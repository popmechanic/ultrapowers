{"title": "Todos with tags", "kind": "behaviour",
 "summary": ["A list of things you mean to do, each of which you can tag with a word.", "It exists so nothing you meant to do gets forgotten, and so you can see which todos belong together.", "You add a todo, tag it, take a tag off, and deleting a todo takes its tags with it."],
 "store": "client/src/store.js",
 "stories": [
  {"id": "S1", "sentence": "You type \"buy milk\" and press Add; \"buy milk\" appears in the list, not ticked.",
   "steps": [
    {"tool": "addTodo", "args": {"text": "buy milk"}, "layer": "ui",
     "ui": [{"type": {"role": "textbox", "name": "New todo", "text": "buy milk"}}, {"click": {"role": "button", "name": "Add"}}],
     "see": [{"role": "checkbox", "name": "buy milk", "count": 1}]}]},
  {"id": "S2", "sentence": "You tag \"buy milk\" with \"shop\"; the tag \"shop\" shows on \"buy milk\".",
   "steps": [
    {"tool": "addTodo", "args": {"text": "buy milk"}, "layer": "store"},
    {"tool": "addTag", "args": {"todoId": "0", "name": "shop"}, "layer": "ui",
     "ui": [{"type": {"role": "textbox", "name": "Tag for buy milk", "text": "shop"}}, {"click": {"role": "button", "name": "Add tag to buy milk"}}],
     "see": [{"role": "button", "name": "Remove shop from buy milk", "count": 1}]}]},
  {"id": "S3", "sentence": "You take the tag \"shop\" off \"buy milk\"; \"buy milk\" has no tags.",
   "steps": [
    {"tool": "addTodo", "args": {"text": "buy milk"}, "layer": "store"},
    {"tool": "addTag", "args": {"todoId": "0", "name": "shop"}, "layer": "store"},
    {"tool": "removeTag", "args": {"id": "0"}, "layer": "ui",
     "ui": [{"click": {"role": "button", "name": "Remove shop from buy milk"}}],
     "see": [{"role": "button", "name": "Remove shop from buy milk", "count": 0}]}]},
  {"id": "S4", "sentence": "You delete \"buy milk\", which is tagged \"shop\"; the todo and its tag are both gone.",
   "steps": [
    {"tool": "addTodo", "args": {"text": "buy milk"}, "layer": "store"},
    {"tool": "addTag", "args": {"todoId": "0", "name": "shop"}, "layer": "store"},
    {"tool": "deleteTodo", "args": {"id": "0"}, "layer": "ui", "link": "L1",
     "ui": [{"click": {"role": "button", "name": "Delete buy milk"}}],
     "see": [{"role": "checkbox", "name": "buy milk", "count": 0}]}]}],
 "links": [{"id": "L1", "sentence": "Deleting a todo clears its tags.", "pieces": ["todo", "tag"]}],
