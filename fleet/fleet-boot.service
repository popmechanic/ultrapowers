[Unit]
Description=ultrapowers sandbox boot
After=network-online.target

[Service]
Type=simple
ExecStart=/home/exedev/repo/fleet/sandbox-boot.sh
# The boot script backgrounds `busybox httpd` to serve the status page. Under
# the default control-group kill mode systemd reaps that child the moment the
# script exits, the page goes dark, and the janitor can never read `done`.
KillMode=process
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
