170 > 1 def test_no_kata_is_left_in_the_remover():
171 < 1     text = REAPER.read_text()
172 < 1     assert "kata" not in text.lower()
173 < 1     assert "localhost:8000" not in text
169 < 2 def test_the_kata_rollback_decides_on_the_run_issue_and_reads_no_evidence():
170 < 2     closed = lambda target, run: {"status": "closed", "closed_reason": "done"}
171 < 2     assert reaper.answer_for(CALLER, RAW, "kata", EVIDENCE, read=never, find=closed) == (202, VM, 7)
172 < 2     still_open = lambda target, run: {"status": "open"}
173 < 2     assert reaper.answer_for(CALLER, RAW, "kata", EVIDENCE, read=never, find=still_open) == (409, None, 7)
174 < 2     assert reaper.answer_for(CALLER, RAW, "kata", EVIDENCE, read=never, find=lambda t, r: None) == (409, None, 7)
