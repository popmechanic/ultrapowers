71 < 2 def test_record_of_is_evidence_unless_it_says_kata():
72 < 2     assert reaper.record_of("kata") == "kata"
73 < 2     for value in [None, "", "evidence", "KATA", "hub"]:
74 < 2         assert reaper.record_of(value) == "evidence"
