65 < 2 def test_issue_done_is_a_run_issue_closed_as_done():
66 < 2     assert reaper.issue_done({"status": "closed", "closed_reason": "done"}) is True
67 < 2     for issue in [None, {"status": "open"}, {"status": "closed", "closed_reason": "wontfix"}]:
68 < 2         assert reaper.issue_done(issue) is False
