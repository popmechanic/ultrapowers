59 < 1 def test_status_done_is_a_status_page_whose_state_is_done():
60 < 1     assert reaper.status_done({"state": "done", "merged": None}) is True
61 < 1     for status in [None, {}, {"state": "parked"}, {"state": "failed"}, {"state": "running"}, {"state": "publishing"}, "done"]:
62 < 1         assert reaper.status_done(status) is False
