153 < 1 @pytest.mark.parametrize("status", [None, {"state": "parked"}, {"state": "failed"}, {"state": "running"}, {}])
154 < 1 def test_evidence_record_that_does_not_say_done_answers_409(status):
155 < 1     read, _ = reader(status)
157 > 1     assert reaper.answer_for(CALLER, RAW, EVIDENCE, read=read) == (409, None, 7)
156 < 2     assert reaper.answer_for(CALLER, RAW, "evidence", EVIDENCE, read=read, find=never) == (409, None, 7)
