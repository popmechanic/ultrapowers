52 < 1 @pytest.mark.parametrize("done", [False, None, "done", 1, {"state": "done"}])
53 < 1 def test_decide_answers_409_unless_the_record_said_done(done):
54 < 1     assert reaper.decide(CALLER, BODY, done) == (409, None)
