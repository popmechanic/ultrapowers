79 < 1 def test_status_url_reads_the_page_at_the_runs_tag_and_no_other_ref():
80 < 1     assert reaper.status_url(EVIDENCE, "o/r", 7) == (
81 < 1         "https://github.int.exe.xyz/api/v3/repos/ops/evidence/contents/runs/o-r/7/status.json"
82 < 1         "?ref=refs%2Ftags%2Fo-r%2Frun-7"
83 < 1     )
84 < 1 
85 < 1 
86 < 1 def test_status_of_reads_the_raw_file_and_the_base64_envelope():
87 < 1     page = {"state": "done", "run": "7"}
88 < 1     raw = json.dumps(page).encode("utf-8")
89 < 1     envelope = json.dumps({"encoding": "base64", "content": base64.encodebytes(raw).decode("ascii")}).encode("utf-8")
90 < 1     assert reaper.status_of(raw) == page
91 < 1     assert reaper.status_of(envelope) == page
92 < 1     for junk in [b"", b"not json", b"[]", b'"done"', json.dumps({"encoding": "base64", "content": "!!"}).encode("utf-8")]:
93 < 1         assert reaper.status_of(junk) is None
94 < 1 
