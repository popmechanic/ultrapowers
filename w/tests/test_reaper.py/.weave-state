159 < 1 def test_no_record_is_read_for_a_wrong_caller_body_or_target():
161 > 1     assert reaper.answer_for(None, RAW, EVIDENCE, read=never) == (403, None, None)
162 < 1     assert reaper.answer_for("kata-hub.exe.xyz", RAW, EVIDENCE, read=never) == (403, None, 7)
163 < 1     assert reaper.answer_for(CALLER, b"not json", EVIDENCE, read=never) == (400, None, None)
160 < 2     assert reaper.answer_for(None, RAW, "evidence", EVIDENCE, read=never, find=never) == (403, None, None)
161 < 2     assert reaper.answer_for("kata-hub.exe.xyz", RAW, "evidence", EVIDENCE, read=never, find=never) == (403, None, 7)
162 < 2     assert reaper.answer_for(CALLER, b"not json", "evidence", EVIDENCE, read=never, find=never) == (400, None, None)
163 < 1     other = json.dumps({"run": 8, "target": "o/r"}).encode("utf-8")
165 > 1     assert reaper.answer_for(CALLER, other, EVIDENCE, read=never) == (403, None, 8)
164 < 2     assert reaper.answer_for(CALLER, other, "evidence", EVIDENCE, read=never, find=never) == (403, None, 8)
165 < 1     bad = json.dumps({"run": 7, "target": "nowhere"}).encode("utf-8")
167 > 1     assert reaper.answer_for(CALLER, bad, EVIDENCE, read=never) == (400, None, 7)
166 < 2     assert reaper.answer_for(CALLER, bad, "kata", EVIDENCE, read=never, find=never) == (400, None, 7)
