96 < 1 def test_read_status_reads_nothing_without_an_evidence_repository(monkeypatch):
97 < 1     monkeypatch.setattr(reaper.urllib.request, "urlopen", never)
98 < 1     for evidence in [None, "", "not a repo", "o/r/x"]:
99 < 1         assert reaper.read_status(evidence, "o/r", 7) is None
100 < 1 
101 < 1 
102 < 1 class _Answer:
103 < 1     def __init__(self, raw):
104 < 1         self.raw = raw
105 < 1 
106 < 1     def __enter__(self):
107 < 1         return self
108 < 1 
109 < 1     def __exit__(self, *exc):
110 < 1         return False
111 < 1 
112 < 1     def read(self):
113 < 1         return self.raw
114 < 1 
115 < 1 
116 < 1 def test_read_status_asks_the_edge_once_and_a_missing_tag_is_none(monkeypatch):
117 < 1     asked = []
118 < 1 
119 < 1     def found(req, timeout=None):
120 < 1         asked.append((req.full_url, timeout))
121 < 1         return _Answer(b'{"state": "done"}')
122 < 1 
123 < 1     monkeypatch.setattr(reaper.urllib.request, "urlopen", found)
124 < 1     assert reaper.read_status(EVIDENCE, "o/r", 7) == {"state": "done"}
125 < 1     assert asked == [(reaper.status_url(EVIDENCE, "o/r", 7), reaper.READ_SECONDS)]
126 < 1     assert reaper.READ_SECONDS < 5, "the calling boot waits five seconds"
127 < 1 
128 < 1     def missing(req, timeout=None):
129 < 1         raise reaper.urllib.error.HTTPError(req.full_url, 404, "Not Found", None, None)
130 < 1 
131 < 1     monkeypatch.setattr(reaper.urllib.request, "urlopen", missing)
132 < 1     assert reaper.read_status(EVIDENCE, "o/r", 7) is None
133 < 1 
134 < 1 
135 < 1 # ── One request, decided ───────────────────────────────────────────────────
136 < 1 
137 < 1 def reader(status):
138 < 1     seen = []
139 < 1 
140 < 1     def read(evidence, target, run):
141 < 1         seen.append((evidence, target, run))
142 < 1         return status
143 < 1 
144 < 1     return read, seen
145 < 1 
146 < 1 
148 > 1 def test_evidence_record_done_at_the_tag_answers_202():
147 < 2 def test_evidence_record_done_at_the_tag_answers_202_and_kata_is_not_asked():
148 < 1     read, seen = reader({"state": "done"})
150 > 1     assert reaper.answer_for(CALLER, RAW, EVIDENCE, read=read) == (202, VM, 7)
149 < 2     assert reaper.answer_for(CALLER, RAW, "evidence", EVIDENCE, read=read, find=never) == (202, VM, 7)
150 < 1     assert seen == [(EVIDENCE, "o/r", 7)]
151 < 1 
