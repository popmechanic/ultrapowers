0 < 1 """The hub's VM remover (fleet/reaper.py): what it answers, and on which record.
1 < 1 
2 < 1 The remover answers 202 only when the caller is a fleet VM whose name carries
3 < 1 the run it names and the record says that run ended done. The record is the
5 > 1 evidence repository's status page at the run's tag. No socket is opened: the
6 < 1 reader is handed in.
4 < 2 evidence repository's status page at the run's tag by default; the kata run
5 < 2 issue is the rollback. No socket is opened: the readers are handed in.
6 < 1 """
7 < 1 import base64
8 < 1 import importlib.util
9 < 1 import json
10 < 1 import pathlib
11 < 1 
12 < 1 import pytest
13 < 1 
14 < 1 REAPER = pathlib.Path(__file__).resolve().parent.parent / "fleet" / "reaper.py"
15 < 1 spec = importlib.util.spec_from_file_location("fleet_reaper", REAPER)
16 < 1 reaper = importlib.util.module_from_spec(spec)
17 < 1 spec.loader.exec_module(reaper)
18 < 1 
19 < 1 VM = "fleet-r7-2611130000-abcd"
20 < 1 CALLER = VM + ".exe.xyz"
21 < 1 BODY = {"run": 7, "target": "o/r"}
22 < 1 RAW = json.dumps(BODY).encode("utf-8")
23 < 1 EVIDENCE = "ops/evidence"
24 < 1 
25 < 1 
26 < 1 def never(*args):
27 < 1     raise AssertionError(f"no record may be read here, got {args}")
28 < 1 
29 < 1 
30 < 1 # ── decide(): the caller, the run its name carries, the target, the record ──
31 < 1 
32 < 1 def test_decide_answers_202_and_names_only_the_caller():
33 < 1     assert reaper.decide(CALLER, BODY, True) == (202, VM)
34 < 1     assert reaper.decide(VM, BODY, True) == (202, VM)
35 < 1 
36 < 1 
37 < 1 @pytest.mark.parametrize("caller", [None, "", "kata-hub.exe.xyz", "fleet-r8-2611130000-abcd.exe.xyz", "xfleet-r7-1-a"])
38 < 1 def test_decide_refuses_a_caller_that_is_not_the_runs_own_vm(caller):
39 < 1     assert reaper.decide(caller, BODY, True) == (403, None)
40 < 1 
41 < 1 
42 < 1 @pytest.mark.parametrize("body", [None, [], {}, {"run": "7", "target": "o/r"}, {"run": True, "target": "o/r"}, {"run": 8, "target": "o/r"}])
43 < 1 def test_decide_refuses_a_body_whose_run_is_not_the_callers(body):
44 < 1     assert reaper.decide(CALLER, body, True) == (403, None)
45 < 1 
46 < 1 
47 < 1 @pytest.mark.parametrize("target", [None, 7, "o", "o/r/x", "o r/x", "o/r?x"])
48 < 1 def test_decide_refuses_a_target_that_is_not_owner_repo(target):
49 < 1     assert reaper.decide(CALLER, {"run": 7, "target": target}, True) == (400, None)
50 < 1 
