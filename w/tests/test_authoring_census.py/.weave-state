551 < 1              if line.strip()]
552 < 1     assert argvs, "the fake `gh` was never invoked: " + p.stdout + p.stderr
553 < 1     expected = {plan_path(n) for n in (131, 132, 133)}
554 < 1     expected |= {status_path(n) for n in (131, 132, 133)}
555 < 2     expected |= {report_path(n) for n in (131, 132, 133)}
556 < 1     for argv in argvs:
