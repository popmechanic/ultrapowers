945 < 2 def report_fetch_answers():
946 < 2     """[M1]'s leg (c) table: the plan and status reads answer for 131 and 132,
947 < 2     the report read answers for 131 only."""
948 < 2     return {
949 < 2         plan_path(131): blob(RECORD_131_PLAIN).decode("utf-8"),
950 < 2         plan_path(132): blob(RECORD_133).decode("utf-8"),
951 < 2         status_path(131): blob(STATUS_131).decode("utf-8"),
952 < 2         status_path(132): blob(STATUS_131).decode("utf-8"),
953 < 2         report_path(131): blob(REPORT_FETCHED).decode("utf-8"),
954 < 2     }
