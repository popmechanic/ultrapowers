957 < 2 def test_c_fetch_writes_the_report_as_the_decoded_bytes_of_the_answer(
958 < 2         tmp_path):
959 < 2     """(c)/[M1]: `run-131/report.json` is written into `run-<N>/report.json`,
960 < 2     and it is exactly the decoded bytes of the answer's base64 `content` — not
961 < 2     a re-serialisation of it."""
962 < 2     p, into, _calls, _bare = run_fetch(
963 < 2         tmp_path, answers=report_fetch_answers(), runs="131..132")
964 < 2     assert p.returncode == 0, p.stdout + p.stderr
965 < 2     written = into / "run-131/report.json"
966 < 2     assert written.is_file(), "no report was written: " + repr(sorted(
967 < 2         str(q.relative_to(into)) for q in into.rglob("*")))
968 < 2     assert written.read_bytes() == blob(REPORT_FETCHED), p.stdout + p.stderr
