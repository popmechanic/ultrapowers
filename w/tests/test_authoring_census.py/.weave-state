558 < 1         assert argv[1].startswith("repos/ops/evidence/contents/runs/o-r/"), \
559 < 1             argv
560 < 1         assert argv[1] in expected, argv
561 < 1         for token in argv:
562 < 1             for owner_repo in re.findall(r"repos/([^/]+/[^/?]+)", token):
563 < 1                 assert owner_repo == EVIDENCE, argv
564 < 1     made = {argv[1] for argv in argvs}
565 < 1     for required in (plan_path(131), plan_path(132), plan_path(133),
567 > 1                      status_path(131), status_path(133)):
566 < 2                      status_path(131), status_path(133),
567 < 2                      report_path(131), report_path(133)):
568 < 1         assert required in made, sorted(made)
570 > 2     # 132's plan tag carries no record, so the run is skipped whole: its
571 < 2     # status is never read.
572 < 1     assert status_path(132) not in made, sorted(made)
569 < 2     # 132's plan tag carries no record, so the run is skipped whole: neither
570 < 2     # its status nor its report is ever read.
571 < 2     assert report_path(132) not in made, sorted(made)
