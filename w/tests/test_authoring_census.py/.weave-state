283 < 1 FAKE_GH = '''#!/usr/bin/env python3
284 < 1 """A `gh` that answers a contents read from a table keyed on argv[1]."""
285 < 1 import base64
286 < 1 import json
287 < 1 import sys
288 < 1 from pathlib import Path
289 < 1 
290 < 1 HERE = Path(__file__).resolve().parent
291 < 1 argv = sys.argv[1:]
292 < 1 with (HERE / "calls.jsonl").open("a") as fh:
293 < 1     fh.write(json.dumps(argv) + "\\n")
294 < 1 table = json.loads((HERE / "answers.json").read_text())
295 < 1 body = table.get(argv[1]) if len(argv) > 1 else None
296 < 1 if body is None:
297 < 1     # No digits of its own: the one stderr line naming the skipped run can
298 < 1     # then only be the script's.
299 < 1     sys.stderr.write("gh: that ref carries no such file\\n")
300 < 1     sys.exit(1)
301 < 1 payload = base64.b64encode(body.encode("utf-8")).decode("ascii")
302 < 1 wrapped = "\\n".join(payload[i:i + 60] for i in range(0, len(payload), 60))
303 < 1 sys.stdout.write(json.dumps({
304 < 1     "name": Path(argv[1].split("?")[0]).name,
305 < 1     "encoding": "base64",
306 < 1     "content": wrapped + "\\n",
307 < 1 }) + "\\n")
308 < 1 '''
309 < 1 
310 < 1 
311 < 1 def fake_gh(tmp_path, answers, name="fakebin"):
312 < 2     """The fake, plus the table it answers from. Returns (its path, its call
313 < 2     log)."""
314 < 1     bindir = tmp_path / name
315 < 1     bindir.mkdir()
316 < 1     (bindir / "answers.json").write_text(json.dumps(answers))
317 < 1     gh = bindir / "gh-fake"
318 < 1     gh.write_text(FAKE_GH)
319 < 1     gh.chmod(0o755)
320 < 1     return gh, bindir / "calls.jsonl"
321 < 1 
