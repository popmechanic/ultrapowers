659 < 2 # ------------------------------------------------------------- the Interfaces
660 < 2 
661 < 1 def load_module():
662 < 2     """The script as a module, for the clauses read at its own seam."""
663 < 1     assert CENSUS.is_file(), (
664 < 1         "the census script does not exist yet: %s" % CENSUS)
665 < 1     spec = importlib.util.spec_from_file_location("authoring_census", CENSUS)
666 < 1     module = importlib.util.module_from_spec(spec)
667 < 1     spec.loader.exec_module(module)
668 < 1     return module
669 < 1 
670 < 2 
671 < 2 # ============================================================================
672 < 2 # Part two: the census counts amendments.
673 < 2 # ============================================================================
674 < 2 
675 < 2 # The records are part one's, but for `run-131`'s question, which carries no
676 < 2 # `explain_rounds` here — this part's rows read that cell as `0`.
677 < 2 RECORD_131_PLAIN = {
678 < 2     "tasks": [{"id": "1", "verdict": "pass"}],
679 < 2     "tally": {"dispatched": 4, "rejected": 1},
680 < 2     "authoring": {
681 < 2         "minutes": 118,
682 < 2         "probes": 12,
683 < 2         "routing": {"branch": "risk", "lane": "ultrapowers"},
684 < 2         "questions": [
685 < 2             {"question": "Claim and summary", "options": ["A", "B"],
686 < 2              "recommended": "A", "picked": "A"},
687 < 2         ],
688 < 2     },
689 < 2 }
690 < 2 
691 < 2 
692 < 2 # The shared literal the Context spells: `report.amendments` is a list of
693 < 2 # `{task, amends, what, why}` rows.
694 < 2 def amendment(task, amends):
695 < 2     return {
696 < 2         "task": task,
697 < 2         "amends": amends,
698 < 2         "what": "the clause moved",
699 < 2         "why": "the tree said otherwise",
700 < 2     }
701 < 2 
702 < 2 
703 < 2 #: A report carrying the empty list: `0` amendments. Zero is a value the file
704 < 2 #: carries, so the cell is `0` and the totals sum is still 0.
705 < 2 REPORT_EMPTY = {"run": "12", "amendments": []}
706 < 2 
707 < 2 
708 < 2 #: Leg (a)'s first run: three amendment rows, so its cell is `3`.
709 < 2 REPORT_THREE = {
710 < 2     "run": "9",
711 < 2     "amendments": [amendment("1", "M1"), amendment("2", "M2"),
712 < 2                    amendment("2", "M3")],
713 < 2 }
714 < 2 
715 < 2 #: Leg (a)'s second run: a report that parses and carries no `amendments`
716 < 2 #: key — every run before this plan. Its cell is `-`, never `0`.
717 < 2 REPORT_NO_KEY = {
718 < 2     "run": "131",
719 < 2     "tasks": [{"id": "1", "verdict": "pass"}],
720 < 2 }
721 < 2 
722 < 2 
723 < 2 #: Leg (c)'s fetched report: two rows, so the fetched row's cell is `2` and no
724 < 2 #: leg's expected number is the same as another's by accident.
725 < 2 REPORT_FETCHED = {
726 < 2     "run": "131",
727 < 2     "amendments": [amendment("1", "M2"), amendment("3", "M1")],
728 < 2 }
729 < 2 
730 < 2 
731 < 2 # ------------------------------------------------------------- the M2 expected
732 < 2 
733 < 2 
734 < 2 #: Where the `amendments` cell sits in a row, counted from the end — the
735 < 2 #: `explain_rounds` column a later plan added closes the row after it.
736 < 2 AMENDMENTS_FROM_END = len(COLUMN_NAMES) - COLUMN_NAMES.index("amendments")
737 < 2 
738 < 2 # (a): `run-9`'s record predates the plan — `-` in every authoring column, its
739 < 2 # tally read — and its report carries three amendment rows.
740 < 2 AM_ROW_9 = tsv("9", "-", "-", "3", "0", "-", "-", "-", "-", "-", "3", "-")
741 < 2 # (a): the full row, its report carrying no `amendments` key. Its question
742 < 2 # carries no `explain_rounds`, so that cell is `0`, not `-` — the record has
743 < 2 # an `authoring` key.
744 < 2 AM_ROW_131 = tsv("131", "118", "12", "4", "1", "risk", "ultrapowers", "1",
745 < 2                  "1/1", "16", "-", "0")
746 < 2 # (a): no report at all beside the record.
747 < 2 AM_ROW_133 = tsv("133", "47", "5", "2", "-", "width", "ultrapowers", "2",
748 < 2                  "1/1", "-", "-", "0")
749 < 2 
750 < 2 # ------------------------------------------------------------- the M3 expected
751 < 2 
752 < 2 #: [M3] the totals line with its ` runs=<window>` field stripped: exactly the
753 < 2 #: format string M3 quotes, filled in for leg (a)'s root. 118 + 47 = 165; 16 is
754 < 2 #: the one row carrying a `run_min`; 3 is the one row carrying an `amendments`.
755 < 2 TOTALS_WITHOUT_WINDOW = ("totals: plans=3 risk_override=1/2 "
756 < 2                          "recommended_picked=2/2 authoring_min=165 "
757 < 2                          "run_min=16 amendments=3 explain_rounds=0")
758 < 2 
759 < 2 WINDOW_RE = re.compile(r" runs=\S+")
760 < 2 
761 < 2 
762 < 2 def without_window(line):
763 < 2     """`line` with one ` runs=<window>` field removed — see this module's
764 < 2     docstring: M3's quoted format string predates that field, so the exam reads
765 < 2     the line either way rather than pinning a question the task answers twice."""
766 < 2     return WINDOW_RE.sub("", line, count=1)
767 < 2 
768 < 2 
769 < 2 # ------------------------------------------------------------------- the seam
770 < 2 
771 < 2 def amendments_root(tmp_path, name="census",
772 < 2                     reports=("three", "no_key", None)):
773 < 2     """Leg (a)'s three run directories under one root.
774 < 2 
775 < 2     `reports` says what each of `run-9`, `run-131`, `run-133` carries beside
776 < 2     its record, in that order: the leg's root is a three-row report, a report
777 < 2     with no `amendments` key, and no report at all."""
778 < 2     which = {
779 < 2         "three": REPORT_THREE,
780 < 2         "no_key": REPORT_NO_KEY,
781 < 2         "empty": REPORT_EMPTY,
782 < 2         None: None,
783 < 2     }
784 < 2     return build_root(tmp_path, name, runs=[
785 < 2         (131, RECORD_131_PLAIN, STATUS_131, which[reports[1]]),
786 < 2         (133, RECORD_133, None, which[reports[2]]),
787 < 2         (9, RECORD_9, None, which[reports[0]]),
788 < 2     ])
789 < 2 
790 < 2 
791 < 2 
792 < 2 def call_log(calls):
793 < 2     return [json.loads(line) for line in lines(calls.read_text())
794 < 2             if line.strip()]
795 < 2 
796 < 2 
797 < 2 def row_for(stdout, number):
798 < 2     """The one printed row whose first cell is `<number>`, or None."""
799 < 2     found = [line for line in lines(stdout)
800 < 2              if line.split("\t")[0] == str(number)]
801 < 2     assert len(found) <= 1, found
802 < 2     return found[0] if found else None
803 < 2 
804 < 2 
805 < 2 def last_cells(stdout):
806 < 2     """The `amendments` cell of every row between the header and the totals
807 < 2     line — the last one this exam is about, whatever columns close the row
808 < 2     after it."""
809 < 2     body = lines(stdout)[1:-1]
810 < 2     return [line.split("\t")[-AMENDMENTS_FROM_END] for line in body]
811 < 2 
812 < 2 
813 < 2 def amendments_cell(row):
814 < 2     """One row's `amendments` cell, read the same way."""
815 < 2     return row.split("\t")[-AMENDMENTS_FROM_END]
816 < 2 
817 < 2 
818 < 2 def totals_field(line, name):
819 < 2     """The value of one ` <name>=<value>` field of the totals line.
820 < 2 
821 < 2     M3's operative words are that the line ends ` amendments=<n>`; a later
822 < 2     plan appends its own fields after it, so what this exam pins is the
823 < 2     field's value, not its position."""
824 < 2     match = re.search(r" %s=(\S+)" % re.escape(name), line)
825 < 2     assert match is not None, line
826 < 2     return match.group(1)
827 < 2 
828 < 2 
829 < 2 # ------------------------------------------------------------------- leg (a)
830 < 2 
831 < 2 def test_a_the_header_ends_with_an_amendments_column_after_run_min(tmp_path):
832 < 2     """(a)/[M2]: `COLUMNS` gains `amendments` as its last name, after
833 < 2     `run_min` — the header line is those names, tab-separated, in that order
834 < 2     and no other."""
835 < 2     root = amendments_root(tmp_path)
836 < 2     p = census("--from", str(root))
837 < 2     assert p.returncode == 0, p.stdout + p.stderr
838 < 2     header = lines(p.stdout)[0]
839 < 2     assert header == HEADER, p.stdout
840 < 2     names = header.split("\t")
841 < 2     assert "amendments" in names, header
842 < 2     assert names[names.index("amendments") - 1] == "run_min", header
843 < 2 
844 < 2 
845 < 2 def test_a_the_three_rows_last_cells_are_three_dash_dash(tmp_path):
846 < 2     """(a)/[M2]: the three runs' last cells are `3` (a report whose
847 < 2     `amendments` has three rows), `-` (a report carrying no `amendments` key)
848 < 2     and `-` (no report), in that order — rows sort by ascending N, so `run-9`
849 < 2     is first."""
850 < 2     root = amendments_root(tmp_path)
851 < 2     p = census("--from", str(root))
852 < 2     assert p.returncode == 0, p.stdout + p.stderr
853 < 2     assert last_cells(p.stdout) == ["3", "-", "-"], p.stdout
854 < 2 
