234 > 1 def write_run(root, number, record, status=None):
233 < 2 def write_run(root, number, record, status=None, report=None):
234 < 2     """One `run-<N>` directory: the record, and beside it the `status.json`
236 > 2     when given."""
235 < 2     and the `report.json` when given."""
236 < 1     d = root / ("run-%s" % number)
237 < 1     d.mkdir(parents=True)
238 < 1     if record is not None:
239 < 1         (d / "gate-verdicts.json").write_bytes(blob(record))
240 < 1     if status is not None:
241 < 1         (d / "status.json").write_bytes(blob(status))
242 < 2     if report is not None:
243 < 2         (d / "report.json").write_bytes(blob(report))
244 < 1     return d
