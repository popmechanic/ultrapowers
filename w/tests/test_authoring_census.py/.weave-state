247 < 1 def build_root(tmp_path, name="census", runs=None):
248 < 2     """Run directories under one root. `runs` is a list of
250 > 2     `(number, record, status)`; it defaults to leg (a)'s three run
251 < 2     directories, which carry no status but 131's."""
249 < 2     `(number, record, status, report)`; it defaults to part one's leg (a)
250 < 2     three run directories, which carry no status but 131's and no report."""
251 < 1     if runs is None:
253 > 1         runs = [(131, RECORD_131, STATUS_131),
254 < 1                 (133, RECORD_133, None),
255 < 1                 (9, RECORD_9, None)]
252 < 2         runs = [(131, RECORD_131, STATUS_131, None),
253 < 2                 (133, RECORD_133, None, None),
254 < 2                 (9, RECORD_9, None, None)]
255 < 1     root = tmp_path / name
256 < 1     root.mkdir()
258 > 1     for number, record, status in runs:
259 < 1         write_run(root, number, record, status)
257 < 2     for number, record, status, report in runs:
258 < 2         write_run(root, number, record, status, report)
259 < 1     return root
