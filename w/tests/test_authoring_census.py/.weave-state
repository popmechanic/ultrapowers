262 < 1 DECOY = """#!/bin/sh
263 < 1 printf '%s\\n' "$*" >> '{log}'
264 < 1 exit 1
265 < 1 """
266 < 1 
267 < 1 
268 < 1 def decoy_env(tmp_path, name="decoy"):
269 < 2     """A `gh` first on PATH that logs and fails. `--gh` names a binary, so the
270 < 2     real one is never resolved by bare name — the seam `check_provenance.py`
271 < 2     gives its own `--gh`. Returns (env, the log that must never appear)."""
272 < 1     bindir = tmp_path / name
273 < 1     bindir.mkdir()
274 < 1     log = bindir / "bare-gh.log"
275 < 1     gh = bindir / "gh"
276 < 1     gh.write_text(DECOY.format(log=log))
277 < 1     gh.chmod(0o755)
278 < 1     env = dict(os.environ)
279 < 1     env["PATH"] = str(bindir) + os.pathsep + env["PATH"]
280 < 1     return env, log
281 < 1 
