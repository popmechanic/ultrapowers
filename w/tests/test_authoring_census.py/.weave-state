471 < 1 def fetch_answers():
472 < 2     """The fake's table: the plan record for 131 and 133, a `status.json` for
474 > 2     131 only. Run 132's plan tag and run 133's status are absent, so the fake
475 < 2     exits 1 for them."""
473 < 2     131 only. Run 132's plan tag and run 133's evidence tag are absent, so the
474 < 2     fake exits 1 for them — and no `report.json` is answered at all, so every
475 < 2     row's `amendments` is `-`."""
476 < 1     return {
477 < 1         plan_path(131): blob(RECORD_131).decode("utf-8"),
478 < 1         plan_path(133): blob(RECORD_133).decode("utf-8"),
479 < 1         status_path(131): blob(STATUS_131).decode("utf-8"),
480 < 1     }
481 < 1 
482 < 1 
483 < 1 def run_fetch(tmp_path, answers=None, runs="131..133",
484 < 1               repo_args=("--evidence-repo", EVIDENCE)):
485 < 2     """`--fetch` over the fake: `answers` defaults to part one's table, and
486 < 2     `repo_args` name the evidence repository (the flag, by default)."""
487 < 1     into = tmp_path / "fetched"
488 < 1     into.mkdir()
489 < 1     gh, calls = fake_gh(tmp_path, fetch_answers() if answers is None
490 < 1                         else answers)
491 < 1     env, bare_log = decoy_env(tmp_path)
492 < 2     # The laptop's own `~/.ultrapowers/fleet.json` is never read: HOME is
493 < 2     # the test's.
494 < 1     env["HOME"] = str(tmp_path / "home")
495 < 1     p = census("--fetch", "o/r", "--runs", runs, "--into", str(into),
496 < 1                "--gh", str(gh), *repo_args, env=env)
497 < 1     return p, into, calls, bare_log
