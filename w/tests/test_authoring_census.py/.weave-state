992 < 2     reports = [argv for argv in argvs
993 < 2                if "report.json" in (argv[1] if len(argv) > 1 else "")]
994 < 2     assert [argv[1] for argv in reports] == [
995 < 2         report_path(131), report_path(132)], reports
996 < 2     for argv in reports:
997 < 2         assert argv == ["api", argv[1]], argv
998 < 2     expected = {plan_path(n) for n in (131, 132)}
999 < 2     expected |= {status_path(n) for n in (131, 132)}
1000 < 2     expected |= {report_path(n) for n in (131, 132)}
1001 < 2     for argv in argvs:
1002 < 2         assert len(argv) == 2, argv
1003 < 2         assert argv[0] == "api", argv
1004 < 2         assert argv[1].startswith("repos/ops/evidence/contents/runs/o-r/"), \
1005 < 2             argv
1006 < 2         assert "?ref=" in argv[1], argv
