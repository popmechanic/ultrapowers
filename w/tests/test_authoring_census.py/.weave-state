225 < 1 def census(*args, env=None):
226 < 2     """The script, as a subprocess. Nothing here reaches into its internals."""
227 < 1     assert CENSUS.is_file(), (
228 < 1         "the census script does not exist yet: %s" % CENSUS)
229 < 1     return subprocess.run([sys.executable, str(CENSUS), *args],
230 < 1                           capture_output=True, text=True, env=env)
231 < 1 
