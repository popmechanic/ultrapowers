264 < 1 def test_a_run_with_no_entry_is_not_joined(tmp_path):
265 < 1     repo = new_repo(tmp_path / "r")
266 < 1     c0 = commit(repo, {"a.txt": lines(*BODY)})
267 < 1     S.genesis(str(repo), c0)
268 < 1     c1 = commit(repo, {"a.txt": lines("ALPHA", *BODY[1:])})
269 < 1     sh(repo, "checkout", "-q", "--detach", c0)
270 < 1     by_hand = commit(repo, {"a.txt": lines(*BODY, "iota")})
271 < 1     entries_before = S.entries(str(repo))
272 < 1     assert S.join(str(repo), by_hand, c1) == ({"joined": False, "reason": "no-run-entry"}, None)
273 < 1     assert S.entries(str(repo)) == entries_before
