129 < 1 def test_a_stored_weave_that_is_not_gits_text_is_drift(tmp_path):
130 < 1     repo = new_repo(tmp_path / "r")
131 < 1     shas = history(repo)
132 < 1     mem = S.Memory(sh(repo, "rev-parse", shas[1] + "^{tree}"))
133 < 1     mem.states["a.txt"] = M.initial_state(["not", "what", "git", "holds"])
134 < 1     mem.dirty.add("a.txt")
135 < 1     S.write_entry(str(repo), mem, "run")
136 < 1     with pytest.raises(S.Drift) as e:
137 < 1         S.resolve(str(repo), shas[1])
138 < 1     assert e.value.paths == ["a.txt"]
