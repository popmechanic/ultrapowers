0 < 2 """The weave store (factory/flock/weave_store.py): main's memory, on real git repositories."""
1 < 1 import json
2 < 1 import os
3 < 1 import subprocess
4 < 1 import sys
5 < 1 
6 < 1 import pytest
7 < 1 
8 < 1 ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
9 < 1 sys.path.insert(0, os.path.join(ROOT, "factory", "flock"))
10 < 1 import weave_store as S  # noqa: E402
11 < 1 
12 < 1 M = S.M
13 < 1 
14 < 1 
15 < 1 @pytest.fixture(autouse=True)
16 < 1 def plain_git(monkeypatch):
17 < 2     # the laptop's own git config (signing, hooks, templates) stays out
18 < 1     monkeypatch.setenv("GIT_CONFIG_GLOBAL", os.devnull)
19 < 1     monkeypatch.setenv("GIT_CONFIG_SYSTEM", os.devnull)
20 < 1     for k, v in {**S.IDENTITY}.items():
21 < 1         monkeypatch.setenv(k, v)
22 < 1 
23 < 1 
24 < 1 def sh(repo, *args):
25 < 1     return subprocess.run(["git", "-C", str(repo), *args], check=True, capture_output=True, text=True).stdout.strip()
26 < 1 
27 < 1 
28 < 1 def commit(repo, files, msg="c"):
29 < 2     """One commit writing `files` ({path: text | bytes | None to delete}); its sha."""
30 < 1     for path, content in files.items():
31 < 1         f = os.path.join(str(repo), path)
32 < 1         if content is None:
33 < 1             os.remove(f)
34 < 1             continue
35 < 1         os.makedirs(os.path.dirname(f), exist_ok=True)
36 < 1         with open(f, "wb") as fh:
37 < 1             fh.write(content if isinstance(content, bytes) else content.encode())
38 < 1     sh(repo, "add", "-A")
39 < 1     sh(repo, "commit", "-q", "-m", msg)
40 < 1     return sh(repo, "rev-parse", "HEAD")
41 < 1 
42 < 1 
43 < 1 def new_repo(path):
44 < 1     subprocess.run(["git", "init", "-q", "-b", "main", str(path)], check=True)
45 < 1     return path
46 < 1 
47 < 1 
48 < 1 def lines(*xs):
49 < 1     return "\n".join(xs) + "\n"
50 < 1 
51 < 1 
52 < 2 # a history that makes a diff choose: a repeated line, a delete, the same text put back, a move
53 < 1 HISTORY = [
54 < 1     {"a.txt": lines("one", "two", "three", "", "four"), "b.txt": lines("x", "y")},
55 < 1     {"a.txt": lines("one", "TWO", "three", "", "four", "five")},
56 < 1     {"a.txt": lines("one", "three", "", "four", "five"), "b.txt": lines("x", "y", "z")},
57 < 1     {"a.txt": lines("zero", "one", "two", "three", "", "", "five", "four"), "c/new.txt": lines("n")},
58 < 1     {"b.txt": None, "a.txt": lines("zero", "one", "two", "three", "", "five", "four", "")},
59 < 1 ]
60 < 1 
61 < 1 
62 < 1 def history(repo):
63 < 1     return [commit(repo, files, "c%d" % i) for i, files in enumerate(HISTORY)]
64 < 1 
65 < 1 
66 < 1 def visible(mem, path):
67 < 1     return "\n".join(M.current_lines(mem.states[path]))
68 < 1 
69 < 1 
70 < 1 def test_a_replayed_weave_shows_gits_text_and_is_stored_once(tmp_path):
71 < 1     repo = new_repo(tmp_path / "r")
72 < 1     shas = history(repo)
73 < 1     S.genesis(str(repo), shas[0])
74 < 1     mem = S.resolve(str(repo), shas[-1])
75 < 1     assert visible(mem, "a.txt") == HISTORY[4]["a.txt"]
77 > 1     assert M.current_lines(mem.states["b.txt"]) == []
76 < 2     assert M.current_lines(mem.states["b.txt"]) == []          # deleted: every line is still there, hidden
77 < 1     assert [e[0] for e in M.deserialize_state(mem.states["b.txt"])] == ["x", "y", "z", ""]
78 < 1     assert S.verify(str(repo), mem) == []
79 < 1     before = sh(repo, "rev-parse", S.REF)
80 < 1     again = S.resolve(str(repo), shas[-1])
81 < 1     assert again.states == mem.states and sh(repo, "rev-parse", S.REF) == before
82 < 1 
83 < 1 
84 < 1 def test_replaying_in_two_hops_writes_the_same_entry_as_one(tmp_path):
85 < 1     one, two = new_repo(tmp_path / "one"), tmp_path / "two"
86 < 1     shas = history(one)
87 < 1     S.genesis(str(one), shas[0])
88 < 1     subprocess.run(["git", "clone", "-q", str(one), str(two)], check=True)
89 < 1     sh(two, "fetch", "-q", "origin", "%s:%s" % (S.REF, S.REF))
90 < 1     S.resolve(str(one), shas[4])
91 < 1     S.resolve(str(two), shas[2])
92 < 1     S.resolve(str(two), shas[4])
93 < 1     tree = sh(one, "rev-parse", shas[4] + "^{tree}")
94 < 1     a, b = S.entries(str(one))[tree], S.entries(str(two))[tree]
95 < 1     assert sh(one, "rev-parse", a + "^{tree}") == sh(two, "rev-parse", b + "^{tree}")
96 < 1 
97 < 1 
98 < 1 def test_a_replayed_line_names_the_commit_that_wrote_it(tmp_path):
99 < 1     repo = new_repo(tmp_path / "r")
100 < 1     shas = history(repo)
101 < 1     S.genesis(str(repo), shas[0])
102 < 1     mem = S.resolve(str(repo), shas[1])
103 < 1     state = M.deserialize_state(mem.states["a.txt"])
104 < 1     by_text = {e[0]: k for e, k in zip(state, S.W.line_keys(state))}
105 < 1     assert mem.auth["a.txt"][by_text["TWO"]] == {"@c:" + shas[1][:12]}
107 > 1     assert by_text["one"] not in mem.auth["a.txt"]
106 < 2     assert by_text["one"] not in mem.auth["a.txt"]             # a genesis line has no author: it reads as base
107 < 1     assert mem.dels["a.txt"][by_text["two"]] == {"@c:" + shas[1][:12]}
108 < 1 
