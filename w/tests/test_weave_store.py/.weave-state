276 < 1 def test_a_file_deleted_on_main_and_made_again_by_a_run_keeps_its_old_lines(tmp_path):
277 < 1     repo = new_repo(tmp_path / "r")
278 < 1     c0 = commit(repo, {"a.txt": lines(*BODY), "b.txt": lines("old one", "old two")})
279 < 1     S.genesis(str(repo), c0)
280 < 1     c1 = commit(repo, {"b.txt": None})
281 < 1     sha, began, stored, _ = flock_run(repo, c1, "3", [("A", "1", "b.txt", lines("new"))])
282 < 1     assert began["installed"] == 0 and stored["stored"]
283 < 1     state = M.deserialize_state(S.resolve(str(repo), sha).states["b.txt"])
284 < 1     assert sorted(e[0] for e in state if e[3] % 2 == 0) == ["", "old one", "old two"]
285 < 1     assert M.current_lines(S.resolve(str(repo), sha).states["b.txt"]) == ["new", ""]
