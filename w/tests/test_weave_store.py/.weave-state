288 < 1 def test_a_join_that_is_not_the_commits_text_stores_nothing(tmp_path):
289 < 1     repo = new_repo(tmp_path / "r")
290 < 1     c0 = commit(repo, {"a.txt": lines(*BODY)})
291 < 1     sh(repo, "checkout", "-q", "--detach", c0)
292 < 1     k = S.W.Keeper()
293 < 1     k.r_base(str(repo), ["a.txt"])
294 < 1     k.r_memory(str(repo), c0)
295 < 1     k.r_rewrite("A", "a.txt", lines("ALPHA", *BODY[1:]), task="1")
296 < 1     k.r_publish("A")
297 < 1     other = commit(repo, {"a.txt": lines("SOMETHING ELSE", *BODY[1:])})
298 < 1     assert k.r_store(str(repo), other, run="4") == {"stored": False, "reason": "drift", "paths": ["a.txt"]}
299 < 1     assert sh(repo, "rev-parse", other + "^{tree}") not in S.entries(str(repo))
