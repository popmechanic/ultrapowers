186 < 1 def test_the_cli_opens_a_store_and_says_what_it_holds(tmp_path):
187 < 1     repo = new_repo(tmp_path / "r")
188 < 1     shas = history(repo)
189 < 1     cli = [sys.executable, os.path.join(ROOT, "factory", "flock", "weave_store.py")]
190 < 1     first = json.loads(subprocess.run([*cli, "open", "--repo", str(repo), "--commit", shas[0]], capture_output=True, text=True, check=True).stdout)
191 < 1     assert first == {"memory": True, "tree": sh(repo, "rev-parse", shas[0] + "^{tree}"), "via": "genesis", "stored": 0, "unwoven": 0}
192 < 1     later = json.loads(subprocess.run([*cli, "open", "--repo", str(repo), "--commit", shas[4]], capture_output=True, text=True, check=True).stdout)
193 < 1     assert later["via"] == "replay" and later["stored"] == 3
194 < 1 
195 < 1 
196 < 2 # ── stage 2: a run starts from the store and lands into it; the catch-up joins real weaves ──
197 < 2 
198 < 1 BODY = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta"]
199 < 1 
200 < 1 
201 < 1 def flock_run(repo, base, run, edits):
202 < 2     """What the engine does around the keeper, by hand: the tree checked out at `base`, the keeper
203 < 2     seeded from its text and then from main's memory, each agent's rewrite published, the join's
204 < 2     text committed, and that commit's entry stored. Returns (commit, memory answer, store answer, keeper)."""
205 < 1     sh(repo, "checkout", "-q", "--detach", base)
206 < 1     k = S.W.Keeper()
207 < 1     k.r_base(str(repo), sh(repo, "ls-files").split("\n"))
208 < 1     answer = k.r_memory(str(repo), base)
209 < 1     for agent, task, path, text in edits:
210 < 1         k.r_rewrite(agent, path, text, task=task)
211 < 1         k.r_publish(agent)
212 < 1     m = k.r_merged()
213 < 1     assert m["conflicts"] == []
214 < 1     sha = commit(repo, {p: (m["files"][p] if m["exists"][p] else None) for p in m["files"]}, "run-%s" % run)
215 < 1     return sha, answer, k.r_store(str(repo), sha, run=run), k
216 < 1 
217 < 1 
218 < 1 def labels(repo, commit_sha, path):
219 < 1     mem = S.resolve(str(repo), commit_sha)
220 < 1     return {l for who in mem.auth.get(path, {}).values() for l in who}
221 < 1 
222 < 1 
223 < 1 def test_a_run_lands_its_weave_and_the_next_run_starts_from_it(tmp_path):
224 < 1     repo = new_repo(tmp_path / "r")
225 < 1     c0 = commit(repo, {"a.txt": lines(*BODY), "b.txt": lines("untouched")})
226 < 1     one, began, stored, _ = flock_run(repo, c0, "1", [("A", "2", "a.txt", lines("ALPHA", *BODY[1:]))])
227 < 1     assert began["memory"] and began["via"] == "genesis" and began["installed"] == 0
228 < 1     assert stored["stored"] and stored["paths"] == 1 and stored["tree"] == sh(repo, "rev-parse", one + "^{tree}")
229 < 1     assert labels(repo, one, "a.txt") == {"@r1:2"}
230 < 1     two, began, stored, k = flock_run(repo, one, "2", [("A", "5", "a.txt", lines("ALPHA", *BODY[1:-1], "THETA"))])
231 < 1     assert began["via"] == "run" and began["installed"] == 1
232 < 2     # inside run 2 a line run 1 wrote reads as base: only this run's own lines have a peer's name
233 < 1     assert k.r_authors_keyed("B", "a.txt")["authors"][0] == "base"
234 < 1     assert stored["stored"] and labels(repo, two, "a.txt") == {"@r1:2", "@r2:5"}
235 < 1     mem = S.resolve(str(repo), two)
236 < 1     assert sorted(mem.states) == ["a.txt"] and S.verify(str(repo), mem) == []
237 < 1 
238 < 1 
239 < 1 def two_runs_from_one_base(tmp_path, mine, theirs):
240 < 1     repo = new_repo(tmp_path / "r")
241 < 1     c0 = commit(repo, {"a.txt": lines(*BODY)})
243 > 1     landed, _, _, _ = flock_run(repo, c0, "1", [("A", "1", "a.txt", theirs)])
242 < 2     landed, _, _, _ = flock_run(repo, c0, "1", [("A", "1", "a.txt", theirs)])   # this one reaches main first
243 < 1     run, _, _, _ = flock_run(repo, c0, "2", [("A", "1", "a.txt", mine)])
244 < 1     return repo, landed, run
245 < 1 
246 < 1 
247 < 1 def test_the_catch_up_joins_two_runs_on_their_own_lines(tmp_path):
248 < 1     repo, landed, run = two_runs_from_one_base(tmp_path, lines(*BODY[:-1], "THETA"), lines("ALPHA", *BODY[1:]))
249 < 1     answer, mem = S.join(str(repo), run, landed)
250 < 1     want = lines("ALPHA", *BODY[1:-1], "THETA")
251 < 1     assert answer == {"joined": True, "conflicts": [], "files": {"a.txt": want}, "paths": ["a.txt"]}
252 < 1     sh(repo, "checkout", "-q", "--detach", landed)
253 < 1     head = commit(repo, {"a.txt": want}, "caught up")
254 < 1     S.settle(str(repo), head, S.Memory.from_json(json.loads(json.dumps(mem.to_json()))))
255 < 1     assert labels(repo, head, "a.txt") == {"@r1:1", "@r2:1"}
256 < 1 
257 < 1 
258 < 1 def test_the_catch_up_names_a_conflict_on_one_line(tmp_path):
259 < 1     repo, landed, run = two_runs_from_one_base(tmp_path, lines("MINE", *BODY[1:]), lines("THEIRS", *BODY[1:]))
260 < 1     answer, _ = S.join(str(repo), run, landed)
261 < 1     assert answer["joined"] and answer["conflicts"] == ["a.txt"]
