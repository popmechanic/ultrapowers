141 < 1 def two_sandboxes(tmp_path):
142 < 1     seed = new_repo(tmp_path / "seed")
143 < 1     shas = history(seed)
144 < 1     origin = tmp_path / "origin.git"
145 < 1     subprocess.run(["git", "clone", "-q", "--bare", str(seed), str(origin)], check=True)
146 < 1     a, b = tmp_path / "a", tmp_path / "b"
147 < 1     for d in (a, b):
148 < 1         subprocess.run(["git", "clone", "-q", str(origin), str(d)], check=True)
149 < 1     return origin, a, b, shas
150 < 1 
151 < 1 
152 < 1 def test_two_sandboxes_replaying_one_commit_push_one_entry_and_no_fork(tmp_path):
153 < 1     origin, a, b, shas = two_sandboxes(tmp_path)
154 < 1     assert S.open_store(str(a), shas[0], "origin").via == "genesis"
155 < 1     S.open_store(str(b), shas[3], "origin")
157 > 1     S.sync(str(a), "origin")
156 < 2     S.sync(str(a), "origin")                       # a has the beginning; b has not pushed its replay yet
157 < 1     S.resolve(str(a), shas[3])
158 < 1     assert S.push(str(a), "origin") == {"pushed": True, "forks": []}
159 < 1     assert S.push(str(b), "origin") == {"pushed": True, "forks": []}
160 < 1     remote = S.entries(str(origin))
161 < 1     assert set(remote) == {sh(origin, "rev-parse", s + "^{tree}") for s in (shas[0], shas[3])}
162 < 1     assert sh(origin, "rev-list", "--count", S.REF) == "2"
163 < 1 
164 < 1 
165 < 1 def test_entries_for_different_trees_both_reach_the_remote(tmp_path):
166 < 1     origin, a, b, shas = two_sandboxes(tmp_path)
167 < 1     S.open_store(str(a), shas[0], "origin")
168 < 1     S.open_store(str(b), shas[0], "origin")
169 < 1     S.resolve(str(a), shas[2])
170 < 1     S.resolve(str(b), shas[4])
171 < 1     assert S.push(str(a), "origin")["pushed"] and S.push(str(b), "origin")["pushed"]
172 < 1     assert len(S.entries(str(origin))) == 3
173 < 1 
174 < 1 
175 < 1 def test_two_beginnings_end_as_one(tmp_path):
176 < 1     origin, a, b, shas = two_sandboxes(tmp_path)
178 > 1     S.genesis(str(b), shas[2])
177 < 2     S.genesis(str(b), shas[2])                     # b begins a store and has not pushed it
178 < 1     assert S.open_store(str(a), shas[0], "origin").via == "genesis"
180 > 1     mem = S.open_store(str(b), shas[2], "origin")
179 < 2     mem = S.open_store(str(b), shas[2], "origin")  # b meets a's beginning: its own is dropped
180 < 1     assert mem.via == "replay" and "a.txt" in mem.states
181 < 1     S.push(str(b), "origin")
182 < 1     vias = [json.loads(sh(origin, "show", e + ":meta.json"))["via"] for e in S.entries(str(origin)).values()]
183 < 1     assert sorted(vias) == ["genesis", "replay"]
