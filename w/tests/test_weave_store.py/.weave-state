121 < 1 def test_a_commit_older_than_the_store_has_no_memory(tmp_path):
122 < 1     repo = new_repo(tmp_path / "r")
123 < 1     shas = history(repo)
124 < 1     S.genesis(str(repo), shas[2])
125 < 1     assert S.resolve(str(repo), shas[1]) is None
126 < 1     assert S.resolve(str(repo), shas[3]) is not None
127 < 1 
