110 < 1 def test_a_path_that_was_ever_binary_is_never_woven(tmp_path):
111 < 1     repo = new_repo(tmp_path / "r")
112 < 1     c0 = commit(repo, {"a.txt": lines("one"), "img": lines("text for now")})
113 < 1     S.genesis(str(repo), c0)
114 < 1     c1 = commit(repo, {"img": b"\xff\xfe\x00binary", "a.txt": lines("one", "two")})
115 < 1     c2 = commit(repo, {"img": lines("text again")})
116 < 1     mem = S.resolve(str(repo), c2)
117 < 1     assert mem.unwoven == {"img"} and "img" not in mem.states and "a.txt" in mem.states
118 < 1     assert c1 != c2
