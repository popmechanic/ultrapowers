143 < 1 def test_the_page_names_elements_the_way_the_checker_does(bun, tmp_path):
144 < 1     """Each (role, name) counted by preview/names.ts and by the checker's Chrome must agree.
145 < 1     Names only: Chrome's own role mapping (an <img> is `image`, a table with no header is a
146 < 1     layout table with no cells) is not what this leg reads."""
147 < 1     browser = os.path.join(ROOT, "factory/stack/tinyapp/browser.ts")
148 < 1     entry = tmp_path / "entry.ts"
149 < 1     entry.write_text("import * as n from %s;\n(window as any).__names = n;\n"
150 < 1                      % json.dumps(os.path.join(STORIES, "preview/names.ts")))
151 < 1     script = """
152 < 1 import {existsSync} from 'node:fs';
153 < 1 import {launchBrowser} from %(browser)s;
154 < 1 const built = await Bun.build({entrypoints: [%(entry)s], format: 'iife'});
155 < 1 const js = await built.outputs[0].text();
156 < 1 const html = %(html)s;
157 < 1 const srv = Bun.serve({port: 0, hostname: '127.0.0.1', fetch: (req) => new URL(req.url).pathname === '/names.js'
158 < 1   ? new Response(js, {headers: {'content-type': 'text/javascript'}})
159 < 1   : new Response(html, {headers: {'content-type': 'text/html'}})});
160 < 1 const origin = `http://127.0.0.1:${srv.port}`;
161 < 1 let b;
162 < 1 try { b = await launchBrowser(); } catch (e) { console.log(JSON.stringify({skip: String(e)})); process.exit(0); }
163 < 1 try {
164 < 1   const p = await b.openUrl({url: origin + '/', origin, clock: '2026-01-01T00:00:00Z'});
165 < 1   for (let i = 0; i < 100 && !(await p.evaluate('!!window.__names')); i++) await Bun.sleep(50);
166 < 1   const out = [];
167 < 1   for (const [role, name] of %(cases)s) {
168 < 1     const ours = await p.evaluate(`[...document.querySelectorAll('*')].filter((e) => __names.roleOf(e) === ${JSON.stringify(role)} && __names.nameOf(e) === ${JSON.stringify(name)}).length`);
169 < 1     out.push([role, name, ours, await p.count({role, name})]);
170 < 1   }
171 < 1   await p.close();
172 < 1   console.log(JSON.stringify({out}));
173 < 1 } finally { await b.close(); srv.stop(); }
174 < 1 """ % {"browser": json.dumps(browser), "entry": json.dumps(str(entry)), "html": json.dumps(NAMES_PAGE),
175 < 1        "cases": json.dumps(CASES)}
176 < 1     got = run_bun(script)
177 < 1     if "skip" in got:
178 < 1         pytest.skip("no browser for the checker: " + got["skip"])
179 < 1     differ = [c for c in got["out"] if c[2] != c[3]]
180 < 1     assert differ == [], "role, name, names.ts count, checker count: %r" % differ
181 < 1 