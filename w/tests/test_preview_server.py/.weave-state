26 < 1 def run_bun(script, cwd=ROOT):
27 < 1     r = subprocess.run(["bun", "-e", script], cwd=cwd, capture_output=True, text=True, timeout=300)
28 < 1     assert r.returncode == 0, r.stderr[-2000:]
29 < 1     return json.loads(r.stdout.strip().splitlines()[-1])
