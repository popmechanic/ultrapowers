74 < 1     other = json.loads(json.dumps(spec))
75 < 1     other["elements"]["add"]["props"]["label"] = "Add it"
76 < 1     screens = os.path.join(bundle, "screens")
77 < 1     os.makedirs(screens, exist_ok=True)
78 < 1     # A per-piece file from before the whole-page screen: /specs must not read it.
79 < 1     for name, s in [("screen.A.json", spec), ("screen.B.json", other), ("screen.json", other), ("todo.A.json", spec)]:
80 < 1         with open(os.path.join(screens, name), "w") as f:
81 < 1             json.dump(s, f)
71 < 1     subprocess.run(["bun", os.path.join(STORIES, "scaffold.ts"), bundle, app],
72 < 1                    check=True, capture_output=True, text=True)
73 < 1     r = subprocess.run(["bun", "install", "--offline"], cwd=app, capture_output=True, text=True, timeout=300)
74 < 1     if r.returncode:
75 < 1         pytest.skip("bun install --offline failed: " + r.stderr.strip()[-200:])
76 < 1     feedback = str(base / "feedback.jsonl")
77 < 1     proc = subprocess.Popen(["bun", PREVIEW, bundle, "--app", app, "--port", "0", "--feedback", feedback],
78 < 1                             cwd=str(base), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
79 < 1     try:
80 < 1         lines = []
81 < 1         deadline = time.time() + 120
82 < 1         url = None
83 < 1         while time.time() < deadline:
84 < 1             line = proc.stdout.readline()
85 < 1             if not line:
86 < 1                 break
87 < 1             lines.append(line)
88 < 1             if line.startswith("PREVIEW http://"):
89 < 1                 url = line.split(" ", 1)[1].strip().rstrip("/")
90 < 1                 break
91 < 1         assert url, "the preview did not start (the page did not build?):\n" + "".join(lines)[-2000:]
93 > 1         yield {"url": url, "feedback": feedback, "specs": {"A": spec, "B": other}, "approved": other}
92 < 2         yield {"url": url, "feedback": feedback}
93 < 1     finally:
94 < 1         proc.kill()
95 < 1         proc.wait(timeout=10)
