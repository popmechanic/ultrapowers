124 < 1 <ul><li>Item one</li><li tabindex="0">Item two</li></ul>
125 < 1 <table><tr><th>Head</th></tr><tr><td>Cell</td></tr><tr tabindex="0"><td>Row two</td></tr></table>
126 < 1 <h2>Heading</h2><button>Btn</button><a href="#x">Lnk</a><section aria-label="Sec">Section text</section>
127 < 1 <div role="switch">Sw</div><div role="tab">Tb</div><div role="tooltip">Tip</div><div role="menuitem">Mi</div>
128 < 1 <div role="radio">Rd</div><div role="checkbox">Cb</div><div role="article">Art</div><div role="status">St</div>
129 < 1 <div role="dialog">Dlg</div><div role="group">Grp</div><div role="listitem">Li3</div>
130 < 1 <header>Hdr</header><footer>Ftr</footer><aside>Asd</aside><div title="Tt" role="note">Nt</div>
131 < 1 <label>Due <input type="text"></label>
132 < 1 <script src="/names.js"></script></body></html>"""
133 < 1 
134 < 1 CASES = [["main", "Main text"], ["navigation", "Nav text"], ["form", "Form text"], ["list", "Item one Item two"],
135 < 1          ["listitem", "Item one"], ["listitem", "Item two"], ["table", "Head Cell Row two"], ["row", "Cell"], ["columnheader", "Head"],
136 < 1          ["row", "Row two"], ["cell", "Cell"], ["heading", "Heading"], ["button", "Btn"], ["link", "Lnk"],
137 < 1          ["region", "Sec"], ["switch", "Sw"], ["tab", "Tb"], ["tooltip", "Tip"], ["menuitem", "Mi"],
138 < 1          ["radio", "Rd"], ["checkbox", "Cb"], ["article", "Art"], ["status", "St"], ["dialog", "Dlg"],
139 < 1          ["group", "Grp"], ["listitem", "Li3"], ["banner", "Hdr"], ["contentinfo", "Ftr"],
140 < 1          ["complementary", "Asd"], ["note", "Tt"], ["note", "Nt"], ["textbox", "Due"]]
