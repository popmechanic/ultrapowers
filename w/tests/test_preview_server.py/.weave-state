109 < 1 def test_the_server_writes_a_pick_with_its_piece(server):
111 > 1     assert request(server["url"] + "/feedback", {"kind": "pick", "piece": "screen", "chose": "B"}) == 204
110 < 2     assert request(server["url"] + "/feedback", {"kind": "pick", "piece": "todo", "chose": "B"}) == 204
111 < 1     assert request(server["url"] + "/feedback", {"kind": "pick", "chose": "A"}) == 204
112 < 1     assert request(server["url"] + "/feedback", {"kind": "pick", "chose": "A", "screen": "x"}) == 400
113 < 1     with open(server["feedback"]) as f:
115 > 1         assert f.read().splitlines() == ['{"kind":"pick","piece":"screen","chose":"B"}', '{"kind":"pick","chose":"A"}']
114 < 2         assert f.read().splitlines() == ['{"kind":"pick","piece":"todo","chose":"B"}', '{"kind":"pick","chose":"A"}']
