66 < 1 def server(bun, tmp_path_factory):
67 < 1     base = tmp_path_factory.mktemp("preview")
68 < 1     app = str(base / "app")
69 < 1     bundle = str(base / "bundle")
70 < 1     shutil.copytree(TODO, bundle)
72 > 1     with open(SPEC) as f:
