98 < 1 def request(url, body=None):
99 < 1     data = None if body is None else json.dumps(body).encode()
100 < 1     req = urllib.request.Request(url, data=data, method="GET" if body is None else "POST",
101 < 1                                  headers={} if body is None else {"content-type": "application/json"})
102 < 1     try:
103 < 1         with urllib.request.urlopen(req, timeout=30) as r:
104 < 1             return r.status
105 < 1     except urllib.error.HTTPError as e:
106 < 1         return e.code
107 < 1 
108 < 1 
110 > 1 def test_specs_answers_the_one_whole_page_screen(server):
111 < 1     with urllib.request.urlopen(server["url"] + "/specs", timeout=30) as r:
112 < 1         got = json.load(r)
113 < 1     assert list(got) == ["screen"]
114 < 1     assert got["screen"] == {"versions": server["specs"], "approved": server["approved"]}
