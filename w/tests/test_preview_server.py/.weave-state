48 < 1 def test_plays_run_one_at_a_time(bun):
49 < 1     got = run_bun("""
50 < 1 import {inTurn} from %s;
51 < 1 const log = [];
52 < 1 const job = (name, ms, fail) => () => new Promise((ok, no) => {
53 < 1   log.push(name + ' start');
54 < 1   setTimeout(() => { log.push(name + ' end'); fail ? no(new Error(name)) : ok(name); }, ms);
55 < 1 });
56 < 1 const a = inTurn(job('a', 40, true)).catch((e) => 'refused ' + e.message);
57 < 1 const b = inTurn(job('b', 5));
58 < 1 const c = inTurn(job('c', 1));
59 < 1 console.log(JSON.stringify({log, answers: await Promise.all([a, b, c])}));
60 < 1 """ % json.dumps(os.path.join(STORIES, "preview/play.ts")))
61 < 1     assert got["log"] == ["a start", "a end", "b start", "b end", "c start", "c end"]
62 < 1     assert got["answers"] == ["refused a", "b", "c"]
