32 < 1 def test_feedback_record_takes_a_pick_with_its_piece_and_the_old_shape(bun):
33 < 1     got = run_bun("""
34 < 1 import {feedbackRecord} from %s;
35 < 1 console.log(JSON.stringify([
36 < 1   feedbackRecord({chose: 'B', piece: 'todo', kind: 'pick'}),
37 < 1   feedbackRecord({kind: 'pick', chose: 'A'}),
38 < 1   feedbackRecord({kind: 'pick', piece: 7, chose: 'A'}),
39 < 1   feedbackRecord({kind: 'pick', piece: 'todo', chose: 'A', extra: 1}),
40 < 1 ]));
41 < 1 """ % json.dumps(PREVIEW))
42 < 1     assert json.dumps(got[0]) == '{"kind": "pick", "piece": "todo", "chose": "B"}'
43 < 1     assert got[1] == {"kind": "pick", "chose": "A"}
44 < 1     assert got[2] is None
45 < 1     assert got[3] is None
