291 < 1 def test_e_m5_refusals(repo):
292 < 1     r, plan, head = repo
293 < 1     zeros = "0" * 40
294 < 1     q = run(plan, "--task", "1", "--base", zeros)
295 < 1     assert q.returncode != 0 and q.stdout == ""
296 < 1     assert q.stderr.strip().startswith("error:") and zeros in q.stderr, q.stderr
297 < 1 
298 < 1 
299 < 2 # ── extractor-and-authoring-refusals task 1 (#1025): a base that is neither a
300 < 2 # checkout directory nor a 40-hex sha is refused on one line, exit 2 ─────────
301 < 2 
302 < 1 REFUSAL = ("extract: --base %s is not a commit this repository has — "
303 < 1            "pass the 40-hex sha or a checkout directory")
304 < 1 
305 < 1 
306 < 1 @pytest.mark.parametrize("label", ["abbrev", "word"])
307 < 1 def test_g_m1_a_short_or_unknown_base_is_refused_on_one_line(repo, label):
308 < 2     """(a) [M1]: the fixture HEAD's first 8 characters, and the word
309 < 2     `notasha` — exit 2, empty stdout, exactly one stderr line, the issue's
310 < 2     message with the value substituted."""
311 < 1     r, plan, head = repo
312 < 1     value = head[:8] if label == "abbrev" else "notasha"
313 < 1     p = run(plan, "--task", "1", "--base", value)
314 < 1     assert p.returncode == 2, (p.returncode, p.stderr)
315 < 1     assert p.stdout == "", p.stdout
316 < 1     assert p.stderr.strip().splitlines() == [REFUSAL % value], p.stderr
317 < 1 
318 < 1 
319 < 1 def test_g_m3_a_real_sha_and_a_directory_still_read_present(repo):
320 < 2     """(d) [M3]: the 40-hex sha and the checkout directory both print
321 < 2     `present` for a file that exists, and the hash equals the no-base diet's."""
322 < 1     r, plan, head = repo
323 < 1     plain = load(run(plan, "--task", "1"))
324 < 1     for rev in (head, str(r)):
325 < 1         d = load(run(plan, "--task", "1", "--base", rev))
326 < 1         by = {f["path"]: f for f in d["base"]["files"]}
327 < 1         assert by["tests/test_mod.py"]["status"] == "present", rev
328 < 1         assert d["hash"] == plain["hash"], rev
329 < 1 