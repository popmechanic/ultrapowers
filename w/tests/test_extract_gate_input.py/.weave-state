206 < 1 def test_d_m4_caps(tmp_path):
207 < 1     r = tmp_path / "repo2"
208 < 1     r.mkdir()
209 < 1     _git(r, "init", "-q", ".")
210 < 1     _git(r, "config", "user.email", "exam@example.invalid")
211 < 1     _git(r, "config", "user.name", "exam")
212 < 1     (r / "t").mkdir()
213 < 1     big = "\n".join(f"line {i} {LONG_LIT} " + "x" * 60 for i in range(200)) + "\n"
215 > 1     (r / "t/big.py").write_text(big)
214 < 2     (r / "t/big.py").write_text(big)          # far over 8,000 bytes of carriers
215 < 1     (r / "t/small.py").write_text(f"a = '{LONG_LIT}'\n")
217 > 1     for i in range(4):
216 < 2     for i in range(4):                        # 4 × ~8 KB crosses 24,000
217 < 1         (r / f"t/fill{i}.py").write_text(big)
218 < 1     plan = r / "plan.md"
219 < 2     # Files: big, small, (nothing — absent), fill0, fill1 (Create:); Proof:
220 < 2     # fill2 (Run: cat) and fill3 (Run: python3). Present entries in order:
221 < 2     # big, small, fill0, fill1, fill2, fill3 — the total cap lands inside fill1.
222 < 1     plan.write_text(_plan_text("t/big.py", "t/small.py", "t/fill0.py",
223 < 1                                "t/nothing.py", "t/fill1.py", "t/fill2.py",
224 < 1                                "t/fill3.py", verb="Create"))
225 < 1     _git(r, "add", "-A")
226 < 1     _git(r, "commit", "-qm", "caps")
227 < 1     head = _git(r, "rev-parse", "HEAD").strip()
228 < 1     d = load(run(plan, "--task", "1", "--base", head))
229 < 1     by = {f["path"]: f for f in d["base"]["files"]}
230 < 1     e = by["t/big.py"]["excerpt"]
231 < 1     assert len(e.encode()) <= 8000 and by["t/big.py"]["truncated"] is True
232 < 1     assert not e.endswith("\n") and e.splitlines()[-1].startswith(tuple("0123456789")), \
233 < 1         "(d) [M4] cut at a line boundary"
234 < 1     assert by["t/small.py"]["truncated"] is False
235 < 1     present = [f for f in d["base"]["files"] if f["status"] == "present"]
236 < 1     total = sum(len(f["excerpt"].encode()) for f in present)
237 < 1     assert 23000 < total <= 24000, total
238 < 2     # big (file cap), small (whole), fill0 (file cap), fill1 (the total cap
239 < 2     # cuts it, non-empty), then every later entry empty and truncated.
240 < 1     order = [f["path"] for f in present]
241 < 1     assert order == ["t/big.py", "t/small.py", "t/fill0.py", "t/fill1.py",
242 < 1                      "t/fill2.py", "t/fill3.py"], order
243 < 1     assert by["t/fill0.py"]["truncated"] is True and by["t/fill0.py"]["excerpt"]
244 < 2     # The entry the TOTAL cap cut keeps what fit (non-empty, truncated); every
245 < 2     # later entry is empty and truncated while still carrying lines/headings.
246 < 1     nonempty = [i for i, f in enumerate(present) if f["excerpt"]]
247 < 1     last = nonempty[-1]
248 < 1     assert last >= order.index("t/fill1.py"), "(d) [M4] the total lands past fill1"
249 < 1     assert last < len(present) - 1, "(d) [M4] at least one entry after the cut"
250 < 1     assert present[last]["truncated"] is True
251 < 1     for f in present[last + 1:]:
252 < 1         assert f["excerpt"] == "" and f["truncated"] is True, f["path"]
253 < 1         assert "lines" in f and "headings" in f, f["path"]
254 < 1 
255 < 1 
256 < 1 def test_h_own_entries_spend_the_budget_after_their_siblings(tmp_path):
257 < 2     """(#1528) an own entry spends the excerpt budget last, so a sibling the
258 < 2     task's Proof names is never starved by the files the task rewrites."""
259 < 1     r = tmp_path / "repo3"
260 < 1     r.mkdir()
261 < 1     _git(r, "init", "-q", ".")
262 < 1     _git(r, "config", "user.email", "exam@example.invalid")
263 < 1     _git(r, "config", "user.name", "exam")
264 < 1     (r / "t").mkdir()
265 < 1     big = "\n".join(f"line {i} {LONG_LIT} " + "x" * 60 for i in range(200)) + "\n"
266 < 1     for i in range(3):
267 < 1         (r / f"t/own{i}.py").write_text(big)
268 < 1     (r / "t/sib_test.py").write_text(
269 < 1         "\n".join(f"s{i} = '{LONG_LIT}'" for i in range(40)) + "\n")
270 < 1     plan = r / "plan.md"
271 < 1     plan.write_text(_plan_text("t/own0.py", "t/own1.py", "t/own2.py",
272 < 1                                "t/nothing.py", "t/none.py", "t/sib_test.py",
273 < 1                                "t/runme.sh"))
274 < 1     _git(r, "add", "-A")
275 < 1     _git(r, "commit", "-qm", "own")
276 < 1     head = _git(r, "rev-parse", "HEAD").strip()
277 < 1     d = load(run(plan, "--task", "1", "--base", head))
278 < 1     files = d["base"]["files"]
279 < 1     by = {f["path"]: f for f in files}
280 < 1     s = by["t/sib_test.py"]
281 < 1     assert [f["path"] for f in files if f["status"] == "present"] == [
282 < 1         "t/own0.py", "t/own1.py", "t/own2.py", "t/sib_test.py"]
283 < 1     assert "own" not in s and s["truncated"] is False
284 < 1     assert s["excerpt"].splitlines()[0] == f"1: s0 = '{LONG_LIT}'"
285 < 1     assert len(s["excerpt"].splitlines()) == 40
286 < 1     assert [by[f"t/own{i}.py"]["own"] for i in range(3)] == ["modify"] * 3
287 < 1     total = sum(len(f["excerpt"].encode()) for f in files if f["status"] == "present")
288 < 1     assert total <= 24000 and by["t/own2.py"]["truncated"] is True
289 < 1 
