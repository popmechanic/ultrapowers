182 < 1 def test_c_m3_headings_and_carrier_excerpt(repo):
183 < 1     r, plan, head = repo
184 < 1     d = load(run(plan, "--task", "1", "--base", head))
185 < 1     by = {f["path"]: f for f in d["base"]["files"]}
186 < 1     assert by["docs/guide.md"]["headings"] == ["# Title", "## Section one", "### Deep"]
187 < 1     assert by["docs/guide.md"]["lines"] == 11
188 < 1     assert by["tests/test_mod.py"]["headings"] == [
189 < 1         "# THE FIXTURE MODULE — its banner", "def test_alpha():", "def test_beta():"]
190 < 1     assert by["tests/sim.mjs"]["headings"] == [
191 < 1         "  test('one', () => {})", "  it('two', () => {})"], \
192 < 1         by["tests/sim.mjs"]["headings"]
193 < 1     ex = by["tests/test_mod.py"]["excerpt"].splitlines()
194 < 1     nums = [int(l.split(":", 1)[0]) for l in ex]
195 < 1     assert nums == sorted(nums) and len(nums) == len(set(nums)), \
196 < 1         "(c) [M3] ascending, no line twice"
197 < 2     # LONG_LIT sits on line 13, OTHER_LIT on 17: regions 11–15 and 15–19
198 < 2     # overlap on 15 and print once; SHORT_LIT (line 21) is not a carrier.
199 < 1     assert nums == list(range(11, 20)), nums
200 < 1     assert ex[2] == f"13:     assert {LONG_LIT} == 1"
201 < 1     assert not any(SHORT_LIT in l for l in ex), "(c) [M3] a 7-char literal is not a carrier"
202 < 1     assert by["docs/guide.md"]["excerpt"] == "" and by["docs/guide.md"]["truncated"] is False
203 < 1     assert by["tests/extra.py"]["excerpt"] == f"1: # extra\n2: q = '{LONG_LIT}'"
204 < 1 
