41 < 1 @pytest.mark.parametrize("fixture,want_exit,want_lines", CASES)
42 < 1 def test_screens_check(app, fixture, want_exit, want_lines):
44 > 1     shutil.copyfile(os.path.join(FIX, fixture), os.path.join(app, SCREEN))
43 < 2     shutil.copyfile(os.path.join(FIX, fixture), os.path.join(app, "client/src/pieces/todo.json"))
44 < 1     r = subprocess.run(["bun", SCREENS, "--bundle", TODO, "--copy", app],
45 < 1                        capture_output=True, text=True, timeout=120)
46 < 1     assert (r.returncode, r.stdout.splitlines()) == (want_exit, want_lines)
47 < 1 
48 < 1 
50 > 1 def _copy(app, tmp_path):
51 < 2     """A copy of the app sharing its node_modules."""
52 < 1     a = str(tmp_path / "app")
53 < 1     shutil.copytree(app, a, symlinks=True, ignore=lambda d, names: ["node_modules"] if d == app else [])
54 < 1     os.symlink(os.path.join(app, "node_modules"), os.path.join(a, "node_modules"))
55 < 1     return a
56 < 1 
57 < 1 
58 < 1 def test_an_app_without_the_one_page_is_checked_per_piece(app, tmp_path):
59 < 1     a = _copy(app, tmp_path)
60 < 1     os.remove(os.path.join(a, SCREEN))
61 < 1     os.makedirs(os.path.join(a, "client/src/pieces"), exist_ok=True)
62 < 1     piece = os.path.join(a, "client/src/pieces/todo.json")
63 < 1     shutil.copyfile(os.path.join(FIX, "todo_root_missing.json"), piece)
64 < 1     r = subprocess.run(["bun", SCREENS, "--bundle", TODO, "--copy", a], capture_output=True, text=True, timeout=120)
65 < 1     assert (r.returncode, r.stdout.splitlines()) == (1, ['SCREENS todo: root "nope" is no element',
66 < 1                                                          'SCREENS todo: form: child "ghost" is no element',
67 < 1                                                          "SCREENS todo: no element runs addTodo",
68 < 1                                                          "SCREENS todo: no element runs completeTodo",
69 < 1                                                          "SCREENS todo: no element runs deleteTodo",
70 < 1                                                          "SCREENS exit 1: 5 finding(s)"])
71 < 1     shutil.copyfile(os.path.join(FIX, "todo.json"), piece)
72 < 1     r = subprocess.run(["bun", SCREENS, "--bundle", TODO, "--copy", a], capture_output=True, text=True, timeout=120)
73 < 1     assert (r.returncode, r.stdout.splitlines()) == (0, ["SCREENS ok: todo"])
