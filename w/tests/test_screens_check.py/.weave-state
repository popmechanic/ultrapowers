28 < 1 @pytest.fixture(scope="module")
29 < 1 def app(tmp_path_factory):
30 < 1     if not shutil.which("bun"):
31 < 1         pytest.skip("bun is not installed")
32 < 1     dst = str(tmp_path_factory.mktemp("screens") / "app")
33 < 1     subprocess.run(["bun", os.path.join(ROOT, "skills/ultrawrite/stories/scaffold.ts"), TODO, dst],
34 < 1                    check=True, capture_output=True, text=True)
35 < 1     r = subprocess.run(["bun", "install", "--offline"], cwd=dst, capture_output=True, text=True, timeout=300)
36 < 1     if r.returncode:
37 < 1         pytest.skip("bun install --offline failed: " + r.stderr.strip()[-200:])
38 < 1     return dst
