76 < 1 def test_a_props_issue_with_no_path_names_the_element(app, tmp_path):
78 > 1     a = _copy(app, tmp_path)
77 < 2     a = str(tmp_path / "app")
78 < 2     shutil.copytree(app, a, symlinks=True, ignore=lambda d, names: ["node_modules"] if d == app else [])
79 < 2     os.symlink(os.path.join(app, "node_modules"), os.path.join(a, "node_modules"))
80 < 1     with open(os.path.join(a, "client/src/screens/catalog.ts"), "a") as f:
81 < 1         f.write("\ncomponents.Separator.props = components.Separator.props.refine(() => false, {message: 'never'})\n")
82 < 1     spec = _todo()
83 < 1     spec["elements"]["sep"] = {"type": "Separator", "props": {}, "children": []}
84 < 1     spec["elements"][spec["root"]]["children"].append("sep")
85 < 1     code, lines = _screens(a, spec)
87 > 1     assert code == 1 and "SCREENS screen: sep: Separator props: never" in lines, lines
86 < 2     assert code == 1 and "SCREENS todo: sep: Separator props: never" in lines, lines
87 < 1     assert not [l for l in lines if "undefined" in l], lines
