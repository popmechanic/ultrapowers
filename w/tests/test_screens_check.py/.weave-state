102 < 1 def _with_file(app, rel, change, run):
103 < 2     """Change one app file in place for `run`, then put it back."""
104 < 1     p = os.path.join(app, rel)
105 < 1     with open(p, "rb") as f:
106 < 1         kept = f.read()
107 < 1     try:
108 < 1         change(p, kept)
109 < 1         return run()
110 < 1     finally:
111 < 1         with open(p, "wb") as f:
112 < 1             f.write(kept)
113 < 1 
114 < 1 
115 < 1 def _draws_edit(fn):
116 < 1     def change(p, kept):
117 < 1         d = json.loads(kept)
118 < 1         fn(d["parts"])
119 < 1         with open(p, "w") as f:
120 < 1             json.dump(d, f)
121 < 1     return change
122 < 1 
