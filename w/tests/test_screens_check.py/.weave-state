125 > 1 def test_a_part_with_no_draws_line_is_a_finding(app):
124 < 2 def test_a_part_with_no_draws_line_is_a_finding(app):  # #1491
125 < 1     got = _with_file(app, "client/src/screens/draws.json", _draws_edit(lambda parts: parts.pop("Badge")),
126 < 1                      lambda: _screens(app, _todo()))
127 < 1     assert got == (1, ["SCREENS parts: part Badge has no line in client/src/screens/draws.json saying what it draws",
128 < 1                        "SCREENS exit 1: 1 finding(s)"])
