0 < 2 """The TinyApp screens check (factory/stack/tinyapp/screens.ts): what a screen's root draws,
1 < 2 and every element's props against the catalog. Needs bun and an offline-installable app."""
3 > 1 import json
2 < 1 import os
3 < 1 import shutil
4 < 1 import subprocess
5 < 1 
6 < 1 import pytest
7 < 1 
8 < 1 ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
9 < 1 SCREENS = os.path.join(ROOT, "factory/stack/tinyapp/screens.ts")
10 < 1 FIX = os.path.join(ROOT, "evals/fixtures/tinyapp-todo")
11 < 1 TODO = os.path.join(ROOT, "skills/ultrawrite/catalog/todo")
14 > 1 SCREEN = "client/src/screen.json"
13 > 2 SCREEN = "client/src/screen.json"  # the one page the scaffold writes
12 < 1 
13 < 1 MISSING = ["SCREENS todo: no element runs addTodo", "SCREENS todo: no element runs completeTodo",
14 < 1            "SCREENS todo: no element runs deleteTodo"]
15 < 1 CASES = [
16 < 1     ("todo.json", 0, ["SCREENS ok: todo"]),
17 < 1     ("todo_buttons_outside.json", 1, MISSING + ["SCREENS exit 1: 3 finding(s)"]),
19 > 1     ("todo_root_missing.json", 1, ['SCREENS screen: root "nope" is no element',
20 < 1                                     'SCREENS screen: form: child "ghost" is no element'] + MISSING
18 < 2     ("todo_root_missing.json", 1, ['SCREENS todo: root "nope" is no element',
19 < 2                                     'SCREENS todo: form: child "ghost" is no element'] + MISSING
20 < 1      + ["SCREENS exit 1: 5 finding(s)"]),
22 > 1     ("todo_props_missing.json", 1, ["SCREENS screen: add: ActionButton needs prop label",
23 < 1                                      "SCREENS screen: heading: Heading needs prop text",
21 < 2     ("todo_props_missing.json", 1, ["SCREENS todo: add: ActionButton needs prop label",
22 < 2                                      "SCREENS todo: heading: Heading needs prop text",
23 < 1                                      "SCREENS exit 1: 2 finding(s)"]),
24 < 1     ("todo_root_hidden.json", 1, MISSING + ["SCREENS exit 1: 3 finding(s)"]),
25 < 1 ]
