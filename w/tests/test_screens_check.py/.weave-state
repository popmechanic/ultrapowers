49 < 1 def _screens(app, spec):
51 > 1     with open(os.path.join(app, SCREEN), "w") as f:
50 < 2     with open(os.path.join(app, "client/src/pieces/todo.json"), "w") as f:
51 < 1         json.dump(spec, f)
52 < 1     r = subprocess.run(["bun", SCREENS, "--bundle", TODO, "--copy", app], capture_output=True, text=True, timeout=120)
53 < 1     return r.returncode, r.stdout.splitlines()
54 < 1 
