0 < 1 """The stories-v1 parser, reached through plan_parse.py as the sandbox runs it."""
1 < 1 import json
2 < 1 import subprocess
3 < 1 import sys
4 < 1 from pathlib import Path
5 < 1 
6 < 1 ROOT = Path(__file__).resolve().parents[1]
7 < 1 sys.path.insert(0, str(ROOT / "skills/ultrapowers/scripts"))
8 < 1 import plan_parse  # noqa: E402
9 < 1 
10 < 1 PARSER = ROOT / "skills/ultrapowers/scripts/plan_parse.py"
11 < 1 FIXTURE = ROOT / "evals/fixtures/stories/todo/.ultrapowers/plan.md"
12 < 1 
13 < 1 
14 < 1 def parse(tmp_path, text):
15 < 1     p = tmp_path / "plan.md"
16 < 1     p.write_text(text, encoding="utf-8")
17 < 1     return subprocess.run([sys.executable, str(PARSER), str(p)], capture_output=True, text=True)
18 < 1 
19 < 1 
20 < 1 def plan_text():
21 < 1     return FIXTURE.read_text(encoding="utf-8")
22 < 1 
23 < 1 
24 < 1 def test_plan_parse_dispatches_a_stories_plan(tmp_path):
25 < 1     res = parse(tmp_path, plan_text())
26 < 1     assert res.returncode == 0, res.stderr
27 < 1     got = json.loads(res.stdout)
28 < 1     assert (got["grammar"], got["stack"], got["plan_id"], got["kind"]) == ("stories-v1", "tinyapp", "p1", "behaviour")
29 < 1     assert [s["id"] for s in got["stories"]] == ["S1", "S2", "S3", "S4"]
30 < 1     t = got["tasks"][0]
31 < 1     assert t["piece"] == "todo" and t["actions"] == ["addTodo", "completeTodo", "deleteTodo"]
32 < 1     assert len(t["probes"]) == 4 and t["proofRuns"] == []
33 < 1     assert t["files"] == ["client/src/pieces/todo.json"]
35 > 1     assert t["wave"] == 1 and got["width"] == 1 and got["bootstrapCmd"] == "bun install"
34 < 2     assert got["launch_waves"][0][0]["id"] == "1" and got["bootstrapCmd"] == "bun install"
35 < 1 
36 < 1 
37 < 1 def test_depends_on_pieces_becomes_edges(tmp_path):
38 < 1     text = plan_text() + ("\n### Task 2: The tag piece\n\n**Piece:** tag\n**Depends-on-pieces:** todo\n"
39 < 1                           "**Files:**\n- Create: `client/src/pieces/tag.json`\n**Purpose:** x\n"
40 < 1                           "**Actions:**\n**Stories:**\n**Proof:**\n")
41 < 1     got = json.loads(parse(tmp_path, text).stdout)
42 < 1     assert got["dag_edges"] == [{"from": "1", "to": "2", "why": "piece tag depends on todo"}]
44 > 1     assert [t["wave"] for t in got["tasks"]] == [1, 2] and got["width"] == 1
43 < 2     assert [[t["id"] for t in w] for w in got["launch_waves"]] == [["1"], ["2"]]
44 < 1     assert got["tasks"][1]["depends_on"] == ["1"]
45 < 1 
46 < 1 
47 < 1 def test_a_malformed_probe_is_refused(tmp_path):
48 < 1     text = plan_text().replace('"layer":"ui"', '"layer":"db"', 1)
49 < 1     res = parse(tmp_path, text)
50 < 1     assert res.returncode == 2 and "layer must be store, ui or saved" in res.stderr
51 < 1 
52 < 1 
53 < 1 def test_an_unknown_stack_is_refused(tmp_path):
54 < 1     res = parse(tmp_path, plan_text().replace("**Stack:** tinyapp", "**Stack:** rails"))
55 < 1     assert res.returncode == 2 and "grammar: Stack rails is not one this plugin knows" in res.stderr
56 < 1 
57 < 1 
58 < 1 def test_claims_plans_still_parse_as_before():
59 < 1     assert plan_parse.plan_grammar("**Grammar:** claims-v1\n") == "claims-v1"
60 < 1     assert plan_parse.plan_grammar("**Grammar:** stories-v1\n") == "stories-v1"
61 < 1     assert plan_parse.plan_grammar("# nothing\n") is None
62 < 1 
63 < 1 
64 < 1 def test_plan_parse_alone_in_a_temp_dir_still_parses_a_claims_plan(tmp_path):
65 < 1     # fleet/compiler.mjs fetches plan_parse.py alone into a temp dir; it must not need stories_parse there.
66 < 1     import shutil
67 < 1     shutil.copy(PARSER, tmp_path / "plan_parse.py")
68 < 1     res = subprocess.run([sys.executable, str(tmp_path / "plan_parse.py"),
69 < 1                           str(ROOT / "evals/fixtures/claims/plan.md")], capture_output=True, text=True)
70 < 1     assert res.returncode == 0, res.stderr
72 > 1     assert "width" in json.loads(res.stdout)
71 < 2     assert "launch_waves" in json.loads(res.stdout)
72 < 1 