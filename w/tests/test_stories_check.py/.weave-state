39 < 1 def test_a_probe_naming_an_unlisted_tool_is_refused(tmp_path):
40 < 1     _, plan = compiled(tmp_path)
41 < 1     t = plan.read_text(encoding="utf-8").replace("- `addTodo` —", "- `createTodo` —")
42 < 1     plan.write_text(t, encoding="utf-8")
43 < 1     res = check(plan)
44 < 1     assert res.returncode == 2
45 < 1     assert "task 1 probe S2.2: names tool addTodo, which no task's Actions list" in res.stdout
