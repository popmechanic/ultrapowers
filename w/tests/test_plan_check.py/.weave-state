161 < 1 ROOT = pathlib.Path(__file__).resolve().parents[1]
162 < 1 COMPILER = ROOT / "skills/ultrapowers/scripts/plan_check.py"
163 < 1 
164 < 1 sys.path.insert(0, str(ROOT / "skills/ultrapowers/scripts"))
165 < 1 import plan_check  # noqa: E402
166 < 1 import plan_parse  # noqa: E402
167 < 1 
168 < 1 sys.path.insert(0, str(ROOT / "skills/ultrawrite/scripts"))
169 < 1 from extract_gate_input import gate_input, verdicts_path  # noqa: E402
