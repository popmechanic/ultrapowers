890 < 1 # ########################################################################### #
891 < 1 # The authoring record                                                        #
892 < 1 # ########################################################################### #
893 < 1 
894 < 1 # --------------------------------------------------------------------------- #
895 < 1 # The plan. One claims-v1 task carrying the fixed grammar the compiler         #
896 < 1 # requires — the header, the six body slots, a numbered Machine clause, a      #
897 < 1 # cited leg, a provenance tag, a predicate Stale-if whose path is absent from  #
898 < 1 # the temp repository, so no plan below is refused for anything but its        #
899 < 1 # record.                                                                      #
900 < 1 # --------------------------------------------------------------------------- #
901 < 1 
902 < 1 PLAN = """# Authoring record probe
903 < 1 
904 < 1 **Grammar:** claims-v1
905 < 1 
906 < 1 **Acceptance:** waived — exam fixture; this plan is compiled, never executed
907 < 1 
908 < 1 **Claim:** An operator compiling this plan is told what the sitting cost. (elicited)
909 < 1 
910 < 1 ### Task 1: The sim
911 < 1 
912 < 1 **Type:** implementation
913 < 1 
914 < 1 **Files:**
915 < 1 - Modify: `fleet/tests/sim_probe.mjs`
916 < 1 
917 < 1 **Claim:** An operator running the sim sees it pass. (derived)
918 < 1 Machine: M1. The sim prints `PASSED`.
919 < 1 
920 < 1 **Authorized-by:** #988
921 < 1 
922 < 1 **Interfaces:**
923 < 1 - Consumes: nothing
924 < 1 - Produces: nothing
925 < 1 
926 < 1 **Context:** The sim is a standalone script with no registry to update.
927 < 1 
928 < 1 **Proof:**
929 < 1 - The suite asserts the sim prints `PASSED`. [M1]
930 < 1 
931 < 1 **Stale-if:**
932 < 1 - path-exists: `fleet/tests/sim_probe.mjs`
933 < 1 """
934 < 1 
935 < 1 # The Context's example record, verbatim, and the `tally` it is read beside.
936 < 1 AUTHORING = {
937 < 1     "minutes": 118,
938 < 2     "probes": 12,
939 < 1     "routing": {"branch": "risk", "lane": "ultrapowers"},
940 < 1     "questions": [{"question": "Claim and summary", "options": ["A", "B"],
941 < 1                    "recommended": "A", "picked": "A"}],
942 < 1 }
943 < 1 TALLY = {"dispatched": 4, "rejected": 1}
944 < 1 
945 < 1 # M1's line for that pair, exactly as the Context writes it.
947 > 1 EXAMPLE_LINE = ("AUTHORING fact: 118 min to PLAN OK, "
946 < 2 EXAMPLE_LINE = ("AUTHORING fact: 118 min to PLAN OK, 12 hub probes, "
947 < 1                 "4 gate dispatches, 1 rejected, routing risk->ultrapowers, "
948 < 1                 "1 questions, 1/1 recommended picked, 0 explain rounds")
949 < 1 # M2's line for a record with no `authoring` key.
950 < 1 NONE_LINE = "AUTHORING fact: none recorded"
951 < 1 
952 < 1 FACT_PREFIX = "AUTHORING fact:"
953 < 1 
954 < 1 
955 < 1 def record(authoring=..., tally=TALLY):
956 < 1     """The gate-verdict record minus its `tasks` key (which is hashed per
957 < 1     plan). `authoring` omitted entirely when passed as None."""
958 < 1     rec = {}
959 < 1     if tally is not None:
960 < 1         rec["tally"] = copy.deepcopy(tally)
961 < 1     if authoring is ...:
962 < 1         authoring = AUTHORING
963 < 1     if authoring is not None:
964 < 1         rec["authoring"] = copy.deepcopy(authoring)
965 < 1     return rec
966 < 1 
967 < 1 
968 < 1 def run_compiler(plan, *flags):
969 < 1     return subprocess.run([sys.executable, str(COMPILER), str(plan), *flags],
970 < 1                           capture_output=True, text=True)
971 < 1 
972 < 1 
973 < 1 def check(dirpath, name, rec, *flags):
974 < 1     return run_compiler(write_plan(dirpath, name, PLAN, rec), *flags)
975 < 1 
976 < 1 
977 < 1 def carrying_lines(stdout):
978 < 1     """Every line mentioning the fact prefix anywhere, so leg (d)'s "zero
979 < 1     lines containing `AUTHORING fact:`" is read as written."""
980 < 1     return [line for line in stdout.splitlines() if FACT_PREFIX in line]
981 < 1 
982 < 1 
983 < 1 def assert_one_fact_after_the_verdict(p, expected):
984 < 1     """[M1]/[M2]: exit 0, `PLAN OK` as the first stdout line, and exactly one
985 < 1     `AUTHORING fact:` line — equal to `expected` in full, and printed after
986 < 1     the verdict line."""
987 < 1     out = p.stdout + p.stderr
988 < 1     assert p.returncode == 0, out
989 < 1     assert p.stdout.splitlines()[:1] == ["PLAN OK"], out
990 < 1     lines = p.stdout.splitlines()
991 < 1     assert fact_lines(p.stdout, FACT_PREFIX) == [expected], out
992 < 1     assert lines.index(expected) > lines.index("PLAN OK"), out
993 < 1 
994 < 1 
995 < 1 # ── (a) M1: the well-formed record prints the Context's example line ────────
996 < 1 # "a claims-v1 plan whose `<stem>.gate-verdicts.json` carries a well-formed
997 < 1 # top-level `authoring` object prints, after the verdict line, exactly one line
999 > 1 # of the form `AUTHORING fact: <minutes> min to PLAN OK, 
998 < 2 # of the form `AUTHORING fact: <minutes> min to PLAN OK, <probes> hub probes,
999 < 1 # <dispatched> gate dispatches, <rejected> rejected, routing <branch>-><lane>,
1000 < 1 # <n> questions, <p>/<q> recommended picked, <e> explain rounds` ... and the
1001 < 1 # compile still exits 0 with `PLAN OK`."
1002 < 1 
1003 < 1 def test_a_the_example_record_prints_the_example_line(tmp_path):
1004 < 1     """(a)/[M1]: the Context's example `authoring` object beside a `tally` of
1005 < 1     dispatched 4 / rejected 1, compiled `--check --base <head>` inside a
1006 < 1     one-commit repository — exit 0, `PLAN OK` first, and exactly one
1007 < 1     `AUTHORING fact:` line, the Context's example line verbatim."""
1008 < 1     repo, head = base_repo(tmp_path)
1009 < 1     p = check(repo, "a.md", record(), "--base", head)
1010 < 1     assert_one_fact_after_the_verdict(p, EXAMPLE_LINE)
1011 < 1 
1012 < 1 
1013 < 1 # ── (b) M1: the tally's absent key, and the question counts ─────────────────
1014 < 1 # "`<dispatched>` and `<rejected>` read from the record's `tally` (`-` when the
1015 < 1 # key is absent), `<n>` the length of `questions`, `<q>` the count of questions
1016 < 1 # whose `recommended` is not null and `<p>` the count of those whose `picked`
1017 < 1 # equals `recommended`."
1018 < 1 
1020 > 1 REJECTED_ABSENT_LINE = ("AUTHORING fact: 118 min to PLAN OK, "
1019 < 2 REJECTED_ABSENT_LINE = ("AUTHORING fact: 118 min to PLAN OK, 12 hub probes, "
1020 < 1                         "4 gate dispatches, - rejected, "
1021 < 1                         "routing risk->ultrapowers, "
1022 < 1                         "1 questions, 1/1 recommended picked, "
1023 < 1                         "0 explain rounds")
1024 < 1 
1025 < 1 # One question carrying no recommended option, one whose pick is the
1026 < 1 # recommendation: two questions, one of them recommended, that one picked.
1027 < 1 TWO_QUESTIONS = [
1028 < 1     {"question": "Claim and summary", "options": ["A", "B"],
1029 < 1      "recommended": None, "picked": "B", "explain_rounds": 2},
1030 < 1     {"question": "Routing", "options": ["A", "B"],
1031 < 1      "recommended": "A", "picked": "A"},
1032 < 1 ]
1034 > 1 TWO_QUESTIONS_LINE = ("AUTHORING fact: 118 min to PLAN OK, "
1033 < 2 TWO_QUESTIONS_LINE = ("AUTHORING fact: 118 min to PLAN OK, 12 hub probes, "
1034 < 1                       "4 gate dispatches, 1 rejected, "
1035 < 1                       "routing risk->ultrapowers, "
1036 < 1                       "2 questions, 1/1 recommended picked, "
1037 < 1                       "2 explain rounds")
1038 < 1 
1039 < 1 
1040 < 1 def test_b_a_tally_without_rejected_prints_a_dash(tmp_path):
1041 < 1     """(b)/[M1]: the same record with `tally` lacking `rejected` — the line is
1042 < 1     the example line with `- rejected` in place of `1 rejected`."""
