514 < 1 def test_d_check_at_base_prints_the_same_two_lines(tmp_path):
515 < 1     """(d)/[M4]: "from the `--check --base` stdout alike" — the same two
516 < 1     lines, in the same order, on the compiler's own stdout."""
517 < 1     repo, head = base_repo(tmp_path)
518 < 1     p = check_at(repo, "d2.md", PLAN_D, "--base", head)
519 < 1     assert p.returncode == 0, p.stdout + p.stderr
