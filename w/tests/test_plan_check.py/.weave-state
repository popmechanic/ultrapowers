523 < 1 
524 < 1 
525 < 1 # =========================================================================== #
526 < 1 # (e)/[M5] — the timeout line, the bound, and the killed process group         #
527 < 1 # =========================================================================== #
528 < 1 # "(e) `green_at_base_lines` with `timeout_s=1` on a task whose `Run:` is
529 < 1 # `sleep 30` returns `GREEN-AT-BASE fact: task 1: Run: sleep 30 — not run
530 < 1 # (timeout after 1 s)`, the call returns in under 4 seconds by
531 < 1 # `time.monotonic()`, and afterwards no `sleep 30` process the call started is
532 < 1 # alive [M5]"
533 < 1 
534 < 1 # The sleeper carries a fraction no other worker is using, so `ps` can tell
535 < 1 # THIS test's `sleep` from the one a sibling pytest worker is running at the
536 < 1 # same moment (#1120): a bare `sleep 30` is indistinguishable across workers,
537 < 1 # and the before/after diff then counts a sibling's sleeper as a leftover.
538 < 1 # `sleep` takes a fractional argument on macOS and on GNU coreutils alike, and
539 < 1 # any value over the 1-second limit exercises the same kill path.
540 < 1 SLEEPER = "sleep 30.%03d" % (os.getpid() % 1000)
541 < 1 PLAN_E = make_plan(runs=run_bullets(SLEEPER))
542 < 1 
543 < 1 
544 < 1 def sleeper_pids():
545 < 1     """Every live process whose command line is exactly this test's sleeper."""
546 < 1     p = subprocess.run(["ps", "-eo", "pid=,args="],
547 < 1                        capture_output=True, text=True)
548 < 1     pids = set()
549 < 1     for line in p.stdout.splitlines():
550 < 1         pid, _, args = line.strip().partition(" ")
551 < 1         if args.strip() == SLEEPER:
552 < 1             pids.add(pid)
553 < 1     return pids
554 < 1 
555 < 1 
556 < 1 def test_e_a_command_past_the_limit_is_killed_and_reported(tmp_path):
557 < 1     """(e)/[M5]: the exact line, the 3-second bound over a 1-second limit, and
558 < 1     no `sleep 30` this call started left alive — `killpg`, not `kill`."""
559 < 1     assert shutil.which("ps"), "the exam needs a real `ps` to see the sleeper"
560 < 1     repo, _head = base_repo(tmp_path)
561 < 1     before = sleeper_pids()
562 < 1     started = time.monotonic()
563 < 1     lines = green_lines(repo, "e.md", PLAN_E, timeout_s=1)
564 < 1     elapsed = time.monotonic() - started
565 < 1     assert command_facts(lines) == [TIMEOUT_LINE % ("1", SLEEPER, 1)], lines
566 < 1     assert elapsed < 4, elapsed
567 < 1     leftover = sleeper_pids() - before
568 < 1     for _ in range(20):
569 < 1         if not leftover:
570 < 1             break
571 < 1         time.sleep(0.1)
572 < 1         leftover = sleeper_pids() - before
573 < 1     assert not leftover, (
574 < 1         "a `sleep 30` this call started outlived it: %s" % sorted(leftover))
575 < 1 
576 < 1 
577 < 1 # =========================================================================== #
578 < 1 # (f)/[M6] — the reading line, in all three shapes                             #
579 < 1 # =========================================================================== #
580 < 1 # "(f) the same call's last line is `GREEN-AT-BASE fact: <S> s over 0 lines
581 < 1 # run, 1 not run (timeout)` with `<S>` matching `[0-9]+\\.[0-9]`, the leg (d)
582 < 1 # call's last line is `GREEN-AT-BASE fact: <S> s over 3 lines run, 0 not run
583 < 1 # (timeout)`, and a task with no `Run:` line returns exactly one line,
584 < 1 # `GREEN-AT-BASE fact: 0.0 s over 0 lines run, 0 not run (timeout)` [M6]"
585 < 1 
586 < 1 PLAN_F_NO_RUNS = make_plan()
587 < 1 
588 < 1 
589 < 1 def assert_reading(line, ran, timed_out):
590 < 1     m = READING_RE.match(line)
591 < 1     assert m, "not M6's reading line: %r" % line
592 < 1     assert (m.group(2), m.group(3)) == (str(ran), str(timed_out)), line
593 < 1     return m.group(1)
594 < 1 
595 < 1 
