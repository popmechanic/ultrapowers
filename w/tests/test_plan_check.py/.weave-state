870 < 1 
871 < 1 def test_d_freeze_violations_answers_m1_m2_m3_from_plain_dicts_alone():
872 < 1     """[M4]: called directly on plain `checks`/`tasks` dicts — no `tmp_path`,
873 < 1     no git, no subprocess anywhere in this test — `freeze_violations`
874 < 1     reproduces the M1, M2 and M3 verdicts on its own, which is what "reads
875 < 1     only the strings the parser printed" means in practice."""
876 < 1     m1 = plan_check.freeze_violations([fake_check(CMD_M1)], [TASK1])
877 < 1     assert len(m1) == 1, m1
878 < 1     for token in (CMD_M1, "fleet/", "task 1", "fleet/tests/test_x.mjs"):
879 < 1         assert token in m1[0], "%r missing from: %r" % (token, m1[0])
880 < 1 
881 < 1     assert plan_check.freeze_violations([fake_check(CMD_M2)], [TASK1]) == [], (
882 < 1         plan_check.freeze_violations([fake_check(CMD_M2)], [TASK1]))
883 < 1 
884 < 1     m3 = plan_check.freeze_violations([fake_check(CMD_M3)], [TASK1])
885 < 1     assert m3, "expected a violation for a pathspec equal to the task's path"
886 < 1     assert any(all(tok in line for tok in
887 < 1                    ("freezes", "src/prover.ts", "task 1")) for line in m3), m3
