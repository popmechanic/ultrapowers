1086 < 1 # ── (d) M2: a bare `--check` prints no fact line at all ─────────────────────
1087 < 1 # "a bare `--check` of either record prints no line beginning `AUTHORING
1088 < 1 # fact:` at all."
1089 < 1 
1090 < 1 @pytest.mark.parametrize("label,authoring", [
1091 < 1     ("with the authoring key", AUTHORING),
1092 < 1     ("without the authoring key", None),
1093 < 1 ])
1094 < 1 def test_d_a_bare_check_prints_no_fact_line(tmp_path, label, authoring):
1095 < 1     """(d)/[M2]: with no `--base` there is no tree to cost a sitting against —
1096 < 1     zero lines containing `AUTHORING fact:`, either way. And the bare verdict
1097 < 1     is the unchanged one the global constraint pins: stdout is `PLAN OK` and
1098 < 1     nothing else."""
1099 < 1     p = check(tmp_path, "d.md", record(authoring=authoring))
1100 < 1     out = p.stdout + p.stderr
1101 < 1     assert p.returncode == 0, out
1102 < 1     assert carrying_lines(p.stdout) == [], out
1103 < 1     assert carrying_lines(p.stderr) == [], out
1104 < 1     assert p.stdout.strip() == "PLAN OK", out
