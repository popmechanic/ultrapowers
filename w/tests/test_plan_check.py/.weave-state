493 < 1 # yields, from `green_at_base_lines` and from the `--check --base` stdout
494 < 1 # alike, exactly `GREEN-AT-BASE fact: task 1: Run: true — exits 0 at BASE; this
495 < 1 # line cannot falsify its clause` and `GREEN-AT-BASE fact: task 1: Run: true —
496 < 1 # exits 0 at BASE; a guard, no leg cites it` in that order and no line naming
497 < 1 # `false` [M4]"
498 < 1 
499 < 1 RUNS_D = run_bullets("true [M1]", "true", "false")
500 < 1 PLAN_D = make_plan(runs=RUNS_D)
501 < 1 EXPECTED_D = [PROVER_LINE % ("1", "true"), GUARD_LINE % ("1", "true")]
502 < 1 
