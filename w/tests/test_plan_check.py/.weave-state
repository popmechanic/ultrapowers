1107 < 1 # ── (e) #1440: the record is telemetry — a malformed one reads `-`, never refuses ──
1108 < 1 
1109 < 1 def _odd():
1110 < 1     """Every field the fact line reads, said oddly or not at all."""
1111 < 1     a = copy.deepcopy(AUTHORING)
1112 < 1     a["minutes"] = "12"
1113 < 2     a["probes"] = -1
1114 < 1     del a["routing"]
1115 < 1     a["questions"] = [{"question": "q", "options": ["only"], "picked": "C"}, "not a row"]
1116 < 1     return a
1117 < 1 
1118 < 1 
1119 < 1 def test_e_a_malformed_record_reads_dashes_and_is_not_refused(tmp_path):
1121 > 1     """(e) #1440: an odd `minutes`, no `routing` and a non-object
1120 < 2     """(e) #1440: odd `minutes`/`probes`, no `routing` and a non-object
1121 < 1     question row — exit 0, `PLAN OK`, and one fact line reading each unsaid
1122 < 1     field as `-` and skipping the row that is not an object."""
1123 < 1     repo, head = base_repo(tmp_path)
1124 < 1     p = check(repo, "e.md", record(authoring=_odd()), "--base", head)
1125 < 1     assert_one_fact_after_the_verdict(
1127 > 1         p, "AUTHORING fact: - min to PLAN OK, 4 gate dispatches, "
1126 < 2         p, "AUTHORING fact: - min to PLAN OK, - hub probes, 4 gate dispatches, "
1127 < 1            "1 rejected, routing -->-, 1 questions, 0/0 recommended picked, "
1128 < 1            "0 explain rounds")
