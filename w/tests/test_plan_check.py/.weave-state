735 < 1 # The run-wide freeze                                                         #
736 < 1 # ########################################################################### #
737 < 1 
738 < 1 # --------------------------------------------------------------------------- #
739 < 1 # The plan: one signed claims-v1 task, `## Global Constraints` varying only   #
740 < 1 # in its one `- Check:` bullet — the three commands M1, M2 and M3 each name.  #
741 < 1 # --------------------------------------------------------------------------- #
742 < 1 
743 < 1 FREEZE_HEAD = """# Freeze probe
744 < 1 
745 < 1 **Grammar:** claims-v1
746 < 1 
747 < 1 **Acceptance:** waived — exam fixture; this plan is compiled, never executed
748 < 1 
749 < 1 **Claim:** An operator's run-wide freeze never covers a task's own Files. (elicited)
750 < 1 """
751 < 1 
752 < 1 FREEZE_TASK = """
753 < 1 ### Task 1: The frozen file
754 < 1 
755 < 1 **Type:** implementation
756 < 1 
757 < 1 **Files:**
758 < 1 - Modify: `src/prover.ts`
759 < 1 - Create: `fleet/tests/test_x.mjs`
760 < 1 
761 < 1 **Claim:** An operator's patch lands without the run-wide freeze going red. (derived)
762 < 1 Machine: M1. The freeze check does not cover the task's own paths.
763 < 1 
764 < 1 **Authorized-by:** #1202
765 < 1 
766 < 1 **Interfaces:**
767 < 1 - Consumes: nothing
768 < 1 - Produces: nothing
769 < 1 
770 < 1 **Context:** The prover is a standalone module with no registry to update.
771 < 1 
772 < 1 **Proof:**
773 < 1 - (a) The suite asserts the prover compiles. [M1]
774 < 1 
775 < 1 **Stale-if:**
776 < 1 - sha-matches: `at-base.txt`
777 < 1 """
778 < 1 
779 < 1 # The three commands the Machine clauses name, verbatim.
780 < 1 CMD_M1 = "git diff --quiet $ULTRA_BASE -- fleet/"
781 < 1 CMD_M2 = "git diff --quiet $ULTRA_BASE -- fleet/launch.mjs fleet/te"
782 < 1 CMD_M3 = "git diff --quiet $ULTRA_BASE -- docs src/prover.ts"
783 < 1 
784 < 1 
786 > 1 def run_plan_check(tmp_path, name, text):
785 < 2 def compile_plan(tmp_path, name, text):
786 < 1     """`plan_check.py <plan>` — no `--base`: the Context says this refusal
787 < 1     needs no repository, and none is set up here."""
788 < 1     plan = write_plan(tmp_path, name, text)
789 < 1     return subprocess.run([sys.executable, str(COMPILER), str(plan)],
790 < 1                           capture_output=True, text=True)
791 < 1 
792 < 1 
793 < 1 def freeze_lines(stdout):
794 < 1     """Every stdout line carrying the word `freezes`."""
795 < 1     return [line for line in stdout.splitlines() if "freezes" in line]
796 < 1 
