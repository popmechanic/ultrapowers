1063 < 1     authoring = copy.deepcopy(AUTHORING)
1064 < 1     authoring["questions"] = [{"question": "which features", "options":
1065 < 1                                ["rename", "sort", "tags", "none"],
1066 < 1                                "recommended": "sort",
1067 < 1                                "picked": ["rename", "sort"]}]
1068 < 1     p = check(repo, "b3.md", record(authoring=authoring), "--base", head)
1069 < 1     assert_one_fact_after_the_verdict(
1070 < 1         p, EXAMPLE_LINE)  # 1 questions, 1/1 recommended picked
1071 < 1 
1072 < 1 
1073 < 1 # ── (c) M2: no record, one `none recorded` line ─────────────────────────────
1074 < 1 # "The same `--check --base <sha>` compile of a record with no `authoring` key
1075 < 1 # exits 0 with `PLAN OK` and prints exactly one line `AUTHORING fact: none
