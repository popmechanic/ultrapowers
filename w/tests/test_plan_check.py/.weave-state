1044 < 1     p = check(repo, "b1.md", record(tally={"dispatched": 4}), "--base", head)
1045 < 1     assert_one_fact_after_the_verdict(p, REJECTED_ABSENT_LINE)
1046 < 1 
1047 < 1 
1048 < 1 def test_b_two_questions_count_only_the_recommended_ones(tmp_path):
1049 < 1     """(b)/[M1]: two questions, one with `recommended` null and one picked
1050 < 1     equal to its recommendation — `2 questions, 1/1 recommended picked`."""
