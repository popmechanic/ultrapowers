174 < 1 # ########################################################################### #
175 < 1 # GREEN-AT-BASE                                                               #
176 < 1 # ########################################################################### #
177 < 1 
178 < 1 
179 < 1 # --------------------------------------------------------------------------- #
180 < 1 # The lines M4, M5 and M6 pin, as format strings. Every assertion below builds  #
181 < 1 # its expectation from these, so a line is compared whole and not by fragment.  #
182 < 1 # --------------------------------------------------------------------------- #
183 < 1 
184 < 1 FACT = "GREEN-AT-BASE fact: "
185 < 1 
186 < 1 PROVER_LINE = (FACT + "task %s: Run: %s — exits 0 at BASE; "
187 < 1                "this line cannot falsify its clause")
188 < 1 GUARD_LINE = (FACT + "task %s: Run: %s — exits 0 at BASE; "
189 < 1               "a guard, no leg cites it")
190 < 1 TIMEOUT_LINE = FACT + "task %s: Run: %s — not run (timeout after %s s)"
191 < 1 READING_LINE = FACT + "%s s over %s lines run, %s not run (timeout)"
192 < 1 # M6's `<S>`, as leg (f) words it: one or more digits, a point, one digit.
193 < 1 READING_RE = re.compile(
194 < 1     r"^GREEN-AT-BASE fact: ([0-9]+\.[0-9]) s over (\d+) lines run, "
195 < 1     r"(\d+) not run \(timeout\)$")
196 < 1 
197 < 1 # M2's refusal, with the span `clause_citation_violations` already prints.
198 < 1 UNKNOWN_CLAUSE_LINE = ("grammar: Run: cites an unknown clause — task %s: %s "
199 < 1                        "cites %s; the Machine line numbers %s")
200 < 1 NO_CITING_LEG = "Machine clause %s has no citing Proof leg"
201 < 1 
202 < 1 
203 < 1 # --------------------------------------------------------------------------- #
204 < 1 # The plan. One task, id 1, parameterized on the three things these legs vary:  #
205 < 1 # the Machine clauses, the Proof `Run:` lines, and the prose legs. Everything   #
206 < 1 # else is the fixed claims-v1 grammar the compiler requires.                    #
207 < 1 # --------------------------------------------------------------------------- #
208 < 1 
209 < 1 HEAD = """# Green probe
210 < 1 
211 < 1 **Grammar:** claims-v1
212 < 1 
213 < 1 **Acceptance:** waived — exam fixture; this plan is compiled, never executed
214 < 1 
215 < 1 **Claim:** An operator gets a reading of which proofs already pass at BASE. (elicited)
216 < 1 """
217 < 1 
218 < 1 TASK = """
219 < 1 ### Task 1: The prover
220 < 1 
221 < 1 **Type:** implementation
222 < 1 
223 < 1 **Files:**
224 < 1 - Modify: `src/prover.ts`
225 < 1 
226 < 1 **Claim:** An operator running the prover sees it pass. (derived)
227 < 1 Machine: {machine}
228 < 1 
229 < 1 **Authorized-by:** #1098
230 < 1 
231 < 1 **Interfaces:**
232 < 1 - Consumes: nothing
233 < 1 - Produces: nothing
234 < 1 
235 < 1 **Context:** The prover is a standalone module with no registry to update.
236 < 1 
237 < 1 **Proof:**
238 < 1 {runs}{legs}
239 < 1 
240 < 1 **Stale-if:**
241 < 1 - {stale}
242 < 1 """
243 < 1 
244 < 1 ONE_CLAUSE = "M1. The prover exits 0."
245 < 1 TWO_CLAUSES = "M1. The prover exits 0. M2. The prover prints nothing."
246 < 1 
247 < 1 LEG_M1 = "- (a) The suite asserts the prover exits 0. [M1]"
248 < 1 LEGS_M1_M2 = ("- (a) The suite asserts the prover exits 0. [M1]\n"
249 < 1               "- (b) The suite asserts the prover prints nothing. [M2]")
250 < 1 # A prose leg citing a ninth clause the Machine line does not number: the
251 < 1 # refusal leg (g)'s last witness needs, drawn by the leg grammar that already
252 < 1 # exists at BASE.
253 < 1 LEGS_M1_AND_M9 = ("- (a) The suite asserts the prover exits 0. [M1]\n"
254 < 1                   "- (b) The suite asserts the ninth thing. [M9]")
255 < 1 
256 < 1 # The file the one-commit repository holds, and an entry the Stale-if machine
257 < 1 # cannot decide — `sha-matches:` with no `@` pins no id — so every
258 < 1 # `--check --base` fixture below prints one `STALE fact:` advisory. That
259 < 1 # advisory is what leg (g)'s ordering is measured against.
260 < 1 AT_BASE = "at-base.txt"
261 < 1 STALE_ADVISORY = "sha-matches: `%s`" % AT_BASE
262 < 1 
263 < 1 
264 < 1 def make_plan(check=None, machine=ONE_CLAUSE, runs="", legs=LEG_M1,
265 < 1               stale=STALE_ADVISORY):
266 < 1     """The one-task claims-v1 plan. With `check`, the freeze section's plan:
267 < 1     `FREEZE_HEAD`, a `## Global Constraints` whose one `- Check:` bullet is
268 < 1     `check`, then `FREEZE_TASK`. Without it, the GREEN-AT-BASE plan
269 < 1     parameterized on its Machine clauses, `Run:` lines, prose legs and
270 < 1     Stale-if entry."""
271 < 1     if check is not None:
272 < 1         constraints = "\n## Global Constraints\n\n- Check: %s\n" % check
273 < 1         return FREEZE_HEAD + constraints + FREEZE_TASK
274 < 1     return HEAD + TASK.format(machine=machine, runs=runs, legs=legs,
275 < 1                               stale=stale)
276 < 1 
277 < 1 
278 < 1 def run_bullets(*commands):
279 < 1     """The Proof `Run:` bullets for `commands`, in Proof order."""
280 < 1     return "".join("- Run: %s\n" % c for c in commands)
281 < 1 
282 < 1 
283 < 1 # --------------------------------------------------------------------------- #
284 < 1 # The repository, the plan on disk, and the two ways the compiler is invoked.   #
285 < 1 # --------------------------------------------------------------------------- #
286 < 1 
287 < 1 def _git(repo, *args):
288 < 1     p = subprocess.run(["git", "-C", str(repo), *args],
289 < 1                        capture_output=True, text=True)
290 < 1     assert p.returncode == 0, " ".join(args) + "\n" + p.stdout + p.stderr
291 < 1     return p.stdout
292 < 1 
293 < 1 
294 < 1 def base_repo(tmp_path):
295 < 1     """A one-commit git repository whose commit holds `at-base.txt` and
296 < 1     nothing else, returned as (repo path, HEAD sha). The plan is written
297 < 1     inside it, so a 40-hex `--base` names a commit of the plan's own
298 < 1     repository — which is the repository M3's worktree is cut from."""
299 < 1     repo = tmp_path / "repo"
300 < 1     repo.mkdir()
301 < 1     _git(repo, "init", "-q", ".")
302 < 1     _git(repo, "config", "user.email", "exam@example.invalid")
303 < 1     _git(repo, "config", "user.name", "exam")
304 < 1     (repo / AT_BASE).write_text("at base\n")
305 < 1     _git(repo, "add", AT_BASE)
306 < 1     _git(repo, "commit", "-qm", "at base")
307 < 1     head = _git(repo, "rev-parse", "HEAD").strip()
308 < 1     assert re.fullmatch(r"[0-9a-f]{40}", head), head
309 < 1     return repo, head
310 < 1 
311 < 1 
312 < 1 def write_plan(dirpath, name, text, rec=None):
313 < 1     """The plan plus the gate-verdict artifact claims-v1 compiles against
315 > 1     (ultrawrite §The proof gate), hashed by the gate's own extractor so a fixture edit re-signs
314 < 2     (spec §4.5), hashed by the gate's own extractor so a fixture edit re-signs
315 < 1     itself rather than going stale against a hand-copied digest. `rec` is the
316 < 1     record's every key but `tasks` (the authoring section passes its own);
317 < 1     omitted, it is a one-dispatch, zero-rejection `tally`."""
318 < 1     plan = pathlib.Path(dirpath) / name
319 < 1     plan.write_text(text)
320 < 1     entry = gate_input(plan, "1")
321 < 1     full = ({"tally": {"dispatched": 1, "rejected": 0}} if rec is None
322 < 1             else dict(rec))
323 < 1     full["tasks"] = {"1": {"hash": entry["hash"], "verdict": "pass",
324 < 1                            "reason": "fixture"}}
325 < 1     verdicts_path(plan).write_text(json.dumps(full))
326 < 1     return plan
327 < 1 
328 < 1 
329 < 1 def compile_at(repo, name, text, *flags, env=None):
330 < 1     plan = write_plan(repo, name, text)
331 < 1     return subprocess.run([sys.executable, str(COMPILER), str(plan), *flags],
332 < 1                           capture_output=True, text=True,
333 < 1                           env=None if env is None else dict(os.environ, **env))
334 < 1 
335 < 1 
336 < 1 def check_at(repo, name, text, *flags, env=None):
337 < 1     return compile_at(repo, name, text, *flags, env=env)
338 < 1 
339 < 1 
340 < 1 def check_at_unsigned(repo, name, text, *flags):
341 < 1     """`check_at`, but with the gate-verdict record removed right after the
342 < 1     plan is signed and written — a refusal for a reason that has nothing to
343 < 1     do with the plan's own commands, which `gate_verdict_violations` already
344 < 1     refuses with `grammar: gate verdicts missing …`. Used by leg (g)'s
345 < 1     refused-plan-runs-nothing scenario."""
346 < 1     plan = write_plan(repo, name, text)
347 < 1     verdicts_path(plan).unlink()
348 < 1     return subprocess.run([sys.executable, str(COMPILER), str(plan),
349 < 1                            "--check", *flags],
350 < 1                           capture_output=True, text=True)
351 < 1 
352 < 1 
353 < 1 def tasks_of(text):
354 < 1     """The task dicts `main()` hands `green_at_base_lines`, built the way the
355 < 1     `--check` branch builds them."""
356 < 1     return plan_parse.parse_plan_full(text)[1]
357 < 1 
358 < 1 
359 < 1 def base_tree_for(plan):
360 < 1     """The `BaseTree` a 40-hex `--base` names for this plan — the same reader
361 < 1     the `--check` branch builds from the flag."""
362 < 1     repo = plan.parent
363 < 1     head = _git(repo, "rev-parse", "HEAD").strip()
364 < 1     return plan_check.BaseTree.from_flag(head, plan), head
365 < 1 
366 < 1 
367 < 1 def green_lines(repo, name, text, **kw):
368 < 1     """`green_at_base_lines` on a real plan, reached through the module so a
369 < 1     BASE tree fails here with `module 'plan_check' has no attribute
370 < 1     'green_at_base_lines'` — the absent implementation, not a bad import."""
371 < 1     plan = write_plan(repo, name, text)
372 < 1     base_tree, _head = base_tree_for(plan)
373 < 1     return plan_check.green_at_base_lines(tasks_of(text), base_tree, **kw)
374 < 1 
375 < 1 
376 < 1 def fact_lines(stdout, prefix=FACT):
377 < 1     """Every line beginning `prefix` — by default `GREEN-AT-BASE fact:`; the
378 < 1     authoring section passes `AUTHORING fact:` — in the order printed."""
379 < 1     return [line for line in stdout.splitlines() if line.startswith(prefix)]
380 < 1 
381 < 1 
382 < 1 def command_facts(lines):
383 < 1     """The per-command lines of M4/M5 — every fact line but M6's reading, which
384 < 1     names no `Run:`."""
385 < 1     return [line for line in lines if line.startswith(FACT) and "Run:" in line]
386 < 1 
387 < 1 
388 < 1 # =========================================================================== #
389 < 1 # (a)/[M1] — the tag is parsed off the command and recorded beside it          #
390 < 1 # =========================================================================== #
391 < 1 # "(a) `parse_task` on a task whose Proof carries `- Run: true [M1]`,
392 < 1 # `- Run: false [M1, M2]` and `- Run: true` records `proof_runs` as exactly
393 < 1 # `[\"true\", \"false\", \"true\"]` — no bracket in any command — and
394 < 1 # `proof_run_cites` as exactly `[[\"M1\"], [\"M1\", \"M2\"], []]` [M1]"
395 < 1 
396 < 1 RUNS_A = run_bullets("true [M1]", "false [M1, M2]", "true")
397 < 1 PLAN_A = make_plan(machine=TWO_CLAUSES, runs=RUNS_A, legs=LEGS_M1_M2)
398 < 1 
399 < 1 
400 < 1 # =========================================================================== #
401 < 1 # (b)/[M2] — an unknown clause is refused, and a tag cites nothing             #
402 < 1 # =========================================================================== #
403 < 1 # "(b) `--check` on a plan whose Machine line numbers M1 and M2 and whose Proof
404 < 1 # carries `- Run: true` tagged with the ninth clause, M9 in the bracket shape,
405 < 1 # exits 2 with the line `grammar: Run: cites an unknown clause — task 1: true
406 < 1 # cites M9; the Machine line numbers M1–M2` on stdout, and `--check` on a plan
407 < 1 # whose leg (a) cites `[M1]` alone while `- Run: true [M2]` is the only
408 < 1 # citation of M2 exits 2 carrying `Machine clause M2 has no citing Proof leg`
409 < 1 # — the tag satisfied nothing [M2]"
410 < 1 
411 < 1 PLAN_B_UNKNOWN = make_plan(machine=TWO_CLAUSES,
412 < 1                            runs=run_bullets("true [M9]"),
413 < 1                            legs=LEGS_M1_M2)
414 < 1 PLAN_B_TAG_IS_NO_LEG = make_plan(machine=TWO_CLAUSES,
415 < 1                                  runs=run_bullets("true [M2]"),
416 < 1                                  legs=LEG_M1)
417 < 1 
418 < 1 
419 < 1 # =========================================================================== #
420 < 1 # (c)/[M3] — one detached worktree at BASE, and nothing left of it             #
421 < 1 # =========================================================================== #
422 < 1 # "(c) in a one-commit repository whose commit holds `at-base.txt`, a plan
423 < 1 # whose `Run:` is `test -f at-base.txt && test \"$ULTRA_BASE\" = <head> && test
424 < 1 # \"$(git rev-parse HEAD)\" = <head> && test \"$PWD\" != <repo> && touch
425 < 1 # wrote-here.txt` yields that command's prover line under `--check --base
426 < 1 # <head>`, and afterwards `git -C <repo> worktree list --porcelain` names
427 < 1 # exactly one worktree (the repository itself), no directory named
428 < 1 # `ultra-green-` survives under the temp root, and `<repo>/wrote-here.txt` does
429 < 1 # not exist — the command ran at BASE, elsewhere than the checkout, and its
430 < 1 # worktree was removed with what it wrote [M3]"
431 < 1 
432 < 1 def witness_command(repo, head):
433 < 1     """The leg's command, with `<head>` and `<repo>` substituted."""
434 < 1     return ('test -f %s && test "$ULTRA_BASE" = %s && '
435 < 1             'test "$(git rev-parse HEAD)" = %s && test "$PWD" != "%s" && '
436 < 1             'touch wrote-here.txt' % (AT_BASE, head, head, repo))
437 < 1 
438 < 1 
439 < 1 def worktree_paths(repo):
440 < 1     """Every worktree `git` knows of for `repo`, by path."""
441 < 1     out = _git(repo, "worktree", "list", "--porcelain")
442 < 1     return [line.split(" ", 1)[1] for line in out.splitlines()
443 < 1             if line.startswith("worktree ")]
444 < 1 
445 < 1 
446 < 1 def test_c_the_run_line_runs_at_base_in_a_worktree_that_is_then_gone(tmp_path):
447 < 1     """(c)/[M3]: the command's own tests say where it ran — BASE's file
448 < 1     present, `ULTRA_BASE` and the worktree HEAD both the 40-hex commit, the
449 < 1     working directory not the repository — and the exam says what is left of
450 < 1     the worktree afterwards: nothing."""
451 < 1     repo, head = base_repo(tmp_path)
452 < 1     command = witness_command(repo, head)
453 < 1     tmpdir = tmp_path / "tmproot"
454 < 1     tmpdir.mkdir()
455 < 1     machine_root = pathlib.Path(tempfile.gettempdir())
456 < 1     before = sorted(machine_root.glob("ultra-green-*"))
457 < 1     p = check_at(repo, "c.md",
458 < 1                  make_plan(runs=run_bullets("%s [M1]" % command)),
459 < 1                  "--base", head, env={"TMPDIR": str(tmpdir)})
460 < 1     out = p.stdout + p.stderr
461 < 1     expected = PROVER_LINE % ("1", command)
462 < 1     assert expected in p.stdout.splitlines(), (
463 < 1         "stdout carried no prover line for the witness command.\n"
464 < 1         "expected: %s\nstdout:\n%s\nstderr:\n%s"
465 < 1         % (expected, p.stdout, p.stderr))
466 < 1     assert p.returncode == 0, out
467 < 1     # "git -C <repo> worktree list --porcelain names exactly one worktree"
468 < 1     paths = worktree_paths(repo)
469 < 1     assert len(paths) == 1, paths
470 < 1     assert pathlib.Path(paths[0]).resolve() == repo.resolve(), (paths, repo)
471 < 1     # "no directory named ultra-green- survives under the temp root" — the
472 < 1     # root the compile was handed, and the machine's own.
473 < 1     assert sorted(tmpdir.glob("ultra-green-*")) == [], sorted(
474 < 1         tmpdir.glob("ultra-green-*"))
475 < 1     # The machine's own temp root is shared with every other pytest worker, and
476 < 1     # a sibling's live worktree appears here between `before` and now — so this
477 < 1     # half is read only when this process is the whole suite (#1120). The
478 < 1     # handed root above is the assertion that holds either way, and it is the
479 < 1     # one that catches a leak the compile is responsible for.
480 < 1     if os.environ.get("PYTEST_XDIST_WORKER") is None:
481 < 1         assert sorted(machine_root.glob("ultra-green-*")) == before, (
482 < 1             "an ultra-green- directory survived under %s" % machine_root)
483 < 1     # "<repo>/wrote-here.txt does not exist" — --force took the worktree away
484 < 1     # with what the command wrote into it.
485 < 1     assert not (repo / "wrote-here.txt").exists(), (
486 < 1         "the command's file landed in the repository's own working tree")
487 < 1 
