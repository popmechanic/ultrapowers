1058 < 1 def test_b_a_multi_select_question_is_one_row(tmp_path):
1059 < 1     """#1189: `picked` may be a list for a multi-select question — one row, one
1060 < 1     question, counted as recommended-picked when the recommendation is among
1061 < 1     the picks."""
