1136 < 2 @pytest.mark.parametrize("ttype", ["gate", "release", "manual"])
1137 < 2 def test_a_task_the_engine_would_skip_is_refused(tmp_path, ttype):
1138 < 2     """The parser keeps only implementation tasks, so a `gate`, `release` or
1139 < 2     `manual` task would vanish without a word: plan_check refuses it."""
1140 < 2     text = (ROOT / "evals/fixtures/claims/plan.md").read_text()
1141 < 2     plan = tmp_path / "p.md"
1142 < 2     plan.write_text(re.sub(r"^\*\*Type:\*\* implementation",
1143 < 2                            "**Type:** " + ttype, text, flags=re.M))
1144 < 2     p = run_compiler(plan)
1145 < 2     assert p.returncode != 0, p.stdout
1146 < 2     lines = [l for l in p.stdout.splitlines()
1147 < 2              if l.startswith("grammar: task 1: Type")]
1148 < 2     assert len(lines) == 1 and ttype in lines[0], p.stdout
1149 < 2     assert "**Publish:**" in lines[0], p.stdout
1150 < 1 
1151 < 1 
1152 < 1 # ########################################################################### #
1153 < 1 # THE BODY'S SHAPE                                                            #
1154 < 1 # ########################################################################### #
1155 < 1 #
1156 < 1 # `slip_violations` refuses a body without its six slots in order and a code
1157 < 1 # fence outside a task's Proof (the three wording slips went in #1440). Every plan is
1158 < 1 # `tests/fixtures/plan_check_slips/good.md` with one slip put in, re-signed
1159 < 1 # so the gate record is never the reason it is refused.
1160 < 1 
1161 < 1 SLIPS_GOOD = ROOT / "tests/fixtures/plan_check_slips/good.md"
1162 < 1 SIX_SLOTS_LINE = ("grammar: task 1: the body must carry Claim, Authorized-by, "
1163 < 1                   "Interfaces, Context, Proof and Stale-if, each once, "
1164 < 1                   "non-empty, in that order")
1165 < 1 
1166 < 1 
1167 < 1 def slipped(tmp_path, pattern, repl):
1168 < 1     """`good.md` with `pattern` replaced by `repl` (multiline), signed and
1169 < 1     checked: the lines the checker prints."""
1170 < 1     text = re.sub(pattern, repl, SLIPS_GOOD.read_text(), flags=re.M)
1171 < 1     assert text != SLIPS_GOOD.read_text(), pattern
1172 < 1     p = run_compiler(write_plan(tmp_path, "p.md", text))
1173 < 1     return p.returncode, p.stdout.splitlines()
1174 < 1 
1175 < 1 
1176 < 1 def test_slips_the_clean_fixture_checks_out():
1177 < 1     p = run_compiler(SLIPS_GOOD)
1178 < 1     assert p.returncode == 0, p.stdout
1179 < 1     assert p.stdout.splitlines()[0] == "PLAN OK", p.stdout
1180 < 1 
1181 < 1 
1182 < 1 def test_slips_a_missing_slot_is_refused(tmp_path):
1183 < 1     code, lines = slipped(tmp_path, r"^\*\*Authorized-by:\*\*.*\n", "")
1184 < 1     assert code == 2 and SIX_SLOTS_LINE in lines, lines
1185 < 1 
1186 < 1 
1187 < 1 def test_slips_an_empty_or_misordered_slot_is_refused(tmp_path):
1188 < 1     code, lines = slipped(tmp_path, r"^(\*\*Authorized-by:\*\*).*$", r"\1")
1189 < 1     assert code == 2 and SIX_SLOTS_LINE in lines, lines
1190 < 1     code, lines = slipped(tmp_path, r"^(\*\*Interfaces:\*\*.*\n\n)(\*\*Context:\*\*.*\n)",
1191 < 1                           r"\2\n\1")
1192 < 1     assert code == 2 and SIX_SLOTS_LINE in lines, lines
1193 < 1 
1194 < 1 
1195 < 1 def test_slips_a_fence_outside_proof_is_refused(tmp_path):
1196 < 1     code, lines = slipped(tmp_path, r"^(\*\*Context:\*\*.*)$", "\\1\n~~~\nx\n~~~")
1197 < 1     assert code == 2, lines
1198 < 1     assert "grammar: task 1: a code fence outside the Proof slot" in lines, lines
1199 < 1     code, lines = slipped(tmp_path, r"^(\*\*Tech Stack:\*\*.*)$", "\\1\n~~~\nx\n~~~")
1200 < 1     assert code == 2, lines
1201 < 1     assert "grammar: header: a code fence above the first task" in lines, lines
1202 < 1     code, lines = slipped(tmp_path, r"\Z", "\n## Notes\n\n~~~\nx\n~~~\n")
1203 < 1     assert code == 2, lines
1204 < 1     assert "grammar: a code fence outside every task" in lines, lines
