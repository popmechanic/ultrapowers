322 < 2 def test_compile_copies_no_screen_into_an_app_without_the_catalog(app, tmp_path):
323 < 2     a = _copy(app, tmp_path)
324 < 2     os.remove(os.path.join(a, "client/src/screens/catalog.ts"))
325 < 2     shutil.rmtree(os.path.join(a, "client/src/pieces"))
326 < 2     b = _bundle(tmp_path, lambda page: None)
327 < 2     os.makedirs(os.path.join(b, "screens"), exist_ok=True)
328 < 2     with open(os.path.join(b, "screens/todo.json"), "w") as f:
329 < 2         f.write('{"root": "r", "elements": {}}\n')
330 < 2     r = subprocess.run(["bun", os.path.join(STORIES, "compile.ts"), b, "--app", a, "--plan-id", "p1",
331 < 2                         "--date", "2026-10-01", "--out", os.path.join(a, ".ultrapowers/plan.md")],
332 < 2                        capture_output=True, text=True, timeout=120)
333 < 2     assert r.returncode == 0, r.stdout + r.stderr
334 < 2     assert not os.path.exists(os.path.join(a, "client/src/pieces/todo.json"))
