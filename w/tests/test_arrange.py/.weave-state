50 < 1 def run_js(body, **values):
51 < 1     """Run PRELUDE + body under bun, with each value bound as a const; parse the JSON it prints."""
52 < 1     consts = "".join("const %s = %s;\n" % (k, json.dumps(v)) for k, v in values.items())
53 < 1     r = subprocess.run(["bun", "-e", PRELUDE + consts + body], cwd=ROOT, capture_output=True, text=True, timeout=300)
54 < 1     assert r.returncode == 0, r.stderr[-2000:]
55 < 1     return json.loads(r.stdout.strip().splitlines()[-1])
