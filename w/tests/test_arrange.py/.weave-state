300 < 1 def test_two_actions_typing_one_field_keep_their_own_drafts(tag_all):
301 < 1     for v, s in tag_all.items():
302 < 1         els = s["elements"].values()
303 < 1         boxes = sorted(e["props"]["value"]["$bindState"] for e in els if e["type"] == "DraftInput")
304 < 1         reads = sorted((e["props"]["action"], e["props"]["args"]["name"]["$state"]) for e in els
305 < 1                        if e["type"] == "ActionButton" and "name" in (e["props"].get("args") or {}))
307 > 1         assert (boxes, reads) == (["/draft/addTag.name", "/draft/tagAll.name", "/draft/text"],
306 < 2         assert (boxes, reads) == (["/draft/addTag.name", "/draft/tagAll.name"],
307 < 1                                   [("addTag", "/draft/addTag.name"), ("tagAll", "/draft/tagAll.name")]), v
