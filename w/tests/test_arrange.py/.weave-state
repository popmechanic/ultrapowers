310 < 1 def test_a_whole_list_button_sits_beside_its_own_list(tag_all):
311 < 1     for v, s in tag_all.items():
312 < 1         els = s["elements"]
313 < 1         parent = {c: p for p, e in els.items() for c in e.get("children", [])}
314 < 1         mover = next(i for i, e in els.items() if e["props"].get("action") == "clearTags")
315 < 1         while parent.get(mover) not in (None, s["root"]) and len(els[parent[mover]]["children"]) == 1:
316 < 1             mover = parent[mover]
317 < 1         tags = next(i for i, e in els.items() if (e.get("repeat") or {}).get("statePath") == "/tables/tags")
318 < 1         kids = els[parent[tags]]["children"]
319 < 1         assert mover in kids and abs(kids.index(mover) - kids.index(tags)) == 1, (v, kids)
