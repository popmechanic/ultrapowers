1 > 1 """Jev's page arranger (skills/ultrawrite/stories/arrange.ts): the whole page from the cards
2 < 1 and the store alone, never a story's `ui` or `see`. Row controls carry their typed args and sit
3 < 1 in the one list of their table, whichever piece owns them; their words come from the card's
4 < 1 `label` and `x-label`, row cells templated in (#1524). A fake evaluator stands in for Jev, so no
0 < 2 """Jev's screen arranger (skills/ultrawrite/stories/arrange.ts) on a bundle beyond the todo
1 < 2 example (#1524): row controls carry their typed args, row text is templated from the row,
2 < 2 and every card action and seen control gets one. A fake evaluator stands in for Jev, so no
3 < 1 test reaches the network. Needs bun and an offline-installable app."""
4 < 1 import hashlib
5 < 1 import json
6 < 1 import os
7 < 1 import shutil
8 < 1 import subprocess
9 < 1 
10 < 1 import pytest
11 < 1 
12 < 1 ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
13 < 1 STORIES = os.path.join(ROOT, "skills/ultrawrite/stories")
14 < 1 ARRANGE = os.path.join(STORIES, "arrange.ts")
15 < 1 TAGS = os.path.join(ROOT, "skills/ultrawrite/catalog/todo-tags")
16 < 1 TODO = os.path.join(ROOT, "skills/ultrawrite/catalog/todo")
17 < 1 SHOPPING = os.path.join(ROOT, "evals/fixtures/tinyapp-shopping")
18 < 1 
19 < 1 PRELUDE = r"""
21 > 1 import {arrange, reshape, writeVersions} from %s;
20 < 2 import {arrange} from %s;
21 < 1 const fake = async ({questions}) => { const answers = {}; for (const [k, q] of Object.entries(questions)) { const keys = Object.keys(q.criteria); let c = keys[0]; if (k.startsWith("select_")) c = keys.find((x) => x.startsWith("use:")) ?? (keys.includes("1") ? "1" : keys[0]); else if (k.startsWith("parent_")) c = keys.find((x) => x.startsWith("node_0")) ?? keys[0]; answers[k] = {choice: c, confidence: 0.9}; } return {answers}; };
22 < 1 const isObj = (v) => typeof v === "object" && v !== null && !Array.isArray(v);
23 < 1 const canon = (v) => JSON.stringify(v, (_k, x) => (isObj(x) ? Object.fromEntries(Object.entries(x).sort(([a], [b]) => a.localeCompare(b))) : x));
24 < 1 const below = (s, id, pred) => (s.elements[id]?.children ?? []).some((c) => pred(s.elements[c]) || below(s, c, pred));
25 < 1 const inRepeat = (s, table, pred) => Object.keys(s.elements).some((id) => s.elements[id].repeat?.statePath === "/tables/" + table && below(s, id, pred));
26 < 1 """ % json.dumps(ARRANGE)
27 < 1 
28 < 1 
29 < 1 def _app(tmp_path_factory, bundle, name):
30 < 1     dst = str(tmp_path_factory.mktemp(name) / "app")
31 < 1     subprocess.run(["bun", os.path.join(STORIES, "scaffold.ts"), bundle, dst],
32 < 1                    check=True, capture_output=True, text=True)
33 < 1     r = subprocess.run(["bun", "install", "--offline"], cwd=dst, capture_output=True, text=True, timeout=300)
34 < 1     if r.returncode:
35 < 1         pytest.skip("bun install --offline failed: " + r.stderr.strip()[-200:])
36 < 1     return dst
38 > 1 
39 < 1 
40 < 1 def _copy(app, tmp_path):
41 < 1     """A copy of the app of its own, its node_modules a link to the shared one."""
42 < 1     dst = str(tmp_path / "app")
43 < 1     shutil.copytree(app, dst, symlinks=True, ignore=lambda d, names: ["node_modules"] if d == app else [])
44 < 1     os.symlink(os.path.join(app, "node_modules"), os.path.join(dst, "node_modules"))
45 < 1     return dst
46 < 1 
47 < 1 
49 > 1 def _bundle(tmp_path, edit, name="page.json", src=TAGS):
50 < 1     """A copy of a bundle (todo-tags by default), its page.json (or another file) passed through edit."""
48 < 2 def _bundle(tmp_path, edit):
49 < 2     """A copy of the todo-tags bundle, its page.json passed through edit(page)."""
50 < 1     b = str(tmp_path / "b")
52 > 1     shutil.copytree(src, b)
53 < 1     with open(os.path.join(b, name)) as f:
54 < 1         doc = json.load(f)
55 < 1     doc = edit(doc) or doc
56 < 1     with open(os.path.join(b, name), "w") as f:
57 < 1         json.dump(doc, f)
51 < 2     shutil.copytree(TAGS, b)
52 < 2     with open(os.path.join(b, "page.json")) as f:
53 < 2         page = json.load(f)
54 < 2     page = edit(page) or page
55 < 2     with open(os.path.join(b, "page.json"), "w") as f:
56 < 2         json.dump(page, f)
57 < 1     return b
