0 < 1 """The claims-v1 parser: `skills/ultrapowers/scripts/plan_parse.py`.
1 < 1 
3 > 1 `plan_parse.py` reduces a claims-v1 plan to the fields the engine needs
4 < 1 (`tasks`, `dag_edges`, `width`, ...) without ever touching the sibling
2 < 2 `plan_parse.py` reduces a claims-v1 plan to the nine fields the engine needs
3 < 2 (`tasks`, `dag_edges`, `launch_waves`) without ever touching the sibling
4 < 1 `<stem>.gate-verdicts.json` `plan_check.py` reads (and the old compiler required).
5 < 1 This exam never imports the module under test — it is a script invoked as
6 < 1 `python3 skills/ultrapowers/scripts/plan_parse.py <plan.md>` — so every
7 < 1 assertion below runs it as a subprocess and reads stdout/stderr/the exit
8 < 1 code, exactly as `factory/engine.mjs` would.
9 < 1 
10 < 1 Every assertion is tagged with the Machine clause (M1-M5) it proves.
11 < 1 """
12 < 1 import json
13 < 1 import subprocess
14 < 1 import sys
15 < 1 from pathlib import Path
16 < 1 
17 < 1 import pytest
18 < 1 
19 < 1 ROOT = Path(__file__).resolve().parents[1]
20 < 1 PARSER = ROOT / "skills/ultrapowers/scripts/plan_parse.py"
21 < 1 
22 < 1 # The three claims-v1 fixtures that carry a `.gate-verdicts.json` record
23 < 1 # beside them — parsed with and without it by M1.
24 < 1 RECORD_FIXTURES = [
25 < 1     ROOT / "evals/fixtures/claims/plan.md",
26 < 1     ROOT / "tests/fixtures/plans/2026-09-01-511-attempt-racing.md",
27 < 1     ROOT / "tests/fixtures/plans/2026-09-02-papercut-drain-2.md",
28 < 1 ]
29 < 1 
31 > 1 # Every field a task object prints (M1).
32 < 1 TASK_FIELDS = {"id", "title", "files", "wave", "proofRuns",
33 < 1                "proofRunClauses", "body"}
34 < 1 
35 < 1 # The printed object's keys (M1).
36 < 1 TOP_KEYS = {"tasks", "dag_edges", "width", "checks", "bootstrapCmd", "publish"}
30 < 2 # Every field a task object prints (M1): a `- Test:`/`- Guard:` bullet or an
31 < 2 # `**Exam command:**` header adds no field here -- cut three (2026-09-22)
32 < 2 # retired the examiner they fed, and `plan_check.py` refuses a plan that
33 < 2 # still carries one instead.
34 < 2 TASK_FIELDS = {"id", "title", "files", "depends_on", "proofRuns",
35 < 2                "proofRunClauses", "interfaces", "body"}
36 < 1 
37 < 1 
38 < 1 # --------------------------------------------------------------------------- #
39 < 1 # Subprocess helpers.                                                         #
40 < 1 # --------------------------------------------------------------------------- #
41 < 1 
42 < 1 def run_parser(plan_path):
43 < 1     return subprocess.run([sys.executable, str(PARSER), str(plan_path)],
44 < 1                           capture_output=True, text=True)
45 < 1 
46 < 1 
47 < 1 def parse_stdout_json(stdout):
48 < 1     """The one JSON object `plan_parse.py` prints on stdout (M1): parsing
49 < 1     fails loudly if stdout carries anything besides that one value."""
50 < 1     text = stdout.strip()
51 < 1     obj, end = json.JSONDecoder().raw_decode(text)
52 < 1     assert end == len(text), (
53 < 1         "stdout carries more than one JSON value: %r" % (text,))
54 < 1     return obj
55 < 1 
56 < 1 
57 < 1 def build_and_run(tmp_path, tasks, **plan_kwargs):
58 < 1     plan_path = tmp_path / "plan.md"
59 < 1     plan_path.write_text(make_plan(tasks, **plan_kwargs))
60 < 1     proc = run_parser(plan_path)
61 < 1     assert proc.returncode == 0, proc.stdout + proc.stderr
62 < 1     return parse_stdout_json(proc.stdout)
63 < 1 
64 < 1 
65 < 1 # --------------------------------------------------------------------------- #
66 < 1 # Minimal claims-v1 plan/task builders. Every task carries the full six-slot  #
67 < 1 # body (Claim, Authorized-by, Interfaces, Context, Proof, Stale-if) so a      #
68 < 1 # parser reading the grammar's whole shape never trips on an absent slot —   #
69 < 1 # only the fields the Machine clauses examine are varied per test.           #
70 < 1 # --------------------------------------------------------------------------- #
71 < 1 
73 > 1 def make_header(title="Exam fixture plan", bootstrap=None, checks=()):
72 < 2 def make_header(title="Exam fixture plan", exam_command=None, bootstrap=None,
73 < 2                 checks=()):
74 < 1     lines = [f"# {title}", "",
75 < 1              "**Grammar:** claims-v1", "",
76 < 1              "**Claim:** An operator sees the placeholder claim proved. (elicited)", "",
77 < 1              "**Summary:** Placeholder summary for an exam fixture.", "",
78 < 1              "**Goal:** Placeholder goal for an exam fixture.", "",
79 < 1              "**Tech Stack:** N/A (exam fixture, never executed).", ""]
80 < 2     if exam_command:
81 < 2         lines += [f"**Exam command:** {exam_command}", ""]
82 < 1     if bootstrap:
83 < 1         lines += [f"**Bootstrap:** {bootstrap}", ""]
84 < 1     lines += ["## Global Constraints", ""]
85 < 1     if checks:
86 < 1         lines += [f"- Check: {c}" for c in checks] + [""]
87 < 1     else:
88 < 1         lines += ["- None.", ""]
89 < 1     return "\n".join(lines)
90 < 1 
91 < 1 
93 > 1 def make_plan(tasks, title="Exam fixture plan", bootstrap=None, checks=()):
94 < 1     return (make_header(title=title, bootstrap=bootstrap, checks=checks)
92 < 2 def make_plan(tasks, exam_command=None, title="Exam fixture plan",
93 < 2               bootstrap=None, checks=()):
94 < 2     return (make_header(title=title, exam_command=exam_command,
95 < 2                         bootstrap=bootstrap, checks=checks)
96 < 1             + "\n" + "\n\n".join(tasks) + "\n")
97 < 1 
98 < 1 
100 > 1 def task_block(task_id, title, *, creates=(), modifies=(), deletes=(),
101 < 1                consumes=(), produces=(), run_cmds=(), legs=None):
99 < 2 def task_block(task_id, title, *, ttype="implementation",
100 < 2                creates=(), modifies=(), deletes=(), tests=(),
101 < 2                consumes=(), produces=(), run_cmds=(), guards=(), legs=None):
102 < 1     lines = [f"### Task {task_id}: {title}", ""]
103 < 2     if ttype is not None:
104 < 2         lines += [f"**Type:** {ttype}", ""]
105 < 1     file_lines = ([f"- Create: `{p}`" for p in creates]
106 < 1                   + [f"- Modify: `{p}`" for p in modifies]
108 > 1                   + [f"- Delete: `{p}`" for p in deletes])
107 < 2                   + [f"- Delete: `{p}`" for p in deletes]
108 < 2                   + [f"- Test: `{p}`" for p in tests])
109 < 1     if not file_lines:
110 < 1         file_lines = [f"- Modify: `unused/{task_id}-files.marker`"]
111 < 1     lines += ["**Files:**"] + file_lines + [""]
112 < 1     lines += [f"**Claim:** Placeholder claim sentence for task {task_id}. (elicited)",
113 < 1               f"Machine: placeholder machine restatement for task {task_id}.", ""]
114 < 1     lines += ["**Authorized-by:** #1", ""]
115 < 1     consumes_lines = list(consumes) or ["none"]
116 < 1     produces_lines = list(produces) or ["none"]
117 < 1     lines += (["**Interfaces:**"]
118 < 1               + [f"- Consumes: {c}" for c in consumes_lines]
119 < 1               + [f"- Produces: {p}" for p in produces_lines]
120 < 1               + [""])
121 < 1     lines += [f"**Context:** Placeholder context prose for task {task_id}.", ""]
123 > 1     proof_lines = [f"- Run: {c}" for c in run_cmds]
122 < 2     proof_lines = ([f"- Test: `{p}`" for p in tests]
123 < 2                    + [f"- Run: {c}" for c in run_cmds]
124 < 2                    + [f"- Guard: `{p}`" for p in guards])
125 < 1     if legs is not None:
126 < 1         proof_lines.append(f"- Legs: {legs}")
127 < 1     if not proof_lines:
129 > 1         proof_lines = ["Proved by the run-wide Check."]
128 < 2         proof_lines = [f"- Guard: `unused/{task_id}-guard.marker`"]
129 < 1     lines += ["**Proof:**"] + proof_lines + [""]
130 < 1     lines += ["**Stale-if:**", f"- path-exists: `unused/{task_id}.marker`"]
131 < 1     return "\n".join(lines)
132 < 1 
133 < 1 
134 < 1 # --------------------------------------------------------------------------- #
135 < 1 # M1 — stdout shape, exit 0, indifferent to the sibling verdict record.       #
136 < 1 # --------------------------------------------------------------------------- #
137 < 1 
138 < 1 @pytest.mark.parametrize("plan_path", RECORD_FIXTURES, ids=lambda p: p.stem)
139 < 1 def test_m1_stdout_shape_with_and_without_verdict_record(plan_path, tmp_path):
140 < 1     verdict_path = plan_path.with_name(plan_path.stem + ".gate-verdicts.json")
141 < 1     assert verdict_path.exists(), "fixture setup: expected a sibling verdict record"
142 < 1 
143 < 1     # The record present, beside the fixture in its own directory.
144 < 1     proc_with = run_parser(plan_path)
145 < 1     assert proc_with.returncode == 0, proc_with.stdout + proc_with.stderr  # [M1]
146 < 1     obj_with = parse_stdout_json(proc_with.stdout)
148 > 1     assert set(obj_with.keys()) == TOP_KEYS  # [M1]
147 < 2     # Pin extended to `checks` and `bootstrapCmd` by this task. [M1] [cmds-M2]
148 < 2     assert set(obj_with.keys()) == {"tasks", "dag_edges", "launch_waves",
149 < 2                                     "checks", "bootstrapCmd", "publish"}
150 < 1 
151 < 1     # A copy of the fixture alone in tmp_path, with no sibling file at all.
152 < 1     tmp_plan = tmp_path / plan_path.name
153 < 1     tmp_plan.write_text(plan_path.read_text())
154 < 1     proc_without = run_parser(tmp_plan)
155 < 1     assert proc_without.returncode == 0, proc_without.stdout + proc_without.stderr  # [M1]
156 < 1     obj_without = parse_stdout_json(proc_without.stdout)
158 > 1     assert set(obj_without.keys()) == TOP_KEYS  # [M1]
157 < 2     assert set(obj_without.keys()) == {"tasks", "dag_edges", "launch_waves",
158 < 2                                        "checks", "bootstrapCmd", "publish"}  # [M1] [cmds-M2]
159 < 1 
160 < 1     # Reading no file but the plan: the answer does not change when the
161 < 1     # sibling verdict record vanishes. [M1]
162 < 1     assert obj_with == obj_without
163 < 1 
164 < 1 
165 < 1 # --------------------------------------------------------------------------- #
167 > 1 # M2 — task entry shape and field derivation.                                 #
166 < 2 # M2 — task/wave entry shape and field derivation.                            #
167 < 1 # --------------------------------------------------------------------------- #
168 < 1 
169 < 1 def test_m2_task_and_wave_shape_on_widget_plan():
170 < 1     plan_path = ROOT / "evals/fixtures/claims/plan.md"
171 < 1     proc = run_parser(plan_path)
172 < 1     assert proc.returncode == 0, proc.stdout + proc.stderr
173 < 1     obj = parse_stdout_json(proc.stdout)
174 < 1 
175 < 1     expected = {
177 > 1         "1": dict(title="The widget constructor", files=["widgetkit/widget.py"], wave=1),
178 < 1         "2": dict(title="The widget catalog", files=["widgetkit/catalog.py"], wave=2),
179 < 1         "3": dict(title="Size formatting", files=["widgetkit/format.py"], wave=1),
176 < 2         "1": dict(
177 < 2             title="The widget constructor",
178 < 2             files=["widgetkit/widget.py"],
179 < 2             interfaces={"consumes": ["nothing (first task)"],
180 < 2                         "produces": ["`make_widget(n: int) -> Widget`"]}),
181 < 2         "2": dict(
182 < 2             title="The widget catalog",
183 < 2             files=["widgetkit/catalog.py"],
184 < 2             interfaces={"consumes": ["`make_widget(n: int) -> Widget`"],
185 < 2                         "produces": ["`catalog(sizes: list[int]) -> list[Widget]`"]}),
186 < 2         "3": dict(
187 < 2             title="Size formatting",
188 < 2             files=["widgetkit/format.py"],
189 < 2             interfaces={"consumes": ["nothing"],
190 < 2                         "produces": ["`format_size(n: int) -> str`"]}),
191 < 1     }
192 < 1 
193 < 1     assert [t["id"] for t in obj["tasks"]] == ["1", "2", "3"]  # [M2]
194 < 1     for t in obj["tasks"]:
195 < 1         assert set(t.keys()) == TASK_FIELDS  # [M2]
196 < 1         assert isinstance(t["id"], str)  # [M2]
197 < 2         assert t["depends_on"] == []  # [M2]
198 < 1         exp = expected[t["id"]]
199 < 1         assert t["title"] == exp["title"]  # [M2]
200 < 2         # A task's `files` is `Create:` and `Modify:` paths only -- its own
201 < 2         # `- Test:` bullet adds no path (cut three, 2026-09-22). [M2]
202 < 1         assert t["files"] == exp["files"]  # [M2]
203 < 1         assert t["files"] == sorted(t["files"])  # [M2]
205 > 1         # Task 2 consumes what task 1 produces, so it sits one layer down. [M2]
206 < 1         assert t["wave"] == exp["wave"]  # [M2]
207 < 1     assert obj["width"] == 2  # [M2]
204 < 2         assert t["interfaces"] == exp["interfaces"]  # [M2]
205 < 2 
206 < 2     for wave in obj["launch_waves"]:
207 < 2         for t in wave:
208 < 2             assert set(t.keys()) == TASK_FIELDS  # [M2]
209 < 2 
210 < 2 
211 < 2 def test_m2_test_bullet_and_exam_command_add_no_field_or_path(tmp_path):
212 < 2     # A task built with `tests=[...]` under both Files and Proof, and an
213 < 2     # `**Exam command:**` template declared at the header -- cut three
214 < 2     # (2026-09-22) retired the examiner both fed. [M2]
215 < 2     tasks = [task_block("1", "Vitest task", creates=["src/a.ts"],
216 < 2                         tests=["tests/a.test.ts", "tests/b.test.ts"])]
217 < 2     obj = build_and_run(tmp_path, tasks, exam_command="npx vitest run {paths}")
218 < 2     t = obj["tasks"][0]
219 < 2     assert "testCmd" not in t  # [M2]
220 < 2     assert "proofTests" not in t  # [M2]
221 < 2     assert "testCmds" not in t  # [M2]
222 < 2     # The Test: bullet's path never joins `files`. [M2]
223 < 2     assert t["files"] == ["src/a.ts"]
224 < 2 
225 < 2 
226 < 2 def test_m2_absent_type_is_implementation(tmp_path):
227 < 2     tasks = [
228 < 2         task_block("1", "Explicit implementation", creates=["m2/impl.py"]),
229 < 2         task_block("2", "No Type marker at all", ttype=None,
230 < 2                    creates=["m2/nomarker.py"]),
231 < 2     ]
232 < 2     obj = build_and_run(tmp_path, tasks)
233 < 2     assert [t["id"] for t in obj["tasks"]] == ["1", "2"]  # [M2]
234 < 2     wave_ids = {t["id"] for wave in obj["launch_waves"] for t in wave}
235 < 2     assert wave_ids == {"1", "2"}  # [M2]
236 < 2 
237 < 2 
238 < 2 @pytest.mark.parametrize("ttype", ["gate", "release", "manual"])
239 < 2 def test_m2_a_task_the_engine_would_skip_is_refused(tmp_path, ttype):
240 < 2     """#1440: a Type the engine never runs is the parser's refusal, not a
241 < 2     silent drop."""
242 < 2     plan_path = tmp_path / "plan.md"
243 < 2     plan_path.write_text(make_plan([
244 < 2         task_block("1", "Explicit implementation", creates=["m2/impl.py"]),
245 < 2         task_block("2", "Other task", ttype=ttype, creates=["m2/other.txt"])]))
246 < 2     proc = run_parser(plan_path)
247 < 2     assert_is_the_scripts_own_refusal(proc)
248 < 2     assert proc.returncode == 2, proc.stdout + proc.stderr
249 < 2     assert "task 2: Type `%s` is never run" % ttype in proc.stderr, proc.stderr
