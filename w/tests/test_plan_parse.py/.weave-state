460 < 1 def assert_is_the_scripts_own_refusal(proc):
461 < 1     """A missing plan_parse.py also exits 2 with one stderr line naming the
462 < 1     interpreter's own launch failure -- guard against mistaking that for a
463 < 1     genuine M5 refusal, so an absent implementation reads as absent rather
464 < 1     than as an accidental pass."""
465 < 1     assert "No such file or directory" not in proc.stderr, (
466 < 1         "stderr is the interpreter's launch failure, not the script's own "
467 < 1         "refusal -- plan_parse.py is missing: " + proc.stderr)
468 < 1 
469 < 1 
