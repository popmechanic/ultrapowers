511 < 1 # --------------------------------------------------------------------------- #
512 < 1 # guard-M3 -- any argv that is not exactly one `<plan.md>` prints the usage   #
513 < 1 #             line on stderr and exits 2 -- an unrecognized flag such as     #
514 < 1 #             `--unguarded` included, since the parser reads none such any   #
515 < 1 #             more (cut three, 2026-09-22).                                  #
516 < 1 # --------------------------------------------------------------------------- #
517 < 1 
518 < 1 def test_guard_m3_bad_argv_variants_exit_2_with_usage(tmp_path):
519 < 1     plan_path = tmp_path / "plan.md"
520 < 1     plan_path.write_text(make_plan([task_block("1", "Solo", creates=["gf/a.py"])]))
521 < 1 
522 < 1     usage_lines = []
523 < 1     for argv_tail in ([], ["--unguarded", str(plan_path)],
524 < 1                       ["--frobnicate", str(plan_path)]):
525 < 1         proc = subprocess.run([sys.executable, str(PARSER)] + argv_tail,
526 < 1                               capture_output=True, text=True)
527 < 1         assert_is_the_scripts_own_refusal(proc)
528 < 1         assert proc.returncode == 2, argv_tail  # [guard-M3]
529 < 1         assert proc.stdout == ""  # [guard-M3]
530 < 1         lines = [l for l in proc.stderr.splitlines() if l.strip()]
531 < 1         assert len(lines) == 1  # [guard-M3]
532 < 1         usage_lines.append(lines[0])
533 < 1 
534 < 1     # The same one usage line for every rejected shape. [guard-M3]
535 < 1     assert len(set(usage_lines)) == 1
536 < 1 
