324 < 1 def test_m4_write_after_create_wins_over_interface_for_the_pair(tmp_path):
325 < 1     tasks = [
326 < 1         task_block("1", "A", creates=["m4/p4.py"], produces=["`g()`"]),
327 < 1         task_block("2", "B", modifies=["m4/p4.py"], consumes=["`g()`"]),
328 < 1     ]
329 < 1     obj = build_and_run(tmp_path, tasks)
330 < 1     # Exactly one edge for the pair; the first-firing rule (write-after-
331 < 1     # create) labels it, not the interface match that also holds. [M4]
332 < 1     assert obj["dag_edges"] == [
333 < 1         {"from": "1", "to": "2", "why": "write-after-create"}]
334 < 1 
