473 < 1     proc = run_parser(plan_path)
474 < 1     assert_is_the_scripts_own_refusal(proc)
475 < 1     assert proc.returncode == 2  # [M5]
476 < 1     lines = [l for l in proc.stderr.splitlines() if l.strip()]
477 < 1     assert len(lines) == 1  # [M5]
478 < 1 
