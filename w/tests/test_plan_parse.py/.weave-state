552 < 1 
553 < 1 # --------------------------------------------------------------------------- #
554 < 1 # Task: "The parser says what a plan wants run -- its proof lines, its       #
555 < 1 # checks, its bootstrap, and its test commands one by one".                  #
556 < 1 #                                                                             #
557 < 1 # This task's own Machine clauses are M1-M3, colliding by number with the    #
558 < 1 # grammar-parser's M1-M5 tags used at the top of this file -- its legs are   #
559 < 1 # tagged cmds-M1, cmds-M2, cmds-M3 to stay unambiguous, mirroring            #
560 < 1 # guard-M*.                                                      #
561 < 1 #                                                                             #
562 < 1 # cmds-M1 -- every task object gains `proofRuns` (the task's Proof           #
563 < 1 #            `- Run:` commands in order, a whole-value backtick wrapper      #
564 < 1 #            removed, `[]` when none).                                      #
566 > 1 # cmds-M2 -- the printed object carries `checks` (one `{"cmd"}` per         #
567 < 1 #            `- Check:` bullet of `## Global Constraints`, in order; a      #
568 < 1 #            `(minor)` suffix is refused, since every Check runs) and       #
569 < 1 #            `bootstrapCmd` (the text of a `**Bootstrap:**` header line     #
570 < 1 #            above the first task, `null` when the plan has none).          #
571 < 1 # cmds-M3 -- the task-object key set is TASK_FIELDS and the top-level key   #
572 < 1 #            set TOP_KEYS, nothing else.                                    #
565 < 2 # cmds-M2 -- the printed object gains `checks` (one `{"cmd", "minor"}` per   #
566 < 2 #            `- Check:` bullet of `## Global Constraints`, in order, with    #
567 < 2 #            `minor` true exactly when the bullet ends with `(minor)`,       #
568 < 2 #            which is not part of `cmd`) and `bootstrapCmd` (the text of a   #
569 < 2 #            `**Bootstrap:**` header line above the first task, `null` when  #
570 < 2 #            the plan has none).                                            #
571 < 2 # cmds-M3 -- the other task fields, `dag_edges` and `launch_waves`           #
572 < 2 #            are unchanged; the task-object key set is the earlier set plus #
573 < 2 #            `proofRuns`, the top-level key set is the earlier set plus     #
574 < 2 #            `checks`/`bootstrapCmd`, both and nothing else.                #
575 < 1 # --------------------------------------------------------------------------- #
576 < 1 
577 < 1 def test_cmds_m1_proofruns_field(tmp_path):
578 < 1     tasks = [
579 < 1         task_block("1", "Mixed", creates=["cm1/a.py"],
580 < 2                    tests=["fleet/tests/test_a.mjs", "tests/test_b.py"],
581 < 1                    run_cmds=["python3 checks/one.py",
582 < 1                              "`python3 checks/two.py`"]),
583 < 1     ]
584 < 1     obj = build_and_run(tmp_path, tasks)
585 < 1     t = obj["tasks"][0]
586 < 1     # proofRuns: the two `- Run:` commands in order, the second's whole-value
587 < 1     # backtick wrapper removed (the first carried none to begin with). [cmds-M1]
588 < 1     assert t["proofRuns"] == ["python3 checks/one.py",
589 < 1                               "python3 checks/two.py"]
590 < 1 
591 < 1 
592 < 1 def test_cmds_m2_checks_and_bootstrap_fields(tmp_path):
593 < 1     tasks = [task_block("1", "Solo", creates=["cm2/a.py"])]
594 < 1     obj = build_and_run(
595 < 1         tmp_path, tasks,
597 > 1         checks=["git diff --quiet $ULTRA_BASE -- fleet/", "`wc -w docs/x.md`"],
596 < 2         checks=["git diff --quiet $ULTRA_BASE -- fleet/",
597 < 2                 "wc -w docs/x.md (minor)"],
598 < 1         bootstrap="bun install --frozen-lockfile")
600 > 1     # checks: one {"cmd"} per `- Check:` bullet, in order, a whole-value
601 < 1     # backtick wrapper removed. [cmds-M2]
599 < 2     # checks: one {"cmd", "minor"} per `- Check:` bullet, in order; the
600 < 2     # trailing "(minor)" marks the bullet as minor and is not part of "cmd". [cmds-M2]
601 < 1     assert obj["checks"] == [
603 > 1         {"cmd": "git diff --quiet $ULTRA_BASE -- fleet/"},
604 < 1         {"cmd": "wc -w docs/x.md"},
602 < 2         {"cmd": "git diff --quiet $ULTRA_BASE -- fleet/", "minor": False},
603 < 2         {"cmd": "wc -w docs/x.md", "minor": True},
604 < 1     ]
605 < 1     # bootstrapCmd: the text of the **Bootstrap:** header line. [cmds-M2]
606 < 1     assert obj["bootstrapCmd"] == "bun install --frozen-lockfile"
608 > 1 
609 < 1 
610 < 1 def test_cmds_m2_a_minor_check_is_refused(tmp_path):
611 < 1     # A `(minor)` Check was once parsed and never run; every Check runs now,
612 < 1     # so the suffix is the parser's refusal rather than part of the command.
613 < 1     plan_path = tmp_path / "plan.md"
614 < 1     plan_path.write_text(make_plan([task_block("1", "Solo", creates=["cm2m/a.py"])],
615 < 1                                    checks=["wc -w docs/x.md (minor)"]))
616 < 1     proc = run_parser(plan_path)
617 < 1     assert_is_the_scripts_own_refusal(proc)
618 < 1     assert proc.returncode == 2, proc.stdout + proc.stderr  # [cmds-M2]
619 < 1     assert "ends `(minor)`, which is never run" in proc.stderr, proc.stderr
607 < 1 
608 < 1 
