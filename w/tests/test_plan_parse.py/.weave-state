252 < 1 # --------------------------------------------------------------------------- #
253 < 1 # M3 — the Interfaces-bullet token rule.                                      #
254 < 1 # --------------------------------------------------------------------------- #
255 < 1 
256 < 1 INTERFACE_TOKEN_CASES = [
257 < 1     pytest.param("`catalog(sizes: list[int]) -> list[Widget]`", "catalog",
258 < 1                  True, id="backtick-signature-cut-at-paren"),
259 < 1     pytest.param("`export async function runWorker(opts)`", "runWorker",
260 < 1                  True, id="decl-keywords-dropped"),
261 < 1     pytest.param("`def make_widget(n)`", "make_widget",
262 < 1                  True, id="def-keyword-dropped"),
263 < 1     pytest.param("none", "none", False, id="none-yields-no-token"),
264 < 1     pytest.param("nothing", "nothing", False, id="nothing-yields-no-token"),
265 < 1     pytest.param("makeWidget", "makeWidget", True, id="bare-word-alone"),
266 < 1     pytest.param("makeWidget", "makeWidget is produced by task 1", False,
267 < 1                  id="bare-word-with-trailing-prose-yields-no-token"),
268 < 1 ]
269 < 1 
270 < 1 
271 < 1 @pytest.mark.parametrize("produces_entry,consumes_entry,expect_edge",
272 < 1                          INTERFACE_TOKEN_CASES)
273 < 1 def test_m3_interface_token_rule(tmp_path, produces_entry, consumes_entry,
274 < 1                                   expect_edge):
275 < 1     tasks = [
276 < 1         task_block("1", "Producer", creates=["m3/p.py"],
277 < 1                    produces=[produces_entry]),
278 < 1         task_block("2", "Consumer", creates=["m3/c.py"],
279 < 1                    consumes=[consumes_entry]),
280 < 1     ]
281 < 1     obj = build_and_run(tmp_path, tasks)
282 < 1     pairs = {(e["from"], e["to"]) for e in obj["dag_edges"]}
283 < 1     if expect_edge:
284 < 1         assert ("1", "2") in pairs  # [M3]
285 < 1     else:
286 < 1         assert pairs == set()  # [M3]
287 < 1 
288 < 1 
289 < 1 # --------------------------------------------------------------------------- #
290 < 1 # M4 — the edge rule and its precedence.                                      #
291 < 1 # --------------------------------------------------------------------------- #
292 < 1 
293 < 1 def test_m4_write_after_create_edge(tmp_path):
294 < 1     tasks = [
295 < 1         task_block("1", "Creator", creates=["m4/p.py"]),
296 < 1         task_block("2", "Modifier", modifies=["m4/p.py"]),
297 < 1     ]
298 < 1     obj = build_and_run(tmp_path, tasks)
299 < 1     assert obj["dag_edges"] == [
300 < 1         {"from": "1", "to": "2", "why": "write-after-create"}]  # [M4]
301 < 1 
302 < 1 
303 < 1 def test_m4_interface_edge(tmp_path):
304 < 1     tasks = [
305 < 1         task_block("1", "Producer", creates=["m4/a2.py"], produces=["`f()`"]),
306 < 1         task_block("2", "Consumer", creates=["m4/b2.py"], consumes=["`f()`"]),
307 < 1     ]
308 < 1     obj = build_and_run(tmp_path, tasks)
309 < 1     assert obj["dag_edges"] == [
310 < 1         {"from": "1", "to": "2", "why": "interface"}]  # [M4]
311 < 1 
312 < 1 
313 < 1 def test_m4_proof_run_edge(tmp_path):
314 < 1     tasks = [
315 < 1         task_block("1", "Owner", creates=["m4/p3.py"]),
316 < 1         task_block("2", "Runner", creates=["m4/other3.py"],
317 < 1                    run_cmds=["python3 m4/p3.py --x"]),
318 < 1     ]
319 < 1     obj = build_and_run(tmp_path, tasks)
320 < 1     assert obj["dag_edges"] == [
321 < 1         {"from": "1", "to": "2", "why": "proof-run"}]  # [M4]
