336 < 1 def test_m4_reverse_interface_dropped_when_forward_already_reachable(tmp_path):
337 < 1     tasks = [
338 < 1         task_block("1", "A", creates=["m4/p5.py"], consumes=["`h()`"]),
339 < 1         task_block("2", "B", modifies=["m4/p5.py"], produces=["`h()`"]),
340 < 1     ]
341 < 1     obj = build_and_run(tmp_path, tasks)
342 < 1     # A->B by write-after-create; B produces what A consumes would draw the
343 < 1     # reverse B->A by interface, but A->B already reaches B, so the reverse
344 < 1     # is not added. [M4]
345 < 1     assert obj["dag_edges"] == [
346 < 1         {"from": "1", "to": "2", "why": "write-after-create"}]
347 < 1 
348 < 1 
349 < 1 def test_m4_reverse_proof_run_dropped_when_forward_already_reachable(tmp_path):
350 < 1     tasks = [
351 < 1         task_block("1", "A", creates=["m4/a6.py"], produces=["`k()`"],
352 < 1                    run_cmds=["python3 m4/b6.py --check"]),
353 < 1         task_block("2", "B", creates=["m4/b6.py"], consumes=["`k()`"]),
354 < 1     ]
355 < 1     obj = build_and_run(tmp_path, tasks)
356 < 1     # A->B by interface (B consumes what A produces); A's Run: names B's own
357 < 1     # file, which would draw the reverse B->A by proof-run, but A->B already
358 < 1     # reaches B, so the reverse is not added. [M4]
359 < 1     assert obj["dag_edges"] == [
360 < 1         {"from": "1", "to": "2", "why": "interface"}]
361 < 1 
