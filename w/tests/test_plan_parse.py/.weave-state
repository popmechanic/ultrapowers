411 < 1 def test_import_js_dynamic_import_edge(tmp_path):
412 < 1     tasks = [
413 < 1         task_block("1", "Module owner", creates=["lib/a.mjs"]),
414 < 1         task_block("2", "Probe", creates=["app/x.mjs"],
415 < 1                    run_cmds=["node -e \"import('./lib/a.mjs')"
