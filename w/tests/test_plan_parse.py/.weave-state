618 < 1 def test_cmds_m3_key_sets_and_other_fields_unchanged(tmp_path):
619 < 1     tasks = [
621 > 1         task_block("1", "A", creates=["cm3/a.py"]),
620 < 2         task_block("1", "A", creates=["cm3/a.py"], tests=["tests/cm3_test.py"]),
621 < 1         task_block("2", "B", modifies=["cm3/a.py"]),
622 < 1     ]
623 < 1     obj = build_and_run(
624 < 1         tmp_path, tasks,
625 < 1         checks=["echo check"], bootstrap="echo boot")
626 < 1 
628 > 1     # The task-object key set is exactly TASK_FIELDS. [cmds-M3]
627 < 2     # The task-object key set is exactly TASK_FIELDS, in both views. [cmds-M3]
628 < 1     for t in obj["tasks"]:
629 < 1         assert set(t.keys()) == TASK_FIELDS
630 < 2     for wave in obj["launch_waves"]:
631 < 2         for t in wave:
632 < 2             assert set(t.keys()) == TASK_FIELDS
633 < 1 
635 > 1     # The top-level key set is exactly TOP_KEYS. [cmds-M3]
636 < 1     assert set(obj.keys()) == TOP_KEYS
634 < 2     # The top-level key set is the earlier set plus `checks` and
635 < 2     # `bootstrapCmd`, nothing else. [cmds-M3]
636 < 2     assert set(obj.keys()) == {"tasks", "dag_edges", "launch_waves",
637 < 2                                "checks", "bootstrapCmd", "publish"}
638 < 1 
639 < 1     # dag_edges are what they were: the write-after-create edge (task "1"
640 < 1     # creates cm3/a.py, task "2" modifies it) still fires with its own
641 < 1     # "why". [cmds-M3]
642 < 1     assert obj["dag_edges"] == [
643 < 1         {"from": "1", "to": "2", "why": "write-after-create"}]
644 < 1 
645 < 1 
646 < 1 # --------------------------------------------------------------------------- #
647 < 1 # runcite -- "The sandbox's parser strips a Run line's clause tag and prints #
648 < 1 # the clauses beside the command": a Proof `Run:` bullet may close with a    #
649 < 1 # `[M2]` / `[M1, M3]` citation tag, the same shape a Legs bullet's own       #
650 < 1 # citation carries. The tag is cut from `proofRuns` (the command a shell     #
651 < 1 # would actually run) and reappears, parallel to `proofRuns`, as the new     #
652 < 1 # `proofRunClauses` field -- `[]` for a command that carried no tag.         #
653 < 1 # runcite-M1 -- for a task whose Proof carries the three named `Run:`        #
654 < 1 #               bullets, `proofRuns` is exactly the three commands with      #
655 < 1 #               every tag stripped and `proofRunClauses` is exactly          #
656 < 1 #               `[["M2"], [], ["M1", "M3"]]`.                                #
657 < 1 # runcite-M2 -- a bracket that is not at the end of the command is part of   #
658 < 1 #               the command: it survives in `proofRuns` unchanged and        #
659 < 1 #               `proofRunClauses` is `[[]]`.                                 #
660 < 1 # runcite-M3 -- on that same plan, the compiler's own (pure, per-task) parse #
661 < 1 #               of `proof_runs` agrees with the parser's `proofRuns`,        #
662 < 1 #               element for element.                                        #
663 < 1 # runcite-M4 -- every task object gains exactly the one key                  #
664 < 1 #               `proofRunClauses` (TASK_FIELDS, line 52, already has it      #
665 < 1 #               folded in) and a task with no `Run:` bullet at all prints    #
666 < 1 #               `proofRunClauses` exactly `[]`.                              #
667 < 1 # --------------------------------------------------------------------------- #
668 < 1 
669 < 1 # The three `- Run:` bullets named by the task's own Machine restatement
670 < 1 # (M1): one tagged [M2], one untagged, one tagged [M1, M3].
671 < 1 THREE_RUN_CMDS = [
673 > 1     "grep -q 'evidence' fleet/CONTRACT.md [M2]",
672 < 2     "grep -q 'kata 0.17.2' fleet/CONTRACT.md [M2]",
673 < 1     "bash -n x.sh",
674 < 1     "true [M1, M3]",
675 < 1 ]
676 < 1 
677 < 1 
678 < 1 def test_runcite_m1_three_run_task_proofruns_and_clauses(tmp_path):
679 < 1     tasks = [
680 < 1         task_block("1", "Three runs", creates=["runcite1/a.py"],
681 < 1                    run_cmds=THREE_RUN_CMDS),
682 < 1     ]
683 < 1     obj = build_and_run(tmp_path, tasks)
684 < 1     t = obj["tasks"][0]
685 < 1     # proofRuns: the citation tag stripped off every command that carries
686 < 1     # one, the untagged command riding back unchanged, all three in Proof
687 < 1     # order. [runcite-M1]
688 < 1     assert t["proofRuns"] == [
690 > 1         "grep -q 'evidence' fleet/CONTRACT.md",
689 < 2         "grep -q 'kata 0.17.2' fleet/CONTRACT.md",
690 < 1         "bash -n x.sh",
691 < 1         "true",
692 < 1     ]
693 < 1     # proofRunClauses: parallel to proofRuns, [] for the untagged command,
694 < 1     # each tag's ids sorted numerically. [runcite-M1]
695 < 1     assert t["proofRunClauses"] == [["M2"], [], ["M1", "M3"]]
696 < 1 
697 < 1 
698 < 1 def test_runcite_m2_bracket_not_at_end_is_part_of_the_command(tmp_path):
699 < 1     tasks = [
700 < 1         task_block("2", "Mid-command bracket", creates=["runcite2/a.py"],
701 < 1                    run_cmds=['test "$(echo [M1])" = x']),
702 < 1     ]
703 < 1     obj = build_and_run(tmp_path, tasks)
704 < 1     t = obj["tasks"][0]
705 < 1     # The bracket sits mid-command, not at the end of the value -- it is part
706 < 1     # of the command and proofRuns prints the whole value unchanged.
707 < 1     # [runcite-M2]
708 < 1     assert t["proofRuns"] == ['test "$(echo [M1])" = x']
709 < 1     # No tag was cut off it, so its clause list is empty. [runcite-M2]
710 < 1     assert t["proofRunClauses"] == [[]]
711 < 1 
712 < 1 
713 < 1 def test_runcite_m4_key_set_and_no_run_line_task(tmp_path):
714 < 1     tasks = [
715 < 1         task_block("4", "Has a run", creates=["runcite4/a.py"],
716 < 1                    run_cmds=["true [M1]"]),
717 < 1         task_block("5", "No run at all", creates=["runcite5/a.py"]),
718 < 1     ]
719 < 1     obj = build_and_run(tmp_path, tasks)
720 < 1 
722 > 1     # Every task object's key set is exactly TASK_FIELDS. [runcite-M4]
721 < 2     # Every task object's key set is exactly TASK_FIELDS, which now carries
722 < 2     # proofRunClauses and nothing else new -- in both `tasks` and
723 < 2     # `launch_waves`. [runcite-M4]
724 < 1     for t in obj["tasks"]:
725 < 1         assert set(t.keys()) == TASK_FIELDS
726 < 2     for wave in obj["launch_waves"]:
727 < 2         for t in wave:
728 < 2             assert set(t.keys()) == TASK_FIELDS
729 < 1 
730 < 1     by_id = {t["id"]: t for t in obj["tasks"]}
731 < 1     assert by_id["4"]["proofRunClauses"] == [["M1"]]  # [runcite-M4]
732 < 1     # A task with no Run: bullet at all prints proofRunClauses exactly [].
733 < 1     # [runcite-M4]
734 < 1     assert by_id["5"]["proofRuns"] == []
735 < 1     assert by_id["5"]["proofRunClauses"] == []
736 < 1 