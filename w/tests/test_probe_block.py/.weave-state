0 < 2 """The stories-v1 probe grammar: one JSON object per ```probe fence, closed checks."""
1 < 1 import sys
2 < 1 from pathlib import Path
3 < 1 
4 < 1 ROOT = Path(__file__).resolve().parents[1]
5 < 1 sys.path.insert(0, str(ROOT / "skills/ultrapowers/scripts"))
6 < 1 import probe_block as pb  # noqa: E402
7 < 1 
8 < 1 EMPTY = [{}, {}]
9 < 1 ONE = [{"todos": {"0": {"text": "buy milk"}}}, {}]
10 < 1 DONE = [{"todos": {"0": {"text": "buy milk", "completed": True}}}, {}]
11 < 1 
12 < 1 
13 < 1 def good():
14 < 1     return {"clause": "S1.1", "layer": "store", "given": [],
15 < 1             "do": [{"tool": "addTodo", "args": {"text": "buy milk"}}],
16 < 1             "expect": [{"table": "todos", "row": "0", "cell": "text", "eq": "buy milk"}],
17 < 1             "see": [], "judge": None, "holds_before": False}
18 < 1 
19 < 1 
20 < 1 def test_a_good_probe_validates():
21 < 1     assert pb.validate_probe(good()) == []
22 < 1 
23 < 1 
24 < 1 def test_unknown_keys_and_bad_layer_are_named():
25 < 1     p = good(); p["mutant"] = []; p["layer"] = "db"
26 < 1     errs = pb.validate_probe(p)
27 < 1     assert any("unknown keys mutant" in e for e in errs)
28 < 1     assert any("layer must be store, ui or saved" in e for e in errs)
29 < 1 
30 < 1 
31 < 1 def test_a_ui_probe_does_click_type_key_and_a_store_probe_one_tool_call():
32 < 1     p = good(); p["layer"] = "ui"
33 < 1     assert any("click/type/key" in e for e in pb.validate_probe(p))
34 < 1     p["do"] = [{"type": {"role": "textbox", "name": "New todo", "text": "x"}},
35 < 1                {"click": {"role": "button", "name": "Add"}}]
36 < 1     assert pb.validate_probe(p) == []
37 < 1     q = good(); q["do"] = [{"click": {"role": "button", "name": "Add"}}]
38 < 1     assert any("one {tool, args} call" in e for e in pb.validate_probe(q))
39 < 1 
40 < 1 
41 < 1 def test_an_open_check_is_refused():
42 < 1     p = good(); p["expect"] = [{"table": "todos", "where": {"text": "x"}}]
43 < 1     assert any("closed checks" in e for e in pb.validate_probe(p))
44 < 1 
45 < 1 
46 < 1 def test_parse_probe_text_reports_bad_json():
47 < 1     p, errs = pb.parse_probe_text("{not json")
48 < 1     assert p is None and errs and errs[0].startswith("probe: not JSON")
49 < 1 
50 < 1 
51 < 1 
52 < 1 
53 < 1 
54 < 1 
55 < 1 def test_tools_of_reads_given_and_tool_do():
56 < 1     p = good(); p["given"] = [{"tool": "addTodo", "args": {"text": "a"}},
57 < 1                               {"tool": "completeTodo", "args": {"id": "0"}}]
58 < 1     assert pb.tools_of(p) == {"addTodo", "completeTodo"}
59 < 1 
60 < 1 
61 < 1 def test_as_names_who_is_signed_in_or_nobody():
62 < 1     p = good(); p["as"] = "kim@station.test"
63 < 1     p["given"] = [{"tool": "addTodo", "args": {"text": "a"}, "as": None}]
64 < 1     assert pb.validate_probe(p) == []
65 < 1     p["as"] = ""
66 < 1     assert any("as must be an email or null" in e for e in pb.validate_probe(p))
67 < 1     q = good(); q["given"] = [{"tool": "addTodo", "args": {}, "as": 3}]
68 < 1     assert any("given must be" in e for e in pb.validate_probe(q))
