0 < 2 /**
1 < 2  * fleet/plan-pins.mjs — the plan-pin check a launch runs before it pushes.
2 < 2  */
3 < 2 
4 < 1 import fsp from 'node:fs/promises'
5 < 1 import os from 'node:os'
6 < 1 import path from 'node:path'
7 < 1 import { spawnSync } from 'node:child_process'
8 < 1 
9 < 1 import { Refusal, git, output } from './lobby.mjs'
10 < 1 
11 < 2 /**
12 < 2  * A hash pin is a fact about BASE, and BASE is chosen at launch and not at
13 < 2  * authoring — so every `git hash-object` literal a plan carries is checked
14 < 2  * against the tree at `--base` before the plan is pushed, with nothing but
15 < 2  * local git reads made. A stale pin found here costs seconds on the laptop; the
16 < 2  * same pin found on the sandbox costs a run.
17 < 2  *
18 < 2  * A pin lives on a `- Check:` bullet of `## Global Constraints` or a `- Run:`
19 < 2  * bullet of a task's Proof — the launcher reads a line by its stripped form and
20 < 2  * not by where in the plan it sits, so a pin on any other kind of line (a
21 < 2  * `**Context:**` sentence quoting one, say) is prose and is not read. Two
22 < 2  * shapes are pins:
23 < 2  *
24 < 2  *   test "$(git hash-object <path>)" = <40-hex>
25 < 2  *   test "$(<command> | git hash-object --stdin)" = <40-hex>
26 < 2  *
27 < 2  * A `Run:` may chain several with `&&`, so one line can carry several.
28 < 2  */
29 < 2 
30 < 2 /** A pin-bearing bullet, by its stripped form. */
31 < 1 const PIN_LINE = /^-\s*(?:Check|Run):\s*(.*)$/
32 < 1 
33 < 2 /**
34 < 2  * `plan_parse.py`'s whole-value backtick rule, copied rather than imported: a
35 < 2  * whole-value backtick wrapper is decoration and comes off before the value is
36 < 2  * matched. A value with backticks INSIDE it does not match and rides
37 < 2  * untouched, exactly as it does there.
38 < 2  */
39 < 1 const WHOLLY_BACKTICKED = /^`([^`]+)`$/
40 < 1 
41 < 2 /**
42 < 2  * The two shapes, each ending in a sha that is 40 hex characters and no more:
43 < 2  * the lookahead is why a 41-hex literal is not a pin, and the exact `{40}` is
44 < 2  * why a 39-hex one is not either. A pin the launcher cannot read is not a pin
45 < 2  * it guesses at.
46 < 2  */
47 < 1 const PATH_PIN = /test\s+"\$\(\s*git\s+hash-object\s+([^\s)"|]+)\s*\)"\s*=\s*([0-9a-f]{40})(?![0-9a-fA-F])/g
48 < 2 /**
49 < 2  * The slice command may not span a `)"`: that boundary closes the substitution
50 < 2  * of an earlier pin on the same `&&`-chained line, and a capture crossing it
51 < 2  * would swallow that pin whole — a path pin chained before a slice pin would be
52 < 2  * read as one slice pin whose command is the two halves joined, handed to
53 < 2  * `/bin/sh` as one command, hashed as the empty blob, and a plan whose pins all
54 < 2  * match would be refused. Only that two-character boundary is forbidden, so a
55 < 2  * command that quotes (`grep "^set -e" f`) or pipes several times still matches.
56 < 2  */
57 < 1 const SLICE_PIN = /test\s+"\$\(\s*((?:(?!\)")[^\n])+?)\s*\|\s*git\s+hash-object\s+--stdin\s*\)"\s*=\s*([0-9a-f]{40})(?![0-9a-fA-F])/g
58 < 1 
59 < 2 /** How a slice pin names itself in a refusal: one line, at most 80 characters. */
60 < 1 const clipCommand = (command) => String(command).replace(/\s+/g, ' ').trim().slice(0, 80)
61 < 1 
62 < 2 /** One stale pin, one line — the path (or clipped command), the pinned sha and
63 < 2  *  what the base really carries, so the operator can see the fix without
64 < 2  *  running anything. */
65 < 1 const pinRefusalLine = (subject, pinned, base, real) =>
66 < 1   `launch: plan pin ${subject}: pinned ${pinned} but --base ${base} has ${real ?? 'no such path'}`
67 < 1 
68 < 2 /** Every pin the plan text carries, in the order the plan writes them. */
69 < 1 function planPins (planText) {
70 < 1   const pins = []
71 < 1   for (const rawLine of String(planText ?? '').split('\n')) {
72 < 1     const bullet = PIN_LINE.exec(rawLine.trim())
73 < 1     if (!bullet) continue
74 < 1     const value = bullet[1].trim()
75 < 1     const unwrapped = WHOLLY_BACKTICKED.exec(value)
76 < 1     const text = unwrapped ? unwrapped[1].trim() : value
77 < 1     const found = []
78 < 1     for (const m of text.matchAll(PATH_PIN)) {
79 < 1       found.push({ at: m.index, kind: 'path', path: m[1], pinned: m[2] })
80 < 1     }
81 < 1     for (const m of text.matchAll(SLICE_PIN)) {
82 < 1       found.push({ at: m.index, kind: 'slice', command: m[1], pinned: m[2] })
83 < 1     }
84 < 1     found.sort((a, b) => a.at - b.at)
85 < 1     pins.push(...found)
86 < 1   }
87 < 1   return pins
88 < 1 }
89 < 1 
90 < 2 /**
91 < 2  * The tree at `<base>`, in a throwaway directory, built with git plumbing
92 < 2  * against a temporary index: `read-tree` fills that index and `checkout-index
93 < 2  * --prefix` writes the files out. The operator's own index, `HEAD` and working
94 < 2  * tree are never read and never written — a launch that verifies a slice pin
95 < 2  * leaves the checkout exactly as a launch that verifies none.
96 < 2  *
97 < 2  * Answers `{ dir, tree }`: `dir` is what the caller removes, `tree` is the
98 < 2  * working directory a slice command runs in.
99 < 2  */
100 < 1 async function basePinCheckout ({ exec, repoDir, base }) {
101 < 1   const dir = await fsp.mkdtemp(path.join(os.tmpdir(), 'fleet-pin-'))
102 < 1   const tree = path.join(dir, 'tree')
103 < 1   const env = { ...process.env, GIT_INDEX_FILE: path.join(dir, 'index') }
104 < 1   try {
105 < 1     await fsp.mkdir(tree, { recursive: true })
106 < 1     for (const argv of [['read-tree', base], ['checkout-index', '-a', '-f', `--prefix=${tree}${path.sep}`]]) {
107 < 1       const res = await exec('git', ['-C', repoDir, ...argv], { env })
108 < 1       if (res.code !== 0) {
109 < 1         throw new Refusal(`launch: git ${argv.join(' ')} failed (exit ${res.code}):\n${output(res)}`)
110 < 1       }
111 < 1     }
112 < 1   } catch (error) {
113 < 1     await fsp.rm(dir, { recursive: true, force: true })
114 < 1     throw error
115 < 1   }
116 < 1   return { dir, tree }
117 < 1 }
118 < 1 
119 < 2 /**
120 < 2  * What a slice pin's command really hashes to at `--base`: the command under
121 < 2  * `/bin/sh -c` with the extracted tree as its working directory, its stdout
122 < 2  * hashed with `git hash-object --stdin`. The shell runs outside the exec seam
123 < 2  * because it is not a lobby verb and not a git read — it is the plan's own
124 < 2  * command, and it must really run for its sha to mean anything.
125 < 2  */
126 < 1 async function slicePinSha ({ exec, repoDir, tree, command }) {
127 < 1   const ran = spawnSync('/bin/sh', ['-c', command], { cwd: tree, maxBuffer: 32 * 1024 * 1024 })
128 < 1   const res = await exec('git', ['-C', repoDir, 'hash-object', '--stdin'], {
129 < 1     input: ran.stdout ?? Buffer.alloc(0)
130 < 1   })
131 < 1   if (res.code !== 0) {
132 < 1     throw new Refusal(
133 < 1       `launch: git hash-object --stdin failed (exit ${res.code}) for plan pin ${clipCommand(command)}:\n${output(res)}`
134 < 1     )
135 < 1   }
136 < 1   return String(res.stdout ?? '').trim()
137 < 1 }
138 < 1 
139 < 2 /**
140 < 2  * Every pin the plan carries, verified against `<base>`, or a `Refusal` (exit
141 < 2  * 2) carrying one line per stale pin — so two stale pins are two lines and an
142 < 2  * operator fixes both in one pass. A path absent at `--base` is stale, not
143 < 2  * skipped: a pin naming a file the base does not have is a pin about some other
144 < 2  * tree.
145 < 2  *
146 < 2  * The base's blob for a path is `git rev-parse <base>:<path>`, which is what
147 < 2  * `git hash-object <path>` answers in a checkout of `<base>` — no clean filter
148 < 2  * is configured in this repository. A slice pin needs the files themselves, so
149 < 2  * it gets a throwaway checkout that is removed in a `finally`, whether this
150 < 2  * answers or throws.
151 < 2  */
152 < 1 export async function verifyPlanPins ({ exec, repoDir, base, planText }) {
153 < 1   const pins = planPins(planText)
154 < 1   if (pins.length === 0) return
155 < 1   const checkout = pins.some((pin) => pin.kind === 'slice')
156 < 1     ? await basePinCheckout({ exec, repoDir, base })
157 < 1     : null
158 < 1   const stale = []
159 < 1   try {
160 < 1     for (const pin of pins) {
161 < 1       if (pin.kind === 'path') {
162 < 1         const res = await git(exec, repoDir, ['rev-parse', `${base}:${pin.path}`])
163 < 1         const real = res.code === 0 ? String(res.stdout ?? '').trim() : null
164 < 1         if (real !== pin.pinned) stale.push(pinRefusalLine(pin.path, pin.pinned, base, real))
165 < 1         continue
166 < 1       }
167 < 1       const real = await slicePinSha({ exec, repoDir, tree: checkout.tree, command: pin.command })
168 < 1       if (real !== pin.pinned) {
169 < 1         stale.push(pinRefusalLine(clipCommand(pin.command), pin.pinned, base, real))
170 < 1       }
171 < 1     }
172 < 1   } finally {
173 < 1     if (checkout !== null) await fsp.rm(checkout.dir, { recursive: true, force: true })
174 < 1   }
175 < 1   if (stale.length > 0) throw new Refusal(stale.join('\n'))
176 < 1 }
177 < 1 