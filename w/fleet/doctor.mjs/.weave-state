0 < 1 #!/usr/bin/env node
1 < 1 /**
2 < 1  * fleet/doctor.mjs — "do you have a fleet?"
3 < 1  *
6 > 1  * The ten rows, their reads and their verdicts are `fleet/CONTRACT.md` §Doctor;
5 > 2  * The eleven rows, their reads and their verdicts are `fleet/CONTRACT.md` §Doctor;
4 < 2  * The ten rows, their reads and their verdicts are `fleet/CONTRACT.md` §Doctor;
5 < 1  * each red row names the `references/first-run.md` section that builds the
6 < 1  * piece. This header does not restate them (#1444). Every row is a read:
7 < 1  * running the doctor twice is the same as running it once.
8 < 1  *
9 < 1  * Built-ins only: the doctor runs on a user's laptop straight out of the
10 < 1  * installed plugin cache, where no `node_modules` under `fleet/` has ever
11 < 1  * existed, so every specifier here is `node:`-prefixed or a sibling fleet
12 < 1  * module that is itself built-ins-only (the config readers come from
13 < 1  * `./lobby.mjs`, one copy for both the doctor and the launcher).
14 < 1  *
15 < 1  * No token rows: no token is on any disk the doctor could stat. The Claude
16 < 1  * subscription reaches a sandbox through the `claude-max` http-proxy, whose
17 < 1  * bearer is injected at exe.dev's edge, and `integrations test claude-max` is
18 < 1  * not a check for an http-proxy (measured 2026-09-04: it answers "test
19 < 1  * connection is available for catalog and database integrations"), so the
20 < 1  * bearer's presence in the listing is the edge-side truth the doctor can read.
21 < 1  */
22 < 1 
23 < 1 import fsp from 'node:fs/promises'
24 < 1 import path from 'node:path'
25 < 1 import { fileURLToPath } from 'node:url'
26 < 1 
27 < 1 import {
28 < 1   CLAUDE_INTEGRATION,
29 < 1   DEFAULT_CONFIG_PATH,
30 < 1   EXE_HOST,
31 < 1   FLEET_DEFAULTS,
32 < 1   FLEET_POLICY,
33 < 1   FLEET_TAG,
34 < 1   Refusal,
35 < 1   VERBS_PATH,
36 < 1   VERBS_RECORD,
37 < 1   defaultExec,
38 < 1   githubIntegrationFor,
39 < 1   isSafeTarget,
40 < 1   listIntegrations,
41 < 1   loadFleetConfig,
42 < 1   parseArgs,
43 < 1   parseJson,
44 < 1   parseMemoryGb,
46 > 2   policyCell,
45 < 1   readEvidenceSetting,
46 < 1   readFleetJson,
47 < 1   readPlanCapacity,
48 < 1   runCli
49 < 1 } from './lobby.mjs'
50 < 1 
53 > 1 /** The ten rows, in the order the doctor reports them. Each id is also a
52 > 2 /** The eleven rows, in the order the doctor reports them. Each id is also a
51 < 2 /** The ten rows, in the order the doctor reports them. Each id is also a
52 < 1  *  `## ` heading in skills/ultrapowers/references/first-run.md. */
53 < 1 export const ROW_IDS = Object.freeze([
56 > 1   'exe-dev', 'capacity', 'claude', 'accounts', 'github', 'integrations', 'evidence', 'verb-drift', 'cloudflare', 'reaper'
55 > 2   'exe-dev', 'capacity', 'claude', 'accounts', 'github', 'integrations', 'evidence', 'verb-drift', 'kata', 'cloudflare', 'reaper'
54 < 2   'exe-dev', 'capacity', 'claude', 'accounts', 'github', 'integrations', 'evidence', 'verb-drift', 'kata', 'cloudflare'
55 < 1 ])
56 < 1 
57 < 1 /** Each row's `fix` is the `## ` heading in first-run.md that repairs it, and
58 < 1  *  every row id is its own heading. */
59 < 1 const FIXES = Object.freeze(Object.fromEntries(ROW_IDS.map((id) => [id, id])))
60 < 1 
61 < 1 /** The doctor's own directory: claude-token.mjs sits beside this file, and the
62 < 1  *  doctor runs it rather than importing it, so its keychain access stays out of
63 < 1  *  a process that has to start when nothing else in the fleet does. */
64 < 1 const HERE = path.dirname(fileURLToPath(import.meta.url))
65 < 1 const CLAUDE_TOKEN = path.join(HERE, 'claude-token.mjs')
66 < 1 
67 < 1 /** The standing lobby reads, as the remote half of `ssh exe.dev "<remote>"`,
68 < 1  *  in the order the doctor issues them; the three `claude-token.mjs` reads sit
70 > 1  *  between the github and hub ones, then the `help` reads of the
69 < 2  *  between the github and kata ones, then the `help` reads of the
70 < 1  *  verb-drift row, one per verb of the record; together they are the only
71 < 1  *  commands the doctor ever runs, every one through the exec seam
72 < 1  *  `exec(cmd, argv)` — `ssh` or `node`, never a shell string.
73 < 1  *
75 > 1  *  `hubVm` is the `reaper` row's: the hub VM (`kata-hub`, the name it has had
76 < 1  *  since it also ran the kata daemon) is the one thing the doctor asks `ls`
77 < 1  *  about, since the remover is asked from it. */
74 < 2  *  The last is the `kata` row's: the hub is the one thing the doctor asks `ls`
75 < 2  *  about, every other row reading edge-side objects the listing already
76 < 2  *  carries. */
77 < 1 const READS = Object.freeze({
78 < 1   whoami: 'whoami',
79 < 1   github: 'integrations setup github --list',
82 > 1   hubVm: 'ls kata-hub --json',
81 > 2   kataVm: 'ls kata-hub --json',
82 < 1   keys: 'ssh-key list --json'
80 < 2   kataVm: 'ls kata-hub --json'
81 < 1 })
82 < 1 
83 < 1 /** One lobby read: `ssh exe.dev "<remote>"`, answered whatever its exit code,
84 < 1  *  so every row keeps the code it reports. */
85 < 1 const lobbyRead = (exec, remote) => exec('ssh', [EXE_HOST, remote])
86 < 1 
87 < 1 /** One `claude-token.mjs` read. stderr joins stdout because claude-token logs
88 < 1  *  its status line there. */
89 < 1 async function tokenRead (exec, argv) {
90 < 1   const res = await exec('node', [CLAUDE_TOKEN, ...argv])
91 < 1   return { code: res.code, stdout: `${res.stdout ?? ''}${res.stderr ?? ''}` }
92 < 1 }
93 < 1 
94 < 1 /** The bearer the edge injects, as the listing spells it. */
95 < 1 const BEARER = 'Authorization:Bearer'
96 < 1 
97 < 1 const row = (id, status, detail) => ({ id, status, detail, fix: FIXES[id] })
98 < 1 const firstLine = (stdout) => String(stdout ?? '').split('\n')[0].trim()
99 < 1 
100 < 1 const parseCpus = (value) => (/^\d+$/.test(String(value ?? '').trim()) ? Number(value) : null)
101 < 1 
102 < 1 /**
103 < 1  * The config file's default account: its top-level `account`, or null when the
104 < 1  * file is absent, is not JSON, is not a JSON object, or names no account. The
105 < 1  * launcher reads the same key to pick the keychain entry a run signs in with;
106 < 1  * the doctor reads it only to ask whether the keychain holds that name.
107 < 1  *
108 < 1  * It travels beside `loadFleetConfig` rather than inside it: `result.config` is
109 < 1  * exactly the two keys the doctor itself reads, and the account reaches
110 < 1  * `doctor()` as its own option.
111 < 1  */
112 < 1 export async function fleetConfigAccount ({ path: configPath } = {}) {
113 < 1   const account = (await readFleetJson(configPath ?? DEFAULT_CONFIG_PATH()))?.account
114 < 1   return typeof account === 'string' && account !== '' ? account : null
115 < 1 }
116 < 1 
117 < 1 // ── exe-dev ──────────────────────────────────────────────────────────────────
118 < 1 
119 < 1 function exeDevRow (res) {
120 < 1   const who = firstLine(res.stdout)
121 < 1   if (res.code === 0 && who !== '') return row('exe-dev', 'ok', `signed in as ${who}`)
122 < 1   return row('exe-dev', 'missing', `ssh exe.dev whoami answered code ${res.code} with no account name`)
123 < 1 }
124 < 1 
125 < 1 // ── capacity ─────────────────────────────────────────────────────────────────
126 < 1 
127 < 1 /**
128 < 1  * `billing plan --json` is one flat object with `max_cpus`, `max_memory_gb`,
129 < 1  * `tier` and `plan`. The row reports two numbers side by side — the pool, and
130 < 1  * the size one run asks for — and draws no conclusion from them, because
131 < 1  * allocation on exe.dev is over-committable: 56 vCPU stood allocated against a
132 < 1  * 16-vCPU plan and no run was ever refused (measured 2026-09-05). A pool
133 < 1  * smaller than the ask is therefore a green row that says so, not a limit.
134 < 1  *
135 < 1  * Only a number the doctor could not read turns the row red: an unreadable
136 < 1  * `billing plan --json`, or a `cpu`/`memory` it cannot parse. Both details name
137 < 1  * `~/.ultrapowers/fleet.json`, the file that sets the size a run asks for.
138 < 1  */
139 < 1 /**
140 < 1  * The pool `billing plan --json` answered, through the lobby's own reader:
141 < 1  * `{ maxCpus, maxMemoryGb, tier }`, or null when the verb exited non-zero or
142 < 1  * answered no numeric `max_cpus`. `readPlanCapacity` reads an absent
143 < 1  * `max_memory_gb` as 0, which is a launch's business; the doctor reads it as no
144 < 1  * pool, so `maxMemoryGb` is null unless the payload itself carries a number.
145 < 1  */
146 < 1 async function readPool (res) {
147 < 1   if (res.code !== 0) return null
148 < 1   let capacity
149 < 1   try {
150 < 1     capacity = await readPlanCapacity(async () => res)
151 < 1   } catch {
152 < 1     return null
153 < 1   }
154 < 1   const payload = parseJson(res.stdout)
155 < 1   return {
156 < 1     maxCpus: capacity.maxCpus,
157 < 1     maxMemoryGb: typeof payload?.max_memory_gb === 'number' ? capacity.maxMemoryGb : null,
158 < 1     tier: capacity.tier !== '' ? capacity.tier : String(payload?.plan ?? 'untiered')
159 < 1   }
160 < 1 }
161 < 1 
162 < 1 function poolRow (res, pool, config) {
163 < 1   const askedCpu = parseCpus(config.cpu)
164 < 1   const askedGb = parseMemoryGb(config.memory)
165 < 1   if (askedCpu === null || askedGb === null) {
166 < 1     return row(
167 < 1       'capacity',
168 < 1       'missing',
169 < 1       `~/.ultrapowers/fleet.json asks for cpu ${config.cpu} / memory ${config.memory}, which is not <int> and <int>GB`
170 < 1     )
171 < 1   }
172 < 1 
173 < 1   if (pool === null || pool.maxMemoryGb === null) {
174 < 1     return row(
175 < 1       'capacity',
176 < 1       'missing',
177 < 1       `billing plan --json answered code ${res.code} with no readable pool — ~/.ultrapowers/fleet.json sets the size a run asks for`
178 < 1     )
179 < 1   }
180 < 1 
181 < 1   const described = `${pool.tier} pool ${pool.maxCpus} vCPU / ${pool.maxMemoryGb}GB`
182 < 1   const asked = `${askedCpu} vCPU / ${askedGb}GB`
183 < 1   return row('capacity', 'ok', `${described}; a run asks ${asked}`)
184 < 1 }
185 < 1 
186 < 1 /** The two key names the doctor reads, as the row's detail spells them. */
187 < 1 const READ_KEYS = Object.keys(FLEET_DEFAULTS)
188 < 1 
189 < 1 /** The names something outside the doctor reads, as the row's detail spells
190 < 1  *  them: `account` picks the keychain entry a run signs in with, and
191 < 1  *  `evidence` names the repository a run keeps its record in. They are the
192 < 1  *  launcher's to read; the doctor only asks whether what they name is there. */
193 < 1 const LAUNCHER_KEYS = Object.freeze(['account', 'evidence'])
194 < 1 
195 < 1 /** Every name the config file may carry: the two the doctor reads, and the
196 < 1  *  ones the launcher does. A name outside this list is a key nothing reads. */
197 < 1 const CONFIG_KEYS = Object.freeze([...READ_KEYS, ...LAUNCHER_KEYS])
198 < 1 
199 < 1 /**
200 < 1  * The pool arithmetic, plus what the config file's own key names say about it.
201 < 1  *
202 < 1  * `configKeys` is the file's own top-level key names (`readFleetJson`): null when there
203 < 1  * is no file to read keys off, and otherwise every top-level name in it. A name
204 < 1  * outside `CONFIG_KEYS` is a key left by a fleet from before the lift — the
205 < 1  * operator wrote a setting nothing consults, so the row is red until the file is
206 < 1  * rewritten, and the detail names those keys by echoing the file rather than
207 < 1  * spelling any of them here. `account` is not among them: the doctor never reads
208 < 1  * it, but the launcher does, and the `accounts` row says whether what it names is
209 < 1  * there. A file that omits one of the two the doctor does read is not wrong, only
210 < 1  * silent, so the green detail says which default it fell back to.
211 < 1  */
212 < 1 function capacityRow (res, pool, config, configKeys = null) {
213 < 1   const base = poolRow(res, pool, config)
214 < 1   const keys = Array.isArray(configKeys) ? configKeys.filter((k) => typeof k === 'string') : null
215 < 1   if (keys === null) return base
216 < 1 
217 < 1   const stale = keys.filter((key) => !CONFIG_KEYS.includes(key))
218 < 1   if (stale.length > 0) {
219 < 1     return row(
220 < 1       'capacity',
221 < 1       'missing',
222 < 1       `~/.ultrapowers/fleet.json carries ${stale.join(', ')} — keys nothing reads; ` +
223 < 1         `it reads ${READ_KEYS.join(' and ')} only, and the launcher reads ` +
224 < 1         `${LAUNCHER_KEYS.join(' and ')}. ${base.detail}`
225 < 1     )
226 < 1   }
227 < 1   if (base.status !== 'ok') return base
228 < 1 
229 < 1   const lacking = READ_KEYS.filter((key) => !keys.includes(key))
230 < 1   const notes = lacking.map(
231 < 1     (key) => ` (${key} not in ~/.ultrapowers/fleet.json — the default ${FLEET_DEFAULTS[key]})`
232 < 1   )
233 < 1   return notes.length === 0 ? base : row('capacity', 'ok', `${base.detail}${notes.join('')}`)
234 < 1 }
235 < 1 
236 < 1 // ── integrations, read once for two rows ─────────────────────────────────────
237 < 1 
238 < 1 /**
239 < 1  * `integrations list --json`, read through the lobby's own `listIntegrations`.
240 < 1  * The doctor asks three questions of each object — does it exist, does it
241 < 1  * carry the bearer, and is it attached to `tag:fleet` — and the lobby's reader
242 < 1  * answers all three defensively (`bearer`, `tags`), so a field rename on
243 < 1  * exe.dev's side does not turn a healthy fleet red for the wrong reason.
244 < 1  *
245 < 1  * Answers a Map of name → `{ name, tags, github, bearer, comment }`, or null
246 < 1  * when the verb exited non-zero or its stdout is not a listing at all.
247 < 1  * `comment` is the entry's own comment string or null: the credential tool
248 < 1  * writes `account=<name>` into `claude-max`'s on every install, and the
249 < 1  * `accounts` row reads the edge's account off it.
250 < 1  */
251 < 1 async function readIntegrations (res) {
252 < 1   if (res.code !== 0) return null
253 < 1   const payload = parseJson(res.stdout)
254 < 1   if (!Array.isArray(payload) && !Array.isArray(payload?.integrations)) return null
255 < 1   const out = new Map()
256 < 1   for (const entry of await listIntegrations(async () => res)) {
257 < 1     out.set(entry.name, {
258 < 1       name: entry.name,
259 < 1       tags: entry.tags,
260 < 1       bearer: entry.bearer,
261 < 1       comment: entry.comment
262 < 1     })
263 < 1   }
264 < 1   return out
265 < 1 }
266 < 1 
267 < 1 /** The fix for an integration no fleet VM is granted. */
268 < 1 const attachFix = (name) => `ssh exe.dev "integrations attach ${name} ${FLEET_POLICY}"`
269 < 1 
270 < 1 /**
271 < 1  * The one question every integration row asks: is the object `name` granted to
272 < 1  * fleet VMs, i.e. attached to `tag:fleet` in `integrations list --json`?
273 < 1  * Resolves null when it is, otherwise the row `id` reports: an absent object is
274 < 1  * `ok` with `absentIsOk` (and `absentDetail`), `missing` without; an unattached
275 < 1  * one is `missing`, naming `attachFix(name)`.
276 < 1  */
277 < 1 export function attachRowFor (name, { id, found, absentIsOk = false, absentDetail = null } = {}) {
278 < 1   const have = found === null || found === undefined ? undefined : found.get(name)
279 < 1   if (have === undefined) {
280 < 1     return row(id, absentIsOk ? 'ok' : 'missing', absentDetail ?? `no ${name} integration at the edge`)
281 < 1   }
282 < 1   if (have.tags.includes(FLEET_TAG)) return null
283 < 1   return row(id, 'missing', `${name} is not attached to ${FLEET_POLICY}, so no fleet VM is granted it — ${attachFix(name)}`)
284 < 1 }
285 < 1 // ── claude ───────────────────────────────────────────────────────────────────
286 < 1 
287 < 1 /**
288 < 1  * `usage --json --no-rotate`'s first row, read for its own detail suffix: the
289 < 1  * account's seven-day and five-hour windows when the row reads clean, or
290 < 1  * `usage unread — <reason>` when it does not — a non-zero exit reads as
291 < 1  * `usage answered code <code>`, an `unread: true` row as its own `reason`.
292 < 1  * A read never rotates the token; that is the point of `--no-rotate`.
293 < 1  */
294 < 1 function usageSuffix (usageRes) {
295 < 1   if (usageRes.code !== 0) {
296 < 1     return `; usage unread — usage answered code ${usageRes.code}`
297 < 1   }
298 < 1   let parsed
299 < 1   try {
300 < 1     parsed = JSON.parse(usageRes.stdout)
301 < 1   } catch {
302 < 1     parsed = null
303 < 1   }
304 < 1   const first = Array.isArray(parsed) ? parsed[0] : undefined
305 < 1   if (first === undefined || first.unread) {
306 < 1     const reason = first?.reason ?? 'no readable JSON'
307 < 1     return `; usage unread — ${reason}`
308 < 1   }
309 < 1   const { sevenDay, fiveHour } = first
310 < 1   return `; 7d ${sevenDay.utilization}% resets ${sevenDay.resetsAt}` +
311 < 1     `; 5h ${fiveHour.utilization}% resets ${fiveHour.resetsAt}`
312 < 1 }
313 < 1 
314 < 1 /**
315 < 1  * The bearer has to exist at the edge. Whether the object reaches a fleet VM
316 < 1  * is the `integrations` row's question (its attachment), not this one's.
317 < 1  *
318 < 1  * claude-token's status line only decorates the row. Either outcome leaves the
319 < 1  * status alone — the bearer is injected at the edge whether or not this laptop
320 < 1  * still holds the refresh token — and only the detail differs. The usage
321 < 1  * window reading rides beside it, appended to `detail` either way, so the
322 < 1  * reading is visible whether or not the bearer is found.
323 < 1  */
324 < 1 function claudeRow (found, tokenRes, usageRes) {
325 < 1   const suffix = usageSuffix(usageRes)
326 < 1   if (found === null) {
327 < 1     return row('claude', 'missing', `integrations list printed no readable JSON${suffix}`)
328 < 1   }
329 < 1   const have = found.get(CLAUDE_INTEGRATION)
330 < 1   if (have === undefined || !have.bearer) {
331 < 1     const why = have === undefined
332 < 1       ? `no ${CLAUDE_INTEGRATION} integration at the edge`
333 < 1       : `${CLAUDE_INTEGRATION} carries no ${BEARER} header`
334 < 1     return row('claude', 'missing', `${why} — node fleet/claude-token.mjs login${suffix}`)
335 < 1   }
336 < 1   const status = tokenRes.code === 0 && firstLine(tokenRes.stdout) !== ''
337 < 1     ? firstLine(tokenRes.stdout)
338 < 1     : 'no refresh token in the keychain — the bearer will not be refreshed before a run'
339 < 1   return row('claude', 'ok', `${CLAUDE_INTEGRATION} carries the bearer at the edge; ${status}${suffix}`)
340 < 1 }
341 < 1 
342 < 1 // ── accounts ─────────────────────────────────────────────────────────────────
343 < 1 
344 < 1 /** The command a laptop with no usable keychain entry runs. */
345 < 1 const LOGIN = 'node fleet/claude-token.mjs login'
346 < 1 
347 < 1 /** The token the credential tool writes into `claude-max`'s comment on every
348 < 1  *  install, so the edge itself records which account its bearer came from. */
349 < 1 const ACCOUNT_TOKEN = 'account='
350 < 1 
351 < 1 /**
352 < 1  * `claude-token.mjs accounts --json` prints one object per keychain entry —
353 < 1  * `{ name, expiresAt, fresh }` — under the one service. Nothing secret is in
354 < 1  * it: an expiry and a name, never a token.
355 < 1  */
356 < 1 function parseAccounts (res) {
357 < 1   if (res.code !== 0) return null
358 < 1   const parsed = parseJson(res.stdout)
359 < 1   return Array.isArray(parsed) ? parsed : null
360 < 1 }
361 < 1 
362 < 1 const accountName = (entry) => (entry && typeof entry.name === 'string' ? entry.name : '')
363 < 1 
364 < 1 const describeAccount = (entry) =>
365 < 1   `${accountName(entry)} ${entry?.fresh === true ? 'fresh until' : 'expired'} ${String(entry?.expiresAt ?? '')}`
366 < 1 
367 < 1 /**
368 < 1  * The account the edge carries, off `claude-max`'s comment: the value after
369 < 1  * `account=` in the first whitespace-separated token that starts with it. Null
370 < 1  * when the comment is prose with no such token — an install from before the
371 < 1  * tool wrote one, which the next refresh records.
372 < 1  */
373 < 1 function edgeAccount (found) {
374 < 1   const comment = found?.get(CLAUDE_INTEGRATION)?.comment
375 < 1   if (typeof comment !== 'string') return null
376 < 1   for (const word of comment.split(/\s+/)) {
377 < 1     if (!word.startsWith(ACCOUNT_TOKEN)) continue
378 < 1     const name = word.slice(ACCOUNT_TOKEN.length)
379 < 1     return name === '' ? null : name
380 < 1   }
381 < 1   return null
382 < 1 }
383 < 1 
384 < 1 /**
385 < 1  * Which accounts this laptop holds, when each one expires, which of them the
386 < 1  * edge is carrying, and — when `~/.ultrapowers/fleet.json` names one — whether
387 < 1  * the keychain holds that name at all. An expired entry is not red: the
388 < 1  * launcher refreshes before every run, and the bearer already lives at the
389 < 1  * edge. An empty keychain is, because nothing can be refreshed from it.
390 < 1  */
391 < 1 function accountsRow (res, found, account) {
392 < 1   const entries = parseAccounts(res)
393 < 1   if (entries === null) {
394 < 1     return row(
395 < 1       'accounts',
396 < 1       'missing',
397 < 1       `claude-token.mjs accounts --json answered code ${res.code} with no JSON array of keychain entries — ${LOGIN}`
398 < 1     )
399 < 1   }
400 < 1   if (entries.length === 0) {
401 < 1     return row('accounts', 'missing', `the keychain holds no account — ${LOGIN}`)
402 < 1   }
403 < 1 
404 < 1   const listed = entries.map(describeAccount).join(', ')
405 < 1   const edge = edgeAccount(found)
406 < 1   const carries = edge === null ? '; edge account unrecorded' : `; edge carries ${edge}`
407 < 1   if (account !== null && !entries.map(accountName).includes(account)) {
408 < 1     return row(
409 < 1       'accounts',
410 < 1       'missing',
411 < 1       `~/.ultrapowers/fleet.json names ${account}, which no keychain entry carries — ` +
412 < 1         `${listed}${carries} — ${LOGIN} --account ${account}`
413 < 1     )
414 < 1   }
415 < 1   const named = account === null ? '' : `; fleet.json names ${account}`
416 < 1   return row('accounts', 'ok', `${listed}${carries}${named}`)
417 < 1 }
418 < 1 
419 < 1 // ── verb-drift ───────────────────────────────────────────────────────────────
420 < 1 
421 < 1 /** The only shape a verb name may take before it is interpolated into an ssh
422 < 1  *  string. Any other key of the record is reported unreadable, never run. */
423 < 1 const VERB = /^[a-z][a-z0-9 -]*$/
424 < 1 
425 < 1 /** The lobby's `Options:` block: two spaces, the flag, spaces, its description.
426 < 1  *  `help <verb>` and `<verb> --help` print the same block (measured 2026-09-05),
427 < 1  *  and `help …` is not a mutating verb, so this is the form the doctor asks. */
428 < 1 const FLAG_LINE = /^[ \t]+(--[A-Za-z0-9-]+)/gm
429 < 1 
430 < 1 function helpFlags (stdout) {
431 < 1   const flags = []
432 < 1   for (const match of String(stdout ?? '').matchAll(FLAG_LINE)) {
433 < 1     if (!flags.includes(match[1])) flags.push(match[1])
434 < 1   }
435 < 1   return flags
436 < 1 }
437 < 1 
438 < 1 /**
439 < 1  * Re-fetch `help <verb>` for every verb of the verb record (`VERBS_PATH`, or
440 < 1  * `recordPath` so an exam drives the row from a fixture) and diff the live
441 < 1  * flag set against the recorded one.
442 < 1  *
443 < 1  * `--help` answers text, not JSON — a `Command:` line, a description, an
444 < 1  * optional `Usage:` line, an `Options:` block and an optional `Examples:` block
445 < 1  * — so the diff unit is the flag set and the record stores flag names, not
446 < 1  * prose. A verb the lobby no longer knows answers a line starting `No help
447 < 1  * available for unrecognized command:` at exit 0, which is why a stdout with no
448 < 1  * flag at all counts as unreadable whatever the exit code was.
449 < 1  *
450 < 1  * A drift is a finding, never a refusal: the caller decides what a finding is
451 < 1  * worth. Only a record this cannot read at all answers `readable: false`.
452 < 1  */
453 < 1 export async function verbDrift ({ help, recordPath } = {}) {
454 < 1   const target = recordPath ?? VERBS_PATH
455 < 1   const unreadable = (why) => ({
456 < 1     readable: false,
457 < 1     capturedAt: null,
458 < 1     findings: [],
459 < 1     detail: `${VERBS_RECORD} ${why} — re-capture it from ssh exe.dev "help <verb>" output`
460 < 1   })
461 < 1 
462 < 1   let text
463 < 1   try {
464 < 1     text = await fsp.readFile(target, 'utf8')
465 < 1   } catch {
466 < 1     return unreadable('is not there')
467 < 1   }
468 < 1   let record
469 < 1   try {
470 < 1     record = JSON.parse(text)
471 < 1   } catch {
472 < 1     return unreadable('is not JSON')
473 < 1   }
474 < 1   const verbs = record && typeof record === 'object' ? record.verbs : null
475 < 1   if (!verbs || typeof verbs !== 'object' || Array.isArray(verbs)) {
476 < 1     return unreadable('carries no verbs object')
477 < 1   }
478 < 1   const capturedAt = typeof record.capturedAt === 'string' ? record.capturedAt : null
479 < 1 
480 < 1   const names = Object.keys(verbs)
481 < 1   const findings = []
482 < 1   const segments = []
483 < 1   for (const verb of names) {
484 < 1     const recorded = Array.isArray(verbs[verb]) ? verbs[verb].filter((f) => typeof f === 'string') : []
485 < 1 
486 < 1     if (!VERB.test(verb)) {
487 < 1       findings.push({ verb, appeared: [], vanished: [], unreadable: -1 })
488 < 1       segments.push(`${verb}: help unreadable (code -1)`)
489 < 1       continue
490 < 1     }
491 < 1 
492 < 1     const res = await help(verb)
493 < 1     const live = helpFlags(res?.stdout)
494 < 1     if (res?.code !== 0 || live.length === 0) {
495 < 1       const code = typeof res?.code === 'number' ? res.code : -1
496 < 1       findings.push({ verb, appeared: [], vanished: [], unreadable: code })
497 < 1       segments.push(`${verb}: help unreadable (code ${code})`)
498 < 1       continue
499 < 1     }
500 < 1 
501 < 1     const appeared = live.filter((flag) => !recorded.includes(flag))
502 < 1     const vanished = recorded.filter((flag) => !live.includes(flag))
503 < 1     if (appeared.length === 0 && vanished.length === 0) continue
504 < 1     findings.push({ verb, appeared, vanished, unreadable: null })
505 < 1     if (appeared.length > 0) segments.push(`${verb}: ${appeared.join(', ')} appeared`)
506 < 1     if (vanished.length > 0) segments.push(`${verb}: ${vanished.join(', ')} vanished`)
507 < 1   }
508 < 1 
509 < 1   const detail = segments.length === 0
510 < 1     ? `${names.length} verbs match ${VERBS_RECORD} (captured ${capturedAt})`
511 < 1     : `drift since ${capturedAt}: ${segments.join('; ')} — re-measure the behaviours with node fleet/tests/probe_exe_facts.mjs`
512 < 1   return { readable: true, capturedAt, findings, detail }
513 < 1 }
514 < 1 
515 < 1 /** A readable record is a green row whatever it found; an unreadable one is the
516 < 1  *  only red, because then the doctor has nothing to compare the lobby against. */
517 < 1 const verbDriftRow = (drift) => row('verb-drift', drift.readable ? 'ok' : 'missing', drift.detail)
518 < 1 
519 < 1 // ── github ───────────────────────────────────────────────────────────────────
520 < 1 
521 < 1 /**
522 < 1  * `integrations setup github --list` has no `--json` (`--json` is a
523 < 1  * flag-parsing error), so the row reads the two-line form it does print: a
524 < 1  * `GitHub accounts:` header, then one indented account per line. No account
525 < 1  * means the browser step has never been walked.
526 < 1  */
