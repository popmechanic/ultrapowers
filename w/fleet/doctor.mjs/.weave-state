713 < 1  */
714 < 1 export async function doctor ({
718 > 1   config, exec, target = null, configKeys = null, account = null, verbsPath = null, evidence = null, now = Date.now()
717 > 2   config, exec, target = null, configKeys = null, account = null, verbsPath = null, evidence = null, now = Date.now(),
718 < 2   kataMode = kataModeOf()
716 > 2   config, exec, target = null, configKeys = null, account = null, verbsPath = null, evidence = null, now = Date.now()
715 < 2   config, exec, target = null, configKeys = null, account = null, verbsPath = null, evidence = null
716 < 1 } = {}) {
717 < 1   const cfg = { ...FLEET_DEFAULTS, ...(config ?? {}) }
718 < 1   const run = exec ?? defaultExec
719 < 1   const want = target === null || target === undefined ? null : String(target)
720 < 1   if (want !== null && !isSafeTarget(want)) {
721 < 1     throw new Error(`--target takes owner/repo, not ${JSON.stringify(want)}`)
722 < 1   }
723 < 1   const wantAccount = account === null || account === undefined ? null : String(account)
724 < 1   const wantEvidence = evidence === null || evidence === undefined ? null : String(evidence)
725 < 1   if (wantEvidence !== null && !isSafeTarget(wantEvidence)) {
726 < 1     throw new Error(`evidence takes owner/repo, not ${JSON.stringify(wantEvidence)}`)
727 < 1   }
728 < 1 
729 < 1   const read = (remote) => lobbyRead(run, remote)
730 < 1   const whoami = await read(READS.whoami)
731 < 1   // The lobby's own readers, each handed the answer already in hand so a
732 < 1   // non-zero exit stays the code the row reports rather than a thrown error.
733 < 1   const billing = await read('billing plan --json')
734 < 1   const pool = await readPool(billing)
735 < 1   const list = await read('integrations list --json')
736 < 1   const found = await readIntegrations(list)
737 < 1   const github = await read(READS.github)
738 < 1   // The status read names the configured account (`fleet.json` `account`), never
739 < 1   // the code's default: the keychain entries are named by email since 2026-09-11.
740 < 1   const token = await tokenRead(run, wantAccount ? ['status', '--account', wantAccount] : ['status'])
741 < 1   // The usage read carries `--account` before `--no-rotate`, unlike the token
742 < 1   // read's trailing clause, and never rotates the token it reads.
743 < 1   const usage = await tokenRead(run, wantAccount
744 < 1     ? ['usage', '--json', '--account', wantAccount, '--no-rotate']
745 < 1     : ['usage', '--json', '--no-rotate'])
746 < 1   const accounts = await tokenRead(run, ['accounts', '--json'])
747 < 1   // The hub's VM, then the evidence repository when a key names one.
749 > 1   const hubVms = await read(READS.hubVm)
748 < 2   const kataVms = await read(READS.kataVm)
751 > 1   // The account's keys, for the one the hub's reaper removes VMs with, and the remover's own answer.
750 > 2   // The account's keys, for the one the hub's reaper removes VMs with.
751 < 1   const keys = await read(READS.keys)
753 > 1   const hub = hubVmRow(hubVms)
752 < 2   const hub = kataVmRow(kataVms)
753 < 1   const reaperProbe = found && found.has(REAPER_INTEGRATION) && typeof hub?.ssh_dest === 'string' && hub.ssh_dest !== ''
754 < 1     ? await run('ssh', ['-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15', hub.ssh_dest, REAPER_PROBE])
755 < 1     : null
749 < 1   const evidenceRepo = wantEvidence === null ? null : await run('gh', evidenceRepoRead(wantEvidence))
750 < 1   const drift = await verbDrift({
751 < 1     help: (verb) => read(`help ${verb}`),
752 < 1     recordPath: verbsPath
753 < 1   })
754 < 1 
755 < 1   const rows = [
756 < 1     exeDevRow(whoami),
757 < 1     capacityRow(billing, pool, cfg, configKeys),
758 < 1     claudeRow(found, token, usage),
759 < 1     accountsRow(accounts, found, wantAccount),
760 < 1     githubRow(github),
761 < 1     integrationsRow(found, want),
762 < 1     evidenceRow(wantEvidence, evidenceRepo, found),
763 < 1     verbDriftRow(drift),
765 > 2     kataMode === 'on' ? kataRow(found, kataVms) : kataOffRow(),
764 < 2     kataRow(found, kataVms),
766 > 1     cloudflareRow(found),
768 > 1     reaperRow(found, keys, now, reaperProbe)
767 < 2     reaperRow(found, keys, now)
765 < 2     cloudflareRow(found)
