724 < 1 }
725 < 1 
726 < 1 /** The key half of the row: `{ status, detail }` from `ssh-key list --json`. */
727 < 1 function reaperKeyRow (keysRes, now) {
728 < 1   if (keysRes.code !== 0) return ({ status: 'missing', detail: `ssh-key list answered code ${keysRes.code}, so the ${REAPER_KEY} key is unread` })
716 < 2   if (keysRes.code !== 0) return row('reaper', 'missing', `ssh-key list answered code ${keysRes.code}, so the ${REAPER_KEY} key is unread`)
717 < 1   let keys = []
718 < 1   try {
719 < 1     const parsed = JSON.parse(keysRes.stdout)
720 < 1     keys = Array.isArray(parsed?.ssh_keys) ? parsed.ssh_keys : []
721 < 1   } catch { keys = [] }
722 < 1   const mine = keys.filter((k) => typeof k?.name === 'string' && k.name.startsWith(REAPER_KEY))
723 < 1   if (mine.length === 0) {
725 > 1     return ({ status: 'missing', detail: `no exe.dev key named ${REAPER_KEY}: the hub cannot remove a finished run's VM` })
724 < 2     return row('reaper', 'missing', `no exe.dev key named ${REAPER_KEY}: the hub cannot remove a finished run's VM`)
725 < 1   }
726 < 1   const until = (k) => (typeof k.expires_at === 'string' && k.expires_at !== '' ? Date.parse(k.expires_at) : Infinity)
727 < 1   const best = mine.reduce((a, b) => (until(b) > until(a) ? b : a))
729 > 1   if (until(best) === Infinity) return ({ status: 'ok', detail: `the key ${best.name} does not expire` })
728 < 2   if (until(best) === Infinity) return row('reaper', 'ok', `the key ${best.name} does not expire`)
729 < 1   const day = best.expires_at.slice(0, 10)
730 < 1   if (!(until(best) > now)) {
732 > 1     return ({ status: 'missing', detail: `the key ${best.name} expired ${day}: the hub answers a finished VM and removes nothing, so each waits for a janitor run` })
731 < 2     return row('reaper', 'missing', `the key ${best.name} expired ${day}: the hub answers a finished VM and removes nothing, so each waits for a janitor run`)
732 < 1   }
733 < 1   const days = Math.floor((until(best) - now) / 86400000)
735 > 1   return ({ status: 'ok', detail: `the key ${best.name} is good until ${day} (${days} days)${days < REAPER_SOON_DAYS ? ' — renew it soon' : ''}` })
734 < 2   return row('reaper', 'ok', `the key ${best.name} is good until ${day} (${days} days)${days < REAPER_SOON_DAYS ? ' — renew it soon' : ''}`)
735 < 1 }
736 < 1 
694 < 1 // ── the doctor ───────────────────────────────────────────────────────────────
695 < 1 
696 < 1 /**
697 < 1  * Run every row against `config` and resolve `{ config, rows, verdict }`.
698 < 1  * `exec(cmd, argv)` is the lobby's seam, resolving `{ code, stdout, stderr }`,
699 < 1  * so a test drives the doctor with a stub. `target` is `owner/repo` or null; anything else is refused before any
700 < 1  * read rather than interpolated into an ssh string.
701 < 1  *
702 < 1  * `configKeys` is the config file's own top-level key names — `readFleetJson`'s keys
703 < 1  * for the same path `config` was loaded from, or null when there is no file.
704 < 1  * It reaches the `capacity` row and nothing else: `result.config` stays exactly
705 < 1  * the two keys the doctor reads.
706 < 1  *
707 < 1  * `account` is that file's own `account` — `fleetConfigAccount` for the same
708 < 1  * path — and reaches the `accounts` row alone, for the same reason. `verbsPath`
709 < 1  * overrides the verb record the `verb-drift` row reads.
710 < 1  *
