771 < 1 // ── CLI ──────────────────────────────────────────────────────────────────────
772 < 1 
773 < 1 const PAD = Math.max(...['ok', 'missing'].map((s) => s.length))
774 < 1 
775 < 1 function renderRows (rows) {
776 < 1   const out = []
777 < 1   for (const r of rows) {
778 < 1     out.push(`${r.status.padEnd(PAD)} ${r.id}  ${r.detail}`)
779 < 1     if (r.status === 'missing') out.push(`    → references/first-run.md §${r.fix}`)
780 < 1   }
781 < 1   return out.join('\n')
782 < 1 }
783 < 1 
784 < 1 /** A value flag's string, or null when absent or given bare. */
785 < 1 const valueOf = (opt) => (typeof opt === 'string' ? opt : null)
786 < 1 
787 < 1 async function main (argv) {
788 < 1   const { opts } = parseArgs(argv, { flags: ['json'] })
789 < 1   const configPath = valueOf(opts.config) ?? DEFAULT_CONFIG_PATH()
790 < 1   const config = await loadFleetConfig({ path: configPath })
791 < 1   // The config file's own top-level key names — what the operator wrote, where
792 < 1   // `config` is what the doctor reads — reach the `capacity` row alone; null
793 < 1   // when there is no JSON object to carry keys.
794 < 1   const written = await readFleetJson(configPath)
795 < 1   const configKeys = written === null ? null : Object.keys(written)
796 < 1   const account = await fleetConfigAccount({ path: configPath })
797 < 1   const evidence = await readEvidenceSetting({ path: configPath })
798 < 1   let result
799 < 1   try {
800 < 1     result = await doctor({ config, exec: defaultExec, target: valueOf(opts.target), configKeys, account, evidence })
801 < 1   } catch (error) {
802 < 1     throw new Refusal(error?.message ?? String(error))
803 < 1   }
804 < 1   process.stdout.write(
805 < 1     opts.json === true ? `${JSON.stringify(result)}\n` : `${renderRows(result.rows)}\n`
806 < 1   )
807 < 1   process.exitCode = result.verdict === 'ready' ? 0 : 1
808 < 1 }
809 < 1 
810 < 1 const invokedPath = process.argv[1] ? path.resolve(process.argv[1]) : ''
811 < 1 if (invokedPath === fileURLToPath(import.meta.url)) {
812 < 1   await runCli(main, process.argv.slice(2))
813 < 1 }
814 < 1 