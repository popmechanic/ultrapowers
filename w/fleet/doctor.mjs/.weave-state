583 < 1     if (off !== null) return off
584 < 1   }
585 < 1   return row('integrations', 'ok', `${names.filter((n) => found.has(n)).join(', ')} attached to ${FLEET_POLICY}`)
586 < 1 }
587 < 1 
588 < 1 // ── evidence ─────────────────────────────────────────────────────────────────
589 < 1 
590 < 1 /** The read that asks whether the evidence repository exists, as the argv of
