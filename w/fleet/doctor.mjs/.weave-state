657 < 2   }
658 < 2   const off = attachRowFor(KATA_INTEGRATION, { id: 'kata', found })
659 < 2   if (off !== null) return off
660 < 2   const vm = kataVmRow(vmsRes)
661 < 2   if (vm === null) {
662 < 2     return row('kata', 'missing', `no ${KATA_VM} VM — ${KATA_FIX}`)
663 < 2   }
664 < 2   const status = typeof vm.status === 'string' && vm.status !== '' ? vm.status : 'unknown'
665 < 2   return row(
666 < 2     'kata',
667 < 2     'ok',
668 < 2     `${KATA_INTEGRATION} carries the bearer, attached to ${FLEET_POLICY}, and ${KATA_VM} is ${status}`
669 < 2   )
670 < 2 }
671 < 2 
673 > 2 /** `launch.kata.mode` of `fleet/policy.json`, read as the launcher reads it: `off` unless the cell says `on`. */
674 < 2 const kataModeOf = () => policyCell(['launch', 'kata', 'mode'], ['off', 'on'])
675 < 2 
676 < 2 /** While no launch asks the hub, the hub is no prerequisite: the row is green and says why. */
677 < 2 const kataOffRow = () => row(
678 < 2   'kata',
679 < 2   'ok',
680 < 2   'not asked: launch.kata.mode is off in fleet/policy.json, so no launch reaches the kata hub (a run is read with fleet/run-read.mjs)'
681 < 2 )
682 < 1 
672 < 1 // ── cloudflare ───────────────────────────────────────────────────────────────
673 < 1 
674 < 1 /** The deploy's credential: an http-proxy integration that forwards a
675 < 1  *  Cloudflare API token, named the same as every other fleet integration. */
676 < 1 const CLOUDFLARE_INTEGRATION = 'cloudflare'
677 < 1 
678 < 1 /**
679 < 1  * The ninth row: cloudflare carries the deploy's credential at the edge, and
