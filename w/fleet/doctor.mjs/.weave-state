712 < 2 function reaperRow (found, keysRes, now) {
713 < 1   if (found === null || found === undefined || !found.has(REAPER_INTEGRATION)) {
714 < 1     return row('reaper', 'ok', `no ${REAPER_INTEGRATION} integration — a finished run's VM waits for the janitor`)
715 < 1   }
717 > 1   const asked = probe !== null && probe.code === 0 && String(probe.stdout ?? '').trim() !== ''
718 < 1   if (asked && /invalid token/i.test(probe.stdout)) {
719 < 1     return row('reaper', 'missing', `the hub's remover answers \`invalid token\`: the key ${REAPER_INTEGRATION} holds is dead, so a finished VM is answered and not removed — bash fleet/reaper-key.sh renews it`)
720 < 1   }
721 < 1   const tested = asked ? '; the remover answered from the hub' : '; the remover was not asked (the hub was not reached)'
722 < 1   const keyRow = reaperKeyRow(keysRes, now)
