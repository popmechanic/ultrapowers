532 < 1   for (const line of body) {
533 < 1     if (!/^\s+\S/.test(line)) continue
534 < 1     names.push(line.trim())
535 < 1   }
536 < 1   return names
537 < 1 }
538 < 1 
539 < 1 function githubRow (res) {
540 < 1   const accounts = res.code === 0 ? githubAccounts(res.stdout) : []
541 < 1   if (accounts.length === 0) {
542 < 1     return row(
543 < 1       'github',
544 < 1       'missing',
545 < 1       `integrations setup github --list answered code ${res.code} with no account — ssh exe.dev integrations setup github walks the browser step`
546 < 1     )
547 < 1   }
548 < 1   return row('github', 'ok', `GitHub accounts ${accounts.join(', ')}`)
549 < 1 }
550 < 1 
551 < 1 // ── integrations ─────────────────────────────────────────────────────────────
552 < 1 
