0 < 1 /**
1 < 1  * The sandbox-toolchain check: what a fresh sandbox can run, by name, and the
2 < 1  * pure walk that names every `Run:` probe or `Check:` word it lacks. Pure — no
3 < 1  * imports. `fleet/launch.mjs` calls `toolchainViolations` before any VM exists.
4 < 1  */
5 < 1 
6 < 1 /**
7 < 1  * The shell's own words — keywords and builtins — that stand at command
8 < 1  * position without naming a program the sandbox must have. `probeWordsOf`
9 < 1  * skips them; a `Run:` line's `test`, `echo` and `for` are bash's, not the
10 < 1  * box's.
11 < 1  */
12 < 1 const SHELL_WORDS = Object.freeze([
13 < 1   'for', 'in', 'do', 'done', 'if', 'then', 'else', 'elif', 'fi', 'while', 'until',
14 < 1   'case', 'esac', 'test', '[', '[[', 'export', 'set', 'cd', 'exit', 'return', 'read',
15 < 1   'shift', 'local', 'eval', 'exec', 'source', '.', ':', 'command', 'type', 'wait',
16 < 1   'trap', 'unset', 'let', 'declare', 'true', 'false', 'echo', 'printf', 'break', 'continue',
17 < 1   'kill'
18 < 1 ])
19 < 1 
20 < 1 /**
21 < 1  * What a fresh sandbox can run, by name (#645). Two groups: what the exeuntu
22 < 1  * image ships — `claude`, `gh`, `git`, `jq`, `python3`, `curl`, bash and the
23 < 1  * coreutils — and the delta `fleet/setup-script.mjs` installs, exactly node
24 < 1  * (with npm and npx), bun (with bunx), celld and pytest. A `Run:` probe or a
25 < 1  * `Check:` line runs on that box under `timeout <s> bash -lc <line>`, so a
26 < 1  * command word missing here exits 127 in its first second, after the plan was
27 < 1  * pushed and a VM created; `toolchainViolations` refuses it on the laptop
28 < 1  * instead, by name — never by language (the operator's shape, 2026-09-05).
29 < 1  * A word this list lacks is a refusal until someone adds it here beside the
30 < 1  * setup-script rung that installs it.
31 < 1  */
32 < 1 export const SANDBOX_TOOLCHAIN = Object.freeze([
33 < 1   // the setup script's delta
34 < 1   'node', 'npm', 'npx', 'bun', 'bunx', 'celld', 'python3', 'pytest',
35 < 1   // the image
36 < 1   'claude', 'gh', 'git', 'jq', 'curl', 'bash', 'sh', 'env', 'sudo', 'install',
37 < 1   'apt-get', 'timeout', 'xargs', 'find', 'grep', 'egrep', 'fgrep', 'sed', 'awk', 'tr',
38 < 1   'cut', 'sort', 'uniq', 'head', 'tail', 'wc', 'cat', 'tee', 'diff', 'cmp', 'comm',
39 < 1   'paste', 'seq', 'expr', 'date', 'sleep', 'basename', 'dirname', 'readlink',
40 < 1   'realpath', 'mkdir', 'rmdir', 'rm', 'cp', 'mv', 'ln', 'ls', 'touch', 'chmod',
41 < 1   'chown', 'stat', 'tar', 'gzip', 'gunzip', 'unzip', 'zip', 'md5sum', 'sha256sum',
42 < 1   'base64', 'od', 'xxd', 'hexdump', 'tac', 'rev', 'nl', 'fold', 'column', 'yes',
43 < 1   'which', 'pwd', 'whoami', 'id', 'hostname', 'uname', 'ps', 'kill', 'pkill',
44 < 1   'nohup', 'mktemp', 'truncate', 'split', 'join', 'shuf', 'tsort', 'du', 'df',
45 < 1   'nproc', 'free', 'ss', 'nc', 'ssh'
46 < 1 ])
47 < 1 
48 < 1 /**
49 < 1  * The command words of one shell line: the first word of the line and of
50 < 1  * every segment after `|`, `||`, `&&`, `;`, `$(` or `(`, and the word after
51 < 1  * each of `do`, `then`, `else`, `elif` — skipping `!`, a `NAME=value`
52 < 1  * assignment and every `SHELL_WORDS` entry, and dropping a word that carries
53 < 1  * a `/` (a path in the target, not a program by name) or opens with `$`, a
54 < 1  * quote, `-` or a digit (an expansion, a string, a flag, a redirection).
55 < 1  * Quote-aware: an operator inside a single- or double-quoted span splits
56 < 1  * nothing (`grep -E "a|b"` names one program), and a `$(` inside double
57 < 1  * quotes still opens a segment, because bash runs what is inside it.
58 < 1  * Duplicates are kept; the caller deduplicates per task.
59 < 1  */
60 < 1 export function probeWordsOf (line) {
61 < 1   const text = String(line ?? '')
62 < 1   // Segments: split on the operators outside quotes, and on `$(` outside
63 < 1   // single quotes; each segment is a list of whitespace-split tokens with
64 < 1   // quoted spans kept whole.
65 < 1   const segments = [[]]
66 < 1   let token = ''
67 < 1   let quote = null
68 < 1   // The quote state to restore when a `$(` … `)` substitution closes.
69 < 1   const substitutions = []
70 < 1   const endToken = () => { if (token !== '') { segments[segments.length - 1].push(token); token = '' } }
71 < 1   const newSegment = () => { endToken(); segments.push([]) }
72 < 1   for (let i = 0; i < text.length; i += 1) {
73 < 1     const ch = text[i]
74 < 1     const next = text[i + 1]
75 < 1     if (quote === "'") {
76 < 1       token += ch
77 < 1       if (ch === "'") quote = null
78 < 1       continue
79 < 1     }
80 < 1     if (quote === '"') {
81 < 1       if (ch === '\\' && next !== undefined) { token += ch + next; i += 1; continue }
82 < 1       if (ch === '$' && next === '(') { substitutions.push('"'); quote = null; newSegment(); i += 1; continue }
83 < 1       token += ch
84 < 1       if (ch === '"') quote = null
85 < 1       continue
86 < 1     }
87 < 1     if (ch === "'" || ch === '"') { quote = ch; token += ch; continue }
88 < 1     if (ch === '\\' && next !== undefined) { token += ch + next; i += 1; continue }
89 < 1     if ((ch === '|' && next === '|') || (ch === '&' && next === '&')) { newSegment(); i += 1; continue }
90 < 1     if (ch === '|' || ch === ';' || ch === '(') { newSegment(); continue }
91 < 1     if (ch === '$' && next === '(') { substitutions.push(null); newSegment(); i += 1; continue }
92 < 1     if (ch === ')') { endToken(); quote = substitutions.length ? substitutions.pop() : null; segments.push([]); continue }
93 < 1     if (/\s/.test(ch)) { endToken(); continue }
94 < 1     token += ch
95 < 1   }
96 < 1   endToken()
97 < 1   const words = []
98 < 1   for (const tokens of segments) {
99 < 1     let atCommand = true
100 < 1     for (const raw of tokens) {
101 < 1       const t = raw.replace(/[}\]]+$/, '')
102 < 1       if (!atCommand) {
103 < 1         if (['do', 'then', 'else', 'elif'].includes(t)) atCommand = true
104 < 1         continue
105 < 1       }
106 < 1       if (t === '' || t === '!' || t === '{' || /^[A-Za-z_][A-Za-z0-9_]*=/.test(t)) continue
107 < 1       if (SHELL_WORDS.includes(t)) {
108 < 1         atCommand = ['do', 'then', 'else', 'elif', 'command', 'exec', 'eval'].includes(t)
109 < 1         continue
110 < 1       }
111 < 1       atCommand = false
112 < 1       if (t.includes('/') || /^[$"'\-0-9<>]/.test(t)) continue
113 < 1       words.push(t)
114 < 1     }
115 < 1   }
116 < 1   return words
117 < 1 }
118 < 1 
119 < 1 /**
121 > 1  * Every command word of every task's `proofRuns` in `compiled.payload.tasks`, and
120 < 2  * Every command word of every task's `proofRuns` across `compiled.waves`, and
121 < 1  * of every `compiled.payload.checks[].cmd` (task `check`), that
122 < 1  * `SANDBOX_TOOLCHAIN` lacks — one `{ task, word, cmd }` per (task, word), in
123 < 1  * document order. Pure; empty means every probe and check can run on the box.
124 < 1  */
125 < 1 export function toolchainViolations (compiled) {
126 < 1   const out = []
127 < 1   const seen = new Set()
128 < 1   const note = (task, cmd) => {
129 < 1     for (const word of probeWordsOf(cmd)) {
130 < 1       if (SANDBOX_TOOLCHAIN.includes(word)) continue
131 < 1       const key = `${task}\u0000${word}`
132 < 1       if (seen.has(key)) continue
133 < 1       seen.add(key)
134 < 1       out.push({ task: String(task), word, cmd: String(cmd) })
135 < 1     }
136 < 1   }
138 > 1   const tasks = Array.isArray(compiled?.payload?.tasks) ? compiled.payload.tasks : []
139 < 1   for (const task of tasks) {
140 < 1     const runs = Array.isArray(task?.proofRuns) ? task.proofRuns : []
141 < 1     for (const cmd of runs) note(task?.id ?? '?', cmd)
137 < 2   const waves = Array.isArray(compiled?.waves) ? compiled.waves : []
138 < 2   for (const wave of waves) {
139 < 2     if (!Array.isArray(wave)) continue
140 < 2     for (const task of wave) {
141 < 2       const runs = Array.isArray(task?.proofRuns) ? task.proofRuns : []
142 < 2       for (const cmd of runs) note(task?.id ?? '?', cmd)
143 < 2     }
144 < 1   }
145 < 1   const checks = Array.isArray(compiled?.payload?.checks) ? compiled.payload.checks : []
146 < 1   for (const check of checks) if (check && typeof check.cmd === 'string') note('check', check.cmd)
147 < 1   return out
148 < 1 }
149 < 1 