587 < 2   mirror.push(row(3, 'issue.commented', 'rvxp', 'factory', '2026-09-29T22:42:30.000Z', { body: 'done by A' }))
588 < 2   assert.equal(mod.projectBoard(mirror, { runs: [275] }).tasks[0].state, 'done', '(mirror b) a done comment sets state done')
589 < 2   const released = [mirror[0], mirror[1],
590 < 2     row(3, 'issue.commented', 'rvxp', 'factory', '2026-09-29T22:42:30.000Z', { body: 'A released: gave up' })]
591 < 2   assert.equal(mod.projectBoard(released, { runs: [275] }).tasks[0].state, 'released', '(mirror c) `<agent> released: <why>` sets state released')
592 < 2   released[2] = row(3, 'issue.commented', 'rvxp', 'factory', '2026-09-29T22:42:30.000Z', { body: 'released: gave up' })
593 < 2   assert.equal(mod.projectBoard(released, { runs: [275] }).tasks[0].state, 'released', '(mirror d) the older bare `released: <why>` still sets state released')
594 < 2 }
