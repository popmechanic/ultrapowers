597 > 2 // ── one shared connection, and a follow that reads only what is new (2026-11-13) ──
598 < 2 {
599 < 2   // (h) every request of a read carries the three ControlMaster options before the host, the
600 < 2   // socket beside the env file; the remote stays the last element
601 < 2   const kataEnvPath = await writeKataEnv('KATA_URL=https://hub.example\nKATA_TOKEN=deadbeefcafe\n')
602 < 2   const { calls, exec } = makeMainExec({ projects: HUB_PROJECTS, issues: HUB_ISSUES, feed: HUB_FEED })
603 < 2   await main(['--run', '207', '--target', 'popmechanic/ultrapowers', '--since', '3030'], { exec, kataEnvPath, write: () => {} })
604 < 2   const want = ['-o', 'ControlMaster=auto', '-o', 'ControlPath=' + path.join(path.dirname(kataEnvPath), 'hub-%C'), '-o', 'ControlPersist=60', 'hub.example']
605 < 2   assert.equal(calls.length, 2, '(h) a read from a cursor is two requests, the projects and one page; got ' + calls.length)
606 < 2   for (const call of calls) {
607 < 2     assert.deepEqual(call.argv.slice(4, -1), want, '(h) the shared-connection options sit before the host; got ' + JSON.stringify(call.argv.slice(0, -1)))
608 < 2   }
609 < 2 
610 < 2   // (i) a request that got no status over the shared connection is made once more on its own
611 < 2   const { sshTransport } = await import('../kata-client.mjs')
612 < 2   const seen = []
613 < 2   const flaky = async (cmd, argv) => {
614 < 2     seen.push(argv)
615 < 2     return argv.some((a) => String(a).startsWith('ControlPath=')) ? { code: 255, stdout: '', stderr: 'mux_client_request_session: read from master failed' } : { code: 0, stdout: '{"ok":true}\n200', stderr: '' }
616 < 2   }
617 < 2   const got = await sshTransport({ sshHost: 'hub.example', exec: flaky, control: '/x/hub-%C' }).request({ method: 'GET', path: '/api/v1/projects' })
618 < 2   assert.ok(got.status === 200 && got.json && got.json.ok === true, '(i) the retry\'s answer is the request\'s; got ' + JSON.stringify(got))
619 < 2   assert.ok(seen.length === 2 && !seen[1].some((a) => String(a).startsWith('Control')), '(i) the second hop carries no Control option; got ' + JSON.stringify(seen.map((a) => a.slice(0, -1))))
620 < 2   const plain = []
621 < 2   await sshTransport({ sshHost: 'hub.example', exec: async (cmd, argv) => { plain.push(argv); return { code: 0, stdout: '{}\n200', stderr: '' } } }).request({ method: 'GET', path: '/x' })
622 < 2   assert.deepEqual(plain[0].slice(0, -1), ['-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15', 'hub.example'], '(i) with no control path the argv is what it was; got ' + JSON.stringify(plain[0].slice(0, -1)))
623 < 2 
624 < 2   // (j) followReader: the first read starts from the run's creation; the next is one request,
625 < 2   // from the last row held, and its projection holds the old rows and the new one
626 < 2   const { hubFromEnv } = await import('../lobby.mjs')
627 < 2   const feed = [...HUB_FEED]
628 < 2   const grow = makeMainExec({ projects: HUB_PROJECTS, issues: HUB_ISSUES, feed })
629 < 2   const page = (after) => { const rows = feed.filter((e) => e.event_id > after).slice(0, 100); return { events: rows, next_after_id: rows.length ? rows[rows.length - 1].event_id : after, reset_required: false } }
630 < 2   const requests = []
