412 < 2 assertBoardRefusal(() => parseBoardArgs(['--target', 'o/r']), 'a missing `--run`')
413 < 2 assertBoardRefusal(() => parseBoardArgs(['--run', '207']), 'a missing `--target`')
414 < 2 assertBoardRefusal(() => parseBoardArgs(['--run', 'abc', '--target', 'o/r']),
415 < 2   'a `--run` that is not a positive integer')
416 < 2 assertBoardRefusal(() => parseBoardArgs(['--run', '207', '--target', 'o/r', '--since', '-1']),
417 < 2   'a `--since` that is not a non-negative integer')
418 < 2 
419 < 2 assert.equal(parseBoardArgs(['--run', '207', '--target', 'o/r']).since, 0,
420 < 2   '(g) [M7] `since` defaults to `0` with none given')
