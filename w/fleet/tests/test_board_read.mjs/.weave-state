580 < 2 {
581 < 2   // A Flock task's state follows the mirror's comments: filed -> claimed -> done (run-275, 2026-09-29).
582 < 2   const mirror = [
583 < 2     row(1, 'issue.created', 'rvxp', 'launch', '2026-09-29T22:41:03.000Z', { title: 'task 1: t', metadata: { run: 275 } }),
584 < 2     row(2, 'issue.commented', 'rvxp', 'factory', '2026-09-29T22:42:22.000Z', { body: 'claimed by A' }),
