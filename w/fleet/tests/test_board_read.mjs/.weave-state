475 < 2         '(g) [M4] no argv element of any call carries the env file\'s token value; got ' + JSON.stringify(call.argv))
476 < 2     }
477 < 2   }
478 < 2   assert.ok(calls[0].argv[calls[0].argv.length - 1].includes('/api/v1/projects?limit=1000'),
479 < 2     '(g) [M7] the first remote lists the projects; got ' + JSON.stringify(calls[0].argv[calls[0].argv.length - 1]))
480 < 2 
481 < 2   assert.ok(TASK_LINE.test(written), '(g) [M4] the written text matches leg (e)\'s task-line pattern; got:\n' + written)
482 < 2   assert.ok(TIMELINE_LINE.test(written),
483 < 2     '(g) [M4] the written text contains a `run-207 task 2` timeline line, matching leg (e)\'s ' +
484 < 2     'timeline-line pattern; got:\n' + written)
485 < 2   assert.ok(written.endsWith('cursor 3031\n'),
486 < 2     '(g) [M4] the written text ends `cursor 3031\\n`; got ' + JSON.stringify(written.slice(-20)))
487 < 2 }
