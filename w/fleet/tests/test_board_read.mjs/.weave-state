404 < 2 const assertBoardRefusal = (thunk, why) => {
405 < 2   let threw = null
406 < 2   try { thunk() } catch (error) { threw = error }
407 < 2   assert.ok(threw, '(g) [M7] ' + why + ': throws')
408 < 2   assert.ok(String(threw && threw.message).startsWith('board-read:'),
409 < 2     '(g) [M7] ' + why + ': message begins `board-read:`; got ' + JSON.stringify(threw && threw.message))
410 < 2 }
