422 < 2 /** `main`'s `exec`: a recording fake in the ssh-curl shape `sshTransport`
423 < 2  *  expects, chosen by which path the remote (the last argv element) names —
424 < 2  *  the projects listing, the issues listing, or a hub-shaped page of `feed`
425 < 2  *  for the `after_id` parsed out of the remote (the same `hubPage` leg (f)
426 < 2  *  uses). */
427 < 2 const makeMainExec = ({ projects, issues, feed }) => {
428 < 2   const calls = []
429 < 2   const page = hubPage(feed)
430 < 2   const exec = async (cmd, argv) => {
431 < 2     calls.push({ cmd, argv })
432 < 2     const remote = String(argv[argv.length - 1])
433 < 2     let answer
434 < 2     if (remote.includes('/api/v1/projects?limit=1000')) {
435 < 2       answer = { projects }
436 < 2     } else if (remote.includes('/api/v1/projects/31/issues?limit=1000')) {
437 < 2       answer = { issues }
438 < 2     } else {
439 < 2       const match = remote.match(/\/api\/v1\/projects\/31\/events\?after_id=(\d+)/)
440 < 2       answer = page(match ? Number(match[1]) : 0)
441 < 2     }
442 < 2     return { code: 0, stdout: JSON.stringify(answer) + '\n200', stderr: '' }
443 < 2   }
444 < 2   return { calls, exec }
445 < 2 }
446 < 2 
447 < 2 const writeKataEnv = async (lines) => {
