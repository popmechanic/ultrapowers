546 < 2 // ── follow: new rows once, one warning per stuck claim and per quiet spell, ends on close ──
547 < 2 {
548 < 2   const T0 = Date.parse('2026-09-28T23:00:00Z')
549 < 2   const iso = (ms) => new Date(T0 + ms).toISOString()
550 < 2   let clock = 0
551 < 2   const claimed = { eventId: 1, at: iso(0), run: 5, issue: 11, name: 'task 1', what: 'claimed by A' }
552 < 2   const done = { eventId: 2, at: iso(40000), run: 5, issue: 11, name: 'task 1', what: 'done by A' }
553 < 2   const closed = { eventId: 3, at: iso(40000), run: 5, issue: 10, name: 'run-5', what: 'closed done' }
554 < 2   const read = async () => clock < 40000
555 < 2     ? { tasks: [{ run: 5, issue: 10, name: 'run-5', closed: null, last: null, lastAt: null },
556 < 2                 { run: 5, issue: 11, name: 'task 1', closed: null, last: 'claimed by A', lastAt: iso(0) }],
557 < 2         timeline: [claimed] }
558 < 2     : { tasks: [{ run: 5, issue: 10, name: 'run-5', closed: 'done', last: 'closed done', lastAt: iso(40000) },
559 < 2                 { run: 5, issue: 11, name: 'task 1', closed: null, last: 'done by A', lastAt: iso(40000) }],
560 < 2         timeline: [claimed, done, closed] }
561 < 2   let out = ''
562 < 2   const rc = await mod.follow({ read, write: (x) => { out += x }, runs: [5], everyMs: 10000, quietMs: 30000,
563 < 2     now: () => T0 + clock, sleep: async (ms) => { clock += ms } })
564 < 2   const lines = out.trim().split('\n')
565 < 2   assert.equal(rc, 0, '(follow a) a run whose own issue closes ends with 0; got ' + rc)
566 < 2   assert.equal(lines.filter((l) => l.endsWith('claimed by A')).length, 1, '(follow b) the claim row prints once; got\n' + out)
567 < 2   assert.equal(lines.filter((l) => l.startsWith('! run-5 task 1 claimed by A') && l.endsWith('no done since')).length, 1, '(follow c) one warning for the stuck claim; got\n' + out)
568 < 2   assert.equal(lines.filter((l) => l.startsWith('! no new row for')).length, 1, '(follow d) one warning for the quiet spell; got\n' + out)
569 < 2   assert.ok(lines.some((l) => l.endsWith('done by A')) && lines.at(-1) === '== closed', '(follow e) the done row prints and the last line is == closed; got\n' + out)
570 < 2 
571 < 2   clock = 0
572 < 2   let out2 = ''
573 < 2   const never = async () => ({ tasks: [{ run: 5, issue: 10, name: 'run-5', closed: null, last: null, lastAt: null }], timeline: [] })
574 < 2   const rc2 = await mod.follow({ read: never, write: (x) => { out2 += x }, runs: [5], everyMs: 10000, quietMs: 60000, maxMs: 20000,
575 < 2     now: () => T0 + clock, sleep: async (ms) => { clock += ms } })
576 < 2   assert.ok(rc2 === 3 && out2.trim().endsWith('== gave up'), '(follow f) a run that never closes gives up at maxMs with 3; got ' + rc2 + '\n' + out2)
577 < 2   assert.equal(mod.parseBoardArgs(['--run', '5', '--target', 'o/r', '--follow', '--quiet', '7']).quietMinutes, 7, '(follow g) --quiet sets the window')
578 < 2 }
