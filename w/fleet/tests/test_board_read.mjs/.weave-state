294 < 2 // ══════════════════════════════════════════════════════════════════════════
295 < 2 // (f) `readBoard` over a hub-shaped feed — rewritten by the task "`readBoard`
296 < 2 // starts at the asked run's creation event and pages to the feed's end"
297 < 2 // (#1227, map #876, on #1174), replacing the old 1000-row-page pin. The
298 < 2 // first block below proves that task's M1–M3; the second block is the
299 < 2 // original `since: 500` leg, unchanged, and now proves that task's M5.
300 < 2 // ══════════════════════════════════════════════════════════════════════════
301 < 2 
302 < 2 /** A recording `client.events`: `answer(projectId, afterId)` decides each page. */
303 < 2 const recordingClient = (answer) => {
304 < 2   const calls = []
305 < 2   return {
306 < 2     calls,
307 < 2     client: {
308 < 2       events: async (projectId, afterId) => {
309 < 2         calls.push([projectId, afterId])
310 < 2         return answer(projectId, afterId)
311 < 2       }
312 < 2     }
313 < 2   }
314 < 2 }
315 < 2 
316 < 2 /** The hub's own paging rule, as Context and `fleet/CONTRACT.md`'s
317 < 2  *  `events-page` fact describe it: at most 100 rows a page whatever `limit`
318 < 2  *  says, `next_after_id` the last answered row's `event_id`, and for an
319 < 2  *  empty page `after` itself. */
320 < 2 const hubPage = (feed) => (after) => {
321 < 2   const rows = feed.filter((e) => e.event_id > after).slice(0, 100)
322 < 2   return { events: rows, next_after_id: rows.length ? rows[rows.length - 1].event_id : after, reset_required: false }
323 < 2 }
324 < 2 
325 < 2 /** 3,000 rows of another run (205): an `issue.created` at `event_id` 1, then
326 < 2  *  2,999 `issue.commented` rows on it, `created_at` rising through
327 < 2  *  `2026-09-20T…` — earlier than every row of `FIXTURE`. */
328 < 2 const fillerAt = (eventId) => new Date(Date.UTC(2026, 8, 20, 0, 0, 0) + (eventId - 1) * 1000).toISOString()
329 < 2 const FILLER_RUN_205 = [
330 < 2   row(1, 'issue.created', 'r205', 'launch', fillerAt(1),
331 < 2     { title: 'run-205: A different fold entirely', body: '', metadata: { run: 205, target: 'other/other' } }),
332 < 2   ...Array.from({ length: 2999 }, (_, i) =>
333 < 2     row(i + 2, 'issue.commented', 'r205', 'factory', fillerAt(i + 2), { body: '[note]\nfiller comment ' + (i + 2) }))
334 < 2 ]
335 < 2 /** `FIXTURE` renumbered `event_id` 3001–3031, `created_at` unchanged — the
336 < 2  *  hub-shaped feed Machine M1 describes, built once and shared with leg (g). */
337 < 2 const shiftRows = (rows, delta) => rows.map((r) => ({ ...r, event_id: r.event_id + delta }))
338 < 2 const HUB_FEED = [...FILLER_RUN_205, ...shiftRows(FIXTURE, 2901)]
339 < 2 assert.equal(HUB_FEED.length, 3031,
340 < 2   '(f) [M1] the hub-shaped feed itself has 3,031 rows — 3,000 of run 205 then the 31-row ' +
341 < 2   'fixture renumbered 3001–3031 — as Machine describes')
342 < 2 
343 < 2 /** `listIssues`'s answer: the run-205 issue, the run 207 issue `zdbs` (its
344 < 2  *  `created_at` 3 ms before its creation event's, row 3001's), and the two
345 < 2  *  task issues, neither carrying a `run`. */
346 < 2 const HUB_ISSUES = [
347 < 2   { short_id: 'r205', title: 'run-205: A different fold entirely', metadata: { run: 205 }, created_at: fillerAt(1), status: 'open', uid: 'u-r205' },
348 < 2   { short_id: 'zdbs', title: 'run-207: A fold red names its fold', metadata: { run: 207, target: 'popmechanic/ultrapowers' }, created_at: '2026-09-21T23:58:00.097Z', status: 'open', uid: 'u-zdbs' },
349 < 2   { short_id: '06tw', title: 'task 1: The judge reads one question', metadata: { task: '1', plan: 'p' }, created_at: '2026-09-21T23:58:03.997Z', status: 'open', uid: 'u-06tw' },
350 < 2   { short_id: 'vwnn', title: 'task 2: A fold round', metadata: { task: '2', plan: 'p' }, created_at: '2026-09-21T23:58:07.997Z', status: 'open', uid: 'u-vwnn' }
351 < 2 ]
352 < 2 
353 < 2 {
354 < 2   const calls = []
355 < 2   const page = hubPage(HUB_FEED)
356 < 2   const client = {
357 < 2     events: async (projectId, afterId) => {
358 < 2       calls.push([projectId, afterId])
359 < 2       return page(afterId)
360 < 2     },
361 < 2     listIssues: async () => ({ issues: HUB_ISSUES })
362 < 2   }
363 < 2   const answer = await readBoard({ client, projectId: 31, runs: [207], since: 0 })
364 < 2 
365 < 2   assert.deepEqual(answer.tasks.map((t) => t.issue), ['zdbs', '06tw', 'vwnn'],
366 < 2     '(f) [M1] over the 3,031-row hub-shaped feed, `readBoard`\'s `tasks` map to exactly ' +
367 < 2     '`[\'zdbs\', \'06tw\', \'vwnn\']` by `issue`, in that order; got ' +
368 < 2     JSON.stringify(answer.tasks.map((t) => t.issue)))
369 < 2   assert.deepEqual(answer.timeline.map((t) => t.eventId),
370 < 2     [3011, 3012, 3014, 3015, 3016, 3017, 3018, 3019, 3020, 3021, 3023, 3027, 3028, 3031],
371 < 2     '(f) [M1] and its `timeline` maps to exactly those fourteen `eventId`s, in that order — ' +
372 < 2     'nothing of run 205 before it; got ' + JSON.stringify(answer.timeline.map((t) => t.eventId)))
373 < 2 
374 < 2   assert.equal(answer.cursor, 3031,
375 < 2     '(f) [M2] that answer\'s `cursor` is exactly 3031, the last event the hub holds; got ' +
376 < 2     JSON.stringify(answer.cursor))
377 < 2 
378 < 2   assert.ok(calls.length < 31,
379 < 2     '(f) [M3] the read makes fewer than 31 calls to `client.events` (a walk from `after_id` ' +
380 < 2     '0 over this 3,031-row feed at 100 rows a page is 31 calls); recorded ' + calls.length +
381 < 2     ' calls: ' + JSON.stringify(calls))
382 < 2 }
