0 < 2 /**
1 < 2  * fleet/tests/test_board_read.mjs — the exam for `fleet/board-read.mjs`: one
2 < 2  * laptop command that names a run and prints its tasks (state, latest note)
3 < 2  * and its event timeline, read off the hub through the same ssh-curl door the
4 < 2  * janitor uses, with no token on the command line (#1174, #876).
5 < 2  *
6 < 2  * This file is the Proof's `Test:`, written whole at the path the Proof names.
7 < 2  * Every relative import is written for THIS directory: `../` is the
8 < 2  * repository's `fleet/`, `./` is `fleet/tests/`.
9 < 2  *
10 < 2  * The Machine clauses under test, restated so a reader can map every
11 < 2  * assertion back to the contract:
12 < 2  *
13 < 2  *   M1 — `projectBoard(events, { runs })` is pure. Over the 31-row fixture
14 < 2  *        with `runs: [207]`, `tasks` is exactly three rows in order (`zdbs`
15 < 2  *        `run-207`, `06tw` `task 1`, `vwnn` `task 2`); no row of `tasks` or
16 < 2  *        `timeline` carries an issue outside run 207 or 206; `runs: [206,
17 < 2  *        207]` gives five task rows.
18 < 2  *   M2 — each `tasks` row carries `run`, `issue`, `name`, `title`, `state`,
19 < 2  *        `closed`, `lastAt`, `last`, with the fixture's three rows' values
20 < 2  *        pinned.
21 < 2  *   M3 — `timeline` is 14 rows in feed order for `runs: [207]`, each row's
22 < 2  *        shape and four pinned rows' contents.
23 < 2  *   M4 — `cursor` is the last input row's `event_id` regardless of `runs`,
24 < 2  *        and `null` over an empty input, alongside empty `tasks`/`timeline`.
25 < 2  *   M5 — `renderBoard(projection)` renders task lines, timeline lines, the
26 < 2  *        `== now` / `== events` banners in order, and a final `cursor <n>`
27 < 2  *        line.
28 < 2  *   M6 — `readBoard({ client, projectId, runs, since })` pages
29 < 2  *        `client.events` until a short page, and answers the projection over
30 < 2  *        every row read, falling back to `since` when the projection's
31 < 2  *        `cursor` is `null`.
32 < 2  *   M7 — `parseBoardArgs(argv)` and `main(argv, { exec, kataEnvPath, write })`:
33 < 2  *        argument parsing and its refusals, and the CLI's two-request ssh
34 < 2  *        round trip with no token in any argv.
35 < 2  *
36 < 2  * The legs, in the order they run here:
37 < 2  *
38 < 2  *   (a) [M1] the fixture's three-row / five-row `tasks` shape.
39 < 2  *   (b) [M2] the `tasks` row fields, pinned.
40 < 2  *   (c) [M3] the `timeline` rows, pinned.
41 < 2  *   (d) [M4] `cursor`, and the empty-input shape.
42 < 2  *   (e) [M5] `renderBoard`'s lines.
43 < 2  *   (f) [M6] `readBoard`'s paging and fallback.
44 < 2  *   (g) [M7] `parseBoardArgs` and `main`.
45 < 2  *
46 < 2  * Nothing here spawns a real process: `main`'s `exec` is a recording fake
47 < 2  * answering the ssh-curl shape (`{ code, stdout: json + '\n' + status,
48 < 2  * stderr }`) that `fleet/kata-client.mjs`'s `sshTransport` expects, chosen by
49 < 2  * which path the remote argv element names — never a shell, never a socket.
50 < 2  * The env file `main` reads lives under a `mkdtemp` of `os.tmpdir()`, and
51 < 2  * `write` collects into a plain string. Assumed of the code under test: it
52 < 2  * builds its client exactly as `fleet/janitor.mjs`'s `openHub` does — one ssh
53 < 2  * call per hub request, the literal `$KATA_AUTH_TOKEN` in the remote and
54 < 2  * never a token value in any argv element — so this exam checks that shape
55 < 2  * rather than importing `sshTransport`/`makeKataClient` itself; the task names
56 < 2  * `fleet/board-read.mjs` as the only module this exam may import.
57 < 2  */
58 < 2 import assert from 'node:assert/strict'
59 < 2 import fs from 'node:fs/promises'
60 < 2 import os from 'node:os'
61 < 2 import path from 'node:path'
62 < 2 
63 < 2 /** The deliverable, imported dynamically: a tree without it reports the
64 < 2  *  ABSENT MODULE as an assertion of leg (a) rather than dying at load with
65 < 2  *  no leg named at all. */
66 < 2 let mod = null
67 < 2 let importError = null
68 < 2 try {
69 < 2   mod = await import('../board-read.mjs')
70 < 2 } catch (error) {
71 < 2   importError = error
72 < 2 }
73 < 2 assert.ok(importError === null,
74 < 2   '(a) [M1] `fleet/board-read.mjs` is importable — the module this task creates. Got: ' +
75 < 2   String(importError && (importError.message || importError)))
76 < 2 const { projectBoard, renderBoard, readBoard, parseBoardArgs, main } = mod
77 < 2 for (const [name, fn] of Object.entries({ projectBoard, renderBoard, readBoard, parseBoardArgs, main })) {
78 < 2   assert.equal(typeof fn, 'function', '(a) [M1] `' + name + '` is exported as a function')
79 < 2 }
80 < 2 
