714 < 1 
715 < 1 {
716 < 1   const runN = '510'
717 < 1   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'fleet-boot-j-'))
718 < 1   const home = path.join(root, 'home')
719 < 1   const bin = path.join(root, 'bin')
720 < 1   fs.mkdirSync(home, { recursive: true })
721 < 1   fs.mkdirSync(bin, { recursive: true })
722 < 1   writeGitConfig(home)
723 < 1 
724 < 1   const { originDir, evidenceDir, base, plan } = buildOrigin(root, runN)
725 < 1   wireEvidence(home, evidenceDir)
726 < 1   git(root, ['clone', originDir, path.join(home, 'target')])
727 < 1 
728 < 1   // Move the origin's main by one commit touching a file the plan never names.
729 < 1   const side = path.join(root, 'side')
730 < 1   git(root, ['clone', originDir, side])
731 < 1   git(side, ['checkout', 'main'])
732 < 1   fs.writeFileSync(path.join(side, 'other.txt'), 'a commit that landed on main after the clone\n')
733 < 1   git(side, ['add', 'other.txt'])
734 < 1   git(side, ['-c', 'user.name=Side', '-c', 'user.email=side@example.com', 'commit', '-m', 'move main'])
735 < 1   git(side, ['push', 'origin', 'main'])
736 < 1 
737 < 1   buildEngineDir(home, ENGINE_SHA)
738 < 1   writeStubs(bin, { claudeAuth: 'oauth' })
739 < 1 
740 < 1   const env = {
741 < 1     ...baseEnv(PROXY_URL),
742 < 1     FLEET_ASSIGNMENT: assignment({ runN, plan, target: 'o/r', base, engine: ENGINE_SHA }),
743 < 1     MERGE_SHA
744 < 1   }
745 < 1 
746 < 1   const res = await runBootAsync({ bin, home, env })
747 < 1 
748 < 1   assert.equal(
749 < 1     res.code, 0,
750 < 1     `(j) the moved-main run exits 0 — got ${res.code}, stdout: ${res.stdout}, stderr tail: ${(res.stderr || '').slice(-4000)}`
751 < 1   )
752 < 1 
753 < 1   const rows = atTag(evidenceDir, runN, 'events.jsonl').split('\n').filter(Boolean).map((l) => JSON.parse(l))
754 < 1   const refoldAt = rows.findIndex((r) => r.kind === 'refold' && r.ok === true)
755 < 1   const mergeAt = rows.findIndex((r) => r.kind === 'merge' && r.code === 200)
756 < 1   assert.ok(refoldAt >= 0, `(j) events.jsonl carries a refold row with ok true — got kinds ${JSON.stringify(rows.map((r) => r.kind))}`)
757 < 1   assert.ok(mergeAt >= 0, `(j) events.jsonl carries a merge row with code 200 — got ${JSON.stringify(rows.filter((r) => r.kind === 'merge'))}`)
758 < 1   assert.ok(refoldAt < mergeAt, `(j) the refold row comes before the merge row — got kinds ${JSON.stringify(rows.map((r) => r.kind))}`)
759 < 1 
760 < 1   assert.equal(JSON.parse(atTag(evidenceDir, runN, 'status.json')).state, 'done', '(j) status.json at the tag records state "done"')
761 < 1   console.log('ok (j) the self-merge catches up to a moved main')
762 < 1 }
763 < 1 
764 < 1 // ── (k) the request to open the pull request gets no answer (flock-baseline run-22) ──
765 < 1 // `created`: the pull request opened all the same; the publish finds it by the run's branch and
766 < 1 // merges it. `lost`: nothing opened; the publish asks once more.
767 < 1 
768 < 1 for (const [n, how] of [['511', 'created'], ['512', 'lost']]) {
769 < 1   const runN = n
770 < 1   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'fleet-boot-k-'))
771 < 1   const home = path.join(root, 'home')
772 < 1   const bin = path.join(root, 'bin')
773 < 1   fs.mkdirSync(home, { recursive: true })
774 < 1   fs.mkdirSync(bin, { recursive: true })
775 < 1   writeGitConfig(home)
776 < 1 
777 < 1   const { originDir, evidenceDir, base, plan } = buildOrigin(root, runN)
778 < 1   wireEvidence(home, evidenceDir)
779 < 1   git(root, ['clone', originDir, path.join(home, 'target')])
780 < 1   buildEngineDir(home, ENGINE_SHA)
781 < 1   writeStubs(bin, { claudeAuth: 'oauth' })
782 < 1   fs.writeFileSync(path.join(home, 'pr-no-answer'), how)
783 < 1 
784 < 1   const env = {
785 < 1     ...baseEnv(PROXY_URL),
786 < 1     FLEET_ASSIGNMENT: assignment({ runN, plan, target: 'o/r', base, engine: ENGINE_SHA }),
787 < 1     MERGE_SHA
788 < 1   }
789 < 1   const res = await runBootAsync({ bin, home, env })
790 < 1   assert.equal(res.code, 0, `(k ${how}) the run exits 0 — got ${res.code}, stderr tail: ${(res.stderr || '').slice(-3000)}`)
791 < 1 
792 < 1   const bootLog = atTag(evidenceDir, runN, 'fleet-boot.log')
793 < 1   assert.ok(bootLog.includes('POST /repos/o/r/pulls answered 000'), `(k ${how}) the boot log records the request that got no answer — got ${bootLog.slice(-1500)}`)
794 < 1   const lookups = fs.readFileSync(path.join(home, 'pr-lookups'), 'utf8').trim().split('\n')
795 < 1   assert.ok(lookups.every((u) => u.endsWith(`/pulls?head=o:ultra%2Fintegration-run-${runN}&state=open`)), `(k ${how}) the lookup names the run's branch — got ${JSON.stringify(lookups)}`)
796 < 1   assert.equal(lookups.length, 1, `(k ${how}) one lookup — got ${JSON.stringify(lookups)}`)
797 < 1   assert.equal(bootLog.includes('the pull request is open all the same: https://github.com/o/r/pull/7'), how === 'created', `(k ${how}) the boot log ${how === 'created' ? 'names' : 'does not name'} a pull request found open`)
798 < 1   assert.ok(fs.existsSync(path.join(home, 'pr-post.json')), `(k ${how}) a pull request was opened`)
799 < 1 
800 < 1   const rows = atTag(evidenceDir, runN, 'events.jsonl').split('\n').filter((l) => l.trim() !== '').map((l) => JSON.parse(l))
801 < 1   const prRows = rows.filter((r) => r.kind === 'publish:pr')
802 < 1   assert.ok(prRows.length === 1 && prRows[0].number === 7 && prRows[0].url === 'https://github.com/o/r/pull/7', `(k ${how}) one publish:pr row for pull request 7 — got ${JSON.stringify(prRows)}`)
803 < 1   assert.ok(rows.some((r) => r.kind === 'merge' && r.code === 200), `(k ${how}) the pull request was merged — got ${JSON.stringify(rows.filter((r) => r.kind === 'merge'))}`)
804 < 1   assert.equal(JSON.parse(atTag(evidenceDir, runN, 'status.json')).state, 'done', `(k ${how}) status.json at the tag records state "done"`)
805 < 1   console.log(`ok (k) no answer to the pull request, ${how}`)
806 < 1 }
807 < 1 
808 < 1 proxyServer.close()
809 < 1 
810 < 1 console.log('ALL TESTS PASSED')
811 < 1 