656 < 1 // ── (i) #1445 a boot killed while its engine runs: `boot.sh died` writes the failed record ──
657 < 1 
658 < 1 {
659 < 1   const runN = '509'
660 < 1   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'fleet-boot-i-'))
661 < 1   const home = path.join(root, 'home')
662 < 1   const bin = path.join(root, 'bin')
663 < 1   fs.mkdirSync(home, { recursive: true })
664 < 1   fs.mkdirSync(bin, { recursive: true })
665 < 1   writeGitConfig(home)
666 < 1 
667 < 1   const { originDir, evidenceDir, base, plan } = buildOrigin(root, runN)
668 < 1   wireEvidence(home, evidenceDir)
669 < 1   git(root, ['clone', originDir, path.join(home, 'target')])
670 < 1   buildEngineDir(home, ENGINE_SHA)
671 < 1   writeStubs(bin, { claudeAuth: 'oauth' })
672 < 1   fs.writeFileSync(path.join(home, 'engine-hangs'), '')
673 < 1 
674 < 1   const env = {
675 < 1     ...baseEnv(PROXY_URL),
676 < 1     FLEET_ASSIGNMENT: assignment({ runN, plan, target: 'o/r', base, engine: ENGINE_SHA })
677 < 1   }
678 < 1   const boot = runBootAsync({ bin, home, env })
679 < 1 
680 < 1   // Killed once the live branch's record says `running` and the engine stub has started.
681 < 1   const liveStatus = () => {
682 < 1     try {
683 < 1       return JSON.parse(git(evidenceDir, ['show', `live/o-r/run-${runN}:runs/o-r/${runN}/status.json`])).state
684 < 1     } catch { return null }
685 < 1   }
686 < 1   const deadline = Date.now() + 60000
687 < 1   while (!(liveStatus() === 'running' && fs.existsSync(path.join(home, 'engine-argv')))) {
688 < 1     if (Date.now() > deadline) { boot.kill(); await boot; assert.fail('(i) the boot never reached a running engine') }
689 < 1     await new Promise((resolve) => setTimeout(resolve, 100))
690 < 1   }
691 < 1   boot.kill()
692 < 1   const killed = await boot
693 < 1   assert.equal(killed.signal, 'SIGKILL', `(i) the boot was killed — got code ${killed.code}, signal ${killed.signal}`)
694 < 1 
695 < 1   const died = await runBootAsync({ bin, home, env }, 'died', { SERVICE_RESULT: 'signal', EXIT_CODE: 'killed', EXIT_STATUS: 'KILL' })
696 < 1   assert.equal(died.code, 0, `(i) boot.sh died exits 0 — got ${died.code}, stderr tail: ${(died.stderr || '').slice(-4000)}`)
697 < 1 
698 < 1   // [M1] the tag's status says failed and names how the unit ended.
699 < 1   assert.ok(`refs/tags/o-r/run-${runN}` in refsOf(evidenceDir), '(i) [M1] the killed run leaves the o-r/run-<N> tag')
700 < 1   const status = JSON.parse(atTag(evidenceDir, runN, 'status.json'))
701 < 1   assert.equal(status.state, 'failed', '(i) [M1] status.json at the tag records state "failed"')
702 < 1   assert.ok(
703 < 1     typeof status.error === 'string' && status.error.includes('unit signal'),
704 < 1     `(i) [M1] status.json's error names how the unit ended — got ${JSON.stringify(status.error)}`
705 < 1   )
706 < 1   // [M2] the tag carries the unit's journal.
707 < 1   assert.ok(
708 < 1     atTag(evidenceDir, runN, 'journal.txt').includes('stub journal line'),
709 < 1     '(i) [M2] journal.txt at the tag carries the journal stub\'s line'
710 < 1   )
711 < 1 }
