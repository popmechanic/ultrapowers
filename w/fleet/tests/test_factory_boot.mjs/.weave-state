0 < 1 /**
1 < 1  * fleet/tests/test_factory_boot.mjs — the exam for "The boot's exam drives the
2 < 1  * probe to `alive`, and the boot hands its dead and misplaced pieces to their
3 < 1  * modules" (the boot half).
4 < 1  *
5 < 1  * At BASE this file drove three `bash factory/boot.sh boot` runs with
6 < 1  * `spawnSync` while its proxy stub was an in-process `http.createServer`; a
7 < 1  * synchronous child blocks the event loop the stub server runs on, so every
8 < 1  * boot's `preflight.mjs` fetch of `/api/oauth/usage` hung to the probe's
9 < 1  * abort and classified `inconclusive` — `alive` was never exercised. This
10 < 1  * file is rewritten whole on the asynchronous rig `test_factory_preflight.mjs`
11 < 1  * uses: every boot is `spawn`ed and awaited (`runBootAsync`), never
12 < 1  * `spawnSync`'d; the rig's own fixture `git` calls stay `spawnSync`, since
13 < 1  * nothing they do waits on the stub server.
14 < 1  *
15 < 1  * Legs, each naming the Machine clause(s) it measures:
16 < 1  *
17 < 1  *   (a) `claude auth status` answers `api_key` — the boot fails before the
18 < 1  *       engine ever runs, and `status.json` at the run's tag records
19 < 1  *       `state: "failed"` with an `error` naming `api_key`.
20 < 1  *
21 < 1  *   (b) [M1, M3, M4] the clean run: the engine stub lands one task, the PR is
22 < 1  *       opened and merged, the run closes — plus the one line ending
23 < 1  *       ` preflight: alive` in `<home>/fleet-boot.log`; the evidence
24 < 1  *       repository holding the tag `o-r/run-<N>` whose `runs/o-r/<N>/` is
25 < 1  *       exactly `engine.log`, `events.jsonl`, `plan.json`, `plan.md` and `status.json`
26 < 1  *       (`state` `done`), `live/o-r/run-<N>` gone and the target holding
27 < 1  *       exactly `main` and the integration branch (M1); the PR body's
28 < 1  *       evidence line byte-exact (M3); no `--past-dir` in the engine's argv,
29 < 1  *       there being no earlier tag (M4); and `<home>/merge-put.json`
30 < 1  *       byte-equal to the exam's own rendering of the merge payload; and
31 < 1  *       `<home>/reap-post.json` parsing to `{ run: 502, target: 'o/r' }`
32 < 1  *       with exactly one `reap: asked the hub` line in the boot log (#1470).
33 < 1  *
34 < 1  *   (c) [M2] the engine stub exits 3 — the boot fails with exactly `"engine
35 < 1  *       exit 3"`, and the run is tagged all the same: `status.json` at
36 < 1  *       `o-r/run-<N>` says `failed` and the live branch is gone; no
37 < 1  *       `<home>/reap-post.json` is written (#1470).
38 < 1  *
39 < 1  *   (d) `node <engineDir>/factory/flock/engine.mjs` with no arguments,
40 < 1  *       through the rig's own `buildEngineDir` symlink, exits 2
41 < 1  *       (`engine: --plan is required`).
42 < 1  *
43 < 1  *   (e) the stale head: the merge PUT waits for the pushed head.
44 < 1  *
45 < 1  *   (f) [M4] with tags `o-r/run-9`, `-77` and `-900` in the evidence
46 < 1  *       repository, run 506's engine gets `--past-dir` whose basename is `77`
47 < 1  *       and whose `status.json` is byte-equal to the tag's.
48 < 1  *
49 < 1  *   (g) [M5] with no `<home>/fleet-evidence-repo` the boot exits non-zero,
50 < 1  *       a `fleet-boot.log` line names `fleet-evidence-repo`, and neither
51 < 1  *       repository's refs move.
52 < 1  *
53 < 1  *   (h) nothing ahead of base with a green engine: done, nothing to build, closed on the base commit.
54 < 1  *
55 < 1  *   (i) [#1445 M1, M2] run 509's boot is SIGKILLed (its whole process group)
56 < 1  *       once the live branch says `running` and the engine stub hangs;
57 < 1  *       `boot.sh died` with `SERVICE_RESULT=signal EXIT_CODE=killed
58 < 1  *       EXIT_STATUS=KILL` then leaves the tag `o-r/run-509` whose
59 < 1  *       `status.json` says `failed` with an `error` naming `unit signal`, and
60 < 1  *       whose `journal.txt` carries the `journalctl` stub's line. Leg (b) ends
61 < 1  *       by running `died` on its finished run and finding its tag where it
62 < 1  *       was (#1445 M3).
63 < 1  *
64 < 1  * The rig, once per case: a bare `origin.git` (the target) holding only a
65 < 1  * `README` commit (`base`) on `main`, and a bare `evidence.git` (the
66 < 1  * operator's `ops/evidence`, `main` seeded with a hand archive) taking the
67 < 1  * launcher's parentless plan commit (`plan`, `runs/o-r/<N>/plan.md`) on
68 < 1  * `refs/heads/live/o-r/run-<N>`. `wireEvidence` writes
69 < 1  * `<home>/fleet-evidence-repo` as the first-boot setup script would and maps
70 < 1  * `https://stub.invalid/ops/evidence.git` to that bare in the case HOME's
71 < 1  * `.gitconfig`; the `systemd-run` stub records the engine's argv to
72 < 1  * `<home>/engine-argv`. `<FLEET_HOME>/target` is a plain clone of the origin. `<FLEET_HOME>/engines/<sha>/
73 < 1  * factory` and `.../skills` are symlinks to this checkout's own `factory/`
75 > 1  * and `skills/`, so the boot's real `factory/publish.mjs` (and, in leg (d),
74 < 2  * and `skills/`, so the boot's real `factory/audit.mjs` (and, in leg (d),
75 < 1  * `factory/flock/engine.mjs`) genuinely runs through a symlinked directory. A `bin`
76 < 1  * directory stubs `claude` (one `authMethod:` line), `curl` (a small
77 < 1  * argument-sniffing router answering the GitHub-shaped endpoints `boot.sh`
78 < 1  * hits, and — new in this task — saving a `PUT …/pulls/7/merge` body to
79 < 1  * `$FLEET_HOME/merge-put.json` the way it already saves the `POST …/pulls`
80 < 1  * body to `pr-post.json`), `systemd-run` (stands in for the whole systemd
81 < 1  * invocation: for the engine unit, either lands one task — writing
82 < 1  * `widget.mjs` and `tests/test_widget.mjs`, committing them into `$target`
83 < 1  * and appending one `landing` row — or exits the code recorded in
84 < 1  * `$FLEET_HOME/engine-exit`) and `systemctl` (a no-op). `node`, `python3`,
85 < 1  * `git` and `bash` are real. Every spawned process — the fixture's own git
86 < 1  * calls and the boot itself — gets `env: simEnv({ bin, home, env })` from
87 < 1  * `./_helpers.mjs`; nothing is ever passed `process.env` directly.
88 < 1  *
89 < 1  * What this exam assumes about `factory/boot.sh`, since it is the one piece
90 < 1  * of context a later reader lacks: that credential-probe failure and engine
91 < 1  * failure both still route through `fail()` writing `status.json` onto the
92 < 1  * live branch and cutting the run's tag before exiting non-zero (so (a) and
94 > 1  * (c) can read it back at the tag); that the boot writes to no issue board,
95 < 1  * so no `board:close`, `board:mark` or `run:audit` row follows the publish's
96 < 1  * own rows; that `factory/policy.json`'s
93 < 2  * (c) can read it back at the tag); that a plan commit with no `kata.json`
94 < 2  * blob leaves the board unbound, so `close_run()` takes its early-return
95 < 2  * path and appends exactly one `board:close` row; that `factory/policy.json`'s
96 < 1  * `publish.self_merge.enabled: true` (already in this repo) is what makes
97 < 1  * (b)'s merge actually happen; and that the `publish:pr` event row's own
98 < 1  * `ts` field is out of this task's own diff — this exam still asserts M1's
99 < 1  * "every row carries a non-empty string `ts`" exactly as written, since a
100 < 1  * clause is asserted as it reads, not as it is comfortable to satisfy today.
101 < 1  * It also assumes that `factory/flock/engine.mjs` reads `process.argv`
102 < 1  * itself (so leg (d)'s bare module path is the same call `boot.sh` makes)
103 < 1  * and, with no `--plan` given, exits 2 before
104 < 1  * touching anything that would need a fuller rig — the same shape the
105 < 1  * sibling exam `test_factory_preflight.mjs` already assumes of
107 > 1  * `preflight.mjs`.
106 < 2  * `audit.mjs`/`preflight.mjs`.
107 < 1  */
108 < 1 
109 < 1 import assert from 'node:assert/strict'
110 < 1 import fs from 'node:fs'
111 < 1 import os from 'node:os'
112 < 1 import path from 'node:path'
113 < 1 
114 < 1 import { bootRig } from './_boot_helpers.mjs'
115 < 1 
116 < 1 const {
117 < 1   ENGINE_SHA, MERGE_SHA, EXPECTED_STATUS_KEYS, SLUG,
119 > 1   git, writeStub, writeGitConfig, buildOrigin, seedPastRun, wireEvidence, refsOf, buildEngineDir, assignment,
118 < 2   git, writeGitConfig, buildOrigin, seedPastRun, wireEvidence, refsOf, buildEngineDir, assignment,
119 < 1   writeStubs, baseEnv, makeProxyServer, runBootAsync, runAsync
120 < 1 } = bootRig()
121 < 1 
122 < 1 /** A file of run `runN`'s folder at its tag `o-r/run-<runN>` in the evidence bare. */
123 < 1 const atTag = (evidenceDir, runN, p) => git(evidenceDir, ['show', `${SLUG}/run-${runN}:runs/${SLUG}/${runN}/${p}`])
124 < 1 const engineArgv = (home) => fs.readFileSync(path.join(home, 'engine-argv'), 'utf8').split('\n').filter((l) => l !== '')
125 < 1 
126 < 1 const proxyServer = await makeProxyServer()
127 < 1 const PROXY_URL = `http://127.0.0.1:${proxyServer.address().port}`
128 < 1 
129 < 1 // ── (a) `claude auth status` answers api_key -> the boot fails before the
130 < 1 //    engine ever runs ───────────────────────────────────────────────────
131 < 1 
132 < 1 {
133 < 1   const runN = '501'
134 < 1   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'fleet-boot-a-'))
135 < 1   const home = path.join(root, 'home')
136 < 1   const bin = path.join(root, 'bin')
137 < 1   fs.mkdirSync(home, { recursive: true })
138 < 1   fs.mkdirSync(bin, { recursive: true })
139 < 1   writeGitConfig(home)
140 < 1 
141 < 1   const { originDir, evidenceDir, base, plan } = buildOrigin(root, runN)
142 < 1   wireEvidence(home, evidenceDir)
143 < 1   git(root, ['clone', originDir, path.join(home, 'target')])
144 < 1   buildEngineDir(home, ENGINE_SHA)
145 < 1   writeStubs(bin, { claudeAuth: 'api_key' })
146 < 1 
147 < 1   const env = {
148 < 1     ...baseEnv(PROXY_URL),
149 < 1     FLEET_ASSIGNMENT: assignment({ runN, plan, target: 'o/r', base, engine: ENGINE_SHA })
150 < 1   }
151 < 1 
152 < 1   const res = await runBootAsync({ bin, home, env })
153 < 1 
154 < 1   assert.notEqual(
155 < 1     res.code, 0,
156 < 1     `(a) the boot exits non-zero on an api_key answer — got 0, stdout: ${res.stdout}, stderr: ${res.stderr}`
157 < 1   )
158 < 1 
159 < 1   const status = JSON.parse(atTag(evidenceDir, runN, 'status.json'))
160 < 1   assert.equal(status.state, 'failed', '(a) status.json records state "failed"')
161 < 1   assert.ok(
162 < 1     typeof status.error === 'string' && status.error.includes('api_key'),
163 < 1     `(a) status.json's error names api_key — got ${JSON.stringify(status.error)}`
164 < 1   )
165 < 1 }
166 < 1 
167 < 1 // ── (a2) a Claude Code release below the floor refuses the run ───────────
168 < 1 
169 < 1 {
170 < 1   const runN = '521'
171 < 1   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'fleet-boot-a2-'))
172 < 1   const home = path.join(root, 'home')
173 < 1   const bin = path.join(root, 'bin')
174 < 1   fs.mkdirSync(home, { recursive: true })
175 < 1   fs.mkdirSync(bin, { recursive: true })
176 < 1   writeGitConfig(home)
177 < 1 
178 < 1   const { originDir, evidenceDir, base, plan } = buildOrigin(root, runN)
179 < 1   wireEvidence(home, evidenceDir)
180 < 1   git(root, ['clone', originDir, path.join(home, 'target')])
181 < 1   buildEngineDir(home, ENGINE_SHA)
182 < 1   writeStubs(bin, { claudeAuth: 'oauth', claudeVersion: '2.1.258' })
183 < 1 
184 < 1   const env = {
185 < 1     ...baseEnv(PROXY_URL),
186 < 1     FLEET_ASSIGNMENT: assignment({ runN, plan, target: 'o/r', base, engine: ENGINE_SHA })
187 < 1   }
188 < 1 
189 < 1   const res = await runBootAsync({ bin, home, env })
190 < 1 
191 < 1   assert.notEqual(res.code, 0, `(a2) the boot exits non-zero on claude 2.1.258 — got 0, stdout: ${res.stdout}`)
192 < 1   const status = JSON.parse(atTag(evidenceDir, runN, 'status.json'))
193 < 1   assert.equal(status.state, 'failed', '(a2) status.json records state "failed"')
194 < 1   assert.equal(
195 < 1     status.error, 'claude 2.1.258 is below the floor 2.1.287',
196 < 1     `(a2) status.json's error names the release and the floor — got ${JSON.stringify(status.error)}`
197 < 1   )
198 < 1 }
199 < 1 
200 < 1 // ── (a3) a missing or non-numeric claude fails the floor, not a shell error ─
201 < 1 
202 < 1 for (const [runN, version, error] of [
203 < 1   ['522', null, 'claude unknown is below the floor 2.1.287'],
204 < 1   ['523', 'v2.1.300', 'claude v2.1.300 is below the floor 2.1.287']
205 < 1 ]) {
206 < 1   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'fleet-boot-a3-'))
207 < 1   const home = path.join(root, 'home')
208 < 1   const bin = path.join(root, 'bin')
209 < 1   fs.mkdirSync(home, { recursive: true })
210 < 1   fs.mkdirSync(bin, { recursive: true })
211 < 1   writeGitConfig(home)
212 < 1 
213 < 1   const { originDir, evidenceDir, base, plan } = buildOrigin(root, runN)
214 < 1   wireEvidence(home, evidenceDir)
215 < 1   git(root, ['clone', originDir, path.join(home, 'target')])
216 < 1   buildEngineDir(home, ENGINE_SHA)
217 < 1   writeStubs(bin, { claudeAuth: 'oauth', claudeVersion: version ?? undefined })
219 > 1   // A missing claude is shadowed, not removed: the sim PATH carries node's own directory,
220 < 1   // and on a box whose /usr/local/bin holds both node and a real claude, removing the stub
221 < 1   // would hand the boot that real, current release.
222 < 1   if (version === null) writeStub(bin, 'claude', '#!/bin/sh\necho "claude: not found" >&2\nexit 127\n')
218 < 2   if (version === null) fs.rmSync(path.join(bin, 'claude'))
219 < 1 
220 < 1   const env = {
221 < 1     ...baseEnv(PROXY_URL),
222 < 1     FLEET_ASSIGNMENT: assignment({ runN, plan, target: 'o/r', base, engine: ENGINE_SHA })
223 < 1   }
224 < 1 
225 < 1   const res = await runBootAsync({ bin, home, env })
226 < 1 
227 < 1   assert.equal(res.code, 1, `(a3) the boot exits 1 on claude ${version} — got ${res.code}, stdout: ${res.stdout}`)
228 < 1   const status = JSON.parse(atTag(evidenceDir, runN, 'status.json'))
229 < 1   assert.equal(status.state, 'failed', `(a3) status.json records state "failed" on claude ${version}`)
230 < 1   assert.equal(status.error, error, `(a3) status.json's error — got ${JSON.stringify(status.error)}`)
231 < 1 }
232 < 1 
233 < 1 // ── (b) [M1, M5] a clean run: land, open, merge, close, probe alive ──────
234 < 1 
235 < 1 {
236 < 1   const runN = '502'
237 < 1   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'fleet-boot-b-'))
238 < 1   const home = path.join(root, 'home')
239 < 1   const bin = path.join(root, 'bin')
240 < 1   fs.mkdirSync(home, { recursive: true })
241 < 1   fs.mkdirSync(bin, { recursive: true })
242 < 1   writeGitConfig(home)
243 < 1   fs.writeFileSync(path.join(home, 'fleet-setup.log'), 'setup: the sim\'s one setup line\n')
244 < 1 
245 < 1   const { originDir, evidenceDir, base, plan } = buildOrigin(root, runN)
246 < 1   wireEvidence(home, evidenceDir)
247 < 1   git(root, ['clone', originDir, path.join(home, 'target')])
248 < 1   buildEngineDir(home, ENGINE_SHA)
249 < 1   writeStubs(bin, { claudeAuth: 'oauth' })
250 < 1 
251 < 1   const env = {
252 < 1     ...baseEnv(PROXY_URL),
253 < 1     FLEET_ASSIGNMENT: assignment({ runN, plan, target: 'o/r', base, engine: ENGINE_SHA }),
254 < 1     MERGE_SHA
255 < 1   }
256 < 1 
257 < 1   const res = await runBootAsync({ bin, home, env })
258 < 1 
259 < 1   assert.equal(
260 < 1     res.code, 0,
261 < 1     `(b) [M1] the clean run exits 0 — got ${res.code}, stdout: ${res.stdout}, stderr tail: ${(res.stderr || '').slice(-4000)}`
262 < 1   )
263 < 1 
264 < 1   // [M1] the boot log carries exactly one line ending ' preflight: alive'
265 < 1   // (at BASE, a synchronous boot blocks the in-process proxy stub and every
266 < 1   // run classifies 'inconclusive' instead).
267 < 1   const bootLog = fs.readFileSync(path.join(home, 'fleet-boot.log'), 'utf8')
268 < 1   const aliveLines = bootLog.split('\n').filter((l) => l.endsWith(' preflight: alive'))
269 < 1   assert.equal(
270 < 1     aliveLines.length, 1,
271 < 1     `(b) [M1] fleet-boot.log carries exactly one line ending ' preflight: alive' — got ${aliveLines.length} of them in:\n${bootLog}`
272 < 1   )
273 < 1 
274 < 1   const landedSha = fs.readFileSync(path.join(home, 'landed-sha'), 'utf8').trim()
275 < 1 
276 < 1   const status = JSON.parse(atTag(evidenceDir, runN, 'status.json'))
277 < 1   assert.deepEqual(
278 < 1     Object.keys(status), EXPECTED_STATUS_KEYS,
279 < 1     `(b) [M1] status.json carries exactly the thirteen named keys, in order — got ${JSON.stringify(Object.keys(status))}`
280 < 1   )
281 < 1   assert.equal(status.state, 'done', '(b) [M1] status.json state is "done"')
282 < 1   assert.equal(status.phase, 'the pull request was merged', '(b) [M1] status.json phase is "the pull request was merged"')
283 < 1   assert.equal(status.pr, 'https://github.com/o/r/pull/7', '(b) [M1] status.json pr is the opened PR\'s URL')
284 < 1   assert.equal(status.prAuthor, 'fleet-bot', '(b) [M1] status.json prAuthor is the PR\'s author login')
285 < 1   assert.equal(status.merged, MERGE_SHA, '(b) [M1] status.json merged is the merge sha the stub reported')
286 < 1   assert.deepEqual(
287 < 1     status.tasks,
288 < 1     { 1: { state: 'folded', park: null } },
289 < 1     `(b) [M1] status.json tasks is exactly the one folded task — got ${JSON.stringify(status.tasks)}`
290 < 1   )
291 < 1 
292 < 1   const eventsText = atTag(evidenceDir, runN, 'events.jsonl')
293 < 1   const rows = eventsText.split('\n').filter((l) => l.trim() !== '').map((l) => JSON.parse(l))
294 < 1   for (const [i, row] of rows.entries()) {
295 < 1     assert.ok(
296 < 1       typeof row.ts === 'string' && row.ts.length > 0,
297 < 1       `(b) [M1] events.jsonl row ${i} (kind=${row.kind}) carries a non-empty string ts — got ${JSON.stringify(row.ts)}`
298 < 1     )
299 < 1   }
300 < 1 
301 < 1   const nonLanding = rows.filter((r) => r.kind !== 'landing')
302 < 1   assert.deepEqual(
303 < 1     nonLanding.map((r) => r.kind),
305 > 1     ['publish:pr', 'weave:push', 'merge'],
306 < 1     `(b) [M1] events.jsonl's non-landing kinds are exactly publish:pr, weave:push, merge in order, and no board row — got ${JSON.stringify(nonLanding.map((r) => r.kind))}`
304 < 2     ['publish:pr', 'weave:push', 'merge', 'board:close', 'run:audit'],
305 < 2     `(b) [M1] events.jsonl's non-landing kinds are exactly publish:pr, weave:push, merge, board:close, run:audit in order — got ${JSON.stringify(nonLanding.map((r) => r.kind))}`
306 < 1   )
307 < 1   // the weave's push sits between the pull request and the merge: main's memory reaches the target
308 < 1   // before the merge request, never after it (factory/publish.mjs `pushWeave`)
310 > 1   const [pubRow, weaveRow, mergeRow] = nonLanding
309 < 2   const [pubRow, weaveRow, mergeRow, closeRow] = nonLanding
310 < 1   assert.equal(weaveRow.when, 'pr', '(b) [M1] the weave:push row is the push made once the pull request is open')
311 < 1   assert.equal(pubRow.url, 'https://github.com/o/r/pull/7', '(b) [M1] the publish:pr row names the PR url')
312 < 1   assert.equal(pubRow.number, 7, '(b) [M1] the publish:pr row names the PR number')
313 < 1   assert.equal(mergeRow.code, 200, '(b) [M1] the merge row records code 200')
314 < 2   assert.equal(closeRow.what, 'run', '(b) [M1] the sole board:close row is "what":"run" (close_run\'s no-kata early return)')
315 < 2   assert.equal(closeRow.code, null, '(b) [M1] the sole board:close row carries code null')
316 < 1 
317 < 1   const prPost = fs.readFileSync(path.join(home, 'pr-post.json'), 'utf8')
318 < 1   // `factory/record.mjs` renders the receipt from `edge` rows (this stub engine writes none, so the
319 < 1   // body carries only the evidence line) and the run folder at its tag in the evidence repository.
320 < 1   const evidenceLine = `**Evidence:** https://github.com/ops/evidence/tree/o-r/run-${runN}/runs/o-r/${runN}`
321 < 1   const expectedBody = 'One widget, one size. It exists so the boot has a plan to carry. It benefits the record.\n\n' +
322 < 1     `${evidenceLine}\n\n` +
323 < 1     'Closes #1222'
324 < 1   // [M3] the body carries exactly that line.
325 < 1   assert.deepEqual(
326 < 1     JSON.parse(fs.readFileSync(path.join(home, 'pr-post.json'), 'utf8')).body.split('\n').filter((l) => l.startsWith('**Evidence:**')),
327 < 1     [evidenceLine],
328 < 1     '(b) [M3] the PR body carries exactly the one evidence line, byte-exact'
329 < 1   )
330 < 1   const expectedPrPost = JSON.stringify({
331 < 1     title: `fleet run-${runN}: A widget that answers its size`,
332 < 1     head: `ultra/integration-run-${runN}`,
333 < 1     base: 'main',
334 < 1     body: expectedBody,
335 < 1     draft: false
336 < 1   })
337 < 1   assert.equal(
338 < 1     prPost, expectedPrPost,
339 < 1     `(b) [M1] the PR POST payload is byte-equal to the exam's own rendering — got ${prPost}`
340 < 1   )
341 < 1 
342 < 1   // [M1] the evidence repository holds the run's one tag and no live branch; the
343 < 1   // target holds exactly `main` and the integration branch.
344 < 1   const evidenceRefs = refsOf(evidenceDir)
345 < 1   assert.ok(`refs/tags/o-r/run-${runN}` in evidenceRefs, '(b) [M1] the evidence repository holds the o-r/run-<N> tag')
346 < 1   assert.ok(!(`refs/heads/live/o-r/run-${runN}` in evidenceRefs), '(b) [M1] refs/heads/live/o-r/run-<N> is gone')
347 < 1   const heads = refsOf(originDir)
348 < 1   assert.deepEqual(
349 < 1     Object.keys(heads).sort(),
350 < 1     ['refs/heads/main', `refs/heads/ultra/integration-run-${runN}`],
351 < 1     `(b) [M1] the target's refs are exactly main and the integration branch — got ${JSON.stringify(Object.keys(heads))}`
352 < 1   )
353 < 1 
354 < 1   // [M4] no earlier o-r/run-<M> tag, so the engine is started with no --past-dir.
355 < 1   const argv = engineArgv(home)
356 < 1   assert.ok(argv.includes('--plan'), `(b) [M4] the systemd-run stub recorded the engine's argv — got ${JSON.stringify(argv)}`)
357 < 1   assert.ok(!argv.includes('--past-dir'), `(b) [M4] with no earlier tag the engine gets no --past-dir — got ${JSON.stringify(argv)}`)
358 < 1   const unitEnv = fs.readFileSync(path.join(home, 'engine-env'), 'utf8').split('\n').filter((l) => l !== '')
