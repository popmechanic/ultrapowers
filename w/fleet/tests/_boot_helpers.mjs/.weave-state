0 < 1 /**
1 < 1  * fleet/tests/_boot_helpers.mjs — the boot sim's rig, shared.
2 < 1  *
3 < 1  * Underscore-prefixed so `test_fleet_suite.py`'s `test_*.mjs` glob does not
4 < 1  * run it as a test of its own (the same convention `_helpers.mjs` follows).
5 < 1  *
6 < 1  * At BASE this rig lived whole inside `test_factory_boot.mjs`: `FIXTURE_PLAN`,
7 < 1  * `buildOrigin`, `buildEngineDir`, `writeStubs` (the `curl` router answering
8 < 1  * `/pulls`, `/pulls/7` and `/pulls/7/merge`, the `systemd-run` stub that runs
9 < 1  * the engine stub inline, `systemctl` a no-op, `claude` a one-line auth
10 < 1  * answer) and the in-process proxy stub server. `fleet/tests/
11 < 1  * test_sims_are_hermetic.mjs` forbids one sim naming another
12 < 1  * (`test_factory_publish.mjs` cannot `import` from `test_factory_boot.mjs`),
13 < 1  * so this task moves those pieces here, behind one factory function,
14 < 1  * `bootRig({ plan, stubs })`, and both `test_factory_boot.mjs` and
15 < 1  * `test_factory_publish.mjs` call it.
16 < 1  *
17 < 1  * `plan` overrides the fixture plan text committed to `runs/o-r/<N>/plan.md`
18 < 1  * in the evidence repository's bare (default `FIXTURE_PLAN`, the boot sim's
19 < 1  * own one-task plan); `stubs` is a
20 < 1  * `{name: content}` map of extra executable stub scripts `writeStubs` writes
21 < 1  * into the case's `bin` directory alongside `claude`/`curl`/`systemd-run`/
22 < 1  * `systemctl` — `test_factory_publish.mjs` uses it for `bun`/`bunx`.
23 < 1  *
24 < 1  * Every process this rig spawns gets `env: simEnv({ bin, home, env })` from
25 < 1  * `./_helpers.mjs` — nothing is ever passed `process.env` directly.
26 < 1  */
27 < 1 
28 < 1 import fs from 'node:fs'
29 < 1 import path from 'node:path'
30 < 1 import { spawn, spawnSync } from 'node:child_process'
31 < 1 import { fileURLToPath } from 'node:url'
32 < 1 
33 < 1 import { simEnv } from './_helpers.mjs'
34 < 1 
35 < 1 const HERE = path.dirname(fileURLToPath(import.meta.url))
36 < 1 const REPO_ROOT = path.resolve(HERE, '../..')
37 < 1 const BOOT_SH = path.join(REPO_ROOT, 'factory', 'boot.sh')
38 < 1 const FACTORY_DIR = path.join(REPO_ROOT, 'factory')
39 < 1 const SKILLS_DIR = path.join(REPO_ROOT, 'skills')
40 < 1 
41 < 1 const ENGINE_SHA = 'e'.repeat(40)
42 < 1 const MERGE_SHA = 'deadbeef'.repeat(5)
43 < 1 
44 < 1 const EXPECTED_STATUS_KEYS = [
45 < 1   'run', 'state', 'phase', 'pr', 'prAuthor', 'merged',
46 < 1   'branch', 'vm', 'startedAt', 'updatedAt', 'error', 'tasks'
47 < 1 ]
48 < 1 
49 < 1 const FIXTURE_PLAN = [
50 < 1   '# A widget that answers its size',
51 < 1   '',
52 < 1   '**Claim:** After this run a widget answers its size. (elicited)',
53 < 1   '',
54 < 1   '**Summary:** One widget, one size. It exists so the boot has a plan to carry. It benefits the record.',
55 < 1   '',
56 < 1   '**Goal:** ship one widget that reports its own size',
57 < 1   '',
58 < 1   '**Closes:** #1222',
59 < 1   '',
60 < 1   '## Global Constraints',
61 < 1   '',
62 < 1   'None.',
63 < 1   '',
64 < 1   '### Task 1: A widget that answers its size',
65 < 1   '',
66 < 1   '**Type:** implementation',
67 < 1   '',
68 < 1   '**Files:**',
69 < 1   '- Create: `widget.mjs`',
70 < 1   '- Test: `tests/test_widget.mjs`',
71 < 1   '',
72 < 1   '**Claim:** A widget answers its size. (derived)',
73 < 1   'Machine: M1. `size()` returns `1`.',
74 < 1   '',
75 < 1   '**Authorized-by:** #1222',
76 < 1   '',
77 < 1   '**Interfaces:**',
78 < 1   '- Consumes: none',
79 < 1   '- Produces: `size()`',
80 < 1   '',
81 < 1   '**Context:** One function, one number.',
82 < 1   '',
83 < 1   '**Proof:**',
84 < 1   '- Test: `tests/test_widget.mjs`',
85 < 1   '- Legs: (a) `size()` is exactly `1` [M1].',
86 < 1   '',
87 < 1   '**Stale-if:**',
88 < 1   '- path-absent: `widget.mjs`',
89 < 1   ''
90 < 1 ].join('\n')
91 < 1 
92 < 1 // ── the rig's own git plumbing (stays synchronous — nothing it does waits
93 < 1 //    on the in-process proxy stub server) ────────────────────────────────
94 < 1 
95 < 1 const GIT_ENV = simEnv({})
96 < 1 
97 < 1 function git (cwd, args) {
98 < 1   const res = spawnSync('git', args, { cwd, encoding: 'utf8', env: GIT_ENV })
99 < 1   if (res.status !== 0) {
100 < 1     throw new Error(`fixture git ${args.join(' ')} (cwd=${cwd}) exited ${res.status}\n${res.stdout}${res.stderr}`)
101 < 1   }
102 < 1   return res.stdout
103 < 1 }
104 < 1 
105 < 1 function writeStub (dir, name, content) {
106 < 1   const p = path.join(dir, name)
107 < 1   fs.writeFileSync(p, content)
108 < 1   fs.chmodSync(p, 0o755)
109 < 1 }
110 < 1 
111 < 1 function writeGitConfig (home) {
112 < 1   fs.writeFileSync(path.join(home, '.gitconfig'), '[user]\n\tname = fleet\n\temail = fleet@exe.dev\n')
113 < 1 }
114 < 1 
115 < 1 // The target is always `o/r`; the operator's evidence repository `ops/evidence`,
116 < 1 // an owner unlike the target's, reached through `GITHUB_INT_HOST` as the boot names it.
117 < 1 const SLUG = 'o-r'
118 < 1 const EVIDENCE_REPO = 'ops/evidence'
119 < 1 const EVIDENCE_URL = `https://stub.invalid/${EVIDENCE_REPO}.git`
120 < 1 
121 < 1 /** A parentless commit in the evidence bare whose tree is `runs/o-r/<runN>/`
122 < 1  *  holding `files` (`{name: text}`), pushed to `ref`; returns its sha. */
123 < 1 function pushRunFolder (evidenceDir, scratch, runN, files, ref) {
124 < 1   git(scratch, ['checkout', '-q', '--orphan', `folder-${runN}-${Date.now()}`])
125 < 1   git(scratch, ['rm', '-rfq', '--ignore-unmatch', '.'])
126 < 1   const folder = path.join(scratch, 'runs', SLUG, String(runN))
127 < 1   fs.mkdirSync(folder, { recursive: true })
128 < 1   for (const [name, text] of Object.entries(files)) fs.writeFileSync(path.join(folder, name), text)
129 < 1   git(scratch, ['add', '-A'])
130 < 1   git(scratch, ['commit', '-qm', `${SLUG}/run-${runN}`])
131 < 1   git(scratch, ['push', '-q', 'origin', `HEAD:${ref}`])
132 < 1   return git(scratch, ['rev-parse', 'HEAD']).trim()
133 < 1 }
134 < 1 
135 < 1 /** Two bares: the target `origin.git`, holding only a `base` commit on `main`,
136 < 1  *  and the evidence repository `evidence.git`, `main` seeded with a hand
137 < 1  *  archive, taking the launcher's parentless plan commit — `runs/o-r/<runN>/plan.md`
138 < 1  *  holding `planText` — on `refs/heads/live/o-r/run-<runN>`. */
139 < 1 function buildOrigin (root, runN, planText) {
140 < 1   const originDir = path.join(root, 'origin.git')
141 < 1   git(root, ['init', '--bare', originDir])
142 < 1   git(originDir, ['symbolic-ref', 'HEAD', 'refs/heads/main'])
143 < 1 
144 < 1   const scratch = path.join(root, 'scratch')
145 < 1   git(root, ['clone', originDir, scratch])
146 < 1   git(scratch, ['config', 'user.email', 'fleet@exe.dev'])
147 < 1   git(scratch, ['config', 'user.name', 'fleet'])
148 < 1 
149 < 1   fs.writeFileSync(path.join(scratch, 'README'), 'seed\n')
150 < 1   git(scratch, ['add', '-A'])
151 < 1   git(scratch, ['commit', '-m', 'seed'])
152 < 1   git(scratch, ['push', 'origin', 'HEAD:refs/heads/main'])
153 < 1   const base = git(scratch, ['rev-parse', 'HEAD']).trim()
154 < 1 
155 < 1   const evidenceDir = path.join(root, 'evidence.git')
156 < 1   git(root, ['init', '--bare', evidenceDir])
157 < 1   git(evidenceDir, ['symbolic-ref', 'HEAD', 'refs/heads/main'])
158 < 1   const evidenceScratch = path.join(root, 'evidence-scratch')
159 < 1   git(root, ['clone', evidenceDir, evidenceScratch])
160 < 1   git(evidenceScratch, ['config', 'user.email', 'fleet@exe.dev'])
161 < 1   git(evidenceScratch, ['config', 'user.name', 'fleet'])
162 < 1   fs.mkdirSync(path.join(evidenceScratch, 'archive'))
163 < 1   fs.writeFileSync(path.join(evidenceScratch, 'archive', 'README'), 'the hand archive\n')
164 < 1   git(evidenceScratch, ['add', '-A'])
165 < 1   git(evidenceScratch, ['commit', '-m', 'seed'])
166 < 1   git(evidenceScratch, ['push', 'origin', 'HEAD:refs/heads/main'])
167 < 1 
168 < 1   const plan = pushRunFolder(evidenceDir, evidenceScratch, runN, { 'plan.md': planText }, `refs/heads/live/${SLUG}/run-${runN}`)
169 < 1 
170 < 1   return { originDir, evidenceDir, evidenceScratch, base, plan }
171 < 1 }
172 < 1 
173 < 1 /** An earlier run's record: a parentless commit holding `runs/o-r/<runN>/`
174 < 1  *  with `files`, tagged `o-r/run-<runN>` in the evidence bare. */
175 < 1 function seedPastRun (evidenceDir, evidenceScratch, runN, files) {
176 < 1   return pushRunFolder(evidenceDir, evidenceScratch, runN, files, `refs/tags/${SLUG}/run-${runN}`)
177 < 1 }
178 < 1 
179 < 1 /** What the first-boot setup script leaves: `<home>/fleet-evidence-repo`
180 < 1  *  naming `ops/evidence` (unless `setting` is false), plus the case HOME's
181 < 1  *  `.gitconfig` routing that repository's URL to the local evidence bare. */
182 < 1 function wireEvidence (home, evidenceDir, { setting = true } = {}) {
183 < 1   if (setting) fs.writeFileSync(path.join(home, 'fleet-evidence-repo'), `${EVIDENCE_REPO}\n`)
184 < 1   fs.appendFileSync(path.join(home, '.gitconfig'), `[url "file://${evidenceDir}"]\n\tinsteadOf = ${EVIDENCE_URL}\n`)
185 < 1 }
186 < 1 
187 < 1 /** Every ref of a bare, `{ref: sha}`, read with `for-each-ref` (no `HEAD`). */
188 < 1 function refsOf (bareDir) {
189 < 1   const map = {}
190 < 1   for (const line of git(bareDir, ['for-each-ref', '--format=%(refname) %(objectname)']).split('\n')) {
191 < 1     if (!line.trim()) continue
192 < 1     const [ref, sha] = line.split(' ')
193 < 1     map[ref] = sha
194 < 1   }
195 < 1   return map
196 < 1 }
197 < 1 
198 < 1 function buildEngineDir (home, engineSha) {
199 < 1   const engineDir = path.join(home, 'engines', engineSha)
200 < 1   fs.mkdirSync(engineDir, { recursive: true })
201 < 1   // `factory` is a real directory of symlinks to the real files, plus its own
202 < 1   // `node_modules`, so the boot's `engine_deps` returns without running npm and
203 < 1   // nothing is written into the checkout's own `factory/`.
204 < 1   const factoryDir = path.join(engineDir, 'factory')
205 < 1   fs.mkdirSync(factoryDir)
206 < 1   for (const entry of fs.readdirSync(FACTORY_DIR)) {
207 < 1     if (entry === 'node_modules') continue
208 < 1     fs.symlinkSync(path.join(FACTORY_DIR, entry), path.join(factoryDir, entry))
209 < 1   }
210 < 1   fs.mkdirSync(path.join(factoryDir, 'node_modules'))
211 < 1   fs.symlinkSync(SKILLS_DIR, path.join(engineDir, 'skills'), 'dir')
212 < 1   return engineDir
213 < 1 }
214 < 1 
215 < 1 function lsRemote (originDir, kind) {
216 < 1   const out = git(originDir, ['ls-remote', kind, originDir])
217 < 1   const map = {}
218 < 1   for (const line of out.split('\n')) {
219 < 1     if (!line.trim()) continue
220 < 1     const [sha, ref] = line.split('\t')
221 < 1     map[ref] = sha
222 < 1   }
223 < 1   return map
224 < 1 }
225 < 1 
226 < 1 function assignment ({ runN, plan, target, base, engine }) {
227 < 1   return `run=${runN} plan=${plan} target=${target} base=${base} engine=${engine}`
228 < 1 }
229 < 1 
230 < 1 const CURL_STUB = `#!/bin/sh
231 < 1 url=""
232 < 1 method="GET"
233 < 1 data=""
234 < 1 wflag=0
235 < 1 while [ $# -gt 0 ]; do
236 < 1   case "$1" in
237 < 1     -X) method="$2"; shift 2 ;;
238 < 1     -H) shift 2 ;;
239 < 1     -d) data="$2"; shift 2 ;;
240 < 1     -w) wflag=1; shift 2 ;;
241 < 1     -o) shift 2 ;;
242 < 1     --max-time) shift 2 ;;
243 < 1     http*) url="$1"; shift ;;
244 < 1     *) shift ;;
245 < 1   esac
246 < 1 done
247 < 1 
248 < 1 case "$url" in
249 < 1   */api/v3/repos/o/r/pulls\\?head=*)
250 < 1     # the open pull request of a branch: the one a POST recorded, else none
251 < 1     printf '%s\\n' "$url" >> "$FLEET_HOME/pr-lookups"
252 < 1     if [ -f "$FLEET_HOME/pr-post.json" ]; then
253 < 1       body='[{"html_url":"https://github.com/o/r/pull/7","number":7,"user":{"login":"fleet-bot"}}]'
254 < 1     else
255 < 1       body='[]'
256 < 1     fi
257 < 1     code=200
258 < 1     ;;
259 < 1   */api/v3/repos/o/r/pulls)
260 < 1     # pr-no-answer (one use): the POST gets no answer, as curl reports it (000). "created"
261 < 1     # opens the pull request all the same; "lost" opens nothing.
262 < 1     noanswer="$(cat "$FLEET_HOME/pr-no-answer" 2>/dev/null)"
263 < 1     if [ "$method" = "POST" ] && [ -n "$noanswer" ]; then
264 < 1       rm -f "$FLEET_HOME/pr-no-answer"
265 < 1       [ "$noanswer" = "created" ] && printf %s "$data" > "$FLEET_HOME/pr-post.json"
266 < 1       body=""
267 < 1       code=000
268 < 1     elif [ "$method" = "POST" ]; then
269 < 1       printf %s "$data" > "$FLEET_HOME/pr-post.json"
270 < 1       body='{"html_url":"https://github.com/o/r/pull/7","number":7,"user":{"login":"fleet-bot"}}'
271 < 1       code=201
272 < 1     else
273 < 1       body=""
274 < 1       code=404
275 < 1     fi
276 < 1     ;;
277 < 1   */api/v3/repos/o/r/pulls/7)
278 < 1     if [ "$method" = "GET" ]; then
279 < 1       tip="$(git -C "$FLEET_HOME/target" ls-remote origin 'refs/heads/ultra/integration-run-*' 2>/dev/null | head -n 1 | cut -f 1)"
280 < 1       stale="$(cat "$FLEET_HOME/stale-heads" 2>/dev/null || echo 0)"
281 < 1       if [ "$stale" -gt 0 ] 2>/dev/null; then
282 < 1         printf %s "$((stale - 1))" > "$FLEET_HOME/stale-heads"
283 < 1         head=0000000000000000000000000000000000000000
284 < 1       else
285 < 1         head="$tip"
286 < 1         [ -n "$tip" ] && : > "$FLEET_HOME/pushed-head-seen"
287 < 1       fi
288 < 1       body=$(printf '{"mergeable":true,"head":{"sha":"%s"}}' "$head")
289 < 1       code=200
290 < 1     else
291 < 1       body=""
292 < 1       code=404
293 < 1     fi
294 < 1     ;;
295 < 1   */api/v3/repos/o/r/pulls/7/merge)
296 < 1     if [ "$method" = "PUT" ]; then
297 < 1       printf %s "$data" > "$FLEET_HOME/merge-put.json"
298 < 1       if [ -f "$FLEET_HOME/stale-heads" ] && [ ! -f "$FLEET_HOME/pushed-head-seen" ]; then
299 < 1         body='{"message":"Pull Request is not mergeable"}'
300 < 1         code=405
301 < 1       else
302 < 1         body=$(printf '{"sha":"%s","message":"Pull Request successfully merged"}' "$MERGE_SHA")
303 < 1         code=200
304 < 1       fi
305 < 1     else
306 < 1       body=""
307 < 1       code=404
308 < 1     fi
309 < 1     ;;
310 < 2   */reap)
311 < 2     if [ "$method" = "POST" ]; then
312 < 2       printf %s "$data" > "$FLEET_HOME/reap-post.json"
313 < 2       body='{"status":202}'
314 < 2       code=202
315 < 2     else
316 < 2       body=""
317 < 2       code=404
318 < 2     fi
319 < 2     ;;
320 < 1   */)
321 < 1     body='{"name":"fleet-sim"}'
322 < 1     code=200
323 < 1     ;;
324 < 1   *)
325 < 1     body=""
326 < 1     code=404
327 < 1     ;;
328 < 1 esac
329 < 1 
330 < 1 printf %s "$body"
331 < 1 if [ "$wflag" = "1" ]; then
332 < 1   printf "\\n%s" "$code"
333 < 1 fi
334 < 1 `
335 < 1 
336 < 1 const SYSTEMD_RUN_STUB = `#!/bin/sh
337 < 1 target=""
338 < 1 rundir=""
339 < 1 prev=""
340 < 1 for a in "$@"; do
341 < 1   case "$prev" in
342 < 1     --target) target="$a" ;;
343 < 1     --run-dir) rundir="$a" ;;
344 < 1   esac
345 < 1   prev="$a"
346 < 1 done
347 < 1 
348 < 1 is_engine=0
349 < 1 for a in "$@"; do
350 < 1   case "$a" in --unit=fleet-engine-*) is_engine=1 ;; esac
351 < 1 done
352 < 1 [ "$is_engine" = "1" ] || exit 0
353 < 1 printf '%s\\n' "$@" > "$FLEET_HOME/engine-argv"
354 < 1 
355 < 1 # The unit's environment is what the \`env\` words set, never this stub's inherited environment:
356 < 1 # \`systemd-run --user\` does not inherit the boot's exports.
357 < 1 : > "$FLEET_HOME/engine-env"
358 < 1 while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do shift; done
359 < 1 shift
360 < 1 if [ "$1" = "env" ]; then
361 < 1   shift
362 < 1   while [ "$#" -gt 0 ]; do
363 < 1     case "$1" in
364 < 1       -u) shift; shift ;;
365 < 1       *=*) printf '%s\\n' "$1" >> "$FLEET_HOME/engine-env"; shift ;;
366 < 1       *) break ;;
367 < 1     esac
368 < 1   done
369 < 1 fi
370 < 1 
371 < 1 # A case that writes \`<home>/engine-hangs\` gets an engine that never lands, so the sim can kill the boot while it runs.
372 < 1 if [ -f "$FLEET_HOME/engine-hangs" ]; then sleep 60; exit 0; fi
373 < 1 
374 < 1 code=0
375 < 1 if [ -f "$FLEET_HOME/engine-exit" ]; then code="$(cat "$FLEET_HOME/engine-exit")"; fi
376 < 1 
377 < 1 if [ "$code" = "0" ] && [ ! -f "$FLEET_HOME/engine-lands-nothing" ]; then
378 < 1   printf '%s\\n' "export const size = () => 1" > "$target/widget.mjs"
379 < 1   mkdir -p "$target/tests"
380 < 1   printf '%s\\n' "export const t = 1" > "$target/tests/test_widget.mjs"
381 < 1   ( cd "$target" && git add -A && git commit -m "task 1" -q ) || exit 1
382 < 1   sha="$(cd "$target" && git rev-parse HEAD)"
383 < 1   printf %s "$sha" > "$FLEET_HOME/landed-sha"
384 < 1   mkdir -p "$rundir"
385 < 1   printf '{"ts":"2026-09-22T00:00:00.000Z","kind":"landing","task":1,"candidateSha":"%s"}\\n' "$sha" >> "$rundir/events.jsonl"
386 < 1 fi
387 < 1 exit "$code"
388 < 1 `
389 < 1 
390 < 1 function claudeStub (mode, version = '2.1.287') {
391 < 1   const text = mode === 'api_key' ? 'authMethod: api_key' : 'authMethod: oauth_token'
392 < 1   return `#!/bin/sh\n[ "$1" = --version ] && { echo '${version} (Claude Code)'; exit 0; }\necho '${text}'\n`
393 < 1 }
394 < 1 
395 < 1 // The `/pulls/7` GET names as `head.sha` the origin's tip of the run's integration
396 < 1 // branch. A case that writes `<home>/stale-heads` (a count) gets that many GETs naming
397 < 1 // forty zeros first, and every `/pulls/7/merge` PUT answers 405 until a GET has named
398 < 1 // the pushed tip (the live catch-up of runs 264/265).
399 < 1 
400 < 1 /** Writes the base stub set (`claude`, `sudo`, `curl`, `systemd-run`, `systemctl`)
401 < 1  *  into `binDir`, plus every `[name, content]` of `extraStubs` — additional
402 < 1  *  executables a case's plan needs (`bun`/`bunx` for the publish probe). */
403 < 1 function writeStubs (binDir, { claudeAuth, claudeVersion, extraStubs = {} } = {}) {
404 < 1   writeStub(binDir, 'claude', claudeStub(claudeAuth, claudeVersion))
405 < 1   // The boot's `sudo -n exeuntu update claude`: a no-op, so the stub's release stands.
406 < 1   writeStub(binDir, 'sudo', '#!/bin/sh\nexit 0\n')
407 < 1   // macOS has no `timeout`: record its argv, then run the rest.
408 < 1   writeStub(binDir, 'timeout', '#!/bin/sh\nprintf \'%s\\n\' "$@" > "$FLEET_HOME/timeout-argv"\nshift\nexec "$@"\n')
409 < 1   writeStub(binDir, 'curl', CURL_STUB)
410 < 1   writeStub(binDir, 'systemd-run', SYSTEMD_RUN_STUB)
411 < 1   writeStub(binDir, 'systemctl', '#!/bin/sh\nexit 0\n')
412 < 1   writeStub(binDir, 'journalctl', '#!/bin/sh\necho \'stub journal line\'\nexit 0\n')
413 < 1   for (const [name, content] of Object.entries(extraStubs)) {
414 < 1     writeStub(binDir, name, content)
415 < 1   }
416 < 1 }
417 < 1 
418 < 1 function baseEnv (proxyUrl) {
419 < 1   return {
420 < 1     ANTHROPIC_PROXY_URL: proxyUrl,
421 < 1     REFLECTION_URL: 'http://127.0.0.1:1',
422 < 1     GITHUB_INT_HOST: 'stub.invalid',
423 < 1     FLEET_COMMIT_SECONDS: '1'
424 < 1   }
425 < 1 }
426 < 1 
427 < 1 // A real, always-200 stand-in for the reflection/oauth-usage proxy so
428 < 1 // `factory/preflight.mjs` (invoked for real by the boot) never needs the
429 < 1 // network: any `claude auth status` this suite's stub answers with
430 < 1 // `oauth_token` classifies as `alive` once its fetch actually completes —
431 < 1 // which requires the child that makes it to run without blocking this
432 < 1 // process's own event loop (the whole reason every boot is `spawn`ed and
433 < 1 // awaited rather than `spawnSync`'d).
434 < 1 function makeProxyServer () {
435 < 1   return import('node:http').then(({ default: http }) => {
436 < 1     const server = http.createServer((_req, res) => {
437 < 1       res.writeHead(200, { 'Content-Type': 'application/json' })
438 < 1       res.end('{}')
439 < 1     })
440 < 1     return new Promise((resolve) => server.listen(0, '127.0.0.1', () => resolve(server)))
441 < 1   })
442 < 1 }
443 < 1 
444 < 1 /** Spawns `cmd` asynchronously, collecting stdout/stderr and resolving once
445 < 1  *  the child's `close` event fires (never blocking this process's event
446 < 1  *  loop — a case's own proxy stub server runs in this same process). A child
447 < 1  *  that outlives `timeoutMs` is killed so a hung boot cannot hang the exam.
448 < 1  *  The child leads its own process group, and the returned promise carries
449 < 1  *  `kill()`, which `SIGKILL`s that whole group — the child and everything it
450 < 1  *  started — so a case can kill a boot mid-run and leave nothing running. */
451 < 1 function runChild (cmd, args, { bin, home, env, timeoutMs } = {}) {
452 < 1   const child = spawn(cmd, args, {
453 < 1     env: simEnv({ bin, home, env }),
454 < 1     stdio: ['ignore', 'pipe', 'pipe'],
455 < 1     detached: true
456 < 1   })
457 < 1   let stdout = ''
458 < 1   let stderr = ''
459 < 1   child.stdout.on('data', (d) => { stdout += d })
460 < 1   child.stderr.on('data', (d) => { stderr += d })
461 < 1   const kill = () => {
462 < 1     try { process.kill(-child.pid, 'SIGKILL') } catch { /* the group is already gone */ }
463 < 1   }
464 < 1   const timer = setTimeout(kill, timeoutMs ?? 120000)
465 < 1   const done = new Promise((resolve) => child.on('close', (code, signal) => {
466 < 1     clearTimeout(timer)
467 < 1     resolve({ code, signal, stdout, stderr })
468 < 1   }))
469 < 1   done.kill = kill
470 < 1   return done
471 < 1 }
472 < 1 
473 < 1 /** `bash factory/boot.sh <sub>` (default `boot`), with `extraEnv` laid over
474 < 1  *  `opts.env`; the returned promise carries `kill()` (see `runChild`). */
475 < 1 const runBootAsync = (opts = {}, sub = 'boot', extraEnv = {}) =>
476 < 1   runChild('bash', [BOOT_SH, sub], { ...opts, env: { ...(opts.env ?? {}), ...extraEnv } })
477 < 1 
478 < 1 /** `node <argv[0]> ...argv.slice(1)`, awaited — the same shape
479 < 1  *  `test_factory_preflight.mjs`'s `runAsync` uses. */
480 < 1 const runAsync = (argv, opts) => runChild(process.execPath, argv, opts)
481 < 1 
482 < 1 /**
483 < 1  * `bootRig({ plan, stubs })` — the rig, bound to one fixture plan and one
484 < 1  * extra-stub set: `plan` (default `FIXTURE_PLAN`) is the text committed to
485 < 1  * `.ultrapowers/plan.md` by `buildOrigin`; `stubs` (default `{}`) is folded
486 < 1  * into every `writeStubs` call this rig object makes.
487 < 1  */
488 < 1 export function bootRig ({ plan = FIXTURE_PLAN, stubs = {} } = {}) {
489 < 1   return {
490 < 1     FIXTURE_PLAN: plan,
491 < 1     ENGINE_SHA,
492 < 1     MERGE_SHA,
493 < 1     EXPECTED_STATUS_KEYS,
494 < 1     REPO_ROOT,
495 < 1     BOOT_SH,
496 < 1     FACTORY_DIR,
497 < 1     SKILLS_DIR,
498 < 1     git,
499 < 1     writeStub,
500 < 1     writeGitConfig,
501 < 1     SLUG,
502 < 1     EVIDENCE_REPO,
503 < 1     buildOrigin: (root, runN) => buildOrigin(root, runN, plan),
504 < 1     seedPastRun,
505 < 1     wireEvidence,
506 < 1     refsOf,
507 < 1     buildEngineDir,
508 < 1     lsRemote,
509 < 1     assignment,
510 < 1     writeStubs: (binDir, opts = {}) => writeStubs(binDir, { ...opts, extraStubs: { ...stubs, ...(opts.extraStubs ?? {}) } }),
511 < 1     baseEnv,
512 < 1     makeProxyServer,
513 < 1     runChild,
514 < 1     runBootAsync,
515 < 1     runAsync
516 < 1   }
517 < 1 }
518 < 1 
519 < 1 export { FIXTURE_PLAN, ENGINE_SHA, MERGE_SHA, EXPECTED_STATUS_KEYS }
