379 < 2 // (j) the README's tray section names no digit hotkey for the band
380 < 2 {
381 < 2   const readme = fs.readFileSync(path.join(ROOT, 'README.md'), 'utf8')
382 < 2   const section = readme.split('## The intent tray')[1].split('\n## ')[0]
383 < 2   assert.ok(!/\(`[0-9]`\)/.test(section), '(j) the README pins no digit hotkey on a band button')
384 < 2   assert.ok(/\*\*Add note\*\* \(`n`\)/.test(section) && /\*\*Send\*\* \(`s`\)/.test(section) && /\*\*Clear\*\*\s+\(`c`\)/.test(section),
385 < 2     '(j) the README names the band hotkeys n, s and c')
386 < 2 }
