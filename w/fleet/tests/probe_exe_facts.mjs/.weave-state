0 < 1 // fleet/tests/probe_exe_facts.mjs — the fleet's twelve exe.dev lobby facts,
1 < 1 // re-read against the live lobby, one line per fact, each stamped with the
2 < 1 // digest that is the only version marker exe.dev exposes.
3 < 1 //
4 < 1 // NOT named test_*.mjs on purpose: `tests/test_fleet_suite.py` globs
5 < 1 // `test_*.mjs`, so the suite never runs this and CI never spends a real VM.
6 < 1 // It is a LIVE MEASUREMENT (fleet/tests/PROBES.md) and is run by hand on the
7 < 1 // laptop, where the ssh seam to exe.dev lives:
8 < 1 //
9 < 1 //     node fleet/tests/probe_exe_facts.mjs
10 < 1 //
11 < 1 // WHY IT EXISTS. Every lobby fact in fleet/RUNBOOK.md's §Traps under "Tags,
12 < 1 // keys and names" and "Reading the lobby" was learned from a run that died on
13 < 1 // it, and fleet/doctor.mjs's verb-drift row re-reads each verb's FLAG set —
14 < 1 // nothing in the tree re-reads a BEHAVIOUR. exe.dev exposes no version verb,
15 < 1 // no --version, no version header, no changelog and no change notification
16 < 1 // (Shelley, exe.dev's assistant, 2026-09-23), so the one thing every line
17 < 1 // here is stamped with is the digest of `help all --json`'s own stdout and
18 < 1 // the UTC date the reading was taken.
19 < 1 //
20 < 1 // THE THROWAWAY VMS. Fact 6 (new-no-positionals) creates one VM,
21 < 1 // `probe-exe-facts-<stamp>`; fact 10 (cp-copies-tags) makes two copies of it.
22 < 1 // All three are removed at the end, the last mutating verbs the probe issues
23 < 1 // — `rm <name>` once per VM it created — and a failing `rm` is named as left
24 < 1 // behind rather than lost silently.
25 < 1 //
26 < 1 // THE REFUSAL. Before any mutating verb the probe reads `ls --json`, and a
27 < 1 // `fleet-r*` VM already listed there means a fleet run is live: it refuses
28 < 1 // to create a throwaway beside it, issues no `new`, and exits 2.
29 < 1 //
30 < 1 // HOW A FACT IS SCORED. Each fact issues the lobby verb(s) its recorded
31 < 1 // reading names and compares what came back against that reading. `holds`
32 < 1 // means the answer is in the same shape/class as recorded; `DRIFT` means it
33 < 1 // is not (a refusal that started succeeding, a shape the lobby stopped
34 < 1 // answering); a verb whose `exec` threw or answered no exit code at all is
35 < 1 // `UNREADABLE` — never scored as drift, since nothing was actually read.
36 < 1 //
37 < 1 // Exit: 0 every fact holds; 1 at least one drift or unreadable fact;
38 < 1 // 2 the lobby was unreachable, a live run's VM was listed, or the cleanup
39 < 1 // left a throwaway VM behind.
40 < 1 
41 < 1 import path from 'node:path'
42 < 1 import { createHash } from 'node:crypto'
43 < 1 import { fileURLToPath } from 'node:url'
44 < 1 
45 < 1 import { EXE_HOST, defaultExec, parseJson } from '../lobby.mjs'
46 < 1 
47 < 1 /**
48 < 1  * The twelve facts, in the order every run logs them — NOT the order they are
49 < 1  * read in: fact 11 (rm-reserves-name) is read last of all, after the cleanup,
50 < 1  * while fact 12 (refused-verbs) is read before it. `says` is the reading the
51 < 1  * fleet holds today, quoted back on a DRIFT or UNREADABLE line, and the ids
52 < 1  * are the shared literal `fleet/CONTRACT.md`'s `exe.dev facts (measured)`
53 < 1  * list carries row for row.
54 < 1  */
55 < 1 export const FACTS = Object.freeze([
56 < 1   { id: 'help-all-digest',
57 < 1     says: 'help all --json is JSON with a commands array; its sha256 is the only version marker exe.dev exposes (Shelley, 2026-09-23)' },
58 < 1   { id: 'ls-json-shape',
59 < 1     says: 'ls --json is {shared_vms, vms}; read .vms[] only; rows carry vm_name, ssh_dest, ssh_host, status' },
60 < 1   { id: 'billing-plan-json',
61 < 1     says: 'billing plan --json carries max_cpus, max_memory_gb, tier and plan — the pool the launcher sizes against' },
62 < 1   { id: 'help-verb-flags',
63 < 1     says: 'help <verb> prints an Options: block, one flag per line, which is what the doctor\'s verb-drift row diffs' },
64 < 1   { id: 'error-on-stdout',
65 < 1     says: 'a lobby error comes back on stdout with exit 1 and no envelope' },
66 < 1   { id: 'new-no-positionals',
67 < 1     says: 'new takes no positionals; a spaced --comment travels inside one ssh argument with its quotes intact, or the lobby reads the tail as positionals' },
68 < 1   { id: 'comment-200-bytes',
69 < 1     says: 'the VM comment holds 200 bytes' },
70 < 1   { id: 'share-port-single',
71 < 1     says: 'share port sets the VM\'s single proxy_port; a second call replaces it' },
72 < 1   { id: 'tag-add-remove',
73 < 1     says: 'tag adds and tag -d removes a tag; tag -d of a tag an integration policy names detaches that integration at once (not re-measured: the probe carries no policy-scoped tag)' },
74 < 1   { id: 'cp-copies-tags',
75 < 1     says: 'cp copies tags by default; --copy-tags=false makes a copy with none' },
76 < 1   { id: 'rm-reserves-name',
77 < 1     says: 'exe.dev does not reserve a deleted VM\'s name: a new VM may take it' },
78 < 1   { id: 'refused-verbs',
79 < 1     says: 'integrations attach and detach are the grant verbs and there is no integrations policy verb: help integrations lists attach and detach and no policy (#1434; the earlier reading attached a nonexistent name, which fails whatever the model)' },
80 < 1 ])
81 < 1 
82 < 1 // ── Small readings of an answer ─────────────────────────────────────────────
83 < 1 
84 < 1 const two = (n) => String(n).padStart(2, '0')
85 < 1 
86 < 1 /** `YYYYMMDDHHMM` from `now`, UTC — the throwaway's stamp. */
87 < 1 const runStampOf = (now) => {
88 < 1   const d = now instanceof Date ? now : new Date(now)
89 < 1   return `${d.getUTCFullYear()}${two(d.getUTCMonth() + 1)}${two(d.getUTCDate())}${two(d.getUTCHours())}${two(d.getUTCMinutes())}`
90 < 1 }
91 < 1 
92 < 1 /** `YYYY-MM-DD` from `now`, UTC — the date every line is stamped with. */
93 < 1 const dateOf = (now) => (now instanceof Date ? now : new Date(now)).toISOString().slice(0, 10)
94 < 1 
95 < 1 /** The first 16 hex characters of the sha256 of `text`'s bytes. */
96 < 1 const sha16 = (text) => createHash('sha256').update(String(text ?? ''), 'utf8').digest('hex').slice(0, 16)
97 < 1 
98 < 1 const FLAG_LINE = /^[ \t]+(--[A-Za-z0-9-]+)/gm
99 < 1 
100 < 1 /** The `Options:` block's flags, as `fleet/doctor.mjs`'s `helpFlags` reads them. */
101 < 1 const helpFlags = (stdout) => {
102 < 1   const flags = []
103 < 1   for (const match of String(stdout ?? '').matchAll(FLAG_LINE)) {
104 < 1     if (!flags.includes(match[1])) flags.push(match[1])
105 < 1   }
106 < 1   return flags
107 < 1 }
108 < 1 
109 < 1 // ── The probe ────────────────────────────────────────────────────────────────
110 < 1 
111 < 1 /**
112 < 1  * Re-measure all twelve facts against `exec` and write one line per fact
113 < 1  * through `log`. `exec` is the seam `fleet/lobby.mjs` defines —
114 < 1  * `(cmd, argv, options?) => Promise<{ code, stdout, stderr }>`, never
115 < 1  * rejecting — driven raw rather than through `lobby(exec, remote)`: several
116 < 1  * facts need the exact stdout/stderr split and the exact exit code a caught
117 < 1  * `LobbyError` does not keep. Every verb is issued as
118 < 1  * `exec('ssh', [EXE_HOST, '<verb line>'])`, one string argument after the
119 < 1  * host, exactly as `fleet/lobby.mjs`'s `lobby` does.
120 < 1  *
121 < 1  * Resolves `{ exit, stamp, results }`.
122 < 1  */
123 < 1 export const probeExeFacts = async ({ exec, log = console.log, now = new Date() } = {}) => {
124 < 1   const date = dateOf(now)
125 < 1   const runStamp = runStampOf(now)
126 < 1   const T = `probe-exe-facts-${runStamp}`
127 < 1 
128 < 1   /** One lobby verb. A thrown `exec` or a non-numeric `code` reads as `code:
129 < 1    *  null` — unreadable, never scored as a drift. */
130 < 1   const send = async (remote) => {
131 < 1     try {
132 < 1       const res = await exec('ssh', [EXE_HOST, remote])
133 < 1       const code = res && typeof res.code === 'number' ? res.code : null
134 < 1       return { code, stdout: String((res && res.stdout) ?? ''), stderr: String((res && res.stderr) ?? '') }
135 < 1     } catch (err) {
136 < 1       return { code: null, stdout: '', stderr: String(err?.message ?? err) }
137 < 1     }
138 < 1   }
139 < 1 
140 < 1   const readJson = (res) => (res.code === 0 ? parseJson(res.stdout) : null)
141 < 1   const vmRow = (payload, name) => {
142 < 1     const rows = Array.isArray(payload?.vms) ? payload.vms : []
143 < 1     return rows.find((row) => row?.vm_name === name) ?? null
144 < 1   }
145 < 1 
146 < 1   const HOLDS = 'holds'
147 < 1   const DRIFT = 'DRIFT'
148 < 1   const UNREADABLE = 'UNREADABLE'
149 < 1   const holds = (read) => ({ verdict: HOLDS, read })
150 < 1   const drift = (read) => ({ verdict: DRIFT, read })
151 < 1   const unreadable = (read) => ({ verdict: UNREADABLE, read })
152 < 1 
153 < 1   // ── fact 1: help all --json — the lobby's reachability, and the digest ────
154 < 1   const helpAll = await send('help all --json')
155 < 1   if (helpAll.code !== 0) {
156 < 1     log(`lobby unreachable — help all --json answered ${helpAll.code === null ? 'no exit code' : `exit ${helpAll.code}`}`)
157 < 1     return { exit: 2, stamp: null, results: [] }
158 < 1   }
159 < 1   const stamp = sha16(helpAll.stdout)
160 < 1   log(`lobby ${stamp} — sha256 of help all --json, read ${date}`)
161 < 1 
162 < 1   const helpAllJson = parseJson(helpAll.stdout)
163 < 1   const fact1 = Array.isArray(helpAllJson?.commands)
164 < 1     ? holds(`help all --json is JSON with ${helpAllJson.commands.length} command(s) under commands[]`)
165 < 1     : drift(helpAllJson ? 'help all --json parsed but carries no commands array' : 'help all --json did not parse as JSON')
166 < 1 
167 < 1   // ── fact 2 and the M3 refusal — ls --json, before any mutating verb ───────
168 < 1   const ls1 = await send('ls --json')
169 < 1   const ls1Json = readJson(ls1)
170 < 1   const vms1 = Array.isArray(ls1Json?.vms) ? ls1Json.vms : []
171 < 1 
172 < 1   const liveRun = vms1.find((row) => typeof row?.vm_name === 'string' && row.vm_name.startsWith('fleet-r'))
173 < 1   if (liveRun) {
174 < 1     log(`${liveRun.vm_name} is a live run's VM — refusing to create a throwaway beside a live run`)
175 < 1     return { exit: 2, stamp, results: [] }
176 < 1   }
177 < 1 
178 < 1   const fact2 = ls1.code !== 0
179 < 1     ? unreadable(`ls --json answered ${ls1.code === null ? 'no exit code' : `exit ${ls1.code}`}`)
180 < 1     : !Array.isArray(ls1Json?.vms)
181 < 1       ? drift('ls --json answered no .vms[] array')
182 < 1       : !Array.isArray(ls1Json?.shared_vms)
183 < 1         ? drift('ls --json answered no .shared_vms[] array')
184 < 1         : holds(`ls --json is {shared_vms, vms}; ${vms1.length} row(s) under .vms[]`)
185 < 1 
186 < 1   // ── fact 3: billing plan --json ────────────────────────────────────────────
187 < 1   const billing = await send('billing plan --json')
188 < 1   const billingJson = readJson(billing)
189 < 1   const BILLING_KEYS = ['max_cpus', 'max_memory_gb', 'tier', 'plan']
190 < 1   const fact3 = billing.code === null
191 < 1     ? unreadable('billing plan --json gave no answer')
192 < 1     : billing.code !== 0
193 < 1       ? drift(`billing plan --json failed (exit ${billing.code})`)
194 < 1       : (() => {
195 < 1           const missing = BILLING_KEYS.filter((key) => !billingJson || !(key in billingJson))
196 < 1           return missing.length === 0
197 < 1             ? holds('billing plan --json carries max_cpus, max_memory_gb, tier and plan')
198 < 1             : drift(`billing plan --json is missing ${missing.join(', ')}`)
199 < 1         })()
200 < 1 
201 < 1   // ── fact 4: help new — the Options: block the doctor's verb-drift reads ──
202 < 1   const helpNew = await send('help new')
203 < 1   const WANT_FLAGS = ['--comment', '--name', '--setup-script', '--tag', '--cpu', '--memory']
204 < 1   const fact4 = helpNew.code === null
205 < 1     ? unreadable('help new gave no answer')
206 < 1     : helpNew.code !== 0
207 < 1       ? drift(`help new failed (exit ${helpNew.code})`)
208 < 1       : (() => {
209 < 1           const found = helpFlags(helpNew.stdout)
210 < 1           const missing = WANT_FLAGS.filter((flag) => !found.includes(flag))
211 < 1           return missing.length === 0
212 < 1             ? holds(`help new's Options: block lists ${WANT_FLAGS.join(', ')}`)
213 < 1             : drift(`help new's Options: block is missing ${missing.join(', ')}`)
214 < 1         })()
215 < 1 
216 < 1   // ── fact 5: a lobby error on stdout, no envelope ──────────────────────────
217 < 1   const badVm = `no-such-vm-${runStamp}`
218 < 1   const errCheck = await send(`comment ${badVm} probe`)
219 < 1   const fact5 = errCheck.code === null
220 < 1     ? unreadable(`comment ${badVm} probe gave no answer`)
221 < 1     : errCheck.code === 0
222 < 1       ? drift(`comment ${badVm} probe exited 0`)
223 < 1       : (() => {
224 < 1           const trimmed = errCheck.stdout.trim()
225 < 1           if (trimmed === '') return drift(`comment ${badVm} probe exited ${errCheck.code} with empty stdout`)
226 < 1           if (parseJson(errCheck.stdout) !== null) return drift(`comment ${badVm} probe's stdout parsed as JSON`)
227 < 1           return holds(`comment ${badVm} probe exited ${errCheck.code} with non-empty, non-JSON stdout`)
228 < 1         })()
229 < 1 
230 < 1   // ── fact 6: new — no positionals, a spaced --comment survives whole ──────
231 < 1   const comment6 = `probe exe facts ${runStamp}`
232 < 1   const newT = await send(`new --name ${T} --cpu 1 --memory 2GB --comment '${comment6}'`)
233 < 1   let tCreated = false
234 < 1   let fact6
235 < 1   if (newT.code === null) {
236 < 1     fact6 = unreadable(`new --name ${T} … gave no answer`)
237 < 1   } else if (newT.code !== 0) {
238 < 1     fact6 = drift(`new --name ${T} … failed (exit ${newT.code})`)
239 < 1   } else {
240 < 1     tCreated = true
241 < 1     const ls2 = await send('ls --json')
242 < 1     const row = vmRow(readJson(ls2), T)
243 < 1     fact6 = row && row.comment === comment6
244 < 1       ? holds(`new --name ${T} … created it and ls --json reads the comment whole`)
245 < 1       : drift(row ? `ls --json reads comment ${JSON.stringify(row.comment)}` : `ls --json does not list ${T}`)
246 < 1   }
247 < 1 
248 < 1   // ── fact 7: the 200-byte comment ceiling ──────────────────────────────────
249 < 1   let fact7
250 < 1   if (!tCreated) {
251 < 1     fact7 = unreadable(`${T} was never created`)
252 < 1   } else {
253 < 1     const over = 'x'.repeat(201)
254 < 1     const atLimit = 'x'.repeat(200)
255 < 1     const long = await send(`comment ${T} ${over}`)
256 < 1     const short = await send(`comment ${T} ${atLimit}`)
257 < 1     if (long.code === null || short.code === null) {
258 < 1       fact7 = unreadable(`comment <201 bytes> exited ${long.code ?? 'none'}, <200 bytes> exited ${short.code ?? 'none'}`)
259 < 1     } else if (long.code !== 0 && short.code === 0) {
260 < 1       fact7 = holds(`comment <201 bytes> failed (exit ${long.code}), <200 bytes> exited 0`)
261 < 1     } else {
262 < 1       fact7 = drift(`comment <201 bytes> exited ${long.code}, <200 bytes> exited ${short.code}`)
263 < 1     }
264 < 1   }
265 < 1 
266 < 1   // ── fact 8: share port — one proxy_port, replaced ─────────────────────────
267 < 1   let fact8
268 < 1   if (!tCreated) {
269 < 1     fact8 = unreadable(`${T} was never created`)
270 < 1   } else {
271 < 1     const s1 = await send(`share port ${T} 8080`)
272 < 1     const row1 = vmRow(readJson(await send('ls --json')), T)
273 < 1     const s2 = await send(`share port ${T} 9090`)
274 < 1     const row2 = vmRow(readJson(await send('ls --json')), T)
275 < 1     if (s1.code === null || s2.code === null) {
276 < 1       fact8 = unreadable(`share port 8080 exited ${s1.code ?? 'none'}, share port 9090 exited ${s2.code ?? 'none'}`)
277 < 1     } else if (s1.code === 0 && s2.code === 0 && row1?.proxy_port === 8080 && row2?.proxy_port === 9090) {
278 < 1       fact8 = holds('share port 8080 then 9090 leaves proxy_port 9090')
279 < 1     } else {
280 < 1       fact8 = drift(`proxy_port read ${row1?.proxy_port ?? 'none'} then ${row2?.proxy_port ?? 'none'}`)
281 < 1     }
282 < 1   }
283 < 1 
284 < 1   // ── fact 9: tag / tag -d ───────────────────────────────────────────────────
285 < 1   const tagName = `probe-exe-${runStamp}`
286 < 1   let fact9
287 < 1   if (!tCreated) {
288 < 1     fact9 = unreadable(`${T} was never created`)
289 < 1   } else {
290 < 1     const add = await send(`tag ${T} ${tagName}`)
291 < 1     const rowA = vmRow(readJson(await send('ls --json')), T)
292 < 1     const hasTag = Array.isArray(rowA?.tags) && rowA.tags.includes(tagName)
293 < 1     const del = await send(`tag -d ${T} ${tagName}`)
294 < 1     const rowB = vmRow(readJson(await send('ls --json')), T)
295 < 1     const tagGone = !(Array.isArray(rowB?.tags) && rowB.tags.includes(tagName))
296 < 1     if (add.code === null || del.code === null) {
297 < 1       fact9 = unreadable(`tag exited ${add.code ?? 'none'}, tag -d exited ${del.code ?? 'none'}`)
298 < 1     } else if (add.code === 0 && hasTag && del.code === 0 && tagGone) {
299 < 1       fact9 = holds(`tag ${tagName} added it and tag -d removed it`)
300 < 1     } else {
301 < 1       fact9 = drift(`tag read tags ${JSON.stringify(rowA?.tags ?? null)}, tag -d read tags ${JSON.stringify(rowB?.tags ?? null)}`)
302 < 1     }
303 < 1   }
304 < 1 
305 < 1   // ── fact 10: cp — copies tags by default, --copy-tags=false makes none ───
306 < 1   const copy1 = `${T}-copy1`
307 < 1   const copy2 = `${T}-copy2`
308 < 1   let copy1Created = false
309 < 1   let copy2Created = false
310 < 1   let fact10
311 < 1   if (!tCreated) {
312 < 1     fact10 = unreadable(`${T} was never created`)
313 < 1   } else {
314 < 1     // Fact 9 removed the tag; put it back so cp has something to copy.
315 < 1     await send(`tag ${T} ${tagName}`)
316 < 1     const cp1 = await send(`cp ${T} ${copy1}`)
317 < 1     if (cp1.code === 0) copy1Created = true
318 < 1     const rowC1 = vmRow(readJson(await send('ls --json')), copy1)
319 < 1     const copy1HasTag = Array.isArray(rowC1?.tags) && rowC1.tags.includes(tagName)
320 < 1     const cp2 = await send(`cp ${T} ${copy2} --copy-tags=false`)
321 < 1     if (cp2.code === 0) copy2Created = true
322 < 1     const rowC2 = vmRow(readJson(await send('ls --json')), copy2)
323 < 1     const copy2NoTags = !Array.isArray(rowC2?.tags) || rowC2.tags.length === 0
324 < 1     await send(`tag -d ${T} ${tagName}`)
325 < 1     if (cp1.code === null || cp2.code === null) {
326 < 1       fact10 = unreadable(`cp ${T} ${copy1} exited ${cp1.code ?? 'none'}, cp --copy-tags=false exited ${cp2.code ?? 'none'}`)
327 < 1     } else if (cp1.code === 0 && copy1HasTag && cp2.code === 0 && copy2NoTags) {
328 < 1       fact10 = holds(`cp ${T} ${copy1} copied ${tagName}; cp --copy-tags=false made ${copy2} with no tags`)
329 < 1     } else {
330 < 1       fact10 = drift(`${copy1} tags read ${JSON.stringify(rowC1?.tags ?? null)}; ${copy2} tags read ${JSON.stringify(rowC2?.tags ?? null)}`)
331 < 1     }
332 < 1   }
333 < 1 
334 < 1   // ── fact 12: refused verbs — read before the cleanup ──────────────────────
335 < 1   const intHelp = await send('help integrations')
336 < 1   const verbs = new Set([...String(intHelp.stdout ?? '').matchAll(/^\s+([a-z-]+)\s+-\s/gm)].map((m) => m[1]))
337 < 1   const fact12 = intHelp.code !== 0
338 < 1     ? unreadable(`help integrations exited ${intHelp.code ?? 'none'}`)
339 < 1     : verbs.has('attach') && verbs.has('detach') && !verbs.has('policy')
340 < 1       ? holds(`help integrations lists attach and detach and no policy`)
341 < 1       : drift(`help integrations lists ${JSON.stringify([...verbs])}`)
342 < 1 
343 < 1   // ── cleanup: one `rm` per VM the run created ──────────────────────────────
344 < 1   const toRemove = []
345 < 1   if (copy1Created) toRemove.push(copy1)
346 < 1   if (copy2Created) toRemove.push(copy2)
347 < 1   if (tCreated) toRemove.push(T)
348 < 1 
349 < 1   const leftBehind = []
350 < 1   for (const name of toRemove) {
351 < 1     const rm = await send(`rm ${name}`)
352 < 1     if (rm.code !== 0) leftBehind.push(name)
353 < 1   }
354 < 1 
355 < 1   // ── fact 11: rm frees the name — read last, after the cleanup ────────────
356 < 1   let fact11
357 < 1   if (!tCreated) {
358 < 1     fact11 = unreadable(`${T} was never created`)
359 < 1   } else if (leftBehind.includes(T)) {
360 < 1     fact11 = unreadable(`${T} was not removed`)
361 < 1   } else {
362 < 1     const again = await send(`new --name ${T} --cpu 1 --memory 2GB`)
363 < 1     if (again.code === null) {
364 < 1       fact11 = unreadable(`new --name ${T} gave no answer`)
365 < 1     } else if (again.code !== 0) {
366 < 1       fact11 = drift(`new --name ${T} … failed (exit ${again.code}) — the name is reserved`)
367 < 1     } else {
368 < 1       // Succeeded: it made a VM, so it is counted in the cleanup.
369 < 1       const rmAgain = await send(`rm ${T}`)
370 < 1       if (rmAgain.code !== 0) leftBehind.push(T)
371 < 1       fact11 = holds(`new --name ${T} … exited 0 — the name was not reserved`)
372 < 1     }
373 < 1   }
374 < 1 
375 < 1   // ── the FACT lines, in FACTS order, and the tally ─────────────────────────
376 < 1   const byId = {
377 < 1     'help-all-digest': fact1,
378 < 1     'ls-json-shape': fact2,
379 < 1     'billing-plan-json': fact3,
380 < 1     'help-verb-flags': fact4,
381 < 1     'error-on-stdout': fact5,
382 < 1     'new-no-positionals': fact6,
383 < 1     'comment-200-bytes': fact7,
384 < 1     'share-port-single': fact8,
385 < 1     'tag-add-remove': fact9,
386 < 1     'cp-copies-tags': fact10,
387 < 1     'rm-reserves-name': fact11,
388 < 1     'refused-verbs': fact12,
389 < 1   }
390 < 1 
391 < 1   const results = []
392 < 1   let driftCount = 0
393 < 1   let unreadableCount = 0
394 < 1   for (const fact of FACTS) {
395 < 1     const { verdict, read } = byId[fact.id]
396 < 1     if (verdict === DRIFT) driftCount += 1
397 < 1     else if (verdict === UNREADABLE) unreadableCount += 1
398 < 1     const line = verdict === HOLDS
399 < 1       ? `FACT ${fact.id}: holds — ${read} (lobby ${stamp}, ${date})`
400 < 1       : `FACT ${fact.id}: ${verdict} — ${read}, recorded ${fact.says} (lobby ${stamp}, ${date})`
401 < 1     log(line)
402 < 1     results.push({ id: fact.id, verdict, read, line })
403 < 1   }
404 < 1 
405 < 1   log(`PROBE: ${FACTS.length} facts, ${driftCount} drift, ${unreadableCount} unreadable`)
406 < 1 
407 < 1   let exit = (driftCount > 0 || unreadableCount > 0) ? 1 : 0
408 < 1   if (leftBehind.length > 0) {
409 < 1     for (const name of leftBehind) {
410 < 1       log(`PROBE: ${name} left behind — rm ${name} answered non-zero`)
411 < 1     }
412 < 1     exit = 2
413 < 1   }
414 < 1 
415 < 1   return { exit, stamp, results }
416 < 1 }
