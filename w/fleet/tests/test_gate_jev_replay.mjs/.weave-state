0 < 2 // The gate Jev replay's scoring (#1528): which rounds are replayed, how they are scored, the exit code
1 < 2 // and the summary line. Pure: no spawn, no file reads.
2 < 1 import assert from 'node:assert/strict'
3 < 1 import { exitCode, replayRounds, score, summary } from './_gate_replay_helpers.mjs'
4 < 1 
5 < 1 const rec = {
6 < 1   tasks: {
7 < 1     1: {
8 < 1       gate_rounds: [
9 < 1         { agent: 'pass', jev: 'fail', right: 'agent' },
10 < 1         { agent: 'pass', jev: 'fail', right: 'jev' },
11 < 1         { agent: 'fail', jev: 'fail' },
12 < 1         { agent: 'pass', jev: 'pass' },
13 < 1         { agent: 'pass', jev: 'fail' },
14 < 1         { agent: 'fail', jev: 'pass', right: 'agent' },
15 < 1       ],
16 < 1     },
17 < 1     2: { gate_rounds: [{ agent: 'fail', jev: null }] },
18 < 1   },
19 < 1 }
20 < 1 const items = replayRounds(rec)
21 < 1 assert.deepEqual(items.map((x) => [x.task, x.round, x.side]),
22 < 1   [['1', 1, 'wrong'], ['1', 2, 'right'], ['1', 3, 'agreed'], ['1', 6, 'other']])
23 < 1 
24 < 1 const byRound = { 1: ['pass', 'pass', 'fail'], 2: ['fail'], 3: ['pass', 'pass', 'fail'], 6: ['fail'] }
25 < 1 const s = score(items, (item) => byRound[item.round])
26 < 1 assert.deepEqual(s, { wrong: 1, wrongPass: 1, right: 1, rightFail: 1, agreed: 1, agreedPass: 1 })
27 < 1 
28 < 1 assert.equal(exitCode(s, true), 1)
29 < 1 assert.equal(exitCode({ ...s, agreedPass: 0 }, true), 0)
30 < 1 assert.equal(exitCode({ ...s, agreedPass: 0 }, false), 1)
32 > 2 // one wrong fail in three now passing is under two thirds; two in three is enough
33 < 1 assert.equal(exitCode({ wrong: 3, wrongPass: 1, agreed: 0, agreedPass: 0 }, true), 1)
34 < 1 assert.equal(exitCode({ wrong: 3, wrongPass: 2, agreed: 0, agreedPass: 0 }, true), 0)
31 < 2 assert.equal(exitCode({ wrong: 3, wrongPass: 1, agreedPass: 0 }, true), 1)
32 < 1 assert.equal(exitCode({ wrong: 0, wrongPass: 0, agreed: 0, agreedPass: 0 }, true), 2)
33 < 1 assert.equal(exitCode({ agreed: 2, agreedPass: 0, wrong: 0, wrongPass: 0 }, true), 0)
34 < 1 
35 < 1 assert.equal(summary(s, '2026-09-29..2026-09-30', true),
36 < 1   'gate-jev replay: n=3 rounds (2026-09-29..2026-09-30), wrong fails now pass 1 of 1, right fails now fail 1 of 1, '
37 < 1   + 'agreed fails now pass 1 of 1, controls ok')
38 < 1 
39 < 1 console.log('ALL TESTS PASSED')
40 < 1 