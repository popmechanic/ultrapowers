0 < 1 #!/usr/bin/env node
1 < 2 // The Jev calls probe: the authoring checks (`skills/ultrawrite/stories/jev_checks.ts`) send each
2 < 2 // question the evidence its answer turns on, send the store once, batch what shares a state and
3 < 2 // ride the same client the fleet uses. It copies `skills/ultrawrite/catalog/todo-tags` (2 pieces,
4 < 2 // 5 actions, 1 link) to a temp dir and runs the checks against a local stand-in Jev (a node:http
5 < 2 // server on 127.0.0.1) that answers every asked key {noul: 0.5} and records each request's headers
6 < 2 // and body. The case is argv[2], the stage run:
7 < 2 //   bundle         the store goes once (5 questions), pieces are compared in one request (2
8 < 2 //                  entries), near-miss requests carry story_steps, the link request carries the
9 < 2 //                  summary, every request carries the key as a bearer header, and product.json
10 < 2 //                  saves 5 branches_on_text readings;
11 < 2 //   map            every request carries other_purposes (1 entry) and no top-level purpose;
12 < 2 //   decompose      every request carries a non-empty summary and a built_before array;
13 < 2 //   understanding  one request carries sentences (2 entries) with 2 questions.
14 < 2 // Prints `JEV CALLS <case> OK` and exits 0, or names what differed and exits 1.
15 < 1 import { spawn } from 'node:child_process'
16 < 1 import fs from 'node:fs'
17 < 1 import http from 'node:http'
18 < 1 import os from 'node:os'
19 < 1 import path from 'node:path'
20 < 1 import { fileURLToPath } from 'node:url'
21 < 1 
22 < 1 const CASE = process.argv[2]
23 < 1 if (!['bundle', 'map', 'decompose', 'understanding'].includes(CASE)) {
24 < 1   console.log('usage: jev_calls_probe.mjs bundle|map|decompose|understanding'); process.exit(2)
25 < 1 }
26 < 1 const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..')
27 < 1 const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'jev-calls-'))
28 < 1 const COPY = path.join(tmp, 'todo-tags')
29 < 1 const HOME = path.join(tmp, 'home')
30 < 1 fs.cpSync(path.join(REPO, 'skills/ultrawrite/catalog/todo-tags'), COPY, { recursive: true })
31 < 1 fs.mkdirSync(HOME)
32 < 1 fs.writeFileSync(path.join(HOME, 'typesafe.env'), 'TYPESAFE_API_KEY=fake-key\n')
33 < 1 
34 < 1 let server
35 < 1 const fail = (why) => { console.log(`JEV CALLS ${CASE} FAILED: ${why}`); server?.close(); process.exit(1) }
36 < 1 
37 < 2 // the stand-in Jev
38 < 1 const requests = []
39 < 1 server = http.createServer((req, res) => {
40 < 1   let body = ''
41 < 1   req.on('data', (c) => { body += c })
42 < 1   req.on('end', () => {
43 < 1     if (req.method !== 'POST' || req.url !== '/v1/systemone') { res.writeHead(404); res.end(); return }
44 < 1     let json = {}
45 < 1     try { json = JSON.parse(body) } catch {}
46 < 1     requests.push({ headers: req.headers, body: json })
47 < 1     const answers = Object.fromEntries(Object.keys(json.questions || {}).map((k) => [k, { noul: 0.5 }]))
48 < 1     res.writeHead(200, { 'content-type': 'application/json' }); res.end(JSON.stringify({ answers }))
49 < 1   })
50 < 1 })
51 < 1 await new Promise((r) => server.listen(0, '127.0.0.1', r))
52 < 1 
53 < 1 const run = await new Promise((resolve) => {
54 < 1   const p = spawn('bun', [path.join(REPO, 'skills/ultrawrite/stories/jev_checks.ts'), COPY, '--stage', CASE], {
55 < 1     cwd: REPO,
56 < 1     env: { ...process.env, TYPESAFE_BASE_URL: `http://127.0.0.1:${server.address().port}`, ULTRAPOWERS_HOME: HOME },
57 < 1   })
58 < 1   let out = ''
59 < 1   p.stdout.on('data', (c) => { out += c })
60 < 1   p.stderr.on('data', (c) => { out += c })
61 < 1   p.on('close', (code) => resolve({ code, out }))
62 < 1 })
63 < 1 if (run.code !== 0) fail(`jev_checks exited ${run.code}:\n${run.out}`)
64 < 1 if (!requests.length) fail(`the stand-in received no request:\n${run.out}`)
65 < 1 
66 < 1 const states = requests.map((r) => r.body.state || {})
67 < 1 const nq = (r) => Object.keys(r.body.questions || {}).length
68 < 1 const has = (k) => requests.filter((r) => r.body.state && Object.hasOwn(r.body.state, k))
69 < 1 
70 < 1 if (CASE === 'bundle') {
71 < 1   const store = has('store_module')
72 < 1   if (store.length !== 1) fail(`${store.length} request(s) carry store_module, expected 1`)
73 < 1   if (nq(store[0]) !== 5) fail(`the store request asks ${nq(store[0])} question(s), expected 5`)
74 < 1   const pieces = has('pieces')
75 < 1   if (pieces.length !== 1) fail(`${pieces.length} request(s) carry pieces, expected 1`)
76 < 1   if (!Array.isArray(pieces[0].body.state.pieces) || pieces[0].body.state.pieces.length !== 2) fail('the pieces request does not carry 2 entries')
77 < 1   const near = has('near_miss')
78 < 1   if (!near.length) fail('no request carries near_miss')
79 < 1   for (const r of near) {
80 < 1     if (!Array.isArray(r.body.state.story_steps) || !r.body.state.story_steps.length) fail('a near_miss request carries no story_steps')
81 < 1   }
82 < 1   const link = has('link')
83 < 1   if (!link.length) fail('no request carries link')
84 < 1   for (const r of link) {
85 < 1     if (typeof r.body.state.summary !== 'string' || !r.body.state.summary) fail('a link request carries no summary string')
86 < 1   }
87 < 1   for (const r of requests) {
88 < 1     if (r.headers.authorization !== 'Bearer fake-key') fail(`a request carries authorization ${JSON.stringify(r.headers.authorization)}`)
89 < 1   }
90 < 1   const product = JSON.parse(fs.readFileSync(path.join(COPY, 'product.json'), 'utf8'))
91 < 1   const n = (product.readings || []).filter((x) => x.question === 'branches_on_text').length
92 < 1   if (n !== 5) fail(`product.json holds ${n} branches_on_text reading(s), expected 5`)
93 < 1 } else if (CASE === 'map') {
94 < 1   for (const s of states) {
95 < 1     if (!Array.isArray(s.other_purposes) || s.other_purposes.length !== 1) fail(`a map request carries other_purposes ${JSON.stringify(s.other_purposes)}`)
96 < 1     if (Object.hasOwn(s, 'purpose')) fail('a map request carries a top-level purpose')
97 < 1   }
98 < 1 } else if (CASE === 'decompose') {
99 < 1   for (const s of states) {
100 < 1     if (typeof s.summary !== 'string' || !s.summary) fail('a decompose request carries no summary string')
101 < 1     if (!Array.isArray(s.built_before)) fail('a decompose request carries no built_before array')
102 < 1   }
103 < 1 } else {
104 < 1   const sent = has('sentences')
105 < 1   if (sent.length !== 1) fail(`${sent.length} request(s) carry sentences, expected 1`)
106 < 1   if (!Array.isArray(sent[0].body.state.sentences) || sent[0].body.state.sentences.length !== 2) fail('the sentences request does not carry 2 entries')
107 < 1   if (nq(sent[0]) !== 2) fail(`the sentences request asks ${nq(sent[0])} question(s), expected 2`)
108 < 1 }
109 < 1 server.close()
110 < 1 console.log(`JEV CALLS ${CASE} OK`)
111 < 1 process.exit(0)
112 < 1 