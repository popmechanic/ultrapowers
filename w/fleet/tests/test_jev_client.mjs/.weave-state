0 < 1 /**
1 < 1  * fleet/tests/test_jev_client.mjs — the exam for Task 1: *the Jev client* —
2 < 1  * one POST at the edge hostname, `null` on any failure.
3 < 1  *
4 < 2  * This file is the Proof's `Test:`, written whole at the path the Proof names.
5 < 1  * Every relative import is written for THIS directory: `../` is the
6 < 1  * repository's `fleet/`, `./` is `fleet/tests/`.
7 < 1  *
8 < 1  * Legs (c) through (g) and this header's M3 through M7 paragraphs examined
9 < 1  * the old engine's `jev:` seam (`runEngine`, `runMain`, the rig, the old
10 < 1  * boot's env lines, `fleet/CONTRACT.md`) — every one of them needed the old
11 < 1  * rig, the old engine, `run-main` or `sandbox-boot.sh`, all of which left the
12 < 1  * tree with the old engine (*the old engine leaves the tree, and the factory
13 < 1  * clones at base with its own code*). What is left is what examines
14 < 1  * `factory/jev-client.mjs` alone: its exports, its constants, its one call, and
15 < 1  * that every failure is `null` and one log line.
16 < 1  *
17 < 1  * The Machine clauses under test, restated so a reader can map every assertion
18 < 1  * back to the contract:
19 < 1  *
20 < 1  *   M1 — `factory/jev-client.mjs` exports `JEV_PATH` = `/v1/systemone`,
21 < 1  *        `JEV_MODEL` = `jev-latest`, `JEV_TIMEOUT_MS` = `10000`,
22 < 1  *        `JEV_STATE_MAX_BYTES` = `120000`, and `makeJevClient({ baseUrl,
23 < 1  *        fetchImpl = globalThis.fetch, timeoutMs = JEV_TIMEOUT_MS, log = () =>
24 < 1  *        {} })` returning `{ ask }`. `ask({ state, questions })` calls
25 < 1  *        `fetchImpl` EXACTLY ONCE, first argument the `baseUrl` stripped of
26 < 1  *        trailing slashes plus `/v1/systemone`, second argument an init whose
27 < 1  *        `method` is `POST`, whose `headers` carry a key lowercasing to
28 < 1  *        `content-type` with value `application/json` and NO key lowercasing
29 < 1  *        to `authorization`, whose `body` parses to an object with exactly the
30 < 1  *        keys `state`, `model`, `questions` and `model` `jev-latest`, and
31 < 1  *        whose `signal` is an `AbortSignal`; and it resolves to the reply's
32 < 1  *        `answers` object when the status is 200–299 and the body parses as
33 < 1  *        JSON carrying an `answers` object.
34 < 1  *   M2 — `ask` resolves `null`, NEVER rejects, and calls `log` exactly once
35 < 1  *        with a string beginning `jev:` for each of: a status outside 200–299;
36 < 1  *        a `fetchImpl` that rejects (an `AbortError` included); a body that is
37 < 1  *        not JSON or carries no `answers` object; and a `state` whose
38 < 1  *        `JSON.stringify` length exceeds `JEV_STATE_MAX_BYTES`, for which
39 < 1  *        `fetchImpl` is not called at all.
40 < 1  *
41 < 1  * The legs, in the order they run here:
42 < 1  *
43 < 1  *   (a) [M1] the four constants and the one green call.
44 < 1  *   (b) [M2] the five failures, plus a `fetchImpl` that throws synchronously.
45 < 1  *
46 < 1  * Nothing here opens a socket. The client is reached only through an injected
47 < 1  * `fetchImpl` whose reply carries the two members `httpTransport` reads —
48 < 1  * `status` and `text()`.
49 < 1  */
50 < 1 import assert from 'node:assert/strict'
51 < 1 
52 < 1 /** The deliverable, imported dynamically: a tree without it reports the ABSENT
53 < 1  *  MODULE as an assertion of leg (a) rather than dying at load with no leg
54 < 1  *  named at all. */
55 < 1 let jev = null
56 < 1 let jevImportError = null
57 < 1 try {
58 < 1   jev = await import('../../factory/jev-client.mjs')
59 < 1 } catch (error) {
60 < 1   jevImportError = error
61 < 1 }
62 < 1 assert.ok(jevImportError === null,
63 < 1   '(a) [M1] `factory/jev-client.mjs` is importable — the module this task creates. Got: ' +
64 < 1   String(jevImportError && (jevImportError.message || jevImportError)))
65 < 1 assert.equal(typeof jev.makeJevClient, 'function',
66 < 1   '(a) [M1] it exports `makeJevClient({ baseUrl, fetchImpl, timeoutMs, log })`; got ' +
67 < 1   JSON.stringify(typeof jev.makeJevClient))
68 < 1 
69 < 1 // ══════════════════════════════════════════════════════════════════════════
70 < 1 // (a) [M1] the four constants, and the one call a green answer makes
71 < 1 // ══════════════════════════════════════════════════════════════════════════
72 < 1 
73 < 1 assert.equal(jev.JEV_PATH, '/v1/systemone',
74 < 1   '(a) [M1] `JEV_PATH` is `/v1/systemone` — the edge\'s one endpoint; got ' +
75 < 1   JSON.stringify(jev.JEV_PATH))
76 < 1 assert.equal(jev.JEV_MODEL, 'jev-latest',
77 < 1   '(a) [M1] `JEV_MODEL` is `jev-latest`; got ' + JSON.stringify(jev.JEV_MODEL))
78 < 1 assert.equal(jev.JEV_TIMEOUT_MS, 10000,
79 < 1   '(a) [M1] `JEV_TIMEOUT_MS` is 10000; got ' + JSON.stringify(jev.JEV_TIMEOUT_MS))
80 < 1 assert.equal(jev.JEV_STATE_MAX_BYTES, 120000,
81 < 1   '(a) [M1] `JEV_STATE_MAX_BYTES` is 120000 — the state budget, on the state\'s own ' +
82 < 1   'JSON; got ' + JSON.stringify(jev.JEV_STATE_MAX_BYTES))
83 < 1 
84 < 1 /** The reply shape a sim hands back: what `httpTransport` reads of a response,
85 < 1  *  and nothing else — `status` and `text()`. */
86 < 1 const reply = (status, body) => ({ status, text: async () => String(body) })
87 < 1 
88 < 1 /** A `fetchImpl` that records every call's two arguments and answers with
89 < 1  *  `answer(argv)` — which may return a promise, reject, or throw outright. */
90 < 1 const recordingFetch = (answer) => {
91 < 1   const calls = []
92 < 1   return { calls, fetchImpl: (...argv) => { calls.push(argv); return answer(argv) } }
93 < 1 }
94 < 1 
95 < 1 /** `[name, value]` pairs of a headers container, whatever the shape: M1 says
96 < 1  *  "a key that lowercases to `content-type`", so the exam reads a plain
97 < 1  *  object, a `Map`, a pair array and a `Headers` alike rather than pinning
98 < 1  *  one of them. */
99 < 1 const headerEntries = (headers) => {
100 < 1   if (!headers) return []
101 < 1   if (typeof headers.entries === 'function') return [...headers.entries()]
102 < 1   if (Array.isArray(headers)) return headers.map((pair) => [pair[0], pair[1]])
103 < 1   return Object.entries(headers)
104 < 1 }
105 < 1 const headerValue = (headers, name) => {
106 < 1   const hit = headerEntries(headers).find(([k]) => String(k).toLowerCase() === name)
107 < 1   return hit === undefined ? null : String(hit[1])
108 < 1 }
109 < 1 const headerNames = (headers) => headerEntries(headers).map(([k]) => String(k).toLowerCase())
110 < 1 
111 < 1 const GREEN_BODY = '{"model":"jev-1.13.0","answers":{"q":{"type":"noul","noul":0.9}},' +
112 < 1   '"usage":{"input_tokens":1,"output_tokens":1}}'
113 < 1 const QUESTIONS = { q: { type: 'noul', instructions: 'x' } }
114 < 1 const STATE = { s: 1 }
115 < 1 const WANT_URL = 'https://jev.invalid/v1/systemone'
116 < 1 
117 < 1 {
118 < 1   const { calls, fetchImpl } = recordingFetch(async () => reply(200, GREEN_BODY))
119 < 1   const logs = []
120 < 1   const client = jev.makeJevClient({ baseUrl: 'https://jev.invalid/', fetchImpl,
121 < 1     log: (l) => logs.push(l) })
122 < 1   assert.equal(typeof client.ask, 'function',
123 < 1     '(a) [M1] `makeJevClient(...)` returns `{ ask }`; got ' + JSON.stringify(Object.keys(client)))
124 < 1 
125 < 1   const answers = await client.ask({ state: STATE, questions: QUESTIONS })
126 < 1   assert.deepEqual(answers, { q: { type: 'noul', noul: 0.9 } },
127 < 1     '(a) [M1] a 200 whose body carries an `answers` object resolves to THAT object — ' +
128 < 1     'the reply\'s `answers`, not the reply; got ' + JSON.stringify(answers))
129 < 1 
130 < 1   assert.equal(calls.length, 1,
131 < 1     '(a) [M1] `ask` calls `fetchImpl` exactly once — one POST, no retry; got ' + calls.length)
132 < 1   const [url, init] = calls[0]
133 < 1   assert.equal(url, WANT_URL,
134 < 1     '(a) [M1] the first argument is the baseUrl stripped of trailing slashes plus ' +
135 < 1     '`/v1/systemone` — `' + WANT_URL + '`; got ' + JSON.stringify(url))
136 < 1   assert.ok(init && typeof init === 'object',
137 < 1     '(a) [M1] the second argument is the request init; got ' + JSON.stringify(init))
138 < 1   assert.equal(init.method, 'POST',
139 < 1     '(a) [M1] its `method` is `POST`; got ' + JSON.stringify(init.method))
140 < 1   assert.equal(headerValue(init.headers, 'content-type'), 'application/json',
141 < 1     '(a) [M1] its headers carry a key lowercasing to `content-type` with value ' +
142 < 1     '`application/json`; got ' + JSON.stringify(headerEntries(init.headers)))
143 < 1   assert.equal(headerNames(init.headers).includes('authorization'), false,
144 < 1     '(a) [M1] and NO key lowercasing to `authorization` — the edge injects the bearer, ' +
145 < 1     'the box never holds it; got ' + JSON.stringify(headerNames(init.headers)))
146 < 1   let sent = null
147 < 1   try { sent = JSON.parse(String(init.body)) } catch { sent = null }
148 < 1   assert.ok(sent && typeof sent === 'object' && !Array.isArray(sent),
149 < 1     '(a) [M1] its `body` parses to an object; got ' + JSON.stringify(init.body))
150 < 1   assert.deepEqual(Object.keys(sent).sort(), ['model', 'questions', 'state'],
151 < 1     '(a) [M1] with exactly the keys `state`, `model`, `questions`, in any order; got ' +
152 < 1     JSON.stringify(Object.keys(sent)))
153 < 1   assert.equal(sent.model, 'jev-latest',
154 < 1     '(a) [M1] whose `model` is `jev-latest`; got ' + JSON.stringify(sent.model))
155 < 1   assert.deepEqual(sent.state, STATE,
156 < 1     '(a) [M1] whose `state` is the state it was handed; got ' + JSON.stringify(sent.state))
157 < 1   assert.deepEqual(sent.questions, QUESTIONS,
158 < 1     '(a) [M1] and whose `questions` are the questions it was handed; got ' +
159 < 1     JSON.stringify(sent.questions))
160 < 1   assert.ok(init.signal instanceof AbortSignal,
161 < 1     '(a) [M1] its `signal` is an `AbortSignal` — the timeout, on the call itself; got ' +
162 < 1     Object.prototype.toString.call(init.signal))
163 < 1   assert.deepEqual(logs, [],
164 < 1     '(a) [M1] an answered call is no log line at all; got ' + JSON.stringify(logs))
165 < 1 }
166 < 1 
167 < 1 {
168 < 1   // The same URL from a baseUrl with no trailing slash: "stripped of trailing
169 < 1   // slashes" is the rule, not "one slash removed".
170 < 1   const { calls, fetchImpl } = recordingFetch(async () => reply(200, GREEN_BODY))
171 < 1   await jev.makeJevClient({ baseUrl: 'https://jev.invalid', fetchImpl })
172 < 1     .ask({ state: STATE, questions: QUESTIONS })
173 < 1   assert.equal(calls.length === 1 ? calls[0][0] : null, WANT_URL,
174 < 1     '(a) [M1] a baseUrl with no trailing slash reaches the same URL — `' + WANT_URL +
175 < 1     '`; got ' + JSON.stringify(calls.map((c) => c[0])))
176 < 1 }
177 < 1 
178 < 1 // ══════════════════════════════════════════════════════════════════════════
179 < 1 // (b) [M2] every failure is `null` and ONE log line — and never a rejection
180 < 1 // ══════════════════════════════════════════════════════════════════════════
181 < 1 
182 < 1 /** One `ask` against one canned answer, with its own log sink. Never rethrows:
183 < 1  *  whether `ask` rejected is itself an assertion below. */
184 < 1 const askWith = async ({ answer, state = STATE }) => {
185 < 1   const logs = []
186 < 1   const { calls, fetchImpl } = recordingFetch(answer)
187 < 1   const client = jev.makeJevClient({ baseUrl: 'https://jev.invalid', fetchImpl,
188 < 1     log: (l) => logs.push(l) })
189 < 1   let value = 'UNSET'
190 < 1   let threw = null
191 < 1   try { value = await client.ask({ state, questions: QUESTIONS }) } catch (error) { threw = error }
192 < 1   return { value, threw, logs, calls }
193 < 1 }
194 < 1 
195 < 1 const abortError = () => {
196 < 1   const error = new Error('The operation was aborted')
197 < 1   error.name = 'AbortError'
198 < 1   return error
199 < 1 }
200 < 1 
201 < 1 const FAILURES = [
202 < 1   { tag: 'a status outside 200–299 (500, with a JSON body)',
203 < 1     answer: async () => reply(500, '{"error":"boom"}') },
204 < 1   { tag: 'a `fetchImpl` that rejects with an `AbortError` — the timeout lane',
205 < 1     answer: async () => { throw abortError() } },
206 < 1   { tag: 'a 200 whose body is not JSON', answer: async () => reply(200, 'not json') },
207 < 1   { tag: 'a 200 whose body carries no `answers` object',
208 < 1     answer: async () => reply(200, '{"model":"x","usage":{}}') },
209 < 1 ]
210 < 1 
211 < 1 for (const failure of FAILURES) {
212 < 1   const { value, threw, logs, calls } = await askWith({ answer: failure.answer })
213 < 1   assert.equal(threw, null,
214 < 1     '(b) [M2] ' + failure.tag + ': `ask` never rejects. It threw: ' +
215 < 1     String(threw && (threw.stack || threw.message || threw)))
216 < 1   assert.equal(value, null,
217 < 1     '(b) [M2] ' + failure.tag + ': `ask` resolves `null`; got ' + JSON.stringify(value))
218 < 1   assert.equal(logs.length, 1,
219 < 1     '(b) [M2] ' + failure.tag + ': exactly one log line — a failed call is one log line ' +
220 < 1     'and no row. Got ' + JSON.stringify(logs))
221 < 1   assert.equal(typeof logs[0], 'string',
222 < 1     '(b) [M2] ' + failure.tag + ': that line is a string; got ' + JSON.stringify(logs[0]))
223 < 1   assert.ok(String(logs[0]).startsWith('jev:'),
224 < 1     '(b) [M2] ' + failure.tag + ': and it begins `jev:`; got ' + JSON.stringify(logs[0]))
225 < 1   assert.equal(calls.length, 1,
226 < 1     '(b) [M2] ' + failure.tag + ': one call was made and never retried; got ' + calls.length)
227 < 1 }
228 < 1 
229 < 1 {
230 < 1   // The budget, checked on the state's own JSON BEFORE any call.
231 < 1   const overBudget = 'x'.repeat(120001)
232 < 1   const { value, threw, logs, calls } = await askWith({
233 < 1     answer: async () => reply(200, GREEN_BODY), state: overBudget,
234 < 1   })
235 < 1   assert.equal(threw, null,
236 < 1     '(b) [M2] an over-budget state: `ask` never rejects. It threw: ' +
237 < 1     String(threw && (threw.stack || threw.message || threw)))
238 < 1   assert.equal(value, null,
239 < 1     '(b) [M2] an over-budget state (`JSON.stringify` longer than `JEV_STATE_MAX_BYTES`) ' +
240 < 1     'resolves `null`; got ' + JSON.stringify(value))
241 < 1   assert.equal(logs.length, 1,
242 < 1     '(b) [M2] with exactly one log line; got ' + JSON.stringify(logs))
243 < 1   assert.ok(String(logs[0]).startsWith('jev:'),
244 < 1     '(b) [M2] beginning `jev:`; got ' + JSON.stringify(logs[0]))
245 < 1   assert.equal(calls.length, 0,
246 < 1     '(b) [M2] and `fetchImpl` was not called AT ALL — the budget is checked before the ' +
247 < 1     'call; got ' + calls.length + ' call(s)')
248 < 1 }
249 < 1 
250 < 1 {
251 < 1   // A seam that throws synchronously is the same lane: `ask` resolves `null`.
252 < 1   const { value, threw } = await askWith({ answer: () => { throw new Error('sync boom') } })
253 < 1   assert.equal(threw, null,
254 < 1     '(b) [M2] a `fetchImpl` that throws SYNCHRONOUSLY: `ask` still never rejects. It threw: ' +
255 < 1     String(threw && (threw.stack || threw.message || threw)))
256 < 1   assert.equal(value, null,
257 < 1     '(b) [M2] a `fetchImpl` that throws synchronously also resolves `null`; got ' +
258 < 1     JSON.stringify(value))
259 < 1 }
260 < 1 
261 < 1 console.log('ALL TESTS PASSED')
