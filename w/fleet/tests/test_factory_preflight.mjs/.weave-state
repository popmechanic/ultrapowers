0 < 1 /**
1 < 1  * fleet/tests/test_factory_preflight.mjs — the exam for "the credential probe
2 < 1  * answers each of the six things the edge can say with one exact line,
4 > 1  * examined by a rig that can answer it; and the probe runs when called
5 < 1  * through a symlinked `factory/`."
3 < 2  * examined by a rig that can answer it; and the probe and the audit each run
4 < 2  * when called through a symlinked `factory/`, where before the audit
5 < 2  * silently did nothing."
6 < 1  *
7 < 1  * Legs, each naming the Machine clause it comes from:
8 < 1  *
9 < 1  *   (a) [M1] `node factory/preflight.mjs --proxy <U>` prints exactly one of
10 < 1  *       the six lines the edge can say and exits 0 — `alive` (oauth_token +
11 < 1  *       usage 200), `api_key`, `no_oauth` (neither word), `inconclusive`
12 < 1  *       (usage 403 with `oauth_scope_insufficient`, and again over 500),
13 < 1  *       `bearer_dead 401 <message>` (a 401 with a `"type":"error"` JSON body
14 < 1  *       carrying a `message`), and `edge_refused 401 <first line>` (a 401
15 < 1  *       with a plain body starting `integration not found`).
17 > 1  *   (b) retired with `factory/audit.mjs` (2026-11-13: its one row listed the kata closes a run
18 < 1  *       missed, and no run has a board to close).
16 < 2  *   (b) [M2] `node <D>/factory/audit.mjs <events> done`, through a
17 < 2  *       symlinked `<D>/factory`, prints exactly one line parsing to an
18 < 2  *       object whose `kind` is `run:audit`, `state` is `done` and `ts` is a
19 < 2  *       non-empty string, and exits 0.
20 < 1  *   (c) [M3] `node <D>/factory/preflight.mjs --proxy <U>`, through the same
21 < 1  *       link, with an `oauth_token` auth answer and a 200 usage answer,
22 < 1  *       prints exactly `alive\n` and exits 0.
23 < 1  *
24 < 1  * M4 is the Proof's `Run:` lines against the modules' own text, not
25 < 1  * something a running exam observes — this file does not touch it.
26 < 1  *
27 < 1  * The rig: one `node:http` server on `127.0.0.1` port `0`, in this process,
28 < 1  * answers `/api/oauth/usage` with whatever `{ code, body }` the current case
29 < 1  * set (mutated between cases, since every case is awaited to completion
30 < 1  * before the next one runs — no two cases are ever in flight together). The
31 < 1  * `claude` stub is a `#!/bin/sh` script, mode `0755`, first on the child's
32 < 1  * `PATH`, that `cat`s an `auth.txt` file the case writes ahead of the run
33 < 1  * with one of `authMethod: oauth_token`, `authMethod: api_key` or
35 > 1  * `authMethod: none`. Every child
34 < 2  * `authMethod: none`. Every child — `preflight.mjs` and `audit.mjs` alike —
35 < 1  * is driven by `runAsync`, which `spawn`s (never `spawnSync`, which would
36 < 1  * block the event loop the proxy stub server runs on) and awaits the close
37 < 1  * event, `env: simEnv({ bin, home })` throughout. Every directory this file
38 < 1  * writes into sits under a fresh `fs.mkdtempSync` under `os.tmpdir()`; no
39 < 1  * string-literal absolute path appears anywhere below.
40 < 1  *
41 < 1  * What this exam assumes about the modules under test: that `classify`'s
42 < 1  * decision is reachable only through the CLI's one printed line (the
43 < 1  * Machine clause and the "For the examiner" note both drive it that way,
44 < 1  * never by importing `classify` in-process); that `preflight.mjs`'s `main`
45 < 1  * takes the argv already sliced past the node/script pair, so spawning it
46 < 1  * with `[PREFLIGHT, '--proxy', url]` as the child's own argv is the same
48 > 1  * call `factory/boot.sh` makes. The assumption does not reach past what the
47 < 2  * call `factory/boot.sh` makes; and that `audit.mjs`'s `main` slices
48 < 2  * `process.argv` itself, so spawning it with `[AUDIT, eventsPath, 'done']`
49 < 2  * is likewise the direct call. Neither assumption reaches past what the
50 < 1  * task's own Context and "For the examiner" section already state.
51 < 1  */
52 < 1 
53 < 1 import assert from 'node:assert/strict'
54 < 1 import fs from 'node:fs'
55 < 1 import os from 'node:os'
56 < 1 import path from 'node:path'
57 < 1 import http from 'node:http'
58 < 1 import { spawn } from 'node:child_process'
59 < 1 import { fileURLToPath } from 'node:url'
60 < 1 
61 < 1 import { simEnv } from './_helpers.mjs'
62 < 1 
63 < 1 const HERE = path.dirname(fileURLToPath(import.meta.url))
64 < 1 const REPO_ROOT = path.resolve(HERE, '../..')
65 < 1 const FACTORY_DIR = path.join(REPO_ROOT, 'factory')
66 < 1 const PREFLIGHT = path.join(FACTORY_DIR, 'preflight.mjs')
67 < 1 
68 < 1 /** Writes an executable `#!/bin/sh` stub into `dir/name`. */
69 < 1 function writeStub (dir, name, content) {
70 < 1   const p = path.join(dir, name)
71 < 1   fs.writeFileSync(p, content)
72 < 1   fs.chmodSync(p, 0o755)
73 < 1 }
74 < 1 
75 < 1 /** Runs `node <argv[0]> ...argv.slice(1)` as a real child, asynchronously —
76 < 1  *  the whole reason this rig exists rather than `spawnSync`: the in-process
77 < 1  *  proxy stub server below can only answer a child that does not block this
78 < 1  *  event loop. Resolves once the child's `close` event fires. */
79 < 1 async function runAsync (argv, { bin, home } = {}) {
80 < 1   const child = spawn(process.execPath, argv, {
81 < 1     env: simEnv({ bin, home }),
82 < 1     stdio: ['ignore', 'pipe', 'pipe'],
83 < 1   })
84 < 1   let stdout = ''
85 < 1   let stderr = ''
86 < 1   child.stdout.on('data', (d) => { stdout += d })
87 < 1   child.stderr.on('data', (d) => { stderr += d })
88 < 1   const code = await new Promise((resolve) => child.on('close', resolve))
89 < 1   return { code, stdout, stderr }
90 < 1 }
91 < 1 
92 < 1 // ── the in-process proxy stub ────────────────────────────────────────────
93 < 1 
94 < 1 /** The `/api/oauth/usage` answer the current case wants; mutated between
95 < 1  *  cases, each of which is awaited to completion before the next mutates it. */
96 < 1 let usageAnswer = { code: 200, body: '{}' }
97 < 1 
98 < 1 const proxyServer = http.createServer((req, res) => {
99 < 1   if (req.url === '/api/oauth/usage') {
100 < 1     res.writeHead(usageAnswer.code, { 'Content-Type': 'application/json' })
101 < 1     res.end(usageAnswer.body)
102 < 1     return
103 < 1   }
104 < 1   res.writeHead(404, { 'Content-Type': 'text/plain' })
105 < 1   res.end('not found')
106 < 1 })
107 < 1 await new Promise((resolve) => proxyServer.listen(0, '127.0.0.1', resolve))
108 < 1 const PROXY_URL = `http://127.0.0.1:${proxyServer.address().port}`
109 < 1 
110 < 1 // ── (a) [M1] the six answers the edge can give ───────────────────────────
111 < 1 
112 < 1 {
113 < 1   const root = fs.mkdtempSync(path.join(os.tmpdir(), 'fleet-preflight-m1-'))
114 < 1   const home = path.join(root, 'home')
115 < 1   const bin = path.join(root, 'bin')
116 < 1   fs.mkdirSync(home, { recursive: true })
117 < 1   fs.mkdirSync(bin, { recursive: true })
118 < 1 
119 < 1   const authFile = path.join(home, 'auth.txt')
120 < 1   // The stub `cat`s whatever the case last wrote to authFile — written once,
121 < 1   // reused across every case below, since the cases run strictly in turn.
122 < 1   writeStub(bin, 'claude', `#!/bin/sh\ncat "${authFile}"\n`)
123 < 1 
124 < 1   const CASES = [
125 < 1     {
126 < 1       label: 'oauth_token + usage 200',
127 < 1       auth: 'authMethod: oauth_token',
128 < 1       usage: { code: 200, body: '{}' },
129 < 1       expected: 'alive\n',
130 < 1     },
131 < 1     {
132 < 1       label: 'api_key',
133 < 1       auth: 'authMethod: api_key',
134 < 1       usage: { code: 200, body: '{}' },
135 < 1       expected: 'api_key\n',
136 < 1     },
137 < 1     {
138 < 1       label: 'neither word',
139 < 1       auth: 'authMethod: none',
140 < 1       usage: { code: 200, body: '{}' },
141 < 1       expected: 'no_oauth\n',
142 < 1     },
143 < 1     {
144 < 1       label: 'oauth_token + usage 403 oauth_scope_insufficient',
145 < 1       auth: 'authMethod: oauth_token',
146 < 1       usage: { code: 403, body: '{"type":"error","error":{"type":"oauth_scope_insufficient"}}' },
147 < 1       expected: 'inconclusive\n',
148 < 1     },
149 < 1     {
150 < 1       label: 'oauth_token + usage 500',
151 < 1       auth: 'authMethod: oauth_token',
152 < 1       usage: { code: 500, body: 'internal error' },
153 < 1       expected: 'inconclusive\n',
154 < 1     },
155 < 1     {
156 < 1       label: 'oauth_token + usage 401 JSON "type":"error" carrying message "revoked"',
157 < 1       auth: 'authMethod: oauth_token',
158 < 1       usage: { code: 401, body: '{"type":"error","error":{"type":"authentication_error","message":"revoked"}}' },
159 < 1       expected: 'bearer_dead 401 revoked\n',
160 < 1     },
161 < 1     {
162 < 1       label: 'oauth_token + usage 401 plain body starting "integration not found"',
163 < 1       auth: 'authMethod: oauth_token',
164 < 1       usage: { code: 401, body: 'integration not found: claude-max\ntrace 1' },
165 < 1       expected: 'edge_refused 401 integration not found: claude-max\n',
166 < 1     },
167 < 1   ]
168 < 1 
169 < 1   for (const c of CASES) {
170 < 1     fs.writeFileSync(authFile, c.auth)
171 < 1     usageAnswer = c.usage
172 < 1     const res = await runAsync([PREFLIGHT, '--proxy', PROXY_URL], { bin, home })
173 < 1     assert.equal(
174 < 1       res.code, 0,
175 < 1       `(a) [M1] ${c.label}: preflight.mjs exits 0 — got ${res.code}, stderr: ${res.stderr}`
176 < 1     )
177 < 1     assert.equal(
178 < 1       res.stdout, c.expected,
179 < 1       `(a) [M1] ${c.label}: preflight.mjs prints exactly ${JSON.stringify(c.expected)} — got ${JSON.stringify(res.stdout)}`
180 < 1     )
181 < 1   }
182 < 1 }
183 < 1 
184 < 1 // ── (b), (c) [M2, M3] both entry guards through a symlinked factory/ ────
185 < 1 
186 < 1 {
187 < 1   const linkRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'fleet-preflight-link-'))
188 < 1   const D = path.join(linkRoot, 'D')
189 < 1   fs.mkdirSync(D, { recursive: true })
190 < 1   fs.symlinkSync(FACTORY_DIR, path.join(D, 'factory'), 'dir')
191 < 1 
192 < 2   // "<D>/../ev.jsonl" — one row, exactly.
193 < 2   const eventsPath = path.join(D, '..', 'ev.jsonl')
194 < 2   fs.writeFileSync(eventsPath, `${JSON.stringify({ kind: 'landing', task: 1 })}\n`)
195 < 2 
196 < 2   // ── (b) [M2] audit.mjs through the link ──────────────────────────────
197 < 2   {
198 < 2     const auditHome = path.join(linkRoot, 'audit-home')
199 < 2     fs.mkdirSync(auditHome, { recursive: true })
200 < 2 
201 < 2     const res = await runAsync(
202 < 2       [path.join(D, 'factory', 'audit.mjs'), eventsPath, 'done'],
203 < 2       { home: auditHome }
204 < 2     )
205 < 2 
206 < 2     assert.equal(
207 < 2       res.code, 0,
208 < 2       `(b) [M2] audit.mjs invoked as <D>/factory/audit.mjs through the symlink exits 0 — got ${res.code}, stderr: ${res.stderr}`
209 < 2     )
210 < 2     const trimmed = res.stdout.trim()
211 < 2     assert.ok(
212 < 2       trimmed.length > 0,
213 < 2       '(b) [M2] audit.mjs through the symlink prints a non-empty line — before the fix, main() never ran and nothing was printed'
214 < 2     )
215 < 2     const outLines = trimmed.split('\n')
216 < 2     assert.equal(
217 < 2       outLines.length, 1,
218 < 2       `(b) [M2] audit.mjs through the symlink prints exactly one line — got ${outLines.length}: ${JSON.stringify(trimmed)}`
219 < 2     )
220 < 2     const parsed = JSON.parse(outLines[0])
221 < 2     assert.equal(parsed.kind, 'run:audit', `(b) [M2] the line's kind is run:audit — got ${JSON.stringify(parsed.kind)}`)
222 < 2     assert.equal(parsed.state, 'done', `(b) [M2] the line's state is done — got ${JSON.stringify(parsed.state)}`)
223 < 2     assert.ok(
224 < 2       typeof parsed.ts === 'string' && parsed.ts.length > 0,
225 < 2       `(b) [M2] the line's ts is a non-empty string — got ${JSON.stringify(parsed.ts)}`
226 < 2     )
227 < 2   }
228 < 2 
229 < 1   // ── (c) [M3] preflight.mjs through the link ──────────────────────────
230 < 1   {
231 < 1     const preflightHome = path.join(linkRoot, 'preflight-home')
232 < 1     const preflightBin = path.join(linkRoot, 'preflight-bin')
233 < 1     fs.mkdirSync(preflightHome, { recursive: true })
234 < 1     fs.mkdirSync(preflightBin, { recursive: true })
235 < 1 
236 < 1     const authFile = path.join(preflightHome, 'auth.txt')
237 < 1     writeStub(preflightBin, 'claude', `#!/bin/sh\ncat "${authFile}"\n`)
238 < 1     fs.writeFileSync(authFile, 'authMethod: oauth_token')
239 < 1     usageAnswer = { code: 200, body: '{}' }
240 < 1 
241 < 1     const res = await runAsync(
242 < 1       [path.join(D, 'factory', 'preflight.mjs'), '--proxy', PROXY_URL],
243 < 1       { bin: preflightBin, home: preflightHome }
244 < 1     )
245 < 1 
246 < 1     assert.equal(
247 < 1       res.code, 0,
248 < 1       `(c) [M3] preflight.mjs invoked as <D>/factory/preflight.mjs through the symlink exits 0 — got ${res.code}, stderr: ${res.stderr}`
249 < 1     )
250 < 1     assert.equal(
251 < 1       res.stdout, 'alive\n',
252 < 1       `(c) [M3] preflight.mjs through the symlink, with oauth_token and a 200 usage answer, prints exactly 'alive\\n' — got ${JSON.stringify(res.stdout)}`
253 < 1     )
254 < 1   }
255 < 1 }
256 < 1 
257 < 1 proxyServer.close()
258 < 1 
259 < 1 console.log('ALL TESTS PASSED')
260 < 1 