236 > 2 // loose-window  the run is green early (task 2's fact holds at base) but its builder is held, so the
237 < 2 //               cleanup opens about 3 s after the first green and takes 2.5 s: past a 4 s window counted
238 < 2 //               from the first green, inside one counted from when it opened. The cleanup lands; no
239 < 2 //               no-progress stop, no fallback (#1531)
240 < 1 test('loose-window', async () => {
241 < 1   const t = flockTarget({ 'a.txt': 'x y z\n', 'b.txt': 'NOTE pending\n' })
242 < 1   const plan = writePlan(t, { claim: 'a.txt and b.txt say what the tasks write.', check: 'test -f a.txt', tasks: [word(1, 'WIPE'), note] })
243 < 1   const r = await flockRun(t, { plan, script: { 1: { 'a.txt': 'x WIPE z\n' }, 2: { 'b.txt': 'NOTE\n' }, 'L:loose': { 'a.txt': 'x WIPE page z\n' },
244 < 1     '@stall_ms': 4000, '@hold_ms': { 2: 2000, 'L:loose': 2500 },
245 < 1     '@beliefs': [{ task: '1', about: 'app', path: 'a.txt', claim: 'a.txt wipes every folder', stale: 'x WIPE z' }] } })
246 < 1   assert(r.rows, `no events.jsonl (engine exit ${r.code}): ${r.out.slice(-1500)}`)
247 < 1   const first = r.of('edge').find((x) => x.green), opened = r.of('loose-task')[0]
248 < 1   assert(first && opened && Date.parse(opened.ts) - Date.parse(first.ts) >= 1500, `expected the cleanup to open well after the first green, saw green ${first?.ts} and loose-task ${opened?.ts}`)
249 < 1   assert(r.of('stall:no-progress').length === 0 && r.of('loose:fallback').length === 0, `expected no stop and no fallback, saw ${JSON.stringify(r.rows.filter((x) => /^stall:|^loose:fallback/.test(x.kind)))}`)
250 < 1   const end = r.of('terminal').at(-1)
251 < 1   assert(end?.pr === 'ready' && end.snap !== opened.snap && r.code === 0, `expected a ready run past the pre-cleanup snapshot ${opened.snap}, saw ${JSON.stringify(r.of('terminal'))} exit ${r.code}`)
252 < 1   assert(t.git('show', 'HEAD:a.txt') === 'x WIPE page z', `the landed a.txt reads ${JSON.stringify(t.git('show', 'HEAD:a.txt'))}`)
253 < 1   t.done()
254 < 1 })
