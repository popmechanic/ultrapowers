361 < 1 test('checker-cannot-run', async () => {
362 < 1   const F = '```'
363 < 1   const PROBE = '{"clause":"S1.1","do":[{"click":{"name":"Add","role":"button"}}],"expect":[{"unchanged":true}],"given":[],"holds_before":true,"judge":null,"layer":"ui","see":[{"count":1,"name":"Add","role":"button"}]}'
364 < 1   const t = flockTarget({ 'note.txt': 'base\n' })
365 < 1   const bin = path.join(t.tmp, 'bin')
366 < 1   fs.mkdirSync(bin)
367 < 1   fs.writeFileSync(path.join(bin, 'bun'), '#!/bin/sh\ncase "$*" in *check.ts*) echo "bun: the checker is missing" >&2; exit 127;; esac\nexit 0\n', { mode: 0o755 })
368 < 1   t.over.PATH = simEnv({ bin, home: t.tmp }).PATH
369 < 1   const plan = path.join(t.tmp, 'plan.md')
370 < 1   fs.writeFileSync(plan, `# Sim plan
371 < 1 
372 < 1 **Grammar:** stories-v1
373 < 1 **Stack:** tinyapp
374 < 1 **Plan-id:** p1
375 < 1 **Kind:** behaviour
376 < 1 **Summary:** One. Two. Three.
377 < 1 **Store:** \`store.js\` sha256:${'0'.repeat(64)}
378 < 1 
379 < 1 ## Stories
380 < 1 
381 < 1 - S1: You add a note; it shows.
382 < 1 
383 < 1 ### Task 1: The note piece
384 < 1 
385 < 1 **Piece:** note
386 < 1 **Depends-on-pieces:** none
387 < 1 
388 < 1 **Files:**
389 < 1 - Create: \`client/src/pieces/note.json\`
390 < 1 
391 < 1 **Purpose:** Keep notes.
392 < 1 
393 < 1 **Stories:**
394 < 1 - S1: You add a note; it shows.
395 < 1 
396 < 1 **Proof:**
397 < 1 ${F}probe
398 < 1 ${PROBE}
399 < 1 ${F}
400 < 1 `)
401 < 1   const r = await flockRun(t, { plan, script: { 1: { 'client/src/pieces/note.json': '{"root":"note","elements":{}}\n' } } })
402 < 1   assert(r.rows, `no events.jsonl (engine exit ${r.code}): ${r.out.slice(-1500)}`)
403 < 1   const tail = `(exit ${r.code}; ${r.out.slice(-600)})`
404 < 1   assert(r.of('checker:start')[0]?.exit === 127, `expected a checker:start row with exit 127, saw ${JSON.stringify(r.of('checker:start'))} ${tail}`)
405 < 1   const ends = r.of('terminal')
406 < 1   assert(ends.length === 1 && ends[0].pr === 'draft' && String(ends[0].why).startsWith('the checker cannot run on this sandbox: '),
407 < 1     `expected one draft terminal row naming the checker, saw ${JSON.stringify(ends)} ${tail}`)
408 < 1   assert(r.of('loose:fallback').length === 0, `expected no loose:fallback, saw ${JSON.stringify(r.of('loose:fallback'))}`)
409 < 1   assert(r.of('builder:open').length === 0, `expected no builder to open, saw ${JSON.stringify(r.of('builder:open'))}`)
410 < 1   t.done()
411 < 1 })
