53 < 1   assert.ok(row.status === 'missing' && row.detail.includes('hub-reaper expired 2026-10-30'), `(b) an expired key is missing and named — got ${JSON.stringify(row)}`)
54 < 1   assert.equal(result.verdict, 'not-ready', '(b) the verdict is not-ready')
