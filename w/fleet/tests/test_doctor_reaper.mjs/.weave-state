72 < 2   assert.ok(forever.row.status === 'ok' && forever.row.detail === 'the key hub-reaper does not expire', `(g) a key with no expiry is ok — got ${JSON.stringify(forever.row)}`)
73 < 1   const unread = await reaperOf({ integrations: [LOBBY_RM], keys: { code: 1, stdout: '' } })
