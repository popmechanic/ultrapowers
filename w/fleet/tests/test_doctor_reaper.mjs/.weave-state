0 < 1 /**
2 > 1  * fleet/tests/test_doctor_reaper.mjs — the doctor's tenth row, `reaper`: the exe.dev key the
1 < 2  * fleet/tests/test_doctor_reaper.mjs — the doctor's eleventh row, `reaper`: the exe.dev key the
2 < 1  * hub removes a finished run's VM with has not expired (the key expired 2026-10-30 and nothing
3 < 1  * said so; on 2026-11-13 the hub answered eight finished VMs and removed none).
4 < 1  *
5 < 1  * Every leg drives `doctor()` through a stub `exec`, with `now` fixed at 2026-11-13T00:00:00Z:
6 < 1  *   (a) no `lobby-rm` integration: ok, the detail saying a finished VM waits for the janitor;
7 < 1  *       `ssh-key list --json` is still read once.
8 < 1  *   (b) `lobby-rm` present, the `hub-reaper` key expired 2026-10-30: missing, the detail naming
9 < 1  *       the key and the day, and the verdict `not-ready`.
10 < 1  *   (c) the key good until 2027-11-01: ok, the detail naming the day and `353 days`.
11 < 1  *   (d) the key good until 2026-11-20: ok, the detail ending `renew it soon`.
12 < 1  *   (e) two keys, one expired and a `hub-reaper-2` that is not: ok on the one that lasts longest.
13 < 1  *   (f) no key named `hub-reaper…`: missing. (g) a key with no expiry: ok, `does not expire`.
14 < 1  *   (h) `ssh-key list --json` answers code 1: missing, the detail naming the code.
16 > 1  *   (i) the hub is listed and its remover answers `invalid token` while the key list shows a key
17 < 1  *       good for a year (2026-11-13's state): missing, the detail naming `bash fleet/reaper-key.sh`;
18 < 1  *       the probe is one `ssh <the hub's ssh_dest> <REAPER_PROBE>`.
19 < 1  *   (j) the remover answers that the VM is not found: ok, the detail saying the remover answered.
20 < 1  *   Legs (c) to (g) list no hub, so their details say the remover was not asked.
15 < 1  */
16 < 1 import assert from 'node:assert/strict'
17 < 1 
19 > 1 import { doctor, REAPER_PROBE } from '../doctor.mjs'
18 < 2 import { doctor } from '../doctor.mjs'
19 < 1 
20 < 1 const keyOf = (cmd, argv = []) => [cmd, ...argv].join(' ')
21 < 1 const lobbyKey = (remote) => keyOf('ssh', ['exe.dev', remote])
22 < 1 const NOW = Date.parse('2026-11-13T00:00:00Z')
23 < 1 const LOBBY_RM = { name: 'lobby-rm', config_summary: 'target=https://exe.dev/ header=Authorization:Bearer ***' }
24 < 1 
26 > 1 function makeExec ({ integrations, keys, probe = null }) {
25 < 2 function makeExec ({ integrations, keys }) {
26 < 1   const calls = []
27 < 1   const exec = async (command, argv) => {
28 < 1     const cmd = keyOf(command, argv)
29 < 1     calls.push(cmd)
30 < 1     if (cmd === lobbyKey('integrations list --json')) return { code: 0, stdout: JSON.stringify(integrations) }
31 < 1     if (cmd === lobbyKey('ssh-key list --json')) return keys
33 > 1     if (probe !== null && cmd === lobbyKey('ls kata-hub --json')) return { code: 0, stdout: JSON.stringify({ vms: [{ vm_name: 'kata-hub', ssh_dest: 'hub.example', status: 'running' }] }) }
34 < 1     if (probe !== null && cmd === keyOf('ssh', ['-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15', 'hub.example', REAPER_PROBE])) return probe
32 < 1     return { code: 1, stdout: '' }
33 < 1   }
34 < 1   exec.calls = calls
35 < 1   return exec
36 < 1 }
37 < 1 const keysOf = (...rows) => ({ code: 0, stdout: JSON.stringify({ ssh_keys: rows }) })
38 < 1 const key = (name, expires_at) => ({ name, added_at: '2026-09-30T18:55:40Z', ...(expires_at ? { expires_at } : {}) })
39 < 1 const reaperOf = async (opts) => {
40 < 1   const exec = makeExec(opts)
41 < 1   const result = await doctor({ config: {}, exec, configKeys: null, account: null, now: NOW })
42 < 1   return { row: result.rows.find((r) => r.id === 'reaper'), result, exec }
43 < 1 }
44 < 1 
45 < 1 { // (a)
46 < 1   const { row, exec } = await reaperOf({ integrations: [], keys: keysOf() })
47 < 1   assert.ok(row && row.status === 'ok' && row.detail.includes('waits for the janitor'), `(a) absent lobby-rm is ok — got ${JSON.stringify(row)}`)
48 < 1   assert.equal(exec.calls.filter((c) => c === lobbyKey('ssh-key list --json')).length, 1, '(a) the keys are read once')
49 < 1   assert.equal(row.fix, 'reaper', '(a) the row\'s fix is its own first-run heading')
50 < 1 }
51 < 1 { // (b)
