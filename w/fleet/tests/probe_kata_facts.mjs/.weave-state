439 < 2       const owned = await step(409, { method: 'POST', path: at, body })
440 < 2       const error = (owned.json && owned.json.error) || {}
441 < 2       const who = (error.data && error.data.current_owner) || 'absent'
442 < 2       return { steps: [owned], note: 'error ' + (error.code || 'absent') + ', current_owner ' + who }
443 < 2     },
444 < 2 
