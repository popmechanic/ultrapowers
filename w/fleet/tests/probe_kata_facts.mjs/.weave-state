540 < 2     'events-issue-uid': async () => {
541 < 2       const events = await step(200, {
542 < 2         method: 'GET', path: projectsPath + '/events?after_id=0&limit=1000',
543 < 2       })
544 < 2       const json = events.json || {}
545 < 2       const rows = Array.isArray(json) ? json : (json.events || [])
546 < 2       const created = Array.isArray(rows) ? rows.filter((row) => row && row.type === 'issue.created') : []
547 < 2       const withUid = created.filter((row) => row && row.issue_uid !== undefined).length
548 < 2       return { steps: [events], note: withUid + ' of ' + created.length + ' issue.created rows carry issue_uid' }
549 < 2     },
