531 < 2       const first = await step(200, { method: 'POST', path: at, body })
532 < 2       const again = await step(200, { method: 'POST', path: at, body })
533 < 2       const labels = issueOf(again.json).labels
534 < 2       const many = Array.isArray(labels)
535 < 2         ? 'carried ' + labels.filter((one) => one === 'probe-kata-facts').length + ' time(s) in the answer'
536 < 2         : 'no labels in the answer'
