514 < 2         const list = Array.isArray(json) ? json : (json.issues || json.ready || json.items)
515 < 2         return Array.isArray(list) ? list.length : 'unreadable'
516 < 2       }
517 < 2       return {
518 < 2         steps: [ready, unowned, owned],
