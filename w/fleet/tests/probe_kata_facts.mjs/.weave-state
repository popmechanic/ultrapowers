551 < 2     'issue-links-shape': async () => {
552 < 2       const read = await step(200, { method: 'GET', path: API + '/issues/' + someUid(state.uid) })
553 < 2       const links = issueOf(read.json).links
554 < 2       const shaped = Array.isArray(links)
555 < 2         ? links.filter((row) => row && row.type !== undefined &&
556 < 2             row.from && row.from.uid !== undefined && row.to && row.to.uid !== undefined).length +
557 < 2           ' of ' + links.length + ' rows carry {type, from.uid, to.uid}'
558 < 2         : 'no links array in the answer'
559 < 2       return { steps: [read], note: shaped }
560 < 2     },
561 < 2 
562 < 2     // The ladder IS the cleanup, which is why it is read last. The confirmed
563 < 2     // purge is deliberately NOT one of these steps: it is the removal, and
564 < 2     // whether the project was left behind is an exit code and a last line, not
565 < 2     // a fact about the hub's shape.
566 < 2     'archive-actor-required': async () => {
567 < 2       // Read while the issues are still open: the hub validates the missing
568 < 2       // parameter before any state check, so the bare read is a 400 and not
569 < 2       // the ladder's open-issue refusal.
570 < 2       const refused = await step(400, { method: 'DELETE', path: projectsPath })
571 < 2       return { steps: [refused], note: 'no actor query' }
572 < 2     },
573 < 2 
574 < 2     'purge-ladder': async () => {
575 < 2       const purgePath = projectsPath + '/actions/purge'
576 < 2       const archivePath = projectsPath + '?actor=' + encodeURIComponent(actor)
577 < 2       const bare = await step(412, { method: 'POST', path: purgePath, body: { actor } })
578 < 2       const unarchived = await step(409, {
579 < 2         method: 'POST', path: purgePath, headers: { 'X-Kata-Confirm': 'PURGE ' + name }, body: { actor },
580 < 2       })
581 < 2       const open = await step(400, { method: 'DELETE', path: archivePath })
582 < 2 
583 < 2       // One close per ISSUE THE HUB CREATED, naming each exactly once — a close
584 < 2       // on an issue a fact already closed is filed all the same, so the block is
585 < 2       // one close per issue whatever order the facts read in, and the archive
586 < 2       // below is what reports a missed one.
587 < 2       for (const uid of issues) {
588 < 2         await send({
589 < 2           method: 'POST',
590 < 2           path: issuePath(uid) + '/actions/close',
591 < 2           body: {
592 < 2             actor,
593 < 2             reason: 'done',
594 < 2             message: closeMessage(48),
595 < 2             evidence: EVIDENCE,
596 < 2             retry_protocol: 'close-v1',
597 < 2           },
598 < 2         })
599 < 2       }
600 < 2 
601 < 2       const archive = await step(200, { method: 'DELETE', path: archivePath })
602 < 2       state.archived = is2xx(archive.status)
603 < 2       const codeOf = (one) => ((one.json && one.json.error) || {}).code || 'absent'
604 < 2       return {
605 < 2         steps: [bare, unarchived, open, archive],
606 < 2         note: codeOf(bare) + ' then ' + codeOf(unarchived) + ' then ' + codeOf(open) +
607 < 2           ', ' + issues.length + ' closes for ' + creates.length + ' creates, then the archive',
608 < 2       }
609 < 2     },
610 < 2   }
611 < 2 
612 < 2   const results = []
613 < 2   let drift = 0
614 < 2   let unreadable = 0
615 < 2 
616 < 2   for (const fact of FACTS) {
617 < 2     const { steps, note } = await READERS[fact.id]()
618 < 2     const missed = steps.find((one) => one.status === 0)
619 < 2     const drifted = steps.find((one) => statusClass(one.status) !== statusClass(one.expect))
620 < 2     const statuses = steps.map((one) => one.status).join(', ')
621 < 2     let verdict = 'holds'
622 < 2     let read = statuses + (note ? ' — ' + note : '')
623 < 2     if (missed) {
624 < 2       verdict = 'unreadable'
625 < 2       unreadable += 1
626 < 2       read = 'no answer to ' + missed.method + ' ' + missed.path
627 < 2     } else if (drifted) {
628 < 2       verdict = 'drift'
629 < 2       drift += 1
630 < 2       read = drifted.status + ' on ' + drifted.method + ' ' + drifted.path
631 < 2     }
632 < 2     const stamp = ' (kata ' + pingVersion + ', ' + date + ')'
633 < 2     const line = verdict === 'holds'
634 < 2       ? 'FACT ' + fact.id + ': holds — ' + read + stamp
635 < 2       : (verdict === 'drift'
636 < 2           ? 'FACT ' + fact.id + ': DRIFT — read ' + read + ', recorded ' + fact.says + stamp
637 < 2           : 'FACT ' + fact.id + ': UNREADABLE — ' + read + ', recorded ' + fact.says + stamp)
638 < 2     log(line)
639 < 2     results.push({ id: fact.id, verdict, read, line })
640 < 2   }
641 < 2 
642 < 2   log('PROBE: ' + FACTS.length + ' facts, ' + drift + ' drift, ' + unreadable + ' unreadable')
643 < 2 
644 < 2   // The last request of every run whose ping answered: the confirmed purge, the
645 < 2   // header repeating the project's own name.
646 < 2   const purge = await send({
647 < 2     method: 'POST',
648 < 2     path: projectsPath + '/actions/purge',
649 < 2     headers: { 'X-Kata-Confirm': 'PURGE ' + name },
650 < 2     body: { actor },
651 < 2   })
652 < 2 
653 < 2   let exit = (drift > 0 || unreadable > 0) ? 1 : 0
654 < 2   if (!is2xx(purge.status) || state.archived === false) {
655 < 2     const named = projectId === name ? projectId : projectId + ' (' + name + ')'
656 < 2     log('PROBE: project ' + named + ' left behind — POST ' + projectsPath +
657 < 2       '/actions/purge answered ' + purge.status)
658 < 2     exit = 2
659 < 2   }
660 < 2 
661 < 2   return { exit, version: pingVersion, results }
662 < 2 }
663 < 2 
664 < 2 // ── The hand run ────────────────────────────────────────────────────────────
665 < 2 //
666 < 2 // Guarded exactly as `fleet/janitor.mjs` guards its own, because the exam
667 < 2 // imports this module: nothing below runs on an import, so an import files no
668 < 2 // request, reads no environment file and exits no process.
669 < 2 
670 < 2 const main = async () => {
671 < 2   const at = defaultKataEnvPath()
672 < 2   let text = ''
673 < 2   try {
674 < 2     text = fs.readFileSync(at, 'utf8')
675 < 2   } catch {
676 < 2     process.stderr.write('probe_kata_facts: no ' + at + ' — run `node fleet/kata-hub.mjs` first\n')
677 < 2     process.exit(2)
678 < 2   }
679 < 2   const sshHost = kataHostOf(parseKataEnv(text).url)
680 < 2   if (!sshHost) {
681 < 2     process.stderr.write('probe_kata_facts: no hub url in ' + at + '\n')
682 < 2     process.exit(2)
683 < 2   }
684 < 2   const { exit } = await probeKataFacts({ transport: sshTransport({ sshHost, exec: defaultExec }) })
685 < 2   process.exit(exit)
686 < 2 }
687 < 2 
688 < 2 const invokedPath = process.argv[1] ? path.resolve(process.argv[1]) : ''
689 < 2 if (invokedPath === fileURLToPath(import.meta.url)) {
690 < 2   await main()
691 < 2 }
692 < 2 