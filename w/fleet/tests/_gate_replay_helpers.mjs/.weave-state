0 < 2 // Pure scoring for gate_jev_replay_probe.mjs (#1528); the sim is test_gate_jev_replay.mjs.
1 < 2 
2 < 2 // the verdict most of the reads agree on, or null
3 < 1 export const majority = (vs) => ['fail', 'pass'].find((v) => vs.filter((x) => x === v).length * 2 > vs.length) ?? null
4 < 1 
5 < 2 // Every recorded round the replay reads, 1-based by position. A round where agent and jev both read:
6 < 2 // both `fail` is `agreed`; a labelled disagreement is `other` unless jev read `fail`, else `wrong` (agent
7 < 2 // was right) or `right` (jev was).
8 < 1 export function replayRounds(rec) {
9 < 1   const out = []
10 < 1   for (const [task, t] of Object.entries(rec?.tasks ?? {})) {
11 < 1     const rounds = Array.isArray(t?.gate_rounds) ? t.gate_rounds : []
12 < 1     rounds.forEach((r, i) => {
13 < 1       if (!r || r.agent == null || r.jev == null) return
14 < 1       let side = null
15 < 1       if (r.agent === 'fail' && r.jev === 'fail') side = 'agreed'
16 < 1       else if (r.agent !== r.jev && r.right) side = r.jev !== 'fail' ? 'other' : r.right === 'agent' ? 'wrong' : r.right === 'jev' ? 'right' : null
17 < 1       if (side) out.push({ task, round: i + 1, r, side })
18 < 1     })
19 < 1   }
20 < 1   return out
21 < 1 }
22 < 1 
23 < 2 // `evaluate(item)` returns the reads of one item; wrong/right/agreed count the fails, *Pass/rightFail what they read now
24 < 1 export function score(items, evaluate) {
25 < 1   const s = { wrong: 0, wrongPass: 0, right: 0, rightFail: 0, agreed: 0, agreedPass: 0 }
26 < 1   for (const item of items) {
27 < 1     const m = majority(evaluate(item))
28 < 1     if (item.side === 'wrong') { s.wrong++; if (m === 'pass') s.wrongPass++ }
29 < 1     else if (item.side === 'right') { s.right++; if (m === 'fail') s.rightFail++ }
30 < 1     else if (item.side === 'agreed') { s.agreed++; if (m === 'pass') s.agreedPass++ }
31 < 1   }
32 < 1   return s
33 < 1 }
34 < 1 
35 < 2 // 2 nothing replayable; 0 only when the controls hold, no agreed fail now passes and two thirds of the wrong fails do
36 < 1 export function exitCode(s, controlsOk) {
37 < 1   if (s.wrong + s.agreed === 0) return 2
38 < 1   return controlsOk && s.agreedPass === 0 && s.wrongPass * 3 >= s.wrong * 2 ? 0 : 1
39 < 1 }
40 < 1 
41 < 1 export function summary(s, dates, controlsOk) {
42 < 1   return `gate-jev replay: n=${s.wrong + s.right + s.agreed} rounds (${dates}), wrong fails now pass ${s.wrongPass} of ${s.wrong}, `
43 < 1     + `right fails now fail ${s.rightFail} of ${s.right}, agreed fails now pass ${s.agreedPass} of ${s.agreed}, `
44 < 1     + `controls ${controlsOk ? 'ok' : 'NOT OK'}`
45 < 1 }
46 < 1 