215 < 1 // M4, raced: a VM that came up for the orphan since the pass listed the fleet
216 < 1 // is not an orphan — nothing is written.
217 < 1 await test('M4: an orphan the fleet carries when listed again is left alone', async () => {
218 < 1   let listings = 0
219 < 1   const late = { vm_name: 'fleet-r5-1234567891-abcd', ssh_dest: DEST, comment: `run=${RUN} target=${TARGET}` }
220 < 1   const other = { vm_name: 'fleet-r9-1234567890-abcd', ssh_dest: 'x', comment: `run=9 target=${TARGET}` }
221 < 1   const base = stub({
222 < 1     gh: {
223 < 1       'GET repos/ops/evidence/git/matching-refs/heads/live/o-r/run-': ok(JSON.stringify([
224 < 1         { ref: 'refs/heads/live/o-r/run-5', object: { sha: HEAD_SHA } }
225 < 1       ])),
226 < 1       [`GET ${STATUS('ops/evidence')}?ref=live/o-r/run-5`]: ok(envelope(livePage('2026-09-30T09:00:00Z')))
227 < 1     }
228 < 1   })
229 < 1   const exec = async (cmd, args = []) => {
230 < 1     if (cmd === 'ssh' && args[0] === 'exe.dev' && /^ls /.test(args[1])) {
231 < 1       listings += 1
232 < 1       base.calls.push({ cmd, args: [...args] })
233 < 1       return ok(JSON.stringify({ vms: listings === 1 ? [other] : [other, late] }))
234 < 1     }
235 < 1     return base.exec(cmd, args)
236 < 1   }
238 > 1   const result = await janitor({ argv: ['--json'], exec, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
237 < 2   const result = await janitor({ argv: ['--json'], exec, kata: null, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
238 < 1   assert.deepEqual(result.closedOut, [])
239 < 1   assert.ok(!ghCalls(base.calls).some((c) => methodOf(c) === 'PUT'), 'no PUT')
240 < 1 })
