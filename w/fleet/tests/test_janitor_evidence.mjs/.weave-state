264 < 2 // The death's hub marking: one metadata POST under the death's idempotency
265 < 2 // key and no `If-Match` — the client's own patchMetadata, handed a key.
267 > 2 await test('M2: under the kata rollback, a hub-read death marks the run issue under janitor:run-<N>:death, no If-Match', async () => {
266 < 2 await test('M2: a hub-read death marks the run issue under janitor:run-<N>:death, no If-Match', async () => {
267 < 2   const requests = []
268 < 2   const issue = { uid: 'u5', status: 'open', revision: 7, updated_at: '2026-09-30T11:55:00Z', metadata: { run: RUN } }
269 < 2   const transport = {
270 < 2     async request (req) {
271 < 2       requests.push(req)
272 < 2       if (req.method === 'GET' && req.path.endsWith('/projects?limit=1000')) {
273 < 2         return { status: 200, json: { projects: [{ id: 3, uid: 'p3', name: 'o-r' }] } }
274 < 2       }
275 < 2       if (req.method === 'GET' && req.path.endsWith('/issues?limit=1000')) return { status: 200, json: { issues: [issue] } }
276 < 2       return { status: 200, json: { issue: { ...issue, revision: 8 } } }
277 < 2     }
278 < 2   }
279 < 2   const { exec } = stub({ vms: [ROW], unit: 'failed' })
280 < 2   const result = await janitor({
282 > 2     argv: ['--json'], exec, kata: makeKataClient({ transport, actor: 'janitor' }), now, configPath: NO_CONFIG, record: 'kata'
281 < 2     argv: ['--json'], exec, kata: makeKataClient({ transport, actor: 'janitor' }), now, configPath: NO_CONFIG
282 < 2   })
283 < 2   assert.equal(result.deaths[0].hubMarked, true)
284 < 2   const patches = requests.filter((r) => r.method === 'POST' && r.path.endsWith('/issues/u5/metadata'))
285 < 2   assert.equal(patches.length, 1)
286 < 2   assert.equal(patches[0].headers['Idempotency-Key'], 'janitor:run-5:death')
287 < 2   assert.equal(patches[0].headers['If-Match'], undefined)
288 < 2   assert.equal(patches[0].body.patch['work.state'], 'failed')
289 < 1 })
