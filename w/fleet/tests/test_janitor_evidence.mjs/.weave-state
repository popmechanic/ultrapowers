475 < 1 const liveRefs = (...runs) => ({
476 < 1   [`GET repos/${EV}/git/matching-refs/heads/live/o-r/run-`]: ok(JSON.stringify(
477 < 1     runs.map((run) => ({ ref: `refs/heads/live/o-r/run-${run}`, object: { sha: HEAD_SHA } }))
478 < 1   ))
479 < 1 })
480 < 1 const sealOf = (run) => ({
481 < 1   [`GET repos/${EV}/git/ref/heads/live/o-r/run-${run}`]: ok(JSON.stringify({ object: { sha: HEAD_SHA } })),
482 < 1   [`POST repos/${EV}/git/refs`]: ok(JSON.stringify({ ref: `refs/tags/o-r/run-${run}` })),
483 < 1   [`GET repos/${EV}/git/ref/tags/o-r/run-${run}`]: ok(JSON.stringify({ object: { sha: HEAD_SHA } })),
484 < 1   [`DELETE repos/${EV}/git/refs/heads/live/o-r/run-${run}`]: ok('')
485 < 1 })
486 < 1 const writes = (calls) => ghCalls(calls).filter((c) => methodOf(c) !== 'GET').map((c) => `${methodOf(c)} ${c.args.find((a) => a.startsWith('repos/'))}`)
487 < 1 
