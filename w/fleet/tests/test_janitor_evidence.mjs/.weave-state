242 < 1 // The seal keeps the branch when the tag cannot be verified.
243 < 1 await test('sealRun: a tag that does not name the head keeps the live branch', async () => {
244 < 1   const answers = sealAnswers('ops/evidence')
245 < 1   answers['POST repos/ops/evidence/git/refs'] = { code: 1, stdout: '', stderr: 'gh: Reference already exists (HTTP 422)' }
246 < 1   answers['GET repos/ops/evidence/git/ref/tags/o-r/run-5'] = ok(JSON.stringify({ object: { sha: 'c'.repeat(40) } }))
247 < 1   const { exec, calls } = stub({
248 < 1     vms: [ROW],
249 < 1     unit: 'failed',
250 < 1     gh: {
