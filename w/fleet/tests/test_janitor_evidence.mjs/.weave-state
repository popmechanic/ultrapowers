320 < 1 await test('R1: the highest-numbered PR decides; open, merged or none keeps the branch', async () => {
321 < 1   for (const pulls of [
322 < 1     [{ number: 12, state: 'closed', merged_at: null }, { number: 20, state: 'open', merged_at: null }],
323 < 1     [{ number: 20, state: 'closed', merged_at: '2026-09-30T10:00:00Z' }, { number: 12, state: 'closed', merged_at: null }],
324 < 1     []
325 < 1   ]) {
