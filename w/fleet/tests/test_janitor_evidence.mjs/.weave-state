291 < 1 // R1 — the integration-branch sweep (folded from test_retire_integration_only):
292 < 1 // a closed, unmerged pull request's branch is the ONE thing deleted on the
293 < 1 // target; no tag, no PATCH, nothing naming a plan or evidence branch.
294 < 1 const PULLS = 'GET repos/o/r/pulls?state=all&per_page=100&head=o:ultra/integration-run-3'
295 < 1 const sweepAnswers = (pulls) => ({
296 < 1   'GET repos/o/r/git/matching-refs/heads/ultra/integration-run-': ok(JSON.stringify([
297 < 1     { ref: 'refs/heads/ultra/integration-run-3', object: { sha: HEAD_SHA } }
298 < 1   ])),
299 < 1   [PULLS]: ok(JSON.stringify(pulls)),
300 < 1   'DELETE repos/o/r/git/refs/heads/ultra/integration-run-3': ok('')
301 < 1 })
302 < 1 const onTarget = (calls) => ghCalls(calls).filter((c) => methodOf(c) !== 'GET' && c.args.some((a) => a.startsWith('repos/o/r/')))
303 < 1 const DELETE_3 = [['api', '-X', 'DELETE', 'repos/o/r/git/refs/heads/ultra/integration-run-3']]
304 < 1 
305 < 1 await test('R1: a closed unmerged PR\'s integration branch is deleted, and nothing else on the target', async () => {
306 < 1   const { exec, calls } = stub({ vms: [ROW], unit: 'active', gh: sweepAnswers([{ number: 12, state: 'closed', merged_at: null }]) })
308 > 1   const result = await janitor({ argv: ['--json'], exec, now, configPath: NO_CONFIG })
307 < 2   const result = await janitor({ argv: ['--json'], exec, kata: null, now, configPath: NO_CONFIG })
308 < 1   assert.deepEqual(onTarget(calls).map((c) => c.args), DELETE_3)
309 < 1   assert.ok(!calls.some((c) => c.args.some((a) => /plan-run-3|evidence-run-3/.test(String(a)))))
310 < 1   assert.deepEqual(result.branches, [{ target: TARGET, run: 3, branch: 'ultra/integration-run-3', pr: 12, deleted: true }])
311 < 1 })
312 < 1 
