365 > 1 // ── The evidence record decides ────────────────────────────────────────────
364 > 2 // ── The evidence record decides, and the hub is not asked ──────────────────
365 < 1 
366 < 1 const EV = 'ops/evidence'
367 < 1 const vmOf = (run) => `fleet-r${run}-1234567890-abcd`
368 < 1 const rowOf = (run) => ({ vm_name: vmOf(run), ssh_dest: `${vmOf(run)}.exe.xyz`, comment: `run=${run} target=${TARGET}` })
369 < 1 const statusOf = (run) => `repos/${EV}/contents/runs/o-r/${run}/status.json`
370 < 1 const atTag = (run, page) => ({ [`GET ${statusOf(run)}?ref=o-r/run-${run}`]: ok(envelope(page)) })
371 < 1 const atLive = (run, page) => ({ [`GET ${statusOf(run)}?ref=live/o-r/run-${run}`]: ok(envelope(page)) })
372 < 1 const OLD = '2026-09-30T09:00:00Z'
373 < 1 const rmCommands = (calls) => calls
374 < 1   .filter((c) => c.cmd === 'ssh' && c.args[0] === 'exe.dev' && /^rm /.test(c.args[1]))
375 < 1   .map((c) => c.args[1])
376 < 1 
378 > 1 // E1 — one pass over a done, a parked, a running and an unreadable run. Only
379 < 1 // `gh` and the lobby are asked: no other command leaves the laptop.
380 < 1 await test('E1: a done and a parked run are reaped, a running one left, an unread one never touched', async () => {
377 < 2 /** A hub that cannot be reached: every request throws, and every one is counted. */
378 < 2 const darkHub = () => {
379 < 2   const requests = []
380 < 2   const transport = { async request (req) { requests.push(req); throw new Error('ssh: connect to host kata-hub.exe.xyz: Connection refused') } }
381 < 2   return { client: makeKataClient({ transport, actor: 'janitor' }), requests }
382 < 2 }
383 < 2 
384 < 2 // E1 — one pass over a done, a parked, a running and an unreadable run, the
385 < 2 // hub unreachable and never asked: the policy file's default is what decides.
386 < 2 await test('E1: with the hub unreachable, a done and a parked run are reaped, a running one left, an unread one never touched', async () => {
387 < 2   const hub = darkHub()
388 < 1   const { exec, calls } = stub({
389 < 1     vms: [rowOf(1), rowOf(2), rowOf(3), rowOf(4)],
390 < 1     unit: 'active',
391 < 1     gh: {
392 < 1       ...atTag(1, { state: 'done', updatedAt: OLD }),
393 < 1       ...atTag(2, { state: 'parked', updatedAt: OLD }),
394 < 1       ...atLive(3, { state: 'running', updatedAt: '2026-09-30T11:59:00Z' })
395 < 1       // run 4: no page at its tag or its live branch.
396 < 1     }
397 < 1   })
399 > 1   const result = await janitor({ argv: ['--json'], exec, now, evidence: EV, configPath: NO_CONFIG })
400 < 1   assert.ok(!('hub' in result) && !('record' in result), 'the result names no hub and no source')
401 < 1   const hosts = calls.filter((c) => c.cmd === 'ssh').map((c) => c.args.find((a) => !a.startsWith('-') && !/^(BatchMode|ConnectTimeout)=/.test(a)))
402 < 1   assert.deepEqual([...new Set(hosts)].sort(), ['exe.dev', `${vmOf(3)}.exe.xyz`], 'ssh reaches the lobby and the one running VM, and no hub')
398 < 2   const result = await janitor({ argv: ['--json'], exec, kata: hub.client, now, evidence: EV, configPath: NO_CONFIG })
399 < 2   assert.equal(result.record, 'evidence', 'the default source')
400 < 2   assert.equal(hub.requests.length, 0, 'the hub is not asked')
401 < 2   assert.equal(result.hub, null)
402 < 1   assert.deepEqual(rmCommands(calls), [`rm ${vmOf(1)} --json`, `rm ${vmOf(2)} --json`])
403 < 1   assert.deepEqual(result.actions.map((a) => [a.run, a.state, a.applied]), [[1, 'done', true], [2, 'parked', true]])
404 < 1   assert.deepEqual(result.unread, [{ vm: vmOf(4), run: 4, target: TARGET }])
405 < 1   assert.deepEqual(result.runs.map((r) => [r.run, r.live, r.state]), [[1, false, 'done'], [2, false, 'parked'], [3, true, 'running'], [4, null, null]])
406 < 1 })
