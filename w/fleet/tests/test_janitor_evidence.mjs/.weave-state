328 > 1     const result = await janitor({ argv: ['--json'], exec, now, configPath: NO_CONFIG })
327 < 2     const result = await janitor({ argv: ['--json'], exec, kata: null, now, configPath: NO_CONFIG })
328 < 1     assert.deepEqual(onTarget(calls), [], JSON.stringify(pulls))
