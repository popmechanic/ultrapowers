0 < 1 #!/usr/bin/env node
1 < 1 /**
2 < 1  * fleet/tests/test_janitor_evidence.mjs — the janitor reads a run's record,
3 < 1  * and writes its end (the death and the close-out), in the operator's evidence
4 < 1  * repository (#1395), never the target's; and it deletes a target's
5 < 1  * integration branch whose pull request closed unmerged, and nothing else there.
7 > 1  *
9 > 1  * The evidence record is the one source: a done and a parked run are reaped, a
10 < 1  * running one left, an unread one never touched (E1–E3); a run that ended with
11 < 1  * its live branch left and no tag is sealed (S1–S4).
8 < 2  * The evidence record is the default source and the hub is not asked (E1–E3);
9 < 2  * `record: 'kata'` is the rollback, the hub first and the evidence repository
10 < 2  * behind it (K1–K2); a run that ended with its live branch left and no tag is
11 < 2  * sealed (S1–S4).
6 < 1  *
7 < 1  * Every call goes through a recording exec stub: the lobby's `ls`, the unit
9 > 1  * reads over ssh, and `gh api` answered by path. No socket is opened; the
10 < 1  * config files live in a temp dir.
8 < 2  * reads over ssh, and `gh api` answered by path. The hub, where a leg needs
9 < 2  * one, is the real kata client over a recording transport. No socket is
10 < 2  * opened; the config files live in a temp dir.
11 < 1  */
12 < 1 import assert from 'node:assert/strict'
13 < 1 import fs from 'node:fs'
14 < 1 import os from 'node:os'
15 < 1 import path from 'node:path'
16 < 1 
19 > 1 import { janitor } from '../janitor.mjs'
18 > 2 import { janitor, recordSourceOf } from '../janitor.mjs'
17 < 2 import { janitor } from '../janitor.mjs'
18 < 2 import { makeKataClient } from '../kata-client.mjs'
19 < 1 
20 < 1 const TARGET = 'o/r'
21 < 1 const RUN = 5
22 < 1 const VM = 'fleet-r5-1234567890-abcd'
23 < 1 const DEST = 'fleet-r5-1234567890-abcd.exe.xyz'
24 < 1 const HEAD_SHA = 'a'.repeat(40)
25 < 1 const NOW = new Date('2026-09-30T12:00:00Z')
26 < 1 const now = () => NOW
27 < 1 
28 < 1 const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'janitor-evidence-'))
29 < 1 const configAt = (name, body) => {
30 < 1   const file = path.join(tmp, name)
31 < 1   fs.writeFileSync(file, body === undefined ? '' : JSON.stringify(body))
32 < 1   return file
33 < 1 }
34 < 1 const NO_CONFIG = path.join(tmp, 'absent.json')
35 < 1 
36 < 1 const envelope = (page, sha = 'b'.repeat(40)) => JSON.stringify({
37 < 1   content: Buffer.from(JSON.stringify(page), 'utf8').toString('base64'),
38 < 1   sha
39 < 1 })
40 < 1 const livePage = (updatedAt = '2026-09-30T11:55:00Z') => ({ state: 'running', updatedAt, run: RUN })
41 < 1 
42 < 1 const ok = (stdout = '') => ({ code: 0, stdout, stderr: '' })
43 < 1 const notFound = () => ({ code: 1, stdout: '', stderr: 'gh: Not Found (HTTP 404)' })
44 < 1 
45 < 1 /**
46 < 1  * A recording exec. `gh` answers are keyed `<METHOD> <path>` (GET for a plain
47 < 1  * `gh api <path>`); anything unkeyed is a 404. `vms` is the lobby listing,
48 < 1  * `unit` the ActiveState the VM reports for the run's unit.
49 < 1  */
50 < 1 function stub ({ vms = [], unit = 'active', gh = {} } = {}) {
51 < 1   const calls = []
52 < 1   const exec = async (cmd, args = []) => {
53 < 1     calls.push({ cmd, args: [...args] })
54 < 1     if (cmd === 'ssh' && args[0] === 'exe.dev') {
55 < 1       if (/^ls /.test(args[1])) return ok(JSON.stringify({ vms }))
56 < 1       return ok('{}')
57 < 1     }
58 < 1     if (cmd === 'ssh') {
59 < 1       const command = args[args.length - 1]
60 < 1       if (command.includes('systemctl')) {
61 < 1         return ok(`ActiveState=${unit}\nSubState=${unit === 'failed' ? 'failed' : 'running'}\nResult=${unit === 'failed' ? 'exit-code' : 'success'}\nExecMainStatus=${unit === 'failed' ? 1 : 0}\n`)
62 < 1       }
63 < 1       if (command.includes('journalctl')) return ok('the unit died\n')
64 < 1       return ok('')
65 < 1     }
66 < 1     if (cmd === 'gh' && args[0] === 'api') {
67 < 1       const x = args.indexOf('-X')
68 < 1       const method = x === -1 ? 'GET' : args[x + 1]
69 < 1       const apiPath = args.find((a) => a.startsWith('repos/'))
70 < 1       const answer = gh[`${method} ${apiPath}`]
71 < 1       if (answer === undefined) return notFound()
72 < 1       return typeof answer === 'function' ? answer(args) : answer
73 < 1     }
74 < 1     return { code: 127, stdout: '', stderr: `unexpected ${cmd}` }
75 < 1   }
76 < 1   return { exec, calls }
77 < 1 }
78 < 1 
79 < 1 const ghCalls = (calls) => calls.filter((c) => c.cmd === 'gh')
80 < 1 const ghPaths = (calls) => ghCalls(calls).map((c) => c.args.find((a) => a.startsWith('repos/')))
81 < 1 const methodOf = (c) => { const x = c.args.indexOf('-X'); return x === -1 ? 'GET' : c.args[x + 1] }
82 < 1 const field = (c, name) => {
83 < 1   const hit = c.args.find((a) => a.startsWith(`${name}=`))
84 < 1   return hit === undefined ? undefined : hit.slice(name.length + 1)
85 < 1 }
86 < 1 
87 < 1 const ROW = { vm_name: VM, ssh_dest: DEST, comment: `run=${RUN} target=${TARGET}` }
88 < 1 const STATUS = (repo) => `repos/${repo}/contents/runs/o-r/5/status.json`
89 < 1 const JOURNAL = (repo) => `repos/${repo}/contents/runs/o-r/5/janitor-journal.txt`
90 < 1 
91 < 1 /** The seal's refs-API answers in `repo`, the tag verified at HEAD_SHA. */
92 < 1 const sealAnswers = (repo) => ({
93 < 1   [`GET repos/${repo}/git/ref/heads/live/o-r/run-5`]: ok(JSON.stringify({ object: { sha: HEAD_SHA } })),
94 < 1   [`POST repos/${repo}/git/refs`]: ok(JSON.stringify({ ref: 'refs/tags/o-r/run-5' })),
95 < 1   [`GET repos/${repo}/git/ref/tags/o-r/run-5`]: ok(JSON.stringify({ object: { sha: HEAD_SHA } })),
96 < 1   [`DELETE repos/${repo}/git/refs/heads/live/o-r/run-5`]: ok('')
97 < 1 })
98 < 1 
99 < 1 let passed = 0
100 < 1 const test = async (name, fn) => {
101 < 1   await fn()
102 < 1   passed += 1
103 < 1   process.stdout.write(`ok - ${name}\n`)
104 < 1 }
105 < 1 
106 < 1 // M1 — the tag read, then the live-branch read, both in the evidence repo.
107 < 1 await test('M1: the status reads go to the evidence repository, tag then live branch', async () => {
108 < 1   const { exec, calls } = stub({
109 < 1     vms: [ROW],
110 < 1     unit: 'active',
111 < 1     gh: { [`GET ${STATUS('ops/evidence')}?ref=live/o-r/run-5`]: ok(envelope(livePage())) }
112 < 1   })
114 > 1   const result = await janitor({ argv: ['--json'], exec, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
113 < 2   const result = await janitor({ argv: ['--json'], exec, kata: null, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
114 < 1   const paths = ghPaths(calls)
115 < 1   const tagAt = paths.indexOf(`${STATUS('ops/evidence')}?ref=o-r/run-5`)
116 < 1   const liveAt = paths.indexOf(`${STATUS('ops/evidence')}?ref=live/o-r/run-5`)
117 < 1   assert.ok(tagAt !== -1, `no tag read in ${JSON.stringify(paths)}`)
118 < 1   assert.ok(liveAt > tagAt, `the live read must follow the tag read: ${JSON.stringify(paths)}`)
119 < 1   assert.deepEqual(paths.filter((p) => p.startsWith('repos/o/r/contents/')), [])
120 < 1   assert.equal(result.evidence, 'ops/evidence')
121 < 1   assert.equal(result.deaths.length, 0)
122 < 1 })
123 < 1 
124 < 1 // M2 — the death: both PUTs on the live branch, then the tag, then the delete.
125 < 1 await test('M2: a dead unit under a running page writes the death and seals the run', async () => {
126 < 1   const { exec, calls } = stub({
127 < 1     vms: [ROW],
128 < 1     unit: 'failed',
129 < 1     gh: {
130 < 1       [`GET ${STATUS('ops/evidence')}?ref=live/o-r/run-5`]: ok(envelope(livePage())),
131 < 1       [`PUT ${JOURNAL('ops/evidence')}`]: ok('{}'),
132 < 1       [`PUT ${STATUS('ops/evidence')}`]: ok('{}'),
133 < 1       ...sealAnswers('ops/evidence')
134 < 1     }
135 < 1   })
137 > 1   const result = await janitor({ argv: ['--json'], exec, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
136 < 2   const result = await janitor({ argv: ['--json'], exec, kata: null, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
137 < 1   const gh = ghCalls(calls)
138 < 1   const journalPut = gh.findIndex((c) => methodOf(c) === 'PUT' && c.args.includes(JOURNAL('ops/evidence')))
139 < 1   const statusPut = gh.findIndex((c) => methodOf(c) === 'PUT' && c.args.includes(STATUS('ops/evidence')))
140 < 1   const tagPost = gh.findIndex((c) => methodOf(c) === 'POST' && c.args.includes('repos/ops/evidence/git/refs'))
141 < 1   const del = gh.findIndex((c) => methodOf(c) === 'DELETE' && c.args.includes('repos/ops/evidence/git/refs/heads/live/o-r/run-5'))
142 < 1   assert.ok(journalPut !== -1 && statusPut > journalPut, 'journal PUT then status PUT')
143 < 1   assert.equal(field(gh[journalPut], 'branch'), 'live/o-r/run-5')
144 < 1   assert.equal(field(gh[statusPut], 'branch'), 'live/o-r/run-5')
145 < 1   const written = JSON.parse(Buffer.from(field(gh[statusPut], 'content'), 'base64').toString('utf8'))
146 < 1   assert.equal(written.state, 'failed')
147 < 1   assert.ok(tagPost > statusPut, 'the tag is cut after the status PUT')
148 < 1   assert.equal(field(gh[tagPost], 'ref'), 'refs/tags/o-r/run-5')
149 < 1   assert.equal(field(gh[tagPost], 'sha'), HEAD_SHA)
150 < 1   assert.ok(del > tagPost, 'the live branch is deleted after the tag')
151 < 1   assert.equal(result.deaths.length, 1)
152 < 1   assert.equal(result.deaths[0].applied, true)
153 < 1   assert.deepEqual(result.deaths[0].sealed, { tagged: true, deleted: true })
154 < 1   assert.deepEqual(ghPaths(calls).filter((p) => p.startsWith('repos/o/r/contents/')), [])
155 < 1 })
156 < 1 
157 < 1 // M3 — the orphan listing names the evidence repository's live prefix.
158 < 1 await test('M3: the orphan close-out lists the evidence repository\'s live branches', async () => {
159 < 1   const { exec, calls } = stub({ vms: [ROW], unit: 'active' })
161 > 1   await janitor({ argv: ['--json'], exec, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
160 < 2   await janitor({ argv: ['--json'], exec, kata: null, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
161 < 1   assert.ok(ghPaths(calls).includes('repos/ops/evidence/git/matching-refs/heads/live/o-r/run-'))
162 < 1   assert.ok(!ghPaths(calls).some((p) => p.startsWith('repos/o/r/git/matching-refs/heads/ultra/evidence')))
163 < 1 })
164 < 1 
165 < 1 // M3, driven: an orphan found there is closed out in the evidence repository.
166 < 1 await test('M3: an orphan found on the live prefix is closed out there', async () => {
167 < 1   const other = { vm_name: 'fleet-r9-1234567890-abcd', ssh_dest: 'x', comment: `run=9 target=${TARGET}` }
168 < 1   const { exec, calls } = stub({
169 < 1     vms: [other],
170 < 1     unit: 'active',
171 < 1     gh: {
172 < 1       'GET repos/ops/evidence/git/matching-refs/heads/live/o-r/run-': ok(JSON.stringify([
173 < 1         { ref: 'refs/heads/live/o-r/run-5', object: { sha: HEAD_SHA } }
174 < 1       ])),
175 < 1       [`GET ${STATUS('ops/evidence')}?ref=live/o-r/run-5`]: ok(envelope(livePage('2026-09-30T09:00:00Z'))),
176 < 1       [`PUT ${STATUS('ops/evidence')}`]: ok('{}'),
177 < 1       ...sealAnswers('ops/evidence')
178 < 1     }
179 < 1   })
181 > 1   const result = await janitor({ argv: ['--json'], exec, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
180 < 2   const result = await janitor({ argv: ['--json'], exec, kata: null, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
181 < 1   assert.deepEqual(result.closedOut, [{ target: TARGET, run: RUN, state: 'running', closed: true }])
182 < 1   assert.ok(ghCalls(calls).some((c) => methodOf(c) === 'DELETE' && c.args.includes('repos/ops/evidence/git/refs/heads/live/o-r/run-5')))
183 < 1 })
184 < 1 
185 < 1 // M4 — the orphan's end: failed written to the live branch, tag cut, branch
186 < 1 // deleted, and no git at all (folded from close-out.mjs's own leg).
187 < 1 await test('M4: an orphan is written failed, tagged, its live branch deleted, with no git', async () => {
188 < 1   const { exec, calls } = stub({
189 < 1     vms: [{ vm_name: 'fleet-r9-1234567890-abcd', ssh_dest: 'x', comment: `run=9 target=${TARGET}` }],
190 < 1     gh: {
191 < 1       'GET repos/ops/evidence/git/matching-refs/heads/live/o-r/run-': ok(JSON.stringify([
192 < 1         { ref: 'refs/heads/live/o-r/run-5', object: { sha: HEAD_SHA } }
193 < 1       ])),
194 < 1       [`GET ${STATUS('ops/evidence')}?ref=live/o-r/run-5`]: ok(envelope(livePage('2026-09-30T09:00:00Z'))),
195 < 1       [`PUT ${STATUS('ops/evidence')}`]: ok('{}'),
196 < 1       ...sealAnswers('ops/evidence')
197 < 1     }
198 < 1   })
200 > 1   const out = await janitor({ argv: ['--json'], exec, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
199 < 2   const out = await janitor({ argv: ['--json'], exec, kata: null, now, evidence: 'ops/evidence', configPath: NO_CONFIG })
200 < 1   assert.deepEqual(out.closedOut, [{ target: TARGET, run: RUN, state: 'running', closed: true }])
201 < 1   const gh = ghCalls(calls)
202 < 1   const put = gh.find((c) => methodOf(c) === 'PUT' && c.args.includes(STATUS('ops/evidence')))
203 < 1   assert.ok(put, 'status PUT')
204 < 1   assert.equal(field(put, 'branch'), 'live/o-r/run-5')
205 < 1   const written = JSON.parse(Buffer.from(field(put, 'content'), 'base64').toString('utf8'))
206 < 1   assert.equal(written.state, 'failed')
207 < 1   assert.equal(written.error, 'reaped before the run recorded its end')
208 < 1   assert.equal(written.run, RUN, 'every other cell kept')
209 < 1   const post = gh.find((c) => methodOf(c) === 'POST' && c.args.includes('repos/ops/evidence/git/refs'))
210 < 1   assert.equal(field(post, 'ref'), 'refs/tags/o-r/run-5')
211 < 1   assert.ok(gh.some((c) => methodOf(c) === 'DELETE' && c.args.includes('repos/ops/evidence/git/refs/heads/live/o-r/run-5')))
212 < 1   assert.ok(!calls.some((c) => c.cmd === 'git'), 'no git at all')
213 < 1 })
