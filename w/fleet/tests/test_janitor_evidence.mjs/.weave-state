316 > 1   const result = await janitor({ argv: ['--json', '--dry-run'], exec, now, configPath: NO_CONFIG })
315 < 2   const result = await janitor({ argv: ['--json', '--dry-run'], exec, kata: null, now, configPath: NO_CONFIG })
316 < 1   assert.deepEqual(onTarget(calls), [])
317 < 1   assert.equal(result.branches[0].deleted, false)
318 < 1 })
