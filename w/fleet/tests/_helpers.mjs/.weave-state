0 < 1 /**
1 < 1  * fleet/tests/_helpers.mjs — the rig's environment.
2 < 1  *
3 < 1  * Underscore-prefixed so test_fleet_suite.py's `test_*.mjs` glob does not run
4 < 1  * it as a test of its own.
5 < 1  *
6 < 1  * The main export is `simEnv`, and one rule behind it: a sim sees what it was handed,
7 < 1  * never the box it runs on. Every process a sim starts gets an environment
8 < 1  * built here — the parent's own `ULTRA_`, `TINYAPP_`, `FLEET_`, `ANTHROPIC_`,
9 < 1  * `CLAUDE_` and `GH_` keys are dropped, `HOME`/`TMPDIR`/`FLEET_HOME` point at a
10 < 1  * directory the sim owns, and `PATH` carries the interpreters and nothing else.
11 < 1  * `fleet/tests/test_sims_are_hermetic.mjs` is the probe that keeps it true.
12 < 1  *
13 < 1  * Node's own rule (`node:child_process`): with an `env` option the child gets
14 < 1  * exactly that object and nothing of `process.env`, and the command — plus, in
15 < 1  * a `bash -c` child, its sub-commands — is looked up on `env.PATH`. That is why
16 < 1  * the interpreters ride the `PATH` this builds.
17 < 1  */
18 < 1 
19 < 1 import fs from 'node:fs'
20 < 1 import os from 'node:os'
21 < 1 import path from 'node:path'
22 < 2 
23 < 2 /** Prefixes of the parent's environment that never reach a child. */
24 < 2 export const DROPPED_PREFIXES = ['ULTRA_', 'TINYAPP_', 'FLEET_', 'ANTHROPIC_', 'CLAUDE_', 'GH_']
25 < 1 
26 < 1 /** The interpreters a sim's children resolve on the `PATH` this builds. */
27 < 1 const INTERPRETERS = ['python3', 'git', 'bash', 'sh']
28 < 1 
29 < 1 /** The first directory of the parent's `PATH` holding an executable `name`. */
30 < 1 const whichDir = (name) => {
31 < 1   for (const dir of (process.env.PATH ?? '').split(path.delimiter)) {
32 < 1     if (!dir) continue
33 < 1     const candidate = path.join(dir, name)
34 < 1     try {
35 < 1       fs.accessSync(candidate, fs.constants.X_OK)
36 < 1       return dir
37 < 1     } catch {
38 < 1       // Not here; keep walking. A missing interpreter is left out silently —
39 < 1       // the sim that needs it fails where it spawns it.
40 < 1     }
41 < 1   }
42 < 1   return null
43 < 1 }
44 < 1 
45 < 1 // The walk above is the same answer every time for one parent `PATH`, and a sim
46 < 1 // that runs hundreds of git commands asks for it hundreds of times; cache it
47 < 1 // against the `PATH` it was read from, so a caller that changes `PATH` still
48 < 1 // gets a fresh answer.
49 < 1 let cached = { path: null, dirs: [] }
50 < 1 const interpreterDirs = () => {
51 < 1   const parent = process.env.PATH ?? ''
52 < 1   if (cached.path !== parent) {
53 < 1     const dirs = []
54 < 1     for (const dir of [path.dirname(process.execPath), ...INTERPRETERS.map(whichDir)]) {
55 < 1       if (dir && !dirs.includes(dir)) dirs.push(dir)
56 < 1     }
57 < 1     cached = { path: parent, dirs }
58 < 1   }
59 < 1   return cached.dirs
60 < 1 }
61 < 1 
62 < 1 /**
63 < 1  * The environment for one child process.
64 < 1  *
65 < 1  *   `bin`   a directory to put first on `PATH` — a case's stubs
66 < 1  *   `home`  the directory `HOME`, `TMPDIR` and `FLEET_HOME` all name;
67 < 1  *           defaults to a fresh `mkdtemp` under `os.tmpdir()`
68 < 1  *   `env`   the caller's own keys, laid over everything else last, so a
69 < 1  *           caller-supplied key of any name wins
70 < 1  */
71 < 1 /**
72 < 1  * The `fleet-sim-*` directories this process minted, removed when it exits
73 < 1  * (#890): a `simEnv()` with no `home` makes one per call, and a sim that
74 < 1  * spawns a dozen children a dozen times would otherwise leave a dozen dirs
75 < 1  * under `os.tmpdir()` for good. Sync on purpose — an `exit` handler gets no
76 < 1  * event loop — and `force`, so a dir a child already removed is not an error.
77 < 1  */
78 < 1 const OWNED = []
79 < 1 process.on('exit', () => {
80 < 1   for (const dir of OWNED) {
81 < 1     try {
82 < 1       fs.rmSync(dir, { recursive: true, force: true })
83 < 1     } catch {
84 < 1       // Left for the box's own tmp reaper; never a failed sim.
85 < 1     }
86 < 1   }
87 < 1 })
88 < 1 
89 < 1 export function simEnv ({ bin, home, env } = {}) {
90 < 1   const root = home ?? fs.mkdtempSync(path.join(os.tmpdir(), 'fleet-sim-'))
91 < 1   if (home == null) OWNED.push(root)
92 < 1 
93 < 1   const dirs = []
94 < 1   for (const dir of [...(Array.isArray(bin) ? bin : bin ? [bin] : []), ...interpreterDirs()]) {
95 < 1     if (dir && !dirs.includes(dir)) dirs.push(dir)
96 < 1   }
97 < 1 
98 < 1   const out = {
99 < 1     PATH: dirs.join(path.delimiter),
100 < 1     HOME: root,
101 < 1     TMPDIR: root,
102 < 1     FLEET_HOME: root,
103 < 1   }
104 < 1   return { ...out, ...env }
105 < 1 }
106 < 1 