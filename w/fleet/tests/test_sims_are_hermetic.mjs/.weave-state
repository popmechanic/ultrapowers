701 < 2 // ── (b) every spawn is handed its environment  [M2] ──────────────────────────
702 < 2 
703 < 1 test('the sweep names zero inheriting spawns in fleet/tests/  [M2 / leg (b)]', () => {
704 < 2   // The reach, pinned by equality against the files the sweep is defined over
705 < 2   // and read from the directory here — not by a floor on how many there are. A
706 < 2   // floor is a fact about how large the pre-flight happened to be on the day it
707 < 2   // was written, and it says nothing when a retired sim leaves the tree; the
708 < 2   // set says the one thing that matters, that every file the rules are defined
709 < 2   // over was read.
710 < 1   const definedOver = fs.readdirSync(TESTS_DIR).filter((n) => isSwept(n) && n !== SELF)
711 < 1   assert.deepEqual(SWEPT, [...definedOver].sort(),
712 < 1     `(b) [M2] the sweep reads every fleet/tests/test_*.mjs and _*.mjs but this file — ` +
713 < 1     `not a file fewer: ${JSON.stringify(SWEPT)}`)
714 < 1   const offenders = treeOffenders('inherit')
715 < 1   assert.deepEqual(named(offenders), [],
716 < 1     `(b) [M2] every spawn in fleet/tests/test_*.mjs and fleet/tests/_*.mjs takes an env derived ` +
717 < 1     `from simEnv — ${offenders.length} do not:\n  ${named(offenders).slice(0, 40).join('\n  ')}`)
718 < 1 })
719 < 1 
720 < 1 test('the same sweep names one offender for each inheriting shape  [M2 / leg (b)]', () => {
721 < 1   const cases = [
722 < 1     ["spawnSync('git', ['status'], { cwd })", 'no env: at all'],
723 < 1     ["spawnSync('git', ['status'], { env: process.env })", 'the parent handed over whole'],
724 < 1     ["execFileSync('git', ['status'], { env: { ...process.env, X: '1' } })", 'the parent spread'],
725 < 1     ["const ENV = { ...process.env }\nspawnSync('git', ['status'], { env: ENV })", 'the parent behind a name'],
726 < 1     ["const bootEnv = (ctx, env) => ({ ...process.env, ...env })\nspawn('bash', [script], { env: bootEnv(ctx, env) })",
727 < 1       'a helper whose body spreads the parent — a name is not what makes it hermetic'],
728 < 1   ]
729 < 1   for (const [source, why] of cases) {
730 < 1     const r = sweep(source, { file: '<case>' })
731 < 1     assert.equal(r.inherit.length, 1,
732 < 1       `(b) [M2] one offender for ${why}: ${JSON.stringify(source)} gave ${JSON.stringify(named(r.inherit))}`)
733 < 1   }
734 < 1 })
735 < 1 
736 < 1 test('the same sweep names none for each simEnv-derived shape  [M2 / leg (b)]', () => {
