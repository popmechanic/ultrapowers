751 < 1 test("a sibling helper's bootEnv is accepted by its body, across the import  [M2 / leg (b)]", () => {
752 < 1   const helperSrc = scan("export const bootEnv = (ctx, env) => ({ ...simEnv({ bin: ctx.bin }), ...env })\n")
753 < 1   const leakySrc = scan("export const bootEnv = (ctx, env) => ({ ...process.env, ...env })\n")
754 < 1   const caller = "import { bootEnv } from './_sandbox_boot_helpers.mjs'\nspawn('bash', [script], { env: bootEnv(ctx, env) })"
755 < 1   const green = sweep(caller, { file: '<case>', resolveImport: (id) => (id === 'bootEnv' ? helperSrc : null) })
756 < 1   assert.deepEqual(named(green.inherit), [],
757 < 1     '(b) [M2] a name a file imports from a sibling _*.mjs is resolved in that sibling\'s source, and ' +
758 < 1     'a body that spreads simEnv( is accepted there')
759 < 1   const red = sweep(caller, { file: '<case>', resolveImport: (id) => (id === 'bootEnv' ? leakySrc : null) })
760 < 1   assert.equal(red.inherit.length, 1,
761 < 1     '(b) [M2] and the same name is named when that body spreads the parent instead')
762 < 1 })
