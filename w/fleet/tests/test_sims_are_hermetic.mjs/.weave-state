738 < 1     ["spawnSync('git', ['status'], { env: simEnv() })", 'a literal simEnv() call'],
739 < 1     ["spawnSync('git', ['status'], { env: { ...simEnv(), X: '1' } })", 'a spread of one'],
740 < 1     ["const ENV = simEnv({ bin })\nspawnSync('git', ['status'], { env: ENV })", 'an identifier bound to one'],
741 < 1     ["const bootEnv = (ctx, env) => ({ ...simEnv({ bin: ctx.bin, home: ctx.home }), ...env })\nspawn('bash', [script], { env: bootEnv(ctx, env) })",
742 < 1       'a helper whose body spreads one'],
743 < 1   ]
744 < 1   for (const [source, why] of cases) {
745 < 1     const r = sweep(source, { file: '<case>' })
746 < 1     assert.deepEqual(named(r.inherit), [],
747 < 1       `(b) [M2] no offender for ${why}: ${JSON.stringify(source)} gave ${JSON.stringify(named(r.inherit))}`)
748 < 1   }
749 < 1 })
