835 < 2 // ── the sentinel ─────────────────────────────────────────────────────────────
836 < 2 
837 < 1 let failures = 0
838 < 1 for (const [name, fn] of tests) {
839 < 1   const started = Date.now()
840 < 1   try {
841 < 1     fn()
