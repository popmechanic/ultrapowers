334 < 1 // (h) [M4] readUsage's call count is gated on refreshCredential, and ordered before push
335 < 1 function orderedSpy (result, order, tag) {
336 < 1   const calls = []
337 < 1   const fn = (...args) => {
338 < 1     calls.push(args)
339 < 1     order.push(tag)
340 < 1     return result
341 < 1   }
342 < 1   fn.calls = calls
343 < 1   return fn
344 < 1 }
345 < 1 const pushOrderRule = (repo, order) => ({
346 < 1   when: (cmd, argv) => cmd === 'git' && argv.includes('push') && !argv.some((a) => /ultrapowers/.test(String(a))),
347 < 1   answer: (cmd, argv, options) => {
348 < 1     order.push('push')
349 < 1     return defaultExec('git', pointAtOrigin(repo, argv, repo.evidence), options ?? {})
350 < 1   }
351 < 1 })
352 < 1 {
353 < 1   const ws = workspace()
354 < 1   const order = []
355 < 1   const exec = makeExec({ rules: [pushOrderRule(ws.repo, order), ...readRules({ repo: ws.repo })] })
356 < 1   const readUsage = orderedSpy(rowAt(0, 0), order, 'readUsage')
357 < 1   const refreshCredential = () => ({ ok: false, refused: REFUSED_LINE })
358 < 1   await thrown(() => launchIn(ws, { exec, refreshCredential, readUsage }))
359 < 1   assert.equal(
360 < 1     readUsage.calls.length, 0,
361 < 1     '(h) [M4] a refused refreshCredential leaves readUsage at zero calls'
362 < 1   )
363 < 1   ws.cleanup()
364 < 1 }
365 < 1 {
366 < 1   const ws = workspace()
367 < 1   const order = []
368 < 1   const exec = makeExec({ rules: [pushOrderRule(ws.repo, order), ...readRules({ repo: ws.repo })] })
369 < 1   const readUsage = orderedSpy(rowAt(0, 0), order, 'readUsage')
370 < 1   const refreshCredential = () => ({ ok: true })
371 < 1   await launchIn(ws, { exec, refreshCredential, readUsage })
372 < 1   assert.equal(
373 < 1     readUsage.calls.length, 1,
374 < 1     '(h) [M4] an ok refreshCredential leaves readUsage at exactly one call'
375 < 1   )
376 < 1   const readUsageIdx = order.indexOf('readUsage')
377 < 1   const pushIdx = order.indexOf('push')
378 < 1   assert.ok(readUsageIdx >= 0, '(h) [M4] readUsage was recorded in the call order')
379 < 1   assert.ok(pushIdx >= 0, '(h) [M4] a git push was recorded in the call order')
380 < 1   assert.ok(
381 < 1     readUsageIdx < pushIdx,
382 < 1     `(h) [M4] readUsage ran before the first git push — order was ${JSON.stringify(order)}`
383 < 1   )
384 < 1   ws.cleanup()
385 < 1 }
386 < 1 
387 < 1 // (i) [M5] fleet/CONTRACT.md names the usage read and the launch line — the
388 < 1 // two `grep` legs of the Proof, run here as substring checks over the file.
389 < 1 {
390 < 1   const contract = fs.readFileSync(path.join(FLEET_DIR, 'CONTRACT.md'), 'utf8')
391 < 1   assert.ok(
392 < 1     contract.includes('no-rotate'),
393 < 1     '(i) [M5] CONTRACT.md names the --no-rotate usage read (grep -q \'no-rotate\')'
394 < 1   )
395 < 1   assert.ok(
396 < 1     contract.includes('usage: <account> 7d'),
397 < 1     '(i) [M5] CONTRACT.md\'s launch-line list names the usage: line (grep -qF \'usage: <account> 7d\')'
398 < 1   )
399 < 1 }
