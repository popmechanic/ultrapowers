970 < 1 
971 < 2 /** A hub that could not be asked: first, because every line below was read another way. */
972 < 2 const renderHub = (h) =>
973 < 2   `hub ${h.host ?? 'none'} unreachable (${h.dark}) — every run read from the evidence repository instead`
974 < 2 
975 < 1 const renderJanitor = (result) => {
976 < 1   const lines = [
977 < 2     ...(result.hub?.dark ? [renderHub(result.hub)] : []),
978 < 1     ...(result.deaths ?? []).map((d) => renderDeath(d, result.dryRun)),
979 < 1     ...(result.actions ?? []).map((a) => renderAction(a, result.dryRun)),
980 < 1     // After every rm and before every stale line: what was removed, then what
981 < 1     // never will be, then what wants a look.
982 < 1     ...(result.kept ?? []).map(renderKept),
983 < 1     ...(result.stale ?? []).map((s) => `stale ${s.vm}  run=${s.run} state=${s.state ?? 'none'} last update ${s.lastUpdate} (${s.from}) — look before you rm`),
984 < 1     ...(result.pending ?? []).map((p) => `pending ${p.vm}  run=${p.run} state=${p.state ?? 'none'} reapable at ${p.reapableAt}`),
985 < 1     ...(result.unknown ?? []).map((u) => `unknown ${u.vm}  no readable assignment — look before you rm`),
987 > 1     ...(result.unread ?? []).map((u) => renderUnread(u, result.evidence ?? null)),
986 < 1     // Last, after every rm, stale and unknown line: the target's branches,
987 < 1     // then the evidence repository's close-outs.
988 < 1     ...(result.branches ?? []).map((b) => renderBranch(b, result.dryRun)),
990 > 1     ...(result.closedOut ?? []).map((c) => renderClosedOut(c, result.dryRun)),
991 < 1     ...(result.sealed ?? []).map((s) => renderSealed(s, result.dryRun))
989 < 2     ...(result.closedOut ?? []).map((c) => renderClosedOut(c, result.dryRun))
990 < 1   ]
991 < 1   return lines.length === 0 ? 'nothing to do' : lines.join('\n')
992 < 1 }
