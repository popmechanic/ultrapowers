0 < 1 #!/usr/bin/env node
1 < 1 /**
2 < 1  * fleet/janitor.mjs — reap finished runs; write the deaths; report stale ones.
3 < 1  *
4 < 1  *   node fleet/janitor.mjs [--age 1h] [--target <owner>/<repo>] [--dry-run] [--json] [--help]
5 < 1  *
7 > 1  * The contract is `fleet/CONTRACT.md` §Janitor: what a pass reads (the run's
9 > 1  * status page in the evidence repository), what
8 < 2  * status page in the evidence repository; the kata hub only when
9 < 2  * `fleet/policy.json`'s `janitor.record.source` is rolled back to `kata`), what
10 < 1  * it removes (a finished run's VM after `--age`, an integration branch nothing
11 < 1  * merged), what it writes (a dead or orphaned run's end, then the seal; the
12 < 1  * seal alone for a run that ended without one) and what it only reports
13 < 1  * (`kept`, `unknown`, `unread`, `stale`). This header does not restate it
14 < 1  * (#1444); the comments below say why the code is shaped the way it is.
6 < 2  * The contract is `fleet/CONTRACT.md` §Janitor: what a pass reads (the hub
7 < 2  * first, the evidence repository when the hub is dark), what it removes (a
8 < 2  * finished run's VM after `--age`, an integration branch nothing merged), what
9 < 2  * it writes (a dead or orphaned run's end, then the seal) and what it only
10 < 2  * reports (`kept`, `unknown`, `stale`). This header does not restate it (#1444);
11 < 2  * the comments below say why the code is shaped the way it is.
12 < 1  *
13 < 1  * Nothing schedules it: `fleet/launch.mjs` runs it before every launch, and it
14 < 1  * is run by hand after the laptop has been asleep. `--dry-run` issues every
15 < 1  * read and no write.
16 < 1  */
17 < 1 
18 < 1 import { Buffer } from 'node:buffer'
20 > 2 import fs from 'node:fs'
19 < 1 import path from 'node:path'
20 < 1 import { fileURLToPath } from 'node:url'
21 < 1 
22 < 2 import { projectNamed, runIssueOf } from './kata-client.mjs'
23 < 1 import {
24 < 1   DEFAULT_CONFIG_PATH,
25 < 1   PLAN_FILE,
26 < 1   Refusal,
27 < 1   defaultExec,
28 < 1   evidenceUrlFor,
29 < 1   git,
30 < 2   hubFromEnv,
31 < 1   integrationBranchFor,
32 < 1   isFullSha,
33 < 1   isRunNumber,
34 < 1   isSafeTarget,
35 < 1   isVmName,
36 < 1   listVms,
37 < 1   liveBranchFor,
38 < 1   lobby,
39 < 1   LobbyError,
40 < 1   output,
41 < 1   parseArgs,
42 < 1   parseComment,
43 < 1   parseDuration,
44 < 1   parseJson,
46 > 2   policyCell,
45 < 1   readEvidenceSetting,
46 < 1   runCli,
47 < 1   runFolderFor,
48 < 1   runOfBranch,
49 < 1   runOfEvidenceRef,
50 < 1   runOfVmName,
52 > 1   runTagFor
51 < 2   runTagFor,
52 < 2   targetSlug
53 < 1 } from './lobby.mjs'
54 < 1 
55 < 1 export const USAGE = 'usage: node fleet/janitor.mjs [--age 1h] [--target <owner>/<repo>] [--dry-run] [--json] [--help]'
56 < 1 
57 < 1 export const usage = () => USAGE
58 < 1 
60 > 1 /** The states of a status page that mean the run is over and its VM is ballast. */
59 < 2 /**
60 < 2  * The states that mean the run is over and its VM is ballast — the same three
61 < 2  * words wherever a run's finish is read: the status page's `state`, and the run
62 < 2  * issue's own `work.state` (#964).
63 < 2  */
64 < 1 export const REAPABLE_STATES = Object.freeze(['done', 'parked', 'failed'])
65 < 1 /** Page states that claim the run is still in flight — the ones worth a probe. */
66 < 1 const LIVE_STATES = Object.freeze(['booting', 'running', 'publishing'])
67 < 1 /** How long a finished run keeps its VM, so its status page can still be read. */
68 < 1 const DEFAULT_AGE = '1h'
69 < 1 /** No status update for this long is a stale run, reported and left alone. */
70 < 1 const STALE_MS = 6 * 60 * 60 * 1000
71 < 1 /**
72 < 1  * The hour is for the operator to read a status page before the run is
73 < 1  * reaped: `reapPlan({finished, updatedAt, nowMs, ageMs})` names the moment a
74 < 1  * finished run crosses it, without mutating anything. `updatedAt` that does
75 < 1  * not parse, or a run not yet `finished`, answers `none` — there is nothing
76 < 1  * to name a time for.
77 < 1  */
78 < 1 const reapPlan = ({ finished, updatedAt, nowMs, ageMs }) => {
79 < 1   const updated = Date.parse(String(updatedAt))
80 < 1   if (!Number.isFinite(updated) || finished !== true) return { action: 'none', reapableAt: null }
81 < 1   const at = updated + ageMs
82 < 1   return nowMs >= at
83 < 1     ? { action: 'rm', reapableAt: new Date(at).toISOString() }
84 < 1     : { action: 'pending', reapableAt: new Date(at).toISOString() }
85 < 1 }
86 < 1 /**
88 > 1  * The comment that takes a VM out of the reap: the hub VM's own comment ends
89 < 1  * `persistent service, do not reap`. The guard matches this substring,
90 < 1  * case-sensitively, so any row someone marks by hand is kept the same way.
87 < 2  * The comment that takes a VM out of the reap. The hub's own comment is
88 < 2  * `kata hub — persistent service, do not reap`, and `fleet/kata-hub.mjs` writes
89 < 2  * it; the guard matches this substring, case-sensitively, so any row someone
90 < 2  * marks by hand is kept the same way.
91 < 1  */
92 < 1 const NEVER_REAP = 'do not reap'
93 < 2 /** The actor every hub write of the janitor's carries. */
94 < 2 const HUB_ACTOR = 'janitor'
95 < 2 /** The idempotency key of the one hub write: a re-driven death is the same patch. */
96 < 2 const deathKeyFor = (run) => `janitor:run-${run}:death`
97 < 2 
98 < 2 /**
99 < 2  * The three keys a run's issue carries about itself, spelled as kata stores
100 < 2  * them: FLAT, dotted name and all (#960). `metadata.work.state` reads nothing —
101 < 2  * there is no `work` object — so every read and every write here goes through
102 < 2  * `metadata['work.state']`.
103 < 2  */
104 < 2 const STATE_KEY = 'work.state'
105 < 2 const ATTENTION_KEY = 'work.attention'
106 < 2 const ATTENTION_MSG_KEY = 'work.attention_msg'
107 < 2 /** What a death writes into those keys: the state, and the hand it raises. */
108 < 2 const DEATH_STATE = 'failed'
109 < 2 const DEATH_ATTENTION = 'needs-human'
110 < 2 
112 > 2 // ── The switch: where a pass reads a run's end ──────────────────────────────
113 < 2 
114 < 2 /**
115 < 2  * `evidence`: the run's status page in the evidence repository, and the hub is
116 < 2  * never asked. `kata`: the rollback — the hub first, the evidence repository
117 < 2  * for a row the hub cannot answer, as every pass read before 2026-11-13.
118 < 2  */
119 < 2 export const RECORD_SOURCES = Object.freeze(['evidence', 'kata'])
120 < 2 const POLICY_PATH = path.join(path.dirname(fileURLToPath(import.meta.url)), 'policy.json')
121 < 2 
122 < 2 /**
123 < 2  * The `janitor.record.source` cell of the `policy.json` beside this file. A
124 < 2  * file that cannot be read, or a cell that names neither source, is the
125 < 2  * default: `evidence`.
126 < 2  */
128 > 2 export const recordSourceOf = (policyPath) => policyCell(['janitor', 'record', 'source'], RECORD_SOURCES, policyPath)
127 < 2 export function recordSourceOf (policyPath = POLICY_PATH) {
128 < 2   try {
129 < 2     const source = JSON.parse(fs.readFileSync(policyPath, 'utf8'))?.janitor?.record?.source
130 < 2     return RECORD_SOURCES.includes(source) ? source : RECORD_SOURCES[0]
131 < 2   } catch {
132 < 2     return RECORD_SOURCES[0]
133 < 2   }
134 < 2 }
135 < 2 
136 < 2 /** The hub of a pass that asks no hub: no client, no host, nothing dark. */
137 < 2 const NO_HUB = () => ({ client: null, host: null, dark: null })
138 < 2 
139 < 2 // ── The rollback: the run's state, asked of kata ────────────────────────────
111 < 2 // ── The hub: the run's state, asked of kata ─────────────────────────────────
112 < 2 
113 < 2 /**
114 < 2  * The hub as the janitor holds it: `client` (null when there is none), `host`
115 < 2  * (the ssh destination, for the report) and `dark` — null while the hub is
116 < 2  * answering, else the first reason it could not, kept for the pass. An
117 < 2  * injected `kata` is the client (`null` for "no hub" outright — a sim's, or the
118 < 2  * launcher's); with none, `~/.ultrapowers/kata-hub.env`
119 < 2  * is read and the client built on its host, exactly as the launcher builds
120 < 2  * its own. An env file that is absent or names no host is not a refusal here:
122 > 2  * a pass with no hub reads the evidence repository, and says so.
121 < 2  * a reaper with no hub reads the target, and says so.
122 < 2  */
123 < 2 async function openHub ({ exec, kata, kataEnvPath }) {
124 < 2   if (kata !== undefined) return { client: kata, host: kata?.host ?? null, dark: null }
125 < 2   const hub = await hubFromEnv({ exec, actor: HUB_ACTOR, kataEnvPath })
126 < 2   if (hub.client === null) return { client: null, host: null, dark: hub.dark }
127 < 2   return { client: hub.client, host: hub.host, dark: null }
128 < 2 }
129 < 2 
130 < 2 /** The first line of what went wrong, for a report line and nothing longer. */
131 < 2 const reasonOf = (error) => String(error?.message ?? error).split('\n')[0].trim()
132 < 2 
133 < 2 /**
134 < 2  * The finish an OPEN issue carries about itself, or null when it carries none:
135 < 2  * `work.state`, read flat, and only when it names one of the three states that
136 < 2  * mean the run is over. Anything else there — a run in flight's own word, a
137 < 2  * value nobody here knows — is not a finish, and the row is read as open.
138 < 2  */
139 < 2 const markedFinishOf = (issue) => {
140 < 2   const value = issue?.metadata?.[STATE_KEY]
141 < 2   return typeof value === 'string' && REAPABLE_STATES.includes(value) ? value : null
142 < 2 }
143 < 2 
144 < 2 /**
145 < 2  * What the hub says about one run, as the row loop reads it: `finished`,
146 < 2  * `live`, `state`, `updatedAt`, `from`, and the project and issue a death
147 < 2  * would mark. A run is finished when its issue is `closed` OR when an open
148 < 2  * issue's `work.state` says so — the park is the case that needs the second
149 < 2  * reading, since a parked run's issue stays open and its VM is ballast all the
150 < 2  * same (#964). `closed_at` is the age of a closed issue and `updated_at` of
151 < 2  * every other row — a closed issue's `updated_at` moves with later comments,
152 < 2  * and the reap's clock is the close; a marked issue's is the mark, which is
153 < 2  * the last thing that touched it.
154 < 2  */
155 < 2 const readingOfIssue = (project, issue) => {
156 < 2   const closed = issue.status === 'closed'
157 < 2   const marked = closed ? null : markedFinishOf(issue)
158 < 2   const updatedAt = closed
159 < 2     ? (typeof issue.closed_at === 'string' ? issue.closed_at : issue.updated_at)
160 < 2     : issue.updated_at
161 < 2   return {
162 < 2     source: 'hub',
163 < 2     finished: closed || marked !== null,
164 < 2     // A marked run is not in flight, so no unit is probed for it: the record
165 < 2     // already says how it ended, and the probe is only ever a cross-check of a
166 < 2     // record that claims the run is still going.
167 < 2     live: issue.status === 'open' && marked === null,
168 < 2     state: closed ? String(issue.closed_reason ?? 'closed') : (marked ?? String(issue.status ?? 'open')),
169 < 2     updatedAt: typeof updatedAt === 'string' ? updatedAt : null,
170 < 2     from: `kata:${project.name}`,
171 < 2     project,
172 < 2     issue
173 < 2   }
174 < 2 }
175 < 2 
176 < 2 /**
177 < 2  * The hub reader for one pass. The projects listing is fetched once, on the
178 < 2  * first row that needs it, and every error darkens the hub for the rest of
179 < 2  * the pass — one dark read costs one ssh timeout, not one per row. A `null`
180 < 2  * answer means "not from the hub": the caller reads the evidence for that row.
181 < 2  */
182 < 2 function hubReader (hub) {
183 < 2   let listing = null
184 < 2   const darken = (error) => {
185 < 2     if (hub.dark === null) hub.dark = reasonOf(error)
186 < 2   }
187 < 2   return async (target, run, plan) => {
188 < 2     if (hub.client === null || hub.dark !== null) return null
189 < 2     try {
190 < 2       if (listing === null) listing = await hub.client.listProjects()
191 < 2       const project = projectNamed(listing, targetSlug(target))
192 < 2       if (project === null) return null
193 < 2       const json = await hub.client.listIssues(project.id)
194 < 2       const issues = Array.isArray(json?.issues) ? json.issues : []
195 < 2       const issue = runIssueOf(issues, run, plan ?? null)
196 < 2       return issue === null ? null : readingOfIssue({ id: project.id, uid: project.uid, name: project.name }, issue)
197 < 2     } catch (error) {
198 < 2       darken(error)
199 < 2       return null
200 < 2     }
201 < 2   }
202 < 2 }
203 < 2 
205 > 1 // ── The record: the run's page, read off the evidence repository ────────────
204 < 2 // ── The fallback: the run's page, read off the evidence repository ──────────
205 < 1 
206 < 1 /**
207 < 1  * One `gh api <path>` on the laptop, through the exec seam. An absent file is
208 < 1  * exit 1 with `HTTP 404`, which is an answer and not a failure — every reader
209 < 1  * here gets `null` for it and decides for itself what an absence means.
210 < 1  */
211 < 1 export const ghApi = async (exec, apiPath) => {
212 < 1   const res = await exec('gh', ['api', apiPath])
213 < 1   return res.code === 0 ? parseJson(res.stdout) : null
214 < 1 }
215 < 1 
216 < 1 /**
217 < 1  * A list read that follows every page: `--paginate --slurp` answers an array
218 < 1  * of pages, flattened here into one array. A one-page answer (or a stub's bare
219 < 1  * array) flattens to itself; anything that is not an array is null, as above.
220 < 1  */
221 < 1 const ghList = async (exec, apiPath) => {
222 < 1   const res = await exec('gh', ['api', '--paginate', '--slurp', apiPath])
223 < 1   const payload = res.code === 0 ? parseJson(res.stdout) : null
224 < 1   return Array.isArray(payload) ? payload.flat() : null
225 < 1 }
226 < 1 
227 < 1 /**
228 < 1  * One file of a run's evidence, as the contents API addresses it: in the
229 < 1  * operator's evidence repository (#1395), under the TARGET's run folder.
230 < 1  */
231 < 1 const contentsPath = (evidence, target, run, file) =>
232 < 1   `repos/${evidence}/contents/${runFolderFor(target, run)}/${file}`
233 < 1 
234 < 1 /**
235 < 1  * The run's status page at one ref. The answer is the contents envelope —
236 < 1  * base64 under `content` — and nothing else is accepted: a bare status
237 < 1  * document would mean `gh` answered something other than the contents API, and
238 < 1  * guessing there is how a janitor reaps on a payload it never read. A missing
239 < 1  * envelope is `null`, which is what sends the reader on to the next ref; an
240 < 1  * envelope whose content is not a JSON object is an answer all the same, and
241 < 1  * carries a null `page` so no second ref is read behind a ref that spoke.
242 < 1  */
243 < 1 export async function readContentsAt (exec, evidence, target, run, ref) {
244 < 1   const payload = await ghApi(exec, `${contentsPath(evidence, target, run, 'status.json')}?ref=${ref}`)
245 < 1   if (!payload || typeof payload.content !== 'string') return null
246 < 1   const decoded = parseJson(Buffer.from(payload.content, 'base64').toString('utf8'))
247 < 1   const page = decoded && typeof decoded === 'object' ? decoded : null
248 < 1   // The envelope's `sha` is the blob as it sits on that ref, and a write of
249 < 1   // this file needs it: the page alone cannot be put back.
250 < 1   return { page, sha: typeof payload.sha === 'string' ? payload.sha : null, from: ref }
251 < 1 }
252 < 1 
253 < 1 /**
254 < 1  * The run's status page as the row loop reads it: the run's tag first, its
255 < 1  * live branch only behind a tag that answered no envelope. Null when neither
256 < 1  * ref has a page, and null without a read when there is no evidence
257 < 1  * repository to read.
258 < 1  */
259 < 1 async function evidenceReading (exec, evidence, target, run) {
260 < 1   if (evidence === null) return null
261 < 1   const found = await readContentsAt(exec, evidence, target, run, runTagFor(target, run)) ??
262 < 1     await readContentsAt(exec, evidence, target, run, liveBranchFor(target, run))
263 < 1   if (found === null || found.page === null) return null
264 < 1   const state = typeof found.page.state === 'string' ? found.page.state : null
265 < 1   return {
266 < 2     source: 'evidence',
267 < 1     finished: REAPABLE_STATES.includes(state),
268 < 1     live: LIVE_STATES.includes(state),
269 < 1     state,
270 < 1     updatedAt: typeof found.page.updatedAt === 'string' ? found.page.updatedAt : null,
271 < 1     from: found.from,
272 < 1     page: found.page,
273 < 1     sha: found.sha
274 < 1   }
275 < 1 }
276 < 1 
277 < 1 /**
278 < 1  * One `gh api -X PUT <contents path>` — the contents API's update, whose body
279 < 1  * is `message`, `content` (base64), `branch` and, for a file that already
280 < 1  * exists, the `sha` it was read at. `-f` is gh's string-field flag, one field
281 < 1  * per pair, so the path stays the first argv element beginning `repos/`.
282 < 1  */
283 < 1 const ghPut = (exec, apiPath, { branch, message, content, sha = null }) => {
284 < 1   const argv = [
285 < 1     'api', '-X', 'PUT', apiPath,
286 < 1     '-f', `branch=${branch}`,
287 < 1     '-f', `message=${message}`,
288 < 1     '-f', `content=${Buffer.from(content, 'utf8').toString('base64')}`
289 < 1   ]
290 < 1   // A new file carries no `sha`; sending one for a file that is not there is a
291 < 1   // 422, and omitting one for a file that is is the other 422.
292 < 1   if (sha !== null) argv.push('-f', `sha=${sha}`)
293 < 1   return exec('gh', argv)
294 < 1 }
295 < 1 
296 < 1 /**
297 < 1  * A row's assignment: the run, the target, and the plan its comment carries
298 < 1  * (`null` when the comment names none, or names something other than a
299 < 1  * 40-hex sha), or null when the comment is absent or says nothing this tool
300 < 1  * can read. The comment's `run=` is the run; the name's is the fallback,
301 < 1  * since the name is only where the run is running this time. The plan is how
302 < 1  * the janitor tells a colliding launch's abandoned run issue from the run
303 < 1  * that actually won the number (#1036, `runIssueOf`).
304 < 1  */
305 < 1 function assignmentOf (row) {
306 < 1   if (!isVmName(row.name)) return null
307 < 1   const fields = parseComment(row.comment)
308 < 1   const run = isRunNumber(fields.run) ? Number(fields.run) : runOfVmName(row.name)
309 < 1   const target = isSafeTarget(fields.target) ? fields.target : null
310 < 1   if (run === null || target === null) return null
311 < 1   const plan = isFullSha(fields.plan) ? fields.plan : null
312 < 1   return { run, target, plan }
313 < 1 }
314 < 1 
315 < 1 /**
316 < 1  * Is this row's comment the operator's "leave it alone"? The raw string is
317 < 1  * read, not the parsed fields: the sentence is prose a person wrote, and a row
318 < 1  * that also carries `run=` and `target=` is kept all the same.
319 < 1  */
320 < 1 const saysNeverReap = (row) => String(row?.comment ?? '').includes(NEVER_REAP)
321 < 1 
322 < 1 // ── The one VM read: is the run's unit still there? ─────────────────────────
323 < 1 
324 < 1 /** The systemd user unit one run is, on its own VM. */
325 < 1 const unitOf = (run) => `fleet-run@${run}.service`
326 < 1 
327 < 1 /** The four properties that say whether a unit is alive, done or dead. */
328 < 1 const UNIT_PROPERTIES = Object.freeze(['ActiveState', 'SubState', 'Result', 'ExecMainStatus'])
329 < 1 
330 < 1 /**
331 < 1  * `$(id -u)` is expanded by the VM's shell, not the laptop's, so it travels as
332 < 1  * text: the janitor never spawns a shell, and `exec` hands this whole string to
333 < 1  * `ssh` as one argv element.
334 < 1  */
335 < 1 const showUnitCommand = (run) =>
336 < 1   `XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user show ${unitOf(run)} ` +
337 < 1   UNIT_PROPERTIES.map((p) => `-p ${p}`).join(' ')
338 < 1 
339 < 1 /** The contract's own journal literal: a field match asks the journal directly. */
340 < 1 const journalCommand = (run) => `journalctl _SYSTEMD_USER_UNIT=${unitOf(run)} --no-pager -n 200`
341 < 1 
342 < 1 /**
343 < 1  * One command on one VM. `BatchMode` refuses to ask for a password and
344 < 1  * `ConnectTimeout` bounds a dark VM at fifteen seconds — `fleet/launch.mjs`
345 < 1  * runs the janitor before every launch, and a VM that is off must cost a launch
346 < 1  * those seconds, not hang it. The destination is the row's own `ssh_dest`,
347 < 1  * handed to `ssh` as its own argv element and never spliced into a string.
348 < 1  */
349 < 1 const onVm = (exec, dest, command) =>
350 < 1   exec('ssh', ['-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15', dest, command])
351 < 1 
352 < 1 /**
353 < 1  * The run's unit as `systemctl show` reports it, or null when it cannot be
354 < 1  * read: a non-zero exit (a dark VM, a refused connection, a timeout), an empty
355 < 1  * answer, or an answer with no `ActiveState` in it. Unreadable is not dead —
356 < 1  * the row is then left exactly as it would have been without this read.
357 < 1  */
358 < 1 async function readUnit (exec, dest, run) {
359 < 1   const res = await onVm(exec, dest, showUnitCommand(run))
360 < 1   if (res.code !== 0) return null
361 < 1   const unit = {}
362 < 1   for (const line of String(res.stdout ?? '').split('\n')) {
363 < 1     const at = line.indexOf('=')
364 < 1     if (at === -1) continue
365 < 1     const key = line.slice(0, at).trim()
366 < 1     if (UNIT_PROPERTIES.includes(key)) unit[key] = line.slice(at + 1).trim()
367 < 1   }
368 < 1   return typeof unit.ActiveState === 'string' && unit.ActiveState !== '' ? unit : null
369 < 1 }
370 < 1 
371 < 1 /**
372 < 1  * The unit is dead when systemd says so — `ActiveState=failed` — or when it was
373 < 1  * killed by its own runtime budget, which leaves `Result=timeout` behind
374 < 1  * whatever `ActiveState` the corpse settled into.
375 < 1  */
376 < 1 const unitIsDead = (unit) => unit.ActiveState === 'failed' || unit.Result === 'timeout'
377 < 1 
378 < 1 /** The unit's four properties as one line, in the order `systemctl` names them. */
379 < 1 const unitSummary = (unit) => UNIT_PROPERTIES
380 < 1   .filter((p) => unit[p] !== undefined)
381 < 1   .map((p) => `${p}=${unit[p]}`)
382 < 1   .join(' ')
383 < 1 
385 > 1 /** What the written page says happened, in the page's own `error` cell. */
386 < 1 const deathError = (run, unit, state) =>
387 < 1   `janitor: ${unitOf(run)} ${unitSummary(unit)} while the page said ${state}`
384 < 2 /**
385 < 2  * What the written page says happened, in the page's own `error` cell — and
386 < 2  * the hub close's message, which kata wants forty characters long. `said` is
387 < 2  * `page` for a row read off the evidence and `hub` for one the hub answered.
388 < 2  */
389 < 2 const deathError = (run, unit, state, said) =>
390 < 2   `janitor: ${unitOf(run)} ${unitSummary(unit)} while the ${said} said ${state}`
391 < 1 
392 < 1 // ── A run's end, written for it ─────────────────────────────────────────────
393 < 1 
394 < 1 /** The `error` a close-out writes: a run no VM carries, whose page said live. */
395 < 1 export const CLOSE_OUT_ERROR = 'reaped before the run recorded its end'
396 < 1 
397 < 1 /**
398 < 1  * Seal run `run` of `target` in `evidence`: the tag `<slug>/run-<N>` cut at
399 < 1  * the live branch's head through GitHub's refs API, read back to verify it
400 < 1  * names that sha, and only then the live branch deleted. An answer that the
401 < 1  * reference already exists is the tag being there, and the read-back decides.
402 < 1  * Any refusal keeps the branch and says so: `{ tagged, deleted, reason? }`.
403 < 1  */
404 < 1 export async function sealRun ({ exec = defaultExec, evidence, target, run }) {
405 < 1   const branch = liveBranchFor(target, run)
406 < 1   const tag = runTagFor(target, run)
407 < 1   const saidBy = (res) => output(res).split('\n')[0]
408 < 1   const head = await exec('gh', ['api', `repos/${evidence}/git/ref/heads/${branch}`])
409 < 1   const sha = head.code === 0 ? parseJson(head.stdout)?.object?.sha : null
