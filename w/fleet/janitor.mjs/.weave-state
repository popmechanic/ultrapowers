940 < 1 }
941 < 1 
942 < 1 const renderAction = (a, dryRun) =>
943 < 1   `${dryRun ? 'would ' : ''}rm ${a.vm}  run=${a.run} ${a.state} since ${a.updatedAt}` +
944 < 1   (a.error === undefined ? '' : ` (failed: ${a.error})`)
945 < 1 
946 < 2 /** A hub-read death also names the hub: marked, would be marked, or refused. */
947 < 2 const renderDeathHub = (d, dryRun) => {
948 < 2   if (d.hubMarked === undefined) return ''
949 < 2   if (d.hubMarked || dryRun) return ' and the hub'
950 < 2   return ` (hub not marked: ${d.hubError ?? 'unknown'})`
951 < 2 }
952 < 2 
953 < 1 const renderDeath = (d, dryRun) =>
954 < 1   `${dryRun ? 'would write death' : 'death'} ${d.vm}  run=${d.run} ` +
956 > 1   `${d.state} → failed: ${unitSummary(d.unit)} — ${liveBranchFor(d.target, d.run)}`
955 < 2   `${d.state} → failed: ${unitSummary(d.unit)} — ${liveBranchFor(d.target, d.run)}` +
956 < 2   renderDeathHub(d, dryRun)
957 < 1 
958 < 1 /** #724: a branch nothing merged, deleted (or, dry, to be). */
959 < 1 const renderBranch = (b, dryRun) =>
960 < 1   `${dryRun ? 'would delete' : b.deleted ? 'deleted' : 'kept'} branch ${b.branch}  ` +
961 < 1   `target=${b.target} PR #${b.pr} closed, not merged` +
962 < 1   (b.error === undefined ? '' : ` (delete failed: ${b.error})`)
963 < 1 
964 < 1 /** #1314: a run no VM carried, whose page said live, written (or not) as failed. */
