966 < 1   `${dryRun ? 'would close out' : 'closed out'} run=${c.run} target=${c.target} ${c.state} → failed`
967 < 1 
969 > 1 /** A run that ended with its live branch left and no seal: sealed, to be, or refused. */
970 < 1 const renderSealed = (s, dryRun) => {
971 < 1   const what = `run=${s.run} target=${s.target} ${s.state}`
972 < 1   if (dryRun) return `would seal ${what} — its live branch is still there`
973 < 1   if (s.sealed) return `sealed ${what} — tag ${runTagFor(s.target, s.run)} cut, live branch deleted`
974 < 1   return `not sealed ${what} — ${s.reason ?? 'unknown'}`
975 < 1 }
976 < 1 
977 < 1 /** A row whose record could not be read: where it was looked for, and that the VM stays. */
978 < 1 const renderUnread = (u, evidence) =>
979 < 1   `unread ${u.vm}  run=${u.run} ` +
980 < 1   (evidence === null
981 < 1     ? 'no evidence repository is set ("evidence" in ~/.ultrapowers/fleet.json)'
982 < 1     : `no status page in ${evidence} at ${runTagFor(u.target, u.run)} or ${liveBranchFor(u.target, u.run)}`) +
983 < 1   ' — left alone'
984 < 1 
968 < 1 /** A row the reap never touches, and why — the comment itself said so. */
