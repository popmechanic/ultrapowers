879 < 1 /**
880 < 1  * A launch's reap and duplicate check (#1437): `fleet/launch.mjs` calls it
882 > 1  * before the run number is read. Answers
881 < 2  * after the hub's ping and before the run number is read. Answers
882 < 1  * `{ reaped, reapError, again }` — the VMs this pass removed, why the pass
883 < 1  * failed (or null), and the live runs of this plan that `again` let through —
884 < 1  * or throws the launcher's own refusal.
885 < 1  *
886 < 1  * Nothing schedules the janitor, so every launch is where it runs — before
887 < 1  * the run number is read, so the fleet a launch joins is already clear of the
889 > 1  * VMs of runs that finished over an hour ago. A reap that fails is reported and not fatal: the run
888 < 2  * VMs of runs that finished over an hour ago. `hub` is the client the launch
890 > 2  * built: the janitor asks it only under the `kata` rollback, so that pass asks
891 < 2  * the hub the launch already reached. A reap that fails is reported and not fatal: the run
889 < 2  * built, so the janitor asks the hub the launch already reached — or, with no
890 < 2  * hub, reads the target. A reap that fails is reported and not fatal: the run
891 < 1  * being launched is worth more than the ballast the janitor came for.
892 < 1  */
893 < 1 export async function preflight ({
895 > 1   exec = defaultExec, now = () => new Date(), evidence, repoDir, target, planText, again = false
894 < 2   exec = defaultExec, now = () => new Date(), hub, evidence, repoDir, target, planText, again = false
895 < 1 }) {
896 < 1   const reaped = []
897 < 1   let reapError = null
898 < 1   let fleetRuns = null
899 < 1   try {
901 > 1     const reap = await janitor({ argv: [], exec, now, evidence })
900 < 2     const reap = await janitor({ argv: [], exec, now, kata: hub, evidence })
901 < 1     fleetRuns = Array.isArray(reap.runs) ? reap.runs : []
902 < 1     for (const action of reap.actions) {
903 < 1       if (action.kind === 'rm' && action.applied === true) reaped.push(action.vm)
904 < 1     }
905 < 1   } catch (error) {
906 < 1     reapError = String(error?.message ?? error) || 'launch: the reap failed'
907 < 1   }
908 < 1 
909 < 1   // A reap that failed leaves no fleet list for the duplicate guard (#1036) to
910 < 1   // read — refuse rather than launch with the guard silently skipped, unless
911 < 1   // the operator passed `--again` to launch without it.
912 < 1   if (fleetRuns === null && again !== true) {
913 < 1     throw new Refusal(
914 < 1       `launch: the reap did not answer, so the duplicate guard (#1036) cannot run — ${reapError}; ` +
915 < 1       'pass --again to launch without it'
916 < 1     )
917 < 1   }
918 < 1 
919 < 1   // ── The duplicate check (#1036). A plan that is already live on this target
920 < 1   //    is refused here, before the run number is read and before anything is
922 > 1   //    pushed: a second launch of the same plan is two sandboxes building one
923 < 1   //    change, and two pull requests for it. (Until 2026-11-13 it also killed
924 < 1   //    the first run, whose task issues on the kata hub the replay re-answered.)
925 < 1   //    "The same plan" is the plan text's git blob sha,
921 < 2   //    pushed: a second launch of the same plan re-answers the live run's task
922 < 2   //    issues on the hub and bumps their revision, and the first run dies at
923 < 2   //    Setup on `kata-revision-mismatch`. "The same plan" is the plan text's
924 < 2   //    git blob sha — the identity the hub's `Idempotency-Key` is built from —
925 < 1   //    never the comment's `plan=` commit, which carries the run number in its
926 < 1   //    subject and so differs on every launch. A row whose record says the run
927 < 1   //    ended never refuses, however recently; a row with no record yet counts
928 < 1   //    as live. When the reap itself failed there is no list and no refusal.
929 < 1   const duplicates = fleetRuns === null
930 < 1     ? []
