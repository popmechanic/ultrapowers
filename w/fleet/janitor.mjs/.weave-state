845 > 1     dryRun,
846 < 1     age,
847 < 2     record: source,
848 < 1     actions,
849 < 1     stale,
850 < 1     unknown,
851 < 1     unread,
852 < 1     deaths,
853 < 1     branches,
854 < 1     closedOut,
855 < 1     sealed,
856 < 1     kept,
857 < 1     pending,
858 < 2     hub: hubReport,
859 < 1     runs,
