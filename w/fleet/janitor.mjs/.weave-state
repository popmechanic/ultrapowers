994 < 1 async function main (argv) {
995 < 1   const { opts } = parseArgs(argv, { flags: ['dry-run', 'json', 'help'] })
996 < 1   // `--help` prints the usage and reaps nothing: an unknown flag used to be
997 < 1   // ignored, and a `--help` that ran a live pass is how three VMs went.
998 < 1   if (opts.help === true) {
999 < 1     process.stdout.write(`${USAGE}\n`)
1000 < 1     return
1001 < 1   }
1002 < 1   const result = await janitor({ argv })
1003 < 1   process.stdout.write(opts.json ? `${JSON.stringify(result)}\n` : `${renderJanitor(result)}\n`)
1004 < 1 }
