848 < 1 /**
849 < 1  * The rows of the janitor's `runs` list that carry this launch's plan on this
850 < 1  * launch's target and whose record does not say the run ended (#1036). The
851 < 1  * plan's identity is its text's blob sha: the launcher hashes `planText` with
852 < 1  * `git hash-object --stdin` (no `-w` — nothing is written before the refusal
853 < 1  * is decided), and reads each candidate row's `runs/<slug>/<N>/plan.md` blob
854 < 1  * off the run's own live branch, `live/<slug>/run-<N>`, fetched from the
855 < 1  * evidence repository into `FETCH_HEAD` (no ref of the checkout is written). A
856 < 1  * fetch or a `rev-parse` that fails means the branch is gone — the run is
857 < 1  * publishing or has published, and no engine reads its task issues any more —
858 < 1  * so that row is not a duplicate.
859 < 1  */
860 < 1 async function liveDuplicatesOf ({ exec, repoDir, target, evidence, planText, runs }) {
861 < 1   const candidates = runs.filter((r) => r.target === target && r.live !== false && isRunNumber(r.run))
862 < 1   if (candidates.length === 0) return []
863 < 1   const hashed = await exec('git', ['-C', repoDir, 'hash-object', '--stdin'], { input: planText })
864 < 1   if (hashed.code !== 0) return []
865 < 1   const wanted = String(hashed.stdout ?? '').trim()
866 < 1   const found = []
867 < 1   for (const row of candidates) {
868 < 1     const branch = liveBranchFor(target, row.run)
869 < 1     const fetched = await git(exec, repoDir, ['fetch', evidenceUrlFor(evidence), `refs/heads/${branch}`])
870 < 1     if (fetched.code !== 0) continue
871 < 1     const planFile = `${runFolderFor(target, row.run)}/${PLAN_FILE}`
872 < 1     const blob = await git(exec, repoDir, ['rev-parse', '--verify', '--quiet', `FETCH_HEAD:${planFile}`])
873 < 1     if (blob.code !== 0) continue
874 < 1     if (String(blob.stdout ?? '').trim() === wanted) found.push({ run: row.run, vm: row.vm })
875 < 1   }
876 < 1   return found
877 < 1 }
