0 < 1 #!/usr/bin/env bash
1 < 1 # fleet/reaper-key.sh — renew the key the hub removes finished VMs with, in one command.
2 < 1 #
3 < 1 #   bash fleet/reaper-key.sh
4 < 1 #
5 < 1 # The operator runs it; nothing is typed and the key is never printed. It mints a new exe.dev key
6 < 1 # that can only `rm` (label `hub-reaper-<date>-<time>`, one year), hands it to the hub-only
7 < 1 # `lobby-rm` integration on stdin, and then asks the hub's remover to remove a VM that does not
8 < 1 # exist: an answer other than `invalid token` means the remover holds a working key. On success it
9 < 1 # names the older `hub-reaper…` keys, which can then be deleted. Renewing by hand took five
10 < 1 # attempts on 2026-11-13 (a reused label, a paste into a waiting prompt, an empty stdin).
11 < 1 set -u
12 < 1 HUB="${KATA_HUB_HOST:-kata-hub.exe.xyz}"
13 < 1 label="hub-reaper-$(date -u +%Y-%m-%d-%H%M)"
14 < 1 hide() { sed -E 's/exe[0-9]+\.[A-Za-z0-9_-]+/<key hidden>/g'; }
15 < 1 probe() {
16 < 1   ssh -o BatchMode=yes -o ConnectTimeout=15 "$HUB" \
17 < 1     "curl -sS -m 30 -X POST https://lobby-rm.int.exe.xyz/exec -d 'rm fleet-r0-doesnotexist-zz --json'" 2>&1
18 < 1 }
19 < 1 
20 < 1 echo "1/3 making a new key, $label (it can only remove VMs, and lasts one year)"
21 < 1 out="$(ssh exe.dev "ssh-key generate-api-key --label=$label --cmds=rm --exp=1y" 2>&1)"
22 < 1 key="$(printf '%s\n' "$out" | grep -oE 'exe[0-9]+\.[A-Za-z0-9_-]{10,}' | head -n 1)"
23 < 1 if [ -z "$key" ]; then
24 < 1   echo "STOPPED: exe.dev's answer held no key. It said:"; printf '%s\n' "$out" | hide; exit 1
25 < 1 fi
26 < 1 
27 < 1 echo "2/3 handing it to the hub's remover"
28 < 1 for ending in newline none; do   # a key and a newline is the form that worked by hand on 2026-11-13
29 < 1   if [ "$ending" = none ]; then said="$(printf '%s' "$key" | ssh exe.dev "integrations edit lobby-rm --bearer=-" 2>&1)"
30 < 1   else said="$(printf '%s\n' "$key" | ssh exe.dev "integrations edit lobby-rm --bearer=-" 2>&1)"; fi
31 < 1   printf '%s\n' "$said" | hide | sed 's/^/    exe.dev: /'
32 < 1   echo "3/3 testing the remover from the hub"
33 < 1   for try in 1 2 3; do
34 < 1     sleep 3
35 < 1     answer="$(probe)"
36 < 1     case "$answer" in
37 < 1       *"invalid token"*) ;;
38 < 1       *) echo "WORKING: the hub's remover accepted the new key. It answered: $(printf '%s' "$answer" | hide | head -c 160)"
39 < 1          old="$(ssh exe.dev "ssh-key list --json" 2>/dev/null | grep -oE '"name": *"hub-reaper[^"]*"' | sed -E 's/.*"(hub-reaper[^"]*)"/\1/' | grep -vx "$label")"
40 < 1          if [ -n "$old" ]; then echo "Older keys you can now delete:"; for k in $old; do echo "    ssh exe.dev \"ssh-key remove $k\""; done; fi
41 < 1          exit 0 ;;
42 < 1     esac
43 < 1   done
44 < 1   echo "    the remover still answers invalid token; trying once more another way"
45 < 1 done
46 < 1 echo "NOT WORKING: the remover still answers invalid token with the new key $label."
47 < 1 echo "Nothing is worse than before. Tell Claude what this printed."
48 < 1 exit 1
49 < 1 