0 < 1 /**
1 < 1  * fleet/lobby.mjs — the laptop's half of the fleet, in one place.
2 < 1  *
3 < 1  * There is no orchestrator and no control VM. A run is a number N per target;
4 < 1  * its VM is `fleet-r<N>-<yymmddHHMM>-<4 hex>`, found again by `fleet-r<N>-*`.
5 < 1  * Where its plan and record live (the operator's evidence repository; the
6 < 1  * target receives only `ultra/integration-run-N`) is `fleet/CONTRACT.md`
7 < 1  * section "The shape in one paragraph"; this file does not restate it.
8 < 1  *
9 < 1  * This module is what the three laptop CLIs (`launch`, `janitor`, `target`)
10 < 1  * share: the exec seam, the config file, the name validators, the branch
12 > 1  * names and the lobby readers.
11 < 2  * names, the lobby readers, and the hub opened from its env file (`hubFromEnv`).
12 < 1  * It runs from the installed plugin cache, so every specifier is
14 > 1  * `node:`-prefixed, and there are no npm dependencies.
13 < 2  * `node:`-prefixed or `./kata-client.mjs` (itself import-free), and there are
14 < 2  * no npm dependencies.
15 < 1  *
16 < 1  * ## The exec seam
17 < 1  *
18 < 1  * One function, `exec(cmd, argv, options?)`, resolving `{ code, stdout, stderr }`
19 < 1  * and never rejecting. It is `execFile`, never a shell string: nothing this
20 < 1  * process builds is ever parsed by a local shell. `options.input` is the only
21 < 1  * way a secret reaches a child — written to its stdin, never to its argv. The
22 < 1  * exe.dev lobby still parses the remote half (`ssh exe.dev "new fleet-r7-… --json"`
23 < 1  * is one argv element), so every value interpolated into that string is
24 < 1  * validated first — `isSafeTarget`, `isFullSha`, `isRunNumber`, `isVmName` —
25 < 1  * and the only quoted field (the assignment comment) is built exclusively from
26 < 1  * validated parts.
27 < 1  */
28 < 1 
29 < 1 import { execFile } from 'node:child_process'
30 < 1 import { randomBytes } from 'node:crypto'
32 > 2 import fs from 'node:fs'
31 < 1 import fsp from 'node:fs/promises'
32 < 1 import os from 'node:os'
33 < 1 import path from 'node:path'
34 < 1 import { fileURLToPath } from 'node:url'
35 < 1 
36 < 2 import { makeKataClient, sshTransport } from './kata-client.mjs'
37 < 1 
38 < 1 // ── Names and shas ──────────────────────────────────────────────────────────
39 < 1 
40 < 1 /** `owner/repo`: exactly one slash, each half a git-safe name that starts and
41 < 1  *  ends with a letter or digit — the only shape that may be interpolated into
42 < 1  *  an ssh string, so `..` and a dot-led half are refused. */
43 < 1 const TARGET = /^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?\/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$/
44 < 1 export const isSafeTarget = (value) => typeof value === 'string' && TARGET.test(value)
45 < 1 
46 < 1 /** A git object name, as a pointer half. */
47 < 1 export const isSafeSha = (value) => typeof value === 'string' && /^[0-9a-f]{7,64}$/.test(value)
48 < 1 
49 < 1 /**
50 < 1  * The stricter shape the assignment comment carries. An abbreviation would let
51 < 1  * two clones resolve one `base=` differently — so `base=` and `engine=` are
52 < 1  * full shas or nothing.
53 < 1  */
54 < 1 export const isFullSha = (value) => isSafeSha(value) && value.length === 40
55 < 1 
56 < 1 /** A run number: a positive decimal integer with no leading zero. */
57 < 1 export const isRunNumber = (value) => /^[1-9][0-9]*$/.test(String(value))
58 < 1 
59 < 1 /**
60 < 1  * One incarnation of a run: `fleet-r<N>-<yymmddHHMM>-<4 hex>`. exe.dev does not
61 < 1  * reserve a deleted name, but a name is still minted once per launch and never
62 < 1  * derived from N alone — the run's durable identity is N, in the comment and in the
63 < 1  * target's three branches; the VM name is only where it is running this time.
64 < 1  */
65 < 1 const VM_NAME = /^fleet-r([1-9][0-9]*)-[0-9]{10}-[0-9a-f]{4}$/
66 < 1 
67 < 1 const stamp = (date) => {
68 < 1   const two = (n) => String(n).padStart(2, '0')
69 < 1   return `${String(date.getUTCFullYear()).slice(2)}${two(date.getUTCMonth() + 1)}${two(date.getUTCDate())}${two(date.getUTCHours())}${two(date.getUTCMinutes())}`
70 < 1 }
71 < 1 
72 < 1 export const vmNameFor = (run, now = new Date(), rand = randomBytes(2).toString('hex')) =>
73 < 1   `fleet-r${run}-${stamp(now)}-${rand}`
74 < 1 
75 < 1 export const isVmName = (value) => typeof value === 'string' && VM_NAME.test(value)
76 < 1 
77 < 1 /** The run number a VM name carries, or null when the name is not a run's. */
78 < 1 export const runOfVmName = (name) => {
79 < 1   const match = VM_NAME.exec(String(name ?? ''))
80 < 1   return match ? Number(match[1]) : null
81 < 1 }
82 < 1 
83 < 1 /** The whole fleet, as the server-side `ls` pattern. */
84 < 1 export const FLEET_PATTERN = 'fleet-r*'
85 < 1 
87 > 1 /** `<owner>/<repo>` → `<owner>-<repo>`, the slash-free half of an integration name
88 < 1  *  and of every evidence ref and folder a run has. */
86 < 2 /** `<owner>/<repo>` → `<owner>-<repo>`, the slash-free half of an integration name,
87 < 2  *  and the name of the target's one kata hub project (every run against one target
88 < 2  *  files into it; a name the hub already holds answers the existing project). */
89 < 1 export const targetSlug = (target) => String(target).replace('/', '-')
90 < 1 
91 < 1 /**
92 < 1  * The ONE GitHub integration a target has: `gh-<owner>-<repo>`, `--act-as-user`,
93 < 1  * writable, attached per VM for the run's window. Named for the repository so
94 < 1  * a plain `integrations list` shows two objects naming one repo without any
95 < 1  * parsing — and two such objects on one VM is the fault the sandbox refuses
96 < 1  * to boot into (measured 2026-09-03: the GitHub edge routes by repo path and
97 < 1  * documents no tie-break between two integrations covering the same repo).
98 < 1  */
99 < 1 export const githubIntegrationFor = (target) => `gh-${targetSlug(target)}`
100 < 1 
101 < 1 // ── The refs a run has on the target ────────────────────────────────────────
102 < 1 
103 < 1 /**
104 < 1  * The one branch a run pushes to the target: the work it integrated. It is
105 < 1  * transient: delete-on-merge drops it, and the janitor deletes the
106 < 1  * closed-unmerged ones.
107 < 1  */
108 < 1 export const integrationBranchFor = (run) => `ultra/integration-run-${run}`
109 < 1 
110 < 1 /** The integration branch, with or without a `refs/heads/` head. */
111 < 1 const RUN_BRANCH = /^(?:refs\/heads\/)?ultra\/integration-run-([1-9][0-9]*)$/
112 < 1 
113 < 1 /**
114 < 1  * The run an integration branch carries, or null: `main`, a non-numeric tail
115 < 1  * like `ultra/integration-run-x` and every other shape answer null. A run
116 < 1  * number is never guessed.
117 < 1  */
118 < 1 export const runOfBranch = (ref) => {
119 < 1   const text = String(ref ?? '')
120 < 1   const match = RUN_BRANCH.exec(text)
121 < 1   return match ? Number(match[1]) : null
122 < 1 }
123 < 1 
124 < 1 // ── The evidence repository ─────────────────────────────────────────────────
125 < 1 
126 < 1 /**
127 < 1  * The evidence repository is the operator's setting (#1395): the key
128 < 1  * `evidence` (`<owner>/<repo>`) in `~/.ultrapowers/fleet.json`, overridden for
129 < 1  * one launch by `--evidence-repo`. Nothing derives it from the target, and
130 < 1  * there is no default. Pure: the override when it is a safe target, else
131 < 1  * `config.evidence` when it is one, else null.
132 < 1  */
133 < 1 export const evidenceRepoFor = (config, override = null) => {
134 < 1   if (isSafeTarget(override)) return override
135 < 1   const setting = config?.evidence
136 < 1   return isSafeTarget(setting) ? setting : null
137 < 1 }
138 < 1 
139 < 1 /**
140 < 1  * The one reader of the `evidence` key: its value, or null when the file is
141 < 1  * absent, unreadable or not a JSON object, names no key, or names a value
142 < 1  * `isSafeTarget` refuses. Beside `loadFleetConfig`, which stays the pool's.
143 < 1  */
144 < 1 export async function readEvidenceSetting ({ path: configPath } = {}) {
145 < 1   const parsed = await readFleetJson(configPath ?? DEFAULT_CONFIG_PATH())
146 < 1   return parsed === null ? null : evidenceRepoFor(parsed)
147 < 1 }
148 < 1 
149 < 1 /**
150 < 1  * A run's place in the evidence repository, keyed by the TARGET's slug
151 < 1  * (collision-free across owners — `facebook/react` lands in
152 < 1  * `runs/facebook-react/<N>/`):
153 < 1  *
154 < 1  *   `runs/<slug>/<N>`       the run's folder
155 < 1  *   `live/<slug>/run-<N>`   the branch the run writes while it flies
156 < 1  *   `<slug>/run-<N>`        the tag that outlives it
157 < 1  */
158 < 1 export const runFolderFor = (target, run) => `runs/${targetSlug(target)}/${run}`
159 < 1 export const liveBranchFor = (target, run) => `live/${targetSlug(target)}/run-${run}`
160 < 1 export const runTagFor = (target, run) => `${targetSlug(target)}/run-${run}`
161 < 1 export const evidenceUrlFor = (repo) => `https://github.com/${repo}.git`
162 < 1 /** Where the plan lands in a run's folder: the launcher commits it there and
163 < 1  *  the janitor's duplicate check reads it back. */
164 < 1 export const PLAN_FILE = 'plan.md'
165 < 1 
166 < 1 const escapeRegex = (text) => String(text).replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
167 < 1 
168 < 1 /**
169 < 1  * The run an evidence-repository ref carries for `target`, or null — the live
170 < 1  * branch or the tag, with or without its `refs/heads/` / `refs/tags/` head.
171 < 1  * The slug is matched literally and as a whole path segment, so a foreign
172 < 1  * slug, a peeled `^{}` line and a non-numeric tail are all null.
173 < 1  */
174 < 1 export const runOfEvidenceRef = (target, ref) => {
175 < 1   const slug = escapeRegex(targetSlug(target))
176 < 1   const shape = new RegExp(
177 < 1     `^(?:(?:refs/heads/)?live/${slug}/run-([1-9][0-9]*)|(?:refs/tags/)?${slug}/run-([1-9][0-9]*))$`
178 < 1   )
179 < 1   const match = shape.exec(String(ref ?? ''))
180 < 1   return match ? Number(match[1] ?? match[2]) : null
181 < 1 }
