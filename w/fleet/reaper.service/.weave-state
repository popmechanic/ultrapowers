0 < 2 [Unit]
2 > 2 Description=fleet reaper: removes a fleet VM once its run's evidence record says done (#1470)
1 < 2 Description=fleet reaper: removes a fleet VM once its run closed as done (#1470)
3 > 2 After=network-online.target
2 < 2 After=network-online.target kata.service
3 < 2 Wants=network-online.target
4 < 2 
5 < 2 [Service]
6 < 2 Type=simple
7 < 2 User=exedev
9 > 2 # REAPER_EVIDENCE_REPO=<owner>/<repo>; absent, no record can be read and nothing is removed.
8 < 2 EnvironmentFile=/etc/kata/kata.env
10 > 2 # REAPER_EVIDENCE_REPO=<owner>/<repo>, and REAPER_RECORD=kata for the rollback; absent, nothing is removed.
11 < 2 EnvironmentFile=-/etc/reaper/reaper.env
9 < 2 ExecStart=/usr/bin/python3 /usr/local/lib/reaper/reaper.py
10 < 2 Restart=on-failure
11 < 2 RestartSec=2
12 < 2 
13 < 2 [Install]
14 < 2 WantedBy=multi-user.target
15 < 2 