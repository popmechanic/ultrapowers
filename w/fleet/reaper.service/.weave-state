0 < 1 [Unit]
2 > 1 Description=fleet reaper: removes a fleet VM once its run's evidence record says done (#1470)
1 < 2 Description=fleet reaper: removes a fleet VM once its run closed as done (#1470)
3 > 1 After=network-online.target
2 < 2 After=network-online.target kata.service
3 < 1 Wants=network-online.target
4 < 1 
5 < 1 [Service]
6 < 1 Type=simple
7 < 1 User=exedev
9 > 1 # REAPER_EVIDENCE_REPO=<owner>/<repo>; absent, no record can be read and nothing is removed.
8 < 2 EnvironmentFile=/etc/kata/kata.env
10 > 2 # REAPER_EVIDENCE_REPO=<owner>/<repo>, and REAPER_RECORD=kata for the rollback; absent, nothing is removed.
11 < 1 EnvironmentFile=-/etc/reaper/reaper.env
9 < 1 ExecStart=/usr/bin/python3 /usr/local/lib/reaper/reaper.py
10 < 1 Restart=on-failure
11 < 1 RestartSec=2
12 < 1 
13 < 1 [Install]
14 < 1 WantedBy=multi-user.target
15 < 1 