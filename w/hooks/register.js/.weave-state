182 > 1     Text({ key: "screen", children: [head + (pick != null ? `  picked: ${piece != null ? `${piece} ` : ""}${pick}` : "")] }),
181 < 2     Text({ key: "screen", children: [head + (pick != null ? `  picked: ${pick}` : "")] }),
182 < 1     ...versions.map((v, i) =>
183 < 1       Button({
184 < 1         key: `pick-${v}`,
