316 < 1     const raw = Array.isArray(input.versions) ? input.versions : Array.isArray(e.versions) ? e.versions : [];
318 > 1     const asked = input.url != null ? String(input.url) : e.url != null ? String(e.url) : "";
319 < 1     const url = LOCAL_URL.test(asked) ? asked : "";
317 < 2     const url = input.url != null ? String(input.url) : e.url != null ? String(e.url) : "";
