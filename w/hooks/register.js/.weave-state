78 < 1 // One Send at a time; what arrives while it is out stays for the next one.
70 < 1 async function send($) {
72 > 1   if (sending) return;
73 < 1   sending = true;
71 < 2   const recs = [];
72 < 2   if (pick != null) recs.push({ kind: "pick", screen: screen ? screen.name : "", chose: pick });
73 < 2   for (const n of notes) recs.push(record(n));
74 < 2   if (!recs.length) return;
75 < 2   const name = screen ? screen.name : "the screen";
76 < 2   const text =
77 < 2     `Feedback from the intent tray on ${name}:\n\n` +
78 < 2     `${FENCE}json\n${JSON.stringify(recs)}\n${FENCE}`;
79 < 2   let entered;
80 < 1   try {
82 > 1     await save($); // take in what other sessions sent or dropped
83 < 1     const sent = { screen, pick, piece, ids: notes.map((n) => n.id) };
84 < 1     const recs = [];
85 < 1     if (pick != null) recs.push(pickRecord());
86 < 1     for (const n of notes) recs.push(record(n));
87 < 1     if (!recs.length) return;
88 < 1     const name = screen ? screen.name : "the screen";
89 < 1     const text =
90 < 1       `Feedback from the intent tray on ${name}:\n\n` +
91 < 1       `${FENCE}json\n${JSON.stringify(recs)}\n${FENCE}`;
92 < 1     let entered;
93 < 1     try {
94 < 1       entered = await $.prompt.submit({ text });
95 < 1     } catch {
96 < 1       return; // the tray keeps its notes
97 < 1     }
98 < 1     if (!entered || entered.drop != null) return;
99 < 1     if (same(screen, sent.screen)) setScreen(null);
100 < 1     if (pick === sent.pick && piece === sent.piece) setPick(null);
101 < 1     drop(sent.ids);
102 < 1     await save($);
103 < 1   } finally {
104 < 1     sending = false;
81 < 2     entered = await $.prompt.submit({ text });
82 < 2   } catch {
83 < 2     return; // the tray keeps its notes
84 < 1   }
85 < 2   if (!entered || entered.drop != null) return;
86 < 2   empty();
87 < 2   await save($);
88 < 1 }
89 < 1 
90 < 1 async function clear($) {
91 < 1   empty();
92 < 1   await save($);
93 < 1 }
