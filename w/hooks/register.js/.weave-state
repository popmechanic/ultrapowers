258 < 1 export function register(on) {
259 < 1   on("session.start", async ($, e, next) => {
260 < 1     cwd = (e && e.cwd) || "";
261 < 1     const saved = await $.store.get(trayKey());
262 < 1     if (!saved || typeof saved !== "object") {
263 < 1       // Lines written before this repo's first session are history.
265 > 1       const bytes = await wholeLines($);
266 < 1       offset = bytes?.length ?? 0;
267 < 1       mark = bytes ? markOf(bytes) : "";
264 < 2       offset = (await wholeLines($))?.length ?? 0;
265 < 1       await save($);
266 < 1     } else {
267 < 1       screen = saved.screen || null;
268 < 1       pick = saved.pick != null ? saved.pick : null;
270 > 1       piece = saved.piece != null ? saved.piece : null;
271 < 1       notes = notesOf(saved.notes);
272 < 1       gone = Array.isArray(saved.gone) ? saved.gone.map(String).slice(-GONE_KEPT) : [];
269 < 2       notes = Array.isArray(saved.notes) ? saved.notes : [];
270 < 1       offset = Number(saved.offset) || 0;
272 > 1       if (typeof saved.mark === "string") {
273 < 1         mark = saved.mark;
274 < 1       } else {
275 < 1         // Stored before the mark: the offset was taken in the file that is there now.
276 < 1         const bytes = await wholeLines($);
277 < 1         mark = bytes ? markOf(bytes) : "";
278 < 1       }
271 < 1     }
272 < 1     await $.command.register({ name: "tray", description: "Open the intent tray", immediate: true });
273 < 1     await $.command.register({
274 < 1       name: "note",
275 < 1       description: "Add a note to the intent tray: /note <element>: <note>, or /note <note>",
276 < 1       argumentHint: "[element: note]",
277 < 1       immediate: true,
278 < 1     });
279 < 1     await $.tool.register({
280 < 1       name: "show_screen",
281 < 1       description:
282 < 1         "Show the operator a screen in the intent tray so they can pick a version and add notes; then wait for their feedback.",
283 < 1       inputSchema: {
284 < 1         type: "object",
285 < 1         properties: {
286 < 1           name: { type: "string", description: "Name of the screen" },
287 < 1           stage: { type: "string", description: "What this round is about" },
288 < 1           versions: { type: "array", items: { type: "string" }, description: "Version labels to pick from" },
289 < 1           url: { type: "string", description: "Address of the preview page, opened by the tray's Open screen button" },
290 < 1         },
291 < 1         required: ["name"],
292 < 1       },
293 < 1     });
294 < 1     $.clock.every(1000, () => readFeedback($));
295 < 1     return next(e);
296 < 1   });
297 < 1 
298 < 1   // A registered command is answered by a command.run hook; CommandSpec has no callback field.
299 < 1   on("command.run", { command: "tray" }, async ($) => {
300 < 1     await openTray($);
301 < 1     return {};
302 < 1   });
303 < 1 
304 < 1   on("command.run", { command: "note" }, async ($, e) => {
