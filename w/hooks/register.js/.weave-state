200 < 1         Button({
201 < 1           key: `drop-${i}`,
202 < 1           onPress: async () => {
204 > 1             drop([n.id]);
203 < 2             notes.splice(i, 1);
204 < 1             await save($);
205 < 1           },
206 < 1           children: ["x"],
207 < 1         }),
208 < 1       ],
209 < 1     })
210 < 1   );
211 < 1   return Box({
212 < 1     key: "tray",
