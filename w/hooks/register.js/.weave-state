0 < 1 // Intent tray mod: Claude shows a screen through the show_screen tool, the
1 < 1 // operator picks a version and adds notes in a pane beside the chat (or in
2 < 1 // the preview page, which appends to .ultrapowers/feedback.jsonl), and Send
3 < 1 // hands everything to Claude as one prompt holding a ```json block.
4 < 1 
5 < 1 const PANE = { id: "intent-tray", title: "Intent tray", rows: 10 };
6 < 1 const FEEDBACK = ".ultrapowers/feedback.jsonl";
7 < 1 const FENCE = "`".repeat(3);
8 < 1 
10 > 1 const GONE_KEPT = 500; // ids of notes sent, cleared or dropped, kept so no session brings them back
11 < 1 
9 < 1 let screen = null; // { name, stage, versions, url }
10 < 1 let pick = null;
12 > 1 let piece = null; // the piece a preview's pick was for, when it named one
13 < 1 let notes = []; // { id, kind, target?, note }
14 < 1 let gone = []; // ids of notes that left the tray, newest last
11 < 2 let notes = []; // { kind, target?, note }
12 < 1 let offset = 0; // bytes of the feedback file already taken (always ends at a newline)
14 > 1 let mark = ""; // the feedback file's first whole line when `offset` was taken: a new one is a new file
13 < 1 let cwd = "";
15 > 1 let sending = false;
16 < 1 const changed = new Set(); // "screen", "pick": set here since the last save, so this session's value wins
14 < 1 
15 < 1 // One tray per working directory: sessions in other repos never see this one.
16 < 1 function trayKey() {
17 < 1   return `tray:${cwd.replace(/\/+$/, "")}`;
18 < 1 }
19 < 1 
21 > 1 let made = 0;
22 < 1 function newId() {
23 < 1   made += 1;
24 < 1   return `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}-${made}`;
25 < 1 }
26 < 1 
27 < 1 // A note stored before notes carried ids gets one from its content, the same in every session.
28 < 1 function withId(n) {
29 < 1   return typeof n.id === "string" ? n : { ...n, id: `v0:${JSON.stringify(record(n))}` };
30 < 1 }
31 < 1 
32 < 1 function notesOf(v) {
33 < 1   return Array.isArray(v) ? v.filter((n) => n && typeof n === "object").map(withId) : [];
34 < 1 }
35 < 1 
36 < 1 // Fold in what other sessions in this repo stored: their notes join ours (none
37 < 1 // that any session sent, cleared or dropped), and their screen and pick stand
38 < 1 // unless this session changed its own since it last saved.
39 < 1 function merge(held) {
40 < 1   if (!held || typeof held !== "object") return;
41 < 1   const left = new Set([...(Array.isArray(held.gone) ? held.gone.map(String) : []), ...gone]);
42 < 1   gone = [...left].slice(-GONE_KEPT);
43 < 1   if (!changed.has("screen")) screen = held.screen || null;
44 < 1   if (!changed.has("pick")) {
45 < 1     pick = held.pick != null ? held.pick : null;
46 < 1     piece = held.piece != null ? held.piece : null;
47 < 1   }
48 < 1   const byId = new Map();
49 < 1   for (const n of [...notesOf(held.notes), ...notes]) if (!left.has(n.id) && !byId.has(n.id)) byId.set(n.id, n);
50 < 1   notes = [...byId.values()];
51 < 1   if (held.mark === mark && Number(held.offset) > offset) offset = Number(held.offset);
52 < 1 }
