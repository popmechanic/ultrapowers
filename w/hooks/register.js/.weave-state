58 < 1 async function addNote($, text) {
59 < 1   const n = parseNote(text);
60 < 1   if (!n) return;
62 > 1   notes.push({ id: newId(), ...n });
61 < 2   notes.push(n);
62 < 1   await save($);
63 < 1 }
