71 > 1 function pickRecord() {
72 < 1   const r = { kind: "pick", screen: screen ? screen.name : "" };
73 < 1   if (piece != null) r.piece = piece;
74 < 1   r.chose = pick;
75 < 1   return r;
76 < 1 }
