54 < 1 // Store the tray merged with what is stored, so two sessions in one repo keep each other's notes.
20 < 1 async function save($) {
22 > 1   merge(await $.store.get(trayKey()));
23 < 1   changed.clear();
24 < 1   await $.store.set(trayKey(), { screen, pick, piece, notes, gone, offset, mark });
21 < 2   await $.store.set(trayKey(), { screen, pick, notes, offset });
22 < 1   $.ui.invalidate();
23 < 1 }
