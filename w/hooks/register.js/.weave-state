25 < 1 function empty() {
27 > 1   setScreen(null);
28 < 1   setPick(null);
29 < 1   drop(notes.map((n) => n.id));
26 < 2   screen = null;
27 < 2   pick = null;
28 < 2   notes = [];
29 < 1 }
30 < 1 
31 < 1 function hasContent() {
32 < 1   return Boolean(screen || pick || notes.length);
33 < 1 }
