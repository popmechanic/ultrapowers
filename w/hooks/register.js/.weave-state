39 < 1 // "element: note" is an element note; text without a colon is a view note.
40 < 1 function parseNote(text) {
41 < 1   const s = String(text || "").trim();
42 < 1   if (!s) return null;
43 < 1   const i = s.indexOf(":");
44 < 1   if (i < 0) return { kind: "view", note: s };
45 < 1   const target = s.slice(0, i).trim();
46 < 1   const note = s.slice(i + 1).trim();
47 < 1   if (!target) return note ? { kind: "view", note } : null;
48 < 1   if (!note) return null;
49 < 1   return { kind: "element", target, note };
50 < 1 }
51 < 1 
53 > 1 const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
54 < 1 
52 < 1 function record(n) {
53 < 1   return n.kind === "view"
54 < 1     ? { kind: "view", note: n.note }
55 < 1     : { kind: n.kind, target: n.target, note: n.note };
56 < 1 }
