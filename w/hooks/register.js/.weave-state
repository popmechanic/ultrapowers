151 < 1 // The Desktop app offers no $.process, so there the tray draws no Open screen button.
152 < 1 function canRun($) {
153 < 1   try {
154 < 1     return "process" in $ && Boolean($.process);
155 < 1   } catch {
156 < 1     return false;
157 < 1   }
148 < 1 }
149 < 1 
150 < 1 // Run one command to its end; true when it exits 0, false when it fails or cannot start.
151 < 1 async function run($, argv) {
152 < 1   try {
153 < 1     const stream = $.process.spawn({ argv });
154 < 1     for await (const _ of stream);
155 < 1     const { code } = await stream.result;
156 < 1     return code === 0;
157 < 1   } catch {
158 < 1     return false;
159 < 1   }
160 < 1 }
