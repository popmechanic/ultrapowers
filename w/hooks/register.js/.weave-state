26 > 1 function drop(ids) {
27 < 1   const out = new Set(ids);
28 < 1   if (!out.size) return;
29 < 1   notes = notes.filter((n) => !out.has(n.id));
30 < 1   gone = [...gone.filter((id) => !out.has(id)), ...out].slice(-GONE_KEPT);
31 < 1 }
32 < 1 
33 < 1 function setScreen(next) {
34 < 1   screen = next;
35 < 1   changed.add("screen");
36 < 1 }
37 < 1 
38 < 1 function setPick(version, of = null) {
39 < 1   pick = version;
40 < 1   piece = version == null ? null : of;
41 < 1   changed.add("pick");
