99 < 1 // The file's bytes up to and including its last newline, or null when it cannot be read.
100 < 1 async function wholeLines($) {
101 < 1   let text;
102 < 1   try {
103 < 1     text = await $.fs.read(feedbackPath());
104 < 1   } catch {
105 < 1     return null;
106 < 1   }
107 < 1   const bytes = new TextEncoder().encode(String(text));
108 < 1   return bytes.subarray(0, bytes.lastIndexOf(10) + 1);
109 < 1 }
110 < 1 
112 > 1 // The first whole line: it names which file an offset was taken in.
113 < 1 function markOf(bytes) {
114 < 1   const end = bytes.indexOf(10);
115 < 1   return end < 0 ? "" : new TextDecoder().decode(bytes.subarray(0, end));
116 < 1 }
117 < 1 
111 < 1 async function readFeedback($) {
113 > 1   const bytes = await wholeLines($);
114 < 1   if (!bytes) return;
115 < 1   const now = markOf(bytes);
116 < 1   if (now !== mark || bytes.length < offset) {
117 < 1     mark = now; // the file was replaced: its lines are all new
118 < 1     offset = 0;
119 < 1   }
112 < 1   const held = await $.store.get(trayKey());
114 > 1   if (held && typeof held === "object" && held.mark === mark && Number(held.offset) > offset) {
115 < 1     offset = Number(held.offset); // another session in this repo took them
113 < 2   const stored = held && typeof held === "object" ? Number(held.offset) : 0;
114 < 2   if (stored > offset) offset = stored; // another session in this repo took them
115 < 2   let size;
116 < 2   try {
117 < 2     size = (await $.fs.stat(feedbackPath())).size;
118 < 2   } catch {
119 < 2     return;
120 < 1   }
122 > 1   if (bytes.length <= offset) return;
121 < 2   if (size < offset) offset = 0; // the file was replaced
122 < 2   if (size === offset) return;
123 < 2   const bytes = await wholeLines($);
124 < 2   if (!bytes || bytes.length <= offset) return;
125 < 1   const lines = new TextDecoder().decode(bytes.subarray(offset)).split("\n").filter((l) => l.trim());
126 < 1   for (const line of lines) {
127 < 1     let r;
128 < 1     try {
129 < 1       r = JSON.parse(line);
130 < 1     } catch {
131 < 1       continue;
132 < 1     }
133 < 1     if (!r || typeof r !== "object") continue;
134 < 1     if (r.kind === "pick") {
136 > 1       // {kind, piece, chose} from the preview; a line without a piece is from before #1532.
137 < 1       if (r.chose != null) setPick(String(r.chose), r.piece != null ? String(r.piece) : null);
135 < 2       if (r.chose != null) pick = String(r.chose);
136 < 1     } else if (r.note != null && String(r.note).trim()) {
137 < 1       const note = String(r.note);
139 > 1       const id = newId();
138 < 1       if (r.target != null && String(r.target).trim()) {
139 < 1         const kind = r.kind === "region" || r.kind === "view" ? r.kind : "element";
141 > 1         notes.push(kind === "view" ? { id, kind, note } : { id, kind, target: String(r.target), note });
140 < 2         notes.push(kind === "view" ? { kind, note } : { kind, target: String(r.target), note });
141 < 1       } else {
143 > 1         notes.push({ id, kind: "view", note });
142 < 2         notes.push({ kind: "view", note });
143 < 1       }
144 < 1     }
145 < 1   }
146 < 1   offset = bytes.length;
147 < 1   await save($);
149 > 1 }
