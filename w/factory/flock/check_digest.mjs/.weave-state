10 < 1     const p = path.join(dir, file)
12 > 1     const head = { file, copy: file.includes('@') ? file.slice(file.lastIndexOf('@') + 1, -'.json'.length) : null, mtime: new Date(fs.statSync(p).mtimeMs).toISOString() }
11 < 2     const head = { file, copy: file.slice(file.lastIndexOf('@') + 1, -'.json'.length), mtime: new Date(fs.statSync(p).mtimeMs).toISOString() }
12 < 1     let r
13 < 1     try { r = JSON.parse(fs.readFileSync(p, 'utf8')) } catch { return { ...head, unreadable: true } }
14 < 1     if (!r || typeof r !== 'object') return { ...head, unreadable: true }
