0 < 2 // A builder about to edit a file is told which of its lines its peers wrote, and which task
1 < 2 // wrote them. authors: the weave's authors_keyed answer, one entry per visible line: 'base',
2 < 2 // one agent letter, or several joined by '|' (written identically by more than one agent).
3 < 2 
4 < 1 const runsOf = (lines) => {
5 < 1   const runs = []
6 < 1   for (const n of lines) {
7 < 1     const last = runs[runs.length - 1]
8 < 1     if (last && last[1] === n - 1) last[1] = n
9 < 1     else runs.push([n, n])
10 < 1   }
11 < 1   return runs.map(([a, b]) => a === b ? String(a) : `${a}-${b}`)
12 < 1 }
13 < 1 const joinAnd = (xs) => xs.length < 2 ? xs.join('') : xs.slice(0, -1).join(', ') + ' and ' + xs[xs.length - 1]
14 < 2 // More than MAX_RUNS runs list the first MAX_RUNS and a count, so a large interleaved file keeps the note short.
15 < 1 const MAX_RUNS = 20
16 < 1 const joinRuns = (xs) => xs.length > MAX_RUNS ? xs.slice(0, MAX_RUNS).join(', ') + ` and ${xs.length - MAX_RUNS} more` : joinAnd(xs)
17 < 1 
18 < 1 export function peerNote ({ path, authors, agent, tasks = {} }) {
19 < 1   const byOwner = new Map()
20 < 1   authors.forEach((who, i) => {
21 < 1     if (who === 'base' || who.split('|').includes(agent)) return
22 < 1     if (!byOwner.has(who)) byOwner.set(who, [])
23 < 1     byOwner.get(who).push(i + 1)
24 < 1   })
25 < 1   if (!byOwner.size) return null
26 < 1   const clauses = [...byOwner].map(([who, lines]) => {
27 < 1     const t = who.includes('|') ? null : tasks[who]
28 < 1     const head = lines.length === 1 ? `line ${lines[0]} was` : `lines ${joinRuns(runsOf(lines))} were`
29 < 1     return `${head} written by ${who}${t ? ` (task ${t.id}: ${t.title})` : ''}`
30 < 1   })
31 < 1   return `In ${path}, ${clauses.join('; ')}; keep what they changed when you edit them.`
32 < 1 }
33 < 1 