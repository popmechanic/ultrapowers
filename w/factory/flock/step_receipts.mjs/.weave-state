5 < 1 export function stepReceipts (results) {
6 < 1   return [...(results || [])]
8 > 1     .filter((r) => r && typeof r.clause === 'string')
7 < 2     .filter((r) => r && typeof r.clause === 'string' && Array.isArray(r.diff))
8 < 1     .map((r) => ({
9 < 1       clause: r.clause,
10 < 1       exit: r.exit,
11 < 1       stage: r.stage,
13 > 1       diff: Array.isArray(r.diff) ? r.diff.slice(0, MAX_DIFF) : null,
14 < 1       truncated: Array.isArray(r.diff) && r.diff.length > MAX_DIFF
12 < 2       diff: r.diff.slice(0, MAX_DIFF),
13 < 2       truncated: r.diff.length > MAX_DIFF
14 < 1     }))
15 < 1     .sort((a, b) => (a.clause < b.clause ? -1 : a.clause > b.clause ? 1 : 0))
16 < 1 }
