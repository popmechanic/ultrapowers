0 < 2 // One Jev read whose answer lands as a row (the peer-rewrite read, #1401); a missing
1 < 2 // answer is recorded as null. `claimOf` gives Jev a task's claim.
2 < 2 import { answerOf } from '../jev-client.mjs'
3 < 2 
4 < 2 // The task body's text from its `**Claim:**` line up to, not including, its `**Authorized-by:**` line.
5 < 2 export function claimOf (body) {
6 < 2   const b = String(body ?? '')
7 < 2   const s = b.search(/^\*\*Claim:\*\*/m)
8 < 2   if (s < 0) return ''
9 < 2   const rest = b.slice(s)
10 < 2   const e = rest.search(/^\*\*Authorized-by:\*\*/m)
11 < 2   return (e < 0 ? rest : rest.slice(0, e)).trim().slice(0, 2000)
12 < 2 }
13 < 2 
14 < 2 export async function readTrial ({ ask, key, question, state, row, emit }) {
15 < 2   let answers = null
16 < 2   try { answers = await ask({ state, questions: { [key]: question } }) } catch { answers = null }
17 < 2   emit({ ...row, ...answerOf(answers, key) })
18 < 2 }
19 < 2 