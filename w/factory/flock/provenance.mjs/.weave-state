0 < 2 // A run's provenance (#1404): what no other source holds. Git has the text and the plan has each
1 < 2 // task's Files and Claim, so neither is copied; this names which task wrote every changed line of
2 < 2 // the landed snapshot and the surprises. (The coverage pass that named the changed code no probe
3 < 2 // ran was retired unread, #1442.)
4 < 2 //
5 < 2 // buildProvenance({ landed, blame, events, lost }) is pure:
6 < 2 //   landed    {path: text} of the landed snapshot
7 < 2 //   blame     the weave's `blame` map: {path: [label per landed line]}: `base`, a task label `A.2`,
8 < 2 //             labels joined `|` when several wrote identical text, or a label with no dot (no task)
9 < 2 //   events    events.jsonl rows
10 < 2 //   lost      the snapshot's `survival` list [{path, author, by, lines}]
11 < 2 // answers { hunks, exceptions }. The final empty line of a text ending in a newline is not a hunk line.
12 < 2 
13 < 1 const cmp = (a, b) => (a < b ? -1 : a > b ? 1 : 0)
14 < 2 const same = (a, b) => JSON.stringify(a) === JSON.stringify(b)
15 < 1 
16 < 2 // a label's task: the text after its dot; several labels give their tasks joined `|` in label
17 < 2 // order; `base` or any label with no dot answers null
18 < 1 function taskOf (label) {
19 < 1   const parts = String(label).split('|')
20 < 1   if (parts.some((l) => l.indexOf('.') < 0)) return null
21 < 1   return parts.map((l) => l.slice(l.indexOf('.') + 1)).join('|')
22 < 1 }
23 < 1 
24 < 1 const span = (a, b) => (a === b ? String(a) : `${a}-${b}`)
25 < 1 
26 < 2 // runs of consecutive lines (1-based) whose key is equal and not undefined, in line order
27 < 1 function runs (keys) {
28 < 1   const out = []
29 < 1   let cur = null
30 < 1   keys.forEach((k, i) => {
31 < 1     const n = i + 1
32 < 1     if (k !== undefined && cur && cur.key === k && cur.to === n - 1) cur.to = n
33 < 1     else if (k !== undefined) out.push(cur = { key: k, from: n, to: n })
34 < 1     else cur = null
35 < 1   })
36 < 1   return out
37 < 1 }
38 < 1 
39 < 1 export function buildProvenance ({ landed, blame, events = [], lost = [] }) {
40 < 1   const paths = Object.keys(landed || {}).filter((p) => blame && Array.isArray(blame[p])).sort(cmp)
41 < 1   const linesOf = (p) => String(landed[p] ?? '').split('\n')
42 < 1   const hunks = [], foreign = []
43 < 1   for (const p of paths) {
44 < 1     const labels = blame[p]
45 < 1     const text = linesOf(p)
46 < 1     const tail = String(landed[p] ?? '').endsWith('\n') ? text.length - 1 : -1
47 < 1     const tasks = labels.map((l, i) => (l === 'base' || i === tail ? undefined : taskOf(l)))
48 < 1     for (const r of runs(tasks.map((t) => (t === null ? undefined : t)))) hunks.push({ path: p, lines: span(r.from, r.to), task: r.key })
49 < 1     for (const r of runs(tasks.map((t) => (t === null ? true : undefined)))) foreign.push({ kind: 'foreign', path: p, lines: span(r.from, r.to) })
50 < 1   }
51 < 1 
52 < 1   const rows = events || []
53 < 1   const contested = []
54 < 1   for (const w of rows.filter((e) => e.kind === 'peer:rewrite')) {
55 < 1     if (!(w.path in (landed || {})) || !Array.isArray(w.after) || !w.after.length) continue
56 < 2     // only the writer's own lines count: a rewrite landed when every `after` line is among them
57 < 1     const text = linesOf(w.path), labels = blame[w.path] || [], own = `${w.agent}.${w.task}`
58 < 1     const mine = text.map((l, i) => (String(labels[i] ?? '').split('|').includes(own) ? l : undefined))
59 < 1     if (!w.after.every((l) => mine.includes(l))) continue
60 < 1     const line = mine.findIndex((l) => l !== undefined && w.after.includes(l)) + 1
62 > 1     contested.push({ kind: 'contested', path: w.path, line, wrote: w.task ?? null, over: (w.peers || []).map((l) => taskOf(l) ?? l).join('|') })
61 < 2     const read = rows.find((e) => e.kind === 'jev:peer-rewrite' && e.path === w.path && same(e.after, w.after))
62 < 2     contested.push({ kind: 'contested', path: w.path, line, wrote: w.task ?? null, over: (w.peers || []).map((l) => taskOf(l) ?? l).join('|'), jev: read ? (read.answer ?? null) : null })
63 < 1   }
64 < 1   contested.sort((a, b) => cmp(a.path, b.path) || a.line - b.line)
65 < 1   const lostRows = (lost || []).map((e) => ({ kind: 'lost', path: e.path, author: e.author, by: e.by, lines: e.lines }))
66 < 1     .sort((a, b) => cmp(a.path, b.path))
67 < 1   const ordered = []
68 < 1   for (const s of rows.filter((e) => e.kind === 'same-anchor')) {
69 < 1     if (!(s.path in (landed || {})) || !Array.isArray(s.lines)) continue
70 < 1     const text = linesOf(s.path)
71 < 1     if (!s.lines.every((l) => text.includes(l))) continue
72 < 1     ordered.push({ kind: 'ordered', path: s.path, anchor: s.anchor, lines: s.lines, at: s.lines.length ? text.indexOf(s.lines[0]) : -1 })
73 < 1   }
74 < 1   ordered.sort((a, b) => cmp(a.path, b.path) || a.at - b.at)
75 < 1   for (const o of ordered) delete o.at
76 < 1   return { hunks, exceptions: [...contested, ...lostRows, ...ordered, ...foreign] }
77 < 1 }
78 < 1 
79 < 2 // remapProvenance(prov, texts) is pure: texts {path: {from, to}} gives a path's text in the run's
80 < 2 // commit and in the caught-up commit. Every line span of such a path (in hunks and the
81 < 2 // exceptions' `lines` span or `line`) is carried line by line through the longest common subsequence
82 < 2 // of the two texts' lines; a line with no match drops, and each mapped set is cut back into runs of
83 < 2 // consecutive lines (an entry whose lines all drop disappears). A side may be null for a file absent
84 < 2 // there: with `to` null every entry of that path drops. Other paths and keys are kept.
85 < 1 const SPAN = /^\d+(-\d+)?$/
86 < 1 
87 < 2 // old line (1-based) -> new line (1-based), for the lines a longest common subsequence keeps; a
88 < 2 // null side (the file is absent there) keeps none. Myers' diff with its middle snake, so memory
89 < 2 // stays linear in the two lengths and time is O((n+m)·D).
90 < 1 function lineMap (from, to) {
91 < 1   const map = new Map()
92 < 1   if (from === null || from === undefined || to === null || to === undefined) return map
93 < 1   const ids = new Map()
94 < 1   const id = (l) => { let v = ids.get(l); if (v === undefined) ids.set(l, v = ids.size); return v }
95 < 1   const a = Int32Array.from(String(from).split('\n'), id), b = Int32Array.from(String(to).split('\n'), id)
96 < 1   const match = (a0, a1, b0, b1) => {
97 < 1     while (a0 < a1 && b0 < b1 && a[a0] === b[b0]) { map.set(a0 + 1, b0 + 1); a0++; b0++ }
98 < 1     while (a1 > a0 && b1 > b0 && a[a1 - 1] === b[b1 - 1]) { a1--; b1--; map.set(a1 + 1, b1 + 1) }
99 < 1     if (a0 === a1 || b0 === b1) return
100 < 1     const [x0, y0, x1, y1] = middleSnake(a0, a1, b0, b1)
101 < 1     match(a0, a0 + x0, b0, b0 + y0)
102 < 1     for (let x = x0, y = y0; x < x1; x++, y++) map.set(a0 + x + 1, b0 + y + 1)
103 < 1     match(a0 + x1, a1, b0 + y1, b1)
104 < 1   }
105 < 2   // the snake (start and end, relative to a0 and b0) a shortest edit path crosses halfway
106 < 1   const middleSnake = (a0, a1, b0, b1) => {
107 < 1     const N = a1 - a0, M = b1 - b0, delta = N - M, odd = (delta & 1) !== 0
108 < 1     const max = Math.ceil((N + M) / 2), off = max + 1
109 < 1     const vf = new Int32Array(2 * max + 3), vb = new Int32Array(2 * max + 3)
110 < 1     for (let d = 0; d <= max; d++) {
111 < 1       for (let k = -d; k <= d; k += 2) {
112 < 1         let x = (k === -d || (k !== d && vf[off + k - 1] < vf[off + k + 1])) ? vf[off + k + 1] : vf[off + k - 1] + 1
113 < 1         let y = x - k
114 < 1         const xs = x, ys = y
115 < 1         while (x < N && y < M && a[a0 + x] === b[b0 + y]) { x++; y++ }
116 < 1         vf[off + k] = x
117 < 1         const kb = delta - k
118 < 1         if (odd && kb >= -(d - 1) && kb <= d - 1 && x + vb[off + kb] >= N) return [xs, ys, x, y]
119 < 1       }
120 < 1       for (let k = -d; k <= d; k += 2) {
121 < 1         let x = (k === -d || (k !== d && vb[off + k - 1] < vb[off + k + 1])) ? vb[off + k + 1] : vb[off + k - 1] + 1
122 < 1         let y = x - k
123 < 1         const xs = x, ys = y
124 < 1         while (x < N && y < M && a[a1 - 1 - x] === b[b1 - 1 - y]) { x++; y++ }
125 < 1         vb[off + k] = x
126 < 1         const kf = delta - k
127 < 1         if (!odd && kf >= -d && kf <= d && x + vf[off + kf] >= N) return [N - x, M - y, N - xs, M - ys]
128 < 1       }
129 < 1     }
130 < 1     throw new Error('no middle snake')
131 < 1   }
132 < 1   match(0, a.length, 0, b.length)
133 < 1   return map
134 < 1 }
135 < 1 
136 < 2 // a span through the map, as the spans of its surviving lines' runs
137 < 1 function mapSpan (text, map) {
138 < 1   const [x, y] = String(text).split('-').map(Number)
139 < 1   const got = []
140 < 1   for (let n = x; n <= (y ?? x); n++) if (map.has(n)) got.push(map.get(n))
141 < 1   got.sort((p, q) => p - q)
142 < 1   const out = []
143 < 1   for (const n of got) {
144 < 1     const last = out[out.length - 1]
145 < 1     if (last && n === last[1] + 1) last[1] = n
146 < 1     else if (!last || n !== last[1]) out.push([n, n])
147 < 1   }
148 < 1   return out.map(([p, q]) => span(p, q))
149 < 1 }
150 < 1 
151 < 1 export function remapProvenance (prov, texts) {
152 < 1   const maps = new Map(Object.entries(texts || {}).map(([p, t]) => [p, lineMap(t.from, t.to)]))
153 < 1   const remap = (list) => {
154 < 1     if (!Array.isArray(list)) return list
155 < 1     const out = []
156 < 1     for (const e of list) {
157 < 1       const map = e && maps.get(e.path)
158 < 1       if (!map) out.push(e)
159 < 1       else if (typeof e.lines === 'string' && SPAN.test(e.lines)) for (const s of mapSpan(e.lines, map)) out.push({ ...e, lines: s })
160 < 1       else if (Number.isInteger(e.line)) { if (map.has(e.line)) out.push({ ...e, line: map.get(e.line) }) } else out.push(e)
161 < 1     }
162 < 1     return out
163 < 1   }
164 < 1   return { ...prov, hunks: remap(prov.hunks), exceptions: remap(prov.exceptions) }
165 < 1 }
166 < 1 