0 < 1 // The Flock's board (map #1292): the in-memory board the engine (factory/flock/engine.mjs) uses —
2 > 1 // the verbs of an issue board (ready, claim, release, park, done, reopen, post_belief, board_read,
3 < 1 // add task) and no service behind them: its moves are rows in events.jsonl.
1 < 2 // Kata's verbs (ready, claim, release, park, done, reopen, post_belief, board_read, add task), no
2 < 2 // Kata. kata_mirror.mjs mirrors its moves onto the hub when the boot passes a record.
3 < 1 
4 < 1 // Each claimer starts its walk of the ready list at its own offset, so N claimers
5 < 1 // do not all race for the first row.
6 < 1 const rotate = (xs, who) => {
7 < 1   if (!xs.length) return xs
8 < 1   const k = [...String(who)].reduce((a, c) => a * 31 + c.charCodeAt(0), 7) % xs.length
9 < 1   return [...xs.slice(k), ...xs.slice(0, k)]
10 < 1 }
11 < 1 
12 < 1 // The final atlas race: each task's remaining chain, the longest run of dependent tasks from it to
13 < 1 // the end, itself included (atlas: 1, 4 and 10 head chains of 3). A task added later (a resolve or
14 < 1 // check task) has no consumers and counts 1.
15 < 1 export function chainLengths (tasks) {
16 < 1   const consumers = new Map(tasks.map((t) => [t.id, []]))
17 < 1   for (const t of tasks) for (const d of t.depends_on) consumers.get(d).push(t.id)
18 < 1   const cp = new Map()
19 < 1   const walk = (id) => {
20 < 1     if (!cp.has(id)) cp.set(id, 1 + Math.max(0, ...consumers.get(id).map(walk)))
21 < 1     return cp.get(id)
22 < 1   }
23 < 1   for (const t of tasks) walk(t.id)
24 < 1   return cp
25 < 1 }
26 < 1 
27 < 1 export class Board {
28 < 1   constructor ({ tasks, now }) {
29 < 1     this.now = now
30 < 1     this.tasks = new Map(tasks.map((t) => [t.id, { ...t, state: 'ready', owner: null, notes: [], reopen: 0 }]))
31 < 1     this.beliefs = []
32 < 1     // the ready set is offered longest remaining chain first, each claimer's own rotation kept only among equals
33 < 1     this.cp = chainLengths(tasks)
34 < 1   }
35 < 1 
36 < 1   offer (list, who) {
37 < 1     const len = (x) => this.cp.get(x.id) || 1
38 < 1     return rotate(list, who).map((x, i) => [x, i]).sort((a, b) => len(b[0]) - len(a[0]) || a[1] - b[1]).map(([x]) => x)
39 < 1   }
40 < 1 
41 < 1   allDone () { return [...this.tasks.values()].every((t) => t.state === 'done') }
42 < 1   // the host's own view of what is claimable, for the settle rule
43 < 1   readyNow () { return [...this.tasks.values()].filter((t) => t.state === 'ready' && t.depends_on.every((d) => this.tasks.get(d).state === 'done')) }
44 < 1 
45 < 1   async claim (agent) {
46 < 1     for (const t of this.offer(this.readyNow(), agent)) {
47 < 1       if (t.state !== 'ready') continue
48 < 1       t.state = 'claimed'; t.owner = agent
49 < 1       return t
50 < 1     }
51 < 1     return null
52 < 1   }
53 < 1   async release (t, why) { t.state = 'ready'; t.owner = null; t.notes.push(why) }
54 < 1   reopen (t, why) { return this.release(t, why) }
55 < 1   async park (t, why) { t.state = 'parked'; t.owner = null; t.notes.push(why) }
56 < 1   async done (t) { t.state = 'done' }
57 < 1   async post (b) { const x = { id: this.beliefs.length + 1, t: this.now(), ...b }; this.beliefs.push(x); return x }
58 < 1   async read () {
59 < 1     return {
60 < 1       tasks: [...this.tasks.values()].map((t) => ({ id: t.id, title: t.title, state: t.state, owner: t.owner, depends_on: t.depends_on, notes: t.notes.slice(-2) })),
61 < 1       beliefs: this.beliefs.slice(-15),
62 < 1     }
63 < 1   }
64 < 1   async addTask (t) { this.tasks.set(t.id, t) }
65 < 1 }
66 < 1 