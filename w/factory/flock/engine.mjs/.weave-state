1222 < 1 
1223 < 1 // ── run ───────────────────────────────────────────────────────────────────────
1224 < 1 await must({ op: 'base', root: BASE_DIR, paths: BASE_PATHS })
1225 < 1 let MEMORY = false   // the run's weaves began from main's memory
1226 < 1 if (MAIN_MODE !== 'frozen') {
1227 < 1   const r = await weave({ op: 'memory', repo: TARGET, commit: BASE_SHA, remote: 'origin' }).catch((e) => ({ ok: false, error: String(e) }))
1228 < 1   MEMORY = !!(r.ok && r.memory)
1229 < 1   ev('weave:memory', r.ok ? { ...r, ok: undefined } : { memory: false, reason: String(r.error).slice(0, 300) })
1230 < 1   log('memory', MEMORY ? `${r.via} entry, ${r.installed} of ${r.stored} stored paths at base` : 'none: ' + (r.reason || r.error))
1231 < 1 }
1232 < 1 ev('start', { workload: W.name, cap: CAP, model: MODEL, clock_ms: CLOCK_MS, pulls: PULLS, chain: Object.fromEntries(board.cp) })
1233 < 1 log(`workload ${W.name}, elastic builders (cap ${CAP}), ${MODEL}, out ${OUT}`)
1234 < 1 // the previous run (#1335, #1395): when this run follows one on the same repository, the sandbox
1235 < 1 // (factory/boot.sh) extracts that run's evidence folder to a directory and names it with
1236 < 1 // --past-dir <dir> (basename = the run number); read what it recorded (status, events, red
1237 < 1 // checks) and brief every builder with it. No --past-dir reads nothing. Any failure (a missing
1238 < 1 // directory or file) is logged once and leaves the brief as it was.
1239 < 1 let PAST = null
1240 < 1 {
1241 < 1   const dir = arg('past-dir')
1242 < 1   if (dir) {
1243 < 1     try {
1244 < 1       const m = Number(path.basename(path.resolve(dir)))
1245 < 1       if (!Number.isInteger(m) || m < 1) throw new Error(`past dir ${dir} is not named by a run number`)
1246 < 1       const text = (f) => fs.readFileSync(path.join(dir, f), 'utf8')
1247 < 1       const status = JSON.parse(text('status.json'))
1248 < 1       const events = readEventRows(path.join(dir, 'events.jsonl'))
1249 < 1       // optional: runs before #1352, and factory runs, have no red-checks.json; pastItems reads null as none
1250 < 1       let redChecks = null
1251 < 1       try { redChecks = JSON.parse(text('red-checks.json')) } catch { /* no red checks recorded */ }
1252 < 1       const items = pastItems({ status, events, redChecks })
1253 < 1       ev('past', { run: m, items: items ? items.length : 0 })
1254 < 1       if (items) {
1255 < 1         PAST = { run: m, items }
1256 < 1         fs.writeFileSync(path.join(OUT, 'past.json'), JSON.stringify(PAST, null, 2) + '\n')
1257 < 1       }
1258 < 1       log('past: run-' + m, items ? items.length + ' items' : 'finished green')
1259 < 1     } catch (e) { log('past: nothing read —', String(e.message || e).split('\n')[0]) }
1260 < 1   }
1261 < 1 }
1262 < 1 // a stories-v1 run proves the checker can run here before any builder spends anything:
1263 < 1 // exit 0 or 1 on the starting app is expected (a green or red finding); anything else — a
1264 < 1 // missing bun/checker (spawn ENOENT reads as 124/127), a crash, a timeout — is the sandbox,
1265 < 1 // not the app, and stops the run before it starts.
1266 < 1 if (W.stories) {
1267 < 1   const first = W.tasks.find((t) => t.facts.length)
1268 < 1   const r = runFacts(SETUP ? DEPS_DIR : BASE_DIR, { facts: [first.facts[0]] })[0]
1269 < 1   ev('checker:start', { exit: r.exit })
1270 < 1   if (r.exit !== 0 && r.exit !== 1) {
1271 < 1     await stall('checker', { tail: r.tail.slice(-300) })
1272 < 1     terminal('draft', 'the checker cannot run on this sandbox: ' + r.tail.slice(-300), null)
1273 < 1   }
1274 < 1 }
1275 < 1 const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
1276 < 1 const pool = []
1277 < 1 lastRise = now()   // setup and the checker preflight do not count against the first window
1278 < 1 const loops = []
1279 < 1 let buildersMax = pool.length
1280 < 1 // a builder is busy while it has a session open or a task claimed in its name
1281 < 1 const busy = (a) => live.has(a) || [...board.tasks.values()].some((t) => t.state === 'claimed' && t.owner === a)
1282 < 1 function openBuilder () {
1283 < 1   const a = pool.length < 26 ? LETTERS[pool.length] : LETTERS[pool.length % 26] + Math.floor(pool.length / 26)
1284 < 1   fs.cpSync(BASE_DIR, agentDir(a), { recursive: true }); linkDeps(agentDir(a)); gitCopy(agentDir(a))
1285 < 1   known[a] = new Set(BASE_PATHS)   // its first session pulls every published change (session -> pullInto)
1286 < 1   pool.push(a); buildersMax = Math.max(buildersMax, pool.length)
1287 < 1   ev('builder:open', { agent: a, pool: pool.length, ready: board.readyNow().length, busy: pool.filter(busy).length })
1288 < 1   log('opens builder', a, '(pool ' + pool.length + ')')
1289 < 1   loops.push(agentLoop(a))
1290 < 1 }
1291 < 1 async function spawner () {
1292 < 1   while (!settled && !outcome && now() < CLOCK_MS) {
1293 < 1     const want = board.readyNow().length - pool.filter((a) => !busy(a)).length
1294 < 1     for (let i = 0; i < want && pool.length < CAP; i++) openBuilder()
1295 < 1     await sleep(500)
1296 < 1   }
1297 < 1 }
1298 < 1 followMain()
1299 < 1 // a run launched behind main takes the move in before its first builder opens, so every copy starts
1300 < 1 // from the main that is there now (run-12 started one commit behind and met it only at the end)
1301 < 1 await absorbMain('start')
1302 < 1 await Promise.all([spawner(), settle(), mainWatcher()])
1303 < 1 await Promise.all(loops)
1304 < 1 await edgeChain
1305 < 1 // every step's receipt, green or red: what its latest checker result says it changed
1306 < 1 for (const row of stepReceipts([...latestResults(CHECK_OUT).values()])) ev('step:receipt', row)
1307 < 1 // checks-digest.json (#1491, check_digest.mjs): one row per checks/ file, so a missing receipt can be read
1308 < 1 try { fs.writeFileSync(path.join(OUT, 'checks-digest.json'), JSON.stringify(checkDigest(CHECK_OUT), null, 1)) } catch (e) { log('engine', `checks-digest: ${e.message}`) }
1309 < 1 if (trialsPending.size) await Promise.race([Promise.all([...trialsPending]), new Promise((r) => setTimeout(r, JEV_TIMEOUT_MS).unref())])
1310 < 1 await peerRewriteDraft()
1311 < 1 // the run's loose ends, read against the last edge's snapshot (BASE text when there is none)
1312 < 1 const looseSnap = outcome && outcome.pr === 'ready' ? outcome.snap : lastEdge ? lastEdge.snap : null
1313 < 1 const looseItems = looseEnds(board.beliefs, textAt(looseSnap))
1314 < 1 ev('loose-ends', { snap: looseSnap, items: looseItems })
1315 < 1 const summary = {
1316 < 1   workload: W.name, builders_max: buildersMax, cap: CAP, model: MODEL, settled, wall_ms: now(),
1317 < 1   // the commit the work sits on: --base, or the main a `peer` run moved to
1318 < 1   base: BASE_NOW,
1319 < 1   final: lastEdge && { snap: lastEdge.snap, green: lastEdge.green, perTask: lastEdge.perTask, check: lastEdge.check, conflicts: lastEdge.conflicts },
1320 < 1   snapshots: snapshots.length, beliefs: board.beliefs.length,
1321 < 1   loose_ends: { reported: looseItems.length, resolved: looseItems.filter((x) => x.state === 'resolved').length },
1322 < 1   // ticket 5: the terminal outcome. `ready` only from a settled green hash; anything else is a
1323 < 1   // draft with what the swarm believed attached, so the operator reads beliefs, not a transcript.
1324 < 1   outcome, debounce_ms: debounceMs(),
1325 < 1   attached: outcome && outcome.pr === 'draft' ? { stalls, open_conflicts: [...ledger.values()].filter((e) => e.open).map((e) => ({ path: e.path, region: e.region, between: e.between })), last_edge: lastEdge && { snap: lastEdge.snap, perTask: lastEdge.perTask, check: lastEdge.check } } : undefined,
1326 < 1   tokens: usage.reduce((a, u) => ({ input: a.input + (u.usage?.input_tokens || 0), output: a.output + (u.usage?.output_tokens || 0), cache_read: a.cache_read + (u.usage?.cache_read_input_tokens || 0), cache_write: a.cache_write + (u.usage?.cache_creation_input_tokens || 0) }), { input: 0, output: 0, cache_read: 0, cache_write: 0 }),
1327 < 1   sessions: usage.length,
1328 < 1   cost_usd: Math.round(usage.reduce((a, u) => a + (u.cost_usd || 0), 0) * 1000) / 1000,
1329 < 1 }
1330 < 1 fs.writeFileSync(path.join(OUT, 'summary.json'), JSON.stringify(summary, null, 1))
1331 < 1 fs.writeFileSync(path.join(OUT, 'board.json'), JSON.stringify(await board.read(), null, 1))
1332 < 1 writeCompactRecord()
1333 < 1 writeFailureRecord()
1334 < 1 log('summary', JSON.stringify(summary))
1335 < 1 // the join's blame and text, asked before the weave closes, for provenance.json at landing
1336 < 1 const JOIN = { blame: (await weave({ op: 'blame' })).blame || {}, files: (await weave({ op: 'merged' })).files || {} }
1337 < 1 const landed = await land()
1338 < 1 keeper.end()
1339 < 1 if (kataPending.size) await Promise.race([Promise.all([...kataPending]), new Promise((r) => setTimeout(r, KATA_EXIT_MS).unref())])
1340 < 1 // a post still pending is dropped at exit: say how many, so the record accounts for every post
1341 < 1 if (kataPending.size) ev('kata:mirror', { abandoned: kataPending.size })
1342 < 1 process.exit(landed)
1343 < 1 
1344 < 1 // #1401: under `enforce`, a settled green whose snapshot lost a peer's line (the survival fact,
1345 < 1 // weave `lost`) that a peer rewrite Jev read as `loses` covers ends a draft. A read covers a lost
1346 < 1 // line when it is on the line's path, names the line's author among its peers and holds the line.
1347 < 1 // A lost line no read answers (Jev off, a null, never asked) is recorded, never drafted.
1348 < 1 // The second look. The first read judges one edit alone, and a builder that folds main's line into
1349 < 1 // a line of its own deletes main's in an edit that puts nothing in its place: flock-baseline run-23
1350 < 1 // ended a draft with nothing lost. Only main's lines (stored labels, `@…`) are looked at again: what
1351 < 1 // main wrote is a fixed text, and a builder of this run still answers for its own lines on the board.
1352 < 1 // True when Jev reads every lost line as carried by the settled file.
1353 < 1 async function carriedBySettled (s, e, read) {
1354 < 1   const labels = String(e.author).split('|')
1355 < 1   if (SECOND_MODE !== 'main' || !jev || !labels.every((a) => a.startsWith('@'))) return false
1356 < 1   const row = { snap: s.snap, path: e.path, author: e.author, agent: read.agent, task: read.task, lost: e.lines }
1357 < 1   const settled = String(s.files[e.path] ?? '').split('\n')
1358 < 1   if (settled.length > SECOND_MAX_LINES) { ev('jev:peer-settled', { ...row, skipped: 'long', lines: settled.length, excused: false }); return false }
1359 < 1   const wrote = await weave({ op: 'wrote', path: e.path, authors: labels })
1360 < 1   // a hand commit says what it meant in its subject; a line another run landed has no sentence here
1361 < 1   const subjects = labels.filter((a) => a.startsWith('@c:')).map((a) => gitIn(TARGET, ['log', '-1', '--format=%s', a.slice(3)], { ok: true }).stdout.trim()).filter(Boolean)
1362 < 1   const t = W.tasks.find((x) => x.id === read.task)
1363 < 1   const sides = {
1364 < 1     theirs: { title: 'A commit on the main branch, merged while this run was at work', ...(subjects.length ? { claim: subjects.join('; ') } : {}) },
1365 < 1     ours: t ? { title: t.title, claim: claimOf(t.body) } : { title: board.tasks.get(read.task)?.title ?? 'A task of this run' },
1366 < 1   }
1367 < 1   let out = null
1368 < 1   await readTrial({ ask: jev.ask, key: 'carried', question: SETTLED_QUESTION, row, emit: (o) => { out = o },
1369 < 1     state: { path: e.path, theirs: (wrote.ok && wrote.lines) || e.lines, lost: e.lines, settled, sides } })
1370 < 1   const excused = !!out && out.answer === 'carried' && (out.confidence ?? 0) >= SECOND_MIN
1371 < 1   ev('jev:peer-settled', { ...(out || row), excused })
1372 < 1   return excused
1373 < 1 }
1374 < 1 async function peerRewriteDraft () {
1375 < 1   if (PEER_MODE !== 'enforce' || !outcome || outcome.pr !== 'ready') return
1376 < 1   const s = snapshots.findLast((x) => x.snap === outcome.snap)
1377 < 1   if (!s || !s.lost) return
1378 < 1   // a line restored with the same text is a new identity in the weave: the deleted one stays lost,
1379 < 1   // but the snapshot shows its text, so nothing was lost
1380 < 1   const shown = (e) => new Set(String(s.files[e.path] ?? '').split('\n'))
1381 < 1   const lost = s.lost.map((e) => ({ ...e, lines: e.lines.filter((l) => !shown(e).has(l)) })).filter((e) => e.lines.length)
1382 < 1   const losing = []
1383 < 1   for (const e of lost) {
1384 < 1     const covers = (l) => (r) => r.path === e.path && String(e.author).split('|').some((a) => (r.peers || []).includes(a)) && (r.peer || []).includes(l)
1385 < 1     const unread = e.lines.filter((l) => !peerReads.some((r) => covers(l)(r) && (r.answer === 'loses' || r.answer === 'keeps')))
1386 < 1     const mine = []
1387 < 1     for (const l of e.lines) for (const r of peerReads.filter(covers(l))) if (r.answer === 'loses' && !mine.includes(r)) mine.push(r)
1388 < 1     if (unread.length) ev('survival:unread', { snap: s.snap, path: e.path, author: e.author, lines: unread })
1389 < 1     if (mine.length && await carriedBySettled(s, e, mine[0])) continue
1390 < 1     for (const r of mine) if (!losing.includes(r)) losing.push(r)
1391 < 1   }
1392 < 1   if (!losing.length) return
1393 < 1   if (preLoose && outcome.snap === preLoose.snap) fellBack = true   // a verdict on the pre-cleanup snapshot itself has nothing to fall back to
1394 < 1   ev('peer:rewrite:draft', { rewrites: losing.map((r) => ({ agent: r.agent, path: r.path, peers: r.peers, after: r.after })) })
1395 < 1   terminal('draft', `a peer rewrite Jev read as losing the peer's change: ${[...new Set(losing.map((r) => r.path))].join(', ')}`, outcome)
1396 < 1   if (outcome.pr === 'ready') await peerRewriteDraft()   // the fallback snapshot is read too; once more at most (#1521)
1397 < 1 }
1398 < 1 
1399 < 1 // ── the compact record: each tested snapshot's patch against the previous one, and the weave's
1400 < 1 // ops with file texts as fingerprints (compact_record.mjs) ──
1401 < 1 function writeCompactRecord () {
1402 < 1   const lines = fs.readFileSync(path.join(OUT, 'weave-ops.jsonl'), 'utf8').split('\n')
1403 < 1   const rec = compactRecord(snapshots, BASE_FILES_0, lines)
1404 < 1   fs.writeFileSync(path.join(OUT, 'snapshots.jsonl'), rec.snapshots)
1405 < 1   fs.writeFileSync(path.join(OUT, 'weave-ops.digest.jsonl'), rec.digest)
1406 < 1 }
1407 < 1 
1408 < 1 // ── the ending: one commit on the target, and the rows the pull request card reads ──
1409 < 1 // Writes a snapshot's files into the target's working tree (the ones that exist; deletes the
1410 < 1 // ones that don't) and commits once with the engine's own git. Answers the commit's sha, or
1411 < 1 // null when the snapshot leaves the tree as it is at base.
1412 < 1 function commitSnapshot (snap, message) {
1413 < 1   const s = snapshots.find((x) => x.snap === snap)
1414 < 1   if (!s) return null
1415 < 1   writeFiles(TARGET, snapshotEntries(s))
1416 < 1   git(['add', '-A'])
1417 < 1   if (!git(['status', '--porcelain']).trim()) return null
1418 < 1   git(['commit', '-qm', message], { identity: true })
1419 < 1   return git(['rev-parse', 'HEAD']).trim()
1420 < 1 }
1421 < 1 // The landed commit's entry in main's memory: the join's weaves, authored by this run's tasks. The
1422 < 1 // boot's publish pushes it before the merge request. A join that is not the landed text (a draft
1423 < 1 // that fell back to an earlier snapshot) stores nothing; the next reader replays the commit instead.
1424 < 1 async function storeEntry (sha) {
1425 < 1   if (!MEMORY) return
1426 < 1   const r = await weave({ op: 'store', repo: TARGET, commit: sha, run: RUN_NO }).catch((e) => ({ ok: false, error: String(e) }))
1427 < 1   ev('weave:store', r.ok ? { commit: sha, ...r, ok: undefined } : { commit: sha, stored: false, reason: String(r.error).slice(0, 300) })
1428 < 1   log('memory', r.ok && r.stored ? `stored ${r.paths} changed path(s) for ${sha.slice(0, 12)}` : 'not stored: ' + (r.reason || r.error))
1429 < 1 }
1430 < 1 async function land () {
1431 < 1   if (outcome && outcome.pr === 'ready' && outcome.snap) {
1432 < 1     const sha = commitSnapshot(outcome.snap, `flock: settled ${outcome.snap}`)
1433 < 1     // (stories-v1 only; a claims-v1 run exits 1 below) settled green and identical to the base: every proof already held there, so there is nothing
1434 < 1     // to land and the run is done (shopping-list run-1, 2026-10-01: the approved screen and the
1435 < 1     // bundle's store already made the app); the boot reads HEAD = BASE with exit 0 as that
1436 < 1     // it still offers every checked step to the Jev step reading, as a landed run does (#1509)
1437 < 1     if (!sha) {
1438 < 1       ev('landing:empty', { snap: outcome.snap, grammar: W.grammar })
1439 < 1       // a claims-v1 probe green at the base is vacuous (#1522): only a stories-v1 run is done here
1440 < 1       if (W.grammar !== 'stories-v1') return 1
1441 < 1       await Promise.race([readAndRecord(null).catch(() => {}), sleep(20000)])
1442 < 1       return 0
1443 < 1     }
1444 < 1     // one `landing` row per task: the settled commit it landed in
1445 < 1     for (const t of W.tasks) ev('landing', { task: t.id, candidateSha: sha })
1446 < 1     await storeEntry(sha)
1447 < 1     writeProvenance(outcome.snap)
1448 < 1     await Promise.race([readAndRecord(null).catch(() => {}), sleep(20000)])
1449 < 1     return 0
1450 < 1   }
1451 < 1   if (lastEdge) {
1452 < 1     const sha = commitSnapshot(lastEdge.snap, `flock: draft ${lastEdge.snap}`)
1453 < 1     if (sha) {
1454 < 1       await storeEntry(sha)
1455 < 1       writeProvenance(lastEdge.snap)
1456 < 1       for (const t of W.tasks) {
1457 < 1         if ((lastEdge.perTask[t.id] || []).some((x) => x !== 0)) ev('parked', { task: t.id, reason: `red at ${lastEdge.snap}` })
1458 < 1       }
1459 < 1     }
1460 < 1   }
1461 < 1   return 1
1462 < 1 }
1463 < 1 
1464 < 1 // provenance.json (#1404, provenance.mjs): the landed snapshot's hunks by task and the surprises.
1465 < 1 // The join's blame is kept only for paths whose text is the landed text.
1466 < 1 function writeProvenance (snap) {
1467 < 1   try {
1468 < 1     const s = snapshots.find((x) => x.snap === snap)
1469 < 1     if (!s) return
1470 < 1     const landed = Object.fromEntries(Object.entries(s.files).filter(([p]) => s.exists[p]))
1471 < 1     const blame = Object.fromEntries(Object.entries(JOIN.blame).filter(([p]) => p in landed && JOIN.files[p] === landed[p]))
1472 < 1     const events = readEventRows(path.join(OUT, 'events.jsonl'))
1473 < 1     const prov = buildProvenance({ landed, blame, events, lost: s.lost || [] })
1474 < 1     fs.writeFileSync(path.join(OUT, 'provenance.json'), JSON.stringify({ snap, ...prov }, null, 1))
1475 < 1   } catch (e) {
1476 < 1     ev('provenance:error', { snap, error: String(e && e.message || e).slice(0, 500) })
1477 < 1   }
1478 < 1 }
1479 < 1 
1480 < 1 // ── what went wrong: red-checks.json on every run ──────
1481 < 1 // red-checks.json holds the last tested snapshot's red facts and the run-wide check when it was
1482 < 1 // red, each with the checker's own result JSON when it wrote one (at most 8 KiB); entries are
1483 < 1 // added in order while the whole stays within 64 KiB, and one that would pass it is left out.
1484 < 1 function writeFailureRecord () {
1485 < 1   const LIMIT = 65536
1486 < 1   const rec = { snap: lastEdge ? lastEdge.snap : null, limit_bytes: LIMIT, truncated: false, red: [] }
1487 < 1   const cands = lastEdge ? [...(lastEdge.red || [])] : []
1488 < 1   if (lastEdge && W.check && lastEdge.check !== 0) cands.push({ task: 'check', cmd: W.check.join(' '), exit: lastEdge.check, tail: lastEdge.checkTail || '' })
1489 < 1   let size = Buffer.byteLength(JSON.stringify(rec))
1490 < 1   for (const c of cands) {
1491 < 1     const e = { ...c }
1492 < 1     if (c.clause) {
1493 < 1       const f = path.join(CHECK_OUT, `${String(c.clause).replaceAll('/', '_')}@edge.json`)
1494 < 1       try { if (fs.statSync(f).size <= 8192) e.checker = JSON.parse(fs.readFileSync(f, 'utf8')) } catch { /* no checker result */ }
1495 < 1     }
1496 < 1     const n = Buffer.byteLength(JSON.stringify(e)) + 1
1497 < 1     if (size + n > LIMIT) { rec.truncated = true; continue }
1498 < 1     size += n; rec.red.push(e)
1499 < 1   }
1500 < 1   fs.writeFileSync(path.join(OUT, 'red-checks.json'), JSON.stringify(rec, null, 1))
1501 < 1 }
1502 < 1 
1503 < 1 