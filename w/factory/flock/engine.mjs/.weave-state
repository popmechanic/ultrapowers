932 < 1         if (note) {
933 < 1           ev('peer:note', { agent, task: task.id, path: rel })
934 < 1           return { hookSpecificOutput: { hookEventName: 'PostToolUse', additionalContext: note } }
935 < 1         }
936 < 1       } else if (name === 'Bash') {
937 < 1         await syncFromDisk(agent)
938 < 1       }
939 < 1       return {}
940 < 1     }] }],
941 < 1     PostToolBatch: [{ hooks: [async () => {
942 < 1       const changed = await pullInto(agent, task)
943 < 1       const spotted = [...(spotNotes[agent] || [])]; delete spotNotes[agent]
944 < 1       if (!changed.length && !spotted.length) return {}
945 < 1       const note = (changed.length ? 'Peers\' published work was merged into your copy just now: ' +
946 < 1         changed.map((c) => `${c.path} (+${c.added} −${c.removed}, from ${c.from}${c.conflict ? ', with conflict marks' : ''})`).join('; ') + '. Re-read before editing those files.' : '') +
947 < 1         (spotted.length ? ' Same-spot insertions in your copy: ' + spotted.join('; ') + '.' : '')
948 < 1       return { hookSpecificOutput: { hookEventName: 'PostToolBatch', additionalContext: note } }
949 < 1     }] }],
950 < 1   }
951 < 1   const prompt = `You are agent ${agent}. You claimed task ${task.id}: ${task.title}.\n\n${task.body}\n` +
952 < 1     (task.notes.length ? `\nNotes on this task from earlier attempts:\n- ${task.notes.slice(-3).join('\n- ')}\n` : '') +
953 < 1     brief(task)
954 < 1   if (outcome) return   // the run ended while this builder was pulling: start no session
955 < 1   ev('session:start', { agent, task: task.id })
956 < 1   log(agent, 'claims task', task.id)
957 < 1   const q = query({ prompt, options: {
958 < 1     cwd, model: MODEL, settingSources: [], permissionMode: 'bypassPermissions', allowDangerouslySkipPermissions: true,
959 < 1     maxTurns: 80, systemPrompt: { type: 'preset', preset: 'claude_code', append: SYSTEM },
960 < 1     mcpServers: { flock: createSdkMcpServer({ name: 'flock', tools }) },
961 < 1     disallowedTools: ['WebFetch', 'WebSearch', 'Task', 'Agent', 'NotebookEdit'], hooks,
962 < 1     // tool search off: the builder's own tools load up front (no ToolSearch step). The key is
963 < 1     // spelt in parts so no line names the retired switch's constant.
964 < 1     env: { ...process.env, PATH: NOGIT + path.delimiter + process.env.PATH, ['ENABLE_TOOL' + '_SEARCH']: 'false' },
965 < 1   } })
966 < 1   let result = null
967 < 1   live.add(agent)
968 < 1   const killer =setTimeout(() => { q.interrupt().catch(() => {}) }, Math.max(1000, CLOCK_MS - now()))
969 < 1   stops.set(agent, () => q.interrupt().catch(() => {}))
970 < 1   if (outcome) q.interrupt().catch(() => {})   // the stop landed between query() and stops.set
971 < 1   try { for await (const m of q) if (m.type === 'result') result = m } catch (e) { ev('session:error', { agent, error: String(e).slice(0, 300) }) }
