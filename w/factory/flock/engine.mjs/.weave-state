0 < 1 #!/usr/bin/env node
1 < 1 // The Flock engine (map #1292: adopted as an experiment behind the boot's engine switch; the
2 < 1 // round-3 arm is the measured shape). Grown from the laptop prototype (flock-runroom's host.mjs).
3 < 1 //
4 < 1 //   node factory/flock/engine.mjs --plan <plan.md> [--plan-json <parse>] --target <dir> --base <sha> --run-dir <dir>
5 < 1 //        [--builder sdk|scripted:<json>] [--clock 13800] [--stall-minutes 20]
6 < 1 //        [--kata-url <hub> --kata-json <record> [--kata-actor engine:<run>]]
7 < 1 //   (with both --kata-url and --kata-json, and a record that reads, the board's
8 < 1 //    claims, releases, reopens and closes are mirrored onto Kata as comments while the run is in
9 < 1 //    flight; without them the board stays in memory and sends nothing.)
10 < 1 //
11 < 1 // With N builders working one plan together, each on its own copy, merging with each other
12 < 1 // between tool batches, the swarm settles on green code; the engine then leaves the target one
13 < 1 // commit ahead of --base and writes the rows the pull request card reads (events.jsonl).
14 < 1 //
15 < 1 // The engine is code, not a model: it seeds the board, runs each builder's session,
16 < 1 // keeps every copy's weave (factory/flock/weave.py), merges peers after each tool
17 < 1 // batch, and tests every published snapshot at the edge. Builders pull their own
18 < 1 // work from the board and never run git.
19 < 1 import { spawnSync } from 'node:child_process'
20 < 1 import crypto from 'node:crypto'
21 < 1 import fs from 'node:fs'
22 < 1 import path from 'node:path'
23 < 1 import { fileURLToPath } from 'node:url'
24 < 1 import util from 'node:util'
25 < 1 import { workloadFromPlan } from './plan.mjs'
26 < 1 import { Board } from './flock_board.mjs'
27 < 1 import { scopeOf } from './scope.mjs'
28 < 1 import { editSpans } from './edit_spans.mjs'
29 < 1 import { compactRecord } from './compact_record.mjs'
30 < 1 import { pullScope } from './pulls.mjs'
31 < 1 import { makeJevClient, JEV_TIMEOUT_MS } from '../jev-client.mjs'
32 < 1 import { readTrial, claimOf } from './trial_reading.mjs'
33 < 1 import { mirrorBoard } from './kata_mirror.mjs'
34 < 1 import { looseEnds } from './loose_ends.mjs'
35 < 1 import { gitIn, utf8, writeFiles, snapshotEntries, startWeave, readEventRows, kataIds, POLICY_FLOCK, EXAM_MS } from './io.mjs'
36 < 1 import { makeKataClient, httpTransport } from '../../fleet/kata-client.mjs'
37 < 1 import { lastSteps, latestResults, readSteps } from './step_reading.mjs'
38 < 1 import { pastItems } from './past.mjs'
39 < 1 import { stepReceipts } from './step_receipts.mjs'
40 < 1 import { checkDigest } from './check_digest.mjs'
41 < 1 import { peerNote } from './peer_note.mjs'
42 < 1 import { buildProvenance } from './provenance.mjs'
