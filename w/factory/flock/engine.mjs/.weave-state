999 < 1 // ── main is a peer (the main-is-a-peer design, stage 3) ───────────────────────
1000 < 1 // A `peer` run follows the target's default branch: a look before its first builder opens, one
1001 < 1 // every MAIN_POLL_MS, and one before a green settle. When it moves, the moved main's stored weaves
1002 < 1 // are published into the run as the peer `main` (keeper op `main`), so every copy takes its text in
1003 < 1 // through the pulls it already makes, a clash with a builder is an ordinary conflict with builders
1004 < 1 // alive to resolve it, and the run's base moves to the new tip: the scope rule, every fact's
1005 < 1 // ULTRA_BASE, each copy's git index and the landing commit all read it. What the weave does not
1006 < 1 // carry (a file that is not text) is copied into each copy as it is on main. Nothing here fails a
1007 < 1 // run: a move that cannot be taken in ends the following, with its reason on a `main:off` row, and
1008 < 1 // the publish's catch-up meets the moved main as it did before.
1009 < 1 let MAIN_BRANCH = null    // the default branch a `peer` run follows; null follows nothing
1010 < 1 let mainOff = null        // why this run stopped following main
1011 < 1 // a changed file that means the installed dependencies may be stale: the setup runs again
1012 < 1 const MANIFEST = /(^|\/)(package\.json|bun\.lockb?|package-lock\.json|requirements[^/]*\.txt|pyproject\.toml|uv\.lock|poetry\.lock|Pipfile\.lock|Cargo\.(toml|lock)|go\.(mod|sum))$/
1013 < 1 function followMain () {
1014 < 1   if (MAIN_MODE !== 'peer' || !MEMORY) return
1015 < 1   const ref = gitIn(TARGET, ['symbolic-ref', '-q', 'refs/remotes/origin/HEAD'], { ok: true })
1016 < 1   const name = ref.status === 0 ? ref.stdout.trim() : ''
1017 < 1   if (name.startsWith('refs/remotes/origin/')) MAIN_BRANCH = name.slice('refs/remotes/origin/'.length)
1018 < 1   ev('main:follow', { branch: MAIN_BRANCH, poll_ms: MAIN_POLL_MS })
1019 < 1 }
1020 < 1 function stopFollowing (reason, more = {}) {
1021 < 1   mainOff = reason
1022 < 1   ev('main:off', { reason, ...more }); log('main: no longer followed —', reason)
1023 < 1   return false
1024 < 1 }
1025 < 1 // the default branch's tip as the remote has it now, or null when it cannot be read
1026 < 1 function mainTip () {
1027 < 1   const r = spawnSync('git', ['-C', TARGET, 'fetch', '-q', 'origin', `refs/heads/${MAIN_BRANCH}`], { encoding: 'utf8', timeout: 60000 })
1028 < 1   return r.status === 0 ? gitIn(TARGET, ['rev-parse', 'FETCH_HEAD']).stdout.trim() : null
1029 < 1 }
1030 < 1 // Looks at main once and takes a move in. True when the base moved (the caller then asks for an
1031 < 1 // edge). It runs on the edge chain, so no edge is copying the base while it is replaced.
1032 < 1 function absorbMain (why) {
1033 < 1   if (!MAIN_BRANCH || mainOff || outcome) return Promise.resolve(false)
1034 < 1   const moved = edgeChain.then(() => absorb(why)).catch((e) => stopFollowing('the move could not be taken in: ' + String(e && e.message || e).slice(0, 300)))
1035 < 1   edgeChain = moved
1036 < 1   return moved
1037 < 1 }
1038 < 1 async function absorb (why) {
1039 < 1   if (mainOff || outcome) return false
1040 < 1   const tip = mainTip()
1041 < 1   if (!tip || tip === BASE_NOW) return false
1042 < 1   if (gitIn(TARGET, ['merge-base', '--is-ancestor', BASE_NOW, tip], { ok: true }).status !== 0) return stopFollowing('main no longer holds the commit this run is based on', { tip })
1043 < 1   const changed = git(['diff', '--name-only', '--no-renames', BASE_NOW, tip]).split('\n').filter(Boolean)
1044 < 1   // the moved base is laid out beside the old one, and the keeper asked, before anything is replaced
1045 < 1   const next = BASE_DIR + '.next'
1046 < 1   fs.rmSync(next, { recursive: true, force: true })
1047 < 1   writeBase(next, tip)
1048 < 1   const nextPaths = walk(next)
1049 < 1   const r = await weave({ op: 'main', repo: TARGET, commit: tip, remote: 'origin', skip: SKIP.source }).catch((e) => ({ ok: false, error: String(e) }))
1050 < 1   if (!r.ok || !r.moved) {
1051 < 1     fs.rmSync(next, { recursive: true, force: true })
1052 < 1     return stopFollowing(r.ok ? r.reason : String(r.error).slice(0, 300), { tip, paths: r.paths })
1053 < 1   }
1054 < 1   // the keeper holds main's weaves now: the base moves
1055 < 1   const from = BASE_NOW
1056 < 1   const wasText = new Set(BASE_PATHS), isTextNow = new Set(nextPaths)
1057 < 1   fs.rmSync(BASE_DIR, { recursive: true, force: true }); fs.renameSync(next, BASE_DIR)
1058 < 1   BASE_NOW = tip; RUN_ENV.ULTRA_BASE = tip
1059 < 1   BASE_PATHS = nextPaths
1060 < 1   BASE_FILES = Object.fromEntries(BASE_PATHS.map((p) => [p, readOr(path.join(BASE_DIR, p))]))
1061 < 1   git(['checkout', '-q', '--detach', tip])   // the landing commit goes on the moved main
1062 < 1   // the installed dependencies, again, when main changed what they are read from; the old ones
1063 < 1   // stay in place when the setup fails on the moved main
1064 < 1   let setup = null
1065 < 1   if (SETUP && changed.some((p) => MANIFEST.test(p))) {
1066 < 1     const old = DEPS_DIR + '.old'
1067 < 1     fs.rmSync(old, { recursive: true, force: true }); fs.renameSync(DEPS_DIR, old)
1068 < 1     fs.cpSync(BASE_DIR, DEPS_DIR, { recursive: true })
1069 < 1     const t0 = Date.now()
1070 < 1     const x = spawnSync(SETUP[0], SETUP.slice(1), { cwd: DEPS_DIR, encoding: 'utf8', timeout: EXAM_MS.setup, env: RUN_ENV })
1071 < 1     setup = { exit: x.status, ms: Date.now() - t0 }
1072 < 1     ev('setup', { cmd: SETUP[SETUP.length - 1], exit: x.status, ms: setup.ms, at: tip })
1073 < 1     if (x.status === 0) fs.rmSync(old, { recursive: true, force: true })
1074 < 1     else { fs.rmSync(DEPS_DIR, { recursive: true, force: true }); fs.renameSync(old, DEPS_DIR) }
1075 < 1     DEP_DIRS = depDirs()
1076 < 1   }
1077 < 1   // what the weave does not carry: a file that is text neither at the old base nor at the new
1078 < 1   const other = changed.filter((p) => !SKIP.test(p) && !wasText.has(p) && !isTextNow.has(p))
1079 < 1   for (const a of pool) {
1080 < 1     const dir = agentDir(a)
1081 < 1     for (const p of other) {
1082 < 1       const src = path.join(BASE_DIR, p), dst = path.join(dir, p)
1083 < 1       fs.rmSync(dst, { recursive: true, force: true })
1084 < 1       if (fs.existsSync(src)) { fs.mkdirSync(path.dirname(dst), { recursive: true }); fs.cpSync(src, dst, { verbatimSymlinks: true }) }
1085 < 1     }
1086 < 1     gitIn(dir, ['read-tree', tip]); gitIn(dir, ['update-index', '-q', '--refresh'], { ok: true })
1087 < 1     if (setup) linkDeps(dir)
1088 < 1   }
1089 < 1   fs.writeFileSync(path.join(OUT, 'base'), tip + '\n')   // the boot publishes against this base
1090 < 1   ev('main:moved', { from, to: tip, why, changed: changed.length, woven: r.paths, other, via: r.via, setup })
1091 < 1   log('main moved', from.slice(0, 12), '->', tip.slice(0, 12), `(${changed.length} file(s), ${r.paths.length} merged as a peer's)`)
1092 < 1   await board.post({ by: 'host', claim: `main moved to ${tip.slice(0, 12)}: ${changed.length} file(s) changed there (${changed.slice(0, 8).join(', ')}${changed.length > 8 ? ', …' : ''}). They merge into every copy like a peer's work, from \`main\`` })
1093 < 1   lastPublish = now(); lastChange = now()
1094 < 1   return true
1095 < 1 }
1096 < 1 async function mainWatcher () {
1097 < 1   while (MAIN_BRANCH && !mainOff && !settled && !outcome && now() < CLOCK_MS) {
1098 < 1     // the next look is due by the clock, in short sleeps so a run that ends is not kept waiting.
1099 < 1     // Counting the sleeps ran late: each one stretches while an edge's tests hold the loop
1100 < 1     // (flock-baseline run-12, 2026-11-13: the 60 s look had not come by 72.6 s, and the look before
1101 < 1     // settling took the move in).
1102 < 1     const due = now() + MAIN_POLL_MS
1103 < 1     while (now() < due && !settled && !outcome) await sleep(500)
1104 < 1     if (await absorbMain('poll')) edge('main moved')
1105 < 1   }
1106 < 1 }
1107 < 1 
1108 < 1 // ── settling ──────────────────────────────────────────────────────────────────
1109 < 1 let outcome = null   // ticket 5: { pr: 'ready' | 'draft', why, snap }
1110 < 1 function debounceMs () {
1111 < 1   const xs = [...edgeLatency].sort((a, b) => a - b)
1112 < 1   const p90 = xs.length ? xs[Math.min(xs.length - 1, Math.floor(0.9 * xs.length))] : 500
1113 < 1   return Math.max(1000, 2 * p90)
1114 < 1 }
1115 < 1 let preLoose = null   // the green edge result the L:loose task was opened on (#1521)
1116 < 1 let fellBack = false  // the run already ends on preLoose: a draft after that stands
1117 < 1 function terminal (pr, why, r) {
1118 < 1   // any draft after the loose-ends task was added lands the green snapshot from before it instead (#1521)
1119 < 1   if (pr === 'draft' && preLoose && !fellBack) {
1120 < 1     fellBack = true
1121 < 1     ev('loose:fallback', { snap: preLoose.snap, from: r && r.snap, why })
1122 < 1     log('LOOSE FALLBACK to', preLoose.snap, why)
1123 < 1     settled = { t: now(), snap: preLoose.snap }; ev('settled', settled)
1124 < 1     pr = 'ready'; why = 'settled green before the loose-ends task; its cleanup was dropped'; r = preLoose
1125 < 1   }
1126 < 1   outcome = { pr, why, snap: r && r.snap, t: now() }
1127 < 1   ev('terminal', outcome); log('TERMINAL', pr, why)
1128 < 1 }
1129 < 1 async function settle () {
1130 < 1   while (!settled && !outcome && now() < CLOCK_MS) {
1131 < 1     await sleep(500)
1132 < 1     const stalled = () => STALL_MS > 0 && now() - lastRise > STALL_MS && lastSessionEnd > lastRise
1133 < 1     if (stalled() && (await edgeChain, stalled())) {
1134 < 1       // no progress (#1334): the best-green count has not risen within the limit, a builder session
1135 < 1       // has ended since it last did, and no queued snapshot raised it (the edge chain is drained)
1136 < 1       await stall('no-progress', { since_rise_ms: now() - lastRise, limit_ms: STALL_MS, best: bestGreen, live: [...live] })
1137 < 1       terminal('draft', `no progress: the green count has not risen for ${Math.round((now() - lastRise) / 1000)} s`, lastEdge)
1138 < 1       for (const stop of stops.values()) stop()
1139 < 1       break
1140 < 1     }
1141 < 1     const all = [...board.tasks.values()]
1142 < 1     // rule S1: nothing can change the code any more.
1143 < 1     // a claimed task is work in progress even before its session goes live (atlas AE5: a resolve
1144 < 1     // task claimed 0.5 s after it was added read as a deadlock, and the run ended a draft on green code)
1145 < 1     const claimed = all.some((t) => t.state === 'claimed')
1146 < 1     if (!live.size && !claimed && !board.allDone() && !board.readyNow().length && now() - lastChange > debounceMs()) {
1147 < 1       // deadlock: no agent working, nothing claimable, work left. Nobody will publish again.
1148 < 1       await stall('deadlock', { left: all.filter((t) => t.state !== 'done').map((t) => ({ id: t.id, state: t.state, depends_on: t.depends_on })) })
1149 < 1       terminal('draft', 'deadlock: work left and nothing claimable', lastEdge); break
1150 < 1     }
1151 < 1     // round 3, `tested`: once the last tested hash is green and nothing was published after it,
1152 < 1     // nothing can change the code, so the debounce buys nothing; it still guards an untested publish
1153 < 1     const tested = lastEdge && lastEdge.green && lastEdge.t >= lastPublish
1154 < 1     if (live.size || !board.allDone() || (!tested && now() - lastChange < debounceMs())) continue
1155 < 1     const r = await edge('settle check')
1156 < 1     // one more look at main before a green run ends: a move is taken in and tested like any other
1157 < 1     if (r.green && await absorbMain('settle')) { edge('main moved'); continue }
1158 < 1     if (r.green && LOOSE_MODE === 'work' && !board.tasks.has('L:loose')) {
1159 < 1       const loose = looseEnds(board.beliefs, textAt(r.snap)).filter((x) => x.state !== 'resolved')
1160 < 1       if (loose.length) {
1161 < 1         const paths = [...new Set(loose.map((x) => x.path))]
1162 < 1         looseWhy = loose.map((x) => ({ path: x.path, claim: x.claim }))
1163 < 1         preLoose = r
1164 < 1         const body = `Every task's facts and the run-wide check pass, but builders reported loose ends: things outside their tasks' files their changes left stale or broken.\n\n` +
1165 < 1           loose.map((x) => `- \`${x.path}\`: ${x.claim} (posted by ${x.by})${x.stale !== undefined ? `; the text still wrong there: ${JSON.stringify(x.stale)}` : ''}`).join('\n') +
1166 < 1           `\n\nFix each that is still wrong. Change only what a loose end names: leave other builders' lines as they are, and post a belief if one of them needs changing. If you judge one should stay as it is, leave it and post a belief saying why. Run the run-wide check, publish, then call done.`
1167 < 1         await board.addTask({ id: 'L:loose', title: LOOSE_TITLE, depends_on: [], state: 'ready', owner: null, notes: [], reopen: 0, facts: [], files: paths, body })
1168 < 1         ev('loose-task', { snap: r.snap, paths, body }); log('loose-ends task for', paths.join(','))
1169 < 1         continue
1170 < 1       }
1171 < 1     }
1172 < 1     if (r.green) { settled = { t: now(), snap: r.snap }; ev('settled', settled); log('SETTLED on', r.snap); terminal('ready', 'settled green', r); break }
1173 < 1     let acted = false
1174 < 1     for (const t of all) {
1175 < 1       const bad = (r.perTask[t.id] || []).some((x) => x !== 0)
1176 < 1       if (!bad) continue
1177 < 1       if (t.reopen >= MAX_REOPEN) continue
1178 < 1       acted = true
1179 < 1       t.reopen += 1
1180 < 1       // the merge orders two insertions at one spot by their text, which no builder chose: a task
1181 < 1       // reopened red is told of each such spot in its files (flock-baseline run-10: tasks 12 and 13
1182 < 1       // each added one rule to one list, the merge put them in alphabetical order, both went red)
1183 < 1       const here = [...spots.values()].filter((x) => (t.files || []).includes(x.p)).map((x) => x.text)
1184 < 1       await board.reopen(t, `edge snapshot ${r.snap} is red on this task's facts ${JSON.stringify(r.perTask[t.id])}; check exit ${r.check}` +
1185 < 1         (here.length ? `. Look here first: ${here.join('; ')}` : ''))
1186 < 1       await board.post({ by: 'host', claim: `edge red on task ${t.id} at snapshot ${r.snap}`, task: t.id })
1187 < 1       ev('reopen', { task: t.id, snap: r.snap, n: t.reopen }); log('reopen task', t.id, 'at', r.snap)
1188 < 1     }
1189 < 1     for (const p of r.blocking || []) {
1190 < 1       const id = 'R:' + p
1191 < 1       if (board.tasks.has(id) && board.tasks.get(id).state !== 'done') continue
1192 < 1       const prev = board.tasks.get(id)
1193 < 1       if (prev && prev.reopen >= MAX_REOPEN) continue
1194 < 1       acted = true
1195 < 1       const ann = (openEntries(p)[0] || {}).annotated || (r.annotated || {})[p]
1196 < 1       const made = openEntries(p).some((e) => e.made)
1197 < 1       await board.addTask({ id, title: 'Resolve conflict marks in ' + p, depends_on: [], state: 'ready', owner: null, notes: [], reopen: prev ? prev.reopen + 1 : 0, facts: [],
1198 < 1         body: `${made ? `Main and a builder each created \`${p}\` without seeing the other's, and the merge put one whole file after the other. It must become one file that keeps what main's version does and what the builder's does` : `Two agents changed the same part of \`${p}\` and the merge marked it as a conflict`}. Here is the merged file with the conflict sections marked (<<<<<<< begin … / ======= begin … / >>>>>>> end conflict; "left" and "right" are the two sides):\n\n\`\`\`\n${ann || '(annotation unavailable)'}\n\`\`\`\n\nYour copy holds the merged text WITHOUT the markers. Make that part of \`${p}\` say what both sides meant (edit with Edit if it does not already), run the tests, then call resolve_conflict for \`${p}\` and then done.` })
1199 < 1       ev('resolve-task', { path: p, snap: r.snap }); log('resolve task for', p)
1200 < 1     }
1201 < 1     if (W.check && r.check !== 0 && all.every((t) => (r.perTask[t.id] || []).every((x) => x === 0))) {
1202 < 1       // ticket 5: the check is red with every fact green. The old loop restarted the quiet
1203 < 1       // window and told nobody, so the run waited for its clock. Now the check owns a task.
1204 < 1       ev('red-check-only', { snap: r.snap, tail: r.checkTail }); log('check red with every fact green')
1205 < 1       const prev = board.tasks.get('C:check')
1206 < 1       if (!prev || (prev.state === 'done' && prev.reopen < MAX_REOPEN)) {
1207 < 1         acted = true
1208 < 1         await stall('check_red', { snap: r.snap, tail: (r.checkTail || '').slice(-300) })
1209 < 1         await board.addTask({ id: 'C:check', title: 'Make the run-wide check green', depends_on: [], state: 'ready', owner: null, notes: [], reopen: prev ? prev.reopen + 1 : 0, facts: [W.check],
1210 < 1           body: `Every task's facts pass on the merged code, but the run-wide check does not. Its output ends:\n\n\`\`\`\n${(r.checkTail || '').slice(-600)}\n\`\`\`\n\nFix the cause (prefer not to rewrite a peer's lines; post a belief if the fix is theirs), run the check, publish, then done.` })
1211 < 1       }
1212 < 1     }
1213 < 1     if (!acted) {
1214 < 1       // exhausted: red or blocked, and every lever (reopen, resolve task, check task) is spent.
1215 < 1       // Waiting for the clock buys nothing: publish the draft now with the beliefs attached.
