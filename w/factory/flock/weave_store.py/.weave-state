0 < 1 #!/usr/bin/env python3
2 > 1 """The weave store: main's memory (the main-is-a-peer design).
1 < 2 """The weave store: main's memory (the main-is-a-peer design, stage 1). No engine reads it yet.
2 < 1 
3 < 1 Each tree of a target's default branch has at most one stored weave, an *entry*: one commit on
4 < 1 the ref `refs/ultrapowers/weave/v1` of the target repository, subject `weave <tree sha>`. The ref
5 < 1 is an append-only log of entries; their order means nothing, and lookup is by subject. Where two
6 < 1 entries name one tree, the one nearer the root is the entry.
7 < 1 
8 < 1 An entry's tree:
9 < 1   meta.json                   {"v": 1, "tree", "via": "genesis" | "replay" | "run", "unwoven": [path]}
10 < 1   w/<path>/.weave-state       the Manyana state string of <path>
11 < 1   w/<path>/.weave-auth        {line key: [label]}, who wrote each line (weave.py's kauth)
12 < 1   w/<path>/.weave-dels        {line key: [label]}, who deleted each line (weave.py's kdel)
13 < 1 
14 < 1 A path with no `.weave-state` has the weave `initial_state` of its text at that tree. A path that
15 < 1 is ever not a regular UTF-8 file is listed in `unwoven` and never woven again.
16 < 1 
17 < 1 The one rule (probe, n=25 files, 917 commits, 2026-11-12: two weaves of one text built by
18 < 1 different routes merged back to that text 0 times in 25): a tree's weave is built once and shared.
19 < 1 A commit with no entry is replayed from the nearest stored first-parent ancestor, one commit at a
20 < 1 time, each changed file through the keeper's `rewrite`. That recipe is a pure function of the
21 < 1 ancestor's entry and the commits, so two sandboxes write byte-identical entries, and replaying
22 < 1 A->B->C equals replaying B->C from a stored B. A replayed line is authored `@c:<commit sha12>`.
23 < 1 
24 < 1 Git stays the fact: every load checks each stored path's visible text against git's text at that
25 < 1 tree, and a mismatch raises Drift.
26 < 1 
27 < 1     python3 factory/flock/weave_store.py open --repo <dir> --commit <sha> [--remote origin]
28 < 1     python3 factory/flock/weave_store.py push --repo <dir> [--remote origin]
29 < 1 
30 < 1     python3 factory/flock/weave_store.py join --repo <dir> --run <sha> --onto <sha> --out <file> [--remote origin]
31 < 1     python3 factory/flock/weave_store.py settle --repo <dir> --commit <sha> --from <file>
32 < 1 
33 < 1 `join` is the catch-up's merge: the run's entry joined with the moved main's, one JSON line
34 < 1 {"joined": true, "conflicts": [path], "files": {path: text | null}, "paths": [path]}: `paths` every
35 < 1 path it decided, `files` those whose text differs from the moved main's; or {"joined": false,
36 < 1 "reason"}. The joined Memory goes to --out.
37 < 1 `settle` stores that Memory as the entry of the commit the catch-up then made:
38 < 1 {"stored": true, "entry"} or {"stored": false, "reason"}.
39 < 1 
40 < 1 `open` prints one JSON line: {"memory": true, "tree", "via", "stored", "unwoven"} (exit 0),
41 < 1 {"memory": false, "reason": "before-genesis"} (exit 0), or {"memory": false, "reason": "drift",
42 < 1 "paths"} (exit 1). With --remote it syncs first, and a store it begins is pushed before it is used.
43 < 1 """
44 < 1 import json, os, subprocess, sys, tempfile
45 < 1 
46 < 1 sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
47 < 1 import weave as W  # noqa: E402
48 < 1 
49 < 1 M = W.M
50 < 1 REF = "refs/ultrapowers/weave/v1"
51 < 1 REMOTE_REF = "refs/ultrapowers/weave-remote/v1"
52 < 1 STATE, AUTH, DELS = ".weave-state", ".weave-auth", ".weave-dels"
53 < 1 REGULAR = ("100644", "100755")
54 < 1 ABSENT = "000000"
55 < 1 IDENTITY = {"GIT_AUTHOR_NAME": "flock", "GIT_AUTHOR_EMAIL": "flock@ultrapowers.invalid",
56 < 1             "GIT_COMMITTER_NAME": "flock", "GIT_COMMITTER_EMAIL": "flock@ultrapowers.invalid"}
57 < 1 
58 < 1 
59 < 1 class Drift(Exception):
60 < 1     """Stored weaves whose visible text is not git's text at their tree."""
61 < 1 
62 < 1     def __init__(self, tree, paths):
63 < 1         super().__init__("weave drift at %s: %s" % (tree[:12], ", ".join(paths[:5])))
64 < 1         self.tree, self.paths = tree, paths
65 < 1 
66 < 1 
67 < 1 def git(repo, *args, data=None, env=None, ok=False):
68 < 1     """One git process in `repo`; its stdout as bytes. A non-zero exit raises unless `ok`."""
69 < 1     r = subprocess.run(["git", "-C", repo, *args], input=data, capture_output=True,
70 < 1                        env=None if env is None else {**os.environ, **env})
71 < 1     if r.returncode != 0 and not ok:
72 < 1         raise RuntimeError("git %s exited %d: %s" % (" ".join(args), r.returncode, r.stderr.decode("utf-8", "replace")))
73 < 1     return r.stdout if r.returncode == 0 else None
74 < 1 
75 < 1 
76 < 1 def out(repo, *args, **kw):
77 < 1     r = git(repo, *args, **kw)
78 < 1     return None if r is None else r.decode().strip()
79 < 1 
80 < 1 
81 < 1 def tree_of(repo, rev):
82 < 1     return out(repo, "rev-parse", rev + "^{tree}")
83 < 1 
84 < 1 
85 < 1 def entries(repo, ref=REF):
86 < 1     """{tree sha: entry commit} off `ref`; of two entries for one tree, the one nearer the root."""
87 < 1     log = out(repo, "log", "--format=%H %s", ref, ok=True)
88 < 1     found = {}
89 < 1     for line in (log or "").splitlines():   # tip first, so a rootward entry overwrites
90 < 1         sha, _, subject = line.partition(" ")
91 < 1         if subject.startswith("weave "):
92 < 1             found[subject[len("weave "):]] = sha
93 < 1     return found
94 < 1 
95 < 1 
96 < 1 def cat(repo, shas):
97 < 1     """{blob sha: bytes} for `shas`, through one `cat-file --batch`."""
98 < 1     shas = list(dict.fromkeys(shas))
99 < 1     if not shas:
100 < 1         return {}
101 < 1     raw = git(repo, "cat-file", "--batch", data=("\n".join(shas) + "\n").encode())
102 < 1     got, i = {}, 0
103 < 1     for sha in shas:
104 < 1         nl = raw.index(b"\n", i)
105 < 1         head = raw[i:nl].split()
106 < 1         if head[-1] == b"missing":
107 < 1             raise RuntimeError("blob %s is missing" % sha)
108 < 1         size = int(head[2])
109 < 1         got[sha] = raw[nl + 1:nl + 1 + size]
110 < 1         i = nl + 1 + size + 1
111 < 1     return got
112 < 1 
113 < 1 
114 < 1 def listing(repo, tree):
115 < 1     """{path: (mode, blob sha)} for every blob under `tree`."""
116 < 1     raw = git(repo, "ls-tree", "-r", "-z", tree)
117 < 1     found = {}
118 < 1     for rec in raw.split(b"\0"):
119 < 1         if not rec:
120 < 1             continue
121 < 1         head, _, path = rec.partition(b"\t")
122 < 1         mode, _kind, sha = head.decode().split()
123 < 1         found[path.decode("utf-8", "surrogateescape")] = (mode, sha)
124 < 1     return found
125 < 1 
126 < 1 
127 < 1 def text_of(data):
128 < 1     """A blob's bytes as text, or None when they are not UTF-8."""
129 < 1     try:
130 < 1         return data.decode("utf-8")
131 < 1     except UnicodeDecodeError:
132 < 1         return None
133 < 1 
134 < 1 
135 < 1 class Memory:
136 < 1     """One tree's weaves: the stored paths' states and sidecars, and the paths never woven."""
137 < 1 
138 < 1     def __init__(self, tree, entry=None, via=None):
139 < 1         self.tree, self.entry, self.via = tree, entry, via
140 < 1         self.states = {}      # path -> Manyana state string
141 < 1         self.auth = {}        # path -> {line key: set(label)}
142 < 1         self.dels = {}        # path -> {line key: set(label)}
143 < 1         self.unwoven = set()
144 < 1         self.dirty = set()    # paths changed since `entry` was read
145 < 1 
146 < 1     def summary(self):
147 < 1         return {"memory": True, "tree": self.tree, "via": self.via, "stored": len(self.states), "unwoven": len(self.unwoven)}
148 < 1 
149 < 1     def to_json(self):
150 < 1         lists = lambda side: {p: {k: sorted(v) for k, v in m.items()} for p, m in side.items()}
151 < 1         return {"tree": self.tree, "entry": self.entry, "via": self.via, "states": self.states, "auth": lists(self.auth),
152 < 1                 "dels": lists(self.dels), "unwoven": sorted(self.unwoven), "dirty": sorted(self.dirty)}
153 < 1 
154 < 1     @classmethod
155 < 1     def from_json(cls, doc):
156 < 1         mem = cls(doc["tree"], doc["entry"], doc["via"])
157 < 1         sets = lambda side: {p: {k: set(v) for k, v in m.items()} for p, m in side.items()}
158 < 1         mem.states, mem.auth, mem.dels = doc["states"], sets(doc["auth"]), sets(doc["dels"])
159 < 1         mem.unwoven, mem.dirty = set(doc["unwoven"]), set(doc["dirty"])
160 < 1         return mem
161 < 1 
162 < 1 
163 < 1 def load(repo, entry):
164 < 1     """The Memory an entry commit holds."""
165 < 1     blobs = listing(repo, tree_of(repo, entry))
166 < 1     data = cat(repo, [sha for _, sha in blobs.values()])
167 < 1     meta = json.loads(data[blobs["meta.json"][1]])
168 < 1     mem = Memory(meta["tree"], entry, meta["via"])
169 < 1     mem.unwoven = set(meta["unwoven"])
170 < 1     for p, (_, sha) in blobs.items():
171 < 1         if not p.startswith("w/"):
172 < 1             continue
173 < 1         path, _, leaf = p[2:].rpartition("/")
174 < 1         if leaf == STATE:
175 < 1             mem.states[path] = data[sha].decode("utf-8")
176 < 1         elif leaf in (AUTH, DELS):
177 < 1             side = {k: set(v) for k, v in json.loads(data[sha]).items()}
178 < 1             (mem.auth if leaf == AUTH else mem.dels)[path] = side
179 < 1     return mem
180 < 1 
181 < 1 
182 < 1 def verify(repo, mem):
183 < 1     """The stored paths whose visible text is not git's text at the Memory's tree."""
184 < 1     at = listing(repo, mem.tree)
185 < 1     data = cat(repo, [at[p][1] for p in mem.states if p in at])
186 < 1     bad = []
187 < 1     for p, state in mem.states.items():
188 < 1         want = []   # absent at this tree: every line deleted
189 < 1         if p in at:
190 < 1             text = text_of(data[at[p][1]]) if at[p][0] in REGULAR else None
191 < 1             if text is None:
192 < 1                 bad.append(p)
193 < 1                 continue
194 < 1             want = text.split("\n")
195 < 1         if M.current_lines(state) != want:
196 < 1             bad.append(p)
197 < 1     return sorted(bad)
198 < 1 
199 < 1 
200 < 1 def replay(repo, mem, parent, commit):
201 < 1     """Carry `mem` from `parent`'s tree to `commit`'s: each changed text file through the keeper's
202 < 1     rewrite, authored `@c:<commit sha12>`. The one recipe by which a tree with no entry gets one."""
203 < 1     raw = git(repo, "diff-tree", "-r", "--no-renames", "--raw", "-z", parent, commit)
204 < 1     parts = raw.split(b"\0")
205 < 1     changes = []
206 < 1     for i in range(0, len(parts) - 1, 2):
207 < 1         old_mode, new_mode, old_sha, new_sha, _status = parts[i].decode().lstrip(":").split()
208 < 1         changes.append((parts[i + 1].decode("utf-8", "surrogateescape"), old_mode, new_mode, old_sha, new_sha))
209 < 1     data = cat(repo, [s for _, om, nm, osha, nsha in changes for m, s in ((om, osha), (nm, nsha)) if m in REGULAR])
210 < 1     label = "@c:" + commit[:12]
211 < 1     keeper = W.Keeper()
212 < 1     keeper.kauth[label], keeper.kdel[label] = mem.auth, mem.dels   # shared: the keeper's writes are the Memory's
213 < 1     work = []
214 < 1     for path, old_mode, new_mode, old_sha, new_sha in changes:
215 < 1         if path in mem.unwoven:
216 < 1             continue
217 < 1         old = text_of(data[old_sha]) if old_mode in REGULAR else None
218 < 1         new = text_of(data[new_sha]) if new_mode in REGULAR else None
219 < 1         if (old_mode != ABSENT and old is None) or (new_mode != ABSENT and new is None):
220 < 1             mem.unwoven.add(path)
221 < 1             for side in (mem.states, mem.auth, mem.dels):
222 < 1                 side.pop(path, None)
223 < 1             mem.dirty.add(path)
224 < 1             continue
225 < 1         if path in mem.states:
226 < 1             keeper.base[path] = mem.states[path]
227 < 1         elif old is not None:
228 < 1             keeper.base[path] = M.initial_state(old.split("\n"))
229 < 1         work.append((path, new))
230 < 1     for path, new in work:
231 < 1         keeper.r_rewrite(label, path, new)
232 < 1         mem.states[path] = keeper.copy(label)[path]
233 < 1         mem.dirty.add(path)
234 < 1     mem.tree = tree_of(repo, commit)
235 < 1 
236 < 1 
237 < 1 def _side_json(side):
238 < 1     return json.dumps({k: sorted(v) for k, v in side.items() if v}, sort_keys=True, separators=(",", ":")).encode()
239 < 1 
240 < 1 
241 < 1 def _blob(repo, data):
242 < 1     return git(repo, "hash-object", "-w", "--stdin", data=data).decode().strip()
243 < 1 
244 < 1 
245 < 1 def write_entry(repo, mem, via):
246 < 1     """Store `mem` as the entry for its tree and return the entry commit. The first entry for a
247 < 1     tree is the only one: when one is already there it is returned and nothing is written."""
248 < 1     have = entries(repo)
249 < 1     if mem.tree in have:
250 < 1         return have[mem.tree]
251 < 1     with tempfile.TemporaryDirectory() as tmp:
252 < 1         env = {"GIT_INDEX_FILE": os.path.join(tmp, "index"), **IDENTITY}
253 < 1         if mem.entry:
254 < 1             git(repo, "read-tree", mem.entry, env=env)
255 < 1         lines = []
256 < 1         null = "0" * 40
257 < 1         for path in sorted(mem.dirty):
258 < 1             leaves = {STATE: None, AUTH: None, DELS: None}
259 < 1             if path in mem.states:
260 < 1                 leaves[STATE] = mem.states[path].encode("utf-8")
261 < 1                 for leaf, side in ((AUTH, mem.auth), (DELS, mem.dels)):
262 < 1                     if any(side.get(path, {}).values()):
263 < 1                         leaves[leaf] = _side_json(side[path])
264 < 1             for leaf, data in leaves.items():
265 < 1                 where = ("w/%s/%s" % (path, leaf)).encode("utf-8", "surrogateescape")
266 < 1                 lines.append((b"0 " + null.encode() if data is None else b"100644 " + _blob(repo, data).encode()) + b"\t" + where)
267 < 1         meta = json.dumps({"v": 1, "tree": mem.tree, "via": via, "unwoven": sorted(mem.unwoven)}, sort_keys=True).encode()
268 < 1         lines.append(b"100644 " + _blob(repo, meta).encode() + b"\tmeta.json")
269 < 1         git(repo, "update-index", "-z", "--index-info", data=b"\0".join(lines) + b"\0", env=env)
270 < 1         tree = out(repo, "write-tree", env=env)
271 < 1     tip = out(repo, "rev-parse", "--verify", "-q", REF, ok=True)
272 < 1     commit = out(repo, "commit-tree", "--no-gpg-sign", tree, *(["-p", tip] if tip else []), "-m", "weave " + mem.tree, env=IDENTITY)
273 < 1     git(repo, "update-ref", REF, commit, *([tip] if tip else []))
274 < 1     mem.entry, mem.via, mem.dirty = commit, via, set()
275 < 1     return commit
276 < 1 
277 < 1 
278 < 1 def resolve(repo, commit):
279 < 1     """The Memory of `commit`'s tree: its entry, or one replayed from the nearest stored
280 < 1     first-parent ancestor and stored. None when no ancestor has an entry (before genesis)."""
281 < 1     have = entries(repo)
282 < 1     if not have:
283 < 1         return None
284 < 1     log = subprocess.Popen(["git", "-C", repo, "log", "--first-parent", "--format=%H %T", commit],
285 < 1                            stdout=subprocess.PIPE, text=True)
286 < 1     path, found = [], None
287 < 1     for line in log.stdout:
288 < 1         sha, tree = line.split()
289 < 1         if tree in have:
290 < 1             found = have[tree]
291 < 1             break
292 < 1         path.append(sha)
293 < 1     log.stdout.close()
294 < 1     log.wait()
295 < 1     if found is None:
296 < 1         return None
297 < 1     mem = load(repo, found)
298 < 1     bad = verify(repo, mem)
299 < 1     if bad:
300 < 1         raise Drift(mem.tree, bad)
301 < 1     if not path:
302 < 1         return mem
303 < 1     chain = path[::-1]   # oldest first
304 < 1     replay(repo, mem, chain[0] + "^", chain[0])
305 < 1     for parent, child in zip(chain, chain[1:]):
306 < 1         replay(repo, mem, parent, child)
307 < 1     bad = verify(repo, mem)
308 < 1     if bad:
309 < 1         raise Drift(mem.tree, bad)
310 < 1     write_entry(repo, mem, "replay")
311 < 1     return mem
312 < 1 
313 < 1 
314 < 1 def genesis(repo, commit):
315 < 1     """Begin the store: an empty entry at `commit`'s tree, where every path's weave is its text."""
316 < 1     mem = Memory(tree_of(repo, commit))
317 < 1     write_entry(repo, mem, "genesis")
318 < 1     return mem
319 < 1 
320 < 1 
321 < 1 def union(into, other):
322 < 1     """Take `other`'s labels into `into`: both are one path's {line key: set(label)}."""
323 < 1     for k, who in other.items():
324 < 1         into.setdefault(k, set()).update(who)
325 < 1 
326 < 1 
327 < 1 def settle(repo, commit, mem, via="run"):
328 < 1     """Store `mem` as the entry of `commit`'s tree: the weaves a run (or a catch-up's join) ended on.
329 < 1     A stored path that is not a regular UTF-8 file there becomes unwoven. Raises Drift, and stores
330 < 1     nothing, when a stored path's visible text is not git's text at that tree."""
331 < 1     mem.tree = tree_of(repo, commit)
332 < 1     at = listing(repo, mem.tree)
333 < 1     data = cat(repo, [at[p][1] for p in mem.states if p in at and at[p][0] in REGULAR])
334 < 1     for p in [p for p in mem.states if p in at and (at[p][0] not in REGULAR or text_of(data[at[p][1]]) is None)]:
335 < 1         mem.unwoven.add(p)
336 < 1         for side in (mem.states, mem.auth, mem.dels):
337 < 1             side.pop(p, None)
338 < 1         mem.dirty.add(p)
339 < 1     bad = verify(repo, mem)
340 < 1     if bad:
341 < 1         raise Drift(mem.tree, bad)
342 < 1     return write_entry(repo, mem, via)
343 < 1 
344 < 1 
345 < 1 def join(repo, run, onto):
346 < 1     """The catch-up's merge. `run` is the run's own commit, whose entry the engine stored; `onto` is
347 < 1     the moved main. Both weaves descend from the entry the run started on, so this is one
348 < 1     `merge_states` per path that differs, with every line's identity kept: no text is diffed.
349 < 1     Returns ({"joined": True, "conflicts", "files", "paths"}, Memory) or ({"joined": False, "reason"}, None)."""
350 < 1     have = entries(repo)
351 < 1     if tree_of(repo, run) not in have:
352 < 1         return {"joined": False, "reason": "no-run-entry"}, None
353 < 1     mem = resolve(repo, onto)
354 < 1     if mem is None:
355 < 1         return {"joined": False, "reason": "before-genesis"}, None
356 < 1     ours = load(repo, have[tree_of(repo, run)])
357 < 1     at = listing(repo, mem.tree)
358 < 1     lazy = [p for p in ours.states if p not in mem.states and p in at and at[p][0] in REGULAR]
359 < 1     data = cat(repo, [at[p][1] for p in lazy])
360 < 1     conflicts, files, decided = [], {}, []
361 < 1     for p in sorted(ours.states):
362 < 1         if p in mem.unwoven or p in ours.unwoven:
363 < 1             continue
364 < 1         theirs = mem.states.get(p)
365 < 1         if theirs is None and p in at:
366 < 1             text = text_of(data[at[p][1]]) if at[p][0] in REGULAR else None
367 < 1             if text is None:
368 < 1                 continue                      # not text on main: the catch-up's own byte rule decides it
369 < 1             theirs = M.initial_state(text.split("\n"))
370 < 1         mine = ours.states[p]
371 < 1         decided.append(p)
372 < 1         if theirs is None:
373 < 1             new = mine                        # the run made this path
374 < 1         elif theirs == mine:
375 < 1             continue
376 < 1         else:
377 < 1             new, marked = M.merge_states(theirs, mine)
378 < 1             if marked != M.current_lines(new):
379 < 1                 conflicts.append(p)
380 < 1         union(mem.auth.setdefault(p, {}), ours.auth.get(p, {}))
381 < 1         union(mem.dels.setdefault(p, {}), ours.dels.get(p, {}))
382 < 1         if new != mem.states.get(p):
383 < 1             mem.states[p] = new
384 < 1             mem.dirty.add(p)
385 < 1         before = M.current_lines(theirs) if theirs is not None else []
386 < 1         after = M.current_lines(new)
387 < 1         if after != before:
388 < 1             files[p] = "\n".join(after) if after else None
389 < 1     mem.unwoven |= ours.unwoven
390 < 1     return {"joined": True, "conflicts": conflicts, "files": files, "paths": decided}, mem
391 < 1 
392 < 1 
393 < 1 def sync(repo, remote="origin"):
394 < 1     """Take in the remote's entries. Local entries whose trees the remote lacks are kept, re-parented
395 < 1     onto the remote's tip; one whose tree the remote holds is dropped, and named in `forks` when the
396 < 1     two differ. A local genesis is dropped once the remote has any entry: a store has one beginning."""
397 < 1     fetched = git(repo, "fetch", "-q", remote, "+%s:%s" % (REF, REMOTE_REF), ok=True)
398 < 1     theirs = entries(repo, REMOTE_REF) if fetched is not None else {}
399 < 1     tip = out(repo, "rev-parse", "--verify", "-q", REMOTE_REF, ok=True) if theirs else None
400 < 1     if not tip:
401 < 1         return {"forks": [], "kept": len(entries(repo))}
402 < 1     mine = out(repo, "rev-list", "--reverse", REF, "--not", REMOTE_REF, ok=True)
403 < 1     forks, kept = [], 0
404 < 1     for sha in (mine or "").split():
405 < 1         subject = out(repo, "log", "-1", "--format=%s", sha)
406 < 1         tree = subject[len("weave "):]
407 < 1         if tree in theirs:
408 < 1             if tree_of(repo, sha) != tree_of(repo, theirs[tree]):
409 < 1                 forks.append(tree)
410 < 1             continue
411 < 1         if json.loads(git(repo, "show", sha + ":meta.json"))["via"] == "genesis":
412 < 1             continue
413 < 1         tip = out(repo, "commit-tree", "--no-gpg-sign", tree_of(repo, sha), "-p", tip, "-m", subject, env=IDENTITY)
414 < 1         kept += 1
415 < 1     git(repo, "update-ref", REF, tip)
416 < 1     return {"forks": forks, "kept": kept}
417 < 1 
418 < 1 
419 < 1 def push(repo, remote="origin", tries=5):
420 < 1     """Sync, then push the local entries without force; a refused push syncs and tries again."""
421 < 1     forks = []
422 < 1     for _ in range(tries):
423 < 1         forks += sync(repo, remote)["forks"]
424 < 1         if forks:
425 < 1             # this clone built a tree's weave the remote holds differently, so what it wove on top
426 < 1             # of its own is not main's memory: keep the remote's and push nothing
427 < 1             return {"pushed": False, "forks": forks}
428 < 1         tip = out(repo, "rev-parse", "--verify", "-q", REF, ok=True)
429 < 1         if not tip:
430 < 1             return {"pushed": False, "forks": forks}
431 < 1         if tip == out(repo, "rev-parse", "--verify", "-q", REMOTE_REF, ok=True):
432 < 1             return {"pushed": True, "forks": forks}
433 < 1         # the lease is the remote tip this clone last saw (none: the ref must not exist yet), so the
434 < 1         # push lands only on the entries it was built on
435 < 1         lease = "--force-with-lease=%s:%s" % (REF, out(repo, "rev-parse", "--verify", "-q", REMOTE_REF, ok=True) or "")
436 < 1         if git(repo, "push", "-q", lease, remote, "%s:%s" % (REF, REF), ok=True) is not None:
437 < 1             git(repo, "update-ref", REMOTE_REF, tip)
438 < 1             return {"pushed": True, "forks": forks}
439 < 1     return {"pushed": False, "forks": forks}
440 < 1 
441 < 1 
442 < 1 def open_store(repo, commit, remote=None):
443 < 1     """The Memory a run starts from at `commit`, or None when the commit is older than the store.
444 < 1     With no store anywhere, begins one at `commit`; with a remote, a store begun here is pushed
445 < 1     before it is used, so two sandboxes beginning at once end on one beginning."""
446 < 1     if remote:
447 < 1         sync(repo, remote)
448 < 1     mem = resolve(repo, commit)
449 < 1     if mem is None and not entries(repo):
450 < 1         genesis(repo, commit)
451 < 1         if remote:
452 < 1             push(repo, remote)
453 < 1         mem = resolve(repo, commit)
454 < 1     return mem
455 < 1 
456 < 1 
457 < 1 def main(argv):
458 < 1     def arg(name, default=None):
459 < 1         return argv[argv.index(name) + 1] if name in argv else default
460 < 1     verb, repo, remote = (argv[0] if argv else None), arg("--repo"), arg("--remote")
461 < 1     if verb == "open" and repo and arg("--commit"):
462 < 1         try:
463 < 1             mem = open_store(repo, out(repo, "rev-parse", arg("--commit")), remote)
464 < 1         except Drift as e:
465 < 1             print(json.dumps({"memory": False, "reason": "drift", "paths": e.paths}))
466 < 1             return 1
467 < 1         print(json.dumps(mem.summary() if mem else {"memory": False, "reason": "before-genesis"}))
468 < 1         return 0
469 < 1     if verb == "join" and repo and arg("--run") and arg("--onto") and arg("--out"):
470 < 1         if remote:
471 < 1             sync(repo, remote)
472 < 1         try:
473 < 1             res, mem = join(repo, out(repo, "rev-parse", arg("--run")), out(repo, "rev-parse", arg("--onto")))
474 < 1         except Drift as e:
475 < 1             res, mem = {"joined": False, "reason": "drift", "paths": e.paths}, None
476 < 1         if mem is not None:
477 < 1             with open(arg("--out"), "w", encoding="utf-8") as f:
478 < 1                 json.dump(mem.to_json(), f)
479 < 1         print(json.dumps(res))
480 < 1         return 0 if res["joined"] else 1
481 < 1     if verb == "settle" and repo and arg("--commit") and arg("--from"):
482 < 1         with open(arg("--from"), encoding="utf-8") as f:
483 < 1             mem = Memory.from_json(json.load(f))
484 < 1         try:
485 < 1             print(json.dumps({"stored": True, "entry": settle(repo, out(repo, "rev-parse", arg("--commit")), mem)}))
486 < 1             return 0
487 < 1         except Drift as e:
488 < 1             print(json.dumps({"stored": False, "reason": "drift", "paths": e.paths}))
489 < 1             return 1
490 < 1     if verb == "push" and repo:
491 < 1         res = push(repo, remote or "origin")
492 < 1         print(json.dumps(res))
493 < 1         return 0 if res["pushed"] else 1
494 < 1     print("usage: weave_store.py open --repo <dir> --commit <sha> [--remote <name>] | push --repo <dir> [--remote <name>]"
495 < 1           " | join --repo <dir> --run <sha> --onto <sha> --out <file> [--remote <name>] | settle --repo <dir> --commit <sha> --from <file>", file=sys.stderr)
496 < 1     return 2
497 < 1 
498 < 1 
499 < 1 if __name__ == "__main__":
500 < 1     sys.exit(W.run_on_kernel_thread(main, sys.argv[1:]))
501 < 1 