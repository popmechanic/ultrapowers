0 < 1 // What a builder is told of when it pulls its peers' published changes (#1292). Every published
2 > 1 // change reaches its copy whatever the scope (engine.mjs pullInto): a copy is a whole tree, and its facts
1 < 2 // change reaches its copy either way (engine.mjs pullInto): a copy is a whole tree, and its facts
2 < 1 // run on all of it (flock-baseline run-10, 2026-11-13: a scope that also held changes back left a
3 < 1 // builder without a file its task needed, and the run ended a draft).
5 > 1 // The scope (settled 2026-11-14 over 72 narrow runs; `all`, told of every change, was cut): the
6 < 1 // task's own files, the files of every task it depends on, and the paths this builder has touched
7 < 1 // (read or edited) in its copy. A change outside the scope lands silently and is told once its path
8 < 1 // comes into scope. `created`: files peers created that were absent at base; they cannot conflict
9 < 1 // with anything in a copy, so the scope always holds them (#1405).
10 < 1 export function pullScope ({ task, tasks, touched, created = [] }) {
4 < 2 // mode `all` (the rollback): null, meaning it is told of every change.
5 < 2 // mode `narrow`: the task's own files, the files of every task it depends on, and the paths this
6 < 2 // builder has touched (read or edited) in its copy. A change outside the scope lands silently and
7 < 2 // is told once its path comes into scope. `created`: files peers created that were absent at base;
8 < 2 // they cannot conflict with anything in a copy, so a narrow scope always holds them (#1405).
9 < 2 export function pullScope ({ task, tasks, touched, mode, created = [] }) {
10 < 2   if (mode !== 'narrow') return null
11 < 1   const scope = new Set(task.files || [])
12 < 1   const deps = new Set((task.depends_on || []).map(String))
13 < 1   for (const t of tasks || []) if (deps.has(String(t.id))) for (const f of t.files || []) scope.add(f)
14 < 1   for (const p of touched || []) scope.add(p)
15 < 1   for (const p of created || []) scope.add(p)
16 < 1   return scope
17 < 1 }
