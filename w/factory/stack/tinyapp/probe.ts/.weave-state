0 < 2 // The state-probe core: one probe read out of a stories-v1 plan, the closed
1 < 2 // checks decided on TinyBase [tables, values] content, and row ids matched by
2 < 2 // creation order. The one definition of probe semantics: compile.ts derives
3 < 2 // probes with checksFor, and the checker decides them with holds.
4 < 1 export type Row = Record<string, unknown>;
5 < 1 export type Content = [Record<string, Record<string, Row>>, Record<string, unknown>];
6 < 1 export type Check = Record<string, unknown>;
7 < 1 export type Locator = {role: string; name: string};
9 > 2 export type UiStep = {click: Locator} | {type: Locator & {text: string}} | {key: Locator & {key: string}}
10 < 2   | {select: Locator & {option: string}};
9 > 1 export type UiStep = {click: Locator} | {type: Locator & {text: string}} | {key: Locator & {key: string}} | {select: Locator & {option: string}};
8 < 2 export type UiStep = {click: Locator} | {type: Locator & {text: string}} | {key: Locator & {key: string}};
9 < 2 // `as` is who is signed in (an email, or null for nobody) from this call on;
10 < 2 // absent, the page's own sign-in stands.
11 < 1 export type ToolCall = {tool: string; args: Record<string, unknown>; as?: string | null};
12 < 1 export type See = {role: string; name: string; count?: number};
13 < 1 export type Probe = {
14 < 1   clause: string;
15 < 1   layer: string;
16 < 1   as?: string | null;
17 < 1   given: ToolCall[];
18 < 1   do: (ToolCall | UiStep)[];
19 < 1   expect: Check[];
20 < 1   see?: See[];
21 < 1   judge?: string | null;
22 < 1   holds_before?: boolean;
23 < 1 };
24 < 1 
25 < 1 const FENCE = /^```probe[ \t]*\n([\s\S]*?)\n```/gm;
26 < 1 
27 < 1 export function probeFromPlan(text: string, clause: string): Probe {
28 < 1   for (const m of text.matchAll(FENCE)) {
29 < 1     const p = JSON.parse(m[1]) as Probe;
30 < 1     if (p.clause === clause) return p;
31 < 1   }
32 < 1   throw new Error(`no probe for clause ${clause} in the plan`);
33 < 1 }
34 < 1 
36 > 1 function sameValue(a: unknown, b: unknown): boolean {
35 < 2 export function sameValue(a: unknown, b: unknown): boolean {
36 < 1   if (Array.isArray(a) || Array.isArray(b)) {
37 < 1     return Array.isArray(a) && Array.isArray(b) && a.length === b.length
38 < 1       && a.every((x, i) => sameValue(x, b[i]));
39 < 1   }
40 < 1   if (a !== null && b !== null && typeof a === 'object' && typeof b === 'object') {
41 < 1     const ka = Object.keys(a).sort();
42 < 1     const kb = Object.keys(b).sort();
43 < 1     return sameValue(ka, kb) && ka.every((k) => sameValue((a as Row)[k], (b as Row)[k]));
44 < 1   }
45 < 1   return typeof a === typeof b && a === b;
46 < 1 }
47 < 1 
48 < 1 export function holds(c: Check, content: Content, before?: Content): boolean {
49 < 1   const [tables, values] = content;
50 < 1   if ('unchanged' in c) return before !== undefined && sameValue(content, before);
51 < 1   if ('value' in c) {
52 < 1     const k = c.value as string;
53 < 1     return 'absent' in c ? !(k in values) : k in values && sameValue(values[k], c.eq);
54 < 1   }
55 < 1   const row = tables[c.table as string]?.[c.row as string];
56 < 1   if (!('cell' in c)) return row === undefined;
57 < 1   if (row === undefined || !((c.cell as string) in row)) return 'absent' in c;
58 < 1   if ('absent' in c) return false;
59 < 1   return sameValue(row[c.cell as string], c.eq);
60 < 1 }
61 < 1 
62 < 1 export function hollow(p: Probe, before: Content): boolean {
63 < 1   if (p.holds_before) return false;
64 < 1   return p.expect.every((c) => holds(c, before, before));
65 < 1 }
66 < 1 
67 < 1 const keysOf = (a: object, b: object) => [...new Set([...Object.keys(a), ...Object.keys(b)])].sort();
68 < 1 
69 < 2 // The closed checks that say exactly how `after` differs from `before`: only
70 < 2 // rows and cells that changed, so a cell another piece adds later never
71 < 2 // breaks them. No difference at all is [{unchanged: true}].
72 < 1 export function checksFor(before: Content, after: Content): Check[] {
73 < 1   const [bt, bv] = before;
74 < 1   const [at, av] = after;
75 < 1   const out: Check[] = [];
76 < 1   for (const t of keysOf(bt, at)) {
77 < 1     const brows = bt[t] ?? {};
78 < 1     const arows = at[t] ?? {};
79 < 1     for (const r of keysOf(brows, arows)) {
80 < 1       if (r in brows && !(r in arows)) {
81 < 1         out.push({table: t, row: r, absent: true});
82 < 1         continue;
83 < 1       }
84 < 1       const bc = brows[r] ?? {};
85 < 1       const ac = arows[r] ?? {};
86 < 1       for (const c of keysOf(bc, ac)) {
87 < 1         if (!(c in ac)) out.push({table: t, row: r, cell: c, absent: true});
88 < 1         else if (!(c in bc) || !sameValue(ac[c], bc[c])) out.push({table: t, row: r, cell: c, eq: ac[c]});
89 < 1       }
90 < 1     }
91 < 1   }
92 < 1   for (const k of keysOf(bv, av)) {
93 < 1     if (!(k in av)) out.push({value: k, absent: true});
94 < 1     else if (!(k in bv) || !sameValue(av[k], bv[k])) out.push({value: k, eq: av[k]});
95 < 1   }
96 < 1   return out.length ? out : [{unchanged: true}];
97 < 1 }
98 < 1 
99 < 1 const show = (v: unknown) => JSON.stringify(v);
100 < 1 
101 < 1 function describe(c: Check, content: Content): string {
102 < 1   const [tables, values] = content;
103 < 1   if ('unchanged' in c) return 'nothing should have changed, but the store did';
104 < 1   if ('value' in c) {
105 < 1     const k = c.value as string;
106 < 1     return 'absent' in c ? `value ${k} should be absent, is ${show(values[k])}`
107 < 1       : `value ${k} should be ${show(c.eq)}, is ${k in values ? show(values[k]) : 'missing'}`;
108 < 1   }
109 < 1   const where = `${c.table} row ${c.row}`;
110 < 1   const row = tables[c.table as string]?.[c.row as string];
111 < 1   if (!('cell' in c)) return `${where} should be gone, but it is still there`;
112 < 1   if ('absent' in c) return `${where}: ${c.cell} should be unset, is ${show(row?.[c.cell as string])}`;
113 < 1   if (row === undefined) return `${where}: ${c.cell} should be ${show(c.eq)}, but the row is missing`;
114 < 1   return `${where}: ${c.cell} should be ${show(c.eq)}, is ${(c.cell as string) in row ? show(row[c.cell as string]) : 'unset'}`;
115 < 1 }
116 < 1 
117 < 1 export function failing(p: Probe, content: Content, before?: Content): string[] {
118 < 1   return p.expect.filter((c) => !holds(c, content, before)).map((c) => describe(c, content));
119 < 1 }
120 < 1 
121 < 1 const AMBIGUOUS = '\u0000';
122 < 1 
123 < 1 export class Aliases {
124 < 1   private order = new Map<string, string[]>();
125 < 1 
126 < 1   learn([tables]: Content): void {
127 < 1     for (const [t, rows] of Object.entries(tables)) {
128 < 1       const known = this.order.get(t) ?? [];
129 < 1       const fresh = Object.keys(rows).filter((id) => !known.includes(id));
130 < 1       this.order.set(t, [...known, ...fresh]);
131 < 1     }
132 < 1   }
133 < 1 
134 < 1   private real(table: string, alias: string): string | undefined {
135 < 1     const i = Number(alias);
136 < 1     return Number.isInteger(i) && i >= 0 ? this.order.get(table)?.[i] : undefined;
137 < 1   }
138 < 1 
139 < 1   rename([tables, values]: Content): Content {
140 < 1     const aliasOf = new Map<string, string>();
141 < 1     for (const ids of this.order.values()) {
142 < 1       ids.forEach((id, i) => aliasOf.set(id, aliasOf.has(id) ? AMBIGUOUS : String(i)));
143 < 1     }
144 < 1     const cell = (v: unknown) => {
145 < 1       const a = typeof v === 'string' ? aliasOf.get(v) : undefined;
146 < 1       return a !== undefined && a !== AMBIGUOUS ? a : v;
147 < 1     };
148 < 1     const out: Content[0] = {};
149 < 1     for (const [t, rows] of Object.entries(tables)) {
150 < 1       const order = this.order.get(t) ?? [];
151 < 1       out[t] = Object.fromEntries(Object.entries(rows).map(([id, row]) => {
152 < 1         const i = order.indexOf(id);
153 < 1         const renamed = Object.fromEntries(Object.entries(row).map(([k, v]) => [k, cell(v)]));
154 < 1         return [i < 0 ? '?' + id : String(i), renamed];
155 < 1       }));
156 < 1     }
157 < 1     return [out, values];
158 < 1   }
159 < 1 
160 < 1   args(args: Record<string, unknown>, schema: unknown): Record<string, unknown> {
161 < 1     const props = ((schema as {properties?: Record<string, Record<string, unknown>>})?.properties) ?? {};
162 < 1     return Object.fromEntries(Object.entries(args).map(([k, v]) => {
163 < 1       const table = props[k]?.['x-row-of'];
164 < 1       const real = typeof table === 'string' && typeof v === 'string' ? this.real(table, v) : undefined;
165 < 1       return [k, real ?? v];
166 < 1     }));
167 < 1   }
168 < 1 }
169 < 1 