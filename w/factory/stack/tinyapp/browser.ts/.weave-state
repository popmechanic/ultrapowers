453 < 1         let found = await optionFor(option, SELECT_OPEN_MS);
454 < 1         if (found === undefined) {
455 < 1           // The keyboard path, for a picker the mouse did not open.
456 < 1           await connection.send('DOM.focus', {...combobox}, sessionId).catch(() => undefined);
457 < 1           for (const type of ['keyDown', 'keyUp'] as const) {
458 < 1             await connection.send(
459 < 1               'Input.dispatchKeyEvent',
460 < 1               {type, key: 'ArrowDown', code: 'ArrowDown', windowsVirtualKeyCode: 40},
461 < 1               sessionId,
462 < 1             );
463 < 1           }
464 < 1           found = await optionFor(option, SELECT_OPEN_MS);
441 < 2         const node = await nodeFor(connection, sessionId, action.click);
442 < 2         // A box below the fold is off the viewport, and a mouse event aimed at
443 < 2         // it lands on nothing — so the element is scrolled into view first.
444 < 2         await connection
445 < 2           .send('DOM.scrollIntoViewIfNeeded', {...node}, sessionId)
446 < 2           .catch(() => undefined);
447 < 2         const centre = await centreOf(connection, sessionId, node);
448 < 2         if (centre === null) {
449 < 2           await clickInPage(connection, sessionId, node);
450 < 2           return;
451 < 1         }
453 > 1         if (found === undefined) {
454 < 1           throw new Error(
455 < 1             `act: no option ${JSON.stringify(option)} in combobox ${JSON.stringify(locator.name)}`,
452 < 2         const {x, y} = centre;
453 < 2         for (const type of ['mousePressed', 'mouseReleased'] as const) {
454 < 2           await connection.send(
455 < 2             'Input.dispatchMouseEvent',
456 < 2             {type, x, y, button: 'left', clickCount: 1},
457 < 2             sessionId,
458 < 1           );
459 < 1         }
461 > 1         await clickNode(found);
460 < 1         return;
461 < 1       }
462 < 1 
463 < 1       const [locator, argument] = 'type' in action ? action.type : action.key;
464 < 1       const node = await nodeFor(connection, sessionId, locator);
465 < 1       await connection.send('DOM.focus', {...node}, sessionId);
466 < 1 
467 < 1       if ('type' in action) {
468 < 1         await connection.send('Input.insertText', {text: argument}, sessionId);
469 < 1         return;
470 < 1       }
471 < 1 
472 < 1       // `Enter` carries `\r` as its text, which is what a page's keypress
473 < 1       // handlers and a form's implicit submission read.
474 < 1       const isEnter = argument === 'Enter';
475 < 1       for (const type of ['keyDown', 'keyUp'] as const) {
476 < 1         await connection.send(
477 < 1           'Input.dispatchKeyEvent',
478 < 1           {
479 < 1             type,
480 < 1             key: argument,
481 < 1             code: argument,
482 < 1             ...(isEnter ? {text: '\r', windowsVirtualKeyCode: 13} : {}),
483 < 1           },
484 < 1           sessionId,
485 < 1         );
486 < 1       }
487 < 1     },
488 < 1 
489 < 1     close: async (): Promise<void> => {
490 < 1       if (!open) {
491 < 1         return;
492 < 1       }
493 < 1       open = false;
494 < 1       await connection.send('Target.detachFromTarget', {sessionId}).catch(() => {});
495 < 1       await connection.send('Target.closeTarget', {targetId}).catch(() => {});
496 < 1     },
497 < 1   };
498 < 1 };
499 < 1 
500 < 1 /**
501 < 1  * Spawns a browser and resolves once its DevTools endpoint is answering.
502 < 1  *
503 < 1  * `binary` defaults to `env.TINYAPP_BROWSER` and then to the image's
504 < 1  * `/headless-shell/headless-shell`; `env` defaults to the process's own. A
505 < 1  * binary that is not there rejects with `browser: no such binary <path>` before
506 < 1  * anything is spawned, so nothing is left running behind the rejection.
507 < 1  *
508 < 1  * The default sandbox mode launches on the fleet image, so no `--no-sandbox` is
509 < 1  * passed. A machine that needs it — a laptop, a container without user
510 < 1  * namespaces — opts in through `env.TINYAPP_BROWSER_ARGS`, space-separated
511 < 1  * flags appended to the argv.
512 < 1  */
513 < 1 export const launchBrowser = async (opts?: {
514 < 1   binary?: string;
515 < 1   env?: Record<string, string | undefined>;
516 < 1 }): Promise<Browser> => {
517 < 1   const env = opts?.env ?? (process.env as Record<string, string | undefined>);
518 < 1   const binary = resolveBinary(opts?.binary, env);
519 < 1 
520 < 1   if (!existsSync(binary)) {
521 < 1     throw new Error(`browser: no such binary ${binary}`);
522 < 1   }
523 < 1 
524 < 1   const userDataDir = mkdtempSync(join(tmpdir(), 'tinyapp-browser-'));
525 < 1   const extra = (env.TINYAPP_BROWSER_ARGS ?? '').split(/\s+/).filter((flag) => flag !== '');
526 < 1   const argv = [
527 < 1     binary,
528 < 1     '--headless',
529 < 1     '--remote-debugging-port=0',
530 < 1     `--user-data-dir=${userDataDir}`,
531 < 1     '--disable-gpu',
532 < 1     '--hide-scrollbars',
533 < 1     ...extra,
534 < 1   ];
535 < 1 
536 < 1   const child = Bun.spawn(argv, {stdout: 'ignore', stderr: 'pipe'});
537 < 1 
538 < 1   const sweep = async (): Promise<void> => {
539 < 1     child.kill();
540 < 1     await child.exited.catch(() => undefined);
541 < 1     rmSync(userDataDir, {recursive: true, force: true});
542 < 1   };
543 < 1 
544 < 1   let connection: Connection;
545 < 1   try {
546 < 1     connection = await connect(await devtoolsUrl(child.stderr));
547 < 1   } catch (error) {
548 < 1     await sweep();
549 < 1     throw error;
550 < 1   }
551 < 1 
552 < 1   return {
553 < 1     argv,
554 < 1 
555 < 1     openUrl: async ({url, origin, clock, prelude, allow}): Promise<Page> => {
556 < 1       const source = [clockPin(clock), prelude ?? '']
557 < 1         .filter((part) => part !== '')
558 < 1         .join(';\n');
559 < 1 
560 < 1       const created = (await connection.send('Target.createTarget', {
561 < 1         url: 'about:blank',
562 < 1       })) as {targetId?: string};
563 < 1       const targetId = created.targetId ?? '';
564 < 1       const attached = (await connection.send('Target.attachToTarget', {
565 < 1         targetId,
566 < 1         flatten: true,
567 < 1       })) as {sessionId?: string};
568 < 1       const sessionId = attached.sessionId ?? '';
569 < 1 
570 < 1       // A page served from an origin cannot have its every request blocked the
571 < 1       // way a `data:` page can — its own document is a request. So each one is
572 < 1       // paused and judged instead: continued when it is to `origin` or to one
573 < 1       // of `allow`'s origins, and failed in the browser otherwise, before a byte
574 < 1       // of it leaves the machine.
575 < 1       await connection.send('Fetch.enable', {patterns: [{urlPattern: '*'}]}, sessionId);
576 < 1       const allowed = [origin, ...(allow ?? [])].map((each) => `${each}/`);
577 < 1       connection.on('Fetch.requestPaused', sessionId, (params) => {
578 < 1         const {requestId, request} = params as {
579 < 1           requestId?: string;
580 < 1           request?: {url?: string};
581 < 1         };
582 < 1         const target = request?.url ?? '';
583 < 1         const pass = allowed.some((prefix) => target.startsWith(prefix));
584 < 1         void connection
585 < 1           .send(
586 < 1             pass ? 'Fetch.continueRequest' : 'Fetch.failRequest',
587 < 1             pass
588 < 1               ? {requestId}
589 < 1               : {requestId, errorReason: 'BlockedByClient'},
590 < 1             sessionId,
591 < 1           )
592 < 1           .catch(() => {});
593 < 1       });
594 < 1 
595 < 1       await connection.send('Page.enable', {}, sessionId);
596 < 1       await connection.send(
597 < 1         'Page.addScriptToEvaluateOnNewDocument',
598 < 1         {source},
599 < 1         sessionId,
600 < 1       );
601 < 1       await connection.send('Page.navigate', {url}, sessionId);
602 < 1 
603 < 1       return pageOn(connection, sessionId, targetId);
604 < 1     },
605 < 1 
606 < 1     close: async (): Promise<void> => {
607 < 1       // Asked politely first, so the shell takes its own children down with it.
608 < 1       await connection.send('Browser.close').catch(() => {});
609 < 1       await Promise.race([child.exited.catch(() => undefined), after(EXIT_GRACE_MS)]);
610 < 1       connection.close();
611 < 1       await sweep();
612 < 1     },
613 < 1   };
614 < 1 };
615 < 1 