392 < 1 /** Builds the `Page` facade over one attached target. */
393 < 1 const pageOn = (
394 < 1   connection: Connection,
395 < 1   sessionId: string,
396 < 1   targetId: string,
397 < 1 ): Page => {
398 < 1   let open = true;
399 < 1   const live = (): void => {
400 < 1     if (!open) {
401 < 1       throw new Error('page: closed');
402 < 1     }
403 < 1   };
404 < 1 
405 < 1   const evaluate = async (expression: string): Promise<unknown> => {
406 < 1     live();
407 < 1     const answer = (await connection.send(
408 < 1       'Runtime.evaluate',
409 < 1       {expression, returnByValue: true, awaitPromise: true},
410 < 1       sessionId,
411 < 1     )) as {
412 < 1       result?: {value?: unknown};
413 < 1       exceptionDetails?: {exception?: {description?: string}; text?: string};
414 < 1     };
415 < 1     if (answer.exceptionDetails !== undefined) {
416 < 1       const detail = answer.exceptionDetails;
417 < 1       throw new Error(
418 < 1         `evaluate: ${detail.exception?.description ?? detail.text ?? 'threw'}`,
419 < 1       );
420 < 1     }
421 < 1     return answer.result?.value;
422 < 1   };
423 < 1 
425 > 1   /** A mouse press and release at the node's centre, or `click()` when it has no box. */
426 < 1   const clickNode = async (node: NodeRef): Promise<void> => {
427 < 1     // A box below the fold is off the viewport, and a mouse event aimed at
428 < 1     // it lands on nothing — so the element is scrolled into view first.
429 < 1     await connection
430 < 1       .send('DOM.scrollIntoViewIfNeeded', {...node}, sessionId)
431 < 1       .catch(() => undefined);
432 < 1     const centre = await centreOf(connection, sessionId, node);
433 < 1     if (centre === null) {
434 < 1       await clickInPage(connection, sessionId, node);
435 < 1       return;
436 < 1     }
437 < 1     const {x, y} = centre;
438 < 1     for (const type of ['mousePressed', 'mouseReleased'] as const) {
439 < 1       await connection.send(
440 < 1         'Input.dispatchMouseEvent',
441 < 1         {type, x, y, button: 'left', clickCount: 1},
442 < 1         sessionId,
443 < 1       );
444 < 1     }
445 < 1   };
446 < 1 
447 < 1   /**
448 < 1    * The first shown element of role `option` named `name`, waiting up to `ms`
449 < 1    * for it. Ignored nodes are passed over: a picker may keep a hidden native
450 < 1    * `<select>` whose options carry the same names.
451 < 1    */
452 < 1   const optionFor = async (name: string, ms: number): Promise<NodeRef | undefined> => {
453 < 1     const end = Date.now() + ms;
454 < 1     for (;;) {
455 < 1       await connection.send('Accessibility.enable', {}, sessionId);
456 < 1       const found = (await connection.send('Accessibility.queryAXTree', {
457 < 1         nodeId: await rootOf(connection, sessionId),
458 < 1         role: 'option',
459 < 1         accessibleName: name,
460 < 1       }, sessionId)) as {nodes?: {backendDOMNodeId?: number; ignored?: boolean}[]};
461 < 1       const backendNodeId = (found.nodes ?? []).find(
462 < 1         (n) => !n.ignored && (n.backendDOMNodeId ?? 0) !== 0)?.backendDOMNodeId;
463 < 1       if (backendNodeId !== undefined) return {backendNodeId};
464 < 1       if (Date.now() > end) return undefined;
465 < 1       await after(50);
466 < 1     }
467 < 1   };
468 < 1 
424 < 1   return {
425 < 1     evaluate,
426 < 1 
427 < 1     count: async (locator) => {
428 < 1       await connection.send('Accessibility.enable', {}, sessionId);
429 < 1       const found = (await connection.send('Accessibility.queryAXTree', {
430 < 1         nodeId: await rootOf(connection, sessionId),
431 < 1         role: locator.role,
432 < 1         accessibleName: locator.name,
433 < 1       }, sessionId)) as {nodes?: {backendDOMNodeId?: number; ignored?: boolean}[]};
434 < 1       return (found.nodes ?? []).filter(
435 < 1         (n) => !n.ignored && (n.backendDOMNodeId ?? 0) !== 0).length;
436 < 1     },
437 < 1 
438 < 1     act: async (action: Action): Promise<void> => {
439 < 1       live();
440 < 1       if ('click' in action) {
442 > 1         await clickNode(await nodeFor(connection, sessionId, action.click));
443 < 1         return;
444 < 1       }
445 < 1 
446 < 1       if ('select' in action) {
447 < 1         // A Radix Select opens on a mouse pointerdown and picks on a pointerup;
448 < 1         // its listbox is rendered in a portal a frame or more after the press,
449 < 1         // so the option is looked for until it shows up.
450 < 1         const [locator, option] = action.select;
