47 < 2       "questions": {
48 < 2         "kept": {
49 < 2           "type": "choice",
50 < 2           "instructions": {
51 < 2             "question": "Does `after` still carry the change the peer made when it turned `before` into `peer`?",
52 < 2             "context": "`path` is the file. `before` is what the peer's lines replaced (empty when the peer only added them), and `peer` is what the peer wrote. `after` is what a second agent then wrote over the peer's lines (empty when it deleted them). `tasks` are the two sides, the second agent's first, each with its `title` and its `claim`, what that side meant. The loose-ends side has no claim: it was asked to fix the problem in its `asked_to_fix`, when one was reported for this file, and anything else it changed in `after` was not asked for."
53 < 2           },
54 < 2           "criteria": {
55 < 2             "keeps": "What the peer changed is still there in `after`, beside the second agent's own change",
56 < 2             "loses": "Part of the peer's change is undone, or `after` runs together words or lines that `before` and `peer` kept apart",
57 < 2             "supersedes": "The second agent's claim means to replace the peer's change, and `after` does exactly that"
58 < 2           }
59 < 2         }
60 < 2       }
