0 < 1 import { createStore } from 'tinybase'
1 < 1 
2 < 2 // The todo piece's store module. Every action is a WebMCP-shaped tool:
3 < 2 // a name, the piece it belongs to, a plain description, a typed input
4 < 2 // schema, and run(store, args) -> true when it changed the store.
5 < 2 // No schema defaults: a todo that was never ticked has no `completed` cell.
6 < 1 export const TOOLS = [
7 < 1   {
8 < 1     name: 'addTodo',
9 < 1     piece: 'todo',
10 < 1     description: 'Add a todo with this text; it starts not done.',
11 < 1     inputSchema: { type: 'object', properties: { text: { type: 'string' } }, required: ['text'] },
12 < 1     run: (store, { text }) => {
13 < 1       const clean = String(text ?? '').trim()
14 < 1       if (clean === '') return false
15 < 1       store.addRow('todos', { text: clean })
16 < 1       return true
17 < 1     }
18 < 1   },
19 < 1   {
20 < 1     name: 'completeTodo',
21 < 1     piece: 'todo',
22 < 1     description: 'Mark this todo as done.',
23 < 1     inputSchema: { type: 'object', properties: { id: { type: 'string', 'x-row-of': 'todos' } }, required: ['id'] },
24 < 1     run: (store, { id }) => {
25 < 1       if (!store.hasRow('todos', id)) return false
26 < 1       store.setCell('todos', id, 'completed', true)
27 < 1       return true
28 < 1     }
29 < 1   },
30 < 1   {
31 < 1     name: 'deleteTodo',
32 < 1     piece: 'todo',
33 < 1     description: 'Remove this todo from the list.',
34 < 1     inputSchema: { type: 'object', properties: { id: { type: 'string', 'x-row-of': 'todos' } }, required: ['id'] },
35 < 1     run: (store, { id }) => {
36 < 1       if (!store.hasRow('todos', id)) return false
37 < 1       store.delRow('todos', id)
38 < 1       return true
39 < 1     }
40 < 1   }
41 < 1 ]
42 < 1 
43 < 1 export function makeStore () {
44 < 1   return createStore().setTablesSchema({
45 < 1     todos: { text: { type: 'string' }, completed: { type: 'boolean' } }
46 < 1   })
47 < 1 }
48 < 1 