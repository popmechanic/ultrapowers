0 < 2 // Packs the page into the Worker: builds client/index.html and writes every
1 < 2 // output file into server/client-files.ts, so a deploy uploads one thing.
2 < 1 import {mkdtempSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync} from 'node:fs';
3 < 1 import {tmpdir} from 'node:os';
4 < 1 import {extname, join, relative} from 'node:path';
5 < 1 
6 < 1 const ROOT = join(import.meta.dir, '..');
7 < 1 const OUT_FILE = join(ROOT, 'server', 'client-files.ts');
8 < 1 
9 < 1 const TEXT_TYPES: Record<string, string> = {
10 < 1   '.html': 'text/html; charset=utf-8',
11 < 1   '.js': 'text/javascript; charset=utf-8',
12 < 1   '.css': 'text/css; charset=utf-8',
13 < 1   '.json': 'application/json; charset=utf-8',
14 < 1   '.svg': 'image/svg+xml',
15 < 1   '.txt': 'text/plain; charset=utf-8',
16 < 1   '.map': 'application/json; charset=utf-8',
17 < 1 };
18 < 1 
19 < 1 const BINARY_TYPES: Record<string, string> = {
20 < 1   '.png': 'image/png',
21 < 1   '.jpg': 'image/jpeg',
22 < 1   '.jpeg': 'image/jpeg',
23 < 1   '.gif': 'image/gif',
24 < 1   '.webp': 'image/webp',
25 < 1   '.ico': 'image/x-icon',
26 < 1   '.woff': 'font/woff',
27 < 1   '.woff2': 'font/woff2',
28 < 1   '.wasm': 'application/wasm',
29 < 1 };
30 < 1 
31 < 1 const walk = (dir: string): string[] =>
32 < 1   readdirSync(dir).flatMap((name) => {
33 < 1     const path = join(dir, name);
34 < 1     return statSync(path).isDirectory() ? walk(path) : [path];
35 < 1   });
36 < 1 
37 < 1 const outdir = mkdtempSync(join(tmpdir(), 'tinyapp-pack-'));
38 < 1 try {
39 < 1   const build = Bun.spawnSync(['bun', 'scripts/build-client.ts', outdir, '--minify'], {
40 < 1     cwd: ROOT,
41 < 1     stdout: 'inherit',
42 < 1     stderr: 'inherit',
43 < 1   });
44 < 1   if (build.exitCode !== 0) {
45 < 1     console.error('PACK FAILED: build-client exited ' + build.exitCode);
46 < 1     process.exit(1);
47 < 1   }
48 < 1 
49 < 1   const files: Record<string, {type: string; text?: string; base64?: string}> = {};
50 < 1   for (const path of walk(outdir).sort()) {
51 < 1     const key = '/' + relative(outdir, path).split('\\').join('/');
52 < 1     const ext = extname(path).toLowerCase();
53 < 1     const bytes = readFileSync(path);
54 < 1     files[key] = ext in TEXT_TYPES
55 < 1       ? {type: TEXT_TYPES[ext], text: bytes.toString('utf8')}
56 < 1       : {type: BINARY_TYPES[ext] ?? 'application/octet-stream', base64: bytes.toString('base64')};
57 < 1   }
58 < 1   if (!files['/index.html']) {
59 < 1     console.error('PACK FAILED: build wrote no index.html');
60 < 1     process.exit(1);
61 < 1   }
62 < 1 
63 < 1   writeFileSync(
64 < 1     OUT_FILE,
66 > 1     'export const FILES: Record<string, {type: string; text?: string; base64?: string}> = ' +
65 < 2     '// Generated by scripts/pack-client.ts (bun run pack). Do not edit.\n' +
66 < 2       'export const FILES: Record<string, {type: string; text?: string; base64?: string}> = ' +
67 < 1       JSON.stringify(files, null, 2) +
68 < 1       ';\n',
69 < 1   );
70 < 1   console.log(`PACKED ${Object.keys(files).length} file(s) into server/client-files.ts`);
71 < 1 } finally {
72 < 1   rmSync(outdir, {recursive: true, force: true});
73 < 1 }
74 < 1 