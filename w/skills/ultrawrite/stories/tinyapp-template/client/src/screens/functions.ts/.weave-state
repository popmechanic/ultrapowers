0 < 1 /** The `$computed` functions a screen may call, passed to every JSONUIProvider.
1 < 1  *
2 < 1  * A row shows only its own cells, so a row that names another table's row (a
3 < 1  * tag naming its todo) reads that row's text through `lookup`, and `format`
4 < 1  * puts the pieces of a label together (#1524):
5 < 1  *
6 < 1  *   {$computed: 'format', args: {template: 'Remove ${name} from ${todoId.text}',
7 < 1  *     name: {$item: 'name'},
8 < 1  *     'todoId.text': {$computed: 'lookup', args: {rows: {$state: '/tables/todos'}, id: {$item: 'todoId'}, column: 'text'}}}}
9 < 1  */
10 < 1 import type { ComputedFunction } from '@json-render/core'
11 < 1 
12 < 1 const text = (v: unknown) => (v === undefined || v === null ? '' : String(v))
13 < 1 
14 < 1 /** One cell of the row whose id is `id` in `rows` (a table as the screen state holds it), or ''. */
15 < 1 const lookup: ComputedFunction = ({ rows, id, column }) => {
16 < 1   if (!Array.isArray(rows)) return ''
17 < 1   const row = rows.find((r) => r && typeof r === 'object' && (r as Record<string, unknown>).id === id) as Record<string, unknown> | undefined
18 < 1   return row ? text(row[String(column)]) : ''
19 < 1 }
20 < 1 
21 < 1 /** `template` with each `${name}` replaced by the arg of that name. */
22 < 1 const format: ComputedFunction = ({ template, ...args }) =>
23 < 1   text(template).replace(/\$\{([^}]+)\}/g, (_m, name: string) => text(args[name]))
24 < 1 
26 > 1 /** The rows of `rows`, in order, whose every `where` cell equals theirs (a picker's options). */
27 < 1 const rowsWhere: ComputedFunction = ({ rows, where }) => {
28 < 1   if (!Array.isArray(rows)) return []
29 < 1   const want = where && typeof where === 'object' ? (where as Record<string, unknown>) : {}
30 < 1   return rows.filter(
31 < 1     (r) =>
32 < 1       r &&
33 < 1       typeof r === 'object' &&
34 < 1       Object.keys(want).every((k) => String((r as Record<string, unknown>)[k] ?? '') === String(want[k])),
35 < 1   )
36 < 1 }
25 < 2 export const functions: Record<string, ComputedFunction> = { lookup, format }
26 < 1 
27 < 1 export const functions: Record<string, ComputedFunction> = { lookup, format, rowsWhere }
28 < 1 