0 < 2 /** A text box's example, worded so it reads as an example and never as text
1 < 2  * already typed (#1506): "eggs" is drawn "e.g. eggs". The spec keeps the raw
2 < 2  * word, which the arranger matches on, so the prefix is added only here, where
3 < 2  * the box is drawn; an example already worded "e.g. …" is left as it is.
4 < 2  */
5 < 1 const PREFIX = 'e.g. '
6 < 1 
7 < 1 export const asExample = (v: string | null | undefined): string | undefined =>
8 < 1   v ? (v.startsWith(PREFIX) ? v : PREFIX + v) : undefined
9 < 1 