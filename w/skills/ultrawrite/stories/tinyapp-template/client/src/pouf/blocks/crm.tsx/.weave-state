0 < 2 import { useState } from 'react'
1 < 2 import { Avatar } from '../avatar'
2 < 2 import { BottomNav, type NavItem } from '../BottomNav'
3 < 2 import { Button } from '../Button'
4 < 2 import { Select } from '../controls'
5 < 2 import { Empty } from '../feedback'
6 < 2 import { Field, Input, Textarea } from '../Input'
7 < 2 import { Row, Shell, Sidebar, Stack } from '../layout'
8 < 2 import { Badge, Blob } from '../media'
9 < 2 import { NavLink } from '../NavLink'
10 < 2 import { Segmented } from '../Segmented'
11 < 2 import { Card, RowCard } from '../surface'
12 < 2 import { Eyebrow, Heading, Text } from '../text'
13 < 2 
14 < 2 type Stage = 'lead' | 'active' | 'at-risk'
15 < 2 type StageFilter = 'all' | Stage
16 < 2 
17 < 2 interface Customer {
18 < 2   id: string
19 < 2   name: string
20 < 2   company: string
21 < 2   email: string
22 < 2   value: number
23 < 2   stage: Stage
24 < 2   owner: string
25 < 2   tone: 'purple' | 'pink' | 'blue' | 'mint'
26 < 2 }
27 < 2 
28 < 2 const CUSTOMERS: Customer[] = [
29 < 2   { id: 'ada', name: 'Ada Lovelace', company: 'Analytical', email: 'ada@example.com', value: 18400, stage: 'active', owner: 'Maya', tone: 'purple' },
30 < 2   { id: 'grace', name: 'Grace Hopper', company: 'Compiler Co.', email: 'grace@example.com', value: 9200, stage: 'lead', owner: 'Noah', tone: 'blue' },
31 < 2   { id: 'katherine', name: 'Katherine Johnson', company: 'Orbital', email: 'kj@example.com', value: 24600, stage: 'active', owner: 'Maya', tone: 'mint' },
32 < 2   { id: 'alan', name: 'Alan Turing', company: 'Bombe Labs', email: 'alan@example.com', value: 7800, stage: 'at-risk', owner: 'Iris', tone: 'pink' },
33 < 2 ]
34 < 2 
35 < 2 const NAV: NavItem[] = [
36 < 2   { href: '/crm', label: 'Customers', icon: 'users', tone: 'purple' },
37 < 2   { href: '/crm/pipeline', label: 'Pipeline', icon: 'log', tone: 'mint' },
38 < 2   { href: '/crm/activity', label: 'Activity', icon: 'activity', tone: 'blue' },
39 < 2   { href: '/crm/reports', label: 'Reports', icon: 'chart', tone: 'yellow' },
40 < 2   { href: '/crm/settings', label: 'Settings', icon: 'settings', tone: 'orange' },
41 < 2 ]
42 < 2 
43 < 2 const STAGE_TONE = { lead: 'blue', active: 'mint', 'at-risk': 'pink' } as const
44 < 2 const STAGES = [
45 < 2   { value: 'lead', label: 'Lead' },
46 < 2   { value: 'active', label: 'Active' },
47 < 2   { value: 'at-risk', label: 'At risk' },
48 < 2 ]
49 < 2 const money = new Intl.NumberFormat('en-US', {
50 < 2   style: 'currency',
51 < 2   currency: 'USD',
52 < 2   maximumFractionDigits: 0,
53 < 2 })
54 < 2 
55 < 2 /** A complete customer workspace with filtering, responsive master/detail,
56 < 2  * editable stages, and notes that persist while the screen is mounted. */
57 < 2 export function CrmBlock() {
58 < 2   const [query, setQuery] = useState('')
59 < 2   const [filter, setFilter] = useState<StageFilter>('all')
60 < 2   const [activeId, setActiveId] = useState(CUSTOMERS[0]!.id)
61 < 2   const [pane, setPane] = useState<'list' | 'detail'>('list')
62 < 2   const [stages, setStages] = useState<Record<string, Stage>>(
63 < 2     Object.fromEntries(CUSTOMERS.map((customer) => [customer.id, customer.stage])),
64 < 2   )
65 < 2   const [draft, setDraft] = useState('')
66 < 2   const [notes, setNotes] = useState<Record<string, string[]>>({})
67 < 2 
68 < 2   const customers = CUSTOMERS.filter((customer) => {
69 < 2     const stage = stages[customer.id]!
70 < 2     const matchesFilter = filter === 'all' || stage === filter
71 < 2     const haystack = `${customer.name} ${customer.company} ${customer.email}`.toLowerCase()
72 < 2     return matchesFilter && haystack.includes(query.toLowerCase())
73 < 2   })
74 < 2   const active = CUSTOMERS.find((customer) => customer.id === activeId) ?? CUSTOMERS[0]!
75 < 2 
76 < 2   const open = (id: string) => {
77 < 2     setActiveId(id)
78 < 2     setPane('detail')
79 < 2     setDraft('')
80 < 2   }
81 < 2 
82 < 2   const addNote = () => {
83 < 2     const note = draft.trim()
84 < 2     if (!note) return
85 < 2     setNotes((current) => ({ ...current, [active.id]: [...(current[active.id] ?? []), note] }))
86 < 2     setDraft('')
87 < 2   }
88 < 2 
89 < 2   return (
90 < 2     <>
91 < 2       <Shell>
92 < 2         <Sidebar mobile="hide">
93 < 2           <Row gap={2} wrap={false}>
94 < 2             <Blob icon="users" tone="purple" size="sm" />
95 < 2             <Heading level={3}>Orbit CRM</Heading>
96 < 2           </Row>
97 < 2           {NAV.map((item) => (
98 < 2             <NavLink
99 < 2               key={item.href}
100 < 2               href={item.href}
101 < 2               currentPath="/crm"
102 < 2               icon={item.icon}
103 < 2               tone={item.tone}
104 < 2             >
105 < 2               {item.label}
106 < 2             </NavLink>
107 < 2           ))}
108 < 2         </Sidebar>
109 < 2 
110 < 2         <Stack gap={5}>
111 < 2           <Row justify="between" align="top">
112 < 2             <Stack gap={1}>
113 < 2               <Eyebrow>Customers</Eyebrow>
114 < 2               <Heading level={1}>Keep every relationship warm.</Heading>
115 < 2             </Stack>
116 < 2             <Button size="sm">Add customer</Button>
117 < 2           </Row>
118 < 2 
119 < 2           <div className="grid [grid-template-columns:minmax(0,360px)_minmax(0,1fr)] gap-(--s4) min-h-[620px] max-[900px]:[grid-template-columns:minmax(0,1fr)]">
120 < 2             <div className={pane === 'detail' ? 'max-[900px]:hidden' : ''}>
121 < 2               <Card>
122 < 2                 <Stack gap={4}>
123 < 2                   <Field label="Search">
124 < 2                     {(id, describedBy) => (
125 < 2                       <Input
126 < 2                         id={id}
127 < 2                         name="customer-search"
128 < 2                         value={query}
129 < 2                         onChange={setQuery}
130 < 2                         describedBy={describedBy}
131 < 2                         label="Search customers"
132 < 2                         autoComplete="off"
133 < 2                         spellCheck={false}
134 < 2                         placeholder="Name, company, or email…"
135 < 2                       />
136 < 2                     )}
137 < 2                   </Field>
138 < 2                   <Segmented
139 < 2                     label="Filter customers"
140 < 2                     value={filter}
141 < 2                     onChange={setFilter}
142 < 2                     options={[
143 < 2                       { value: 'all', label: 'All' },
144 < 2                       { value: 'active', label: 'Active' },
145 < 2                       { value: 'lead', label: 'Leads' },
146 < 2                       { value: 'at-risk', label: 'At risk' },
147 < 2                     ]}
148 < 2                   />
149 < 2                   <Stack gap={2}>
150 < 2                     {customers.length === 0 ? (
151 < 2                       <Empty icon="search" title="No customers found">
152 < 2                         Try a broader search or another stage.
153 < 2                       </Empty>
154 < 2                     ) : customers.map((customer) => (
155 < 2                       <RowCard
156 < 2                         key={customer.id}
157 < 2                         selected={customer.id === activeId}
158 < 2                         onClick={() => open(customer.id)}
159 < 2                       >
160 < 2                         <Row gap={3} wrap={false}>
161 < 2                           <Avatar fallback={customer.name.slice(0, 2)} tone={customer.tone} size="sm" />
162 < 2                           <Stack gap={1}>
163 < 2                             <Text truncate>{customer.name}</Text>
164 < 2                             <Text size="sm" muted truncate>{customer.company}</Text>
165 < 2                           </Stack>
166 < 2                         </Row>
167 < 2                       </RowCard>
168 < 2                     ))}
169 < 2                   </Stack>
170 < 2                 </Stack>
171 < 2               </Card>
172 < 2             </div>
173 < 2 
174 < 2             <div className={pane === 'list' ? 'max-[900px]:hidden' : ''}>
175 < 2               <Card>
176 < 2                 <Stack gap={5}>
177 < 2                   <Row justify="between" align="top">
178 < 2                     <Row gap={3} wrap={false} align="top">
179 < 2                       <Avatar fallback={active.name.slice(0, 2)} tone={active.tone} size="lg" />
180 < 2                       <Stack gap={1}>
181 < 2                         <Heading level={2}>{active.name}</Heading>
182 < 2                         <Text muted>{active.company}</Text>
183 < 2                         <Badge tone={STAGE_TONE[stages[active.id]!]}>{stages[active.id]}</Badge>
184 < 2                       </Stack>
185 < 2                     </Row>
186 < 2                     <Button size="sm" variant="quiet" onClick={() => setPane('list')}>
187 < 2                       Back to customers
188 < 2                     </Button>
189 < 2                   </Row>
190 < 2 
191 < 2                   <div className="grid grid-cols-3 gap-(--s3) max-[700px]:grid-cols-1">
192 < 2                     <Card variant="tight">
193 < 2                       <Stack gap={1}><Text size="sm" muted>Account value</Text><Heading level={3}>{money.format(active.value)}</Heading></Stack>
194 < 2                     </Card>
195 < 2                     <Card variant="tight">
196 < 2                       <Stack gap={1}><Text size="sm" muted>Owner</Text><Heading level={3}>{active.owner}</Heading></Stack>
197 < 2                     </Card>
198 < 2                     <Card variant="tight">
199 < 2                       <Stack gap={1}><Text size="sm" muted>Email</Text><Text>{active.email}</Text></Stack>
200 < 2                     </Card>
201 < 2                   </div>
202 < 2 
203 < 2                   <Field label="Lifecycle stage">
204 < 2                     {(id, describedBy) => (
205 < 2                       <Select
206 < 2                         id={id}
207 < 2                         value={stages[active.id]!}
208 < 2                         onChange={(value) => setStages((current) => ({ ...current, [active.id]: value as Stage }))}
209 < 2                         options={STAGES}
210 < 2                         describedBy={describedBy}
211 < 2                       />
212 < 2                     )}
213 < 2                   </Field>
214 < 2 
215 < 2                   <Stack gap={3}>
216 < 2                     <Heading level={3}>Notes</Heading>
217 < 2                     {(notes[active.id] ?? []).map((note, index) => (
218 < 2                       <Card key={`${active.id}-${index}`} variant="tight">
219 < 2                         <Text>{note}</Text>
220 < 2                       </Card>
221 < 2                     ))}
222 < 2                     <Field label="Add a note">
223 < 2                       {(id, describedBy) => (
224 < 2                         <Textarea
225 < 2                           id={id}
226 < 2                           name="customer-note"
227 < 2                           value={draft}
228 < 2                           onChange={setDraft}
229 < 2                           describedBy={describedBy}
230 < 2                           autoComplete="off"
231 < 2                           placeholder="Capture the next step…"
232 < 2                           rows={3}
233 < 2                         />
234 < 2                       )}
235 < 2                     </Field>
236 < 2                     <Row justify="end">
237 < 2                       <Button size="sm" onClick={addNote} disabled={!draft.trim()}>Save note</Button>
238 < 2                     </Row>
239 < 2                   </Stack>
240 < 2                 </Stack>
241 < 2               </Card>
242 < 2             </div>
243 < 2           </div>
244 < 2         </Stack>
245 < 2       </Shell>
246 < 2       <BottomNav primary={NAV.slice(0, 4)} groups={[{ title: 'CRM', items: NAV }]} currentPath="/crm" />
247 < 2     </>
248 < 2   )
249 < 2 }
250 < 2 