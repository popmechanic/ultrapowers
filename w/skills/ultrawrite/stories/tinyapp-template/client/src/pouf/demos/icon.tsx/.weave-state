0 < 2 import { Icon } from '../Icon'
1 < 2 import type { IconName } from '../Icon'
2 < 2 import { Row, Stack } from '../layout'
3 < 2 import { Text } from '../text'
4 < 2 import type { Demo } from './types'
5 < 2 
6 < 2 /** `satisfies Record<IconName, true>` keeps this exhaustive: add a glyph to
7 < 2  * Icon.tsx's ICONS and omit it here and this file stops compiling. */
8 < 2 const ICON_ROLES = {
9 < 2   overview: true, chart: true, log: true, channels: true, activity: true, lab: true, history: true,
10 < 2   performance: true, settings: true, database: true, menu: true, up: true, down: true, flat: true, ok: true,
11 < 2   warn: true, fail: true, info: true, idle: true, off: true, live: true, draft: true, target: true, alerts: true,
12 < 2   add: true, remove: true, search: true, close: true, expand: true, prev: true, next: true, photo: true,
13 < 2   heart: true, 'heart-filled': true, comment: true, play: true, pause: true, rewind: true, forward: true,
14 < 2   sun: true, cloud: true, rain: true, star: true, calendar: true, clock: true, user: true, users: true,
15 < 2   mail: true, lock: true, send: true, home: true, trophy: true, flame: true, sparkle: true, music: true,
16 < 2   cart: true, tag: true, dots: true, sword: true, shield: true, wand: true, smile: true, card: true,
17 < 2   pin: true, wind: true, drop: true,
18 < 2 } satisfies Record<IconName, true>
19 < 2 const ICON_NAMES = Object.keys(ICON_ROLES) as IconName[]
20 < 2 
21 < 2 export const iconDemos: Demo[] = [
22 < 2   { id: 'all', render: () => (
23 < 2       <Row gap={4}>
24 < 2         {ICON_NAMES.map((name) => (
25 < 2           <Stack key={name} gap={1}>
26 < 2             <Row justify="center"><Icon name={name} /></Row>
27 < 2             <Text size="sm" muted mono>{name}</Text>
28 < 2           </Stack>
29 < 2         ))}
30 < 2       </Row>
31 < 2     ) },
32 < 2   { id: 'sizes', render: () => (
33 < 2       <Row gap={4}>
34 < 2         <Icon name="settings" size="sm" />
35 < 2         <Icon name="settings" size="md" />
36 < 2         <Icon name="settings" size="lg" />
37 < 2       </Row>
38 < 2     ) },
39 < 2   { id: 'labelled', render: () => <Icon name="ok" label="Connected" /> },
40 < 2 ]
