0 < 2 import { useState } from 'react'
1 < 2 import clsx from 'clsx'
2 < 2 import { Card, RowCard } from '../surface'
3 < 2 import { Shell, Sidebar, Stack, Row, Spacer } from '../layout'
4 < 2 import { Heading, Text, Eyebrow } from '../text'
5 < 2 import { Avatar } from '../avatar'
6 < 2 import { Dot, Badge, Blob } from '../media'
7 < 2 import { Input } from '../Input'
8 < 2 import { Button } from '../Button'
9 < 2 import { Icon } from '../Icon'
10 < 2 import { NavLink } from '../NavLink'
11 < 2 import { BottomNav, type NavItem } from '../BottomNav'
12 < 2 
13 < 2 const NAV: NavItem[] = [
14 < 2   { href: '/', label: 'Overview', icon: 'overview', tone: 'purple' },
15 < 2   { href: '/inbox', label: 'Inbox', icon: 'mail', tone: 'blue' },
16 < 2   { href: '/board', label: 'Board', icon: 'log', tone: 'mint' },
17 < 2   { href: '/messages', label: 'Messages', icon: 'comment', tone: 'pink' },
18 < 2   { href: '/settings', label: 'Settings', icon: 'settings', tone: 'orange' },
19 < 2 ]
20 < 2 
21 < 2 const HERE = '/messages'
22 < 2 
23 < 2 interface Message {
24 < 2   id: string
25 < 2   from: 'me' | 'them'
26 < 2   text: string
27 < 2   time: string
28 < 2 }
29 < 2 
30 < 2 interface Convo {
31 < 2   id: string
32 < 2   name: string
33 < 2   tone: 'purple' | 'pink' | 'blue' | 'mint'
34 < 2   online: boolean
35 < 2   unread: number
36 < 2 }
37 < 2 
38 < 2 const CONVOS: Convo[] = [
39 < 2   { id: 'maya', name: 'Maya B.', tone: 'mint', online: true, unread: 0 },
40 < 2   { id: 'grace', name: 'Grace H.', tone: 'blue', online: true, unread: 2 },
41 < 2   { id: 'kat', name: 'Katherine J.', tone: 'pink', online: false, unread: 0 },
42 < 2   { id: 'alan', name: 'Alan T.', tone: 'purple', online: false, unread: 0 },
43 < 2 ]
44 < 2 
45 < 2 /* One thread per conversation. The previous version kept a single flat message
46 < 2  * list and a hardcoded "Maya B." header, so picking another person in the list
47 < 2  * showed you Maya's messages under their name. */
48 < 2 const SEED: Record<string, Message[]> = {
49 < 2   maya: [
50 < 2     { id: 'm1', from: 'them', text: 'hey! did you try the new cushion buttons?', time: '9:41' },
51 < 2     { id: 'm2', from: 'me', text: 'yes — they literally press in. so satisfying', time: '9:42' },
52 < 2     { id: 'm3', from: 'them', text: 'right?? depth is the whole personality', time: '9:42' },
53 < 2     { id: 'm4', from: 'me', text: 'shipping the dashboard with them today', time: '9:44' },
54 < 2   ],
55 < 2   grace: [
56 < 2     { id: 'g1', from: 'them', text: 'migration finished — zero visual drift', time: '8:10' },
57 < 2     { id: 'g2', from: 'them', text: 'across 2,700 lines. the gate paid for itself', time: '8:12' },
58 < 2   ],
59 < 2   kat: [
60 < 2     { id: 'k1', from: 'them', text: 'sent the optical-centering note', time: 'Tue' },
61 < 2     { id: 'k2', from: 'me', text: 'read it twice. the glyph offset finally makes sense', time: 'Tue' },
62 < 2   ],
63 < 2   alan: [
64 < 2     { id: 'a1', from: 'them', text: 'variants over classNames, always', time: 'Mon' },
65 < 2   ],
66 < 2 }
67 < 2 
68 < 2 const PANES =
69 < 2   'grid [grid-template-columns:minmax(0,280px)_minmax(0,1fr)] min-h-[520px] max-[900px]:[grid-template-columns:minmax(0,1fr)]'
70 < 2 
71 < 2 /** An example chat screen: app shell, a conversation list that actually
72 < 2  * switches threads, message bubbles, and a working composer. Below 900px the
73 < 2  * list and thread take turns rather than splitting a phone in half. */
74 < 2 export function ChatBlock() {
75 < 2   const [threads, setThreads] = useState<Record<string, Message[]>>(SEED)
76 < 2   const [draft, setDraft] = useState('')
77 < 2   const [active, setActive] = useState('maya')
78 < 2   const [read, setRead] = useState<string[]>([])
79 < 2   const [pane, setPane] = useState<'list' | 'detail'>('list')
80 < 2 
81 < 2   const convo = CONVOS.find((c) => c.id === active) ?? CONVOS[0]!
82 < 2   const messages = threads[active] ?? []
83 < 2   const unreadTotal = CONVOS.filter((c) => !read.includes(c.id)).reduce((n, c) => n + c.unread, 0)
84 < 2 
85 < 2   function open(id: string) {
86 < 2     setActive(id)
87 < 2     setRead((r) => (r.includes(id) ? r : [...r, id]))
88 < 2     setDraft('')
89 < 2     setPane('detail')
90 < 2   }
91 < 2 
92 < 2   function send() {
93 < 2     const text = draft.trim()
94 < 2     if (!text) return
95 < 2     setThreads((t) => ({
96 < 2       ...t,
97 < 2       [active]: [
98 < 2         ...(t[active] ?? []),
99 < 2         { id: `${active}-${(t[active]?.length ?? 0) + 1}`, from: 'me', text, time: 'now' },
100 < 2       ],
101 < 2     }))
102 < 2     setDraft('')
103 < 2   }
104 < 2 
105 < 2   return (
106 < 2     <>
107 < 2       <Shell>
108 < 2         <Sidebar mobile="hide">
109 < 2           <Row gap={2} wrap={false}>
110 < 2             <Blob icon="target" tone="purple" size="sm" />
111 < 2             <Heading level={3}>Acme</Heading>
112 < 2           </Row>
113 < 2           {NAV.map((item) => (
114 < 2             <NavLink key={item.href} href={item.href} currentPath={HERE} icon={item.icon} tone={item.tone}>
115 < 2               {item.label}
116 < 2             </NavLink>
117 < 2           ))}
118 < 2         </Sidebar>
119 < 2 
120 < 2         <Stack gap={5}>
121 < 2           <Row justify="between">
122 < 2             <Stack gap={1}>
123 < 2               <Eyebrow>Team</Eyebrow>
124 < 2               <Heading level={1}>Messages</Heading>
125 < 2             </Stack>
126 < 2             {unreadTotal > 0 && <Badge tone="pink">{unreadTotal} new</Badge>}
127 < 2           </Row>
128 < 2 
129 < 2           <Card variant="flush">
130 < 2             <div className={PANES}>
131 < 2               {/* Conversation list */}
132 < 2               <div
133 < 2                 className={clsx(
134 < 2                   'flex flex-col [border-right:1px_solid_rgba(201,168,255,0.3)]',
135 < 2                   'max-[900px]:[border-right:none]',
136 < 2                   pane === 'detail' && 'max-[900px]:hidden',
137 < 2                 )}
138 < 2               >
139 < 2                 <div className="flex flex-col gap-(--s2) p-(--s3)">
140 < 2                   {CONVOS.map((c) => {
141 < 2                     const thread = threads[c.id] ?? []
142 < 2                     const last = thread[thread.length - 1]
143 < 2                     const unread = read.includes(c.id) ? 0 : c.unread
144 < 2                     return (
145 < 2                       <RowCard key={c.id} onClick={() => open(c.id)} selected={c.id === active}>
146 < 2                         <Row gap={3} wrap={false}>
147 < 2                           <Avatar fallback={c.name.slice(0, 2)} tone={c.tone} />
148 < 2                           <Stack gap={1}>
149 < 2                             <Row gap={2} wrap={false}>
150 < 2                               <Text truncate>{c.name}</Text>
151 < 2                               {c.online && <Dot tone="mint" />}
152 < 2                             </Row>
153 < 2                             <Text size="sm" muted truncate>{last?.text ?? 'No messages yet'}</Text>
154 < 2                           </Stack>
155 < 2                           <Spacer />
156 < 2                           {unread > 0 && <Badge tone="purple">{unread}</Badge>}
157 < 2                         </Row>
158 < 2                       </RowCard>
159 < 2                     )
160 < 2                   })}
161 < 2                 </div>
162 < 2               </div>
163 < 2 
164 < 2               {/* Active thread */}
165 < 2               <div
166 < 2                 className={clsx(
167 < 2                   'flex flex-col min-w-0',
168 < 2                   pane === 'list' && 'max-[900px]:hidden',
169 < 2                 )}
170 < 2               >
171 < 2                 <div className="p-(--s5) [border-bottom:1px_solid_rgba(201,168,255,0.3)]">
172 < 2                   <Row gap={3} wrap={false}>
173 < 2                     <span className="hidden max-[900px]:inline-flex">
174 < 2                       <Button size="sm" variant="quiet" onClick={() => setPane('list')} label="Back to conversations">
175 < 2                         <Icon name="prev" size="sm" />
176 < 2                       </Button>
177 < 2                     </span>
178 < 2                     <Avatar fallback={convo.name.slice(0, 2)} tone={convo.tone} />
179 < 2                     <Stack gap={1}>
180 < 2                       <Heading level={3}>{convo.name}</Heading>
181 < 2                       <Row gap={2} wrap={false}>
182 < 2                         <Dot tone={convo.online ? 'mint' : 'purple'} />
183 < 2                         <Text size="sm" muted>{convo.online ? 'Online' : 'Offline'}</Text>
184 < 2                       </Row>
185 < 2                     </Stack>
186 < 2                     <Spacer />
187 < 2                     <Button variant="quiet" size="sm" label="Call"><Icon name="alerts" size="sm" /></Button>
188 < 2                   </Row>
189 < 2                 </div>
190 < 2 
191 < 2                 <div className="flex flex-col gap-(--s3) p-(--s5) flex-1 min-h-[260px] max-h-[340px] overflow-y-auto">
192 < 2                   <Row justify="center"><Badge tone="blue">Today</Badge></Row>
193 < 2                   {messages.map((m) => (
194 < 2                     <div
195 < 2                       key={m.id}
196 < 2                       className={clsx(
197 < 2                         'flex flex-col gap-1',
198 < 2                         m.from === 'me' ? 'items-end' : 'items-start',
199 < 2                       )}
200 < 2                     >
201 < 2                       <div
202 < 2                         className={clsx(
203 < 2                           'max-w-[78%] px-4 py-3 rounded-[20px] font-bold',
204 < 2                           m.from === 'me'
205 < 2                             ? 'bg-purple text-[var(--on-accent)] [box-shadow:var(--pouf-control)]'
206 < 2                             : 'bg-surface text-ink [box-shadow:var(--pouf-row)]',
207 < 2                         )}
208 < 2                       >
209 < 2                         {m.text}
210 < 2                       </div>
211 < 2                       <Text size="sm" muted>{m.time}</Text>
212 < 2                     </div>
213 < 2                   ))}
214 < 2                 </div>
215 < 2 
216 < 2                 <div className="p-(--s4) [border-top:1px_solid_rgba(201,168,255,0.3)]">
217 < 2                   <Row gap={2} wrap={false}>
218 < 2                     <Button variant="quiet" size="sm" label="Attach"><Icon name="add" size="sm" /></Button>
219 < 2                     <div className="flex-1 min-w-0">
220 < 2                       <Input
221 < 2                         value={draft}
222 < 2                         onChange={setDraft}
223 < 2                         placeholder={`Message ${convo.name}…`}
224 < 2                         label={`Message ${convo.name}`}
225 < 2                       />
226 < 2                     </div>
227 < 2                     <Button onClick={send} disabled={!draft.trim()} label="Send">
228 < 2                       <Icon name="send" size="sm" />
229 < 2                     </Button>
230 < 2                   </Row>
231 < 2                 </div>
232 < 2               </div>
233 < 2             </div>
234 < 2           </Card>
235 < 2           <Spacer />
236 < 2         </Stack>
237 < 2       </Shell>
238 < 2       <BottomNav primary={NAV.slice(0, 4)} groups={[{ title: 'App', items: NAV }]} currentPath={HERE} />
239 < 2     </>
240 < 2   )
241 < 2 }
242 < 2 