0 < 2 import { useState } from 'react'
1 < 2 import { Pagination } from '../pagination'
2 < 2 import type { Demo } from './types'
3 < 2 
4 < 2 function InteractivePagination({ initial, subject = false }: { initial: number; subject?: boolean }) {
5 < 2   const [page, setPage] = useState(initial)
6 < 2   const control = <Pagination page={page} total={5} onChange={setPage} />
7 < 2   return subject ? <span data-subject>{control}</span> : control
8 < 2 }
9 < 2 
10 < 2 export const paginationDemos: Demo[] = [
11 < 2   { id: 'middle', states: ['hover', 'focus'], render: () => (
12 < 2       <InteractivePagination initial={2} subject />
13 < 2     ) },
14 < 2   { id: 'first-page', render: () => <InteractivePagination initial={1} /> },
15 < 2   { id: 'last-page', render: () => <InteractivePagination initial={5} /> },
