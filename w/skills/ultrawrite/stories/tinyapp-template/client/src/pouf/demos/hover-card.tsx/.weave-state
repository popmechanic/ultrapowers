0 < 2 import { useEffect, useRef } from 'react'
1 < 2 import { HoverCard } from '../hovercard'
2 < 2 import { Badge } from '../media'
3 < 2 import { Text } from '../text'
4 < 2 import { simulateHover } from './interact'
5 < 2 import type { Demo } from './types'
6 < 2 
7 < 2 const content = <Text size="sm">Created 3 hours ago · 12 items · shared with 2 people.</Text>
8 < 2 
9 < 2 function HoverCardOpen() {
10 < 2   const ref = useRef<HTMLDivElement>(null)
11 < 2   // HoverCard has no controlled `open` prop, and it opens on a real hover
12 < 2   // after openDelay (300ms) — dispatching the pointer sequence arms Radix's
13 < 2   // own timer, but the panel won't actually be visible until that elapses.
14 < 2   useEffect(() => { simulateHover(ref.current?.querySelector('.pouf-hover__anchor')) }, [])
15 < 2   return (
16 < 2     <div ref={ref}>
17 < 2       <HoverCard content={content}>
18 < 2         <Badge tone="info">Hover for details</Badge>
19 < 2       </HoverCard>
20 < 2     </div>
21 < 2   )
22 < 2 }
23 < 2 
24 < 2 export const hoverCardDemos: Demo[] = [
25 < 2   { id: 'trigger', states: ['hover'], render: () => (
26 < 2       <span data-subject>
27 < 2         <HoverCard content={content}>
28 < 2           <Badge tone="info">Hover for details</Badge>
29 < 2         </HoverCard>
30 < 2       </span>
31 < 2     ) },
32 < 2   { id: 'open', render: () => <HoverCardOpen /> },
33 < 2 ]
