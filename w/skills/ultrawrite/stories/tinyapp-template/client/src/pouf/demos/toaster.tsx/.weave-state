0 < 2 import { useEffect } from 'react'
1 < 2 import { Button } from '../Button'
2 < 2 import { Row } from '../layout'
3 < 2 import { toast, Toaster } from '../toaster'
4 < 2 import type { ToastVariant } from '../toaster'
5 < 2 import type { Demo } from './types'
6 < 2 
7 < 2 /** toaster.tsx's toast state is a module-level singleton (see its header
8 < 2  * comment) — there is no controlled-open prop to render into, so each
9 < 2  * "-open" demo below fires the imperative API itself, once, on mount. This
10 < 2  * assumes each demo gets a fresh page load; navigating between these via a
11 < 2  * hash change on an already-open page would accumulate toasts rather than
12 < 2  * replace them, since nothing here ever clears the queue. */
13 < 2 function ToasterOpen({ variant }: { variant: ToastVariant }) {
14 < 2   useEffect(() => {
15 < 2     if (variant === 'default') toast('Saved — sample note')
16 < 2     else if (variant === 'success') toast.success('Payment received', { description: '$48.00 · Visa ending 4242' })
17 < 2     else if (variant === 'error') toast.error('API connection lost', { description: 'Retrying…' })
18 < 2     else if (variant === 'warning')
19 < 2       toast.warning('Storage almost full', { description: '92% used. Consider upgrading.' })
20 < 2     else toast.info('Maya replied to your thread', { description: '“depth is the whole personality”' })
21 < 2     // eslint-disable-next-line react-hooks/exhaustive-deps
22 < 2   }, [])
23 < 2   return <Toaster />
24 < 2 }
25 < 2 
26 < 2 export const toasterDemos: Demo[] = [
27 < 2   { id: 'trigger', states: ['hover', 'focus'], render: () => (
28 < 2       <Row gap={2}>
29 < 2         <span data-subject>
30 < 2           <Button size="sm" tone="purple" onClick={() => toast('Saved — sample note')}>Default</Button>
31 < 2         </span>
32 < 2         <Button size="sm" tone="mint" onClick={() => toast.success('Payment received', { description: '$48.00 · Visa ending 4242' })}>Success</Button>
33 < 2         <Button size="sm" tone="pink" onClick={() => toast.error('API connection lost', { description: 'Retrying…' })}>Error</Button>
34 < 2         <Button size="sm" tone="yellow" onClick={() => toast.warning('Storage almost full', { description: '92% used. Consider upgrading.' })}>Warning</Button>
35 < 2         <Button size="sm" tone="blue" onClick={() => toast.info('Maya replied to your thread', { description: '“depth is the whole personality”' })}>Info</Button>
36 < 2         <Button size="sm" variant="quiet" onClick={() => toast('Note deleted', { action: { label: 'Undo', onClick: () => toast.success('Restored') } })}>With action</Button>
37 < 2       </Row>
38 < 2     ) },
39 < 2   { id: 'default-open', render: () => <ToasterOpen variant="default" /> },
40 < 2   { id: 'success-open', render: () => <ToasterOpen variant="success" /> },
41 < 2   { id: 'error-open', render: () => <ToasterOpen variant="error" /> },
42 < 2   { id: 'warning-open', render: () => <ToasterOpen variant="warning" /> },
43 < 2   { id: 'info-open', render: () => <ToasterOpen variant="info" /> },
44 < 2 ]
45 < 2 