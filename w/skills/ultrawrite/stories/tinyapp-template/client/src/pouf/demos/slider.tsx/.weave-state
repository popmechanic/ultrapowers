0 < 2 import { useState } from 'react'
1 < 2 import { Slider } from '../slider'
2 < 2 import { Stack } from '../layout'
3 < 2 import { Text } from '../text'
4 < 2 import type { Demo } from './types'
5 < 2 
6 < 2 function InteractiveSlider({
7 < 2   initial,
8 < 2   label,
9 < 2   subject = false,
10 < 2 }: {
11 < 2   initial: number[]
12 < 2   label: string
13 < 2   subject?: boolean
14 < 2 }) {
15 < 2   const [value, setValue] = useState(initial)
16 < 2   const shown = value.length === 1 ? `${value[0]}%` : `${value[0]}–${value[1]}%`
17 < 2   const content = (
18 < 2     <Stack gap={2}>
19 < 2       <Text size="sm" muted>{label}: {shown}</Text>
20 < 2       <Slider value={value} onChange={setValue} label={label} />
21 < 2     </Stack>
22 < 2   )
23 < 2   return subject ? <span data-subject style={{ display: 'block', width: '100%' }}>{content}</span> : content
24 < 2 }
25 < 2 
26 < 2 export const sliderDemos: Demo[] = [
27 < 2   { id: 'single', states: ['hover', 'focus'], render: () => (
28 < 2       <InteractiveSlider initial={[40]} label="Volume" subject />
29 < 2     ) },
30 < 2   { id: 'range', render: () => <InteractiveSlider initial={[20, 80]} label="Price range" /> },
31 < 2   { id: 'disabled', render: () => <Slider value={[50]} onChange={() => {}} disabled label="Disabled" /> },
32 < 2 ]
33 < 2 