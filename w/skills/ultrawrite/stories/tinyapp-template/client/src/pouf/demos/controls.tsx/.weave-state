190 < 2             <RowCard onClick={() => {}}><Text>Banana</Text></RowCard>
191 < 2           </Stack>
192 < 2         </Dialog>
193 < 2       </span>
194 < 2     ) },
195 < 2   { id: 'open', render: () => (
196 < 2       <Dialog
197 < 2         open
198 < 2         onOpenChange={() => {}}
199 < 2         trigger={<Button tone="blue" size="sm">Open dialog</Button>}
200 < 2         title="Pick a fruit"
201 < 2         description="Dismisses on outside click — nothing here is destructive."
202 < 2       >
203 < 2         <Stack gap={2}>
204 < 2           <RowCard onClick={() => {}}><Text>Apple</Text></RowCard>
205 < 2           <RowCard onClick={() => {}}><Text>Banana</Text></RowCard>
206 < 2         </Stack>
207 < 2       </Dialog>
208 < 2     ) },
209 < 2   { id: 'large', render: () => (
