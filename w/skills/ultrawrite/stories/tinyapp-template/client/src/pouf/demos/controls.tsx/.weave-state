222 < 2 /* -------------------------------------------------------------- Combobox */
223 < 2 
224 < 2 const timezoneOptions = ['America/New_York', 'Europe/London', 'Asia/Tokyo', 'Australia/Sydney']
225 < 2 
226 < 2 function InteractiveCombobox({
227 < 2   initial,
228 < 2   options = timezoneOptions,
229 < 2   subject = false,
230 < 2 }: {
231 < 2   initial: string
232 < 2   options?: string[]
233 < 2   subject?: boolean
234 < 2 }) {
235 < 2   const [value, setValue] = useState(initial)
236 < 2   const field = (
237 < 2     <Field label={options.length ? 'Timezone' : 'Custom zone (no list offered)'}>
238 < 2       {(id, d) => (
239 < 2         <Combobox
240 < 2           id={id}
241 < 2           describedBy={d}
242 < 2           value={value}
243 < 2           onChange={setValue}
244 < 2           options={options}
245 < 2           error={options.length ? undefined : 'No presets — type an IANA name.'}
246 < 2           mono
247 < 2           placeholder={options.length ? 'Search a timezone…' : 'e.g. Europe/Paris…'}
248 < 2         />
249 < 2       )}
250 < 2     </Field>
251 < 2   )
252 < 2   return subject ? <span data-subject>{field}</span> : field
253 < 2 }
254 < 2 
255 < 2 function ComboboxOpen() {
256 < 2   const ref = useRef<HTMLDivElement>(null)
257 < 2   useEffect(() => { simulateOpen(ref.current?.querySelector('button')) }, [])
258 < 2   return (
259 < 2     <div ref={ref}>
260 < 2       <Field label="Timezone">
261 < 2         {(id, d) => (
262 < 2           <Combobox id={id} describedBy={d} value="America/New_York" onChange={() => {}} options={timezoneOptions} mono placeholder="Search a timezone…" />
263 < 2         )}
264 < 2       </Field>
265 < 2     </div>
266 < 2   )
267 < 2 }
268 < 2 
269 < 2 export const comboboxDemos: Demo[] = [
270 < 2   { id: 'default', states: ['hover', 'focus'], render: () => <InteractiveCombobox initial="America/New_York" subject /> },
271 < 2   // The empty-list case is the contract, not a degradation: a field that offers
272 < 2   // no preset list must still let you type a value.
273 < 2   { id: 'no-options', render: () => <InteractiveCombobox initial="" options={[]} /> },
274 < 2   { id: 'open', render: () => <ComboboxOpen /> },
275 < 2 ]
276 < 2 