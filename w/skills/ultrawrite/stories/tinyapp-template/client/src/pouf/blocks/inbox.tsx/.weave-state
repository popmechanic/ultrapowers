0 < 2 import { useMemo, useState } from 'react'
1 < 2 import clsx from 'clsx'
2 < 2 import { Card, RowCard } from '../surface'
3 < 2 import { Shell, Sidebar, Stack, Row, Spacer } from '../layout'
4 < 2 import { Heading, Text, Eyebrow } from '../text'
5 < 2 import { Avatar } from '../avatar'
6 < 2 import { Badge, Blob, Dot } from '../media'
7 < 2 import { Button } from '../Button'
8 < 2 import { Icon } from '../Icon'
9 < 2 import { Input, Textarea } from '../Input'
10 < 2 import { Empty } from '../feedback'
11 < 2 import { NavLink } from '../NavLink'
12 < 2 import { BottomNav, type NavItem } from '../BottomNav'
13 < 2 
14 < 2 const NAV: NavItem[] = [
15 < 2   { href: '/', label: 'Overview', icon: 'overview', tone: 'purple' },
16 < 2   { href: '/inbox', label: 'Inbox', icon: 'mail', tone: 'blue' },
17 < 2   { href: '/board', label: 'Board', icon: 'log', tone: 'mint' },
18 < 2   { href: '/messages', label: 'Messages', icon: 'comment', tone: 'pink' },
19 < 2   { href: '/settings', label: 'Settings', icon: 'settings', tone: 'orange' },
20 < 2 ]
21 < 2 
22 < 2 const HERE = '/inbox'
23 < 2 
24 < 2 interface Mail {
25 < 2   id: string
26 < 2   from: string
27 < 2   subject: string
28 < 2   preview: string
29 < 2   body: string
30 < 2   time: string
31 < 2   tone: 'purple' | 'pink' | 'blue' | 'mint'
32 < 2   unread: boolean
33 < 2 }
34 < 2 
35 < 2 const MAIL: Mail[] = [
36 < 2   { id: '1', from: 'Maya Bloom', subject: 'The cushion buttons shipped', preview: 'Just merged — depth really does sell it.', body: 'Just merged — depth really does sell it. Take a look when you get a sec.', time: '9:41', tone: 'mint', unread: true },
37 < 2   { id: '2', from: 'Grace Hopper', subject: 'Migration is green', preview: 'Zero visual drift across 2,700 lines.', body: 'Zero visual drift across 2,700 lines. The snapshot gate paid off.', time: '8:12', tone: 'blue', unread: true },
38 < 2   { id: '3', from: 'Katherine J.', subject: 'Optical centering notes', preview: 'Attached the write-up.', body: 'Attached the write-up on why a centered glyph looks low on a cushion.', time: 'Yesterday', tone: 'pink', unread: false },
39 < 2   { id: '4', from: 'Alan Turing', subject: 'Variants over classNames', preview: 'A short argument for the strict API.', body: 'A short argument for why the strict API keeps everything on-system.', time: 'Yesterday', tone: 'purple', unread: false },
40 < 2 ]
41 < 2 
42 < 2 const PANES =
43 < 2   'grid [grid-template-columns:minmax(0,320px)_minmax(0,1fr)] min-h-[520px] max-[900px]:[grid-template-columns:minmax(0,1fr)]'
44 < 2 
45 < 2 /** An example email inbox: app shell, a mail list you can actually search, and
46 < 2  * a reading pane that replies. Below 900px the two panes become one — the list,
47 < 2  * then the message — because side-by-side at phone width reads neither. */
48 < 2 export function InboxBlock() {
49 < 2   const [active, setActive] = useState('1')
50 < 2   const [query, setQuery] = useState('')
51 < 2   const [read, setRead] = useState<string[]>([])
52 < 2   const [replying, setReplying] = useState(false)
53 < 2   const [draft, setDraft] = useState('')
54 < 2   const [sent, setSent] = useState<string[]>([])
55 < 2   /* Only consulted below 900px, where exactly one pane shows at a time. Above
56 < 2    * it both panes are always visible and this is inert. */
57 < 2   const [pane, setPane] = useState<'list' | 'detail'>('list')
58 < 2 
59 < 2   const results = useMemo(() => {
60 < 2     const q = query.trim().toLowerCase()
61 < 2     if (!q) return MAIL
62 < 2     return MAIL.filter((m) =>
63 < 2       `${m.from} ${m.subject} ${m.body}`.toLowerCase().includes(q),
64 < 2     )
65 < 2   }, [query])
66 < 2 
67 < 2   const current = MAIL.find((m) => m.id === active) ?? MAIL[0]!
68 < 2   const unreadCount = MAIL.filter((m) => m.unread && !read.includes(m.id)).length
69 < 2 
70 < 2   function open(id: string) {
71 < 2     setActive(id)
72 < 2     setRead((r) => (r.includes(id) ? r : [...r, id]))
73 < 2     setReplying(false)
74 < 2     setDraft('')
75 < 2     setPane('detail')
76 < 2   }
77 < 2 
78 < 2   function send() {
79 < 2     if (!draft.trim()) return
80 < 2     setSent((s) => [...s, draft.trim()])
81 < 2     setDraft('')
82 < 2     setReplying(false)
83 < 2   }
84 < 2 
85 < 2   return (
86 < 2     <>
87 < 2       <Shell>
88 < 2         <Sidebar mobile="hide">
89 < 2           <Row gap={2} wrap={false}>
90 < 2             <Blob icon="target" tone="purple" size="sm" />
91 < 2             <Heading level={3}>Acme</Heading>
92 < 2           </Row>
93 < 2           {NAV.map((item) => (
94 < 2             <NavLink key={item.href} href={item.href} currentPath={HERE} icon={item.icon} tone={item.tone}>
95 < 2               {item.label}
96 < 2             </NavLink>
97 < 2           ))}
98 < 2         </Sidebar>
99 < 2 
100 < 2         <Stack gap={5}>
101 < 2           <Row justify="between">
102 < 2             <Stack gap={1}>
103 < 2               <Eyebrow>Mail</Eyebrow>
104 < 2               <Heading level={1}>Inbox</Heading>
105 < 2             </Stack>
106 < 2             {unreadCount > 0 && <Badge tone="pink">{unreadCount} unread</Badge>}
107 < 2           </Row>
108 < 2 
109 < 2           <Card variant="flush">
110 < 2             <div className={PANES}>
111 < 2               {/* List pane */}
112 < 2               <div
113 < 2                 className={clsx(
114 < 2                   'flex flex-col [border-right:1px_solid_rgba(201,168,255,0.3)]',
115 < 2                   'max-[900px]:[border-right:none]',
116 < 2                   pane === 'detail' && 'max-[900px]:hidden',
117 < 2                 )}
118 < 2               >
119 < 2                 <div className="p-(--s5) pb-(--s3)">
120 < 2                   <Input
121 < 2                     value={query}
122 < 2                     onChange={setQuery}
123 < 2                     placeholder="Search mail…"
124 < 2                     label="Search mail"
125 < 2                   />
126 < 2                 </div>
127 < 2                 <div className="flex flex-col gap-(--s2) px-(--s3) pb-(--s3)">
128 < 2                   {results.length === 0 ? (
129 < 2                     <div className="p-(--s4)">
130 < 2                       <Empty icon="search" title="No matches">
131 < 2                         <Text size="sm" muted>Nothing here matches “{query}”.</Text>
132 < 2                       </Empty>
133 < 2                     </div>
134 < 2                   ) : (
135 < 2                     results.map((m) => (
136 < 2                       <RowCard key={m.id} onClick={() => open(m.id)} selected={m.id === active}>
137 < 2                         <Row gap={3} wrap={false}>
138 < 2                           <Avatar fallback={m.from.slice(0, 2)} tone={m.tone} />
139 < 2                           <Stack gap={1}>
140 < 2                             <Row gap={2} wrap={false}>
141 < 2                               <Text truncate>{m.from}</Text>
142 < 2                               {m.unread && !read.includes(m.id) && <Dot tone="pink" />}
143 < 2                             </Row>
144 < 2                             <Text size="sm" truncate>{m.subject}</Text>
145 < 2                           </Stack>
146 < 2                           <Spacer />
147 < 2                           <Text size="sm" muted>{m.time}</Text>
148 < 2                         </Row>
149 < 2                       </RowCard>
150 < 2                     ))
151 < 2                   )}
152 < 2                 </div>
153 < 2               </div>
154 < 2 
155 < 2               {/* Reading pane */}
156 < 2               <div
157 < 2                 className={clsx(
158 < 2                   'flex flex-col min-w-0',
159 < 2                   pane === 'list' && 'max-[900px]:hidden',
160 < 2                 )}
161 < 2               >
162 < 2                 <div className="p-(--s5) [border-bottom:1px_solid_rgba(201,168,255,0.3)]">
163 < 2                   <Row justify="between">
164 < 2                     <Row gap={2} wrap={false}>
165 < 2                       {/* Phone-only: the list is gone, so this is the way back. */}
166 < 2                       <span className="hidden max-[900px]:inline-flex">
167 < 2                         <Button size="sm" variant="quiet" onClick={() => setPane('list')} label="Back to list">
168 < 2                           <Icon name="prev" size="sm" />
169 < 2                         </Button>
170 < 2                       </span>
171 < 2                       <Heading level={3}>{current.subject}</Heading>
172 < 2                     </Row>
173 < 2                     <Row gap={2} wrap={false}>
174 < 2                       <Button size="sm" variant="quiet" label="Archive"><Icon name="ok" size="sm" /></Button>
175 < 2                       <Button size="sm" variant="quiet" label="Delete"><Icon name="remove" size="sm" /></Button>
176 < 2                     </Row>
177 < 2                   </Row>
178 < 2                 </div>
179 < 2                 <div className="p-(--s5) flex-1">
180 < 2                   <Stack gap={4}>
181 < 2                     <Row gap={3} wrap={false}>
182 < 2                       <Avatar fallback={current.from.slice(0, 2)} tone={current.tone} />
183 < 2                       <Stack gap={1}>
184 < 2                         <Text>{current.from}</Text>
185 < 2                         <Text size="sm" muted>to me · {current.time}</Text>
186 < 2                       </Stack>
187 < 2                     </Row>
188 < 2                     <Text>{current.body}</Text>
189 < 2                     <Text muted>Let me know what you think — happy to walk through it on a call.</Text>
190 < 2 
191 < 2                     {sent.map((s, i) => (
192 < 2                       <div key={i} className="[border-left:3px_solid_var(--mint)] pl-(--s4)">
193 < 2                         <Stack gap={1}>
194 < 2                           <Text size="sm" muted>You replied</Text>
195 < 2                           <Text>{s}</Text>
196 < 2                         </Stack>
197 < 2                       </div>
198 < 2                     ))}
199 < 2 
200 < 2                     {replying ? (
201 < 2                       <Stack gap={3}>
202 < 2                         <Textarea
203 < 2                           value={draft}
204 < 2                           onChange={setDraft}
205 < 2                           placeholder={`Reply to ${current.from}…`}
206 < 2                           label="Your reply"
207 < 2                         />
208 < 2                         <Row gap={2}>
209 < 2                           <Button onClick={send} tone="mint" label="Send reply">
210 < 2                             <Icon name="send" size="sm" /> Send
211 < 2                           </Button>
212 < 2                           <Button variant="quiet" onClick={() => { setReplying(false); setDraft('') }}>
213 < 2                             Cancel
214 < 2                           </Button>
215 < 2                         </Row>
216 < 2                       </Stack>
217 < 2                     ) : (
218 < 2                       <Row gap={2}>
219 < 2                         <Button onClick={() => setReplying(true)} label="Reply">
220 < 2                           <Icon name="rewind" size="sm" /> Reply
221 < 2                         </Button>
222 < 2                         <Button variant="quiet" label="Forward">
223 < 2                           <Icon name="forward" size="sm" /> Forward
224 < 2                         </Button>
225 < 2                       </Row>
226 < 2                     )}
227 < 2                   </Stack>
228 < 2                 </div>
229 < 2               </div>
230 < 2             </div>
231 < 2           </Card>
232 < 2           <Spacer />
233 < 2         </Stack>
234 < 2       </Shell>
235 < 2       <BottomNav primary={NAV.slice(0, 4)} groups={[{ title: 'App', items: NAV }]} currentPath={HERE} />
236 < 2     </>
237 < 2   )
238 < 2 }
239 < 2 