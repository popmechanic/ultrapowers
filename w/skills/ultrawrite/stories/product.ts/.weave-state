0 < 1 #!/usr/bin/env bun
1 < 2 // The product record: what the app is for, what the operator said and what
2 < 2 // the author assumed, every concept a successful version needs, and the order
3 < 2 // the plans build them in. It lives in the bundle while a plan is authored and
4 < 2 // in the target app (stories/product.json) after compile. product.md is its
5 < 2 // rendering in the operator's words; it is never written by hand.
6 < 2 //
7 < 2 //   bun skills/ultrawrite/stories/product.ts check <product.json>
8 < 2 //   bun skills/ultrawrite/stories/product.ts render <product.json> [--bundle <dir>] --out <product.md>
9 < 2 //   bun skills/ultrawrite/stories/product.ts record <product.json>
10 < 1 import {readFileSync, writeFileSync} from 'node:fs';
11 < 1 import {join} from 'node:path';
12 < 1 import {parseArgs} from 'node:util';
13 < 1 import {KINDS, type Page} from './bundle';
14 < 1 
15 < 1 export type Assumption = {text: string; about: 'product' | 'technical'; state: 'decided' | 'open'; by: 'author' | 'operator'};
16 < 1 export type Concept = {id: string; purpose: string; part: string; status: 'keep' | 'defer' | 'cut'; relies_on: string[]};
17 < 1 export type Subproject = {
18 < 1   id: string; title: string; reason: string; concepts: string[]; depends_on: string[];
19 < 1   status: 'next' | 'planned' | 'built'; plan?: string; history?: string[];
20 < 1 };
21 < 1 export type Reading = {
22 < 1   stage: string; question: string; subject: string; noul: number | null; flagged: boolean;
23 < 1   operator_pick: string | null; date: string;
24 < 1 };
25 < 1 export type Product = {
26 < 1   version: 'product-v1';
27 < 1   intent: {name: string; kind: string; audience: string[]; summary: string[]; success: string[]};
28 < 1   understanding: {ask: string; said: string[]; assumed: Assumption[]; unsure: string[]};
29 < 1   concepts: Concept[];
30 < 1   subprojects: Subproject[];
31 < 1   readings: Reading[];
32 < 1 };
33 < 1 
34 < 1 const TOP = ['version', 'intent', 'understanding', 'concepts', 'subprojects', 'readings'];
35 < 1 const isStr = (v: unknown) => typeof v === 'string' && v.trim() !== '';
36 < 1 const strs = (v: unknown) => Array.isArray(v) && v.every(isStr);
37 < 1 const extra = (o: object, keys: string[]) => Object.keys(o).filter((k) => !keys.includes(k));
38 < 1 const list = (v: unknown): string[] => (Array.isArray(v) ? v.filter((x) => typeof x === 'string') : []);
39 < 1 const isObj = (v: unknown) => !!v && typeof v === 'object' && !Array.isArray(v);
40 < 1 
41 < 1 function cycle(ids: string[], edges: (id: string) => string[]): string | null {
42 < 1   const state = new Map<string, number>();
43 < 1   const visit = (id: string, path: string[]): string | null => {
44 < 1     if (state.get(id) === 2) return null;
45 < 1     if (state.get(id) === 1) return [...path, id].join(' → ');
46 < 1     state.set(id, 1);
47 < 1     for (const n of edges(id)) {
48 < 1       const c = visit(n, [...path, id]);
49 < 1       if (c) return c;
50 < 1     }
51 < 1     state.set(id, 2);
52 < 1     return null;
53 < 1   };
54 < 1   for (const id of ids) {
55 < 1     const c = visit(id, []);
56 < 1     if (c) return c;
57 < 1   }
58 < 1   return null;
59 < 1 }
60 < 1 
61 < 2 // Every way `p` leaves product-v1, one plain sentence each; [] when valid.
62 < 1 export function checkProduct(p: unknown): string[] {
63 < 1   const errs: string[] = [];
64 < 1   if (!p || typeof p !== 'object') return ['product: must be a JSON object'];
65 < 1   const o = p as Record<string, any>;
66 < 1   for (const k of extra(o, TOP)) errs.push(`product: unknown field ${k}`);
67 < 1   if (o.version !== 'product-v1') errs.push('product: version must be product-v1');
68 < 1 
69 < 1   const i = o.intent ?? {};
70 < 1   for (const k of extra(i, ['name', 'kind', 'audience', 'summary', 'success'])) errs.push(`intent: unknown field ${k}`);
71 < 1   if (!isStr(i.name)) errs.push('intent: name must be the product\'s name');
72 < 1   if (!KINDS.includes(i.kind)) errs.push('intent: kind must be behaviour or preserve');
73 < 1   if (!strs(i.audience) || !i.audience.length) errs.push('intent: audience must name who uses it');
74 < 1   if (!strs(i.summary) || i.summary.length !== 3) errs.push('intent: summary must be three sentences');
75 < 1   if (!strs(i.success) || !i.success.length) errs.push('intent: success must say what would make it a success');
76 < 1 
77 < 1   const u = o.understanding ?? {};
78 < 1   for (const k of extra(u, ['ask', 'said', 'assumed', 'unsure'])) errs.push(`understanding: unknown field ${k}`);
79 < 1   if (!isStr(u.ask)) errs.push('understanding: ask must be the raw ask, verbatim');
80 < 1   if (!strs(u.said)) errs.push('understanding: said must be a list of sentences');
81 < 1   if (!strs(u.unsure)) errs.push('understanding: unsure must be a list of sentences');
82 < 1   if (!Array.isArray(u.assumed)) errs.push('understanding: assumed must be a list');
83 < 1   for (const [n, a] of (Array.isArray(u.assumed) ? u.assumed : []).entries()) {
84 < 1     const at = `understanding: assumption ${n + 1}`;
85 < 1     if (!a || typeof a !== 'object') { errs.push(`${at} must be an object`); continue; }
86 < 1     for (const k of extra(a, ['text', 'about', 'state', 'by'])) errs.push(`${at}: unknown field ${k}`);
87 < 1     if (!isStr(a.text)) errs.push(`${at}: text is missing`);
88 < 1     if (!['product', 'technical'].includes(a.about)) errs.push(`${at}: about must be product or technical`);
89 < 1     if (!['decided', 'open'].includes(a.state)) errs.push(`${at}: state must be decided or open`);
90 < 1     if (!['author', 'operator'].includes(a.by)) errs.push(`${at}: by must be author or operator`);
91 < 1   }
92 < 1 
93 < 1   const concepts: any[] = (Array.isArray(o.concepts) ? o.concepts : []).filter((c: unknown, n: number) => {
94 < 1     if (!isObj(c)) errs.push(`concept ${n + 1}: must be an object`);
95 < 1     return isObj(c);
96 < 1   });
97 < 1   if (!Array.isArray(o.concepts)) errs.push('product: concepts must be a list');
98 < 1   const cids = new Set<string>();
99 < 1   for (const c of concepts) {
100 < 1     const at = `concept ${c?.id ?? '?'}`;
101 < 1     for (const k of extra(c ?? {}, ['id', 'purpose', 'part', 'status', 'relies_on'])) errs.push(`${at}: unknown field ${k}`);
102 < 1     if (!isStr(c?.id)) errs.push('concept: every concept needs an id');
103 < 1     else if (cids.has(c.id)) errs.push(`${at}: the id is used twice`);
104 < 1     else cids.add(c.id);
105 < 1     if (!isStr(c?.purpose)) errs.push(`${at}: purpose is missing`);
106 < 1     if (!isStr(c?.part)) errs.push(`${at}: part is missing`);
107 < 1     if (!['keep', 'defer', 'cut'].includes(c?.status)) errs.push(`${at}: status must be keep, defer or cut`);
108 < 1     if (!strs(c?.relies_on ?? null)) errs.push(`${at}: relies_on must be a list of concept ids`);
109 < 1   }
110 < 1   for (const c of concepts) for (const r of list(c.relies_on)) if (!cids.has(r)) errs.push(`concept ${c.id}: relies on ${r}, which is no concept`);
111 < 1   const byId = new Map(concepts.map((c) => [c.id, c]));
112 < 1   const cc = cycle([...cids], (id) => list(byId.get(id)?.relies_on));
113 < 1   if (cc) errs.push(`concepts rely on each other in a circle: ${cc}`);
114 < 1 
115 < 1   const subs: any[] = (Array.isArray(o.subprojects) ? o.subprojects : []).filter((x: unknown, n: number) => {
116 < 1     if (!isObj(x)) errs.push(`plan ${n + 1}: must be an object`);
117 < 1     return isObj(x);
118 < 1   });
119 < 1   if (!Array.isArray(o.subprojects)) errs.push('product: subprojects must be a list');
120 < 1   const sids = new Set<string>();
121 < 1   const home = new Map<string, string[]>();
122 < 1   for (const s of subs) {
123 < 1     const at = `plan ${s?.id ?? '?'}`;
124 < 1     for (const k of extra(s ?? {}, ['id', 'title', 'reason', 'concepts', 'depends_on', 'status', 'plan', 'history'])) errs.push(`${at}: unknown field ${k}`);
125 < 1     if (!isStr(s?.id)) errs.push('plan: every plan needs an id');
126 < 1     else if (sids.has(s.id)) errs.push(`${at}: the id is used twice`);
127 < 1     else sids.add(s.id);
128 < 1     if (!isStr(s?.title)) errs.push(`${at}: title is missing`);
129 < 1     if (!isStr(s?.reason)) errs.push(`${at}: reason (why it comes in this order) is missing`);
130 < 1     if (!strs(s?.concepts ?? null) || !(s?.concepts ?? []).length) errs.push(`${at}: concepts must list what it builds`);
131 < 1     if (!strs(s?.depends_on ?? null)) errs.push(`${at}: depends_on must be a list of plan ids`);
132 < 1     if (!['next', 'planned', 'built'].includes(s?.status)) errs.push(`${at}: status must be next, planned or built`);
133 < 1     if (s?.status === 'built' && !isStr(s?.plan)) errs.push(`${at}: a built plan names its plan id`);
134 < 1     if (s?.history !== undefined && !strs(s.history)) errs.push(`${at}: history must be a list of plan ids`);
135 < 1     for (const c of list(s?.concepts)) {
136 < 1       if (!cids.has(c)) errs.push(`${at}: builds ${c}, which is no concept`);
137 < 1       else if (byId.get(c).status !== 'keep') errs.push(`${at}: builds ${c}, which is not kept for the first version`);
138 < 1       home.set(c, [...(home.get(c) ?? []), s.id]);
139 < 1     }
140 < 1   }
141 < 1   for (const s of subs) for (const d of list(s.depends_on)) if (!sids.has(d)) errs.push(`plan ${s.id}: depends on ${d}, which is no plan`);
142 < 1   const sById = new Map(subs.map((s) => [s.id, s]));
143 < 1   const sc = cycle([...sids], (id) => list(sById.get(id)?.depends_on));
144 < 1   if (sc) errs.push(`plans depend on each other in a circle: ${sc}`);
145 < 1   for (const c of concepts) {
146 < 1     if (c?.status !== 'keep') continue;
147 < 1     const h = home.get(c.id) ?? [];
148 < 1     if (h.length === 0 && subs.length) errs.push(`concept ${c.id}: kept, but no plan builds it`);
149 < 1     if (h.length > 1) errs.push(`concept ${c.id}: built by more than one plan (${h.join(', ')})`);
150 < 1   }
151 < 1   if (subs.filter((s) => s?.status === 'next').length > 1) errs.push('plans: only one plan can be next');
152 < 1 
153 < 1   if (!Array.isArray(o.readings)) errs.push('product: readings must be a list');
154 < 1   for (const r of Array.isArray(o.readings) ? o.readings : []) {
155 < 1     const k = extra(r ?? {}, ['stage', 'question', 'subject', 'noul', 'flagged', 'operator_pick', 'date']);
156 < 1     if (k.length) errs.push(`reading ${r?.question ?? '?'}: unknown field ${k.join(', ')}`);
157 < 1   }
158 < 1   return errs;
159 < 1 }
160 < 1 
161 < 1 export function loadProduct(path: string): Product {
162 < 1   return JSON.parse(readFileSync(path, 'utf8'));
163 < 1 }
164 < 1 
165 < 1 export function saveProduct(path: string, p: Product): void {
166 < 1   writeFileSync(path, JSON.stringify(p, null, 1) + '\n');
167 < 1 }
168 < 1 
169 < 1 const SAY = {keep: 'First version', defer: 'Later', cut: 'Not doing'} as const;
170 < 1 
171 < 2 // product.md: the product in the operator's words. No ids, statuses, kinds or scores.
172 < 1 export function renderProduct(p: Product, page?: Page & {subproject?: string}): string {
173 < 1   const out = [`# ${p.intent.name}`, '', p.intent.summary.join(' '), '',
174 < 1     `**Who uses it:** ${p.intent.audience.join(', ')}`, '', '**It succeeds when:**',
175 < 1     ...p.intent.success.map((s) => `- ${s}`), '', '## What it does', ''];
176 < 1   const parts = [...new Set(p.concepts.map((c) => c.part))];
177 < 1   for (const part of parts) {
178 < 1     out.push(`### ${part}`, '');
179 < 1     for (const st of ['keep', 'defer', 'cut'] as const) {
180 < 1       const cs = p.concepts.filter((c) => c.part === part && c.status === st);
181 < 1       if (cs.length) out.push(`**${SAY[st]}:**`, ...cs.map((c) => `- ${c.purpose}`), '');
182 < 1     }
183 < 1   }
184 < 1   if (p.subprojects.length) {
185 < 1     out.push('## The order we build it in', '');
186 < 1     p.subprojects.forEach((s, i) => {
187 < 1       const mark = page?.subproject === s.id ? ' **(this plan)**' : s.status === 'built' ? ' (built)' : '';
188 < 1       out.push(`${i + 1}. **${s.title}**${mark}: ${s.reason}`);
189 < 1     });
190 < 1     out.push('');
191 < 1   }
192 < 1   if (page?.subproject) {
193 < 1     const s = p.subprojects.find((x) => x.id === page.subproject);
194 < 1     out.push(`## This plan: ${s?.title ?? page.title}`, '', '### What you will be able to do', '');
195 < 1     page.stories.forEach((st, i) => out.push(`${i + 1}. ${st.sentence}`));
196 < 1     if (page.links?.length) out.push('', '### What goes together', '', ...page.links.map((l) => `- ${l.sentence}`));
197 < 1     out.push('');
198 < 1   }
199 < 1   return out.join('\n');
200 < 1 }
201 < 1 
202 < 2 // Fill operator_pick on readings that have none, from the product's final
203 < 2 // state: a concept's status, an assumption's state. Returns how many it filled.
204 < 1 export function recordPicks(p: Product): number {
205 < 1   let n = 0;
206 < 1   for (const r of p.readings) {
207 < 1     if (r.operator_pick !== null) continue;
208 < 1     if (r.stage === 'map') {
209 < 1       const c = p.concepts.find((x) => x.id === r.subject);
210 < 1       if (c) { r.operator_pick = c.status; n++; }
211 < 1     } else if (r.question === 'assumption_surprises') {
212 < 1       const a = p.understanding.assumed.find((x) => x.text === r.subject);
213 < 1       if (a) { r.operator_pick = a.by === 'operator' ? 'asked' : 'author-decided'; n++; }
214 < 1     }
215 < 1   }
216 < 1   return n;
217 < 1 }
218 < 1 
219 < 1 function main(argv: string[]): number {
220 < 1   const [cmd, file, ...rest] = argv;
221 < 1   if (!file || !['check', 'render', 'record'].includes(cmd)) {
222 < 1     console.error('usage: product.ts check <product.json> | render <product.json> [--bundle <dir>] --out <product.md> | record <product.json>');
223 < 1     return 2;
224 < 1   }
225 < 1   let p: Product;
226 < 1   try {
227 < 1     p = loadProduct(file);
228 < 1   } catch (e) {
229 < 1     console.log(`product: cannot read ${file}: ${(e as Error).message}`);
230 < 1     return 2;
231 < 1   }
232 < 1   const errs = checkProduct(p);
233 < 1   if (errs.length) {
234 < 1     console.log(errs.join('\n'));
235 < 1     console.log(`${errs.length} problem(s)`);
236 < 1     return 2;
237 < 1   }
238 < 1   if (cmd === 'check') {
239 < 1     console.log(`PRODUCT OK: ${p.concepts.length} concept(s), ${p.subprojects.length} plan(s)`);
240 < 1     return 0;
241 < 1   }
242 < 1   if (cmd === 'record') {
243 < 1     console.log(`RECORDED ${recordPicks(p)} pick(s)`);
244 < 1     saveProduct(file, p);
245 < 1     return 0;
246 < 1   }
247 < 1   const {values: v} = parseArgs({args: rest, options: {bundle: {type: 'string'}, out: {type: 'string'}}});
248 < 1   if (!v.out) {
249 < 1     console.error('usage: product.ts render <product.json> [--bundle <dir>] --out <product.md>');
250 < 1     return 2;
251 < 1   }
252 < 1   const page = v.bundle ? JSON.parse(readFileSync(join(v.bundle, 'page.json'), 'utf8')) : undefined;
253 < 1   writeFileSync(v.out, renderProduct(p, page));
254 < 1   console.log(`RENDERED ${v.out}`);
255 < 1   return 0;
256 < 1 }
257 < 1 
258 < 1 if (import.meta.main) {
259 < 1   let code = 2;
260 < 1   try {
261 < 1     code = main(process.argv.slice(2));
262 < 1   } catch (e) {
263 < 1     console.log(`product: ${(e as Error).message}`);
264 < 1   }
265 < 1   process.exit(code);
266 < 1 }
267 < 1 