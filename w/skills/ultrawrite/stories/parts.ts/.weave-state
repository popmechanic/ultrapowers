0 < 1 // What a TinyApp's screen parts can draw (#1491): each part's line in the app's
1 < 1 // client/src/screens/draws.json names the accessibility role it draws and the props
2 < 1 // that name it. A story that expects to see a role no part draws cannot pass until a
3 < 1 // part is added, so the planning checks say so and the compiler writes it into the
4 < 1 // task that needs it; a builder then adds the part in the open.
5 < 1 import {existsSync, readFileSync} from 'node:fs';
6 < 1 import {join} from 'node:path';
7 < 1 import type {Bundle} from './bundle';
8 < 1 
9 < 1 export const TEMPLATE_DRAWS = join(import.meta.dir, 'tinyapp-template', 'client', 'src', 'screens', 'draws.json');
10 < 1 export const drawsPath = (app: string) => join(app, 'client', 'src', 'screens', 'draws.json');
11 < 1 
12 < 1 export type Draws = Record<string, {role: string | null; name?: string[]}>;
13 < 1 
14 < 1 /** The parts' lines from a draws.json, or null when there is no such file (an app scaffolded before it). */
15 < 1 export function readDraws(file: string): Draws | null {
16 < 1   if (!existsSync(file)) return null;
17 < 1   const j = JSON.parse(readFileSync(file, 'utf8'));
18 < 1   return (j && typeof j === 'object' && j.parts && typeof j.parts === 'object' ? j.parts : {}) as Draws;
19 < 1 }
20 < 1 
21 < 1 /** Every role some part draws. */
22 < 1 export const drawnRoles = (d: Draws) => new Set(Object.values(d).map((p) => p?.role).filter((r): r is string => typeof r === 'string'));
23 < 1 
24 < 1 /** The roles a list of `see` entries expects, in first-seen order. */
25 < 1 export const rolesSeen = (sees: {role: string; count?: number}[]) => [...new Set(sees.filter((s) => (s.count ?? 1) > 0).map((s) => s.role))];
26 < 1 
27 < 1 /** Each role the stories expect that no part draws, with the stories expecting it and one name they expect. */
28 < 1 export function undrawn(b: Bundle, d: Draws): {role: string; stories: string[]; name: string}[] {
29 < 1   const roles = drawnRoles(d);
30 < 1   const out: {role: string; stories: string[]; name: string}[] = [];
31 < 1   for (const s of b.page.stories)
32 < 1     for (const st of s.steps)
33 < 1       for (const see of st.see ?? []) {
34 < 1         if (!((see.count ?? 1) > 0) || roles.has(see.role)) continue;
35 < 1         const r = out.find((x) => x.role === see.role) ?? (out.push({role: see.role, stories: [], name: see.name}), out[out.length - 1]);
36 < 1         if (!r.stories.includes(s.id)) r.stories.push(s.id);
37 < 1       }
38 < 1   return out;
39 < 1 }
40 < 1 