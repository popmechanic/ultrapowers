44 < 2 // Sample data: every step whose tool takes no row, once each, in story order.
45 < 1 function fill(s: unknown) {
46 < 1   const seen = new Set<string>();
47 < 1   for (const story of bundle.stories ?? []) {
48 < 1     for (const step of story.steps ?? []) {
49 < 1       const tool = list.find((t) => t.name === step.tool);
50 < 1       if (!tool || takesRow(tool)) continue;
51 < 1       const key = JSON.stringify([step.tool, step.args ?? {}]);
52 < 1       if (seen.has(key)) continue;
53 < 1       seen.add(key);
55 > 1       try { tool.run(s, step.args ?? {}, null); } catch {}
54 < 2       try { tool.run(s, step.args ?? {}, null); } catch { /* a refused step changes nothing */ }
55 < 1     }
56 < 1   }
57 < 1 }
58 < 1 fill(store);
59 < 1 
60 < 2 // On /compare each version gets its own store, filled the same way, so
61 < 2 // acting in one version leaves the others' rows alone.
62 < 1 const viewer = () => ({staff: true, who: null});
63 < 1 const sandboxes = new Map<string, {state: ReturnType<typeof tinybaseState>; tools: ReturnType<typeof bind>}>();
64 < 1 function sandbox(key: string) {
65 < 1   let box = sandboxes.get(key);
66 < 1   if (!box) {
67 < 1     const s = createMergeableStore().setTablesSchema(schema);
68 < 1     fill(s);
69 < 1     box = {state: tinybaseState(s, viewer), tools: bind(s)};
70 < 1     sandboxes.set(key, box);
71 < 1   }
72 < 1   return box;
73 < 1 }
74 < 1 
75 < 1 const compare = location.pathname.replace(/\/+$/, '') === '/compare';
76 < 1 const asked = new URLSearchParams(location.search).get('v');
77 < 1 const letters = (p: Piece) => Object.keys(p.versions ?? {}).sort();
78 < 1 
79 < 1 async function playOne(id: string) {
80 < 1   const story = (bundle.stories ?? []).find((s) => s.id === id);
81 < 1   const report = story
84 > 1     ? await inTurn(() => play(story, store, tools, schemas)).catch((e: unknown) => ({ok: false, misses: [`play failed: ${(e as Error).message}`]}))
83 > 2     ? await inTurn(() => play(story, store, tools)).catch((e: unknown) => ({ok: false, misses: [`play failed: ${(e as Error).message}`]}))
82 < 2     ? await play(story, store, tools).catch((e: unknown) => ({ok: false, misses: [`play failed: ${(e as Error).message}`]}))
83 < 1     : {ok: false, misses: [`no story ${id}`]};
84 < 1   await fetch('/played', {method: 'POST', headers: {'content-type': 'application/json'}, body: JSON.stringify({story: id, ok: report.ok, misses: report.misses})});
85 < 1 }
86 < 1 
89 > 1 function choose(v: string) {
90 < 1   void fetch('/feedback', {method: 'POST', headers: {'content-type': 'application/json'}, body: JSON.stringify({kind: 'pick', piece: 'screen', chose: v})});
88 > 2 function choose(piece: string, v: string) {
89 < 2   void fetch('/feedback', {method: 'POST', headers: {'content-type': 'application/json'}, body: JSON.stringify({kind: 'pick', piece, chose: v})});
87 < 2 function choose(v: string) {
88 < 2   void fetch('/feedback', {method: 'POST', headers: {'content-type': 'application/json'}, body: JSON.stringify({kind: 'pick', chose: v})});
89 < 1 }
