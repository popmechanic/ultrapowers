132 < 1                 >{chosen ? 'Chosen ✓' : `Choose ${v}`}</button>
133 < 1               </div>
134 < 1               <JSONUIProvider registry={registry} store={box.state} handlers={box.tools} functions={functions}>
135 < 1                 <Renderer spec={screen.versions[v]} registry={registry} />
136 < 1               </JSONUIProvider>
137 < 1             </section>
138 < 1           );
139 < 1         })}
140 < 1       </div>
118 < 2       <>
119 < 2         {Object.entries(pieces).map(([name, p]) => (
120 < 2           <div key={name} className="preview-compare" data-compare={name}>
121 < 2             {letters(p).map((v) => {
122 < 2               const chosen = (picked[name] ?? recorded(p)) === v;
123 < 2               const box = sandbox(`${name}\u0000${v}`);
124 < 2               return (
125 < 2                 <section key={v} data-piece={name} data-version={v} data-chosen={chosen ? '' : undefined}>
126 < 2                   <div className="preview-version-head">
127 < 2                     <span>{v}</span>
128 < 2                     <button
129 < 2                       type="button"
130 < 2                       className="preview-choose"
131 < 2                       aria-pressed={chosen}
133 > 2                       onClick={() => { setPicked((m) => ({...m, [name]: v})); choose(name, v); }}
132 < 2                       onClick={() => { setPicked((m) => ({...m, [name]: v})); choose(v); }}
133 < 2                     >{chosen ? 'Chosen ✓' : `Choose ${v}`}</button>
134 < 2                   </div>
136 > 2                   <JSONUIProvider registry={registry} store={box.state} handlers={box.tools} functions={functions}>
135 < 2                   <JSONUIProvider registry={registry} store={box.state} handlers={box.tools}>
136 < 2                     <Renderer spec={p.versions[v]} registry={registry} />
137 < 2                   </JSONUIProvider>
138 < 2                 </section>
139 < 2               );
140 < 2             })}
141 < 2           </div>
142 < 2         ))}
143 < 2       </>
144 < 1     );
145 < 1   }
147 > 1   const spec = screen.approved ?? (asked ? screen.versions?.[asked] : undefined) ?? screen.versions?.A;
146 < 1   return (
147 < 1     <div className="preview-single">
149 > 1       {spec ? <section data-piece="screen"><Renderer spec={spec} registry={registry} /></section> : null}
148 < 2       {Object.entries(pieces).map(([name, p]) => {
149 < 2         const spec = p.approved ?? (asked ? p.versions?.[asked] : undefined) ?? p.versions?.A;
150 < 2         return spec ? (
