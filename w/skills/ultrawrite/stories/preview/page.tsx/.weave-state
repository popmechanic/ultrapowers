17 < 1 type Tool = {name: string; inputSchema?: {properties?: Record<string, Record<string, unknown>>}; run: (store: unknown, args: Record<string, unknown>, who: string | null) => boolean};
18 < 1 type Piece = {versions: Record<string, Spec>; approved?: Spec};
20 > 1 type Pieces = {screen: Piece};
19 < 2 type Pieces = Record<string, Piece>;
20 < 1 type Story = {id: string; steps: {tool: string; args?: Record<string, unknown>; layer?: string}[]};
21 < 1 
22 < 1 declare global {
23 < 1   interface Window {
24 < 1     __PREVIEW__?: {store: unknown; tools: Record<string, (args: Record<string, unknown>) => boolean>; playing: boolean};
25 < 1   }
26 < 1 }
