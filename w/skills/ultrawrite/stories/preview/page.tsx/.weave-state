28 < 1 const list = TOOLS as unknown as Tool[];
29 < 1 const schema = JSON.parse(makeStore().getTablesSchemaJson());
30 < 1 const bind = (s: unknown) => Object.fromEntries(list.map((t) => [t.name, (args: Record<string, unknown>) => t.run(s, args, null)]));
31 < 1 const store = createMergeableStore().setTablesSchema(schema);
32 < 1 const tools = bind(store);
34 > 1 const schemas = Object.fromEntries(list.map((t) => [t.name, t.inputSchema]));
33 < 1 window.__PREVIEW__ = {store, tools, playing: false};
34 < 1 
35 < 1 const takesRow = (t: Tool | undefined) =>
36 < 1   Object.values(t?.inputSchema?.properties ?? {}).some((p) => p && typeof p === 'object' && 'x-row-of' in p);
37 < 1 
38 < 1 const [bundle, initial] = await Promise.all([
39 < 1   fetch('/bundle').then((r) => r.json() as Promise<{title: string; stories: Story[]}>),
40 < 1   fetch('/specs').then((r) => r.json() as Promise<Pieces>),
41 < 1 ]);
42 < 1 document.title = `${bundle.title} — preview`;
