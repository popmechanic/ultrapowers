91 < 2 // The recorded pick: `arrange.ts --pick` writes the approved screen as a byte
92 < 2 // copy of the chosen version, so equal JSON names it.
93 < 1 const same = (a: unknown, b: unknown) => JSON.stringify(a) === JSON.stringify(b);
94 < 1 const recorded = (p: Piece) => (p.approved ? letters(p).find((v) => same(p.versions[v], p.approved)) : undefined);
95 < 1 
98 > 2 // The pick still standing once `next` replaces `prev`: versions that changed
99 < 2 // were re-arranged, so the earlier click no longer names what is drawn.
100 < 1 const kept = (pick: string | null, prev: Pieces, next: Pieces) =>
101 < 1   same(prev.screen?.versions ?? {}, next.screen?.versions ?? {}) ? pick : null;
97 > 2 // The picks still standing once `next` replaces `prev`: a piece whose versions
98 < 2 // changed was re-arranged, so its earlier click no longer names what is drawn.
99 < 2 const kept = (picks: Record<string, string>, prev: Pieces, next: Pieces) =>
100 < 2   Object.fromEntries(Object.entries(picks).filter(([name]) => same(prev[name]?.versions ?? {}, next[name]?.versions ?? {})));
101 < 1 
96 < 1 function Page() {
97 < 1   const [pieces, setPieces] = useState<Pieces>(initial);
99 > 1   const [picked, setPicked] = useState<string | null>(null);
98 < 2   const [picked, setPicked] = useState<Record<string, string>>({});
100 > 1   const shown = useRef<Pieces>(initial);
99 < 1   useEffect(() => {
100 < 1     let ws: WebSocket | null = null;
101 < 1     let stopped = false;
102 < 1     const open = () => {
103 < 1       ws = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/ws`);
104 < 1       ws.onopen = () => ws?.send(JSON.stringify({type: 'hello', page: compare ? 'compare' : 'single'}));
105 < 1       ws.onmessage = (e) => {
106 < 1         const msg = JSON.parse(String(e.data));
108 > 1         if (msg?.type === 'specs' && msg.pieces) {
109 < 1           const prev = shown.current;
110 < 1           const next = msg.pieces as Pieces;
111 < 1           shown.current = next;
112 < 1           setPieces(next);
113 < 1           setPicked((m) => kept(m, prev, next));
114 < 1         }
107 < 2         if (msg?.type === 'specs' && msg.pieces) setPieces(msg.pieces);
108 < 1         else if (msg?.type === 'play' && typeof msg.story === 'string' && !compare) void playOne(msg.story);
109 < 1       };
110 < 1       ws.onclose = () => { if (!stopped) setTimeout(open, 1000); };
111 < 1     };
112 < 1     open();
113 < 1     return () => { stopped = true; ws?.close(); };
114 < 1   }, []);
