2 < 1 /* The preview's own chrome: plain CSS, not Tailwind classes. */
3 < 1 .preview-compare {
4 < 1   display: flex;
5 < 1   gap: 24px;
6 < 1   align-items: flex-start;
7 < 1   padding: 16px;
8 < 1 }
9 < 1 .preview-compare > section[data-version] {
10 < 1   flex: 1 1 0;
11 < 1   min-width: 0;
12 < 1   padding: 12px;
13 < 1   border: 1px dashed rgba(58, 46, 92, 0.35);
14 < 1   border-radius: 12px;
15 < 1 }
16 < 1 .preview-compare > section[data-version][data-chosen] {
