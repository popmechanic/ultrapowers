0 < 1 #!/usr/bin/env bun
1 < 1 // What Jev would have said at the proof gate. It reads the gate reader's diet (the task's Claim
2 < 1 // with its numbered Machine clauses, and the Proof slot) and asks, in one request, whether each
3 < 1 // clause states a computable fact, whether a probe would catch it false, and whether a leg
4 < 1 // contradicts the clause it cites, and, when the diet carries `base`, whether a file there already
5 < 1 // pins the opposite of a clause. The verdict is computed here, from policy.json. Jev judges
6 < 1 // beside the agent reader; it decides nothing.
7 < 1 //
8 < 1 //   bun skills/ultrawrite/stories/gate_jev.ts <diet.json> [--record <gate-verdicts.json> --agent pass|fail --reason <sentence>]
9 < 1 //   bun skills/ultrawrite/stories/gate_jev.ts --agreement <dir>
10 < 1 //   bun skills/ultrawrite/stories/gate_jev.ts --readings <dir>
11 < 1 //   bun skills/ultrawrite/stories/gate_jev.ts --label <gate-verdicts.json> --task <id> --round <n> --right agent|jev --because "<one line>"
12 < 1 import {existsSync, readdirSync, readFileSync, writeFileSync} from 'node:fs';
13 < 1 import {join} from 'node:path';
14 < 1 import {parseArgs} from 'node:util';
15 < 1 import {at, defaultAsk, loadQuestions, noul} from './jev';
16 < 1 
17 < 1 const Q = loadQuestions().authoring_gate.questions as Record<string, any>;
18 < 1 const POLICY_FILE = JSON.parse(readFileSync(join(import.meta.dir, 'policy.json'), 'utf8'));
19 < 1 const POLICY = POLICY_FILE.flag_at;
20 < 1 // Which reading the gate asks (#1497): the `caught` question's key, and whether Jev reads the base
21 < 1 // entries the extractor marks `own` (the task's own Modify:/Delete: files). A missing cell is the
22 < 1 // reading of 2026-09-29; each cell reverts alone.
24 > 1 // An unknown `caught` key falls back to `caught` with one stderr line naming both (#1528, #1532),
25 < 1 // and the record names the key asked.
23 < 2 // An unknown `caught` key falls back to `caught` (#1528), and the record names the key asked.
24 < 1 const ASKED = String(POLICY_FILE.gate_reading?.caught ?? 'caught');
26 > 1 if (!Object.hasOwn(Q, ASKED)) console.error(`gate_jev: policy.json gate_reading.caught names no question "${ASKED}"; asking "caught"`);
25 < 1 const READING = {caught: Object.hasOwn(Q, ASKED) ? ASKED : 'caught',
26 < 1   own_files: POLICY_FILE.gate_reading?.own_files === 'dropped' ? 'dropped' : 'read'};
27 < 1 
28 < 1 type Diet = {task: string | number; claim: string; proof: string; hash: string; base?: Record<string, unknown>};
29 < 1 type Verdict = 'pass' | 'fail' | null;
30 < 1 type Reading = {caught: string; own_files: string};
31 < 1 type Round = {hash: string; agent: string; jev: Verdict; clauses?: unknown; contradiction?: number | null; pinned?: number | null;
32 < 1   reading?: Reading; right?: 'agent' | 'jev'; because?: string};
33 < 1 
34 < 1 const ids = (tag: string | undefined) => (tag ?? '').split(',').map((s) => s.trim()).filter(Boolean);
35 < 1 
36 < 1 export function gateState(d: Diet) {
37 < 1   const m = d.claim.indexOf('Machine:');
38 < 1   const claim = (m < 0 ? d.claim : d.claim.slice(0, m)).trim();
39 < 1   const machine = m < 0 ? '' : d.claim.slice(m + 'Machine:'.length);
40 < 1   const parts = machine.split(/(?:^|\s)(M\d+)\.\s+/);
41 < 1   const clauses: {id: string; text: string}[] = [];
42 < 1   for (let k = 1; k < parts.length; k += 2) clauses.push({id: parts[k], text: parts[k + 1].trim()});
43 < 1   const probes: {command: string; proves: string[]}[] = [];
44 < 1   const legs: {text: string; cites: string[]}[] = [];
45 < 1   for (const line of d.proof.split('\n')) {
46 < 1     const run = line.match(/^\s*-\s*Run:\s*(.*?)\s*(?:\[(M\d+(?:\s*,\s*M\d+)*)\])?\s*$/);
47 < 1     if (run) probes.push({command: run[1], proves: ids(run[2])});
48 < 1     const legLine = line.match(/^\s*-\s*Legs:\s*(.*)$/);
49 < 1     if (legLine) {
50 < 1       for (const piece of legLine[1].split(/\([a-z]\)\s*/).map((s) => s.trim()).filter(Boolean)) {
51 < 1         const t = piece.replace(/[;.]\s*$/, '').trim();
52 < 1         const c = t.match(/\s*\[(M\d+(?:\s*,\s*M\d+)*)\]$/);
53 < 1         legs.push({text: c ? t.slice(0, c.index).trim() : t, cites: ids(c?.[1])});
54 < 1       }
55 < 1     }
56 < 1   }
57 < 1   if (!d.base || typeof d.base !== 'object') return {claim, clauses, probes, legs};
58 < 1   return {claim, clauses, probes, legs, base: baseFor(d.base)};
59 < 1 }
60 < 1 
61 < 1 // A base with a `files` array loses the entries marked `own` when own_files is "dropped"; either
62 < 1 // way no entry keeps the `own` key. Any other base reaches Jev unchanged.
63 < 1 function baseFor(base: Record<string, unknown>): Record<string, unknown> {
64 < 1   if (!Array.isArray(base.files)) return base;
65 < 1   const files = (base.files as unknown[])
66 < 1     .filter((f) => READING.own_files === 'read' || !(f && typeof f === 'object' && 'own' in f))
67 < 1     .map((f) => {
68 < 1       if (!f || typeof f !== 'object') return f;
69 < 1       const {own: _own, ...rest} = f as Record<string, unknown>;
70 < 1       return rest;
71 < 1     });
72 < 1   return {...base, files};
73 < 1 }
74 < 1 
75 < 1 async function read(d: Diet) {
76 < 1   const state = gateState(d);
77 < 1   const questions: Record<string, unknown> = {};
78 < 1   state.clauses.forEach((c, i) => {
79 < 1     questions[`fact:${c.id}`] = at(Q.fact, {i});
80 < 1     questions[`caught:${c.id}`] = at(Q[READING.caught], {i});
81 < 1   });
82 < 1   questions.contradiction = Q.contradiction;
83 < 1   const askPinned = 'base' in state && !(Array.isArray(state.base.files) && state.base.files.length === 0);
84 < 1   if (askPinned) questions.pinned = Q.pinned;
85 < 1   const answers = await defaultAsk(state, questions);
86 < 1   const clauses = state.clauses.map((c) => ({id: c.id, fact: noul(answers, `fact:${c.id}`), caught: noul(answers, `caught:${c.id}`)}));
87 < 1   const contradiction = noul(answers, 'contradiction');
88 < 1   const pinned = askPinned ? noul(answers, 'pinned') : null;
89 < 1   let verdict: Verdict = null;
90 < 1   if (answers !== null) {
91 < 1     const uncaught = clauses.some((c) => c.fact !== null && c.caught !== null && c.fact >= POLICY.gate_fact && c.caught < POLICY.gate_caught_below);
92 < 1     verdict = uncaught || (contradiction !== null && contradiction >= POLICY.gate_contradiction)
93 < 1       || (pinned !== null && pinned >= POLICY.gate_pinned) ? 'fail' : 'pass';
94 < 1   }
95 < 1   return {task: d.task, hash: d.hash, verdict, clauses, contradiction, pinned};
96 < 1 }
97 < 1 
98 < 1 // The one writer of the gate verdict: set the task's {hash, verdict, reason} (what plan_check.py
99 < 1 // reads) and append the round with Jev's reading beside it; every other key stays as it was.
100 < 1 function record(file: string, task: string, reason: string, round: Round) {
101 < 1   const rec = existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : {};
102 < 1   rec.tasks ??= {};
103 < 1   rec.tasks[task] = {...(rec.tasks[task] ?? {}), hash: round.hash, verdict: round.agent, reason};
104 < 1   rec.tasks[task].gate_rounds ??= [];
105 < 1   rec.tasks[task].gate_rounds.push(round);
106 < 1   writeFileSync(file, JSON.stringify(rec, null, 2) + '\n');
107 < 1 }
108 < 1 
109 < 1 const disagrees = (r: Round) => r.agent != null && r.jev != null && r.agent !== r.jev;
110 < 1 
111 < 1 // Mark who the run proved right on one disagreeing round (1-based over the task's gate_rounds).
112 < 1 // Anything else — unknown task, out-of-range round, a round that agrees — writes nothing.
113 < 1 function label(file: string, task: string, n: number, right: 'agent' | 'jev', because: string): boolean {
114 < 1   if (!existsSync(file)) return false;
115 < 1   const rec = JSON.parse(readFileSync(file, 'utf8'));
116 < 1   const rs = rec?.tasks?.[task]?.gate_rounds;
117 < 1   if (!Array.isArray(rs) || !Number.isInteger(n) || n < 1 || n > rs.length) return false;
118 < 1   const r = rs[n - 1];
119 < 1   if (!r || !disagrees(r)) return false;
120 < 1   r.right = right;
121 < 1   r.because = because;
122 < 1   writeFileSync(file, JSON.stringify(rec, null, 2) + '\n');
123 < 1   return true;
124 < 1 }
125 < 1 
126 < 1 function agreement(dir: string): string[] {
127 < 1   let plans = 0, rounds = 0, agree = 0, jevOnly = 0, agentOnly = 0;
128 < 1   let disagreements = 0, agentRight = 0, jevRight = 0, unlabelled = 0;
129 < 1   for (const f of readdirSync(dir).filter((n) => n.endsWith('.gate-verdicts.json')).sort()) {
130 < 1     const rec = JSON.parse(readFileSync(join(dir, f), 'utf8'));
131 < 1     const rs: Round[] = Object.values(rec.tasks ?? {}).flatMap((t: any) => (Array.isArray(t?.gate_rounds) ? t.gate_rounds : []))
132 < 1       .filter((r: Round) => r && r.jev != null);
133 < 1     if (rs.length) plans += 1;
134 < 1     for (const r of rs) {
135 < 1       rounds += 1;
136 < 1       if (r.agent === r.jev) agree += 1;
137 < 1       else if (r.jev === 'fail' && r.agent === 'pass') jevOnly += 1;
138 < 1       else if (r.agent === 'fail' && r.jev === 'pass') agentOnly += 1;
139 < 1       if (!disagrees(r)) continue;
140 < 1       disagreements += 1;
141 < 1       if (r.right === 'agent') agentRight += 1;
142 < 1       else if (r.right === 'jev') jevRight += 1;
143 < 1       else unlabelled += 1;
144 < 1     }
145 < 1   }
146 < 1   return [`gate-jev: n=${plans} plans, ${rounds} rounds, agree ${agree}, jev-only fail ${jevOnly}, agent-only fail ${agentOnly}`,
147 < 1     `gate-jev outcomes: disagreements ${disagreements}, agent right ${agentRight}, jev right ${jevRight}, unlabelled ${unlabelled}`];
148 < 1 }
149 < 1 
150 < 1 // The census per reading: a reworded question is a different question, so each reading
151 < 1 // (caught question / own files) is counted apart; a round recorded without one is caught/read.
152 < 1 export function readings(dir: string): string[] {
153 < 1   const by = new Map<string, {plans: number; rounds: number; agree: number; disagreements: number; agentRight: number;
154 < 1     jevRight: number; unlabelled: number}>();
155 < 1   for (const f of readdirSync(dir).filter((n) => n.endsWith('.gate-verdicts.json')).sort()) {
156 < 1     const rec = JSON.parse(readFileSync(join(dir, f), 'utf8'));
157 < 1     const rs: Round[] = Object.values(rec.tasks ?? {}).flatMap((t: any) => (Array.isArray(t?.gate_rounds) ? t.gate_rounds : []))
158 < 1       .filter((r: Round) => r && r.jev != null);
159 < 1     const seen = new Set<string>();
160 < 1     for (const r of rs) {
161 < 1       const name = `${r.reading?.caught ?? 'caught'}/${r.reading?.own_files ?? 'read'}`;
162 < 1       let c = by.get(name);
163 < 1       if (!c) by.set(name, c = {plans: 0, rounds: 0, agree: 0, disagreements: 0, agentRight: 0, jevRight: 0, unlabelled: 0});
164 < 1       if (!seen.has(name)) { seen.add(name); c.plans += 1; }
165 < 1       c.rounds += 1;
166 < 1       if (r.agent === r.jev) c.agree += 1;
167 < 1       if (!disagrees(r)) continue;
168 < 1       c.disagreements += 1;
169 < 1       if (r.right === 'agent') c.agentRight += 1;
170 < 1       else if (r.right === 'jev') c.jevRight += 1;
171 < 1       else c.unlabelled += 1;
172 < 1     }
173 < 1   }
174 < 1   return [...by.keys()].sort().map((name) => {
175 < 1     const c = by.get(name)!;
176 < 1     return `gate-jev reading ${name}: n=${c.plans} plans, ${c.rounds} rounds, agree ${c.agree}, disagreements ${c.disagreements}, `
177 < 1       + `agent right ${c.agentRight}, jev right ${c.jevRight}, unlabelled ${c.unlabelled}`;
178 < 1   });
179 < 1 }
180 < 1 
181 < 1 async function main(): Promise<number> {
182 < 1   const usage = 'usage: gate_jev.ts <diet.json> [--record <gate-verdicts.json> --agent pass|fail --reason <sentence>] | gate_jev.ts --agreement <dir>'
183 < 1     + ' | gate_jev.ts --label <gate-verdicts.json> --task <id> --round <n> --right agent|jev --because "<one line>"'
184 < 1     + ' | gate_jev.ts --readings <dir>';
185 < 1   const {values, positionals} = parseArgs({allowPositionals: true,
186 < 1     options: {record: {type: 'string'}, agent: {type: 'string'}, reason: {type: 'string'}, agreement: {type: 'string'},
187 < 1       readings: {type: 'string'},
188 < 1       label: {type: 'string'}, task: {type: 'string'}, round: {type: 'string'}, right: {type: 'string'}, because: {type: 'string'}}});
189 < 1   if (values.label !== undefined) {
190 < 1     const {task, round, right, because} = values;
191 < 1     if (positionals.length || !task || !round || !/^\d+$/.test(round) || (right !== 'agent' && right !== 'jev')
192 < 1       || !because?.trim() || /[\r\n]/.test(because)) { console.error(usage); return 2; }
193 < 1     if (!label(values.label, task, Number(round), right, because)) {
194 < 1       console.error(`gate-jev: task ${task} round ${round} in ${values.label} is not a disagreement to label`);
195 < 1       return 2;
196 < 1     }
197 < 1     return 0;
198 < 1   }
199 < 1   if (values.agreement !== undefined) {
200 < 1     if (positionals.length) { console.error(usage); return 2; }
201 < 1     for (const line of agreement(values.agreement)) console.log(line);
202 < 1     return 0;
203 < 1   }
204 < 1   if (values.readings !== undefined) {
205 < 1     if (positionals.length) { console.error(usage); return 2; }
206 < 1     for (const line of readings(values.readings)) console.log(line);
207 < 1     return 0;
208 < 1   }
209 < 1   const given = [values.record, values.agent, values.reason].filter((v) => v !== undefined).length;
210 < 1   if (positionals.length !== 1 || (given !== 0 && given !== 3) || (values.reason !== undefined && !values.reason.trim())
211 < 1     || (values.agent !== undefined && !['pass', 'fail'].includes(values.agent))) {
212 < 1     console.error(usage);
213 < 1     return 2;
214 < 1   }
215 < 1   const diet: Diet = JSON.parse(readFileSync(positionals[0], 'utf8'));
216 < 1   const out = await read(diet);
217 < 1   console.log(JSON.stringify(out));
218 < 1   if (values.record !== undefined) record(values.record, String(diet.task), values.reason!, {hash: diet.hash, agent: values.agent!,
219 < 1     jev: out.verdict, clauses: out.clauses, contradiction: out.contradiction, pinned: out.pinned, reading: {...READING}});
220 < 1   return 0;
221 < 1 }
222 < 1 
223 < 1 if (import.meta.main) process.exit(await main());
224 < 1 