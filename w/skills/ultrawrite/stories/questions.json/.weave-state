224 < 1       "provenance": "moved from skills/ultrawrite/stories/questions.json (authoring-questions-v2), 2026-09-29; caught_v2 added 2026-10-01 for #1497, narrowed the same day to exempt wiring only (#1528)",
225 < 1       "calibrated": false,
226 < 1       "questions": {
227 < 1         "fact": {
228 < 1           "type": "noul",
229 < 1           "instructions": {
230 < 1             "question": "Does `clauses[i].text` state a computable fact: an exit code, a recorded argv, a byte-exact string, a count, an ordering of events, or that something is gone, unchanged or exactly so many?",
231 < 1             "context": "`claim` is what a task promises; `clauses` are its machine clauses, each with an id and its text. `probes` are the commands that prove it, each naming the clauses it proves; `legs` say which clause each part of the proof covers."
232 < 1           },
233 < 1           "criteria": {
234 < 1             "true": "A program could decide it exactly",
235 < 1             "false": "It needs a judgment to decide"
236 < 1           }
237 < 1         },
238 < 1         "caught": {
239 < 1           "type": "noul",
240 < 1           "instructions": {
241 < 1             "question": "Would at least one command in `probes` fail if `clauses[i].text` were false?",
242 < 1             "context": "`clauses` are a task's machine clauses; `probes` are the commands that prove them, each with the clause ids it claims to prove (`proves`)."
243 < 1           },
244 < 1           "criteria": {
245 < 1             "true": "Some probe would fail",
246 < 1             "false": "Every probe could still pass"
247 < 1           }
248 < 1         },
249 < 1         "caught_v2": {
250 < 1           "type": "noul",
251 < 1           "instructions": {
252 < 1             "question": "Is `clauses[i].text` either caught by a probe, so that at least one command in `probes` would fail if it were false, or a clause that only says how the code is wired, which needs no probe?",
253 < 1             "context": "`clauses` are a task's machine clauses; `probes` are the commands that prove them, each with the clause ids it claims to prove (`proves`). A clause only about wiring says which function calls which, or what a function is passed, and nothing more; a reader of the change judges such a clause later, so it needs no probe. Every other clause needs a probe: one about an exit code, a recorded argv, a byte-exact string, a count, an ordering of events, a line the code prints or logs, a file's content, or that something is gone, unchanged or exactly so many."
254 < 1           },
255 < 1           "criteria": {
256 < 1             "true": "Some probe would fail if the clause were false, or the clause only says which function calls which or what a function is passed",
257 < 1             "false": "The clause says more than which function calls which or what a function is passed, and every probe could still pass if it were false"
258 < 1           }
259 < 1         },
260 < 1         "contradiction": {
261 < 1           "type": "noul",
262 < 1           "instructions": {
263 < 1             "question": "Does any entry of `legs` say something the clause it cites rules out?",
264 < 1             "context": "`legs` are the proof's legs, each with its text and the clause ids it cites (`cites`); `clauses` are the task's machine clauses."
265 < 1           },
266 < 1           "criteria": {
267 < 1             "true": "Some leg contradicts its clause",
268 < 1             "false": "Every leg agrees with the clauses it cites"
269 < 1           }
270 < 1         },
271 < 1         "pinned": {
272 < 1           "type": "noul",
273 < 1           "instructions": {
274 < 1             "question": "Does some file in `base` already pin the opposite of an entry of `clauses`, where that clause does not say the file changes?",
275 < 1             "context": "`base` holds, for each file the task names, what it is at BASE: whether it exists, its line count, its headings or test names, and an `excerpt` of its lines carrying the task's literals. `clauses` are the task's machine clauses; asked only when `base` is present."
276 < 1           },
277 < 1           "criteria": {
278 < 1             "true": "Some file at BASE already pins the opposite of a clause that does not say it changes",
279 < 1             "false": "No file at BASE pins the opposite of a clause, or the clause says that file changes"
280 < 1           }
281 < 1         }
282 < 1       }
