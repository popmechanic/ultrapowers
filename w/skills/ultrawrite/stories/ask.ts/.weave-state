0 < 2 // One Jev question from the skill's own questions.json, asked over stdin's state: `ask.ts <set> <question>`.
1 < 2 // Prints {"noul": <number|null>}; a failed call still prints null and exits 0. Bad input exits 2.
2 < 1 import {join} from 'node:path';
3 < 1 
4 < 1 import {defaultAsk, loadQuestions, noul} from './jev';
5 < 1 
6 < 1 function fail(msg: string): never {
7 < 1   console.error(msg);
8 < 1   process.exit(2);
9 < 1 }
10 < 1 
11 < 1 const args = process.argv.slice(2);
12 < 1 if (args.length !== 2) fail('usage: ask.ts <set> <question>  (state JSON on stdin)');
13 < 1 const [set, question] = args;
14 < 1 
15 < 1 const file = join(import.meta.dir, 'questions.json');
16 < 1 let sets: Record<string, {questions?: Record<string, unknown>}>;
17 < 1 try {
18 < 1   sets = loadQuestions();
19 < 1 } catch (e) {
20 < 1   fail(`ask: cannot read ${file}: ${(e as Error).message}`);
21 < 1 }
22 < 1 const s = Object.hasOwn(sets, set) ? sets[set] : undefined;
23 < 1 if (!s) fail(`ask: no set ${set} in ${file}`);
24 < 1 const q = s.questions && Object.hasOwn(s.questions, question) ? s.questions[question] : undefined;
25 < 1 if (!q) fail(`ask: no question ${question} in set ${set}`);
26 < 1 
27 < 1 let state: unknown;
28 < 1 try {
29 < 1   state = JSON.parse(await Bun.stdin.text());
30 < 1 } catch (e) {
31 < 1   fail(`ask: stdin is not JSON: ${(e as Error).message}`);
32 < 1 }
33 < 1 
34 < 1 let answers: Record<string, unknown> | null = null;
35 < 1 try {
36 < 1   answers = await defaultAsk(state, {[question]: q});
37 < 1 } catch (e) {
38 < 1   console.error(`ask: ${(e as Error).message}`);
39 < 1 }
40 < 1 console.log(JSON.stringify({noul: noul(answers, question)}));
41 < 1 