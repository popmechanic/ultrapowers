0 < 1 #!/usr/bin/env bun
1 < 2 // Jev reads the plan at each enrichment stage. It judges; it never generates or
2 < 2 // decides. A flag is for the author to act on. Only three kinds of flag may
3 < 2 // become the operator's doubts (DOUBT:), each a product choice in plain words:
4 < 2 // an ask sentence with two readings, an assumption about what the app does,
5 < 2 // and a link the audience might not expect. The code checks run first.
6 < 2 //
7 < 2 //   bun skills/ultrawrite/stories/jev_checks.ts <bundle> [--ask-file <ask.txt>] [--stage understanding|map|decompose|bundle]
8 < 1 import {existsSync, readFileSync} from 'node:fs';
9 < 1 import {join} from 'node:path';
10 < 1 import {parseArgs} from 'node:util';
11 < 1 import {loadBundle, type Bundle} from './bundle';
12 < 1 import {runChecks} from './checks';
13 < 1 import {checkProduct, saveProduct, type Product} from './product';
14 < 1 import {at, defaultAsk, loadQuestions, noul, type Ask} from './jev';
15 < 1 
16 < 1 const SETS = loadQuestions() as Record<string, any>;
17 < 1 const GROUPS = ['ambiguity', 'coherence', 'near_miss', 'content_branch', 'redundancy', 'surprise', 'map', 'decompose', 'gate', 'link', 'about_product'];
18 < 1 const Q = Object.fromEntries(GROUPS.map((g) => [g, SETS[`authoring_${g}`].questions]));
19 < 1 const POLICY = JSON.parse(readFileSync(join(import.meta.dir, 'policy.json'), 'utf8')).flag_at;
20 < 1 const STAGES = ['understanding', 'map', 'decompose', 'bundle'];
21 < 1 
22 < 1 type Out = {flags: string[]; doubts: string[]; reads: number};
23 < 1 
24 < 1 export const sentences = (text: string) => text.trim().split(/(?<=[.!?])\s+/).filter(Boolean);
25 < 1 const f2 = (v: number) => v.toFixed(2);
26 < 1 const today = () => new Date().toISOString().slice(0, 10);
27 < 1 
28 < 1 type Get = (k: string, flagged: (v: number) => boolean, question?: string, subject?: string) => number | null;
29 < 1 
30 < 2 // `one` sends its request at once, so every call of a stage runs concurrently; the thunk it
31 < 2 // returns is awaited in the stage's own order, so flags and reading rows keep that order.
32 < 1 function reader(ask: Ask, out: Out, product: Product | null, stage: string) {
33 < 1   return (state: unknown, questions: Record<string, unknown>, label: string, subject: string): (() => Promise<Get>) => {
34 < 1     out.reads += 1;
35 < 1     const answers = ask(state, questions);
36 < 1     return async () => {
37 < 1       const a = await answers;
38 < 1       if (a === null) out.flags.push(`JEV unread: ${label}`);
39 < 1       return (k, flagged, question = k, subj = subject) => {
40 < 1         const v = noul(a, k);
41 < 1         product?.readings.push({stage, question, subject: subj, noul: v, flagged: v !== null && flagged(v), operator_pick: null, date: today()});
42 < 1         return v !== null && flagged(v) ? v : null;
43 < 1       };
44 < 1     };
45 < 1   };
46 < 1 }
47 < 1 
48 < 2 // The ask's sentences, all in one request: one question per sentence.
49 < 1 async function ambiguity(one: ReturnType<typeof reader>, ask: string, out: Out) {
50 < 1   const ss = sentences(ask);
51 < 1   if (!ss.length) return;
52 < 1   const questions = Object.fromEntries(ss.map((_, i) => [`two_apps_${i}`, at(Q.ambiguity.two_apps, {i})]));
53 < 1   const get = await one({ask, sentences: ss}, questions, `ambiguity of ${ss.length} sentence(s)`, ask)();
54 < 1   ss.forEach((s, i) => {
55 < 1     const v = get(`two_apps_${i}`, (x) => x >= POLICY.two_apps, 'two_apps', s);
56 < 1     if (v !== null) out.doubts.push(`DOUBT: "${s}" can mean two different apps; ask which one, with both readings side by side`);
57 < 1   });
58 < 1 }
59 < 1 
60 < 1 async function understanding(p: Product, ask: Ask, out: Out) {
61 < 1   const one = reader(ask, out, p, 'understanding');
62 < 2   // Only what the author decided alone; a choice the operator already made is never re-asked.
63 < 1   const assumed = p.understanding.assumed.filter((x) => x.about === 'product' && x.by === 'author')
64 < 1     .map((a) => [a, one({ask: p.understanding.ask, assumption: a.text}, Q.surprise, `assumption "${a.text}"`, a.text)] as const);
65 < 2   // A technical label keeps an assumption from the surprise question; Jev reads whether it is
66 < 2   // really about the app, and a high reading is only a flag: the author acts on it.
67 < 1   const technical = p.understanding.assumed.filter((x) => x.about === 'technical' && x.by === 'author')
68 < 1     .map((a) => [a, one({assumption: a.text}, {about_product: Q.about_product.about_product}, `technical assumption "${a.text}"`, a.text)] as const);
69 < 1   await ambiguity(one, p.understanding.ask, out);
70 < 1   for (const [a, read] of assumed) {
71 < 1     const v = (await read())('assumption_surprises', (x) => x >= POLICY.assumption_surprises);
72 < 1     if (v !== null) out.doubts.push(`DOUBT: ask whether the app should: ${a.text}`);
73 < 1   }
74 < 1   for (const [a, read] of technical) {
75 < 1     const v = (await read())('about_product', (x) => x >= POLICY.about_product);
76 < 1     if (v !== null) out.flags.push(`JEV flag: assumption "${a.text}" is labelled technical but reads as about the product (about_product ${f2(v)}); the label may hide it from the surprise check`);
77 < 1   }
78 < 1 }
79 < 1 
80 < 1 async function map(p: Product, ask: Ask, out: Out) {
81 < 1   if (!p.concepts.length) throw new Error('the map has no concepts yet; list them in product.json first');
82 < 1   const one = reader(ask, out, p, 'map');
83 < 1   const summary = p.intent.summary.join(' ');
84 < 1   const audience = p.intent.audience.join(', ');
85 < 1   const reads = p.concepts.map((c) => one(
86 < 1     {summary, audience, piece: {name: c.id, purpose: c.purpose}, other_purposes: p.concepts.filter((o) => o !== c).map((o) => o.purpose)},
87 < 1     {essential: Q.map.essential, serves_summary: Q.map.serves_summary, one_need: Q.coherence.one_need}, `concept ${c.id}`, c.id));
88 < 1   for (const [i, c] of p.concepts.entries()) {
89 < 1     const get = await reads[i]();
90 < 1     const low = get('essential', (x) => x < POLICY.essential_below);
91 < 1     const read = p.readings[p.readings.length - 1].noul;
92 < 1     out.flags.push(`JEV map: ${c.id}: recommend ${low !== null ? 'Later' : 'First version'} (essential ${read === null ? 'unread' : f2(read)})`);
93 < 1     const s = get('serves_summary', (x) => x < POLICY.serves_summary_below);
94 < 1     if (s !== null) out.flags.push(`JEV flag: ${c.id}: may not serve what the product is for (serves_summary ${f2(s)}); recommend Not doing`);
95 < 1     const n = get('one_need', (x) => x < POLICY.one_need_below);
96 < 1     if (n !== null) out.flags.push(`JEV flag: ${c.id}: its purpose reads as more than one need (one_need ${f2(n)}); split it`);
97 < 1   }
98 < 1 }
99 < 1 
100 < 1 async function decompose(p: Product, ask: Ask, out: Out) {
101 < 1   if (!p.subprojects.length) throw new Error('no build order yet; list the plans in product.json first');
102 < 1   const one = reader(ask, out, p, 'decompose');
103 < 1   const audience = p.intent.audience.join(', ');
104 < 1   const summary = p.intent.summary.join(' ');
105 < 1   const plans = p.subprojects.map((s) => ({title: s.title, does: s.concepts.map((id) => p.concepts.find((c) => c.id === id)?.purpose ?? id)}));
106 < 1   const reads = p.subprojects.map((s, k) =>
107 < 1     one({audience, summary, plan: plans[k], built_before: plans.slice(0, k)}, Q.decompose, `plan ${s.id}`, s.id));
108 < 1   for (const [k, s] of p.subprojects.entries()) {
109 < 1     const v = (await reads[k]())('stands_alone', (x) => x < POLICY.stands_alone_below);
110 < 1     if (v !== null) out.flags.push(`JEV flag: ${s.id} "${s.title}" may not be usable on its own (stands_alone ${f2(v)}); regroup it`);
111 < 1   }
112 < 1 }
113 < 1 
114 < 1 async function bundleStage(b: Bundle, ask: Ask, out: Out, askText?: string) {
115 < 1   const one = reader(ask, out, b.product, 'bundle');
116 < 1   const stories = new Map(b.page.stories.map((s) => [s.id, s]));
117 < 1   const summary = (b.product?.intent.summary ?? b.page.summary ?? []).join(' ');
118 < 1   const audience = b.product?.intent.audience.join(', ') ?? 'the people who use the app';
119 < 2   // Every request goes out now; the answers are read below in the order the flags are written.
120 < 1   const coherence = b.cards.map((c) => one(
121 < 1     {piece: {name: c.piece, purpose: c.purpose, actions: c.actions.map((a) => ({name: a.name, description: a.description}))}},
122 < 1     Q.coherence, `piece ${c.piece} coherence`, c.piece));
123 < 1   const nearMiss = b.cards.map((c) => {
124 < 1     const story = stories.get(c.main_story ?? '');
125 < 1     return one({piece: {name: c.piece, purpose: c.purpose}, story: story?.sentence ?? '',
126 < 1       story_steps: (story?.steps ?? []).map((st) => ({tool: st.tool, args: st.args, see: st.see ?? []})), near_miss: c.near_miss ?? ''},
127 < 1     Q.near_miss, `piece ${c.piece} near-miss`, c.piece);
128 < 1   });
129 < 2   // The store goes once, with one question per action.
130 < 1   const actions = b.cards.flatMap((c) => c.actions.map((a) => ({piece: c.piece, name: a.name, description: a.description})));
131 < 1   const storeRead = actions.length ? one({store_module: b.storeText.slice(0, 20000), actions},
132 < 1     Object.fromEntries(actions.map((_, i) => [`branches_on_text_${i}`, at(Q.content_branch.branches_on_text, {i})])),
133 < 1     `store for ${actions.length} action(s)`, 'store') : null;
134 < 2   // Every pair of pieces, in one request.
135 < 1   const pairs: [number, number][] = [];
136 < 1   for (let i = 0; i < b.cards.length; i++) for (let j = i + 1; j < b.cards.length; j++) pairs.push([i, j]);
137 < 1   const pairRead = pairs.length ? one({pieces: b.cards.map((c) => ({name: c.piece, purpose: c.purpose}))},
138 < 1     Object.fromEntries(pairs.map(([i, j]) => [`same_need_${i}_${j}`, at(Q.redundancy.same_need, {i, j})])),
139 < 1     `${pairs.length} pair(s) of pieces`, 'pieces') : null;
140 < 1   const links = (b.page.links ?? []).map((l) => one({audience, summary, link: l.sentence}, Q.link, `link ${l.id}`, l.id));
141 < 2   // A later plan's ask is new words: read them too. The first plan's ask was read at stage 2.
142 < 1   if (askText && askText.trim() !== (b.product?.understanding.ask ?? '').trim()) await ambiguity(one, askText, out);
143 < 1   const storeGet = storeRead && (await storeRead());
144 < 1   let n = 0;
145 < 1   for (const [k, c] of b.cards.entries()) {
146 < 1     const get = await coherence[k]();
147 < 1     let v = get('one_need', (x) => x < POLICY.one_need_below);
148 < 1     if (v !== null) out.flags.push(`JEV flag: piece ${c.piece}: its purpose reads as more than one need (one_need ${f2(v)})`);
149 < 1     v = get('same_people', (x) => x < POLICY.same_people_below);
150 < 1     if (v !== null) out.flags.push(`JEV flag: piece ${c.piece}: its actions serve different people (same_people ${f2(v)})`);
151 < 1     v = (await nearMiss[k]())('story_passes_near_miss', (x) => x >= POLICY.story_passes_near_miss);
152 < 1     if (v !== null) out.flags.push(`JEV flag: piece ${c.piece}: main story ${c.main_story} does not rule out its near-miss (story_passes_near_miss ${f2(v)})`);
153 < 1     for (const act of c.actions) {
154 < 1       v = storeGet!(`branches_on_text_${n++}`, (x) => x >= POLICY.branches_on_text, 'branches_on_text', act.name);
155 < 1       if (v !== null) out.flags.push(`JEV flag: piece ${c.piece}: ${act.name} may act on the wording of typed text (branches_on_text ${f2(v)})`);
156 < 1     }
157 < 1   }
158 < 1   const pairGet = pairRead && (await pairRead());
159 < 1   for (const [i, j] of pairs) {
160 < 1     const [x, y] = [b.cards[i], b.cards[j]];
161 < 1     const v = pairGet!(`same_need_${i}_${j}`, (z) => z >= POLICY.same_need, 'same_need', `${x.piece}+${y.piece}`);
162 < 1     if (v !== null) out.flags.push(`JEV flag: pieces ${x.piece} and ${y.piece} serve the same need (same_need ${f2(v)})`);
163 < 1   }
164 < 1   for (const [k, l] of (b.page.links ?? []).entries()) {
165 < 1     const v = (await links[k]())('link_expected', (x) => x < POLICY.link_expected_below);
166 < 1     if (v !== null) out.doubts.push(`DOUBT: ask whether this should happen: ${l.sentence}`);
167 < 1   }
168 < 1 }
169 < 1 
170 < 1 async function main(): Promise<number> {
171 < 1   const {values, positionals} = parseArgs({allowPositionals: true,
172 < 1     options: {'ask-file': {type: 'string'}, stage: {type: 'string'}}});
173 < 1   const stage = values.stage ?? 'bundle';
174 < 1   if (positionals.length !== 1 || !STAGES.includes(stage)) {
175 < 1     console.error('usage: jev_checks.ts <bundle> [--ask-file <ask.txt>] [--stage understanding|map|decompose|bundle]');
176 < 1     return 2;
177 < 1   }
178 < 1   const dir = positionals[0];
179 < 1   const productPath = join(dir, 'product.json');
180 < 1   const out: Out = {flags: [], doubts: [], reads: 0};
181 < 1   let product: Product | null = null;
182 < 1   if (existsSync(productPath)) {
183 < 1     product = JSON.parse(readFileSync(productPath, 'utf8'));
184 < 1     const errs = checkProduct(product);
185 < 1     if (errs.length) {
186 < 1       console.log(errs.join('\n'));
187 < 1       console.log(`${errs.length} problem(s) in product.json`);
188 < 1       return 2;
189 < 1     }
190 < 1   } else if (stage !== 'bundle') {
191 < 1     console.log(`jev_checks: stage ${stage} reads ${productPath}, which does not exist; write the product record first`);
192 < 1     return 2;
193 < 1   }
194 < 1   try {
195 < 1     if (stage === 'understanding') await understanding(product!, defaultAsk, out);
196 < 1     else if (stage === 'map') await map(product!, defaultAsk, out);
197 < 1     else if (stage === 'decompose') await decompose(product!, defaultAsk, out);
198 < 1     else {
199 < 1       const b = loadBundle(dir);
200 < 1       const {refusals, facts} = runChecks(b);
201 < 1       for (const l of [...refusals, ...facts]) console.log(l);
202 < 1       if (refusals.length) {
203 < 1         console.log(`${refusals.length} refusal(s); fix them before Jev reads the draft`);
204 < 1         return 2;
205 < 1       }
206 < 1       const askText = values['ask-file'] ? readFileSync(values['ask-file'], 'utf8') : undefined;
207 < 1       await bundleStage(b, defaultAsk, out, askText);
208 < 1       product = b.product;
209 < 1     }
210 < 1   } catch (e) {
211 < 1     console.log(`jev_checks: ${(e as Error).message}`);
212 < 1     return 2;
213 < 1   }
214 < 1   for (const f of [...out.flags, ...out.doubts]) console.log(f);
215 < 1   if (product) saveProduct(productPath, product);
216 < 1   console.log(`JEV read: ${out.reads} call(s), ${out.flags.filter((f) => f.startsWith('JEV flag')).length} flag(s), ${out.doubts.length} doubt(s)`);
217 < 1   return 0;
218 < 1 }
219 < 1 
220 < 1 if (import.meta.main) process.exit(await main());
221 < 1 