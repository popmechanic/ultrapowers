358 > 1 /** The whole page in each version of authoring_arrange: every version kept, or dropped with why. */
359 < 1 export async function arrange(opts: {bundle: string; app: string; evaluate: Evaluator}): Promise<{versions: Record<string, Spec>; dropped: Record<string, string>; calls: number}> {
357 < 2 export async function arrange(opts: {bundle: string; app: string; piece?: string; evaluate: Evaluator}) {
358 < 1   const b = loadBundle(opts.bundle);
359 < 1   const kit = await loadKit(opts.app);
360 < 1   const set = arrangeSet();
361 < 1   let calls = 0;
362 < 1   const evaluate: Evaluator = (r) => {
363 < 1     calls++;
364 < 1     return opts.evaluate(r);
365 < 1   };
367 > 1   const versions: Record<string, Spec> = {};
368 < 1   const dropped: Record<string, string> = {};
371 > 1   const pieces = candidatesFor(b, kit);
372 < 1   const {candidates, required} = pieces;
370 > 2   const {candidates, required, lists, fields, writes, heading} = candidatesFor(b, kit);
369 < 2   const {candidates, required, lists, fields, writes} = candidatesFor(b, kit);
370 < 1   const common = {catalog: kit.catalog, candidates, evaluate, instructions: {next: set.guidance}, context: contextOf(b)};
371 < 1   const results = await Promise.all(
372 < 1     Object.entries(set.versions).map(async ([v, sentence]) => {
373 < 1       const prompt = [...b.page.summary, ...b.cards.map((c) => c.purpose), sentence].join(' ');
374 < 1       let {spec} = await lastSpec(kit.compose({...common, prompt}));
375 < 1       let left = missing(spec, required);
376 < 1       if (spec && left.length) {
377 < 1         spec = (await lastSpec(kit.compose({...common, initialSpec: spec, elementDescriptions: descriptionsOf(spec, candidates), prompt: `Add ${left.map((c) => c.description).join('; ')}`}))).spec;
378 < 1         left = missing(spec, required);
379 < 1       }
382 > 1       return [v, left.length || !spec ? {why: `left out ${left.map((c) => c.description).join('; ')}`} : {spec: expand(spec, pieces)}] as const;
381 > 2       return [v, left.length || !spec ? {why: `left out ${left.map((c) => c.description).join('; ')}`} : {spec: expand(spec, lists, heading, fields, writes)}] as const;
380 < 2       return [v, left.length || !spec ? {why: `left out ${left.map((c) => c.description).join('; ')}`} : {spec: expand(spec, lists, b.page.title, fields, writes)}] as const;
381 < 1     }),
382 < 1   );
383 < 1   for (const [v, r] of results) {
384 < 1     if ('spec' in r) versions[v] = r.spec;
385 < 1     else dropped[v] = r.why;
366 < 2   const versions: Record<string, Record<string, Spec>> = {};
367 < 2   const dropped: Record<string, Record<string, string>> = {};
368 < 2   for (const card of cardsOf(b, opts.piece)) {
370 > 2     const {candidates, required, lists, fields, writes} = candidatesFor(b, card, kit);
369 < 2     const {candidates, required, lists, fields} = candidatesFor(b, card, kit);
370 < 2     const common = {catalog: kit.catalog, candidates, evaluate, instructions: {next: set.guidance}, context: contextOf(b)};
371 < 2     const results = await Promise.all(
372 < 2       Object.entries(set.versions).map(async ([v, sentence]) => {
373 < 2         const prompt = [...b.page.summary, card.purpose, sentence].join(' ');
374 < 2         let {spec} = await lastSpec(kit.compose({...common, prompt}));
375 < 2         let left = missing(spec, required);
376 < 2         if (spec && left.length) {
377 < 2           spec = (await lastSpec(kit.compose({...common, initialSpec: spec, elementDescriptions: descriptionsOf(spec, candidates), prompt: `Add ${left.map((c) => c.description).join('; ')}`}))).spec;
378 < 2           left = missing(spec, required);
379 < 2         }
381 > 2         return [v, left.length || !spec ? {why: `left out ${left.map((c) => c.description).join('; ')}`} : {spec: expand(spec, lists, b.page.title, fields, writes)}] as const;
380 < 2         return [v, left.length || !spec ? {why: `left out ${left.map((c) => c.description).join('; ')}`} : {spec: expand(spec, lists, b.page.title, fields)}] as const;
381 < 2       }),
382 < 2     );
383 < 2     for (const [v, r] of results) {
384 < 2       if ('spec' in r) (versions[card.piece] ??= {})[v] = r.spec;
385 < 2       else (dropped[card.piece] ??= {})[v] = r.why;
386 < 2     }
387 < 1   }
388 < 1   return {versions, dropped, calls};
389 < 1 }
