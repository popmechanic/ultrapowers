38 < 1 /** The app's catalog, store and a staged copy of the composer, or CouldNotRun. */
39 < 1 async function loadKit(app: string): Promise<Kit> {
40 < 1   const dir = resolve(app);
41 < 1   const catPath = join(dir, 'client', 'src', 'screens', 'catalog.ts');
42 < 1   const storePath = join(dir, 'client', 'src', 'store.js');
43 < 1   if (!existsSync(catPath)) throw new CouldNotRun(`no catalog module at ${catPath}`);
44 < 1   if (!existsSync(storePath)) throw new CouldNotRun(`no store module at ${storePath}`);
45 < 1   const stage = join(dir, '.preview', 'json-render');
46 < 1   mkdirSync(stage, {recursive: true});
47 < 1   cpSync(VENDOR, stage, {recursive: true});
48 < 1   const cat = await import(catPath);
49 < 1   const store = await import(storePath);
50 < 1   const composer = await import(join(stage, 'experimental-compose.ts'));
51 < 1   return {compose: composer.experimental_composeSpec, catalog: cat.catalogFor(store.TOOLS), TOOLS: store.TOOLS, makeStore: store.makeStore};
52 < 1 }
