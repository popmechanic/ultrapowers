60 < 1 /** The row argument of an action: the input property carrying x-row-of, with its table. */
61 < 1 function rowArg(tool: Tool | undefined): {arg: string; table: string} | null {
62 < 1   for (const [k, p] of Object.entries(tool?.inputSchema?.properties ?? {})) if (typeof p['x-row-of'] === 'string') return {arg: k, table: p['x-row-of']};
63 < 1   return null;
64 < 1 }
65 < 1 
67 > 1 /** A row that a cell of this row names: the cell (a column some action takes as a row of
68 < 1  *  `table`), that table, and the named row's cells. */
69 < 1 type Join = {cell: string; table: string; cells: Json};
70 < 1 
66 < 1 /** A row control's name with the row's string cells put back as expressions: the
68 > 1  *  one cell it equals, or every cell it holds, longest first. Text left over that a
69 < 1  *  joined row's cell holds is read from that row by `lookup` (#1524), the whole label
71 > 1  *  then put together by `format`. A cell `skip` names (an id, or a column naming a row)
72 < 1  *  is never cut out of the text: it is a key, left to the joins. */
73 < 1 function fromRow(name: string, row: Json, joins: Join[] = [], skip: (column: string) => boolean = () => false): unknown {
74 < 1   const strings = (o: Json) => Object.entries(o).filter(([k, v]) => typeof v === 'string' && v !== '' && !skip(k)) as [string, string][];
70 < 2  *  then put together by `format`. */
71 < 2 function fromRow(name: string, row: Json, joins: Join[] = []): unknown {
72 < 2   const strings = (o: Json) => Object.entries(o).filter(([, v]) => typeof v === 'string' && v !== '') as [string, string][];
73 < 1   const cells = strings(row);
67 < 2  *  one cell it equals, or every cell it holds, longest first. */
68 < 2 function fromRow(name: string, row: Json): unknown {
69 < 2   const cells = Object.entries(row).filter(([, v]) => typeof v === 'string' && v !== '') as [string, string][];
70 < 1   const exact = cells.find(([, v]) => v === name);
71 < 1   if (exact) return {$item: exact[0]};
72 < 1   // Text and inserted expressions alternate; only text is searched, so no cell lands inside a ${...}.
74 > 1   type Part = {text: string; cell?: string; join?: {by: string; table: string; column: string}};
75 < 1   let parts: Part[] = [{text: name}];
76 < 1   const cut = (v: string, part: Omit<Part, 'text'>) =>
77 < 1     (parts = parts.flatMap((p) => (p.cell !== undefined ? [p] : p.text.split(v).flatMap((t, i) => (i ? [{text: '', ...part}, {text: t}] : [{text: t}])))));
78 < 1   for (const [k, v] of [...cells].sort(([, a], [, b]) => b.length - a.length)) cut(v, {cell: k});
79 < 1   const joined = joins.flatMap((j) => strings(j.cells).map(([column, v]) => ({v, by: j.cell, table: j.table, column})));
80 < 1   for (const j of joined.sort((a, b) => b.v.length - a.v.length)) cut(j.v, {cell: `${j.by}.${j.column}`, join: j});
73 < 2   let parts: {text: string; cell?: string}[] = [{text: name}];
74 < 2   for (const [k, v] of [...cells].sort(([, a], [, b]) => b.length - a.length))
75 < 2     parts = parts.flatMap((p) => (p.cell !== undefined ? [p] : p.text.split(v).flatMap((t, i) => (i ? [{text: '', cell: k}, {text: t}] : [{text: t}]))));
76 < 1   if (!parts.some((p) => p.cell !== undefined)) return name;
78 > 1   const template = parts.map((p) => (p.cell === undefined ? p.text : '${' + p.cell + '}')).join('');
79 < 1   if (!parts.some((p) => p.join)) return {$template: template};
80 < 1   const lookup = (j: NonNullable<Part['join']>) => ({$computed: 'lookup', args: {rows: {$state: LIST(j.table)}, id: {$item: j.by}, column: j.column}});
81 < 1   const used = parts.filter((p) => p.cell !== undefined);
82 < 1   if (used.length === 1 && used[0].join && template === '${' + used[0].cell + '}') return lookup(used[0].join);
83 < 1   const args: Json = {template};
84 < 1   for (const p of used) args[p.cell!] = p.join ? lookup(p.join) : {$item: p.cell};
85 < 1   return {$computed: 'format', args};
77 < 2   return {$template: parts.map((p) => (p.cell === undefined ? p.text : '${' + p.cell + '}')).join('')};
78 < 1 }
79 < 1 
80 < 1 /** Every candidate for one card, walking each story on a fresh store. A text box typed
81 < 1  *  for a row action sits in that row; after the walk, each control a story sees but never
82 < 1  *  uses, and each card action still without one, gets a control of its own. */
83 < 1 function candidatesFor(b: Bundle, card: Card, kit: Kit): Pieces {
84 < 1   const tools = new Map(kit.TOOLS.map((t) => [t.name, t]));
85 < 1   const mine = new Set(card.actions.map((a) => a.name));
86 < 1   const describe = (name: string) => tools.get(name)?.description ?? card.actions.find((a) => a.name === name)?.description ?? '';
87 < 1   const drafts = new Map<string, {k: string; name: string; example?: string}[]>();
88 < 1   const rowDrafts = new Map<string, string[]>();
89 < 1   const buttons: {name: string; action: string}[] = [];
90 < 1   const lists = new Map<string, {table: string; controls: RowControl[]}>();
91 < 1   const named = new Set<string>();
93 > 1   const seen: {role: 'button' | 'checkbox'; name: string; table: string; cells: Json; joins: Join[]}[] = [];
94 < 1   // a column some action takes as a row of a table, by name: a tag's todoId names a todo
95 < 1   const rowOf = new Map<string, string>();
96 < 1   for (const t of kit.TOOLS) for (const [k, p] of Object.entries(t.inputSchema?.properties ?? {})) if (typeof p['x-row-of'] === 'string') rowOf.set(k, p['x-row-of']);
98 > 1   const isKey = (column: string) => column === 'id' || rowOf.has(column);
97 < 1   const joinsOf = (store: any, table: string, cells: Json): Join[] =>
98 < 1     Object.entries(cells).flatMap(([k, v]) => {
99 < 1       const other = rowOf.get(k);
100 < 1       const named = other && other !== table && typeof v === 'string' ? store.getRow(other, v) : undefined;
101 < 1       return named && Object.keys(named).length ? [{cell: k, table: other!, cells: named as Json}] : [];
102 < 1     });
92 < 2   const seen: {role: 'button' | 'checkbox'; name: string; table: string; cells: Json}[] = [];
94 > 1   // makeStore gives the same schema every time
95 < 1   const schema: Record<string, Record<string, {type?: string}>> = JSON.parse(kit.makeStore().getTablesSchemaJson?.() ?? '{}');
96 < 1   // the tables each action changed when the stories ran it
97 < 1   const writes = new Map<string, string[]>();
93 < 2   let schema: Record<string, Record<string, {type?: string}>> = {};
94 < 1   const listOf = (table: string) => {
95 < 1     const l = lists.get(table) ?? {table, controls: []};
96 < 1     lists.set(table, l);
97 < 1     return l;
98 < 1   };
100 > 1   const rowControl = (type: 'ActionCheckbox' | 'ActionButton', name: string, action: string, arg: string, table: string, cells: Json, role: string, joins: Join[] = []): RowControl => {
102 > 1     const control: RowControl = {type, name, action, arg, label: fromRow(name, cells, joins, isKey), description: `${role === 'checkbox' ? 'a checkbox' : 'a button'} "${name}" (${describe(action)})`};
101 < 2     const control: RowControl = {type, name, action, arg, label: fromRow(name, cells, joins), description: `${role === 'checkbox' ? 'a checkbox' : 'a button'} "${name}" (${describe(action)})`};
99 < 2   const rowControl = (type: 'ActionCheckbox' | 'ActionButton', name: string, action: string, arg: string, table: string, cells: Json, role: string): RowControl => {
100 < 2     const control: RowControl = {type, name, action, arg, label: fromRow(name, cells), description: `${role === 'checkbox' ? 'a checkbox' : 'a button'} "${name}" (${describe(action)})`};
101 < 1     if (type === 'ActionCheckbox') {
102 < 1       const flag = Object.keys(schema[table] ?? {}).find((c) => schema[table][c]?.type === 'boolean');
103 < 1       if (flag) control.checked = {$item: flag};
104 < 1     }
105 < 1     return control;
106 < 1   };
107 < 1   for (const story of b.page.stories) {
108 < 1     const store = kit.makeStore();
109 < 2     schema = JSON.parse(store.getTablesSchemaJson?.() ?? '{}');
110 < 1     for (const step of story.steps) {
111 < 1       const tool = tools.get(step.tool);
112 < 1       const args = (step.args ?? {}) as Json;
113 < 1       for (const u of step.ui ?? []) named.add('type' in u ? u.type.name : u.click.name);
114 < 1       if (mine.has(step.tool)) {
115 < 1         const row = rowArg(tool);
116 < 1         const cells = (row ? store.getRow(row.table, String(args[row.arg])) ?? {} : {}) as Json;
118 > 1         const joins = row ? joinsOf(store, row.table, cells) : [];
117 < 1         for (const u of step.ui ?? []) {
118 < 1           if ('type' in u && u.type.role === 'textbox') {
119 < 1             const k = Object.keys(args).find((x) => args[x] === u.type.text);
120 < 1             if (!k) continue;
121 < 1             const text = typeof u.type.text === 'string' && u.type.text !== '' ? u.type.text : undefined;
122 < 1             if (row) {
123 < 1               const l = listOf(row.table);
124 < 1               const had = l.controls.find((c) => c.type === 'DraftInput' && c.action === step.tool && c.draft === k);
125 < 1               if (had) {
126 < 1                 if (had.example === undefined && text !== undefined) had.example = text;
127 < 1                 continue;
128 < 1               }
131 > 1               const control: RowControl = {type: 'DraftInput', name: u.type.name, action: step.tool, arg: row.arg, draft: k, label: fromRow(u.type.name, cells, joins, isKey), ...(text === undefined ? {} : {example: text}), description: `a text box "${u.type.name}", where you type the ${k} for ${step.tool}`};
130 > 2               const control: RowControl = {type: 'DraftInput', name: u.type.name, action: step.tool, arg: row.arg, draft: k, label: fromRow(u.type.name, cells, joins), ...(text === undefined ? {} : {example: text}), description: `a text box "${u.type.name}", where you type the ${k} for ${step.tool}`};
129 < 2               const control: RowControl = {type: 'DraftInput', name: u.type.name, action: step.tool, arg: row.arg, draft: k, label: fromRow(u.type.name, cells), ...(text === undefined ? {} : {example: text}), description: `a text box "${u.type.name}", where you type the ${k} for ${step.tool}`};
130 < 1               const button = l.controls.findIndex((c) => c.type === 'ActionButton' && c.action === step.tool);
131 < 1               l.controls.splice(button < 0 ? l.controls.length : button, 0, control);
132 < 1               rowDrafts.set(step.tool, [...(rowDrafts.get(step.tool) ?? []), k]);
133 < 1               continue;
134 < 1             }
135 < 1             const list = drafts.get(step.tool) ?? [];
136 < 1             const had = list.find((d) => d.k === k);
137 < 1             if (!had) list.push({k, name: u.type.name, ...(text === undefined ? {} : {example: text})});
138 < 1             else if (had.example === undefined && text !== undefined) had.example = text;
139 < 1             drafts.set(step.tool, list);
140 < 1           } else if ('click' in u && (u.click.role === 'button' || u.click.role === 'checkbox')) {
141 < 1             const name = u.click.name;
142 < 1             if (!row) {
143 < 1               if (u.click.role === 'button' && !buttons.some((x) => x.name === name && x.action === step.tool)) buttons.push({name, action: step.tool});
144 < 1               continue;
145 < 1             }
146 < 1             const l = listOf(row.table);
147 < 1             const type = u.click.role === 'checkbox' ? 'ActionCheckbox' : 'ActionButton';
148 < 1             if (l.controls.some((c) => c.type === type && c.action === step.tool)) continue;
150 > 1             l.controls.push(rowControl(type, name, step.tool, row.arg, row.table, cells, u.click.role, joins));
149 < 2             l.controls.push(rowControl(type, name, step.tool, row.arg, row.table, cells, u.click.role));
150 < 1           }
151 < 1         }
152 < 1       }
154 > 1       const before = store.getTables() as Record<string, unknown>;
153 < 1       tool?.run(store, args, step.as ?? null);
155 > 1       const after = store.getTables() as Record<string, unknown>;
156 < 1       for (const t of new Set([...Object.keys(before), ...Object.keys(after)]))
157 < 1         if (JSON.stringify(before[t]) !== JSON.stringify(after[t]) && !(writes.get(step.tool) ?? []).includes(t)) writes.set(step.tool, [...(writes.get(step.tool) ?? []), t]);
154 < 1       for (const see of step.see ?? []) {
155 < 1         if ((see.role !== 'button' && see.role !== 'checkbox') || !((see.count ?? 0) > 0) || seen.some((x) => x.name === see.name)) continue;
156 < 1         let best: {table: string; cells: Json; length: number} | undefined;
157 < 1         for (const [table, rows] of Object.entries(store.getTables() as Record<string, Record<string, Json>>))
158 < 1           for (const cells of Object.values(rows))
160 > 1             for (const [k, v] of Object.entries(cells))
161 < 1               if (!isKey(k) && typeof v === 'string' && v !== '' && see.name.includes(v) && v.length > (best?.length ?? 0)) best = {table, cells, length: v.length};
159 < 2             for (const v of Object.values(cells))
160 < 2               if (typeof v === 'string' && v !== '' && see.name.includes(v) && v.length > (best?.length ?? 0)) best = {table, cells, length: v.length};
162 > 1         if (best) seen.push({role: see.role, name: see.name, table: best.table, cells: best.cells, joins: joinsOf(store, best.table, best.cells)});
161 < 2         if (best) seen.push({role: see.role, name: see.name, table: best.table, cells: best.cells});
162 < 1       }
163 < 1     }
164 < 1   }
165 < 1   const controlled = (action: string) => buttons.some((x) => x.action === action) || [...lists.values()].some((l) => l.controls.some((c) => c.type !== 'DraftInput' && c.action === action));
166 < 1   for (const t of seen) {
167 < 1     if (named.has(t.name)) continue;
168 < 1     const action = card.actions.find((a) => {
169 < 1       const row = rowArg(tools.get(a.name));
170 < 1       return row?.table === t.table && Object.keys(tools.get(a.name)?.inputSchema?.properties ?? {}).length === 1 && !controlled(a.name);
171 < 1     });
172 < 1     if (!action) continue;
173 < 1     const row = rowArg(tools.get(action.name))!;
175 > 1     listOf(t.table).controls.push(rowControl(t.role === 'checkbox' ? 'ActionCheckbox' : 'ActionButton', t.name, action.name, row.arg, t.table, t.cells, t.role, t.joins));
174 < 2     listOf(t.table).controls.push(rowControl(t.role === 'checkbox' ? 'ActionCheckbox' : 'ActionButton', t.name, action.name, row.arg, t.table, t.cells, t.role));
175 < 1   }
176 < 1   for (const a of card.actions) {
177 < 1     if (controlled(a.name)) continue;
178 < 1     const row = rowArg(tools.get(a.name));
179 < 1     if (row) listOf(row.table).controls.push(rowControl('ActionButton', a.description, a.name, row.arg, row.table, {}, 'button'));
180 < 1     else buttons.push({name: a.description, action: a.name});
181 < 1   }
183 > 1   // A field two actions type into gets a draft of its own per action; any other keeps /draft/<field>.
184 < 1   const typers = new Map<string, Set<string>>();
185 < 1   for (const [action, ks] of [...[...drafts].map(([a, ds]) => [a, ds.map((d) => d.k)] as const), ...rowDrafts]) for (const k of ks) typers.set(k, (typers.get(k) ?? new Set()).add(action));
186 < 1   const draftKey = (action: string, k: string) => ((typers.get(k)?.size ?? 0) > 1 ? `${action}.${k}` : k);
182 < 1   for (const l of lists.values())
183 < 1     for (const c of l.controls) {
185 > 1       if (c.type === 'DraftInput') {
186 < 1         c.draft = draftKey(c.action, c.draft!);
187 < 1         continue;
188 < 1       }
184 < 2       if (c.type === 'DraftInput') continue;
185 < 1       c.args = {[c.arg]: {$item: 'id'}};
187 > 1       if (c.type === 'ActionButton') for (const k of rowDrafts.get(c.action) ?? []) c.args[k] = {$state: `/draft/${draftKey(c.action, k)}`};
186 < 2       if (c.type === 'ActionButton') for (const k of rowDrafts.get(c.action) ?? []) c.args[k] = {$state: `/draft/${k}`};
187 < 1     }
188 < 1   const required: Candidate[] = [];
189 < 1   for (const [action, ds] of drafts)
190 < 1     for (const d of ds)
192 > 1       required.push({id: `input_${action}_${d.k}`, root: false, description: `The text box "${d.name}", where you type the ${d.k} for ${action}: ${describe(action)}`, element: {type: 'DraftInput', props: {label: d.name, ...(d.example === undefined ? {} : {placeholder: d.example}), value: {$bindState: `/draft/${draftKey(action, d.k)}`}}}});
191 < 2       required.push({id: `input_${action}_${d.k}`, root: false, description: `The text box "${d.name}", where you type the ${d.k} for ${action}: ${describe(action)}`, element: {type: 'DraftInput', props: {label: d.name, ...(d.example === undefined ? {} : {placeholder: d.example}), value: {$bindState: `/draft/${d.k}`}}}});
192 < 1   for (const [i, x] of buttons.entries()) {
193 < 1     const ds = drafts.get(x.action) ?? [];
194 < 1     const props: Json = {label: x.name, action: x.action};
196 > 1     if (ds.length) props.args = Object.fromEntries(ds.map((d) => [d.k, {$state: `/draft/${draftKey(x.action, d.k)}`}]));
195 < 2     if (ds.length) props.args = Object.fromEntries(ds.map((d) => [d.k, {$state: `/draft/${d.k}`}]));
196 < 1     required.push({id: `button_${i}`, root: false, description: `The button "${x.name}": ${describe(x.action)}`, element: {type: 'ActionButton', props}});
197 < 1   }
198 < 1   for (const l of lists.values())
199 < 1     required.push({id: `list_${l.table}`, root: false, description: `The list of ${l.table}, one line per entry, each with ${l.controls.map((c) => c.description).join(', ')}`, element: {type: 'Separator', props: {}, visible: {$state: LIST(l.table)}}});
200 < 1   const candidates: Candidate[] = [
201 < 1     {id: 'card', maxUses: 3, description: 'A card: a puffy surface grouping what it holds', element: {type: 'Card', props: {}}},
202 < 1     {id: 'stack', maxUses: 3, description: 'A column: its children one above the other', element: {type: 'Stack', props: {gap: 3}}},
203 < 1     {id: 'row', maxUses: 3, root: false, description: 'A row: its children side by side', element: {type: 'Row', props: {gap: 2, align: 'center'}}},
204 < 1     {id: 'title', root: false, description: `The page title "${b.page.title}" as a heading`, element: {type: 'Heading', props: {text: b.page.title, level: 1}}},
205 < 1     {id: 'purpose', root: false, description: `What it is for, in muted text: "${card.purpose}"`, element: {type: 'Text', props: {text: card.purpose, muted: true}}},
206 < 1     ...required,
207 < 1   ];
209 > 1   const fields = new Map([...drafts].map(([action, ds]) => [action, ds.map((d) => draftKey(action, d.k))]));
210 < 1   return {candidates, required, lists, fields, writes};
208 < 2   const fields = new Map([...drafts].map(([action, ds]) => [action, ds.map((d) => d.k)]));
209 < 2   return {candidates, required, lists, fields};
210 < 1 }
