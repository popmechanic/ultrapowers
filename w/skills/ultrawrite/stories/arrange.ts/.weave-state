54 < 1 function arrangeSet() {
55 < 1   const s = loadQuestions().authoring_arrange as unknown as {guidance: string; versions: Record<string, string>};
56 < 1   if (!s?.versions) throw new CouldNotRun('questions.json has no authoring_arrange set');
57 < 1   return s;
58 < 1 }
