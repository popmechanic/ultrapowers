349 < 2 function cardsOf(b: Bundle, piece?: string): Card[] {
350 < 2   const cards = b.cards.filter((c) => !piece || c.piece === piece);
351 < 2   if (!cards.length) throw new CouldNotRun(`the bundle has no piece ${piece}`);
352 < 2   return cards;
