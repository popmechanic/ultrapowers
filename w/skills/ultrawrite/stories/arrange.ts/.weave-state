60 < 2 /** The row argument of an action: the input property carrying x-row-of, with its table. */
61 < 2 function rowArg(tool: Tool | undefined): {arg: string; table: string} | null {
62 < 2   for (const [k, p] of Object.entries(tool?.inputSchema?.properties ?? {})) if (typeof p['x-row-of'] === 'string') return {arg: k, table: p['x-row-of']};
63 < 2   return null;
64 < 2 }
