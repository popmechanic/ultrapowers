392 > 1 export async function reshape(opts: {bundle: string; app: string; spec: Spec; notes: string[]; evaluate: Evaluator}) {
391 < 2 export async function reshape(opts: {bundle: string; app: string; piece: string; spec: Spec; notes: string[]; evaluate: Evaluator}) {
392 < 1   const b = loadBundle(opts.bundle);
393 < 1   const kit = await loadKit(opts.app);
394 < 1   const set = arrangeSet();
398 > 1   const pieces = candidatesFor(b, kit);
399 < 1   const {candidates, required} = pieces;
400 < 1   const initialSpec = collapse(opts.spec, pieces.lines);
397 > 2   const {candidates, required, lists, fields, writes, heading} = candidatesFor(b, kit);
396 > 2   const {candidates, required, lists, fields, writes} = candidatesFor(b, kit);
395 < 2   const [card] = cardsOf(b, opts.piece);
397 > 2   const {candidates, required, lists, fields, writes} = candidatesFor(b, card, kit);
396 < 2   const {candidates, lists, fields} = candidatesFor(b, card, kit);
397 < 2   const initialSpec = collapse(opts.spec);
398 < 1   const out = await lastSpec(
399 < 1     kit.compose({
400 < 1       catalog: kit.catalog,
401 < 1       candidates,
402 < 1       evaluate: opts.evaluate,
403 < 1       instructions: {next: set.guidance},
404 < 1       context: contextOf(b),
405 < 1       initialSpec,
406 < 1       elementDescriptions: descriptionsOf(initialSpec, candidates),
407 < 1       prompt: opts.notes.join('\n'),
408 < 1     }),
409 < 1   );
410 < 1   if (!out.spec) throw new Error('the composer returned no screen');
412 > 1   const left = missing(out.spec, required);
413 < 1   if (left.length) throw new CouldNotRun(`the reshaped screen left out ${left.map((c) => c.description).join('; ')}`);
416 > 1   return {spec: expand(out.spec, pieces), steps: out.steps.map((s) => s.description)};
415 > 2   return {spec: expand(out.spec, lists, heading, fields, writes), steps: out.steps.map((s) => s.description)};
414 < 2   return {spec: expand(out.spec, lists, b.page.title, fields, writes), steps: out.steps.map((s) => s.description)};
411 < 2   return {spec: expand(out.spec, lists, b.page.title, fields), steps: out.steps.map((s) => s.description)};
412 < 1 }
