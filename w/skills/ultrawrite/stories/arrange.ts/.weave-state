343 < 1 async function lastSpec(events: AsyncGenerator<{type: string; spec: Spec | null; steps: {description: string}[]}>) {
344 < 1   let done: {spec: Spec | null; steps: {description: string}[]} = {spec: null, steps: []};
345 < 1   for await (const ev of events) if (ev.type === 'complete') done = ev;
346 < 1   return done;
347 < 1 }
