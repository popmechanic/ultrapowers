349 < 1 function cardsOf(b: Bundle, piece?: string): Card[] {
350 < 1   const cards = b.cards.filter((c) => !piece || c.piece === piece);
351 < 1   if (!cards.length) throw new CouldNotRun(`the bundle has no piece ${piece}`);
352 < 1   return cards;
353 < 1 }
354 < 1 
355 < 1 const contextOf = (b: Bundle) => ({app: b.page.title, stories: b.page.stories.map((s) => s.sentence)});
356 < 1 
357 < 1 export async function arrange(opts: {bundle: string; app: string; piece?: string; evaluate: Evaluator}) {
358 < 1   const b = loadBundle(opts.bundle);
359 < 1   const kit = await loadKit(opts.app);
360 < 1   const set = arrangeSet();
361 < 1   let calls = 0;
362 < 1   const evaluate: Evaluator = (r) => {
363 < 1     calls++;
364 < 1     return opts.evaluate(r);
365 < 1   };
366 < 1   const versions: Record<string, Record<string, Spec>> = {};
367 < 1   const dropped: Record<string, Record<string, string>> = {};
368 < 1   for (const card of cardsOf(b, opts.piece)) {
370 > 1     const {candidates, required, lists, fields, writes} = candidatesFor(b, card, kit);
369 < 2     const {candidates, required, lists, fields} = candidatesFor(b, card, kit);
370 < 1     const common = {catalog: kit.catalog, candidates, evaluate, instructions: {next: set.guidance}, context: contextOf(b)};
371 < 1     const results = await Promise.all(
372 < 1       Object.entries(set.versions).map(async ([v, sentence]) => {
373 < 1         const prompt = [...b.page.summary, card.purpose, sentence].join(' ');
374 < 1         let {spec} = await lastSpec(kit.compose({...common, prompt}));
375 < 1         let left = missing(spec, required);
376 < 1         if (spec && left.length) {
377 < 1           spec = (await lastSpec(kit.compose({...common, initialSpec: spec, elementDescriptions: descriptionsOf(spec, candidates), prompt: `Add ${left.map((c) => c.description).join('; ')}`}))).spec;
378 < 1           left = missing(spec, required);
379 < 1         }
381 > 1         return [v, left.length || !spec ? {why: `left out ${left.map((c) => c.description).join('; ')}`} : {spec: expand(spec, lists, b.page.title, fields, writes)}] as const;
380 < 2         return [v, left.length || !spec ? {why: `left out ${left.map((c) => c.description).join('; ')}`} : {spec: expand(spec, lists, b.page.title, fields)}] as const;
381 < 1       }),
382 < 1     );
383 < 1     for (const [v, r] of results) {
384 < 1       if ('spec' in r) (versions[card.piece] ??= {})[v] = r.spec;
385 < 1       else (dropped[card.piece] ??= {})[v] = r.why;
386 < 1     }
387 < 1   }
388 < 1   return {versions, dropped, calls};
389 < 1 }
390 < 1 
391 < 1 export async function reshape(opts: {bundle: string; app: string; piece: string; spec: Spec; notes: string[]; evaluate: Evaluator}) {
392 < 1   const b = loadBundle(opts.bundle);
393 < 1   const kit = await loadKit(opts.app);
394 < 1   const set = arrangeSet();
395 < 1   const [card] = cardsOf(b, opts.piece);
397 > 1   const {candidates, required, lists, fields, writes} = candidatesFor(b, card, kit);
396 < 2   const {candidates, lists, fields} = candidatesFor(b, card, kit);
397 < 1   const initialSpec = collapse(opts.spec);
398 < 1   const out = await lastSpec(
399 < 1     kit.compose({
400 < 1       catalog: kit.catalog,
401 < 1       candidates,
402 < 1       evaluate: opts.evaluate,
403 < 1       instructions: {next: set.guidance},
404 < 1       context: contextOf(b),
405 < 1       initialSpec,
406 < 1       elementDescriptions: descriptionsOf(initialSpec, candidates),
407 < 1       prompt: opts.notes.join('\n'),
408 < 1     }),
409 < 1   );
410 < 1   if (!out.spec) throw new Error('the composer returned no screen');
412 > 1   const left = missing(out.spec, required);
413 < 1   if (left.length) throw new CouldNotRun(`the reshaped screen left out ${left.map((c) => c.description).join('; ')}`);
414 < 1   return {spec: expand(out.spec, lists, b.page.title, fields, writes), steps: out.steps.map((s) => s.description)};
411 < 2   return {spec: expand(out.spec, lists, b.page.title, fields), steps: out.steps.map((s) => s.description)};
412 < 1 }
413 < 1 
414 < 1 const USAGE = 'usage: arrange.ts <bundle> --app <dir> [--piece <piece>] [--pick <V> | --reshape --note <text>...]';
415 < 1 const write = (path: string, spec: Spec) => writeFileSync(path, JSON.stringify(spec, null, 2) + '\n');
417 > 1 
418 < 1 /** A piece's kept versions as <screens>/<piece>.<V>.json, and any other version of it, left
419 < 1  *  from an earlier arrange, gone, so /compare shows only these. The approved
420 < 1  *  <piece>.json stays. */
421 < 1 export function writeVersions(screens: string, piece: string, kept: Record<string, Spec>) {
422 < 1   if (Object.keys(kept).length) mkdirSync(screens, {recursive: true});
423 < 1   if (existsSync(screens))
424 < 1     for (const f of readdirSync(screens)) {
425 < 1       const v = f.startsWith(`${piece}.`) && f.endsWith('.json') ? f.slice(piece.length + 1, -'.json'.length) : '';
426 < 1       if (v && !v.includes('.') && !Object.hasOwn(kept, v)) rmSync(join(screens, f));
427 < 1     }
428 < 1   for (const [v, spec] of Object.entries(kept)) write(join(screens, `${piece}.${v}.json`), spec);
429 < 1 }
416 < 1 
417 < 1 async function main(argv: string[]): Promise<number> {
418 < 1   const pos: string[] = [];
419 < 1   const notes: string[] = [];
420 < 1   const flags: Record<string, string> = {};
421 < 1   let reshaping = false;
422 < 1   for (let i = 0; i < argv.length; i++) {
423 < 1     const a = argv[i];
424 < 1     if (a === '--reshape') reshaping = true;
425 < 1     else if (a === '--note' && i + 1 < argv.length) notes.push(argv[++i]);
426 < 1     else if (['--app', '--piece', '--pick'].includes(a) && i + 1 < argv.length) flags[a.slice(2)] = argv[++i];
427 < 1     else if (a.startsWith('--')) return usage();
428 < 1     else pos.push(a);
429 < 1   }
430 < 1   if (pos.length !== 1 || !flags.app || (flags.pick && reshaping) || ((flags.pick || reshaping) && !flags.piece) || (reshaping && !notes.length) || (notes.length && !reshaping))
431 < 1     return usage();
432 < 1   const bundle = resolve(pos[0]);
433 < 1   const app = resolve(flags.app);
434 < 1   const screens = join(bundle, 'screens');
435 < 1   try {
436 < 1     for (const f of [join(app, 'client', 'src', 'screens', 'catalog.ts'), join(app, 'client', 'src', 'store.js')])
437 < 1       if (!existsSync(f)) throw new CouldNotRun(`no ${f}`);
438 < 1     if (flags.pick) {
439 < 1       const from = join(screens, `${flags.piece}.${flags.pick}.json`);
440 < 1       if (!existsSync(from)) throw new CouldNotRun(`no version ${flags.pick} of ${flags.piece} at ${from}`);
441 < 1       copyFileSync(from, join(screens, `${flags.piece}.json`));
442 < 1       console.log(`ARRANGE picked ${flags.piece} ${flags.pick}`);
443 < 1       return 0;
444 < 1     }
445 < 1     if (reshaping) {
446 < 1       const file = join(screens, `${flags.piece}.json`);
447 < 1       if (!existsSync(file)) throw new CouldNotRun(`no approved screen at ${file}`);
448 < 1       const spec = JSON.parse(readFileSync(file, 'utf8'));
449 < 1       const out = await reshape({bundle, app, piece: flags.piece, spec, notes, evaluate: composeEvaluator()}).catch(fail);
450 < 1       write(file, out.spec);
451 < 1       for (const s of out.steps) console.log(`ARRANGE ${flags.piece}: ${s}`);
452 < 1       console.log(`ARRANGE reshaped ${flags.piece}: ${out.steps.length} steps`);
453 < 1       return 0;
454 < 1     }
455 < 1     const started = performance.now();
456 < 1     const r = await arrange({bundle, app, piece: flags.piece, evaluate: composeEvaluator()}).catch(fail);
457 < 1     const empty: string[] = [];
458 < 1     for (const card of cardsOf(loadBundle(bundle), flags.piece)) {
459 < 1       const kept = r.versions[card.piece] ?? {};
461 > 1       writeVersions(screens, card.piece, kept);
462 < 1       for (const [v, spec] of Object.entries(kept)) console.log(`ARRANGE ${card.piece} ${v}: ${Object.keys(spec.elements).length} elements`);
460 < 2       if (Object.keys(kept).length) mkdirSync(screens, {recursive: true});
461 < 2       for (const [v, spec] of Object.entries(kept)) {
462 < 2         write(join(screens, `${card.piece}.${v}.json`), spec);
463 < 2         console.log(`ARRANGE ${card.piece} ${v}: ${Object.keys(spec.elements).length} elements`);
464 < 2       }
465 < 1       for (const [v, why] of Object.entries(r.dropped[card.piece] ?? {})) console.log(`ARRANGE ${card.piece} ${v}: dropped, ${why}`);
466 < 1       if (!Object.keys(kept).length) empty.push(card.piece);
467 < 1     }
468 < 1     if (empty.length) {
469 < 1       console.log(`ARRANGE exit 1: ${empty.join(', ')} kept no version`);
470 < 1       return 1;
471 < 1     }
472 < 1     console.log(`ARRANGE ok: ${r.calls} Jev calls, ${Math.round(performance.now() - started)} ms`);
473 < 1     return 0;
474 < 1   } catch (e) {
475 < 1     console.log(`ARRANGE could not run: ${(e as Error).message}`);
476 < 1     return 2;
477 < 1   }
478 < 1 }
479 < 1 
480 < 1 // Anything the composer or Jev throws stops the run as could-not-run.
481 < 1 function fail(e: unknown): never {
482 < 1   throw new CouldNotRun((e as Error)?.message ?? String(e));
483 < 1 }
484 < 1 
485 < 1 function usage(): number {
486 < 1   console.log(USAGE);
487 < 1   return 2;
488 < 1 }
489 < 1 
490 < 1 if (import.meta.main) process.exit(await main(process.argv.slice(2)));
491 < 1 