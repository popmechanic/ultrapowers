417 < 1 async function main(argv: string[]): Promise<number> {
418 < 1   const pos: string[] = [];
419 < 1   const notes: string[] = [];
420 < 1   const flags: Record<string, string> = {};
421 < 1   let reshaping = false;
422 < 1   for (let i = 0; i < argv.length; i++) {
423 < 1     const a = argv[i];
424 < 1     if (a === '--reshape') reshaping = true;
425 < 1     else if (a === '--note' && i + 1 < argv.length) notes.push(argv[++i]);
427 > 1     else if (['--app', '--pick'].includes(a) && i + 1 < argv.length) flags[a.slice(2)] = argv[++i];
426 < 2     else if (['--app', '--piece', '--pick'].includes(a) && i + 1 < argv.length) flags[a.slice(2)] = argv[++i];
427 < 1     else if (a.startsWith('--')) return usage();
428 < 1     else pos.push(a);
429 < 1   }
431 > 1   if (pos.length !== 1 || !flags.app || (flags.pick && reshaping) || (reshaping && !notes.length) || (notes.length && !reshaping)) return usage();
430 < 2   if (pos.length !== 1 || !flags.app || (flags.pick && reshaping) || ((flags.pick || reshaping) && !flags.piece) || (reshaping && !notes.length) || (notes.length && !reshaping))
431 < 2     return usage();
432 < 1   const bundle = resolve(pos[0]);
433 < 1   const app = resolve(flags.app);
434 < 1   const screens = join(bundle, 'screens');
436 > 1   const file = join(screens, 'screen.json');
435 < 1   try {
436 < 1     for (const f of [join(app, 'client', 'src', 'screens', 'catalog.ts'), join(app, 'client', 'src', 'store.js')])
437 < 1       if (!existsSync(f)) throw new CouldNotRun(`no ${f}`);
438 < 1     if (flags.pick) {
440 > 1       if (!/^[A-Za-z0-9_-]+$/.test(flags.pick)) return usage();
441 < 1       const from = join(screens, `screen.${flags.pick}.json`);
442 < 1       if (!existsSync(from)) throw new CouldNotRun(`no version ${flags.pick} at ${from}`);
443 < 1       copyFileSync(from, file);
444 < 1       console.log(`ARRANGE picked ${flags.pick}`);
439 < 2       const from = join(screens, `${flags.piece}.${flags.pick}.json`);
440 < 2       if (!existsSync(from)) throw new CouldNotRun(`no version ${flags.pick} of ${flags.piece} at ${from}`);
441 < 2       copyFileSync(from, join(screens, `${flags.piece}.json`));
442 < 2       console.log(`ARRANGE picked ${flags.piece} ${flags.pick}`);
443 < 1       return 0;
444 < 1     }
445 < 1     if (reshaping) {
446 < 2       const file = join(screens, `${flags.piece}.json`);
447 < 1       if (!existsSync(file)) throw new CouldNotRun(`no approved screen at ${file}`);
448 < 1       const spec = JSON.parse(readFileSync(file, 'utf8'));
450 > 1       const out = await reshape({bundle, app, spec, notes, evaluate: composeEvaluator()}).catch(fail);
449 < 2       const out = await reshape({bundle, app, piece: flags.piece, spec, notes, evaluate: composeEvaluator()}).catch(fail);
450 < 1       write(file, out.spec);
452 > 1       for (const s of out.steps) console.log(`ARRANGE: ${s}`);
453 < 1       console.log(`ARRANGE reshaped: ${out.steps.length} steps`);
451 < 2       for (const s of out.steps) console.log(`ARRANGE ${flags.piece}: ${s}`);
452 < 2       console.log(`ARRANGE reshaped ${flags.piece}: ${out.steps.length} steps`);
453 < 1       return 0;
454 < 1     }
455 < 1     const started = performance.now();
457 > 1     const r = await arrange({bundle, app, evaluate: composeEvaluator()}).catch(fail);
458 < 1     writeVersions(screens, r.versions);
459 < 1     for (const [v, spec] of Object.entries(r.versions)) console.log(`ARRANGE ${v}: ${Object.keys(spec.elements).length} elements`);
460 < 1     for (const [v, why] of Object.entries(r.dropped)) console.log(`ARRANGE ${v}: dropped, ${why}`);
461 < 1     if (!Object.keys(r.versions).length) {
462 < 1       console.log('ARRANGE exit 1: the page kept no version');
456 < 2     const r = await arrange({bundle, app, piece: flags.piece, evaluate: composeEvaluator()}).catch(fail);
457 < 2     const empty: string[] = [];
458 < 2     for (const card of cardsOf(loadBundle(bundle), flags.piece)) {
459 < 2       const kept = r.versions[card.piece] ?? {};
461 > 2       writeVersions(screens, card.piece, kept);
462 < 2       for (const [v, spec] of Object.entries(kept)) console.log(`ARRANGE ${card.piece} ${v}: ${Object.keys(spec.elements).length} elements`);
460 < 2       if (Object.keys(kept).length) mkdirSync(screens, {recursive: true});
461 < 2       for (const [v, spec] of Object.entries(kept)) {
462 < 2         write(join(screens, `${card.piece}.${v}.json`), spec);
463 < 2         console.log(`ARRANGE ${card.piece} ${v}: ${Object.keys(spec.elements).length} elements`);
464 < 2       }
465 < 2       for (const [v, why] of Object.entries(r.dropped[card.piece] ?? {})) console.log(`ARRANGE ${card.piece} ${v}: dropped, ${why}`);
466 < 2       if (!Object.keys(kept).length) empty.push(card.piece);
467 < 2     }
468 < 2     if (empty.length) {
469 < 2       console.log(`ARRANGE exit 1: ${empty.join(', ')} kept no version`);
470 < 1       return 1;
471 < 1     }
472 < 1     console.log(`ARRANGE ok: ${r.calls} Jev calls, ${Math.round(performance.now() - started)} ms`);
473 < 1     return 0;
474 < 1   } catch (e) {
475 < 1     console.log(`ARRANGE could not run: ${(e as Error).message}`);
476 < 1     return 2;
477 < 1   }
478 < 1 }
479 < 1 
480 < 1 // Anything the composer or Jev throws stops the run as could-not-run.
481 < 1 function fail(e: unknown): never {
482 < 1   throw new CouldNotRun((e as Error)?.message ?? String(e));
483 < 1 }
484 < 1 
485 < 1 function usage(): number {
486 < 1   console.log(USAGE);
487 < 1   return 2;
488 < 1 }
489 < 1 
490 < 1 if (import.meta.main) process.exit(await main(process.argv.slice(2)));
