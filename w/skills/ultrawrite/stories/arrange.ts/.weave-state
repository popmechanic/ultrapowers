81 < 1 const slotsOf = (words: string) => [...words.matchAll(/\$\{([^}]+)\}/g)].map((m) => m[1]);
82 < 1 
83 < 1 /** A row's cell `${cell}`, or `${col.cell}` the cell of the row column `col` names. */
84 < 1 function cellOf(t: string, words: string, rowOf: Map<string, string>): unknown {
85 < 1   if (!t.includes('.')) return {$item: t};
86 < 1   const [by, column] = [t.slice(0, t.indexOf('.')), t.slice(t.indexOf('.') + 1)];
87 < 1   const table = rowOf.get(by);
88 < 1   if (!table) throw new CouldNotRun(`the words "${words}" name ${by}, which names no table's row`);
89 < 1   return {$computed: 'lookup', args: {rows: {$state: LIST(table)}, id: {$item: by}, column}};
90 < 1 }
