29 < 1 const VENDOR = join(import.meta.dir, 'vendor', 'json-render');
30 < 1 const LIST = (table: string) => `/tables/${table}`;
31 < 1 const isObj = (v: unknown): v is Json => typeof v === 'object' && v !== null && !Array.isArray(v);
32 < 1 
33 < 1 // Object keys sorted, as the composer compares recipes.
34 < 1 const recipeKey = (v: unknown) =>
35 < 1   JSON.stringify(v, (_k, x) => (isObj(x) ? Object.fromEntries(Object.entries(x).sort(([a], [b]) => a.localeCompare(b))) : x));
36 < 1 const atomic = (e: Element) => ({type: e.type, props: e.props, ...(e.on === undefined ? {} : {on: e.on}), ...(e.visible === undefined ? {} : {visible: e.visible})});
