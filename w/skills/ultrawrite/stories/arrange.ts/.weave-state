0 < 1 #!/usr/bin/env bun
1 < 1 // Jev arranges each piece's screen from what the app can do. The candidates come
2 < 1 // from the bundle by code: every control a story's `ui` step names (a bound
3 < 1 // DraftInput, a bound ActionButton, a list of a table's rows), a few containers,
4 < 1 // the page title and the card's purpose. Jev only chooses and places them, through
5 < 1 // json-render's composer, once per version of questions.json's authoring_arrange.
6 < 1 // The kit is the installed TinyApp's: its catalog and store, and the composer copied
7 < 1 // to <app>/.preview/json-render/ so it shares the app's zod.
8 < 1 //
9 < 1 //   bun skills/ultrawrite/stories/arrange.ts <bundle> --app <dir> [--piece <piece>]
10 < 1 //   bun skills/ultrawrite/stories/arrange.ts <bundle> --app <dir> --piece <p> --pick <V>
11 < 1 //   bun skills/ultrawrite/stories/arrange.ts <bundle> --app <dir> --piece <p> --reshape --note <text> [--note <text>...]
13 > 1 import {copyFileSync, cpSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync} from 'node:fs';
12 < 2 import {copyFileSync, cpSync, existsSync, mkdirSync, readFileSync, writeFileSync} from 'node:fs';
13 < 1 import {join, resolve} from 'node:path';
14 < 1 import {loadBundle, type Bundle, type Card} from './bundle';
15 < 1 import {composeEvaluator, loadQuestions} from './jev';
16 < 1 
17 < 1 type Json = Record<string, unknown>;
18 < 1 type Element = {type: string; props: Json; children?: string[]; on?: Json; visible?: unknown; repeat?: {statePath: string; key?: string}};
19 < 1 export type Spec = {root: string; elements: Record<string, Element>; state?: Json};
20 < 1 export type Evaluator = (request: {state: Json; questions: Record<string, {criteria: Record<string, string>}>; signal: AbortSignal}) => Promise<{answers: Record<string, {choice: string; confidence?: number}>}>;
21 < 1 type Candidate = {id: string; description: string; element: Pick<Element, 'type' | 'props' | 'visible'>; root?: boolean; maxUses?: number};
22 < 1 type RowControl = {type: 'ActionCheckbox' | 'ActionButton' | 'DraftInput'; name: string; action: string; arg: string; label: unknown; checked?: unknown; draft?: string; example?: string; args?: Json; description: string};
23 < 1 type Kit = {compose: (o: Json) => AsyncGenerator<{type: string; spec: Spec | null; steps: {description: string}[]}>; catalog: unknown; TOOLS: Tool[]; makeStore: () => any};
24 < 1 type Tool = {name: string; description: string; inputSchema?: {properties?: Record<string, Json>}; run: (store: unknown, args: unknown, as: unknown) => unknown};
26 > 1 type Pieces = {candidates: Candidate[]; required: Candidate[]; lists: Map<string, {table: string; controls: RowControl[]}>; fields: Map<string, string[]>; writes: Map<string, string[]>};
25 < 2 type Pieces = {candidates: Candidate[]; required: Candidate[]; lists: Map<string, {table: string; controls: RowControl[]}>; fields: Map<string, string[]>};
26 < 1 
27 < 1 export class CouldNotRun extends Error {}
28 < 1 
29 < 1 const VENDOR = join(import.meta.dir, 'vendor', 'json-render');
30 < 1 const LIST = (table: string) => `/tables/${table}`;
31 < 1 const isObj = (v: unknown): v is Json => typeof v === 'object' && v !== null && !Array.isArray(v);
32 < 1 
33 < 1 // Object keys sorted, as the composer compares recipes.
34 < 1 const recipeKey = (v: unknown) =>
35 < 1   JSON.stringify(v, (_k, x) => (isObj(x) ? Object.fromEntries(Object.entries(x).sort(([a], [b]) => a.localeCompare(b))) : x));
36 < 1 const atomic = (e: Element) => ({type: e.type, props: e.props, ...(e.on === undefined ? {} : {on: e.on}), ...(e.visible === undefined ? {} : {visible: e.visible})});
37 < 1 
38 < 1 /** The app's catalog, store and a staged copy of the composer, or CouldNotRun. */
39 < 1 async function loadKit(app: string): Promise<Kit> {
40 < 1   const dir = resolve(app);
41 < 1   const catPath = join(dir, 'client', 'src', 'screens', 'catalog.ts');
42 < 1   const storePath = join(dir, 'client', 'src', 'store.js');
43 < 1   if (!existsSync(catPath)) throw new CouldNotRun(`no catalog module at ${catPath}`);
44 < 1   if (!existsSync(storePath)) throw new CouldNotRun(`no store module at ${storePath}`);
45 < 1   const stage = join(dir, '.preview', 'json-render');
46 < 1   mkdirSync(stage, {recursive: true});
47 < 1   cpSync(VENDOR, stage, {recursive: true});
48 < 1   const cat = await import(catPath);
49 < 1   const store = await import(storePath);
50 < 1   const composer = await import(join(stage, 'experimental-compose.ts'));
51 < 1   return {compose: composer.experimental_composeSpec, catalog: cat.catalogFor(store.TOOLS), TOOLS: store.TOOLS, makeStore: store.makeStore};
52 < 1 }
53 < 1 
54 < 1 function arrangeSet() {
55 < 1   const s = loadQuestions().authoring_arrange as unknown as {guidance: string; versions: Record<string, string>};
56 < 1   if (!s?.versions) throw new CouldNotRun('questions.json has no authoring_arrange set');
57 < 1   return s;
58 < 1 }
