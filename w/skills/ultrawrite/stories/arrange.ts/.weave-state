92 < 1 /** A page line's slot: a value in state.values, `sum t.c`, `count t` or `count t c=v`. */
93 < 1 function totalOf(t: string): unknown {
94 < 1   const sum = t.match(/^sum\s+([^\s.]+)\.(\S+)$/);
95 < 1   if (sum) return {$computed: 'sum', args: {rows: {$state: LIST(sum[1])}, column: sum[2]}};
96 < 1   const count = t.match(/^count\s+(\S+)(?:\s+([^\s=]+)=(.*))?$/);
97 < 1   if (count) return {$computed: 'count', args: {rows: {$state: LIST(count[1])}, where: count[2] ? {[count[2]]: count[3]} : {}}};
98 < 1   return {$state: `/values/${t}`};
99 < 1 }
