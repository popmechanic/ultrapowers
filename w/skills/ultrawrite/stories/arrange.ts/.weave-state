327 > 1 /** Each element that is one side of a page line made the other side. */
328 < 1 function swap(spec: Spec, lines: Line[], from: keyof Line, to: keyof Line) {
329 < 1   const by = new Map(lines.map((l) => [recipeKey(l[from]), l[to]]));
330 < 1   for (const e of Object.values(spec.elements)) {
331 < 1     const other = e.on === undefined && e.visible === undefined ? by.get(recipeKey(atomic(e))) : undefined;
332 < 1     if (other) e.props = structuredClone(other.props);
333 < 1   }
334 < 1 }
