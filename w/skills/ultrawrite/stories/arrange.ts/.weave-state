415 > 1 const USAGE = 'usage: arrange.ts <bundle> --app <dir> [--pick <V> | --reshape --note <text>...]';
414 < 2 const USAGE = 'usage: arrange.ts <bundle> --app <dir> [--piece <piece>] [--pick <V> | --reshape --note <text>...]';
415 < 1 const write = (path: string, spec: Spec) => writeFileSync(path, JSON.stringify(spec, null, 2) + '\n');
417 > 1 
419 > 1 /** The page's kept versions as <screens>/screen.<V>.json, and any other version, left
418 < 2 /** A piece's kept versions as <screens>/<piece>.<V>.json, and any other version of it, left
419 < 1  *  from an earlier arrange, gone, so /compare shows only these. The approved
421 > 1  *  screen.json stays. */
422 < 1 export function writeVersions(screens: string, kept: Record<string, Spec>) {
420 < 2  *  <piece>.json stays. */
421 < 2 export function writeVersions(screens: string, piece: string, kept: Record<string, Spec>) {
422 < 1   if (Object.keys(kept).length) mkdirSync(screens, {recursive: true});
423 < 1   if (existsSync(screens))
424 < 1     for (const f of readdirSync(screens)) {
426 > 1       const v = f.startsWith('screen.') && f.endsWith('.json') ? f.slice('screen.'.length, -'.json'.length) : '';
425 < 2       const v = f.startsWith(`${piece}.`) && f.endsWith('.json') ? f.slice(piece.length + 1, -'.json'.length) : '';
426 < 1       if (v && !v.includes('.') && !Object.hasOwn(kept, v)) rmSync(join(screens, f));
427 < 1     }
429 > 1   for (const [v, spec] of Object.entries(kept)) write(join(screens, `screen.${v}.json`), spec);
428 < 2   for (const [v, spec] of Object.entries(kept)) write(join(screens, `${piece}.${v}.json`), spec);
429 < 1 }
