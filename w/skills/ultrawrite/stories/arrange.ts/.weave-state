223 < 1 /** The composer's layout made real: each list placeholder a repeat over its table,
224 < 1  *  each draft-reading button clearing its drafts once it ran, the page title (one,
225 < 1  *  added if left out) first under the root, the controls in the order of use, empty
226 < 1  *  containers gone. */
228 > 1 function expand(input: Spec, lists: Pieces['lists'], title: string, fields: Pieces['fields'], writes: Pieces['writes']): Spec {
227 < 2 function expand(input: Spec, lists: Pieces['lists'], title: string, fields: Pieces['fields']): Spec {
228 < 1   const spec: Spec = structuredClone({root: input.root, elements: input.elements});
229 < 1   for (const [id, e] of Object.entries(spec.elements)) {
230 < 1     const path = isObj(e.visible) ? e.visible.$state : undefined;
231 < 1     const list = e.type === 'Separator' && typeof path === 'string' && path.startsWith('/tables/') ? lists.get(path.slice('/tables/'.length)) : undefined;
232 < 1     if (list) {
233 < 1       const row = `${id}_row`;
234 < 1       const kids = list.controls.map((_, i) => `${id}_${i}`);
235 < 1       spec.elements[id] = {type: 'Stack', props: {gap: 2}, repeat: {statePath: LIST(list.table), key: 'id'}, children: [row]};
236 < 1       spec.elements[row] = {type: 'Row', props: {justify: 'between', align: 'center'}, children: kids};
237 < 1       list.controls.forEach((c, i) => {
238 < 1         if (c.type === 'DraftInput') {
239 < 1           spec.elements[kids[i]] = {type: 'DraftInput', props: {label: c.label, ...(c.example === undefined ? {} : {placeholder: c.example}), value: {$bindState: `/draft/${c.draft}`}}, children: []};
240 < 1           return;
241 < 1         }
242 < 1         const props: Json = {label: c.label, ...(c.checked === undefined ? {} : {checked: c.checked}), action: c.action, args: c.args};
243 < 1         if (c.type === 'ActionButton') Object.assign(props, {variant: 'quiet', size: 'sm'});
244 < 1         const clear = Object.values(c.args ?? {}).flatMap((v) => (isObj(v) && typeof v.$state === 'string' ? [{action: 'setState', params: {statePath: v.$state, value: ''}}] : []));
245 < 1         spec.elements[kids[i]] = {type: c.type, props, children: [], ...(c.type === 'ActionButton' && clear.length ? {on: {press: clear.length === 1 ? clear[0] : clear}} : {})};
246 < 1       });
247 < 1       continue;
248 < 1     }
249 < 1     if (e.type === 'ActionButton' && isObj(e.props.args)) {
250 < 1       const paths = Object.values(e.props.args).map((v) => (isObj(v) ? v.$state : undefined)).filter((p): p is string => typeof p === 'string' && p.startsWith('/draft/'));
251 < 1       const clear = paths.map((p) => ({action: 'setState', params: {statePath: p, value: ''}}));
252 < 1       if (clear.length) e.on = {press: clear.length === 1 ? clear[0] : clear};
253 < 1     }
254 < 1   }
255 < 1   const heading = {type: 'Heading', props: {text: title, level: 1}};
256 < 1   const titles = Object.keys(spec.elements).filter((id) => id !== spec.root && recipeKey(atomic(spec.elements[id])) === recipeKey(heading));
257 < 1   let keep = titles[0];
258 < 1   if (!keep) {
259 < 1     keep = 'title';
260 < 1     for (let i = 1; spec.elements[keep]; i++) keep = `title_${i}`;
261 < 1     spec.elements[keep] = {...heading, children: []};
262 < 1   }
263 < 1   for (const id of titles.slice(1)) delete spec.elements[id];
264 < 1   for (const p of Object.values(spec.elements)) if (p.children?.some((c) => titles.includes(c))) p.children = p.children.filter((c) => !titles.includes(c));
265 < 1   const root = spec.elements[spec.root];
266 < 1   root.children = [keep, ...(root.children ?? []).filter((c) => c !== keep)];
268 > 1   inUseOrder(spec, fields, writes);
267 < 2   inUseOrder(spec, fields);
268 < 1   const containers = new Set(['Card', 'Stack', 'Row', 'Grid']);
269 < 1   for (let changed = true; changed; ) {
270 < 1     changed = false;
271 < 1     for (const [id, e] of Object.entries(spec.elements)) {
272 < 1       if (id === spec.root || !containers.has(e.type) || e.repeat || (e.children ?? []).length) continue;
273 < 1       delete spec.elements[id];
274 < 1       for (const p of Object.values(spec.elements)) if (p.children?.includes(id)) p.children = p.children.filter((c) => c !== id);
275 < 1       changed = true;
276 < 1     }
277 < 1   }
278 < 1   return spec;
279 < 1 }
280 < 1 
281 < 1 /** The order a person uses the screen, by code (#1510). An action's text boxes, in the
282 < 1  *  order the stories type into them, sit directly before its button, gathered where the
284 > 1  *  first box sits. A whole-list button (no args) sits just below its list (the list of
285 < 1  *  the one table its action changed; with one list on the screen, that one), unless it,
286 < 1  *  or the wrapper holding only it, is already right beside the list. Anything already in
283 < 2  *  first box sits. A whole-list button (no args) sits just below its list, unless it, or
284 < 2  *  the wrapper holding only it, is already right beside the list. Anything already in
285 < 1  *  order is left as composed, so the versions keep their own containers. */
287 > 1 function inUseOrder(spec: Spec, fields: Pieces['fields'], writes: Pieces['writes']) {
286 < 2 function inUseOrder(spec: Spec, fields: Pieces['fields']) {
287 < 1   const parentOf = (id: string) => Object.keys(spec.elements).find((p) => spec.elements[p].children?.includes(id));
288 < 1   const take = (id: string) => {
289 < 1     const p = parentOf(id);
290 < 1     if (p) spec.elements[p].children = spec.elements[p].children!.filter((c) => c !== id);
291 < 1   };
292 < 1   const draftOf = (e: Element) => {
293 < 1     const path = isObj(e.props.value) ? e.props.value.$bindState : undefined;
294 < 1     return typeof path === 'string' && path.startsWith('/draft/') ? path.slice('/draft/'.length) : undefined;
295 < 1   };
296 < 1   const els = () => Object.entries(spec.elements);
297 < 1   for (const [action, keys] of fields) {
298 < 1     const boxes = keys.map((k) => els().find(([, e]) => e.type === 'DraftInput' && draftOf(e) === k)?.[0]).filter((id): id is string => !!id);
299 < 1     const button = els().find(([, e]) => e.type === 'ActionButton' && e.props.action === action && isObj(e.props.args))?.[0];
300 < 1     const group = button ? [...boxes, button] : boxes;
301 < 1     const home = group.length > 1 ? parentOf(group[0]) : undefined;
302 < 1     if (!home) continue;
303 < 1     const kids = spec.elements[home].children!;
304 < 1     const at = kids.indexOf(group[0]);
305 < 1     if (recipeKey(kids.slice(at, at + group.length)) === recipeKey(group)) continue;
306 < 1     const before = kids.slice(0, at).filter((c) => !group.includes(c)).length;
307 < 1     for (const id of group) take(id);
308 < 1     spec.elements[home].children!.splice(before, 0, ...group);
309 < 1   }
311 > 1   const all = els().filter(([, e]) => e.repeat?.statePath?.startsWith('/tables/')).map(([id]) => id);
310 < 2   const list = els().find(([, e]) => e.repeat?.statePath?.startsWith('/tables/'))?.[0];
311 < 2   const listParent = list && parentOf(list);
312 < 2   if (!list || !listParent) return;
313 < 1   for (const [id, e] of els()) {
314 < 1     if (e.type !== 'ActionButton' || e.props.args !== undefined) continue;
316 > 1     const changed = (writes.get(String(e.props.action)) ?? []).map(LIST);
317 < 1     const own = all.filter((l) => changed.includes(spec.elements[l].repeat!.statePath));
318 < 1     const list = own.length === 1 ? own[0] : all.length === 1 ? all[0] : undefined;
319 < 1     const listParent = list && parentOf(list);
320 < 1     if (!list || !listParent) continue;
315 < 1     let mover = id;
316 < 1     for (let p = parentOf(mover); p && p !== spec.root && spec.elements[p].children!.length === 1; p = parentOf(p)) mover = p;
317 < 1     const kids = spec.elements[listParent].children!;
318 < 1     const i = kids.indexOf(list);
319 < 1     if (kids[i - 1] === mover || kids[i + 1] === mover) continue;
320 < 1     take(mover);
321 < 1     const now = spec.elements[listParent].children!;
322 < 1     now.splice(now.indexOf(list) + 1, 0, mover);
323 < 1   }
324 < 1 }
325 < 1 
326 < 1 /** An expanded spec folded back to what the composer may read: lists as placeholders, no `on`. */
327 < 1 function collapse(input: Spec): Spec {
328 < 1   const spec: Spec = structuredClone({root: input.root, elements: input.elements});
329 < 1   const drop = (id: string): void => {
330 < 1     for (const c of spec.elements[id]?.children ?? []) drop(c);
331 < 1     delete spec.elements[id];
332 < 1   };
333 < 1   for (const [id, e] of Object.entries(spec.elements)) {
334 < 1     if (!spec.elements[id]) continue;
335 < 1     if (e.repeat?.statePath?.startsWith('/tables/')) {
336 < 1       for (const c of e.children ?? []) drop(c);
337 < 1       spec.elements[id] = {type: 'Separator', props: {}, visible: {$state: e.repeat.statePath}, children: []};
338 < 1     } else if (e.type === 'ActionButton') delete e.on;
339 < 1   }
340 < 1   return spec;
341 < 1 }
