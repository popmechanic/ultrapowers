68 > 1 /** A control's words, read off its card: plain text, or for a control in a row, with
69 < 1  *  `${cell}` naming a cell of that row and `${col.cell}` a cell of the row that column
70 < 1  *  `col` names, read by `lookup` (#1524) and put together by `format`. */
71 < 1 function wordsOf(label: string, rowOf: Map<string, string>, inRow: boolean): unknown {
73 > 1   const tokens = inRow ? slotsOf(label) : [];
72 < 2   const tokens = inRow ? [...label.matchAll(/\$\{([^}]+)\}/g)].map((m) => m[1]) : [];
73 < 1   if (!tokens.length) return label;
74 < 1   const whole = tokens.length === 1 && label === '${' + tokens[0] + '}';
75 < 1   if (tokens.every((t) => !t.includes('.'))) return whole ? {$item: tokens[0]} : {$template: label};
77 > 1   if (whole) return cellOf(tokens[0], label, rowOf);
76 < 2   const lookup = (t: string) => {
77 < 2     const [by, column] = [t.slice(0, t.indexOf('.')), t.slice(t.indexOf('.') + 1)];
78 < 2     const table = rowOf.get(by);
79 < 2     if (!table) throw new CouldNotRun(`the words "${label}" name ${by}, which names no table's row`);
80 < 2     return {$computed: 'lookup', args: {rows: {$state: LIST(table)}, id: {$item: by}, column}};
81 < 2   };
82 < 2   if (whole) return lookup(tokens[0]);
83 < 1   const args: Json = {template: label};
85 > 1   for (const t of tokens) args[t] ??= cellOf(t, label, rowOf);
84 < 2   for (const t of tokens) args[t] ??= t.includes('.') ? lookup(t) : {$item: t};
67 > 2 /** A row that a cell of this row names: the cell (a column some action takes as a row of
68 < 2  *  `table`), that table, and the named row's cells. */
69 < 2 type Join = {cell: string; table: string; cells: Json};
70 < 2 
66 < 2 /** A row control's name with the row's string cells put back as expressions: the
68 > 2  *  one cell it equals, or every cell it holds, longest first. Text left over that a
69 < 2  *  joined row's cell holds is read from that row by `lookup` (#1524), the whole label
71 > 2  *  then put together by `format`. A cell `skip` names (an id, or a column naming a row)
72 < 2  *  is never cut out of the text: it is a key, left to the joins. */
73 < 2 function fromRow(name: string, row: Json, joins: Join[] = [], skip: (column: string) => boolean = () => false): unknown {
74 < 2   const strings = (o: Json) => Object.entries(o).filter(([k, v]) => typeof v === 'string' && v !== '' && !skip(k)) as [string, string][];
70 < 2  *  then put together by `format`. */
71 < 2 function fromRow(name: string, row: Json, joins: Join[] = []): unknown {
72 < 2   const strings = (o: Json) => Object.entries(o).filter(([, v]) => typeof v === 'string' && v !== '') as [string, string][];
73 < 2   const cells = strings(row);
67 < 2  *  one cell it equals, or every cell it holds, longest first. */
68 < 2 function fromRow(name: string, row: Json): unknown {
69 < 2   const cells = Object.entries(row).filter(([, v]) => typeof v === 'string' && v !== '') as [string, string][];
70 < 2   const exact = cells.find(([, v]) => v === name);
71 < 2   if (exact) return {$item: exact[0]};
72 < 2   // Text and inserted expressions alternate; only text is searched, so no cell lands inside a ${...}.
74 > 2   type Part = {text: string; cell?: string; join?: {by: string; table: string; column: string}};
75 < 2   let parts: Part[] = [{text: name}];
76 < 2   const cut = (v: string, part: Omit<Part, 'text'>) =>
77 < 2     (parts = parts.flatMap((p) => (p.cell !== undefined ? [p] : p.text.split(v).flatMap((t, i) => (i ? [{text: '', ...part}, {text: t}] : [{text: t}])))));
78 < 2   for (const [k, v] of [...cells].sort(([, a], [, b]) => b.length - a.length)) cut(v, {cell: k});
79 < 2   const joined = joins.flatMap((j) => strings(j.cells).map(([column, v]) => ({v, by: j.cell, table: j.table, column})));
80 < 2   for (const j of joined.sort((a, b) => b.v.length - a.v.length)) cut(j.v, {cell: `${j.by}.${j.column}`, join: j});
73 < 2   let parts: {text: string; cell?: string}[] = [{text: name}];
74 < 2   for (const [k, v] of [...cells].sort(([, a], [, b]) => b.length - a.length))
75 < 2     parts = parts.flatMap((p) => (p.cell !== undefined ? [p] : p.text.split(v).flatMap((t, i) => (i ? [{text: '', cell: k}, {text: t}] : [{text: t}]))));
76 < 2   if (!parts.some((p) => p.cell !== undefined)) return name;
78 > 2   const template = parts.map((p) => (p.cell === undefined ? p.text : '${' + p.cell + '}')).join('');
79 < 2   if (!parts.some((p) => p.join)) return {$template: template};
80 < 2   const lookup = (j: NonNullable<Part['join']>) => ({$computed: 'lookup', args: {rows: {$state: LIST(j.table)}, id: {$item: j.by}, column: j.column}});
81 < 2   const used = parts.filter((p) => p.cell !== undefined);
82 < 2   if (used.length === 1 && used[0].join && template === '${' + used[0].cell + '}') return lookup(used[0].join);
83 < 2   const args: Json = {template};
84 < 2   for (const p of used) args[p.cell!] = p.join ? lookup(p.join) : {$item: p.cell};
85 < 1   return {$computed: 'format', args};
77 < 2   return {$template: parts.map((p) => (p.cell === undefined ? p.text : '${' + p.cell + '}')).join('')};
78 < 1 }
