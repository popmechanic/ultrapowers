101 < 1 /** A card line's words put together by `format`, each slot in the card's `words` where it gives them. */
102 < 1 function lineOf(words: string, said: Card['words'], argOf: (t: string) => unknown): unknown {
103 < 1   const args: Json = {template: words};
104 < 1   for (const t of slotsOf(words)) args[t] ??= said?.[t] ? {$computed: 'words', args: {value: argOf(t), words: said[t]}} : argOf(t);
105 < 1   return {$computed: 'format', args};
106 < 1 }
