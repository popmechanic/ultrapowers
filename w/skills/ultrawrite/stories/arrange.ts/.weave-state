212 < 1 /** Element id -> its candidate's description, by recipe. */
213 < 1 function descriptionsOf(spec: Spec, candidates: Candidate[]): Record<string, string> {
214 < 1   const by = new Map(candidates.map((c) => [recipeKey(c.element), c.description]));
215 < 1   return Object.fromEntries(Object.entries(spec.elements).map(([id, e]) => [id, by.get(recipeKey(atomic(e))) ?? `Existing ${e.type}`]));
216 < 1 }
