121 < 2 +export function renderPage() {
122 < 2 +  return `<!doctype html>
123 < 2 +<html>
124 < 2 +<head>
125 < 2 +  <title>linkboard</title>
126 < 2 +  <meta charset="utf-8">
127 < 2 +  <meta name="viewport" content="width=device-width, initial-scale=1">
128 < 2 +</head>
129 < 2 +<body>
130 < 2 +  <h1>Linkboard</h1>
131 < 2 +  <ul id="links"></ul>
132 < 2 +  <script>
133 < 2 +    fetch('/links')
134 < 2 +      .then(res => res.json())
135 < 2 +      .then(links => {
136 < 2 +        const ul = document.getElementById('links');
137 < 2 +        links.forEach(link => {
138 < 2 +          const li = document.createElement('li');
139 < 2 +          const a = document.createElement('a');
140 < 2 +          a.href = link.url;
141 < 2 +          a.textContent = link.title;
142 < 2 +          li.appendChild(a);
143 < 2 +          ul.appendChild(li);
144 < 2 +        });
145 < 2 +      })
146 < 2 +      .catch(err => console.error('Failed to fetch links:', err));
147 < 2 +  </script>
148 < 2 +</body>
149 < 2 +</html>`;
150 < 2 +}
151 < 2 diff --git a/src/store.js b/src/store.js
