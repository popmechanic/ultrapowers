12 < 2 new file mode 100644
13 < 2 index 0000000..0cb0c42
14 < 2 --- /dev/null
15 < 2 +++ b/src/api.js
16 < 2 @@ -0,0 +1,41 @@
17 < 2 +import { createApp } from './app.js';
18 < 2 +import { createStore } from './store.js';
19 < 2 +import { validateLink } from './validate.js';
20 < 2 +import { renderPage } from './page.js';
21 < 2 +
22 < 2 +function sendJson(res, status, payload) {
23 < 2 +  res.writeHead(status, { 'content-type': 'application/json' });
24 < 2 +  res.end(JSON.stringify(payload));
25 < 2 +}
26 < 2 +
27 < 2 +/**
28 < 2 + * Creates an http.Server wiring the link store, request routing, and
29 < 2 + * validation together into the linkboard REST API and board UI.
30 < 2 + *
31 < 2 + * @returns {import('node:http').Server}
32 < 2 + */
33 < 2 +export function createServer() {
34 < 2 +  const store = createStore();
35 < 2 +
36 < 2 +  return createApp({
37 < 2 +    'GET /links': (req, res) => {
38 < 2 +      sendJson(res, 200, store.list());
39 < 2 +    },
40 < 2 +
41 < 2 +    'POST /links': (req, res, body) => {
42 < 2 +      const result = validateLink(body);
43 < 2 +      if (!result.ok) {
44 < 2 +        sendJson(res, 422, { error: result.error });
45 < 2 +        return;
46 < 2 +      }
47 < 2 +      const link = store.add(result.value);
48 < 2 +      sendJson(res, 201, link);
49 < 2 +    },
50 < 2 +
51 < 2 +    'GET /': (req, res) => {
52 < 2 +      const html = renderPage();
53 < 2 +      res.writeHead(200, { 'content-type': 'text/html' });
54 < 2 +      res.end(html);
55 < 2 +    },
56 < 2 +  });
57 < 2 +}
58 < 2 diff --git a/src/app.js b/src/app.js
59 < 2 new file mode 100644
60 < 2 index 0000000..43e6685
61 < 2 --- /dev/null
62 < 2 +++ b/src/app.js
63 < 2 @@ -0,0 +1,51 @@
64 < 2 +import { createServer } from 'node:http';
65 < 2 +
66 < 2 +function readBody(req) {
67 < 2 +  return new Promise((resolve, reject) => {
68 < 2 +    const chunks = [];
69 < 2 +    req.on('data', (chunk) => chunks.push(chunk));
70 < 2 +    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
71 < 2 +    req.on('error', reject);
72 < 2 +  });
73 < 2 +}
74 < 2 +
75 < 2 +function sendJson(res, status, payload) {
76 < 2 +  const body = JSON.stringify(payload);
77 < 2 +  res.writeHead(status, { 'content-type': 'application/json' });
78 < 2 +  res.end(body);
79 < 2 +}
80 < 2 +
81 < 2 +/**
82 < 2 + * Creates an http.Server that parses JSON bodies and routes exact-match
83 < 2 + * `METHOD /path` keys to their handlers.
84 < 2 + *
85 < 2 + * @param {Record<string, (req, res, body) => void>} handlers
86 < 2 + * @returns {import('node:http').Server}
87 < 2 + */
88 < 2 +export function createApp(handlers) {
89 < 2 +  return createServer(async (req, res) => {
90 < 2 +    const url = new URL(req.url, 'http://localhost');
91 < 2 +    const key = `${req.method} ${url.pathname}`;
92 < 2 +    const handler = handlers[key];
93 < 2 +
94 < 2 +    if (!handler) {
95 < 2 +      sendJson(res, 404, { error: 'not found' });
96 < 2 +      return;
97 < 2 +    }
98 < 2 +
99 < 2 +    const raw = await readBody(req);
100 < 2 +    let body;
101 < 2 +    if (raw.length === 0) {
102 < 2 +      body = undefined;
103 < 2 +    } else {
104 < 2 +      try {
105 < 2 +        body = JSON.parse(raw);
106 < 2 +      } catch {
107 < 2 +        sendJson(res, 400, { error: 'invalid json' });
108 < 2 +        return;
109 < 2 +      }
110 < 2 +    }
111 < 2 +
112 < 2 +    handler(req, res, body);
113 < 2 +  });
114 < 2 +}
