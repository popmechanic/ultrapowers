156 < 2 @@ -0,0 +1,26 @@
157 < 2 +import { randomUUID } from 'node:crypto';
158 < 2 +
159 < 2 +export function createStore() {
160 < 2 +  const links = [];
161 < 2 +
162 < 2 +  return {
163 < 2 +    add({ url, title }) {
164 < 2 +      const link = {
165 < 2 +        id: randomUUID(),
166 < 2 +        url,
167 < 2 +        title,
168 < 2 +        createdAt: new Date().toISOString(),
169 < 2 +      };
170 < 2 +      links.push(link);
171 < 2 +      return link;
172 < 2 +    },
173 < 2 +
174 < 2 +    list() {
175 < 2 +      return links;
176 < 2 +    },
177 < 2 +
178 < 2 +    get(id) {
179 < 2 +      return links.find(link => link.id === id);
180 < 2 +    },
181 < 2 +  };
182 < 2 +}
183 < 2 diff --git a/src/validate.js b/src/validate.js
