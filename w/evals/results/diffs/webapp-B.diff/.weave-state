187 < 2 +++ b/src/validate.js
188 < 2 @@ -0,0 +1,76 @@
189 < 2 +export function validateLink(input) {
190 < 2 +  // Reject non-object input
191 < 2 +  if (typeof input !== 'object' || input === null) {
192 < 2 +    return {
193 < 2 +      ok: false,
194 < 2 +      error: 'Input must be an object'
195 < 2 +    };
196 < 2 +  }
197 < 2 +
198 < 2 +  // Extract url and title
199 < 2 +  const { url, title } = input;
200 < 2 +
201 < 2 +  // Check url is present and is a string
202 < 2 +  if (typeof url !== 'string') {
203 < 2 +    return {
204 < 2 +      ok: false,
205 < 2 +      error: 'url must be a string'
206 < 2 +    };
207 < 2 +  }
208 < 2 +
209 < 2 +  // Check title is present and is a string
210 < 2 +  if (typeof title !== 'string') {
211 < 2 +    return {
212 < 2 +      ok: false,
213 < 2 +      error: 'title must be a string'
214 < 2 +    };
215 < 2 +  }
216 < 2 +
217 < 2 +  // Trim whitespace
218 < 2 +  const trimmedUrl = url.trim();
219 < 2 +  const trimmedTitle = title.trim();
220 < 2 +
221 < 2 +  // Check url is not empty after trimming
222 < 2 +  if (trimmedUrl.length === 0) {
223 < 2 +    return {
224 < 2 +      ok: false,
225 < 2 +      error: 'url cannot be empty'
226 < 2 +    };
227 < 2 +  }
228 < 2 +
229 < 2 +  // Check title is not empty after trimming
230 < 2 +  if (trimmedTitle.length === 0) {
231 < 2 +    return {
232 < 2 +      ok: false,
233 < 2 +      error: 'title cannot be empty'
234 < 2 +    };
235 < 2 +  }
236 < 2 +
237 < 2 +  // Try to parse the URL
238 < 2 +  let parsedUrl;
239 < 2 +  try {
240 < 2 +    parsedUrl = new URL(trimmedUrl);
241 < 2 +  } catch (error) {
242 < 2 +    return {
243 < 2 +      ok: false,
244 < 2 +      error: 'url must be a valid URL'
245 < 2 +    };
246 < 2 +  }
247 < 2 +
248 < 2 +  // Check that the scheme is http or https
249 < 2 +  if (parsedUrl.protocol !== 'http:' && parsedUrl.protocol !== 'https:') {
250 < 2 +    return {
251 < 2 +      ok: false,
252 < 2 +      error: 'url scheme must be http or https'
253 < 2 +    };
254 < 2 +  }
255 < 2 +
256 < 2 +  // Return success with trimmed fields
257 < 2 +  return {
258 < 2 +    ok: true,
259 < 2 +    value: {
260 < 2 +      url: trimmedUrl,
261 < 2 +      title: trimmedTitle
262 < 2 +    }
263 < 2 +  };
264 < 2 +}
