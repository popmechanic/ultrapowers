2143 < 2 +def test_export_state_returns_a_deep_enough_copy():
2144 < 2 +    audit.record("GET", "/r0", "a0", 500)
2145 < 2 +    audit.record("POST", "/r1", "a1", 500)
2146 < 2 +    state = audit.export_state()
2147 < 2 +    assert state == {
2148 < 2 +        "entries": [
2149 < 2 +            {"method": "GET", "path": "/r0", "actor": "a0"},
2150 < 2 +            {"method": "POST", "path": "/r1", "actor": "a1"},
2151 < 2 +        ],
2152 < 2 +        "dropped": 0,
2153 < 2 +    }
2154 < 2 +    # mutating the exported entries must not change the live log.
2155 < 2 +    state["entries"].append({"method": "X", "path": "/y", "actor": "z"})
2156 < 2 +    state["entries"][0]["actor"] = "mutated"
2157 < 2 +    assert audit.entries() == [
2158 < 2 +        {"method": "GET", "path": "/r0", "actor": "a0"},
2159 < 2 +        {"method": "POST", "path": "/r1", "actor": "a1"},
2160 < 2 +    ]
2161 < 2 +    assert audit.dropped() == 0
2162 < 2 +
2163 < 2 +
2164 < 2 +def test_import_state_round_trips_and_copies_its_input():
2165 < 2 +    for i in range(5):
2166 < 2 +        audit.record("GET", "/r%d" % i, "a%d" % i, 3)
2167 < 2 +    state = audit.export_state()
2168 < 2 +    audit.clear()
2169 < 2 +    assert audit.entries() == []
2170 < 2 +    assert audit.dropped() == 0
2171 < 2 +    audit.import_state(state)
2172 < 2 +    assert audit.entries() == [
2173 < 2 +        {"method": "GET", "path": "/r2", "actor": "a2"},
2174 < 2 +        {"method": "GET", "path": "/r3", "actor": "a3"},
2175 < 2 +        {"method": "GET", "path": "/r4", "actor": "a4"},
2176 < 2 +    ]
2177 < 2 +    assert audit.dropped() == 2
2178 < 2 +    # mutations of the state dict passed to import_state must not leak in.
2179 < 2 +    state["entries"].append({"method": "X", "path": "/y", "actor": "z"})
2180 < 2 +    state["entries"][0]["actor"] = "mutated"
2181 < 2 +    state["dropped"] = 999
2182 < 2 +    assert audit.entries() == [
2183 < 2 +        {"method": "GET", "path": "/r2", "actor": "a2"},
2184 < 2 +        {"method": "GET", "path": "/r3", "actor": "a3"},
2185 < 2 +        {"method": "GET", "path": "/r4", "actor": "a4"},
2186 < 2 +    ]
2187 < 2 +    assert audit.dropped() == 2
