1423 < 2 +    "numeric": "field {field} must be numeric (got {got})",
1424 < 2 +    "non_negative": "field {field} must be non-negative",
1425 < 2 +    "max": "field {field} exceeds max_amount {limit}",
1426 < 2 +    "non_empty": "field {field} must be a non-empty string",
