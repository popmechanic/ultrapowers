2063 < 2 +        audit.record("GET", "/r%d" % i, "actor%d" % i, 2)
2064 < 2 +        assert len(audit.entries()) <= 2
2065 < 2 +
2066 < 2 +
2067 < 2 +def test_dispatch_hook_default_actor_is_anonymous():
