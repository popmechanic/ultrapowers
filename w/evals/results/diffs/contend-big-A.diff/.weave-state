910 < 2 +"""Windowed quota counter driven by a deterministic logical clock.
911 < 2 +
912 < 2 +Module-global state only: a logical clock (`_clock`, seconds — advanced
913 < 2 +only via `advance()`; no wall-clock time anywhere, so behavior is fully
914 < 2 +deterministic for tests) and a per-key hit-timestamp store (`_hits`).
915 < 2 +`reset()` clears both. Every other function reads/writes this shared
916 < 2 +state; there is exactly one clock and one hit store for the whole
917 < 2 +process, which `app/ratelimit.py`, `app/throttle.py`, and
918 < 2 +`app/backoff.py` all build on.
919 < 2 +"""
920 < 2 +
921 < 2 +
922 < 2 +class QuotaExceededError(Exception):
923 < 2 +    pass
924 < 2 +
925 < 2 +
926 < 2 +_clock = 0.0
927 < 2 +_hits = {}
928 < 2 +
929 < 2 +
930 < 2 +def reset():
931 < 2 +    """Clear the logical clock back to 0.0 and every key's hits."""
932 < 2 +    global _clock, _hits
933 < 2 +    _clock = 0.0
934 < 2 +    _hits = {}
935 < 2 +
936 < 2 +
937 < 2 +def now():
938 < 2 +    """Return the current logical clock value."""
939 < 2 +    return _clock
940 < 2 +
941 < 2 +
942 < 2 +def advance(seconds):
943 < 2 +    """Move the logical clock forward by `seconds` (>= 0) and return the
944 < 2 +    new value. The clock is monotonic: a negative `seconds` raises
945 < 2 +    ValueError and leaves the clock unchanged."""
946 < 2 +    global _clock
947 < 2 +    if seconds < 0:
948 < 2 +        raise ValueError("advance: seconds must be >= 0, got %r" % (seconds,))
949 < 2 +    _clock += seconds
950 < 2 +    return _clock
951 < 2 +
952 < 2 +
953 < 2 +def _prune(key, window_seconds):
954 < 2 +    """Drop hits for `key` strictly older than now() - window_seconds (a
955 < 2 +    hit sitting exactly at that boundary is kept). A no-op for an
956 < 2 +    infinite window. Returns the surviving (already-stored) hit list."""
957 < 2 +    hits = _hits.get(key)
958 < 2 +    if not hits or window_seconds == float("inf"):
959 < 2 +        return hits or []
960 < 2 +    threshold = now() - window_seconds
961 < 2 +    kept = [h for h in hits if h >= threshold]
962 < 2 +    if kept:
963 < 2 +        _hits[key] = kept
964 < 2 +    else:
965 < 2 +        del _hits[key]
966 < 2 +    return _hits.get(key, [])
967 < 2 +
968 < 2 +
969 < 2 +def take(key, limit, window_seconds, burst=0):
970 < 2 +    """Record a hit for `key` and return the new in-window hit count.
971 < 2 +    Raises QuotaExceededError, without recording, once the in-window
972 < 2 +    count would exceed `limit + burst`."""
973 < 2 +    hits = _prune(key, window_seconds)
974 < 2 +    allowed = limit + burst
975 < 2 +    if len(hits) >= allowed:
976 < 2 +        raise QuotaExceededError(
977 < 2 +            "quota exceeded for key %r: limit %s (burst %s)" % (key, limit, burst)
978 < 2 +        )
979 < 2 +    hits = list(hits)
980 < 2 +    hits.append(now())
981 < 2 +    _hits[key] = hits
982 < 2 +    return len(hits)
983 < 2 +
984 < 2 +
985 < 2 +def remaining(key, limit, window_seconds, burst=0):
986 < 2 +    """Return how many more `take` calls would succeed right now for
987 < 2 +    `key`, without recording a hit. Floors at 0."""
988 < 2 +    hits = _prune(key, window_seconds)
989 < 2 +    allowed = limit + burst
990 < 2 +    return max(0, allowed - len(hits))
991 < 2 +
992 < 2 +
993 < 2 +def snapshot(window_seconds):
994 < 2 +    """Return a dict mapping each key with at least one in-window hit to
995 < 2 +    the sorted list of its in-window hit timestamps. Keys with none are
996 < 2 +    omitted. The returned lists are fresh copies — mutating one never
997 < 2 +    affects later `snapshot`/`remaining` readings."""
998 < 2 +    result = {}
999 < 2 +    for key in list(_hits.keys()):
1000 < 2 +        hits = _prune(key, window_seconds)
1001 < 2 +        if hits:
1002 < 2 +            result[key] = sorted(hits)
1003 < 2 +    return result
1004 < 2 +
1005 < 2 +
1006 < 2 +def time_to_next_slot(key, limit, window_seconds, burst=0):
1007 < 2 +    """Return the seconds until one slot frees for `key`: 0.0 when a
1008 < 2 +    take would succeed right now; otherwise the time until the oldest
1009 < 2 +    in-window hit ages out. Never raises — an exhausted key with a zero
1010 < 2 +    allowance (limit + burst == 0, so no hit was ever recorded) or an
1011 < 2 +    infinite window reports float("inf") instead of crashing on an
1012 < 2 +    empty hit list. Read-only."""
1013 < 2 +    if remaining(key, limit, window_seconds, burst) > 0:
1014 < 2 +        return 0.0
1015 < 2 +    if window_seconds == float("inf"):
1016 < 2 +        return float("inf")
1017 < 2 +    hits = _hits.get(key, [])
1018 < 2 +    if not hits:
1019 < 2 +        return float("inf")
1020 < 2 +    return min(hits) + window_seconds - now()
1021 < 2 +
1022 < 2 +
1023 < 2 +def usage(key, limit, window_seconds, burst=0):
1024 < 2 +    """Read-only snapshot of a key's quota state."""
1025 < 2 +    hits = _prune(key, window_seconds)
1026 < 2 +    return {
1027 < 2 +        "used": len(hits),
1028 < 2 +        "allowed": limit + burst,
1029 < 2 +        "remaining": remaining(key, limit, window_seconds, burst),
1030 < 2 +        "reset_in": time_to_next_slot(key, limit, window_seconds, burst),
1031 < 2 +    }
1032 < 2 +
1033 < 2 +
1034 < 2 +def purge(window_seconds):
1035 < 2 +    """Drop every key's aged-out hits (removing keys left with none) and
1036 < 2 +    return the total number of hits dropped."""
1037 < 2 +    dropped = 0
1038 < 2 +    for key in list(_hits.keys()):
1039 < 2 +        before = len(_hits.get(key, []))
1040 < 2 +        after = _prune(key, window_seconds)
1041 < 2 +        dropped += before - len(after)
1042 < 2 +    return dropped
