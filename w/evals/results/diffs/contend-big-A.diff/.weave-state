1341 < 2 +        if not check(fields[field], r):
1342 < 2 +            failures.append("field %s failed %s" % (field, r["name"]))
1343 < 2 +    return failures
1344 < 2 +
1345 < 2 +
1346 < 2 +def first_failure(fields, rules_by_field):
