2105 < 2 +
2106 < 2 +
2107 < 2 +def test_record_many_appends_in_order_enforcing_cap_after_every_append():
2108 < 2 +    triples = [
2109 < 2 +        ("GET", "/r0", "a0"),
2110 < 2 +        ("GET", "/r1", "a1"),
2111 < 2 +        ("GET", "/r2", "a2"),
2112 < 2 +        ("GET", "/r3", "a3"),
2113 < 2 +    ]
2114 < 2 +    seen_lengths = []
2115 < 2 +    original_record = audit.record
2116 < 2 +
2117 < 2 +    def recording_record(method, path, actor, max_entries):
2118 < 2 +        original_record(method, path, actor, max_entries)
2119 < 2 +        seen_lengths.append(len(audit.entries()))
2120 < 2 +
2121 < 2 +    audit.record = recording_record
2122 < 2 +    try:
2123 < 2 +        count = audit.record_many(triples, 2)
2124 < 2 +    finally:
2125 < 2 +        audit.record = original_record
2126 < 2 +    assert count == 4
2127 < 2 +    assert all(n <= 2 for n in seen_lengths)
2128 < 2 +    assert audit.entries() == [
2129 < 2 +        {"method": "GET", "path": "/r2", "actor": "a2"},
2130 < 2 +        {"method": "GET", "path": "/r3", "actor": "a3"},
2131 < 2 +    ]
