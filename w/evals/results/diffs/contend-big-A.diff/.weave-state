430 < 2 +++ b/app/coerce.py
431 < 2 @@ -0,0 +1,80 @@
432 < 2 +"""Pre-validation coercion layer: turn loosely-typed input (e.g. strings
433 < 2 +from a form) into the types app.schema's rules expect.
434 < 2 +
435 < 2 +Imports app.schema only; every CoerceError message is built from
436 < 2 +COERCE_CATALOG (no other message literals in this module).
437 < 2 +"""
438 < 2 +from app import schema
439 < 2 +
440 < 2 +
441 < 2 +class CoerceError(Exception):
442 < 2 +    pass
443 < 2 +
444 < 2 +
445 < 2 +COERCE_CATALOG = {
446 < 2 +    "amount": "cannot coerce {field} to a number (got {value!r})",
447 < 2 +    "flag": "cannot coerce {field} to a flag (got {value!r})",
448 < 2 +}
449 < 2 +
450 < 2 +
451 < 2 +_TRUE_FLAGS = {"true", "yes", "1", "on"}
452 < 2 +_FALSE_FLAGS = {"false", "no", "0", "off"}
453 < 2 +
454 < 2 +
455 < 2 +def parse_amount(value, field):
456 < 2 +    if isinstance(value, bool):
457 < 2 +        raise CoerceError(COERCE_CATALOG["amount"].format(field=field, value=value))
458 < 2 +    if isinstance(value, str):
459 < 2 +        text = value.strip()
460 < 2 +        try:
461 < 2 +            if "." in text:
462 < 2 +                parsed = float(text)
463 < 2 +            else:
464 < 2 +                parsed = int(text)
465 < 2 +        except ValueError:
466 < 2 +            raise CoerceError(COERCE_CATALOG["amount"].format(field=field, value=value))
467 < 2 +    else:
468 < 2 +        parsed = value
469 < 2 +
470 < 2 +    if not schema.is_valid_amount(parsed):
471 < 2 +        raise CoerceError(COERCE_CATALOG["amount"].format(field=field, value=value))
472 < 2 +    return parsed
473 < 2 +
474 < 2 +
475 < 2 +def parse_flag(value, field):
476 < 2 +    if isinstance(value, bool):
477 < 2 +        return value
478 < 2 +    if isinstance(value, str):
479 < 2 +        text = value.strip().lower()
480 < 2 +        if text in _TRUE_FLAGS:
481 < 2 +            return True
482 < 2 +        if text in _FALSE_FLAGS:
483 < 2 +            return False
484 < 2 +    raise CoerceError(COERCE_CATALOG["flag"].format(field=field, value=value))
485 < 2 +
486 < 2 +
487 < 2 +def coerce_fields(fields, spec):
488 < 2 +    result = dict(fields)
489 < 2 +    for field, rules in spec.items():
490 < 2 +        if rules.get("type") == "number" and field in fields and isinstance(fields[field], str):
491 < 2 +            result[field] = parse_amount(fields[field], field=field)
492 < 2 +    return result
493 < 2 +
494 < 2 +
495 < 2 +def coerce_report(fields, spec):
496 < 2 +    coerced = dict(fields)
497 < 2 +    errors = []
498 < 2 +    for field, rules in spec.items():
499 < 2 +        if rules.get("type") == "number" and field in fields and isinstance(fields[field], str):
500 < 2 +            try:
501 < 2 +                coerced[field] = parse_amount(fields[field], field=field)
502 < 2 +            except CoerceError as exc:
503 < 2 +                errors.append((field, str(exc)))
504 < 2 +    return coerced, errors
505 < 2 +
506 < 2 +
507 < 2 +def describe_coercions(spec):
508 < 2 +    fields = sorted(f for f, rules in spec.items() if rules.get("type") == "number")
509 < 2 +    if not fields:
510 < 2 +        return "(no coercions)"
511 < 2 +    return "\n".join("%s: number" % field for field in fields)
