1314 < 2 +    name = "any(" + ",".join(r["name"] for r in rules) + ")"
1315 < 2 +
1316 < 2 +    def test(value):
1317 < 2 +        return any(check(value, r) for r in rules)
1318 < 2 +
1319 < 2 +    return rule(name, test)
1320 < 2 +
1321 < 2 +
1322 < 2 +def negate(r):
1323 < 2 +    name = "not(%s)" % r["name"]
1324 < 2 +    return rule(name, lambda value: not check(value, r))
1325 < 2 +
1326 < 2 +
1327 < 2 +def when(cond, then):
