1834 < 2 new file mode 100644
1835 < 2 index 0000000..67d425a
1836 < 2 --- /dev/null
1837 < 2 +++ b/app/tiers.py
1838 < 2 @@ -0,0 +1,65 @@
1839 < 2 +"""Actor-tier policy layer over app.throttle.
1840 < 2 +
1841 < 2 +Imports app.throttle and app.quota only; no module state of its own
1842 < 2 +beyond the TIERS constant.
1843 < 2 +"""
1844 < 2 +import copy
1845 < 2 +
1846 < 2 +from app import throttle
1847 < 2 +
1848 < 2 +
1849 < 2 +class TierError(Exception):
1850 < 2 +    pass
1851 < 2 +
1852 < 2 +
1853 < 2 +TIERS = {
1854 < 2 +    "free": {"limit": 2, "window": 60, "burst": 0},
1855 < 2 +    "pro": {"limit": 10, "window": 60, "burst": 2},
1856 < 2 +    "internal": {"limit": 100, "window": 60, "burst": 10},
1857 < 2 +}
1858 < 2 +
1859 < 2 +_UPGRADE_PATH = {"free": "pro", "pro": "internal", "internal": None}
1860 < 2 +
1861 < 2 +
1862 < 2 +def tier_of(actor, assignments):
1863 < 2 +    """The actor's tier, defaulting to "free" when unassigned. Raises
1864 < 2 +    TierError (naming both the actor and the bogus tier) when the
1865 < 2 +    assignment names a tier absent from TIERS."""
1866 < 2 +    tier = assignments.get(actor, "free")
1867 < 2 +    if tier not in TIERS:
1868 < 2 +        raise TierError(
1869 < 2 +            "actor %r assigned unknown tier %r" % (actor, tier)
1870 < 2 +        )
1871 < 2 +    return tier
1872 < 2 +
1873 < 2 +
1874 < 2 +def policy_for(actor, assignments):
1875 < 2 +    """A deep copy of the actor's tier policy — mutating the result
1876 < 2 +    never touches TIERS."""
1877 < 2 +    return copy.deepcopy(TIERS[tier_of(actor, assignments)])
1878 < 2 +
1879 < 2 +
1880 < 2 +def enforce_tier(method, path, actor, assignments):
1881 < 2 +    """Builds the one-key policies dict for this actor's tier and
1882 < 2 +    delegates to throttle.enforce."""
1883 < 2 +    policies = {"%s %s" % (method, path): policy_for(actor, assignments)}
1884 < 2 +    return throttle.enforce(method, path, actor, policies)
1885 < 2 +
1886 < 2 +
1887 < 2 +def remaining_tier(method, path, actor, assignments):
1888 < 2 +    """Read-only: delegates to throttle.remaining_for under the same
1889 < 2 +    one-key policies dict."""
1890 < 2 +    policies = {"%s %s" % (method, path): policy_for(actor, assignments)}
1891 < 2 +    return throttle.remaining_for(method, path, actor, policies)
1892 < 2 +
1893 < 2 +
1894 < 2 +def describe_tiers():
1895 < 2 +    return throttle.describe_policies(TIERS)
1896 < 2 +
1897 < 2 +
1898 < 2 +def upgrade_path(tier):
1899 < 2 +    """The next tier by allowance, or None for the top tier. Raises
1900 < 2 +    TierError (naming the tier) for an unknown tier."""
1901 < 2 +    if tier not in _UPGRADE_PATH:
1902 < 2 +        raise TierError("unknown tier %r" % (tier,))
1903 < 2 +    return _UPGRADE_PATH[tier]
1904 < 2 diff --git a/app/validation.py b/app/validation.py
1905 < 2 new file mode 100644
1906 < 2 index 0000000..af2bb0a
1907 < 2 --- /dev/null
1908 < 2 +++ b/app/validation.py
1909 < 2 @@ -0,0 +1,96 @@
1910 < 2 +"""Input-validation layer for record creation.
1911 < 2 +
1912 < 2 +Wires into app.registry's PRE_CREATE_HOOKS as `pre_create_hook`. Every
1913 < 2 +error message is built through app.schema.format_error against
1914 < 2 +schema.ERROR_CATALOG — no error-message string literals live here.
1915 < 2 +"""
1916 < 2 +import re
1917 < 2 +
1918 < 2 +from app import schema
1919 < 2 +
1920 < 2 +
1921 < 2 +class ValidationError(Exception):
1922 < 2 +    pass
1923 < 2 +
1924 < 2 +
1925 < 2 +def _template_pattern(template):
1926 < 2 +    """Turn a str.format template into a regex that matches any string
1927 < 2 +    produced by formatting it (the '{...}' placeholders become '.+')."""
1928 < 2 +    parts = re.split(r"(\{[^}]*\})", template)
1929 < 2 +    pattern = "".join(
1930 < 2 +        ".+" if part.startswith("{") and part.endswith("}") else re.escape(part)
1931 < 2 +        for part in parts
1932 < 2 +    )
1933 < 2 +    return "^" + pattern + "$"
1934 < 2 +
1935 < 2 +
1936 < 2 +def validate_fields(fields, required_fields, max_amount):
1937 < 2 +    """Validate fields against required_fields (checked first, in
1938 < 2 +    order) and, when present, the shape of "amount" and "name". Returns
1939 < 2 +    a new dict: "name" stripped, everything else preserved unchanged.
1940 < 2 +    Raises ValidationError (wrapping schema.format_error messages) on
1941 < 2 +    the first violation."""
1942 < 2 +    missing = schema.check_required(fields, required_fields)
1943 < 2 +    if missing:
1944 < 2 +        raise ValidationError(schema.format_error("missing", field=missing[0]))
1945 < 2 +
1946 < 2 +    if "amount" in fields:
1947 < 2 +        amount = fields["amount"]
1948 < 2 +        if not schema.is_valid_amount(amount):
1949 < 2 +            raise ValidationError(
1950 < 2 +                schema.format_error("numeric", field="amount", got=type(amount).__name__)
1951 < 2 +            )
1952 < 2 +        if amount < 0:
1953 < 2 +            raise ValidationError(schema.format_error("non_negative", field="amount"))
1954 < 2 +        if amount > max_amount:
1955 < 2 +            raise ValidationError(schema.format_error("max", field="amount", limit=max_amount))
1956 < 2 +
1957 < 2 +    result = dict(fields)
1958 < 2 +    if "name" in fields:
1959 < 2 +        name = fields["name"]
1960 < 2 +        if not schema.is_non_empty_str(name):
1961 < 2 +            raise ValidationError(schema.format_error("non_empty", field="name"))
1962 < 2 +        result["name"] = name.strip()
1963 < 2 +
1964 < 2 +    return result
1965 < 2 +
1966 < 2 +
1967 < 2 +def pre_create_hook(store, config, fields):
1968 < 2 +    return validate_fields(
1969 < 2 +        fields,
1970 < 2 +        config["validation_required_fields"],
1971 < 2 +        config["validation_max_amount"],
1972 < 2 +    )
1973 < 2 +
1974 < 2 +
1975 < 2 +def validate_many(entries, required_fields, max_amount):
1976 < 2 +    """Validate a list of fields dicts. Returns (validated, errors):
1977 < 2 +    validated is the list of successfully-validated new dicts in input
1978 < 2 +    order; errors is [(index, str(err)), ...] for the failures, also in
1979 < 2 +    input order."""
1980 < 2 +    validated = []
1981 < 2 +    errors = []
1982 < 2 +    for index, entry in enumerate(entries):
1983 < 2 +        try:
1984 < 2 +            validated.append(validate_fields(entry, required_fields, max_amount))
1985 < 2 +        except ValidationError as exc:
1986 < 2 +            errors.append((index, str(exc)))
1987 < 2 +    return validated, errors
1988 < 2 +
1989 < 2 +
1990 < 2 +def error_code(message):
1991 < 2 +    """Map an error-message string back to its ERROR_CATALOG code by
1992 < 2 +    matching against the catalog's templates (built at call time, not a
1993 < 2 +    second hand-written table)."""
1994 < 2 +    for code, template in schema.ERROR_CATALOG.items():
1995 < 2 +        if re.match(_template_pattern(template), message):
1996 < 2 +            return code
1997 < 2 +    raise ValueError(message)
1998 < 2 +
1999 < 2 +
2000 < 2 +def explain_config(config):
2001 < 2 +    required = ", ".join(config["validation_required_fields"])
2002 < 2 +    return "validation config:\n  required: %s\n  max_amount: %s" % (
2003 < 2 +        required,
2004 < 2 +        config["validation_max_amount"],
2005 < 2 +    )
