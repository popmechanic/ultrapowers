2044 < 2 +    got = audit.entries()
2045 < 2 +    got.append({"method": "X", "path": "/y", "actor": "z"})
2046 < 2 +    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
2047 < 2 +
2048 < 2 +
2049 < 2 +def test_cap_drops_oldest_first():
2050 < 2 +    for i in range(4):
2051 < 2 +        audit.record("GET", "/r%d" % i, "actor%d" % i, 3)
2052 < 2 +    result = audit.entries()
2053 < 2 +    assert len(result) == 3
2054 < 2 +    assert result == [
2055 < 2 +        {"method": "GET", "path": "/r1", "actor": "actor1"},
2056 < 2 +        {"method": "GET", "path": "/r2", "actor": "actor2"},
2057 < 2 +        {"method": "GET", "path": "/r3", "actor": "actor3"},
2058 < 2 +    ]
2059 < 2 +
2060 < 2 +
2061 < 2 +def test_cap_enforced_on_every_call():
