1623 < 2 +
1624 < 2 +def columns(records):
1625 < 2 +    """Sorted union of every key across all records."""
1626 < 2 +    keys = set()
1627 < 2 +    for record in records:
1628 < 2 +        keys.update(record.keys())
1629 < 2 +    return sorted(keys)
1630 < 2 +
1631 < 2 +
1632 < 2 +def cell(value):
1633 < 2 +    """Plain str() rendering of a value, except None -> ""."""
1634 < 2 +    if value is None:
1635 < 2 +        return ""
1636 < 2 +    return str(value)
1637 < 2 +
1638 < 2 +
1639 < 2 +def escape_csv(value):
1640 < 2 +    """CSV-escape a single cell (RFC4180-ish): quote iff the cell contains
1641 < 2 +    a comma, quote, or newline; double any inner quotes."""
1642 < 2 +    text = value if isinstance(value, str) else cell(value)
1643 < 2 +    if "," in text or '"' in text or "\n" in text or "\r" in text:
1644 < 2 +        return '"' + text.replace('"', '""') + '"'
1645 < 2 +    return text
1646 < 2 +
1647 < 2 +
1648 < 2 +def widths(records, cols):
1649 < 2 +    """dict mapping each column name to max(len(header), max cell width)."""
1650 < 2 +    result = {}
1651 < 2 +    for col in cols:
1652 < 2 +        widest = len(col)
1653 < 2 +        for record in records:
1654 < 2 +            widest = max(widest, len(cell(record.get(col))))
1655 < 2 +        result[col] = widest
1656 < 2 +    return result
1657 < 2 +
1658 < 2 +
1659 < 2 +def pad(value, width, align):
1660 < 2 +    """Pad `value` to `width` using `align` ("left" or "right"). A value at
1661 < 2 +    or beyond `width` is returned unchanged. `align` is validated before
1662 < 2 +    any short-circuit on width."""
1663 < 2 +    if align not in ("left", "right"):
1664 < 2 +        raise ValueError(align)
1665 < 2 +    if len(value) >= width:
1666 < 2 +        return value
1667 < 2 +    fill = " " * (width - len(value))
1668 < 2 +    if align == "left":
1669 < 2 +        return value + fill
1670 < 2 +    return fill + value
1671 < 2 +
1672 < 2 +
1673 < 2 +def sanitize_flat(value):
1674 < 2 +    """cell(value) with every tab/newline replaced by a single space."""
1675 < 2 +    text = cell(value)
1676 < 2 +    return text.replace("\t", " ").replace("\n", " ").replace("\r", " ")
1677 < 2 +
1678 < 2 +
1679 < 2 +def escape_html(value):
1680 < 2 +    """cell(value) HTML-escaped: & first, then < > "."""
1681 < 2 +    text = cell(value)
1682 < 2 +    text = text.replace("&", "&amp;")
1683 < 2 +    text = text.replace("<", "&lt;")
1684 < 2 +    text = text.replace(">", "&gt;")
1685 < 2 +    text = text.replace('"', "&quot;")
1686 < 2 +    return text
1687 < 2 +
1688 < 2 +
1689 < 2 +def truncate(value, width, marker="..."):
1690 < 2 +    """`value` unchanged if it already fits `width`; else truncated with
1691 < 2 +    `marker` appended so the result is exactly `width` characters. A
1692 < 2 +    `width` too small to hold the marker only raises when truncation is
1693 < 2 +    actually needed -- an already-fitting value never triggers it."""
1694 < 2 +    if len(value) <= width:
1695 < 2 +        return value
1696 < 2 +    if width < len(marker):
1697 < 2 +        raise ValueError(width)
1698 < 2 +    return value[: width - len(marker)] + marker
1699 < 2 +
1700 < 2 +
1701 < 2 +def wrap(value, width):
1702 < 2 +    """Greedily wrap `value` on spaces into lines each <= width. A single
1703 < 2 +    word longer than width is hard-split at width."""
1704 < 2 +    if width < 1:
1705 < 2 +        raise ValueError(width)
1706 < 2 +    if value == "":
1707 < 2 +        return [""]
1708 < 2 +
1709 < 2 +    lines = []
1710 < 2 +    current = ""
1711 < 2 +    for word in value.split(" "):
1712 < 2 +        while len(word) > width:
1713 < 2 +            if current:
1714 < 2 +                lines.append(current)
1715 < 2 +                current = ""
1716 < 2 +            lines.append(word[:width])
1717 < 2 +            word = word[width:]
1718 < 2 +        if not current:
1719 < 2 +            candidate = word
1720 < 2 +        else:
1721 < 2 +            candidate = current + " " + word
1722 < 2 +        if len(candidate) <= width:
1723 < 2 +            current = candidate
1724 < 2 +        else:
1725 < 2 +            lines.append(current)
1726 < 2 +            current = word
1727 < 2 +    lines.append(current)
1728 < 2 +    return lines
1729 < 2 +
1730 < 2 +
1731 < 2 +def fit(value, width, align):
1732 < 2 +    """Compose truncate then pad: an over-long value is truncated to
1733 < 2 +    `width` (marker included), a short one padded per `align`."""
1734 < 2 +    return pad(truncate(value, width), width, align)
1735 < 2 +
1736 < 2 +
1737 < 2 +def render_row(cells, widths_list, align):
1738 < 2 +    """Render one pipe-table row: "| " + " | ".join(padded cells) + " |"."""
1739 < 2 +    if len(cells) != len(widths_list):
1740 < 2 +        raise ValueError(
1741 < 2 +            "cells/widths length mismatch: %d != %d" % (len(cells), len(widths_list))
1742 < 2 +        )
1743 < 2 +    padded = [pad(c, w, align) for c, w in zip(cells, widths_list)]
1744 < 2 +    return "| " + " | ".join(padded) + " |"
1745 < 2 diff --git a/app/throttle.py b/app/throttle.py
1746 < 2 new file mode 100644
1747 < 2 index 0000000..a4faf91
1748 < 2 --- /dev/null
1749 < 2 +++ b/app/throttle.py
1750 < 2 @@ -0,0 +1,82 @@
1751 < 2 +"""Pure policy layer over app.quota — path/method-keyed rate policies.
1752 < 2 +
1753 < 2 +Imports app.quota only (never app.ratelimit); no module state of its
1754 < 2 +own beyond the POLICIES constant. NOT wired into app.registry — a
1755 < 2 +library layer other callers (e.g. app.tiers) build on.
1756 < 2 +"""
1757 < 2 +from app import quota
1758 < 2 +
1759 < 2 +
1760 < 2 +class PolicyError(Exception):
1761 < 2 +    pass
1762 < 2 +
1763 < 2 +
1764 < 2 +POLICIES = {
1765 < 2 +    "POST /records": {"limit": 5, "window": 60, "burst": 0},
1766 < 2 +    "GET /export": {"limit": 10, "window": 60, "burst": 2},
1767 < 2 +}
1768 < 2 +
1769 < 2 +
1770 < 2 +def match_policy(method, path, policies):
1771 < 2 +    """Return the policy dict whose key's method matches `method` and
1772 < 2 +    whose path-prefix is a prefix of `path`, preferring the longest
1773 < 2 +    matching prefix. None if nothing matches."""
1774 < 2 +    best = None
1775 < 2 +    best_len = -1
1776 < 2 +    for policy_key, policy in policies.items():
1777 < 2 +        policy_method, _, prefix = policy_key.partition(" ")
1778 < 2 +        if policy_method != method:
1779 < 2 +            continue
1780 < 2 +        if path.startswith(prefix) and len(prefix) > best_len:
1781 < 2 +            best = policy
1782 < 2 +            best_len = len(prefix)
1783 < 2 +    return best
1784 < 2 +
1785 < 2 +
1786 < 2 +def key_for(method, path, actor):
1787 < 2 +    return "%s %s:%s" % (method, path, actor)
1788 < 2 +
1789 < 2 +
1790 < 2 +def enforce(method, path, actor, policies):
1791 < 2 +    """No matching policy: return None, record nothing. A match:
1792 < 2 +    delegate to quota.take under the policy's params and return the
1793 < 2 +    in-window count, or raise PolicyError (chained) once exhausted."""
1794 < 2 +    policy = match_policy(method, path, policies)
1795 < 2 +    if policy is None:
1796 < 2 +        return None
1797 < 2 +    key = key_for(method, path, actor)
1798 < 2 +    try:
1799 < 2 +        return quota.take(
1800 < 2 +            key, policy["limit"], policy["window"], burst=policy.get("burst", 0)
1801 < 2 +        )
1802 < 2 +    except quota.QuotaExceededError as exc:
1803 < 2 +        raise PolicyError(
1804 < 2 +            "policy exceeded for key %r: limit %s" % (key, policy["limit"])
1805 < 2 +        ) from exc
1806 < 2 +
1807 < 2 +
1808 < 2 +def remaining_for(method, path, actor, policies):
1809 < 2 +    """Read-only: None when no policy matches, else quota.remaining
1810 < 2 +    under the policy's params."""
1811 < 2 +    policy = match_policy(method, path, policies)
1812 < 2 +    if policy is None:
1813 < 2 +        return None
1814 < 2 +    key = key_for(method, path, actor)
1815 < 2 +    return quota.remaining(
1816 < 2 +        key, policy["limit"], policy["window"], burst=policy.get("burst", 0)
1817 < 2 +    )
1818 < 2 +
1819 < 2 +
1820 < 2 +def describe_policies(policies):
1821 < 2 +    """Render one line per policy key (sorted), or a fixed placeholder
1822 < 2 +    for an empty policy set."""
1823 < 2 +    if not policies:
1824 < 2 +        return "(no policies)"
1825 < 2 +    lines = []
1826 < 2 +    for key in sorted(policies):
1827 < 2 +        policy = policies[key]
1828 < 2 +        lines.append(
1829 < 2 +            "%s: limit=%s, window=%s, burst=%s"
1830 < 2 +            % (key, policy["limit"], policy["window"], policy["burst"])
1831 < 2 +        )
1832 < 2 +    return "\n".join(lines)
