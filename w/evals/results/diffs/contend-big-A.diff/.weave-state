4597 < 2 +    assert tabular.cell("x") == "x"
4598 < 2 +
4599 < 2 +
4600 < 2 +def test_escape_csv():
4601 < 2 +    assert tabular.escape_csv("plain") == "plain"
4602 < 2 +    assert tabular.escape_csv("a,b") == '"a,b"'
4603 < 2 +    assert tabular.escape_csv('say "hi"') == '"say ""hi"""'
4604 < 2 +    assert tabular.escape_csv("line1\nline2") == '"line1\nline2"'
4605 < 2 +    assert tabular.escape_csv("") == ""
4606 < 2 +
4607 < 2 +
4608 < 2 +def test_widths():
4609 < 2 +    records = [{"name": "x", "id": "1"}, {"name": "yy", "id": "22222"}]
4610 < 2 +    cols = ["name", "id"]
4611 < 2 +    # "name" header (4) is strictly wider than every cell ("x", "yy")
4612 < 2 +    # "id" header (2) is narrower than its widest cell ("22222", width 5)
4613 < 2 +    assert tabular.widths(records, cols) == {"name": 4, "id": 5}
4614 < 2 +
4615 < 2 +
4616 < 2 +def test_pad():
4617 < 2 +    assert tabular.pad("ab", 4, "left") == "ab  "
4618 < 2 +    assert tabular.pad("ab", 4, "right") == "  ab"
