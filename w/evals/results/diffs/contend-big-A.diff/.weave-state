1048 < 2 @@ -0,0 +1,94 @@
1049 < 2 +"""Per-key rate limiting on POST writes, layered on app.quota.
1050 < 2 +
1051 < 2 +Keeps no counter state of its own — every increment lives in
1052 < 2 +app.quota's module-global hit store; `reset()` simply delegates to
1053 < 2 +`quota.reset()` so callers reset both the counters and the logical
1054 < 2 +clock in one call.
1055 < 2 +
1056 < 2 +Wires into app.registry's DISPATCH_HOOKS as `dispatch_hook`.
1057 < 2 +"""
1058 < 2 +from app import quota
1059 < 2 +
1060 < 2 +
1061 < 2 +class RateLimitExceededError(quota.QuotaExceededError):
1062 < 2 +    pass
1063 < 2 +
1064 < 2 +
1065 < 2 +def reset():
1066 < 2 +    """Delegate to quota.reset(): clears every key's counter AND the
1067 < 2 +    logical clock."""
1068 < 2 +    quota.reset()
1069 < 2 +
1070 < 2 +
1071 < 2 +def check_and_increment(key, limit, window_seconds=float("inf"), burst=0):
1072 < 2 +    """Record a hit for `key` and return the new in-window count.
1073 < 2 +    Delegates to quota.take; re-raises quota.QuotaExceededError as the
1074 < 2 +    RateLimitExceededError subclass."""
1075 < 2 +    try:
1076 < 2 +        return quota.take(key, limit, window_seconds, burst=burst)
1077 < 2 +    except quota.QuotaExceededError as exc:
1078 < 2 +        raise RateLimitExceededError(
1079 < 2 +            "rate limit exceeded for key %r: limit %s" % (key, limit)
1080 < 2 +        ) from exc
1081 < 2 +
1082 < 2 +
1083 < 2 +def dispatch_hook(store, config, method, path, kwargs):
1084 < 2 +    """DISPATCH_HOOKS entry: rate-limits POST writes only (GETs and any
1085 < 2 +    other method pass through untouched). The key is the caller's
1086 < 2 +    `actor` kwarg, defaulting to "anonymous". Only
1087 < 2 +    `rate_limit_max_per_window` is a required config key; window and
1088 < 2 +    burst always read via `.get(...)` defaults so a minimal, limit-only
1089 < 2 +    config still works."""
1090 < 2 +    if method != "POST":
1091 < 2 +        return
1092 < 2 +    actor = kwargs.get("actor", "anonymous")
1093 < 2 +    limit = config["rate_limit_max_per_window"]
1094 < 2 +    window_seconds = config.get("rate_limit_window_seconds", 60)
1095 < 2 +    burst = config.get("rate_limit_burst", 0)
1096 < 2 +    check_and_increment(actor, limit, window_seconds, burst=burst)
1097 < 2 +
1098 < 2 +
1099 < 2 +def retry_after(key, config):
1100 < 2 +    """Seconds until `key`'s next slot frees, read-only. Delegates to
1101 < 2 +    quota.time_to_next_slot using the same config-key conventions as
1102 < 2 +    dispatch_hook."""
1103 < 2 +    limit = config["rate_limit_max_per_window"]
