88 < 2 +++ b/app/audit_query.py
89 < 2 @@ -0,0 +1,257 @@
90 < 2 +"""Pure read-side query toolkit over audit entry lists.
91 < 2 +
92 < 2 +Every function here takes a plain list of `{"method", "path", "actor"}`
93 < 2 +entry dicts as its `entries` argument and returns a fresh result without
94 < 2 +ever mutating that argument or the dicts inside it. This module imports
95 < 2 +nothing from app.audit — it knows nothing about the live log, only about
96 < 2 +lists of entries it is handed.
97 < 2 +"""
98 < 2 +
99 < 2 +_FIELDS = ("method", "path", "actor")
100 < 2 +
101 < 2 +
102 < 2 +def _check_field(field):
103 < 2 +    if field not in _FIELDS:
104 < 2 +        raise ValueError("unknown field: %s" % field)
105 < 2 +
106 < 2 +
107 < 2 +def filter_entries(entries, actor=None, method=None, path=None):
108 < 2 +    """Copies of the entries matching every given (non-None) criterion,
109 < 2 +    in original order. No criteria given returns every entry."""
110 < 2 +    result = []
111 < 2 +    for entry in entries:
112 < 2 +        if actor is not None and entry.get("actor") != actor:
113 < 2 +            continue
114 < 2 +        if method is not None and entry.get("method") != method:
115 < 2 +            continue
116 < 2 +        if path is not None and entry.get("path") != path:
117 < 2 +            continue
118 < 2 +        result.append(dict(entry))
119 < 2 +    return result
120 < 2 +
121 < 2 +
122 < 2 +def counts_by(entries, field):
123 < 2 +    """value -> count over `field` (one of "method"/"path"/"actor")."""
124 < 2 +    _check_field(field)
125 < 2 +    counts = {}
126 < 2 +    for entry in entries:
127 < 2 +        value = entry[field]
128 < 2 +        counts[value] = counts.get(value, 0) + 1
129 < 2 +    return counts
130 < 2 +
131 < 2 +
132 < 2 +def counts_matrix(entries):
133 < 2 +    """Nested dict method -> actor -> count. Only combinations that
134 < 2 +    occur appear; no zero-filled cells."""
135 < 2 +    matrix = {}
136 < 2 +    for entry in entries:
137 < 2 +        method = entry["method"]
138 < 2 +        actor = entry["actor"]
139 < 2 +        by_actor = matrix.setdefault(method, {})
140 < 2 +        by_actor[actor] = by_actor.get(actor, 0) + 1
141 < 2 +    return matrix
142 < 2 +
143 < 2 +
144 < 2 +def rollup(entries, fields):
145 < 2 +    """Counts nested by each field in `fields`, in order. `fields` must
146 < 2 +    be a non-empty list of distinct names drawn from "method"/"path"/
147 < 2 +    "actor"."""
148 < 2 +    if not fields:
149 < 2 +        raise ValueError("fields must not be empty")
150 < 2 +    seen = set()
151 < 2 +    for field in fields:
152 < 2 +        _check_field(field)
153 < 2 +        if field in seen:
154 < 2 +            raise ValueError("duplicate field: %s" % field)
155 < 2 +        seen.add(field)
156 < 2 +    return _rollup(entries, fields)
157 < 2 +
158 < 2 +
159 < 2 +def _rollup(entries, fields):
160 < 2 +    if len(fields) == 1:
161 < 2 +        return counts_by(entries, fields[0])
162 < 2 +    field, rest = fields[0], fields[1:]
163 < 2 +    groups = {}
164 < 2 +    for entry in entries:
165 < 2 +        groups.setdefault(entry[field], []).append(entry)
166 < 2 +    return {value: _rollup(group, rest) for value, group in groups.items()}
167 < 2 +
168 < 2 +
169 < 2 +def last_n(entries, n):
170 < 2 +    """The final `n` entries (a copy), in order. `n` larger than the
171 < 2 +    list returns the whole list (a copy)."""
172 < 2 +    if n < 0:
173 < 2 +        raise ValueError("n must be >= 0")
174 < 2 +    if n == 0:
175 < 2 +        return []
176 < 2 +    return [dict(entry) for entry in entries[-n:]]
177 < 2 +
178 < 2 +
179 < 2 +def redact(entries, fields):
180 < 2 +    """New entry dicts with each field in `fields` replaced by "***";
181 < 2 +    the other keys, and the originals, are untouched."""
182 < 2 +    for field in fields:
183 < 2 +        _check_field(field)
184 < 2 +    result = []
185 < 2 +    for entry in entries:
186 < 2 +        new_entry = dict(entry)
187 < 2 +        for field in fields:
188 < 2 +            new_entry[field] = "***"
189 < 2 +        result.append(new_entry)
190 < 2 +    return result
191 < 2 +
192 < 2 +
193 < 2 +def summary(entries):
194 < 2 +    """Total/by_method/by_actor/first/last over `entries`. `first` and
195 < 2 +    `last` are copies of the first and last entries, or None."""
196 < 2 +    if not entries:
197 < 2 +        return {"total": 0, "by_method": {}, "by_actor": {}, "first": None, "last": None}
198 < 2 +    return {
199 < 2 +        "total": len(entries),
200 < 2 +        "by_method": counts_by(entries, "method"),
201 < 2 +        "by_actor": counts_by(entries, "actor"),
202 < 2 +        "first": dict(entries[0]),
203 < 2 +        "last": dict(entries[-1]),
204 < 2 +    }
205 < 2 +
206 < 2 +
207 < 2 +def recent(entries, config):
208 < 2 +    """The most recent `config["audit_query_default_limit"]` entries."""
209 < 2 +    return last_n(entries, config["audit_query_default_limit"])
210 < 2 +
211 < 2 +
212 < 2 +def paginate(entries, page, per_page):
213 < 2 +    """1-based page of `entries`: `{"page", "pages", "total", "items"}`.
214 < 2 +    `items` is always a copy."""
215 < 2 +    if page < 1 or per_page < 1:
216 < 2 +        raise ValueError("page and per_page must be >= 1")
217 < 2 +    total = len(entries)
218 < 2 +    pages = (total + per_page - 1) // per_page if total > 0 else 0
219 < 2 +    start = (page - 1) * per_page
220 < 2 +    end = start + per_page
221 < 2 +    items = [dict(entry) for entry in entries[start:end]]
222 < 2 +    return {"page": page, "pages": pages, "total": total, "items": items}
223 < 2 +
224 < 2 +
225 < 2 +def to_report(entries):
226 < 2 +    """Plain-text report: header/total, then a "by method:" and a
227 < 2 +    "by actor:" section (each sorted alphabetically), each preceded by
228 < 2 +    a blank line. Sections with no counts are omitted entirely."""
229 < 2 +    methods = counts_by(entries, "method")
230 < 2 +    actors = counts_by(entries, "actor")
231 < 2 +    lines = ["audit report", "total: %d" % len(entries)]
232 < 2 +    if methods:
233 < 2 +        lines.append("")
234 < 2 +        lines.append("by method:")
235 < 2 +        for name in sorted(methods):
236 < 2 +            lines.append("  %s: %d" % (name, methods[name]))
237 < 2 +    if actors:
238 < 2 +        lines.append("")
239 < 2 +        lines.append("by actor:")
240 < 2 +        for name in sorted(actors):
241 < 2 +            lines.append("  %s: %d" % (name, actors[name]))
242 < 2 +    return "\n".join(lines)
243 < 2 +
244 < 2 +
245 < 2 +def to_csv_report(entries):
246 < 2 +    """CSV report: header row, then one "method,<value>,<count>" row
247 < 2 +    per method (alphabetical) and one "actor,<value>,<count>" row per
248 < 2 +    actor (alphabetical)."""
249 < 2 +    methods = counts_by(entries, "method")
250 < 2 +    actors = counts_by(entries, "actor")
251 < 2 +    lines = ["field,value,count"]
252 < 2 +    for name in sorted(methods):
253 < 2 +        lines.append("method,%s,%d" % (name, methods[name]))
254 < 2 +    for name in sorted(actors):
255 < 2 +        lines.append("actor,%s,%d" % (name, actors[name]))
256 < 2 +    return "\n".join(lines)
257 < 2 +
258 < 2 +
259 < 2 +def to_markdown_report(entries):
260 < 2 +    """Pipe-table report with the same row order/content as
261 < 2 +    `to_csv_report`, no cell padding."""
262 < 2 +    methods = counts_by(entries, "method")
263 < 2 +    actors = counts_by(entries, "actor")
264 < 2 +    lines = ["| field | value | count |", "| --- | --- | --- |"]
265 < 2 +    for name in sorted(methods):
266 < 2 +        lines.append("| method | %s | %d |" % (name, methods[name]))
267 < 2 +    for name in sorted(actors):
268 < 2 +        lines.append("| actor | %s | %d |" % (name, actors[name]))
269 < 2 +    return "\n".join(lines)
270 < 2 +
271 < 2 +
272 < 2 +def top_actors(entries, n):
273 < 2 +    """`(actor, count)` tuples sorted by count descending, ties broken
274 < 2 +    by actor ascending, truncated to `n`."""
275 < 2 +    if n < 0:
276 < 2 +        raise ValueError("n must be >= 0")
277 < 2 +    counts = counts_by(entries, "actor")
278 < 2 +    ranked = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
279 < 2 +    return ranked[:n]
280 < 2 +
281 < 2 +
282 < 2 +def merge_entries(*entry_lists):
283 < 2 +    """One new list concatenating the input lists in argument order;
284 < 2 +    entries are copies."""
285 < 2 +    result = []
286 < 2 +    for entry_list in entry_lists:
287 < 2 +        for entry in entry_list:
288 < 2 +            result.append(dict(entry))
289 < 2 +    return result
290 < 2 +
291 < 2 +
292 < 2 +def _diff_counts(a_counts, b_counts):
293 < 2 +    diff = {}
294 < 2 +    for key in set(a_counts) | set(b_counts):
295 < 2 +        a_value = a_counts.get(key, 0)
296 < 2 +        b_value = b_counts.get(key, 0)
297 < 2 +        if a_value != b_value:
298 < 2 +            diff[key] = b_value - a_value
299 < 2 +    return diff
300 < 2 +
301 < 2 +
302 < 2 +def diff_summaries(a, b):
303 < 2 +    """Given two `summary(...)` dicts, the delta from `a` to `b`: total
304 < 2 +    difference, plus only the by_method/by_actor values whose counts
305 < 2 +    changed (a value absent from one side counts as 0)."""
306 < 2 +    return {
307 < 2 +        "total": b["total"] - a["total"],
308 < 2 +        "by_method": _diff_counts(a["by_method"], b["by_method"]),
309 < 2 +        "by_actor": _diff_counts(a["by_actor"], b["by_actor"]),
310 < 2 +    }
311 < 2 +
312 < 2 +
313 < 2 +def format_entry(entry):
314 < 2 +    """Exactly "<METHOD> <path> (<actor>)"; raises ValueError naming
315 < 2 +    the first missing key if any of the three is absent."""
316 < 2 +    for key in _FIELDS:
317 < 2 +        if key not in entry:
318 < 2 +            raise ValueError("missing key: %s" % key)
319 < 2 +    return "%s %s (%s)" % (entry["method"], entry["path"], entry["actor"])
320 < 2 +
321 < 2 +
322 < 2 +def to_lines(entries):
323 < 2 +    """`format_entry` strings for each entry, in order."""
324 < 2 +    return [format_entry(entry) for entry in entries]
325 < 2 +
326 < 2 +
327 < 2 +def group_by(entries, field):
328 < 2 +    """Dict mapping each distinct value of `field` to the list of
329 < 2 +    matching entry copies, in original order."""
330 < 2 +    _check_field(field)
331 < 2 +    result = {}
332 < 2 +    for entry in entries:
333 < 2 +        result.setdefault(entry[field], []).append(dict(entry))
334 < 2 +    return result
335 < 2 +
336 < 2 +
337 < 2 +def search(entries, needle):
338 < 2 +    """Entry copies where `needle` is a substring of any of the three
339 < 2 +    field values, in original order. `needle` must not be empty."""
340 < 2 +    if needle == "":
341 < 2 +        raise ValueError("needle must not be empty")
342 < 2 +    result = []
343 < 2 +    for entry in entries:
344 < 2 +        if any(needle in str(entry[key]) for key in _FIELDS):
345 < 2 +            result.append(dict(entry))
346 < 2 +    return result
347 < 2 diff --git a/app/backoff.py b/app/backoff.py
348 < 2 new file mode 100644
349 < 2 index 0000000..d8cf340
350 < 2 --- /dev/null
351 < 2 +++ b/app/backoff.py
352 < 2 @@ -0,0 +1,73 @@
353 < 2 +"""Deterministic retry-schedule calculator over app.quota.
354 < 2 +
355 < 2 +Imports app.quota only (never app.ratelimit); pure — no module state
356 < 2 +of its own.
357 < 2 +"""
358 < 2 +from app import quota
359 < 2 +
360 < 2 +
361 < 2 +class BackoffError(Exception):
362 < 2 +    pass
363 < 2 +
364 < 2 +
365 < 2 +def schedule(base, factor, retries):
366 < 2 +    """Exponential delay schedule: [base * factor**i for i in
367 < 2 +    range(retries)], as floats."""
368 < 2 +    if base <= 0:
369 < 2 +        raise BackoffError("base must be > 0, got %r" % (base,))
370 < 2 +    if factor < 1.0:
371 < 2 +        raise BackoffError("factor must be >= 1.0, got %r" % (factor,))
372 < 2 +    if retries < 0:
373 < 2 +        raise BackoffError("retries must be >= 0, got %r" % (retries,))
374 < 2 +    return [float(base * factor ** i) for i in range(retries)]
375 < 2 +
376 < 2 +
377 < 2 +def capped(seq, cap):
378 < 2 +    """Element-wise min(seq[i], cap), as a new list; input unmutated."""
379 < 2 +    if cap <= 0:
380 < 2 +        raise BackoffError("cap must be > 0, got %r" % (cap,))
381 < 2 +    return [min(x, cap) for x in seq]
382 < 2 +
383 < 2 +
384 < 2 +def total_wait(seq):
385 < 2 +    return float(sum(seq))
386 < 2 +
387 < 2 +
388 < 2 +def next_delay(attempt, base, factor, cap):
389 < 2 +    """min(base * factor**attempt, cap) for a single attempt."""
390 < 2 +    if attempt < 0:
391 < 2 +        raise BackoffError("attempt must be >= 0, got %r" % (attempt,))
392 < 2 +    return min(base * factor ** attempt, cap)
393 < 2 +
394 < 2 +
395 < 2 +def delay_until_free(key, config):
396 < 2 +    """Delegates to quota.time_to_next_slot using the same config-key
397 < 2 +    conventions as app.ratelimit."""
398 < 2 +    limit = config["rate_limit_max_per_window"]
399 < 2 +    window_seconds = config.get("rate_limit_window_seconds", 60)
400 < 2 +    burst = config.get("rate_limit_burst", 0)
401 < 2 +    return quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
402 < 2 +
403 < 2 +
404 < 2 +def retry_plan(key, config, retries):
405 < 2 +    """Read-only combined view: whether a call would succeed right now,
406 < 2 +    how long until it would, and a capped exponential backoff
407 < 2 +    schedule."""
408 < 2 +    limit = config["rate_limit_max_per_window"]
409 < 2 +    window_seconds = config.get("rate_limit_window_seconds", 60)
410 < 2 +    burst = config.get("rate_limit_burst", 0)
411 < 2 +    immediate = quota.remaining(key, limit, window_seconds, burst=burst) > 0
412 < 2 +    wait = delay_until_free(key, config)
413 < 2 +    base = config.get("backoff_base", 1.0)
414 < 2 +    factor = config.get("backoff_factor", 2.0)
415 < 2 +    cap = config.get("backoff_cap", 60.0)
416 < 2 +    backoff = capped(schedule(base, factor, retries), cap)
417 < 2 +    return {"immediate": immediate, "wait": wait, "backoff": backoff}
418 < 2 +
419 < 2 +
420 < 2 +def describe_schedule(seq):
421 < 2 +    """Comma-joined delays each suffixed "s", or a fixed placeholder for
422 < 2 +    an empty schedule."""
423 < 2 +    if not seq:
424 < 2 +        return "(no retries)"
425 < 2 +    return ", ".join("%ss" % delay for delay in seq)
