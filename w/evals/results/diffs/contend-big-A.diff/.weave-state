3487 < 2 @@ -0,0 +1,180 @@
3488 < 2 +"""Tests for the windowed quota counter in app/quota.py."""
3489 < 2 +import pytest
3490 < 2 +
3491 < 2 +from app import quota
3492 < 2 +
3493 < 2 +
3494 < 2 +def setup_function(_fn):
3495 < 2 +    quota.reset()
3496 < 2 +
3497 < 2 +
3498 < 2 +def test_quota_exceeded_error_is_exception_subclass():
3499 < 2 +    assert issubclass(quota.QuotaExceededError, Exception)
3500 < 2 +
3501 < 2 +
3502 < 2 +def test_now_and_advance():
3503 < 2 +    assert quota.now() == 0.0
3504 < 2 +    assert quota.advance(30) == 30.0
3505 < 2 +    assert quota.now() == 30.0
3506 < 2 +    with pytest.raises(ValueError):
3507 < 2 +        quota.advance(-1)
3508 < 2 +    assert quota.now() == 30.0
3509 < 2 +
3510 < 2 +
3511 < 2 +def test_take_counts_then_raises():
3512 < 2 +    assert quota.take("k", limit=2, window_seconds=60) == 1
3513 < 2 +    assert quota.take("k", limit=2, window_seconds=60) == 2
3514 < 2 +    with pytest.raises(quota.QuotaExceededError) as exc:
3515 < 2 +        quota.take("k", limit=2, window_seconds=60)
3516 < 2 +    message = str(exc.value)
3517 < 2 +    assert "k" in message
3518 < 2 +    assert "2" in message
3519 < 2 +
3520 < 2 +
3521 < 2 +def test_window_pruning():
3522 < 2 +    quota.take("k", 2, 60)
3523 < 2 +    quota.take("k", 2, 60)
3524 < 2 +    quota.advance(61)
3525 < 2 +    assert quota.take("k", 2, 60) == 1
3526 < 2 +
3527 < 2 +    quota.reset()
3528 < 2 +    quota.advance(30)
3529 < 2 +    quota.take("k", 2, 60)  # hit recorded at t=30
3530 < 2 +    quota.advance(31)  # now = 61
3531 < 2 +    assert quota.now() == 61.0
3532 < 2 +    assert quota.remaining("k", 1, 60) == 0  # still counts at t=61
3533 < 2 +    quota.advance(30)  # now = 91
3534 < 2 +    assert quota.now() == 91.0
3535 < 2 +    assert quota.remaining("k", 1, 60) == 1  # no longer counts at t=91
3536 < 2 +
3537 < 2 +
3538 < 2 +def test_infinite_window_never_prunes():
3539 < 2 +    quota.take("k", 1, float("inf"))
3540 < 2 +    with pytest.raises(quota.QuotaExceededError):
3541 < 2 +        quota.take("k", 1, float("inf"))
3542 < 2 +    quota.advance(10 ** 6)
3543 < 2 +    with pytest.raises(quota.QuotaExceededError):
3544 < 2 +        quota.take("k", 1, float("inf"))
3545 < 2 +
3546 < 2 +
3547 < 2 +def test_burst_allows_extra_hits():
3548 < 2 +    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 1
3549 < 2 +    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 2
3550 < 2 +    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 3
3551 < 2 +    with pytest.raises(quota.QuotaExceededError):
3552 < 2 +        quota.take("k", limit=2, window_seconds=60, burst=1)
3553 < 2 +
3554 < 2 +
3555 < 2 +def test_per_key_independence():
3556 < 2 +    quota.take("a", 1, 60)
3557 < 2 +    with pytest.raises(quota.QuotaExceededError):
3558 < 2 +        quota.take("a", 1, 60)
3559 < 2 +    # "b" is untouched by "a"'s exhaustion, same clock and window
3560 < 2 +    assert quota.take("b", 1, 60) == 1
3561 < 2 +    with pytest.raises(quota.QuotaExceededError):
3562 < 2 +        quota.take("b", 1, 60)
3563 < 2 +    with pytest.raises(quota.QuotaExceededError):
3564 < 2 +        quota.take("a", 1, 60)
3565 < 2 +
3566 < 2 +
3567 < 2 +def test_reset_clears_clock_and_all_hits():
3568 < 2 +    quota.advance(5)
3569 < 2 +    quota.take("k", 1, 60)
3570 < 2 +    with pytest.raises(quota.QuotaExceededError):
3571 < 2 +        quota.take("k", 1, 60)
3572 < 2 +    quota.reset()
3573 < 2 +    assert quota.now() == 0.0
3574 < 2 +    assert quota.take("k", 1, 60) == 1
3575 < 2 +
3576 < 2 +
3577 < 2 +def test_remaining_is_read_only_and_recovers_after_window():
3578 < 2 +    assert quota.remaining("k", 2, 60) == 2
3579 < 2 +    quota.take("k", 2, 60)
3580 < 2 +    assert quota.remaining("k", 2, 60) == 1
3581 < 2 +    assert quota.remaining("k", 2, 60) == 1  # calling twice: same value
3582 < 2 +    assert quota.take("k", 2, 60) == 2  # still succeeds where it should
3583 < 2 +    assert quota.remaining("k", 2, 60) == 0  # floors at 0 when exhausted
3584 < 2 +    quota.advance(61)
3585 < 2 +    assert quota.remaining("k", 2, 60) == 2  # recovers to full allowance
3586 < 2 +
3587 < 2 +
3588 < 2 +def test_snapshot_exact_and_deep_copy():
3589 < 2 +    quota.take("a", 5, 60)  # t=0
3590 < 2 +    quota.advance(10)
3591 < 2 +    quota.take("a", 5, 60)  # t=10
3592 < 2 +    quota.take("b", 5, 60)  # t=10
