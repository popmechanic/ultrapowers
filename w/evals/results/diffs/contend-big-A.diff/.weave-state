637 < 2 +"""Export/report formatter: CSV, JSON, Markdown, NDJSON, TSV (+ HTML).
638 < 2 +
639 < 2 +Column model, cell rendering, escaping, and padding all come from
640 < 2 +app.tabular; this module only sequences those primitives into whole-file
641 < 2 +formats and exposes the FORMATS / EXTRA_FORMATS lookup tables the registry
642 < 2 +wires into the pre-existing /export route.
643 < 2 +"""
644 < 2 +import json
645 < 2 +
646 < 2 +from app import tabular
647 < 2 +
648 < 2 +
649 < 2 +def to_csv(records):
650 < 2 +    if not records:
651 < 2 +        return ""
652 < 2 +    cols = tabular.columns(records)
653 < 2 +    lines = [",".join(tabular.escape_csv(c) for c in cols)]
654 < 2 +    for record in records:
655 < 2 +        lines.append(
656 < 2 +            ",".join(tabular.escape_csv(tabular.cell(record.get(c))) for c in cols)
657 < 2 +        )
658 < 2 +    return "\n".join(lines)
659 < 2 +
660 < 2 +
661 < 2 +def to_json(records):
662 < 2 +    return json.dumps(records, sort_keys=True)
663 < 2 +
664 < 2 +
665 < 2 +def to_markdown(records, align="left"):
666 < 2 +    if not records:
667 < 2 +        return ""
668 < 2 +    cols = tabular.columns(records)
669 < 2 +    widths = tabular.widths(records, cols)
670 < 2 +    widths_list = [widths[c] for c in cols]
671 < 2 +
672 < 2 +    header = tabular.render_row(
673 < 2 +        [tabular.pad(c, widths[c], align) for c in cols], widths_list, align
674 < 2 +    )
675 < 2 +    if align == "right":
676 < 2 +        sep_cells = ["-" * (widths[c] - 1) + ":" for c in cols]
677 < 2 +    else:
678 < 2 +        sep_cells = ["-" * widths[c] for c in cols]
679 < 2 +    separator = "| " + " | ".join(sep_cells) + " |"
680 < 2 +
681 < 2 +    lines = [header, separator]
682 < 2 +    for record in records:
683 < 2 +        cells = [tabular.fit(tabular.cell(record.get(c)), widths[c], align) for c in cols]
684 < 2 +        lines.append(tabular.render_row(cells, widths_list, align))
685 < 2 +    return "\n".join(lines)
686 < 2 +
687 < 2 +
688 < 2 +def to_ndjson(records):
689 < 2 +    if not records:
690 < 2 +        return ""
691 < 2 +    return "\n".join(json.dumps(record, sort_keys=True) for record in records)
692 < 2 +
693 < 2 +
694 < 2 +def to_tsv(records):
695 < 2 +    if not records:
696 < 2 +        return ""
697 < 2 +    cols = tabular.columns(records)
698 < 2 +    lines = ["\t".join(tabular.sanitize_flat(c) for c in cols)]
699 < 2 +    for record in records:
700 < 2 +        lines.append(
701 < 2 +            "\t".join(tabular.sanitize_flat(record.get(c)) for c in cols)
702 < 2 +        )
703 < 2 +    return "\n".join(lines)
704 < 2 +
705 < 2 +
706 < 2 +def to_html(records):
707 < 2 +    if not records:
708 < 2 +        return ""
709 < 2 +    cols = tabular.columns(records)
710 < 2 +    lines = ["<table>"]
711 < 2 +    header_cells = "".join(
712 < 2 +        "<th>%s</th>" % tabular.escape_html(c) for c in cols
713 < 2 +    )
714 < 2 +    lines.append("<tr>%s</tr>" % header_cells)
715 < 2 +    for record in records:
716 < 2 +        row_cells = "".join(
717 < 2 +            "<td>%s</td>" % tabular.escape_html(record.get(c)) for c in cols
718 < 2 +        )
719 < 2 +        lines.append("<tr>%s</tr>" % row_cells)
720 < 2 +    lines.append("</table>")
721 < 2 +    return "\n".join(lines)
722 < 2 +
723 < 2 +
724 < 2 +def parse_csv(text):
725 < 2 +    if text == "":
726 < 2 +        return []
727 < 2 +
728 < 2 +    rows = []
729 < 2 +    row = []
730 < 2 +    field_chars = []
731 < 2 +    in_quotes = False
732 < 2 +    i = 0
733 < 2 +    n = len(text)
734 < 2 +
735 < 2 +    def end_field():
736 < 2 +        row.append("".join(field_chars))
737 < 2 +        field_chars.clear()
738 < 2 +
739 < 2 +    def end_row():
740 < 2 +        end_field()
741 < 2 +        rows.append(row[:])
742 < 2 +        row.clear()
743 < 2 +
744 < 2 +    while i < n:
745 < 2 +        ch = text[i]
746 < 2 +        if in_quotes:
747 < 2 +            if ch == '"':
748 < 2 +                if i + 1 < n and text[i + 1] == '"':
749 < 2 +                    field_chars.append('"')
750 < 2 +                    i += 2
751 < 2 +                    continue
752 < 2 +                in_quotes = False
753 < 2 +                i += 1
754 < 2 +                continue
755 < 2 +            field_chars.append(ch)
756 < 2 +            i += 1
757 < 2 +            continue
758 < 2 +
759 < 2 +        if ch == '"':
760 < 2 +            in_quotes = True
761 < 2 +            i += 1
762 < 2 +            continue
763 < 2 +        if ch == ",":
764 < 2 +            end_field()
765 < 2 +            i += 1
766 < 2 +            continue
767 < 2 +        if ch == "\r":
768 < 2 +            i += 1
769 < 2 +            continue
770 < 2 +        if ch == "\n":
771 < 2 +            end_row()
772 < 2 +            i += 1
773 < 2 +            continue
774 < 2 +        field_chars.append(ch)
775 < 2 +        i += 1
776 < 2 +
777 < 2 +    if in_quotes:
778 < 2 +        raise ValueError("unterminated quote in CSV")
779 < 2 +
780 < 2 +    # Always commit the trailing segment: a trailing unquoted newline
781 < 2 +    # implies one more (possibly empty) row, just as text.split("\n")
782 < 2 +    # would yield a trailing "" element.
783 < 2 +    end_row()
784 < 2 +
785 < 2 +    header = rows[0]
786 < 2 +    result = []
787 < 2 +    for data_row in rows[1:]:
788 < 2 +        result.append(dict(zip(header, data_row)))
789 < 2 +    return result
790 < 2 +
791 < 2 +
792 < 2 +FORMATS = {
793 < 2 +    "csv": to_csv,
794 < 2 +    "json": to_json,
795 < 2 +    "md": to_markdown,
796 < 2 +    "ndjson": to_ndjson,
797 < 2 +    "tsv": to_tsv,
798 < 2 +}
799 < 2 +
800 < 2 +EXTRA_FORMATS = {
801 < 2 +    "html": to_html,
802 < 2 +}
803 < 2 +
804 < 2 +
805 < 2 +def render(records, fmt):
806 < 2 +    if fmt not in FORMATS:
807 < 2 +        raise ValueError("unknown export format: %s" % fmt)
808 < 2 +    return FORMATS[fmt](records)
809 < 2 +
810 < 2 +
811 < 2 +def render_any(records, fmt):
812 < 2 +    if fmt in FORMATS:
813 < 2 +        return FORMATS[fmt](records)
814 < 2 +    if fmt in EXTRA_FORMATS:
815 < 2 +        return EXTRA_FORMATS[fmt](records)
816 < 2 +    raise ValueError("unknown export format: %s" % fmt)
817 < 2 +
818 < 2 +
819 < 2 +def summary_line(records):
820 < 2 +    return "%d records, %d columns" % (len(records), len(tabular.columns(records)))
