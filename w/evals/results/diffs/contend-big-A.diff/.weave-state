4696 < 2 +    }
4697 < 2 +
4698 < 2 +    policies_with_longer = dict(policies)
4699 < 2 +    policies_with_longer["GET /export/full"] = {"limit": 1, "window": 5, "burst": 0}
4700 < 2 +    assert throttle.match_policy("GET", "/export/full", policies_with_longer) == {
4701 < 2 +        "limit": 1,
4702 < 2 +        "window": 5,
4703 < 2 +        "burst": 0,
4704 < 2 +    }
4705 < 2 +
4706 < 2 +    assert throttle.match_policy("POST", "/export", policies) is None
