4976 < 2 +        {"name": "x", "amount": True}, ["name", "amount"], 100))) == \
4977 < 2 +        "field amount must be numeric (got bool)"
4978 < 2 +    assert str(_raises(lambda: validation.validate_fields(
4979 < 2 +        {"name": "x", "amount": -1}, ["name", "amount"], 100))) == \
4980 < 2 +        "field amount must be non-negative"
4981 < 2 +    assert str(_raises(lambda: validation.validate_fields(
4982 < 2 +        {"name": "x", "amount": 101}, ["name", "amount"], 100))) == \
4983 < 2 +        "field amount exceeds max_amount 100"
4984 < 2 +    assert str(_raises(lambda: validation.validate_fields(
4985 < 2 +        {"name": "", "amount": 1}, ["name", "amount"], 100))) == \
4986 < 2 +        "field name must be a non-empty string"
