2798 < 2 +
2799 < 2 +def setup_function(_fn):
2800 < 2 +    quota.reset()
2801 < 2 +
2802 < 2 +
2803 < 2 +def test_backoff_error_is_exception_subclass_distinct_from_quota_exceeded_error():
2804 < 2 +    assert issubclass(backoff.BackoffError, Exception)
2805 < 2 +    assert not issubclass(backoff.BackoffError, quota.QuotaExceededError)
2806 < 2 +
2807 < 2 +
2808 < 2 +def test_schedule_exact_values_and_types():
2809 < 2 +    result = backoff.schedule(1.0, 2.0, 3)
2810 < 2 +    assert result == [1.0, 2.0, 4.0]
2811 < 2 +    assert all(type(x) is float for x in result)
2812 < 2 +    assert backoff.schedule(1.0, 2.0, 0) == []
2813 < 2 +    with pytest.raises(backoff.BackoffError):
2814 < 2 +        backoff.schedule(0, 2.0, 3)
2815 < 2 +    with pytest.raises(backoff.BackoffError):
2816 < 2 +        backoff.schedule(1.0, 0.5, 3)
2817 < 2 +    with pytest.raises(backoff.BackoffError):
2818 < 2 +        backoff.schedule(1.0, 2.0, -1)
2819 < 2 +
2820 < 2 +
2821 < 2 +def test_capped_element_wise_min_and_unmutated_input():
2822 < 2 +    original = [1.0, 2.0, 4.0]
2823 < 2 +    result = backoff.capped(original, 3.0)
2824 < 2 +    assert result == [1.0, 2.0, 3.0]
2825 < 2 +    assert original == [1.0, 2.0, 4.0]
2826 < 2 +    with pytest.raises(backoff.BackoffError):
2827 < 2 +        backoff.capped([1.0], 0)
2828 < 2 +
2829 < 2 +
2830 < 2 +def test_total_wait():
2831 < 2 +    assert backoff.total_wait([1.0, 2.0, 3.0]) == 6.0
2832 < 2 +    assert backoff.total_wait([]) == 0.0
2833 < 2 +
2834 < 2 +
2835 < 2 +def test_next_delay_exact_values():
2836 < 2 +    assert backoff.next_delay(0, 1.0, 2.0, 60.0) == 1.0
2837 < 2 +    assert backoff.next_delay(6, 1.0, 2.0, 60.0) == 60.0
2838 < 2 +    with pytest.raises(backoff.BackoffError):
2839 < 2 +        backoff.next_delay(-1, 1.0, 2.0, 60.0)
2840 < 2 +
2841 < 2 +
2842 < 2 +def test_delay_until_free_delegates_to_time_to_next_slot(monkeypatch):
2843 < 2 +    calls = []
2844 < 2 +
2845 < 2 +    def fake_time_to_next_slot(*args, **kwargs):
2846 < 2 +        calls.append((args, kwargs))
2847 < 2 +        return 42.0
2848 < 2 +
2849 < 2 +    monkeypatch.setattr(quota, "time_to_next_slot", fake_time_to_next_slot)
2850 < 2 +    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
2851 < 2 +    result = backoff.delay_until_free("k", config)
2852 < 2 +    assert calls == [(("k", 2, 60), {"burst": 0})]
2853 < 2 +    assert result == 42.0
2854 < 2 +
2855 < 2 +    monkeypatch.undo()
2856 < 2 +    quota.take("k", 2, 60)
2857 < 2 +    quota.take("k", 2, 60)
2858 < 2 +    quota.advance(10)
2859 < 2 +    assert backoff.delay_until_free("k", config) == 50.0
2860 < 2 +
2861 < 2 +    minimal_config = {"rate_limit_max_per_window": 2}
2862 < 2 +    quota.reset()
2863 < 2 +    quota.take("j", 2, 60)
2864 < 2 +    quota.take("j", 2, 60)
2865 < 2 +    assert backoff.delay_until_free("j", minimal_config) == 60.0
2866 < 2 +
2867 < 2 +
2868 < 2 +def test_retry_plan_exact_dict_fresh_and_exhausted():
2869 < 2 +    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
2870 < 2 +    assert backoff.retry_plan("k", config, 3) == {
2871 < 2 +        "immediate": True,
2872 < 2 +        "wait": 0.0,
2873 < 2 +        "backoff": [1.0, 2.0, 4.0],
2874 < 2 +    }
2875 < 2 +    # read-only: no hit recorded
2876 < 2 +    assert quota.take("k", 2, 60) == 1
2877 < 2 +
2878 < 2 +    quota.reset()
2879 < 2 +    quota.take("k", 2, 60)
2880 < 2 +    quota.take("k", 2, 60)
2881 < 2 +    quota.advance(10)
2882 < 2 +    assert backoff.retry_plan("k", config, 3) == {
2883 < 2 +        "immediate": False,
2884 < 2 +        "wait": 50.0,
2885 < 2 +        "backoff": [1.0, 2.0, 4.0],
2886 < 2 +    }
2887 < 2 +    # still read-only
2888 < 2 +    quota.advance(51)
2889 < 2 +    assert quota.take("k", 2, 60) == 1
2890 < 2 +
2891 < 2 +
