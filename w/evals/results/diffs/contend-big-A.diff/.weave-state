516 < 2 +++ b/app/colspec.py
517 < 2 @@ -0,0 +1,113 @@
518 < 2 +"""Column-projection layer: parse a compact "colspec" string into
519 < 2 +(source, header) pairs and use it to project/select/drop record fields.
520 < 2 +
521 < 2 +Pure; only depends on app.tabular for the column-model / rename helpers it
522 < 2 +delegates to.
523 < 2 +"""
524 < 2 +from app import tabular
525 < 2 +
526 < 2 +
527 < 2 +class ColspecError(Exception):
528 < 2 +    pass
529 < 2 +
530 < 2 +
531 < 2 +def parse_colspec(text):
532 < 2 +    """Parse "a,b:B,c" into [(source, header), ...]. A bare token uses its
533 < 2 +    own name as header. Whitespace around tokens and the ":" is stripped.
534 < 2 +    Raises ColspecError on an empty spec, an empty token, more than one
535 < 2 +    ":" in a token, a duplicate source, or a duplicate header."""
536 < 2 +    if not text.strip():
537 < 2 +        raise ColspecError("empty colspec")
538 < 2 +
539 < 2 +    pairs = []
540 < 2 +    seen_sources = set()
541 < 2 +    seen_headers = set()
