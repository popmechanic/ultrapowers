845 < 2 +        "amount": {"required": True, "type": "number", "max": 100000},
846 < 2 +    },
847 < 2 +    "draft": {
848 < 2 +        "name": {"type": "str"},
849 < 2 +    },
850 < 2 +    "import": {
851 < 2 +        "name": {"required": True, "type": "str", "non_empty": True},
852 < 2 +        "amount": {"type": "number"},
853 < 2 +    },
854 < 2 +}
855 < 2 +
856 < 2 +
857 < 2 +def get_profile(name):
