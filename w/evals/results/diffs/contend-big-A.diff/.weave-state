2035 < 2 +    assert audit.entries() == [
2036 < 2 +        {"method": "GET", "path": "/records", "actor": "alice"},
2037 < 2 +        {"method": "POST", "path": "/records", "actor": "bob"},
2038 < 2 +        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
2039 < 2 +    ]
2040 < 2 +
2041 < 2 +
2042 < 2 +def test_entries_returns_a_copy():
