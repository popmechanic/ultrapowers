1198 < 2 +
1199 < 2 +
1200 < 2 +def section(title, records, fmt="md"):
1201 < 2 +    if not title or not title.strip():
1202 < 2 +        raise ReportError("section title must not be empty")
1203 < 2 +    if fmt not in export.FORMATS and fmt not in export.EXTRA_FORMATS:
1204 < 2 +        raise ReportError("unknown export format: %s" % fmt)
1205 < 2 +    return {"title": title, "records": records, "fmt": fmt}
1206 < 2 +
1207 < 2 +
1208 < 2 +def render_section(sec):
1209 < 2 +    title = sec["title"]
1210 < 2 +    records = sec["records"]
1211 < 2 +    fmt = sec["fmt"]
1212 < 2 +    if not records:
1213 < 2 +        return "## " + title + "\n\n(no records)"
1214 < 2 +    return "## " + title + "\n\n" + export.render_any(records, fmt)
1215 < 2 +
1216 < 2 +
1217 < 2 +def _check_duplicate_titles(sections):
1218 < 2 +    seen = set()
1219 < 2 +    for sec in sections:
1220 < 2 +        title = sec["title"]
1221 < 2 +        if title in seen:
1222 < 2 +            raise ReportError("duplicate section title: %s" % title)
1223 < 2 +        seen.add(title)
1224 < 2 +
1225 < 2 +
1226 < 2 +def render_report(title, sections):
1227 < 2 +    if not sections:
1228 < 2 +        return "# " + title + "\n\n(empty report)"
1229 < 2 +    _check_duplicate_titles(sections)
1230 < 2 +    rendered = [render_section(sec) for sec in sections]
1231 < 2 +    return "# " + title + "\n\n" + "\n\n".join(rendered)
1232 < 2 +
1233 < 2 +
1234 < 2 +def toc(sections):
