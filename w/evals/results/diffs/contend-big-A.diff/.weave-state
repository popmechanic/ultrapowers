4 < 2 +++ b/app/audit.py
5 < 2 @@ -0,0 +1,78 @@
6 < 2 +"""Module-global audit log of every dispatched call.
7 < 2 +
8 < 2 +Keeps a capped, in-memory record of `(method, path, actor)` triples in
9 < 2 +call order. Wires into app.registry's DISPATCH_HOOKS as `dispatch_hook`,
10 < 2 +which fires for every dispatch regardless of method — unlike rate
11 < 2 +limiting, the audit log does not special-case POST/GET.
12 < 2 +
13 < 2 +`audit_log_enabled` in DEFAULT_CONFIG is recorded for a future on/off
14 < 2 +switch and is not read by any code here: `dispatch_hook` always logs.
15 < 2 +"""
16 < 2 +
17 < 2 +_log = []
18 < 2 +_dropped = 0
19 < 2 +
20 < 2 +
21 < 2 +def clear():
22 < 2 +    """Reset the log and the dropped counter. Tests must call this at
23 < 2 +    the start of every test — the log is module-global state."""
24 < 2 +    global _log, _dropped
25 < 2 +    _log = []
26 < 2 +    _dropped = 0
27 < 2 +
28 < 2 +
29 < 2 +def entries():
30 < 2 +    """Return a copy of the log, in call order. Mutating the returned
31 < 2 +    list (or its dicts) never affects the live log."""
32 < 2 +    return [dict(e) for e in _log]
33 < 2 +
34 < 2 +
35 < 2 +def dropped():
36 < 2 +    """Number of entries evicted by the cap since the last clear()."""
37 < 2 +    return _dropped
38 < 2 +
39 < 2 +
40 < 2 +def record(method, path, actor, max_entries):
41 < 2 +    """Append one `{"method", "path", "actor"}` entry, then enforce the
42 < 2 +    cap (oldest dropped first) immediately — the cap is checked on every
43 < 2 +    call, not just at the end."""
44 < 2 +    global _dropped
45 < 2 +    _log.append({"method": method, "path": path, "actor": actor})
46 < 2 +    while len(_log) > max_entries:
47 < 2 +        _log.pop(0)
48 < 2 +        _dropped += 1
49 < 2 +
50 < 2 +
51 < 2 +def record_many(triples, max_entries):
52 < 2 +    """Append each `(method, path, actor)` triple in order via
53 < 2 +    `record`, so the cap is enforced after every single append. Returns
54 < 2 +    the number of triples appended (always `len(triples)`, even for
55 < 2 +    entries that immediately age back out under the cap)."""
56 < 2 +    for method, path, actor in triples:
57 < 2 +        record(method, path, actor, max_entries)
58 < 2 +    return len(triples)
59 < 2 +
60 < 2 +
61 < 2 +def dispatch_hook(store, config, method, path, kwargs):
62 < 2 +    """DISPATCH_HOOKS entry: logs every dispatched call. The actor is
63 < 2 +    the caller's `actor` kwarg, defaulting to "anonymous". Only the
64 < 2 +    three log fields are ever recorded — other kwargs (e.g. record
65 < 2 +    fields on a create call) never leak into the audit entry."""
66 < 2 +    actor = kwargs.get("actor", "anonymous")
67 < 2 +    max_entries = config["audit_log_max_entries"]
68 < 2 +    record(method, path, actor, max_entries)
69 < 2 +
70 < 2 +
71 < 2 +def export_state():
72 < 2 +    """Return `{"entries": entries(), "dropped": dropped()}` — a copy
73 < 2 +    deep enough that mutating the result never touches the live log."""
74 < 2 +    return {"entries": entries(), "dropped": dropped()}
75 < 2 +
76 < 2 +
77 < 2 +def import_state(state):
78 < 2 +    """Replace the log and the dropped counter from an
79 < 2 +    `export_state()`-shaped dict. Copies its input: later mutations of
80 < 2 +    `state` never leak into the live log."""
81 < 2 +    global _log, _dropped
82 < 2 +    _log = [dict(e) for e in state["entries"]]
83 < 2 +    _dropped = state["dropped"]
84 < 2 diff --git a/app/audit_query.py b/app/audit_query.py
85 < 2 new file mode 100644
