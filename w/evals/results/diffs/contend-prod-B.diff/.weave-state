1537 < 2 +"""Tests for app/audit.py — a module-global append-only audit log with a
1538 < 2 +cap on retained entries."""
1539 < 2 +import pytest
1540 < 2 +
1541 < 2 +from app import audit
1542 < 2 +
1543 < 2 +
1544 < 2 +def test_entries_on_fresh_log_is_empty():
1545 < 2 +    audit.clear()
1546 < 2 +    assert audit.entries() == []
1547 < 2 +
1548 < 2 +
1549 < 2 +def test_record_appends_exactly_one_entry():
1550 < 2 +    audit.clear()
1551 < 2 +    audit.record("GET", "/records", "alice", 500)
1552 < 2 +    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
1553 < 2 +
1554 < 2 +
1555 < 2 +def test_entries_returns_in_call_order():
1556 < 2 +    audit.clear()
1557 < 2 +    audit.record("GET", "/records", "alice", 500)
1558 < 2 +    audit.record("POST", "/records", "bob", 500)
1559 < 2 +    audit.record("DELETE", "/records", "carol", 500)
1560 < 2 +    assert audit.entries() == [
1561 < 2 +        {"method": "GET", "path": "/records", "actor": "alice"},
1562 < 2 +        {"method": "POST", "path": "/records", "actor": "bob"},
1563 < 2 +        {"method": "DELETE", "path": "/records", "actor": "carol"},
1564 < 2 +    ]
1565 < 2 +
1566 < 2 +
1567 < 2 +def test_entries_returns_a_copy():
1568 < 2 +    audit.clear()
1569 < 2 +    audit.record("GET", "/records", "alice", 500)
1570 < 2 +    result = audit.entries()
1571 < 2 +    result.append({"method": "X", "path": "Y", "actor": "Z"})
1572 < 2 +    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
1573 < 2 +
1574 < 2 +
1575 < 2 +def test_cap_keeps_last_n_entries():
1576 < 2 +    audit.clear()
1577 < 2 +    audit.record("GET", "/a", "alice", 3)
1578 < 2 +    audit.record("GET", "/b", "bob", 3)
1579 < 2 +    audit.record("GET", "/c", "carol", 3)
1580 < 2 +    audit.record("GET", "/d", "dave", 3)
1581 < 2 +    assert audit.entries() == [
1582 < 2 +        {"method": "GET", "path": "/b", "actor": "bob"},
1583 < 2 +        {"method": "GET", "path": "/c", "actor": "carol"},
1584 < 2 +        {"method": "GET", "path": "/d", "actor": "dave"},
1585 < 2 +    ]
1586 < 2 +
1587 < 2 +
1588 < 2 +def test_cap_enforced_on_every_call_not_just_at_end():
1589 < 2 +    audit.clear()
1590 < 2 +    for i in range(5):
1591 < 2 +        audit.record("GET", "/p%d" % i, "actor%d" % i, 2)
1592 < 2 +        assert len(audit.entries()) <= 2
1593 < 2 +
1594 < 2 +
1595 < 2 +def test_dispatch_hook_defaults_actor_to_anonymous():
