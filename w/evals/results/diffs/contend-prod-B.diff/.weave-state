87 < 2 @@ -0,0 +1,256 @@
88 < 2 +"""Pure read-side query module over audit entry lists.
89 < 2 +
90 < 2 +Every function here takes `entries` as a plain list of `{"method",
91 < 2 +"path", "actor"}` dicts and never mutates it (or the dicts inside it) —
92 < 2 +this module imports nothing from `app.audit`; callers compose the two
93 < 2 +(see the audit log's own dispatch_hook + this module's filter_entries,
94 < 2 +for instance).
95 < 2 +"""
96 < 2 +
97 < 2 +FIELDS = ("method", "path", "actor")
98 < 2 +
99 < 2 +
100 < 2 +def _check_field(field):
101 < 2 +    if field not in FIELDS:
102 < 2 +        raise ValueError("unknown field: %s" % field)
103 < 2 +
104 < 2 +
105 < 2 +def filter_entries(entries, method=None, actor=None, path=None):
106 < 2 +    """Return a new list of the entries matching every given criterion
107 < 2 +    (criteria AND together); with no criteria, every entry is returned."""
108 < 2 +    result = entries
109 < 2 +    if method is not None:
110 < 2 +        result = [e for e in result if e["method"] == method]
111 < 2 +    if actor is not None:
112 < 2 +        result = [e for e in result if e["actor"] == actor]
113 < 2 +    if path is not None:
114 < 2 +        result = [e for e in result if e["path"] == path]
115 < 2 +    return list(result)
116 < 2 +
117 < 2 +
118 < 2 +def counts_by(entries, field):
119 < 2 +    """Return {value: count} over `field` ("method"/"path"/"actor")."""
120 < 2 +    _check_field(field)
121 < 2 +    counts = {}
122 < 2 +    for e in entries:
123 < 2 +        value = e[field]
124 < 2 +        counts[value] = counts.get(value, 0) + 1
125 < 2 +    return counts
126 < 2 +
127 < 2 +
128 < 2 +def counts_matrix(entries):
129 < 2 +    """Return the nested dict method -> actor -> count; only combinations
130 < 2 +    that occur appear (no zero-filled cells)."""
131 < 2 +    matrix = {}
132 < 2 +    for e in entries:
133 < 2 +        by_actor = matrix.setdefault(e["method"], {})
134 < 2 +        by_actor[e["actor"]] = by_actor.get(e["actor"], 0) + 1
135 < 2 +    return matrix
136 < 2 +
137 < 2 +
138 < 2 +def rollup(entries, fields):
139 < 2 +    """Generalized nested counts over `fields`, an ordered non-empty list
140 < 2 +    of distinct names drawn from FIELDS."""
141 < 2 +    if not fields:
142 < 2 +        raise ValueError("fields must be non-empty")
143 < 2 +    if len(fields) != len(set(fields)):
144 < 2 +        raise ValueError("fields must not contain duplicates")
145 < 2 +    for field in fields:
146 < 2 +        _check_field(field)
147 < 2 +
148 < 2 +    result = {}
149 < 2 +    for e in entries:
150 < 2 +        node = result
151 < 2 +        for field in fields[:-1]:
152 < 2 +            node = node.setdefault(e[field], {})
153 < 2 +        last_field = fields[-1]
154 < 2 +        node[e[last_field]] = node.get(e[last_field], 0) + 1
155 < 2 +    return result
156 < 2 +
157 < 2 +
158 < 2 +def last_n(entries, n):
159 < 2 +    """Return the final n entries in order (a copy); n=0 -> []; n larger
160 < 2 +    than the list returns the whole list (a copy); negative n raises
161 < 2 +    ValueError."""
162 < 2 +    if n < 0:
163 < 2 +        raise ValueError("n must not be negative")
164 < 2 +    if n == 0:
165 < 2 +        return []
166 < 2 +    return list(entries[-n:])
167 < 2 +
168 < 2 +
169 < 2 +def redact(entries, fields):
170 < 2 +    """Return new entry dicts with each field in `fields` replaced by
171 < 2 +    "***"; other keys untouched. `fields` outside FIELDS raises
172 < 2 +    ValueError."""
173 < 2 +    for field in fields:
174 < 2 +        _check_field(field)
175 < 2 +    result = []
176 < 2 +    for e in entries:
177 < 2 +        copy = dict(e)
178 < 2 +        for field in fields:
179 < 2 +            copy[field] = "***"
180 < 2 +        result.append(copy)
181 < 2 +    return result
182 < 2 +
183 < 2 +
184 < 2 +def summary(entries):
185 < 2 +    """Return {"total", "by_method", "by_actor", "first", "last"} over
186 < 2 +    entries; "first"/"last" are copies of the first/last entries (or None
187 < 2 +    for an empty list)."""
188 < 2 +    if not entries:
189 < 2 +        return {
190 < 2 +            "total": 0,
191 < 2 +            "by_method": {},
192 < 2 +            "by_actor": {},
193 < 2 +            "first": None,
194 < 2 +            "last": None,
195 < 2 +        }
196 < 2 +    return {
197 < 2 +        "total": len(entries),
198 < 2 +        "by_method": counts_by(entries, "method"),
199 < 2 +        "by_actor": counts_by(entries, "actor"),
200 < 2 +        "first": dict(entries[0]),
201 < 2 +        "last": dict(entries[-1]),
202 < 2 +    }
203 < 2 +
204 < 2 +
205 < 2 +def recent(entries, config):
206 < 2 +    """Return last_n(entries, config["audit_query_default_limit"])."""
207 < 2 +    return last_n(entries, config["audit_query_default_limit"])
208 < 2 +
209 < 2 +
210 < 2 +def paginate(entries, page, per_page):
211 < 2 +    """Return {"page", "pages", "total", "items"} — 1-based pages."""
212 < 2 +    if page < 1:
213 < 2 +        raise ValueError("page must be >= 1")
214 < 2 +    if per_page < 1:
215 < 2 +        raise ValueError("per_page must be >= 1")
216 < 2 +
217 < 2 +    total = len(entries)
218 < 2 +    pages = (total + per_page - 1) // per_page if total else 0
219 < 2 +    start = (page - 1) * per_page
220 < 2 +    items = list(entries[start:start + per_page])
221 < 2 +    return {"page": page, "pages": pages, "total": total, "items": items}
222 < 2 +
223 < 2 +
224 < 2 +def _report_lines(entries):
225 < 2 +    """Shared line-building for to_report/to_csv_report/to_markdown_report,
226 < 2 +    all sourced from counts_by (never a re-count)."""
227 < 2 +    by_method = counts_by(entries, "method")
228 < 2 +    by_actor = counts_by(entries, "actor")
229 < 2 +    return by_method, by_actor
230 < 2 +
231 < 2 +
232 < 2 +def to_report(entries):
233 < 2 +    """Render the plain-text audit report."""
234 < 2 +    by_method, by_actor = _report_lines(entries)
235 < 2 +    lines = ["audit report", "total: %d" % len(entries)]
236 < 2 +    if by_method:
237 < 2 +        lines.append("")
238 < 2 +        lines.append("by method:")
239 < 2 +        for method in sorted(by_method):
240 < 2 +            lines.append("  %s: %d" % (method, by_method[method]))
241 < 2 +    if by_actor:
242 < 2 +        lines.append("")
243 < 2 +        lines.append("by actor:")
244 < 2 +        for actor in sorted(by_actor):
245 < 2 +            lines.append("  %s: %d" % (actor, by_actor[actor]))
246 < 2 +    return "\n".join(lines)
247 < 2 +
248 < 2 +
249 < 2 +def to_csv_report(entries):
250 < 2 +    """Render the CSV audit report."""
251 < 2 +    by_method, by_actor = _report_lines(entries)
252 < 2 +    lines = ["field,value,count"]
253 < 2 +    for method in sorted(by_method):
254 < 2 +        lines.append("method,%s,%d" % (method, by_method[method]))
255 < 2 +    for actor in sorted(by_actor):
256 < 2 +        lines.append("actor,%s,%d" % (actor, by_actor[actor]))
257 < 2 +    return "\n".join(lines)
258 < 2 +
259 < 2 +
260 < 2 +def to_markdown_report(entries):
261 < 2 +    """Render the markdown-table audit report."""
262 < 2 +    by_method, by_actor = _report_lines(entries)
263 < 2 +    lines = ["| field | value | count |", "| --- | --- | --- |"]
264 < 2 +    for method in sorted(by_method):
265 < 2 +        lines.append("| method | %s | %d |" % (method, by_method[method]))
266 < 2 +    for actor in sorted(by_actor):
267 < 2 +        lines.append("| actor | %s | %d |" % (actor, by_actor[actor]))
268 < 2 +    return "\n".join(lines)
269 < 2 +
270 < 2 +
271 < 2 +def top_actors(entries, n):
272 < 2 +    """Return [(actor, count), ...] sorted by count descending, ties
273 < 2 +    broken by actor ascending, truncated to n."""
274 < 2 +    if n < 0:
275 < 2 +        raise ValueError("n must not be negative")
276 < 2 +    counts = counts_by(entries, "actor")
277 < 2 +    ranked = sorted(counts.items(), key=lambda pair: (-pair[1], pair[0]))
278 < 2 +    return ranked[:n]
279 < 2 +
280 < 2 +
281 < 2 +def merge_entries(*entry_lists):
282 < 2 +    """Return one new list concatenating the inputs in argument order;
283 < 2 +    entries are copies."""
284 < 2 +    result = []
285 < 2 +    for entry_list in entry_lists:
286 < 2 +        for e in entry_list:
287 < 2 +            result.append(dict(e))
288 < 2 +    return result
289 < 2 +
290 < 2 +
291 < 2 +def diff_summaries(a, b):
292 < 2 +    """Return {"total", "by_method", "by_actor"} of the deltas between two
293 < 2 +    summary(...) dicts; only values whose counts changed are included."""
294 < 2 +
295 < 2 +    def _diff(a_counts, b_counts):
296 < 2 +        changed = {}
297 < 2 +        for value in set(a_counts) | set(b_counts):
298 < 2 +            delta = b_counts.get(value, 0) - a_counts.get(value, 0)
299 < 2 +            if delta != 0:
300 < 2 +                changed[value] = delta
301 < 2 +        return changed
302 < 2 +
303 < 2 +    return {
304 < 2 +        "total": b["total"] - a["total"],
305 < 2 +        "by_method": _diff(a["by_method"], b["by_method"]),
306 < 2 +        "by_actor": _diff(a["by_actor"], b["by_actor"]),
307 < 2 +    }
308 < 2 +
309 < 2 +
310 < 2 +def format_entry(entry):
311 < 2 +    """Return "<METHOD> <path> (<actor>)"; missing key raises ValueError
312 < 2 +    naming it."""
313 < 2 +    for field in FIELDS:
314 < 2 +        if field not in entry:
315 < 2 +            raise ValueError("missing field: %s" % field)
316 < 2 +    return "%s %s (%s)" % (entry["method"], entry["path"], entry["actor"])
317 < 2 +
318 < 2 +
319 < 2 +def to_lines(entries):
320 < 2 +    """Return [format_entry(e) for e in entries]."""
321 < 2 +    return [format_entry(e) for e in entries]
322 < 2 +
323 < 2 +
324 < 2 +def group_by(entries, field):
325 < 2 +    """Return {value: [matching entry copies in original order]}."""
326 < 2 +    _check_field(field)
327 < 2 +    result = {}
328 < 2 +    for e in entries:
329 < 2 +        result.setdefault(e[field], []).append(dict(e))
330 < 2 +    return result
331 < 2 +
332 < 2 +
333 < 2 +def search(entries, needle):
334 < 2 +    """Return entry copies where `needle` is a substring of any of the
335 < 2 +    three field values, in original order. Empty needle raises
336 < 2 +    ValueError."""
337 < 2 +    if needle == "":
338 < 2 +        raise ValueError("needle must not be empty")
339 < 2 +    result = []
340 < 2 +    for e in entries:
341 < 2 +        if any(needle in e[field] for field in FIELDS):
342 < 2 +            result.append(dict(e))
343 < 2 +    return result
