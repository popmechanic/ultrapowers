3671 < 2 +
3672 < 2 +
3673 < 2 +def test_enforce_no_matching_policy_returns_none_and_records_nothing():
3674 < 2 +    result = throttle.enforce("PATCH", "/nope", "a", POLICIES)
3675 < 2 +    assert result is None
3676 < 2 +    # nothing recorded: a take against the same key still succeeds fully.
3677 < 2 +    key = throttle.key_for("PATCH", "/nope", "a")
3678 < 2 +    assert quota.take(key, limit=1, window_seconds=60) == 1
3679 < 2 +
3680 < 2 +
3681 < 2 +def test_enforce_delegates_to_quota_take(monkeypatch):
3682 < 2 +    calls = []
3683 < 2 +
3684 < 2 +    def recorder(key, limit, window_seconds, burst=0):
3685 < 2 +        calls.append((key, limit, window_seconds, burst))
3686 < 2 +        return 1
3687 < 2 +
3688 < 2 +    monkeypatch.setattr(quota, "take", recorder)
3689 < 2 +    policies = {"POST /records": {"limit": 5, "window": 60, "burst": 0}}
3690 < 2 +    result = throttle.enforce("POST", "/records", "mallory", policies)
3691 < 2 +    expected_key = throttle.key_for("POST", "/records", "mallory")
3692 < 2 +    assert calls == [(expected_key, 5, 60, 0)]
3693 < 2 +    assert result == 1
3694 < 2 +
3695 < 2 +
3696 < 2 +def test_enforce_exhausted_policy_raises_policy_error():
3697 < 2 +    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
3698 < 2 +    throttle.enforce("POST", "/records", "mallory", policies)
3699 < 2 +    with pytest.raises(PolicyError) as exc_info:
3700 < 2 +        throttle.enforce("POST", "/records", "mallory", policies)
3701 < 2 +    msg = str(exc_info.value)
3702 < 2 +    key = throttle.key_for("POST", "/records", "mallory")
3703 < 2 +    assert key in msg
3704 < 2 +    assert "1" in msg
3705 < 2 +
3706 < 2 +
3707 < 2 +def test_enforce_policy_error_chained_from_quota_exceeded_error():
3708 < 2 +    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
3709 < 2 +    throttle.enforce("POST", "/records", "mallory", policies)
3710 < 2 +    with pytest.raises(PolicyError) as exc_info:
3711 < 2 +        throttle.enforce("POST", "/records", "mallory", policies)
3712 < 2 +    assert isinstance(exc_info.value.__cause__, QuotaExceededError)
3713 < 2 +
3714 < 2 +
3715 < 2 +def test_remaining_for_none_when_no_match_else_read_only_remaining():
3716 < 2 +    assert throttle.remaining_for("PATCH", "/nope", "a", POLICIES) is None
3717 < 2 +
3718 < 2 +    policies = {"POST /records": {"limit": 2, "window": 60, "burst": 0}}
3719 < 2 +    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 2
3720 < 2 +    throttle.enforce("POST", "/records", "mallory", policies)
3721 < 2 +    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 1
3722 < 2 +    # read-only: a subsequent take still succeeds where it should
3723 < 2 +    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 1
3724 < 2 +    throttle.enforce("POST", "/records", "mallory", policies)
3725 < 2 +    with pytest.raises(PolicyError):
3726 < 2 +        throttle.enforce("POST", "/records", "mallory", policies)
3727 < 2 +
