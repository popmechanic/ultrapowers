696 < 2 @@ -0,0 +1,102 @@
697 < 2 +"""Per-actor rate limiting on top of app/quota.py.
698 < 2 +
699 < 2 +`check_and_increment` is a thin per-key call counter (no window: it uses an
700 < 2 +infinite window, since it exists for callers that just want a hard cap on
701 < 2 +total calls). `dispatch_hook` is the DISPATCH_HOOKS-shaped hook the
702 < 2 +registry wires in: it rate-limits POST /records per actor over a rolling
703 < 2 +window, and is a no-op for every other method (rate limiting applies to
704 < 2 +writes, not reads).
705 < 2 +
706 < 2 +All counting lives in `app/quota.py`'s module-global hits store --
707 < 2 +`ratelimit` keeps no counter state of its own; `reset()` here just
708 < 2 +delegates to `quota.reset()`.
709 < 2 +"""
710 < 2 +from app import quota
711 < 2 +from app.quota import QuotaExceededError
712 < 2 +
713 < 2 +
714 < 2 +class RateLimitExceededError(QuotaExceededError):
715 < 2 +    pass
716 < 2 +
717 < 2 +
718 < 2 +def reset():
719 < 2 +    """Reset all rate-limit counters (and the underlying logical clock)."""
720 < 2 +    quota.reset()
721 < 2 +
722 < 2 +
723 < 2 +def check_and_increment(key, limit, window_seconds=float("inf")):
724 < 2 +    """Record a call for `key` against a hard cap of `limit` calls (no
725 < 2 +    window by default). Returns the running count. Raises
726 < 2 +    RateLimitExceededError once exhausted."""
727 < 2 +    try:
728 < 2 +        return quota.take(key, limit, window_seconds, burst=0)
729 < 2 +    except QuotaExceededError as exc:
730 < 2 +        raise RateLimitExceededError(
731 < 2 +            "rate limit exceeded for %r: limit=%s" % (key, limit)
732 < 2 +        ) from exc
733 < 2 +
734 < 2 +
735 < 2 +def dispatch_hook(store, config, method, path, kwargs):
736 < 2 +    """DISPATCH_HOOKS entry point: rate-limits POST calls per actor over a
737 < 2 +    rolling window. A no-op for any other method. Only
738 < 2 +    `rate_limit_max_per_window` is a required config key; window and burst
739 < 2 +    always default via `.get`."""
740 < 2 +    if method != "POST":
741 < 2 +        return
742 < 2 +    actor = kwargs.get("actor", "anonymous")
743 < 2 +    limit = config["rate_limit_max_per_window"]
744 < 2 +    window_seconds = config.get("rate_limit_window_seconds", 60)
745 < 2 +    burst = config.get("rate_limit_burst", 0)
746 < 2 +    try:
747 < 2 +        quota.take(actor, limit, window_seconds, burst=burst)
748 < 2 +    except QuotaExceededError as exc:
749 < 2 +        raise RateLimitExceededError(
750 < 2 +            "rate limit exceeded for %r: limit=%s" % (actor, limit)
751 < 2 +        ) from exc
752 < 2 +
753 < 2 +
754 < 2 +def _policy_params(config):
755 < 2 +    limit = config["rate_limit_max_per_window"]
756 < 2 +    window_seconds = config.get("rate_limit_window_seconds", 60)
757 < 2 +    burst = config.get("rate_limit_burst", 0)
758 < 2 +    return limit, window_seconds, burst
759 < 2 +
760 < 2 +
761 < 2 +def retry_after(key, config):
762 < 2 +    """Seconds until `key`'s next slot frees, per the config's policy."""
763 < 2 +    limit, window_seconds, burst = _policy_params(config)
764 < 2 +    return quota.time_to_next_slot(key, limit, window_seconds, burst)
765 < 2 +
766 < 2 +
767 < 2 +def limit_headers(key, config):
768 < 2 +    """X-RateLimit-* headers for `key` under the config's policy. Records
769 < 2 +    no hit. `Limit` is the configured limit alone; burst is reflected only
770 < 2 +    in `Remaining`'s full allowance."""
771 < 2 +    limit, window_seconds, burst = _policy_params(config)
772 < 2 +    return {
773 < 2 +        "X-RateLimit-Limit": str(limit),
774 < 2 +        "X-RateLimit-Remaining": str(quota.remaining(key, limit, window_seconds, burst)),
775 < 2 +        "X-RateLimit-Reset": str(quota.time_to_next_slot(key, limit, window_seconds, burst)),
776 < 2 +    }
777 < 2 +
778 < 2 +
779 < 2 +def status_line(key, config):
780 < 2 +    """A one-line human-readable usage summary for `key`. Read-only."""
781 < 2 +    limit, window_seconds, burst = _policy_params(config)
782 < 2 +    usage = quota.usage(key, limit, window_seconds, burst)
783 < 2 +    return "%s: %s/%s, reset in %ss" % (
784 < 2 +        key,
785 < 2 +        usage["used"],
786 < 2 +        usage["allowed"],
787 < 2 +        usage["reset_in"],
788 < 2 +    )
789 < 2 +
790 < 2 +
791 < 2 +def check_many(keys, config):
792 < 2 +    """Read-only: for each key in `keys`, would a POST for it succeed right
793 < 2 +    now? Records no hits."""
794 < 2 +    limit, window_seconds, burst = _policy_params(config)
795 < 2 +    return {
796 < 2 +        key: quota.remaining(key, limit, window_seconds, burst) > 0
797 < 2 +        for key in keys
798 < 2 +    }
