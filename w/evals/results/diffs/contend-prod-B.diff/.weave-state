1436 < 2 +"""Input-validation layer wired into record creation as a PRE_CREATE_HOOK.
1437 < 2 +
1438 < 2 +Every error message here comes from schema.format_error -- this module
1439 < 2 +holds no error-message string literals of its own, so the catalog in
1440 < 2 +app.schema is the single source of truth for wording.
1441 < 2 +"""
1442 < 2 +import re
1443 < 2 +
1444 < 2 +from app import schema
1445 < 2 +
1446 < 2 +
1447 < 2 +class ValidationError(Exception):
1448 < 2 +    """Raised by validate_fields (and validate_many, per-entry) when a
1449 < 2 +    field fails validation."""
1450 < 2 +
1451 < 2 +
1452 < 2 +def validate_fields(fields, required_fields, max_amount):
1453 < 2 +    """Validate ``fields`` against ``required_fields`` (presence) and, for
1454 < 2 +    whichever of "amount"/"name" are present, their value rules. Returns
1455 < 2 +    a new dict (the input is never mutated): "name" is stripped, every
1456 < 2 +    other key/value is preserved unchanged."""
1457 < 2 +    missing = schema.check_required(fields, required_fields)
1458 < 2 +    if missing:
1459 < 2 +        raise ValidationError(schema.format_error("missing", field=missing[0]))
1460 < 2 +
1461 < 2 +    if "amount" in fields:
1462 < 2 +        amount = fields["amount"]
1463 < 2 +        if not schema.is_valid_amount(amount):
1464 < 2 +            raise ValidationError(
1465 < 2 +                schema.format_error("numeric", field="amount", got=type(amount).__name__)
1466 < 2 +            )
1467 < 2 +        if amount < 0:
1468 < 2 +            raise ValidationError(schema.format_error("non_negative", field="amount"))
1469 < 2 +        if amount > max_amount:
1470 < 2 +            raise ValidationError(
1471 < 2 +                schema.format_error("max", field="amount", limit=max_amount)
1472 < 2 +            )
1473 < 2 +
1474 < 2 +    if "name" in fields:
1475 < 2 +        name = fields["name"]
1476 < 2 +        if not schema.is_non_empty_str(name):
1477 < 2 +            raise ValidationError(schema.format_error("non_empty", field="name"))
1478 < 2 +
1479 < 2 +    result = dict(fields)
1480 < 2 +    if "name" in result:
1481 < 2 +        result["name"] = result["name"].strip()
1482 < 2 +    return result
1483 < 2 +
1484 < 2 +
1485 < 2 +def pre_create_hook(store, config, fields):
1486 < 2 +    """PRE_CREATE_HOOKS entry point: delegates to validate_fields using
1487 < 2 +    the config's validation settings. ``store`` is unused."""
1488 < 2 +    return validate_fields(
1489 < 2 +        fields,
1490 < 2 +        config["validation_required_fields"],
1491 < 2 +        config["validation_max_amount"],
1492 < 2 +    )
1493 < 2 +
1494 < 2 +
1495 < 2 +def validate_many(entries, required_fields, max_amount):
1496 < 2 +    """Validate a list of ``fields`` dicts. Returns (validated, errors):
1497 < 2 +    validated is the list of successfully-validated new dicts in input
1498 < 2 +    order; errors is a list of (index, str(err)) tuples for the
1499 < 2 +    failures, also in input order. Neither the input list nor its dicts
1500 < 2 +    are mutated."""
1501 < 2 +    validated = []
1502 < 2 +    errors = []
1503 < 2 +    for index, entry in enumerate(entries):
1504 < 2 +        try:
1505 < 2 +            validated.append(validate_fields(entry, required_fields, max_amount))
1506 < 2 +        except ValidationError as exc:
1507 < 2 +            errors.append((index, str(exc)))
1508 < 2 +    return validated, errors
1509 < 2 +
1510 < 2 +
1511 < 2 +def error_code(message):
1512 < 2 +    """Map an error-message string back to its ERROR_CATALOG code by
1513 < 2 +    matching against the catalog's templates, built fresh from
1514 < 2 +    schema.ERROR_CATALOG at call time (not a second hand-written table)."""
1515 < 2 +    for code, template in schema.ERROR_CATALOG.items():
1516 < 2 +        pattern = re.escape(template)
1517 < 2 +        pattern = re.sub(r"\\\{\w+\\\}", ".*", pattern)
1518 < 2 +        if re.fullmatch(pattern, message):
1519 < 2 +            return code
1520 < 2 +    raise ValueError("unrecognized error message: %s" % message)
1521 < 2 +
1522 < 2 +
1523 < 2 +def explain_config(config):
1524 < 2 +    """Render an exact human-readable summary of the validation config."""
1525 < 2 +    required = config["validation_required_fields"]
1526 < 2 +    max_amount = config["validation_max_amount"]
1527 < 2 +    return "validation config:\n  required: %s\n  max_amount: %s" % (
1528 < 2 +        ", ".join(required),
1529 < 2 +        max_amount,
1530 < 2 +    )
