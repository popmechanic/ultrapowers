2618 < 2 +def test_purge_drops_aged_out_hits_and_returns_count():
2619 < 2 +    quota.take("k1", limit=5, window_seconds=60)  # t=0
2620 < 2 +    quota.take("k1", limit=5, window_seconds=60)  # t=0
2621 < 2 +    quota.advance(10)
2622 < 2 +    quota.take("k2", limit=5, window_seconds=60)  # t=10
2623 < 2 +    quota.advance(60)  # now=70: k1's two t=0 hits aged out, k2's t=10 hit stays (60 not > 60)
2624 < 2 +    dropped = quota.purge(60)
2625 < 2 +    assert dropped == 2
2626 < 2 +    assert "k1" not in quota.snapshot(60)
2627 < 2 +    assert quota.snapshot(60) == {"k2": [10.0]}
2628 < 2 +    assert quota.purge(60) == 0
