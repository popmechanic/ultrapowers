1709 < 2 +++ b/tests/test_audit_query.py
1710 < 2 @@ -0,0 +1,450 @@
1711 < 2 +"""Tests for app/audit_query.py — a pure read-side module over audit entry
1712 < 2 +lists. Every function takes `entries` as a plain list argument and never
1713 < 2 +mutates its input; each test snapshots the input before calling and
1714 < 2 +asserts it is unchanged afterward."""
1715 < 2 +import copy
1716 < 2 +
1717 < 2 +import pytest
1718 < 2 +
1719 < 2 +from app import audit_query as aq
1720 < 2 +
1721 < 2 +
1722 < 2 +def assert_unmutated(entries, snapshot):
1723 < 2 +    assert entries == snapshot
1724 < 2 +
1725 < 2 +
1726 < 2 +ENTRIES_4 = [
1727 < 2 +    {"method": "GET", "path": "/records", "actor": "alice"},
1728 < 2 +    {"method": "POST", "path": "/records", "actor": "bob"},
1729 < 2 +    {"method": "GET", "path": "/report", "actor": "alice"},
1730 < 2 +    {"method": "DELETE", "path": "/records/1", "actor": "carol"},
1731 < 2 +]
1732 < 2 +
1733 < 2 +
1734 < 2 +def make_entries_4():
1735 < 2 +    return copy.deepcopy(ENTRIES_4)
1736 < 2 +
1737 < 2 +
1738 < 2 +def test_filter_entries():
1739 < 2 +    entries = [
1740 < 2 +        {"method": "GET", "path": "/records", "actor": "a"},
1741 < 2 +        {"method": "POST", "path": "/records", "actor": "b"},
1742 < 2 +        {"method": "GET", "path": "/other", "actor": "a"},
1743 < 2 +        {"method": "POST", "path": "/other", "actor": "a"},
1744 < 2 +    ]
1745 < 2 +    snapshot = copy.deepcopy(entries)
1746 < 2 +
1747 < 2 +    assert aq.filter_entries(entries, actor="a") == [entries[0], entries[2], entries[3]]
1748 < 2 +    assert_unmutated(entries, snapshot)
1749 < 2 +
1750 < 2 +    assert aq.filter_entries(entries, method="POST") == [entries[1], entries[3]]
1751 < 2 +    assert_unmutated(entries, snapshot)
1752 < 2 +
1753 < 2 +    assert aq.filter_entries(entries, path="/records") == [entries[0], entries[1]]
1754 < 2 +    assert_unmutated(entries, snapshot)
1755 < 2 +
1756 < 2 +    assert aq.filter_entries(entries, actor="a", method="POST") == [entries[3]]
1757 < 2 +    assert_unmutated(entries, snapshot)
1758 < 2 +
1759 < 2 +    assert aq.filter_entries(entries) == entries
1760 < 2 +    assert_unmutated(entries, snapshot)
1761 < 2 +
1762 < 2 +    first_call = aq.filter_entries(entries, actor="a")
1763 < 2 +    first_call.append({"method": "X", "path": "Y", "actor": "Z"})
1764 < 2 +    second_call = aq.filter_entries(entries, actor="a")
1765 < 2 +    assert second_call == [entries[0], entries[2], entries[3]]
1766 < 2 +    assert_unmutated(entries, snapshot)
1767 < 2 +
1768 < 2 +
1769 < 2 +def test_counts_by():
1770 < 2 +    entries = make_entries_4()
1771 < 2 +    snapshot = copy.deepcopy(entries)
1772 < 2 +
1773 < 2 +    assert aq.counts_by(entries, "method") == {"GET": 2, "POST": 1, "DELETE": 1}
1774 < 2 +    assert_unmutated(entries, snapshot)
1775 < 2 +
1776 < 2 +    assert aq.counts_by(entries, "actor") == {"alice": 2, "bob": 1, "carol": 1}
1777 < 2 +    assert_unmutated(entries, snapshot)
1778 < 2 +
1779 < 2 +    assert aq.counts_by(entries, "path") == {
1780 < 2 +        "/records": 2,
1781 < 2 +        "/report": 1,
1782 < 2 +        "/records/1": 1,
1783 < 2 +    }
1784 < 2 +    assert_unmutated(entries, snapshot)
1785 < 2 +
1786 < 2 +    with pytest.raises(ValueError):
1787 < 2 +        aq.counts_by(entries, "bogus")
1788 < 2 +
1789 < 2 +    assert aq.counts_by([], "method") == {}
