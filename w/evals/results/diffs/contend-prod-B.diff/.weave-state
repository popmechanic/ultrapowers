3730 < 2 +    policies = {
3731 < 2 +        "POST /records": {"limit": 5, "window": 60, "burst": 0},
3732 < 2 +        "GET /export": {"limit": 10, "window": 60, "burst": 2},
3733 < 2 +    }
3734 < 2 +    expected = (
3735 < 2 +        "GET /export: limit=10, window=60, burst=2\n"
3736 < 2 +        "POST /records: limit=5, window=60, burst=0"
3737 < 2 +    )
3738 < 2 +    assert throttle.describe_policies(policies) == expected
3739 < 2 +    assert throttle.describe_policies({}) == "(no policies)"
3740 < 2 +
3741 < 2 +
3742 < 2 +def test_end_to_end_enforce_then_advance_frees_slot():
3743 < 2 +    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
3744 < 2 +    throttle.enforce("POST", "/records", "mallory", policies)
3745 < 2 +    with pytest.raises(PolicyError):
3746 < 2 +        throttle.enforce("POST", "/records", "mallory", policies)
3747 < 2 +    quota.advance(61)
3748 < 2 +    throttle.enforce("POST", "/records", "mallory", policies)  # passes
