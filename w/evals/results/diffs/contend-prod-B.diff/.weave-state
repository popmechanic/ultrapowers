837 < 2 @@ -0,0 +1,154 @@
838 < 2 +"""Pure rule-combinator layer on top of app.schema's predicates.
839 < 2 +
840 < 2 +A "rule" is a plain dict: {"name": <str>, "test": <callable>}. Rules
841 < 2 +combine (all_of/any_of/negate/when) without ever reimplementing the
842 < 2 +predicates schema.py already owns -- every builtin here calls through to
843 < 2 +app.schema at call time, so patching schema's predicates changes what
844 < 2 +these rules do.
845 < 2 +"""
846 < 2 +from app import schema
847 < 2 +
848 < 2 +
849 < 2 +class RuleError(Exception):
850 < 2 +    """Distinct from schema.SchemaError -- this module's own error type."""
851 < 2 +
852 < 2 +
853 < 2 +def rule(name, predicate):
854 < 2 +    """Build a rule dict. ``name`` must be a non-empty string."""
855 < 2 +    if not isinstance(name, str) or name == "":
856 < 2 +        raise ValueError("rule name must be a non-empty string")
857 < 2 +    return {"name": name, "test": predicate}
858 < 2 +
859 < 2 +
860 < 2 +def check(value, r):
861 < 2 +    """Run a rule's predicate against ``value``."""
862 < 2 +    return bool(r["test"](value))
863 < 2 +
864 < 2 +
865 < 2 +def all_of(*rules):
866 < 2 +    """Composite rule passing iff every child rule passes."""
867 < 2 +    name = "all(" + ",".join(r["name"] for r in rules) + ")"
868 < 2 +
869 < 2 +    def test(value):
870 < 2 +        return all(check(value, r) for r in rules)
871 < 2 +
872 < 2 +    return rule(name, test)
873 < 2 +
874 < 2 +
875 < 2 +def any_of(*rules):
876 < 2 +    """Composite rule passing iff at least one child rule passes. A
877 < 2 +    vacuous any_of() (no children) is a bug, not a policy: ValueError."""
878 < 2 +    if not rules:
879 < 2 +        raise ValueError("any_of requires at least one rule")
880 < 2 +    name = "any(" + ",".join(r["name"] for r in rules) + ")"
881 < 2 +
882 < 2 +    def test(value):
883 < 2 +        return any(check(value, r) for r in rules)
884 < 2 +
885 < 2 +    return rule(name, test)
886 < 2 +
887 < 2 +
888 < 2 +def negate(r):
889 < 2 +    """Invert a rule."""
890 < 2 +    name = "not(%s)" % r["name"]
891 < 2 +
892 < 2 +    def test(value):
893 < 2 +        return not check(value, r)
894 < 2 +
895 < 2 +    return rule(name, test)
896 < 2 +
897 < 2 +
898 < 2 +def when(cond, then):
899 < 2 +    """Material implication: passes when ``cond`` fails, or ``then``
900 < 2 +    passes."""
901 < 2 +    name = "when(%s,%s)" % (cond["name"], then["name"])
902 < 2 +
903 < 2 +    def test(value):
904 < 2 +        return (not check(value, cond)) or check(value, then)
905 < 2 +
906 < 2 +    return rule(name, test)
907 < 2 +
908 < 2 +
909 < 2 +def explain(value, r):
910 < 2 +    """Return "<name>: pass" or "<name>: fail" for ``value`` against ``r``."""
911 < 2 +    return "%s: %s" % (r["name"], "pass" if check(value, r) else "fail")
912 < 2 +
913 < 2 +
914 < 2 +def apply_rules(fields, rules_by_field):
915 < 2 +    """Return the list of "field <f> failed <rule name>" strings, in
916 < 2 +    rules_by_field insertion order, skipping fields absent from
917 < 2 +    ``fields``. ``fields`` is never mutated."""
918 < 2 +    errors = []
919 < 2 +    for field, r in rules_by_field.items():
920 < 2 +        if field not in fields:
921 < 2 +            continue
922 < 2 +        if not check(fields[field], r):
923 < 2 +            errors.append("field %s failed %s" % (field, r["name"]))
924 < 2 +    return errors
925 < 2 +
926 < 2 +
927 < 2 +def first_failure(fields, rules_by_field):
928 < 2 +    """Return the (field, rule name) tuple of the first failure in
929 < 2 +    insertion order, or None."""
930 < 2 +    for field, r in rules_by_field.items():
931 < 2 +        if field not in fields:
932 < 2 +            continue
933 < 2 +        if not check(fields[field], r):
934 < 2 +            return (field, r["name"])
935 < 2 +    return None
936 < 2 +
937 < 2 +
938 < 2 +def explain_failures(fields, rules_by_field):
939 < 2 +    """Return explain() strings for failing fields only, in
940 < 2 +    rules_by_field insertion order."""
941 < 2 +    result = []
942 < 2 +    for field, r in rules_by_field.items():
943 < 2 +        if field not in fields:
944 < 2 +            continue
945 < 2 +        if not check(fields[field], r):
946 < 2 +            result.append(explain(fields[field], r))
947 < 2 +    return result
948 < 2 +
949 < 2 +
950 < 2 +BUILTINS = {
951 < 2 +    "number": rule("number", lambda value: schema.is_valid_amount(value)),
952 < 2 +    "str": rule("str", lambda value: isinstance(value, str)),
953 < 2 +    "non_empty": rule("non_empty", lambda value: schema.is_non_empty_str(value)),
954 < 2 +}
955 < 2 +
956 < 2 +
957 < 2 +def parse_rule(text):
958 < 2 +    """Parse a "&"-joined builtin list into a single rule, composing with
959 < 2 +    all_of when more than one token is present, in text order."""
960 < 2 +    if not text:
961 < 2 +        raise ValueError("empty rule text")
962 < 2 +    tokens = text.split("&")
963 < 2 +    resolved = []
964 < 2 +    for token in tokens:
965 < 2 +        if token not in BUILTINS:
966 < 2 +            raise ValueError("unknown rule: %s" % token)
967 < 2 +        resolved.append(BUILTINS[token])
968 < 2 +    if len(resolved) == 1:
969 < 2 +        return resolved[0]
970 < 2 +    return all_of(*resolved)
971 < 2 +
972 < 2 +
973 < 2 +def parse_rules(text_by_field):
974 < 2 +    """Map a dict of field name -> "&"-joined rule text through
975 < 2 +    parse_rule, preserving insertion order."""
976 < 2 +    result = {}
977 < 2 +    for field, text in text_by_field.items():
978 < 2 +        try:
979 < 2 +            result[field] = parse_rule(text)
980 < 2 +        except ValueError as exc:
981 < 2 +            raise ValueError("field %s: %s" % (field, exc))
982 < 2 +    return result
983 < 2 +
984 < 2 +
985 < 2 +def describe_rules(rules_by_field):
986 < 2 +    """Render an exact multi-line description: one line per field in
987 < 2 +    insertion order, "<field>: <rule name>"."""
988 < 2 +    if not rules_by_field:
989 < 2 +        return "(no rules)"
990 < 2 +    lines = ["%s: %s" % (field, r["name"]) for field, r in rules_by_field.items()]
991 < 2 +    return "\n".join(lines)
