3659 < 2 +    assert policy == POLICIES["GET /export"]
3660 < 2 +
3661 < 2 +    extended = dict(POLICIES)
3662 < 2 +    extended["GET /export/full"] = {"limit": 3, "window": 10, "burst": 0}
3663 < 2 +    policy = throttle.match_policy("GET", "/export/full", extended)
3664 < 2 +    assert policy == extended["GET /export/full"]
3665 < 2 +
3666 < 2 +    assert throttle.match_policy("POST", "/export", POLICIES) is None
3667 < 2 +
