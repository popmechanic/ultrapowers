349 < 2 @@ -0,0 +1,205 @@
350 < 2 +"""Machine-readable export formats built on top of `app.tabular`.
351 < 2 +
352 < 2 +Every serializer builds its column model and cell rendering through
353 < 2 +`tabular` so the key-union, escaping, and str() logic exist in exactly
354 < 2 +one place.
355 < 2 +"""
356 < 2 +import json
357 < 2 +
358 < 2 +from app import tabular
359 < 2 +
360 < 2 +
361 < 2 +def to_csv(records):
362 < 2 +    """CSV rendering: header row of the sorted column union, then one
363 < 2 +    row per record, missing fields as empty cells."""
364 < 2 +    if not records:
365 < 2 +        return ""
366 < 2 +    cols = tabular.columns(records)
367 < 2 +    lines = [",".join(tabular.escape_csv(c) for c in cols)]
368 < 2 +    for r in records:
369 < 2 +        lines.append(",".join(tabular.escape_csv(r.get(c)) for c in cols))
370 < 2 +    return "\n".join(lines)
371 < 2 +
372 < 2 +
373 < 2 +def to_json(records):
374 < 2 +    """JSON array of the records, keys sorted."""
375 < 2 +    return json.dumps(records, sort_keys=True)
376 < 2 +
377 < 2 +
378 < 2 +def to_markdown(records, align="left"):
379 < 2 +    """Pipe-table rendering: header row, dash separator, one row per
380 < 2 +    record. `align` is "left" or "right" (delegated to tabular.pad via
381 < 2 +    tabular.fit/render_row for the ValueError)."""
382 < 2 +    if not records:
383 < 2 +        return ""
384 < 2 +    cols = tabular.columns(records)
385 < 2 +    col_widths = tabular.widths(records, cols)
386 < 2 +    widths_list = [col_widths[c] for c in cols]
387 < 2 +
388 < 2 +    header_cells = [tabular.pad(c, col_widths[c], align) for c in cols]
389 < 2 +    header_row = tabular.render_row(header_cells, widths_list, align)
390 < 2 +
391 < 2 +    if align == "right":
392 < 2 +        sep_cells = ["-" * (col_widths[c] - 1) + ":" for c in cols]
393 < 2 +    else:
394 < 2 +        sep_cells = ["-" * col_widths[c] for c in cols]
395 < 2 +    sep_row = "| " + " | ".join(sep_cells) + " |"
396 < 2 +
397 < 2 +    rows = [header_row, sep_row]
398 < 2 +    for r in records:
399 < 2 +        cells = [
400 < 2 +            tabular.pad(tabular.cell(r.get(c)), col_widths[c], align)
401 < 2 +            for c in cols
402 < 2 +        ]
403 < 2 +        rows.append(tabular.render_row(cells, widths_list, align))
404 < 2 +    return "\n".join(rows)
405 < 2 +
406 < 2 +
407 < 2 +def to_ndjson(records):
408 < 2 +    """One JSON object per line, sort_keys=True, no trailing newline."""
409 < 2 +    if not records:
410 < 2 +        return ""
411 < 2 +    return "\n".join(json.dumps(r, sort_keys=True) for r in records)
412 < 2 +
413 < 2 +
414 < 2 +def to_tsv(records):
415 < 2 +    """Tab-separated rendering: sorted-column header then one row per
416 < 2 +    record, every cell and header passed through tabular.sanitize_flat."""
417 < 2 +    if not records:
418 < 2 +        return ""
419 < 2 +    cols = tabular.columns(records)
420 < 2 +    lines = ["\t".join(tabular.sanitize_flat(c) for c in cols)]
421 < 2 +    for r in records:
422 < 2 +        lines.append(
423 < 2 +            "\t".join(tabular.sanitize_flat(r.get(c)) for c in cols)
424 < 2 +        )
425 < 2 +    return "\n".join(lines)
426 < 2 +
427 < 2 +
428 < 2 +def to_html(records):
429 < 2 +    """<table> rendering: header row, one row per record, every cell and
430 < 2 +    header passed through tabular.escape_html. Not in FORMATS/registry."""
431 < 2 +    if not records:
432 < 2 +        return ""
433 < 2 +    cols = tabular.columns(records)
434 < 2 +    lines = ["<table>"]
435 < 2 +    header = "".join(
436 < 2 +        "<th>%s</th>" % tabular.escape_html(c) for c in cols
437 < 2 +    )
438 < 2 +    lines.append("<tr>%s</tr>" % header)
439 < 2 +    for r in records:
440 < 2 +        cells = "".join(
441 < 2 +            "<td>%s</td>" % tabular.escape_html(r.get(c)) for c in cols
442 < 2 +        )
443 < 2 +        lines.append("<tr>%s</tr>" % cells)
444 < 2 +    lines.append("</table>")
445 < 2 +    return "\n".join(lines)
446 < 2 +
447 < 2 +
448 < 2 +def parse_csv(text):
449 < 2 +    """Inverse of to_csv: parses a CSV string into a list of dicts of
450 < 2 +    header -> cell string (values are never re-typed). Handles quoted
451 < 2 +    cells (with doubled inner quotes and embedded newlines). Raises
452 < 2 +    ValueError on an unterminated quote."""
453 < 2 +    if text == "":
454 < 2 +        return []
455 < 2 +
456 < 2 +    rows = _parse_csv_rows(text)
457 < 2 +    if not rows:
458 < 2 +        return []
459 < 2 +    header = rows[0]
460 < 2 +    return [dict(zip(header, row)) for row in rows[1:]]
461 < 2 +
462 < 2 +
463 < 2 +def _parse_csv_rows(text):
464 < 2 +    """Split `text` into rows of raw field strings, honoring quoted cells
465 < 2 +    (doubled quotes, embedded commas/newlines). Every unquoted newline
466 < 2 +    ends a row and starts a new one — including a trailing newline,
467 < 2 +    which yields a final empty row (the caller special-cases "" so this
468 < 2 +    is never invoked on an empty string)."""
469 < 2 +    rows = []
470 < 2 +    row = []
471 < 2 +    field = []
472 < 2 +    i = 0
473 < 2 +    n = len(text)
474 < 2 +    in_quotes = False
475 < 2 +
476 < 2 +    while i < n:
477 < 2 +        ch = text[i]
478 < 2 +        if in_quotes:
479 < 2 +            if ch == '"':
480 < 2 +                if i + 1 < n and text[i + 1] == '"':
481 < 2 +                    field.append('"')
482 < 2 +                    i += 2
483 < 2 +                    continue
484 < 2 +                in_quotes = False
485 < 2 +                i += 1
486 < 2 +                continue
487 < 2 +            field.append(ch)
488 < 2 +            i += 1
489 < 2 +            continue
490 < 2 +
491 < 2 +        if ch == '"' and not field:
492 < 2 +            in_quotes = True
493 < 2 +            i += 1
494 < 2 +            continue
495 < 2 +        if ch == ",":
496 < 2 +            row.append("".join(field))
497 < 2 +            field = []
498 < 2 +            i += 1
499 < 2 +            continue
500 < 2 +        if ch == "\n":
501 < 2 +            row.append("".join(field))
502 < 2 +            rows.append(row)
503 < 2 +            row = []
504 < 2 +            field = []
505 < 2 +            i += 1
506 < 2 +            continue
507 < 2 +        field.append(ch)
508 < 2 +        i += 1
509 < 2 +
510 < 2 +    if in_quotes:
511 < 2 +        raise ValueError("unterminated quote in CSV")
512 < 2 +
513 < 2 +    row.append("".join(field))
514 < 2 +    rows.append(row)
515 < 2 +
516 < 2 +    return rows
517 < 2 +
518 < 2 +
519 < 2 +FORMATS = {
520 < 2 +    "csv": to_csv,
521 < 2 +    "json": to_json,
522 < 2 +    "md": to_markdown,
523 < 2 +    "ndjson": to_ndjson,
524 < 2 +    "tsv": to_tsv,
525 < 2 +}
526 < 2 +
527 < 2 +EXTRA_FORMATS = {
528 < 2 +    "html": to_html,
529 < 2 +}
530 < 2 +
531 < 2 +
532 < 2 +def render(records, fmt):
533 < 2 +    """Delegate to the matching FORMATS function. Raises ValueError
534 < 2 +    naming an unknown fmt."""
535 < 2 +    if fmt not in FORMATS:
536 < 2 +        raise ValueError("unknown export format: %s" % fmt)
537 < 2 +    return FORMATS[fmt](records)
538 < 2 +
539 < 2 +
540 < 2 +def render_any(records, fmt):
541 < 2 +    """Serve FORMATS first, then EXTRA_FORMATS. Raises ValueError naming
542 < 2 +    an unknown fmt."""
543 < 2 +    if fmt in FORMATS:
544 < 2 +        return FORMATS[fmt](records)
545 < 2 +    if fmt in EXTRA_FORMATS:
546 < 2 +        return EXTRA_FORMATS[fmt](records)
547 < 2 +    raise ValueError("unknown export format: %s" % fmt)
548 < 2 +
549 < 2 +
550 < 2 +def summary_line(records):
551 < 2 +    """"<N> records, <M> columns" summary."""
552 < 2 +    return "%d records, %d columns" % (
553 < 2 +        len(records), len(tabular.columns(records))
554 < 2 +    )
