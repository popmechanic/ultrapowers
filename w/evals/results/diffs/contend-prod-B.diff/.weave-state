1792 < 2 +def test_last_n():
1793 < 2 +    entries = [
1794 < 2 +        {"method": "GET", "path": "/a", "actor": "alice"},
1795 < 2 +        {"method": "GET", "path": "/b", "actor": "bob"},
1796 < 2 +        {"method": "GET", "path": "/c", "actor": "carol"},
1797 < 2 +    ]
1798 < 2 +    snapshot = copy.deepcopy(entries)
1799 < 2 +
1800 < 2 +    assert aq.last_n(entries, 2) == [entries[1], entries[2]]
1801 < 2 +    assert_unmutated(entries, snapshot)
1802 < 2 +
1803 < 2 +    assert aq.last_n(entries, 0) == []
1804 < 2 +    assert_unmutated(entries, snapshot)
1805 < 2 +
1806 < 2 +    result = aq.last_n(entries, 100)
1807 < 2 +    assert result == entries
1808 < 2 +    result.append({"method": "X", "path": "Y", "actor": "Z"})
1809 < 2 +    assert_unmutated(entries, snapshot)
1810 < 2 +
1811 < 2 +    with pytest.raises(ValueError):
