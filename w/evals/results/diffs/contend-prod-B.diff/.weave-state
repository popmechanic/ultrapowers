4 < 2 +++ b/app/audit.py
5 < 2 @@ -0,0 +1,76 @@
6 < 2 +"""Module-global audit log of every dispatched call.
7 < 2 +
8 < 2 +`dispatch_hook` is registered into `registry.DISPATCH_HOOKS` and fires on
9 < 2 +EVERY call the app dispatches (unlike rate limiting, it does not
10 < 2 +special-case the method). It always logs — `DEFAULT_CONFIG` carries an
11 < 2 +`audit_log_enabled` key reserved for a future on/off switch, but no code
12 < 2 +in this plan reads it.
13 < 2 +
14 < 2 +The log is a module-global list capped at `max_entries` (read from
15 < 2 +`config["audit_log_max_entries"]` by `dispatch_hook`); once full, the
16 < 2 +oldest entry is dropped for each new one appended. `dropped()` tracks how
17 < 2 +many entries have been evicted since the last `clear()`.
18 < 2 +"""
19 < 2 +
20 < 2 +_log = []
21 < 2 +_dropped = 0
22 < 2 +
23 < 2 +
24 < 2 +def clear():
25 < 2 +    """Reset the log and the dropped counter."""
26 < 2 +    global _log, _dropped
27 < 2 +    _log = []
28 < 2 +    _dropped = 0
29 < 2 +
30 < 2 +
31 < 2 +def entries():
32 < 2 +    """Return a copy of the log, oldest first — a deep-enough copy that
33 < 2 +    mutating a returned entry does not affect the live log."""
34 < 2 +    return [dict(e) for e in _log]
35 < 2 +
36 < 2 +
37 < 2 +def dropped():
38 < 2 +    """Return the number of entries evicted by the cap since the last
39 < 2 +    clear()."""
40 < 2 +    return _dropped
41 < 2 +
42 < 2 +
43 < 2 +def record(method, path, actor, max_entries):
44 < 2 +    """Append one entry, then enforce the cap (drop-oldest) immediately."""
45 < 2 +    global _dropped
46 < 2 +    _log.append({"method": method, "path": path, "actor": actor})
47 < 2 +    while len(_log) > max_entries:
48 < 2 +        _log.pop(0)
49 < 2 +        _dropped += 1
50 < 2 +
51 < 2 +
52 < 2 +def record_many(triples, max_entries):
53 < 2 +    """Append each (method, path, actor) triple in order, enforcing the
54 < 2 +    cap after every append. Returns the number appended (always
55 < 2 +    len(triples))."""
56 < 2 +    for method, path, actor in triples:
57 < 2 +        record(method, path, actor, max_entries)
58 < 2 +    return len(triples)
59 < 2 +
60 < 2 +
61 < 2 +def export_state():
62 < 2 +    """Return {"entries": entries(), "dropped": dropped()} — a copy safe
63 < 2 +    to mutate without affecting the live log."""
64 < 2 +    return {"entries": entries(), "dropped": dropped()}
65 < 2 +
66 < 2 +
67 < 2 +def import_state(state):
68 < 2 +    """Replace the log and the dropped counter from an export_state()
69 < 2 +    -shaped dict. Copies its input; later mutation of `state` does not
70 < 2 +    leak into the live log."""
71 < 2 +    global _log, _dropped
72 < 2 +    _log = [dict(e) for e in state["entries"]]
73 < 2 +    _dropped = state["dropped"]
74 < 2 +
75 < 2 +
76 < 2 +def dispatch_hook(store, config, method, path, kwargs):
77 < 2 +    """DISPATCH_HOOKS callable: log every call. Actor defaults to
78 < 2 +    "anonymous" when kwargs has no "actor" key; only method/path/actor are
79 < 2 +    retained, never the other call kwargs."""
80 < 2 +    actor = kwargs.get("actor", "anonymous")
81 < 2 +    record(method, path, actor, config["audit_log_max_entries"])
