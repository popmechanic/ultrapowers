1683 < 2 +def test_import_state_round_trip_and_no_leak_from_source_dict():
1684 < 2 +    audit.clear()
1685 < 2 +    audit.record("GET", "/a", "alice", 500)
1686 < 2 +    audit.record("GET", "/b", "bob", 500)
1687 < 2 +    for i in range(5):
1688 < 2 +        audit.record("GET", "/p%d" % i, "actor%d" % i, 3)
1689 < 2 +    state = audit.export_state()
1690 < 2 +    expected_entries = audit.entries()
1691 < 2 +    expected_dropped = audit.dropped()
1692 < 2 +
1693 < 2 +    audit.clear()
1694 < 2 +    assert audit.entries() == []
1695 < 2 +    assert audit.dropped() == 0
1696 < 2 +
1697 < 2 +    audit.import_state(state)
1698 < 2 +    assert audit.entries() == expected_entries
1699 < 2 +    assert audit.dropped() == expected_dropped
1700 < 2 +
1701 < 2 +    state["entries"].append({"method": "X", "path": "Y", "actor": "Z"})
1702 < 2 +    state["dropped"] = 999
1703 < 2 +    assert audit.entries() == expected_entries
1704 < 2 +    assert audit.dropped() == expected_dropped
1705 < 2 diff --git a/tests/test_audit_query.py b/tests/test_audit_query.py
1706 < 2 new file mode 100644
