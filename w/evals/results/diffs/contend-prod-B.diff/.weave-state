1630 < 2 +def test_record_many_appends_all_in_order_and_enforces_cap_throughout():
1631 < 2 +    audit.clear()
1632 < 2 +    triples = [
1633 < 2 +        ("GET", "/a", "alice"),
1634 < 2 +        ("GET", "/b", "bob"),
1635 < 2 +        ("GET", "/c", "carol"),
1636 < 2 +        ("GET", "/d", "dave"),
1637 < 2 +    ]
1638 < 2 +
1639 < 2 +    seen_lengths = []
1640 < 2 +    original_record = audit.record
1641 < 2 +
1642 < 2 +    def recording_record(*args, **kwargs):
1643 < 2 +        original_record(*args, **kwargs)
1644 < 2 +        seen_lengths.append(len(audit.entries()))
1645 < 2 +
1646 < 2 +    audit.record = recording_record
1647 < 2 +    try:
1648 < 2 +        count = audit.record_many(triples, max_entries=2)
1649 < 2 +    finally:
1650 < 2 +        audit.record = original_record
1651 < 2 +
1652 < 2 +    assert count == 4
1653 < 2 +    assert all(n <= 2 for n in seen_lengths)
1654 < 2 +    assert audit.entries() == [
1655 < 2 +        {"method": "GET", "path": "/c", "actor": "carol"},
1656 < 2 +        {"method": "GET", "path": "/d", "actor": "dave"},
1657 < 2 +    ]
