996 < 2 +++ b/app/schema.py
997 < 2 @@ -0,0 +1,204 @@
998 < 2 +"""Declarative field-validation toolkit.
999 < 2 +
1000 < 2 +This module owns the shared error vocabulary (``ERROR_CATALOG`` /
1001 < 2 +``format_error``), the low-level predicates (``is_valid_amount``,
1002 < 2 +``is_non_empty_str``, ``check_required``), and a small declarative spec
1003 < 2 +compiler (``compile_spec`` and friends) that other modules build on.
1004 < 2 +Nothing in here knows about records, stores, or hooks; it is pure.
1005 < 2 +"""
1006 < 2 +import math
1007 < 2 +
1008 < 2 +
1009 < 2 +ERROR_CATALOG = {
1010 < 2 +    "missing": "missing field: {field}",
1011 < 2 +    "numeric": "field {field} must be numeric (got {got})",
1012 < 2 +    "non_negative": "field {field} must be non-negative",
1013 < 2 +    "max": "field {field} exceeds max_amount {limit}",
1014 < 2 +    "non_empty": "field {field} must be a non-empty string",
1015 < 2 +    "type_str": "field {field} must be a string",
1016 < 2 +}
1017 < 2 +
1018 < 2 +
1019 < 2 +class SchemaError(Exception):
1020 < 2 +    """Raised by a compiled spec validator when a field fails its rules."""
1021 < 2 +
1022 < 2 +
1023 < 2 +def format_error(code, **kwargs):
1024 < 2 +    """Render the ``ERROR_CATALOG`` template for ``code``. Raises
1025 < 2 +    ``KeyError`` for an unknown code -- there is no silent fallback."""
1026 < 2 +    return ERROR_CATALOG[code].format(**kwargs)
1027 < 2 +
1028 < 2 +
1029 < 2 +def check_required(fields, required_fields):
1030 < 2 +    """Return the subset of ``required_fields`` absent from ``fields``, in
1031 < 2 +    ``required_fields`` order."""
1032 < 2 +    return [f for f in required_fields if f not in fields]
1033 < 2 +
1034 < 2 +
1035 < 2 +def is_valid_amount(value):
1036 < 2 +    """True for a finite, non-bool int/float. Bools are excluded even
1037 < 2 +    though ``isinstance(True, int)`` is True in Python. Ints of any size
1038 < 2 +    are always finite, so only floats are routed through
1039 < 2 +    ``math.isfinite`` (an int too large to convert to float would raise
1040 < 2 +    ``OverflowError`` if it were)."""
1041 < 2 +    if isinstance(value, bool):
1042 < 2 +        return False
1043 < 2 +    if isinstance(value, int):
1044 < 2 +        return True
1045 < 2 +    if isinstance(value, float):
1046 < 2 +        return math.isfinite(value)
1047 < 2 +    return False
1048 < 2 +
1049 < 2 +
1050 < 2 +def is_non_empty_str(value):
1051 < 2 +    """True for a string with at least one non-whitespace character."""
1052 < 2 +    return isinstance(value, str) and value.strip() != ""
1053 < 2 +
1054 < 2 +
1055 < 2 +_ALLOWED_RULE_KEYS = {"required", "type", "non_empty", "max"}
1056 < 2 +_ALLOWED_TYPES = {"str", "number"}
1057 < 2 +
1058 < 2 +
1059 < 2 +def _first_rule_failure(field, value, rules):
1060 < 2 +    """Check ``rules`` for ``field``/``value`` in the fixed order
1061 < 2 +    type -> non_empty -> max, returning the first failure message, or
1062 < 2 +    None if every applicable rule passes."""
1063 < 2 +    if "type" in rules:
1064 < 2 +        kind = rules["type"]
1065 < 2 +        if kind == "number":
1066 < 2 +            if not is_valid_amount(value):
1067 < 2 +                return format_error("numeric", field=field, got=type(value).__name__)
1068 < 2 +        elif kind == "str":
1069 < 2 +            if not isinstance(value, str):
1070 < 2 +                return format_error("type_str", field=field)
1071 < 2 +    if rules.get("non_empty"):
1072 < 2 +        if not is_non_empty_str(value):
1073 < 2 +            return format_error("non_empty", field=field)
1074 < 2 +    if "max" in rules:
1075 < 2 +        limit = rules["max"]
1076 < 2 +        if not is_valid_amount(value):
1077 < 2 +            return format_error("numeric", field=field, got=type(value).__name__)
1078 < 2 +        if value > limit:
1079 < 2 +            return format_error("max", field=field, limit=limit)
1080 < 2 +    return None
1081 < 2 +
1082 < 2 +
1083 < 2 +def compile_spec(spec):
1084 < 2 +    """Compile a declarative field spec into a reusable validator
1085 < 2 +    callable. Raises ValueError at compile time for an unknown rule key
