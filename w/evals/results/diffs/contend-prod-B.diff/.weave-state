2412 < 2 --- /dev/null
2413 < 2 +++ b/tests/test_quota.py
2414 < 2 @@ -0,0 +1,214 @@
2415 < 2 +"""Tests for app/quota.py — the windowed counter app/ratelimit.py delegates to."""
2416 < 2 +import pytest
2417 < 2 +
2418 < 2 +from app import quota
2419 < 2 +from app.quota import QuotaExceededError
2420 < 2 +
2421 < 2 +
2422 < 2 +@pytest.fixture(autouse=True)
2423 < 2 +def _reset():
2424 < 2 +    quota.reset()
2425 < 2 +
2426 < 2 +
2427 < 2 +def test_quota_exceeded_error_is_exception_subclass():
2428 < 2 +    assert issubclass(QuotaExceededError, Exception)
2429 < 2 +
2430 < 2 +
2431 < 2 +def test_now_and_advance_are_a_monotonic_logical_clock():
2432 < 2 +    assert quota.now() == 0.0
2433 < 2 +    assert quota.advance(30) == 30.0
2434 < 2 +    assert quota.now() == 30.0
2435 < 2 +    with pytest.raises(ValueError):
2436 < 2 +        quota.advance(-1)
2437 < 2 +    assert quota.now() == 30.0
2438 < 2 +
2439 < 2 +
2440 < 2 +def test_take_counts_hits_then_raises_with_key_and_limit_in_message():
2441 < 2 +    assert quota.take("k", limit=2, window_seconds=60) == 1
2442 < 2 +    assert quota.take("k", limit=2, window_seconds=60) == 2
2443 < 2 +    with pytest.raises(QuotaExceededError) as exc_info:
2444 < 2 +        quota.take("k", limit=2, window_seconds=60)
2445 < 2 +    msg = str(exc_info.value)
2446 < 2 +    assert "k" in msg
2447 < 2 +    assert "2" in msg
2448 < 2 +
2449 < 2 +
2450 < 2 +def test_window_pruning_ages_out_old_hits():
2451 < 2 +    quota.take("k", 2, 60)
2452 < 2 +    quota.take("k", 2, 60)
2453 < 2 +    quota.advance(61)
2454 < 2 +    assert quota.take("k", 2, 60) == 1
2455 < 2 +
2456 < 2 +    quota.reset()
2457 < 2 +    quota.take("k", 2, 60)  # t=0
2458 < 2 +    quota.advance(30)
2459 < 2 +    quota.take("k", 2, 60)  # t=30, count=2
2460 < 2 +    quota.advance(31)  # now=61: t=0 hit aged out (>60 old), t=30 hit still in window (31 old)
2461 < 2 +    assert quota.take("k", 2, 60) == 2
2462 < 2 +    quota.advance(30)  # now=91: t=30 hit now aged out (61 old), t=61 hit still in window (30 old)
2463 < 2 +    assert quota.take("k", 2, 60) == 2
2464 < 2 +
2465 < 2 +
2466 < 2 +def test_infinite_window_never_prunes():
2467 < 2 +    quota.take("k", limit=1, window_seconds=float("inf"))
2468 < 2 +    with pytest.raises(QuotaExceededError):
2469 < 2 +        quota.take("k", limit=1, window_seconds=float("inf"))
2470 < 2 +    quota.advance(10**6)
2471 < 2 +    with pytest.raises(QuotaExceededError):
2472 < 2 +        quota.take("k", limit=1, window_seconds=float("inf"))
2473 < 2 +
2474 < 2 +
2475 < 2 +def test_burst_allowance():
2476 < 2 +    quota.take("k", limit=2, window_seconds=60, burst=1)
2477 < 2 +    quota.take("k", limit=2, window_seconds=60, burst=1)
2478 < 2 +    quota.take("k", limit=2, window_seconds=60, burst=1)
2479 < 2 +    with pytest.raises(QuotaExceededError):
2480 < 2 +        quota.take("k", limit=2, window_seconds=60, burst=1)
2481 < 2 +
2482 < 2 +
2483 < 2 +def test_burst_defaults_to_zero():
2484 < 2 +    quota.take("k", limit=1, window_seconds=60)
2485 < 2 +    with pytest.raises(QuotaExceededError):
2486 < 2 +        quota.take("k", limit=1, window_seconds=60)
2487 < 2 +
2488 < 2 +
2489 < 2 +def test_per_key_independence():
2490 < 2 +    quota.take("a", limit=2, window_seconds=60)
2491 < 2 +    quota.take("b", limit=2, window_seconds=60)
2492 < 2 +    quota.take("a", limit=2, window_seconds=60)
2493 < 2 +    with pytest.raises(QuotaExceededError):
2494 < 2 +        quota.take("a", limit=2, window_seconds=60)
2495 < 2 +    # "b" is untouched — still has one slot left
2496 < 2 +    assert quota.take("b", limit=2, window_seconds=60) == 2
2497 < 2 +    with pytest.raises(QuotaExceededError):
2498 < 2 +        quota.take("b", limit=2, window_seconds=60)
2499 < 2 +
2500 < 2 +
2501 < 2 +def test_reset_clears_clock_and_all_keys():
2502 < 2 +    quota.take("k", limit=1, window_seconds=60)
2503 < 2 +    with pytest.raises(QuotaExceededError):
2504 < 2 +        quota.take("k", limit=1, window_seconds=60)
2505 < 2 +    quota.advance(30)
2506 < 2 +    quota.reset()
2507 < 2 +    assert quota.now() == 0.0
2508 < 2 +    assert quota.take("k", limit=1, window_seconds=60) == 1
2509 < 2 +
2510 < 2 +
2511 < 2 +def test_remaining_is_read_only_and_reports_correctly():
2512 < 2 +    assert quota.remaining("k", limit=2, window_seconds=60) == 2
2513 < 2 +    quota.take("k", limit=2, window_seconds=60)
2514 < 2 +    assert quota.remaining("k", limit=2, window_seconds=60) == 1
2515 < 2 +    assert quota.remaining("k", limit=2, window_seconds=60) == 1
2516 < 2 +    quota.take("k", limit=2, window_seconds=60)
2517 < 2 +    assert quota.remaining("k", limit=2, window_seconds=60) == 0
2518 < 2 +    # floors at 0 -- no negative overshoot possible via take, but the read is 0
2519 < 2 +    with pytest.raises(QuotaExceededError):
2520 < 2 +        quota.take("k", limit=2, window_seconds=60)
2521 < 2 +    assert quota.remaining("k", limit=2, window_seconds=60) == 0
2522 < 2 +    # a subsequent take still behaves as before (still exhausted)
2523 < 2 +    with pytest.raises(QuotaExceededError):
2524 < 2 +        quota.take("k", limit=2, window_seconds=60)
2525 < 2 +    # after advancing past the window, recovers to full allowance
2526 < 2 +    quota.advance(61)
2527 < 2 +    assert quota.remaining("k", limit=2, window_seconds=60) == 2
2528 < 2 +
2529 < 2 +
2530 < 2 +def test_remaining_includes_burst_in_full_allowance():
2531 < 2 +    assert quota.remaining("k", limit=2, window_seconds=60, burst=1) == 3
2532 < 2 +    quota.take("k", limit=2, window_seconds=60, burst=1)
2533 < 2 +    assert quota.remaining("k", limit=2, window_seconds=60, burst=1) == 2
2534 < 2 +
2535 < 2 +
2536 < 2 +def test_snapshot_returns_deep_copy_dict_of_in_window_hits():
2537 < 2 +    quota.take("k1", limit=5, window_seconds=60)  # t=0
2538 < 2 +    quota.advance(10)
2539 < 2 +    quota.take("k1", limit=5, window_seconds=60)  # t=10
2540 < 2 +    quota.take("k2", limit=5, window_seconds=60)  # t=10
2541 < 2 +    quota.advance(60)  # now=70; k1's t=0 hit ages out (70-0=70 > 60), t=10 hit stays (60 not > 60)
2542 < 2 +    snap = quota.snapshot(60)
2543 < 2 +    assert snap == {"k1": [10.0], "k2": [10.0]}
2544 < 2 +
2545 < 2 +    snap["k1"].append(999)
2546 < 2 +    later_snap = quota.snapshot(60)
2547 < 2 +    assert later_snap == {"k1": [10.0], "k2": [10.0]}
2548 < 2 +    assert quota.remaining("k1", limit=5, window_seconds=60) == 4
2549 < 2 +
2550 < 2 +
2551 < 2 +def test_snapshot_omits_keys_with_no_in_window_hits():
2552 < 2 +    quota.take("k", limit=5, window_seconds=60)  # t=0
2553 < 2 +    quota.advance(61)
2554 < 2 +    assert quota.snapshot(60) == {}
2555 < 2 +
2556 < 2 +
2557 < 2 +def test_time_to_next_slot_zero_when_remaining_positive():
