1208 < 2 +"""Column-model toolkit shared by every export format.
1209 < 2 +
1210 < 2 +`app.export` builds each serializer on top of these primitives so the
1211 < 2 +column union, cell rendering, and escaping logic exist in exactly one
1212 < 2 +place: here.
1213 < 2 +"""
1214 < 2 +
1215 < 2 +
1216 < 2 +def columns(records):
1217 < 2 +    """Sorted union of every key across all records."""
1218 < 2 +    keys = set()
1219 < 2 +    for r in records:
1220 < 2 +        keys.update(r.keys())
1221 < 2 +    return sorted(keys)
1222 < 2 +
1223 < 2 +
1224 < 2 +def cell(value):
1225 < 2 +    """Plain str() rendering of a value, except None -> ""."""
1226 < 2 +    if value is None:
1227 < 2 +        return ""
1228 < 2 +    return str(value)
1229 < 2 +
1230 < 2 +
1231 < 2 +def escape_csv(value):
1232 < 2 +    """CSV-escape a single cell: quote the whole cell and double any
1233 < 2 +    inner quotes if the cell contains a comma, quote, or newline."""
1234 < 2 +    text = cell(value)
1235 < 2 +    if any(ch in text for ch in (",", '"', "\n")):
1236 < 2 +        return '"' + text.replace('"', '""') + '"'
1237 < 2 +    return text
1238 < 2 +
1239 < 2 +
1240 < 2 +def widths(records, cols):
1241 < 2 +    """Column name -> max(len(header), max cell width) across records."""
1242 < 2 +    result = {}
1243 < 2 +    for col in cols:
1244 < 2 +        widest = len(col)
1245 < 2 +        for r in records:
1246 < 2 +            widest = max(widest, len(cell(r.get(col))))
1247 < 2 +        result[col] = widest
1248 < 2 +    return result
1249 < 2 +
1250 < 2 +
1251 < 2 +def pad(value, width, align):
1252 < 2 +    """Pad `value` to `width` per `align` ("left" or "right"). A value
1253 < 2 +    already at or beyond width is returned unchanged. Any other align
1254 < 2 +    raises ValueError, validated before any short-circuit."""
1255 < 2 +    if align not in ("left", "right"):
1256 < 2 +        raise ValueError("invalid align: %s" % align)
1257 < 2 +    if len(value) >= width:
1258 < 2 +        return value
1259 < 2 +    padding = " " * (width - len(value))
1260 < 2 +    if align == "left":
1261 < 2 +        return value + padding
1262 < 2 +    return padding + value
1263 < 2 +
1264 < 2 +
1265 < 2 +def sanitize_flat(value):
1266 < 2 +    """cell(value) rendering with every tab/newline replaced by a space."""
1267 < 2 +    text = cell(value)
1268 < 2 +    return text.replace("\t", " ").replace("\n", " ")
1269 < 2 +
1270 < 2 +
1271 < 2 +def escape_html(value):
1272 < 2 +    """cell(value) rendering with &, <, >, " escaped (& first)."""
1273 < 2 +    text = cell(value)
1274 < 2 +    text = text.replace("&", "&amp;")
1275 < 2 +    text = text.replace("<", "&lt;")
1276 < 2 +    text = text.replace(">", "&gt;")
1277 < 2 +    text = text.replace('"', "&quot;")
1278 < 2 +    return text
1279 < 2 +
1280 < 2 +
1281 < 2 +def truncate(value, width, marker="..."):
1282 < 2 +    """Truncate `value` to `width` chars, appending `marker` if it was
1283 < 2 +    truncated. Raises ValueError if width < len(marker)."""
1284 < 2 +    if width < len(marker):
1285 < 2 +        raise ValueError("width shorter than marker: %s" % width)
1286 < 2 +    if len(value) <= width:
1287 < 2 +        return value
1288 < 2 +    return value[:width - len(marker)] + marker
1289 < 2 +
1290 < 2 +
1291 < 2 +def wrap(value, width):
1292 < 2 +    """Greedily word-wrap `value` on spaces into lines <= width. A single
1293 < 2 +    word longer than width is hard-split at width. wrap("", width)
1294 < 2 +    returns [""]. Raises ValueError if width < 1."""
1295 < 2 +    if width < 1:
1296 < 2 +        raise ValueError("width must be >= 1: %s" % width)
1297 < 2 +    if value == "":
1298 < 2 +        return [""]
1299 < 2 +
1300 < 2 +    def split_long_word(word):
1301 < 2 +        return [word[i:i + width] for i in range(0, len(word), width)]
1302 < 2 +
1303 < 2 +    words = value.split(" ")
1304 < 2 +    lines = []
1305 < 2 +    current = ""
1306 < 2 +    for word in words:
1307 < 2 +        if len(word) > width:
1308 < 2 +            if current:
1309 < 2 +                lines.append(current)
1310 < 2 +                current = ""
1311 < 2 +            lines.extend(split_long_word(word))
1312 < 2 +            continue
1313 < 2 +        if not current:
1314 < 2 +            candidate = word
1315 < 2 +        else:
1316 < 2 +            candidate = current + " " + word
1317 < 2 +        if len(candidate) <= width:
1318 < 2 +            current = candidate
1319 < 2 +        else:
1320 < 2 +            lines.append(current)
1321 < 2 +            current = word
1322 < 2 +    if current or not lines:
1323 < 2 +        lines.append(current)
1324 < 2 +    return lines
1325 < 2 +
1326 < 2 +
1327 < 2 +def fit(value, width, align):
1328 < 2 +    """Compose truncate then pad: an over-long value is truncated to
1329 < 2 +    width (marker included), a short one padded per align."""
1330 < 2 +    return pad(truncate(value, width), width, align)
1331 < 2 +
1332 < 2 +
1333 < 2 +def render_row(cells, widths_list, align):
1334 < 2 +    """Render one pipe-table row: "| " + " | ".join(padded cells) + " |".
1335 < 2 +    Raises ValueError if len(cells) != len(widths_list)."""
1336 < 2 +    if len(cells) != len(widths_list):
1337 < 2 +        raise ValueError(
1338 < 2 +            "cells/widths length mismatch: %d != %d"
1339 < 2 +            % (len(cells), len(widths_list))
1340 < 2 +        )
1341 < 2 +    padded = [pad(c, w, align) for c, w in zip(cells, widths_list)]
1342 < 2 +    return "| " + " | ".join(padded) + " |"
