1815 < 2 +def test_redact():
1816 < 2 +    entries = make_entries_4()
1817 < 2 +    snapshot = copy.deepcopy(entries)
1818 < 2 +
1819 < 2 +    redacted = aq.redact(entries, ["actor"])
1820 < 2 +    assert redacted == [
1821 < 2 +        {"method": "GET", "path": "/records", "actor": "***"},
1822 < 2 +        {"method": "POST", "path": "/records", "actor": "***"},
1823 < 2 +        {"method": "GET", "path": "/report", "actor": "***"},
1824 < 2 +        {"method": "DELETE", "path": "/records/1", "actor": "***"},
1825 < 2 +    ]
1826 < 2 +    assert_unmutated(entries, snapshot)
1827 < 2 +
1828 < 2 +    identity = aq.redact(entries, [])
1829 < 2 +    assert identity == entries
1830 < 2 +    assert identity is not entries
1831 < 2 +    assert all(a is not b for a, b in zip(identity, entries))
1832 < 2 +
1833 < 2 +    with pytest.raises(ValueError):
1834 < 2 +        aq.redact(entries, ["bogus"])
