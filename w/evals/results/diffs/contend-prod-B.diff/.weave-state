561 < 2 +"""Windowed hit counter over a module-global logical clock.
562 < 2 +
563 < 2 +No wall time anywhere: the clock is a plain float (seconds) that only
564 < 2 +moves when a caller calls `advance()`. This keeps tests fully
565 < 2 +deterministic. `app/ratelimit.py` delegates to this module for all actual
566 < 2 +counting; it keeps no counter state of its own.
567 < 2 +"""
568 < 2 +
569 < 2 +
570 < 2 +class QuotaExceededError(Exception):
571 < 2 +    pass
572 < 2 +
573 < 2 +
574 < 2 +_clock = 0.0
575 < 2 +_hits = {}
576 < 2 +
577 < 2 +
578 < 2 +def reset():
579 < 2 +    """Clear the clock back to 0.0 and every key's recorded hits."""
580 < 2 +    global _clock, _hits
581 < 2 +    _clock = 0.0
582 < 2 +    _hits = {}
583 < 2 +
584 < 2 +
585 < 2 +def now():
586 < 2 +    """Return the current logical clock value."""
587 < 2 +    return _clock
588 < 2 +
589 < 2 +
590 < 2 +def advance(delta):
591 < 2 +    """Advance the logical clock by `delta` seconds and return the new
592 < 2 +    value. Raises ValueError (leaving the clock unchanged) if `delta` is
593 < 2 +    negative -- the clock is monotonic."""
594 < 2 +    global _clock
595 < 2 +    if delta < 0:
596 < 2 +        raise ValueError("clock is monotonic: cannot advance by a negative amount")
597 < 2 +    _clock += delta
598 < 2 +    return _clock
599 < 2 +
600 < 2 +
601 < 2 +def _prune(key, window_seconds):
602 < 2 +    """Drop hits for `key` strictly older than now - window_seconds, in
603 < 2 +    place. No-op for an infinite window."""
604 < 2 +    if window_seconds == float("inf"):
605 < 2 +        return
606 < 2 +    cutoff = _clock - window_seconds
607 < 2 +    hits = _hits.get(key)
608 < 2 +    if hits is None:
609 < 2 +        return
610 < 2 +    _hits[key] = [t for t in hits if t >= cutoff]
611 < 2 +
612 < 2 +
613 < 2 +def _in_window_hits(key, window_seconds):
614 < 2 +    _prune(key, window_seconds)
615 < 2 +    return _hits.get(key, [])
616 < 2 +
617 < 2 +
618 < 2 +def take(key, limit, window_seconds, burst=0):
619 < 2 +    """Record a hit for `key` if the in-window count (after recording) does
620 < 2 +    not exceed limit + burst. Returns the in-window hit count after
621 < 2 +    recording. Raises QuotaExceededError (without recording) once the
622 < 2 +    allowance is exhausted."""
623 < 2 +    hits = _in_window_hits(key, window_seconds)
624 < 2 +    if len(hits) >= limit + burst:
625 < 2 +        raise QuotaExceededError(
626 < 2 +            "quota exceeded for %r: limit=%s" % (key, limit)
627 < 2 +        )
628 < 2 +    hits.append(_clock)
629 < 2 +    _hits[key] = hits
630 < 2 +    return len(hits)
631 < 2 +
632 < 2 +
633 < 2 +def remaining(key, limit, window_seconds, burst=0):
634 < 2 +    """Read-only: how many more `take` calls would currently succeed."""
635 < 2 +    hits = _in_window_hits(key, window_seconds)
636 < 2 +    return max(0, limit + burst - len(hits))
637 < 2 +
638 < 2 +
639 < 2 +def snapshot(window_seconds):
640 < 2 +    """Return a dict mapping each key with at least one in-window hit to
641 < 2 +    the sorted list of its in-window hit timestamps. A deep copy: mutating
642 < 2 +    a returned list never affects later readings."""
643 < 2 +    result = {}
644 < 2 +    for key in list(_hits.keys()):
645 < 2 +        hits = _in_window_hits(key, window_seconds)
646 < 2 +        if hits:
647 < 2 +            result[key] = sorted(hits)
648 < 2 +    return result
649 < 2 +
650 < 2 +
651 < 2 +def time_to_next_slot(key, limit, window_seconds, burst=0):
652 < 2 +    """Read-only: seconds until the oldest in-window hit ages out and frees
653 < 2 +    a slot. 0.0 if a slot is available now. float("inf") if the window is
654 < 2 +    infinite (nothing ever ages out) or the allowance is zero (no hit can
655 < 2 +    ever free a slot)."""
656 < 2 +    if remaining(key, limit, window_seconds, burst) > 0:
657 < 2 +        return 0.0
658 < 2 +    if window_seconds == float("inf"):
659 < 2 +        return float("inf")
660 < 2 +    if limit + burst == 0:
661 < 2 +        return float("inf")
662 < 2 +    hits = _in_window_hits(key, window_seconds)
663 < 2 +    if not hits:
664 < 2 +        return float("inf")
665 < 2 +    return min(hits) + window_seconds - _clock
666 < 2 +
667 < 2 +
668 < 2 +def usage(key, limit, window_seconds, burst=0):
669 < 2 +    """Read-only snapshot of a key's current usage against a policy."""
670 < 2 +    hits = _in_window_hits(key, window_seconds)
671 < 2 +    return {
672 < 2 +        "used": len(hits),
673 < 2 +        "allowed": limit + burst,
674 < 2 +        "remaining": remaining(key, limit, window_seconds, burst),
675 < 2 +        "reset_in": time_to_next_slot(key, limit, window_seconds, burst),
676 < 2 +    }
677 < 2 +
678 < 2 +
679 < 2 +def purge(window_seconds):
680 < 2 +    """Drop every key's aged-out hits, removing keys left with none.
681 < 2 +    Returns the total number of hits dropped."""
682 < 2 +    dropped = 0
683 < 2 +    for key in list(_hits.keys()):
684 < 2 +        before = len(_hits.get(key, []))
685 < 2 +        _prune(key, window_seconds)
686 < 2 +        after = len(_hits.get(key, []))
687 < 2 +        dropped += before - after
688 < 2 +        if not _hits.get(key):
689 < 2 +            _hits.pop(key, None)
690 < 2 +    return dropped
