3650 < 2 +def test_policies_constant_is_pinned_exactly():
3651 < 2 +    assert POLICIES == {
3652 < 2 +        "POST /records": {"limit": 5, "window": 60, "burst": 0},
3653 < 2 +        "GET /export": {"limit": 10, "window": 60, "burst": 2},
3654 < 2 +    }
3655 < 2 +
