1349 < 2 +"""A pure policy layer over app/quota.py.
1350 < 2 +
1351 < 2 +This is a library for future routes: it is not wired into the registry.
1352 < 2 +It imports app.quota only -- never app.ratelimit -- and keeps no module
1353 < 2 +state of its own beyond the POLICIES constant.
1354 < 2 +"""
1355 < 2 +from app import quota
1356 < 2 +from app.quota import QuotaExceededError
1357 < 2 +
1358 < 2 +
1359 < 2 +class PolicyError(Exception):
1360 < 2 +    pass
1361 < 2 +
1362 < 2 +
1363 < 2 +POLICIES = {
1364 < 2 +    "POST /records": {"limit": 5, "window": 60, "burst": 0},
1365 < 2 +    "GET /export": {"limit": 10, "window": 60, "burst": 2},
1366 < 2 +}
1367 < 2 +
1368 < 2 +
1369 < 2 +def match_policy(method, path, policies):
1370 < 2 +    """Return the policy dict whose key is "<method> <path-prefix>" where
1371 < 2 +    path-prefix is a prefix of `path`, choosing the longest matching
1372 < 2 +    prefix. None if nothing matches."""
1373 < 2 +    best_key = None
1374 < 2 +    best_policy = None
1375 < 2 +    for key, policy in policies.items():
1376 < 2 +        policy_method, _, prefix = key.partition(" ")
1377 < 2 +        if policy_method != method:
1378 < 2 +            continue
1379 < 2 +        if not path.startswith(prefix):
1380 < 2 +            continue
1381 < 2 +        if best_key is None or len(prefix) > len(best_key):
1382 < 2 +            best_key = prefix
1383 < 2 +            best_policy = policy
1384 < 2 +    return best_policy
1385 < 2 +
1386 < 2 +
1387 < 2 +def key_for(method, path, actor):
1388 < 2 +    return "%s %s:%s" % (method, path, actor)
1389 < 2 +
1390 < 2 +
1391 < 2 +def enforce(method, path, actor, policies):
1392 < 2 +    """No matching policy: return None, record nothing. A match: delegate
1393 < 2 +    to quota.take under the policy's params, returning the in-window
1394 < 2 +    count. Raises PolicyError (chained from QuotaExceededError) once the
1395 < 2 +    policy's allowance is exhausted."""
1396 < 2 +    policy = match_policy(method, path, policies)
1397 < 2 +    if policy is None:
1398 < 2 +        return None
1399 < 2 +    key = key_for(method, path, actor)
1400 < 2 +    try:
1401 < 2 +        return quota.take(key, policy["limit"], policy["window"], burst=policy["burst"])
1402 < 2 +    except QuotaExceededError as exc:
1403 < 2 +        raise PolicyError(
1404 < 2 +            "policy exhausted for %r: limit=%s" % (key, policy["limit"])
1405 < 2 +        ) from exc
1406 < 2 +
1407 < 2 +
1408 < 2 +def remaining_for(method, path, actor, policies):
1409 < 2 +    """None when no policy matches, else quota.remaining under the
1410 < 2 +    policy's params. Read-only."""
1411 < 2 +    policy = match_policy(method, path, policies)
1412 < 2 +    if policy is None:
1413 < 2 +        return None
1414 < 2 +    key = key_for(method, path, actor)
1415 < 2 +    return quota.remaining(key, policy["limit"], policy["window"], burst=policy["burst"])
1416 < 2 +
1417 < 2 +
1418 < 2 +def describe_policies(policies):
1419 < 2 +    """Render an exact multi-line string: one line per key, sorted."""
1420 < 2 +    if not policies:
1421 < 2 +        return "(no policies)"
1422 < 2 +    lines = []
1423 < 2 +    for key in sorted(policies):
1424 < 2 +        policy = policies[key]
1425 < 2 +        lines.append(
1426 < 2 +            "%s: limit=%s, window=%s, burst=%s"
1427 < 2 +            % (key, policy["limit"], policy["window"], policy["burst"])
1428 < 2 +        )
1429 < 2 +    return "\n".join(lines)
