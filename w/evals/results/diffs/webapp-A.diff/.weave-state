120 < 2 +export function renderPage() {
121 < 2 +  return `<!doctype html>
122 < 2 +<html lang="en">
123 < 2 +<head>
124 < 2 +<meta charset="utf-8">
125 < 2 +<title>linkboard</title>
126 < 2 +</head>
127 < 2 +<body>
128 < 2 +<h1>linkboard</h1>
129 < 2 +<ul id="links"></ul>
130 < 2 +<script>
131 < 2 +fetch('/links')
132 < 2 +  .then((res) => res.json())
133 < 2 +  .then((links) => {
134 < 2 +    const list = document.getElementById('links');
135 < 2 +    for (const link of links) {
136 < 2 +      const li = document.createElement('li');
137 < 2 +      const a = document.createElement('a');
138 < 2 +      a.href = link.url;
139 < 2 +      a.textContent = link.title;
140 < 2 +      li.appendChild(a);
141 < 2 +      list.appendChild(li);
142 < 2 +    }
143 < 2 +  });
144 < 2 +</script>
145 < 2 +</body>
146 < 2 +</html>
147 < 2 +`;
148 < 2 +}
149 < 2 diff --git a/src/store.js b/src/store.js
150 < 2 new file mode 100644
151 < 2 index 0000000..b71ed7a
152 < 2 --- /dev/null
153 < 2 +++ b/src/store.js
154 < 2 @@ -0,0 +1,28 @@
155 < 2 +import { randomUUID } from 'node:crypto';
156 < 2 +
157 < 2 +export function createStore() {
158 < 2 +  const links = [];
159 < 2 +  const byId = new Map();
160 < 2 +
161 < 2 +  function add({ url, title }) {
162 < 2 +    const link = {
163 < 2 +      id: randomUUID(),
164 < 2 +      url,
165 < 2 +      title,
166 < 2 +      createdAt: new Date().toISOString(),
167 < 2 +    };
168 < 2 +    links.push(link);
169 < 2 +    byId.set(link.id, link);
170 < 2 +    return link;
171 < 2 +  }
172 < 2 +
173 < 2 +  function list() {
174 < 2 +    return links.slice();
175 < 2 +  }
176 < 2 +
177 < 2 +  function get(id) {
178 < 2 +    return byId.get(id);
179 < 2 +  }
180 < 2 +
181 < 2 +  return { add, list, get };
182 < 2 +}
183 < 2 diff --git a/src/validate.js b/src/validate.js
184 < 2 new file mode 100644
185 < 2 index 0000000..bc981ee
186 < 2 --- /dev/null
187 < 2 +++ b/src/validate.js
188 < 2 @@ -0,0 +1,35 @@
189 < 2 +function isValidScheme(url) {
190 < 2 +  return url.protocol === 'http:' || url.protocol === 'https:';
191 < 2 +}
192 < 2 +
193 < 2 +export function validateLink(input) {
194 < 2 +  if (typeof input !== 'object' || input === null || Array.isArray(input)) {
195 < 2 +    return { ok: false, error: 'input must be an object' };
196 < 2 +  }
197 < 2 +
198 < 2 +  const { url, title } = input;
199 < 2 +
200 < 2 +  if (typeof url !== 'string' || url.trim() === '') {
201 < 2 +    return { ok: false, error: 'url must be a non-empty string' };
202 < 2 +  }
203 < 2 +
204 < 2 +  if (typeof title !== 'string' || title.trim() === '') {
205 < 2 +    return { ok: false, error: 'title must be a non-empty string' };
206 < 2 +  }
207 < 2 +
208 < 2 +  const trimmedUrl = url.trim();
209 < 2 +  const trimmedTitle = title.trim();
210 < 2 +
211 < 2 +  let parsedUrl;
212 < 2 +  try {
213 < 2 +    parsedUrl = new URL(trimmedUrl);
214 < 2 +  } catch {
215 < 2 +    return { ok: false, error: 'url must be a valid URL' };
216 < 2 +  }
217 < 2 +
218 < 2 +  if (!isValidScheme(parsedUrl)) {
219 < 2 +    return { ok: false, error: 'url must use http or https' };
220 < 2 +  }
221 < 2 +
222 < 2 +  return { ok: true, value: { url: trimmedUrl, title: trimmedTitle } };
223 < 2 +}
224 < 2 diff --git a/tests/api.test.js b/tests/api.test.js
