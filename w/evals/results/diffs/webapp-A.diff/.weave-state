283 < 2 +  assert.ok(created.id);
284 < 2 +  assert.ok(created.createdAt);
285 < 2 +
286 < 2 +  const listRes = await request(server, { method: 'GET', path: '/links' });
287 < 2 +  assert.equal(listRes.status, 200);
288 < 2 +  const links = JSON.parse(listRes.body);
289 < 2 +  assert.equal(links.length, 1);
290 < 2 +  assert.deepEqual(links[0], created);
291 < 2 +});
