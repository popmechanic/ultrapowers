229 < 2 @@ -0,0 +1,89 @@
230 < 2 +import { test } from 'node:test';
231 < 2 +import assert from 'node:assert/strict';
232 < 2 +import http from 'node:http';
233 < 2 +import { createServer } from '../src/api.js';
234 < 2 +
235 < 2 +function request(server, { method = 'GET', path = '/', body } = {}) {
236 < 2 +  return new Promise((resolve, reject) => {
237 < 2 +    const { port } = server.address();
238 < 2 +    const payload = body === undefined ? undefined : (typeof body === 'string' ? body : JSON.stringify(body));
239 < 2 +    const req = http.request(
240 < 2 +      { host: '127.0.0.1', port, method, path, headers: payload ? { 'content-type': 'application/json' } : {} },
241 < 2 +      (res) => {
242 < 2 +        let data = '';
243 < 2 +        res.on('data', (chunk) => { data += chunk; });
244 < 2 +        res.on('end', () => {
245 < 2 +          resolve({ status: res.statusCode, headers: res.headers, body: data });
246 < 2 +        });
247 < 2 +      }
248 < 2 +    );
249 < 2 +    req.on('error', reject);
250 < 2 +    if (payload) req.write(payload);
251 < 2 +    req.end();
252 < 2 +  });
253 < 2 +}
254 < 2 +
255 < 2 +async function startServer(t) {
256 < 2 +  const server = createServer();
257 < 2 +  server.listen(0);
258 < 2 +  t.after(() => server.close());
259 < 2 +  await new Promise((resolve) => server.once('listening', resolve));
260 < 2 +  return server;
261 < 2 +}
262 < 2 +
