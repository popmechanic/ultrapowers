264 < 2 +  const server = await startServer(t);
265 < 2 +
266 < 2 +  const res = await request(server, { method: 'GET', path: '/links' });
267 < 2 +  assert.equal(res.status, 200);
268 < 2 +  assert.deepEqual(JSON.parse(res.body), []);
269 < 2 +});
