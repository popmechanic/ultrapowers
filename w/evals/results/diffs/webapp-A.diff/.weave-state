15 < 2 +++ b/src/api.js
16 < 2 @@ -0,0 +1,40 @@
17 < 2 +import { createStore } from './store.js';
18 < 2 +import { createApp } from './app.js';
19 < 2 +import { validateLink } from './validate.js';
20 < 2 +import { renderPage } from './page.js';
21 < 2 +
22 < 2 +function sendJson(res, status, payload) {
23 < 2 +  const body = JSON.stringify(payload);
24 < 2 +  res.writeHead(status, { 'content-type': 'application/json' });
25 < 2 +  res.end(body);
26 < 2 +}
27 < 2 +
28 < 2 +/**
29 < 2 + * Create the linkboard HTTP server, wiring the store, validation, and
30 < 2 + * routing modules together.
31 < 2 + *
32 < 2 + * @returns {import('node:http').Server}
33 < 2 + */
34 < 2 +export function createServer() {
35 < 2 +  const store = createStore();
36 < 2 +
37 < 2 +  return createApp({
38 < 2 +    'GET /links': (req, res) => {
39 < 2 +      sendJson(res, 200, store.list());
40 < 2 +    },
41 < 2 +    'POST /links': (req, res, body) => {
42 < 2 +      const result = validateLink(body);
43 < 2 +      if (!result.ok) {
44 < 2 +        sendJson(res, 422, { error: result.error });
45 < 2 +        return;
46 < 2 +      }
47 < 2 +      const link = store.add(result.value);
48 < 2 +      sendJson(res, 201, link);
49 < 2 +    },
50 < 2 +    'GET /': (req, res) => {
51 < 2 +      const html = renderPage();
52 < 2 +      res.writeHead(200, { 'content-type': 'text/html' });
53 < 2 +      res.end(html);
54 < 2 +    },
55 < 2 +  });
56 < 2 +}
57 < 2 diff --git a/src/app.js b/src/app.js
58 < 2 new file mode 100644
59 < 2 index 0000000..09353a0
60 < 2 --- /dev/null
61 < 2 +++ b/src/app.js
62 < 2 @@ -0,0 +1,51 @@
63 < 2 +import http from 'node:http';
64 < 2 +
65 < 2 +function sendJson(res, status, payload) {
66 < 2 +  const body = JSON.stringify(payload);
67 < 2 +  res.writeHead(status, { 'content-type': 'application/json' });
68 < 2 +  res.end(body);
69 < 2 +}
70 < 2 +
71 < 2 +/**
72 < 2 + * Create an http.Server that routes exact-match "METHOD /path" keys to
73 < 2 + * handlers of the shape (req, res, body) => void.
74 < 2 + *
75 < 2 + * The request body is read and, when present, parsed as JSON before the
76 < 2 + * handler is invoked. Invalid JSON yields a 400 response. Unmatched routes
77 < 2 + * yield a 404 response.
78 < 2 + *
79 < 2 + * @param {Record<string, (req, res, body) => void>} handlers
80 < 2 + * @returns {http.Server}
81 < 2 + */
82 < 2 +export function createApp(handlers) {
83 < 2 +  return http.createServer((req, res) => {
84 < 2 +    const chunks = [];
85 < 2 +    req.on('data', (chunk) => chunks.push(chunk));
86 < 2 +    req.on('end', () => {
87 < 2 +      const raw = Buffer.concat(chunks).toString('utf8');
88 < 2 +      let body;
89 < 2 +      if (raw.length > 0) {
90 < 2 +        try {
91 < 2 +          body = JSON.parse(raw);
92 < 2 +        } catch {
93 < 2 +          sendJson(res, 400, { error: 'invalid json' });
94 < 2 +          return;
95 < 2 +        }
96 < 2 +      }
97 < 2 +
98 < 2 +      const path = (req.url || '/').split('?')[0];
99 < 2 +      const key = `${req.method} ${path}`;
100 < 2 +      const handler = handlers[key];
101 < 2 +
102 < 2 +      if (!handler) {
103 < 2 +        sendJson(res, 404, { error: 'not found' });
104 < 2 +        return;
105 < 2 +      }
106 < 2 +
107 < 2 +      handler(req, res, body);
108 < 2 +    });
109 < 2 +    req.on('error', () => {
110 < 2 +      sendJson(res, 400, { error: 'invalid json' });
111 < 2 +    });
112 < 2 +  });
113 < 2 +}
114 < 2 diff --git a/src/page.js b/src/page.js
