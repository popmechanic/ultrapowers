79 < 2 @@ -0,0 +1,14 @@
80 < 2 +"""User schema: the dataclass and the creation-payload field contract."""
81 < 2 +
82 < 2 +from dataclasses import dataclass
83 < 2 +
84 < 2 +
85 < 2 +@dataclass
86 < 2 +class User:
87 < 2 +    id: int
88 < 2 +    name: str
89 < 2 +    email: str
90 < 2 +
91 < 2 +
92 < 2 +# The creation-payload contract. Insertion order matters: name first.
93 < 2 +FIELDS = {"name": str, "email": str}
94 < 2 diff --git a/apistub/serialize.py b/apistub/serialize.py
95 < 2 new file mode 100644
96 < 2 index 0000000..12abb30
97 < 2 --- /dev/null
98 < 2 +++ b/apistub/serialize.py
99 < 2 @@ -0,0 +1,18 @@
100 < 2 +"""Serialization helpers for apistub schema objects."""
101 < 2 +
102 < 2 +import json
103 < 2 +from collections import OrderedDict
104 < 2 +
105 < 2 +from apistub.schema import User
106 < 2 +
107 < 2 +
108 < 2 +def to_json(user: User) -> str:
109 < 2 +    """Serialize a ``User`` to a JSON string with keys in id, name, email order."""
110 < 2 +    payload = OrderedDict(
111 < 2 +        (
112 < 2 +            ("id", user.id),
113 < 2 +            ("name", user.name),
114 < 2 +            ("email", user.email),
115 < 2 +        )
116 < 2 +    )
117 < 2 +    return json.dumps(payload)
118 < 2 diff --git a/apistub/store.py b/apistub/store.py
119 < 2 new file mode 100644
120 < 2 index 0000000..8fdd7f1
121 < 2 --- /dev/null
122 < 2 +++ b/apistub/store.py
123 < 2 @@ -0,0 +1,28 @@
124 < 2 +"""In-memory storage for User records."""
125 < 2 +
126 < 2 +from typing import Dict, List, Optional
127 < 2 +
128 < 2 +from apistub.schema import User
129 < 2 +
130 < 2 +
131 < 2 +class MemoryStore:
132 < 2 +    """A simple in-memory store for `User` records."""
133 < 2 +
134 < 2 +    def __init__(self) -> None:
135 < 2 +        self._users: Dict[int, User] = {}
136 < 2 +        self._next_id: int = 1
137 < 2 +
138 < 2 +    def add(self, name: str, email: str) -> User:
139 < 2 +        """Create a new `User` with an auto-incrementing id and store it."""
140 < 2 +        user = User(self._next_id, name, email)
141 < 2 +        self._users[user.id] = user
142 < 2 +        self._next_id += 1
143 < 2 +        return user
144 < 2 +
145 < 2 +    def get(self, user_id: int) -> Optional[User]:
146 < 2 +        """Return the `User` with the given id, or `None` if not found."""
147 < 2 +        return self._users.get(user_id)
148 < 2 +
149 < 2 +    def list(self) -> List[User]:
150 < 2 +        """Return all users in insertion order."""
151 < 2 +        return list(self._users.values())
152 < 2 diff --git a/apistub/validate.py b/apistub/validate.py
153 < 2 new file mode 100644
154 < 2 index 0000000..e06ac24
155 < 2 --- /dev/null
156 < 2 +++ b/apistub/validate.py
157 < 2 @@ -0,0 +1,24 @@
158 < 2 +"""Payload validation against the User creation-payload field contract."""
159 < 2 +
160 < 2 +from apistub.schema import FIELDS
161 < 2 +
162 < 2 +
163 < 2 +def validate_payload(payload):
164 < 2 +    """Validate a creation payload against `schema.FIELDS`.
165 < 2 +
166 < 2 +    Returns a list of error strings, empty when the payload is valid.
167 < 2 +    Unknown keys in the payload are ignored.
168 < 2 +    """
169 < 2 +    errors = []
170 < 2 +
171 < 2 +    for key, declared_type in FIELDS.items():
172 < 2 +        if key not in payload:
173 < 2 +            errors.append(f"missing: {key}")
174 < 2 +        elif not isinstance(payload[key], declared_type):
175 < 2 +            errors.append(f"wrong type: {key}")
176 < 2 +
177 < 2 +    email = payload.get("email")
178 < 2 +    if isinstance(email, str) and "@" not in email:
179 < 2 +        errors.append("invalid: email")
180 < 2 +
181 < 2 +    return errors
