0 < 2 diff --git a/apistub/app.py b/apistub/app.py
1 < 2 new file mode 100644
2 < 2 index 0000000..3600ced
3 < 2 --- /dev/null
4 < 2 +++ b/apistub/app.py
5 < 2 @@ -0,0 +1,27 @@
6 < 2 +"""Minimal router dispatching HTTP-shaped requests to handlers."""
7 < 2 +
8 < 2 +import json
9 < 2 +import re
10 < 2 +
11 < 2 +from apistub.handlers import create_user, get_user
12 < 2 +
13 < 2 +_USER_ID_RE = re.compile(r"^/users/(\d+)$")
14 < 2 +
15 < 2 +
16 < 2 +def route(store, method, path, payload=None):
17 < 2 +    """Dispatch `(method, path)` to the matching handler.
18 < 2 +
19 < 2 +    Returns a `(status, body)` tuple:
20 < 2 +    - `("POST", "/users")` -> `create_user(store, payload)`.
21 < 2 +    - `("GET", "/users/<digits>")` -> `get_user(store, int(<digits>))`.
22 < 2 +    - Anything else -> `(404, json.dumps({"errors": ["no route"]}))`.
23 < 2 +    """
24 < 2 +    if method == "POST" and path == "/users":
25 < 2 +        return create_user(store, payload)
26 < 2 +
27 < 2 +    if method == "GET":
28 < 2 +        match = _USER_ID_RE.match(path)
29 < 2 +        if match:
30 < 2 +            return get_user(store, int(match.group(1)))
31 < 2 +
32 < 2 +    return 404, json.dumps({"errors": ["no route"]})
33 < 2 diff --git a/apistub/handlers.py b/apistub/handlers.py
34 < 2 new file mode 100644
35 < 2 index 0000000..be5732f
36 < 2 --- /dev/null
37 < 2 +++ b/apistub/handlers.py
38 < 2 @@ -0,0 +1,35 @@
39 < 2 +"""HTTP-shaped handler functions for the users API, no network."""
40 < 2 +
41 < 2 +import json
42 < 2 +
43 < 2 +from apistub.serialize import to_json
44 < 2 +from apistub.validate import validate_payload
45 < 2 +
46 < 2 +
47 < 2 +def create_user(store, payload):
48 < 2 +    """Validate `payload` and, if valid, add a new user to `store`.
49 < 2 +
50 < 2 +    Returns a `(status, body)` tuple: `(400, ...)` with a JSON list of
51 < 2 +    errors when the payload is invalid, otherwise `(201, ...)` with the
52 < 2 +    newly created user serialized to JSON.
53 < 2 +    """
54 < 2 +    errors = validate_payload(payload)
55 < 2 +    if errors:
56 < 2 +        return 400, json.dumps({"errors": errors})
57 < 2 +
58 < 2 +    user = store.add(payload["name"], payload["email"])
59 < 2 +    return 201, to_json(user)
60 < 2 +
61 < 2 +
62 < 2 +def get_user(store, user_id):
63 < 2 +    """Look up `user_id` in `store`.
64 < 2 +
65 < 2 +    Returns a `(status, body)` tuple: `(200, ...)` with the user
66 < 2 +    serialized to JSON when found, otherwise `(404, ...)` with a JSON
67 < 2 +    error list.
68 < 2 +    """
69 < 2 +    user = store.get(user_id)
70 < 2 +    if user is None:
71 < 2 +        return 404, json.dumps({"errors": ["not found"]})
72 < 2 +
73 < 2 +    return 200, to_json(user)
