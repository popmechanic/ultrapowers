198 < 2 diff --git a/textkit/ngrams.py b/textkit/ngrams.py
199 < 2 new file mode 100644
200 < 2 index 0000000..38b713f
201 < 2 --- /dev/null
202 < 2 +++ b/textkit/ngrams.py
203 < 2 @@ -0,0 +1,8 @@
204 < 2 +def ngrams(tokens, n):
205 < 2 +    """Return a list of tuples of n consecutive tokens.
206 < 2 +
207 < 2 +    Raises ValueError if n < 1. Returns [] when n > len(tokens).
208 < 2 +    """
209 < 2 +    if n < 1:
210 < 2 +        raise ValueError("n must be >= 1")
211 < 2 +    return [tuple(tokens[i:i + n]) for i in range(len(tokens) - n + 1)]
212 < 2 diff --git a/textkit/redact.py b/textkit/redact.py
213 < 2 new file mode 100644
214 < 2 index 0000000..a3aeeda
215 < 2 --- /dev/null
216 < 2 +++ b/textkit/redact.py
217 < 2 @@ -0,0 +1,12 @@
218 < 2 +import re
219 < 2 +
220 < 2 +
221 < 2 +def redact(text, words):
222 < 2 +    """Replace each whole-word, case-insensitive occurrence of any word in
223 < 2 +    `words` with "*" repeated to the match's length."""
224 < 2 +    words = list(words)
225 < 2 +    if not words:
226 < 2 +        return text
227 < 2 +
228 < 2 +    pattern = r"\b(?:" + "|".join(re.escape(word) for word in words) + r")\b"
229 < 2 +    return re.sub(pattern, lambda m: "*" * len(m.group(0)), text, flags=re.IGNORECASE)
230 < 2 diff --git a/textkit/reverse_words.py b/textkit/reverse_words.py
231 < 2 new file mode 100644
232 < 2 index 0000000..60969cc
233 < 2 --- /dev/null
234 < 2 +++ b/textkit/reverse_words.py
235 < 2 @@ -0,0 +1,6 @@
236 < 2 +def reverse_words(text):
237 < 2 +    """Split on whitespace, reverse word order, join with single spaces.
238 < 2 +
239 < 2 +    Empty or whitespace-only input returns "".
240 < 2 +    """
241 < 2 +    return " ".join(reversed(text.split()))
242 < 2 diff --git a/textkit/titlecase.py b/textkit/titlecase.py
243 < 2 new file mode 100644
244 < 2 index 0000000..ba11988
245 < 2 --- /dev/null
246 < 2 +++ b/textkit/titlecase.py
247 < 2 @@ -0,0 +1,18 @@
248 < 2 +MINOR_WORDS = {"a", "an", "and", "as", "at", "but", "by", "for", "in", "of", "on", "or", "the", "to"}
249 < 2 +
250 < 2 +
251 < 2 +def titlecase(text):
252 < 2 +    """Title-case text, lowercasing minor words except at the start or end."""
253 < 2 +    words = text.split()
254 < 2 +    if not words:
255 < 2 +        return ""
256 < 2 +
257 < 2 +    last_index = len(words) - 1
258 < 2 +    result = []
259 < 2 +    for index, word in enumerate(words):
260 < 2 +        lowered = word.lower()
261 < 2 +        if index in (0, last_index) or lowered not in MINOR_WORDS:
262 < 2 +            result.append(lowered[:1].upper() + lowered[1:])
263 < 2 +        else:
264 < 2 +            result.append(lowered)
265 < 2 +    return " ".join(result)
266 < 2 diff --git a/textkit/truncate.py b/textkit/truncate.py
267 < 2 new file mode 100644
268 < 2 index 0000000..3867cc9
269 < 2 --- /dev/null
270 < 2 +++ b/textkit/truncate.py
271 < 2 @@ -0,0 +1,7 @@
272 < 2 +def truncate(text, limit, ellipsis="..."):
273 < 2 +    """Truncate ``text`` to ``limit`` characters, appending ``ellipsis`` if cut short."""
274 < 2 +    if limit < len(ellipsis):
275 < 2 +        raise ValueError("limit must be at least as long as the ellipsis")
276 < 2 +    if len(text) <= limit:
277 < 2 +        return text
278 < 2 +    return text[: limit - len(ellipsis)].rstrip() + ellipsis
279 < 2 diff --git a/textkit/word_count.py b/textkit/word_count.py
280 < 2 new file mode 100644
281 < 2 index 0000000..2163dd5
282 < 2 --- /dev/null
283 < 2 +++ b/textkit/word_count.py
284 < 2 @@ -0,0 +1,13 @@
285 < 2 +import re
286 < 2 +
287 < 2 +
288 < 2 +def word_count(text):
289 < 2 +    """Return a dict mapping each word to its count.
290 < 2 +
291 < 2 +    Words are maximal runs matching [a-z0-9]+ after lowercasing the input,
292 < 2 +    so "Don't" yields "don" and "t" as separate words.
293 < 2 +    """
294 < 2 +    counts = {}
295 < 2 +    for word in re.findall(r"[a-z0-9]+", text.lower()):
296 < 2 +        counts[word] = counts.get(word, 0) + 1
297 < 2 +    return counts
298 < 2 