4 < 2 +++ b/app/audit.py
5 < 2 @@ -0,0 +1,76 @@
6 < 2 +"""Audit log of every dispatched call.
7 < 2 +
8 < 2 +`dispatch_hook` is registered into `app.registry.DISPATCH_HOOKS` and fires
9 < 2 +for every dispatch, regardless of method — unlike rate limiting, the audit
10 < 2 +log does not special-case which HTTP verbs it logs. It always records; the
11 < 2 +`audit_log_enabled` config key is reserved for a future on/off switch and
12 < 2 +is not read by this module in this plan.
13 < 2 +
14 < 2 +The log is module-global state (a single process-wide audit trail) capped
15 < 2 +at `audit_log_max_entries` (or an explicit `max_entries` argument): once
16 < 2 +full, the oldest entry is evicted for each new one appended. `dropped()`
17 < 2 +reports how many entries have been evicted since the last `clear()`.
18 < 2 +"""
19 < 2 +
20 < 2 +_log = []
21 < 2 +_dropped = 0
22 < 2 +
23 < 2 +
24 < 2 +def clear():
25 < 2 +    """Reset the log and the dropped counter."""
26 < 2 +    global _log, _dropped
27 < 2 +    _log = []
28 < 2 +    _dropped = 0
29 < 2 +
30 < 2 +
31 < 2 +def entries():
32 < 2 +    """Return a copy of the log, in append order."""
33 < 2 +    return [dict(e) for e in _log]
34 < 2 +
35 < 2 +
36 < 2 +def record(method, path, actor, max_entries):
37 < 2 +    """Append one entry, then evict from the front until the log is at
38 < 2 +    most `max_entries` long, incrementing the dropped counter for each
39 < 2 +    eviction."""
40 < 2 +    global _dropped
41 < 2 +    _log.append({"method": method, "path": path, "actor": actor})
42 < 2 +    while len(_log) > max_entries:
43 < 2 +        _log.pop(0)
44 < 2 +        _dropped += 1
45 < 2 +
46 < 2 +
47 < 2 +def record_many(triples, max_entries):
48 < 2 +    """Append each (method, path, actor) triple in order, enforcing the
49 < 2 +    cap after every append. Returns the number of triples appended (always
50 < 2 +    len(triples) — appends that immediately age out still count)."""
51 < 2 +    for method, path, actor in triples:
52 < 2 +        record(method, path, actor, max_entries)
53 < 2 +    return len(triples)
54 < 2 +
55 < 2 +
56 < 2 +def dropped():
57 < 2 +    """Number of entries evicted by the cap since the last clear()."""
58 < 2 +    return _dropped
59 < 2 +
60 < 2 +
61 < 2 +def export_state():
62 < 2 +    """Return {"entries": entries(), "dropped": dropped()} — a copy safe
63 < 2 +    to mutate without affecting the live log."""
64 < 2 +    return {"entries": entries(), "dropped": dropped()}
65 < 2 +
66 < 2 +
67 < 2 +def import_state(state):
68 < 2 +    """Replace the log and dropped counter from an export_state()-shaped
69 < 2 +    dict. Copies its input so later mutation of `state` does not leak into
70 < 2 +    the live log."""
71 < 2 +    global _log, _dropped
72 < 2 +    _log = [dict(e) for e in state["entries"]]
73 < 2 +    _dropped = state["dropped"]
74 < 2 +
75 < 2 +
76 < 2 +def dispatch_hook(store, config, method, path, kwargs):
77 < 2 +    """DISPATCH_HOOKS-shaped hook: records every dispatch, actor defaulting
78 < 2 +    to "anonymous" when kwargs carries none. Never logs record fields —
79 < 2 +    only method/path/actor."""
80 < 2 +    actor = kwargs.get("actor", "anonymous")
81 < 2 +    record(method, path, actor, config["audit_log_max_entries"])
82 < 2 diff --git a/app/audit_query.py b/app/audit_query.py
