2025 < 2 diff --git a/tests/test_backoff.py b/tests/test_backoff.py
2026 < 2 new file mode 100644
2027 < 2 index 0000000..2cbb7db
2028 < 2 --- /dev/null
2029 < 2 +++ b/tests/test_backoff.py
2030 < 2 @@ -0,0 +1,104 @@
2031 < 2 +"""Tests for app/backoff.py -- a deterministic retry-schedule calculator
2032 < 2 +built on app/quota.py."""
2033 < 2 +import pytest
2034 < 2 +
2035 < 2 +from app import backoff, quota
2036 < 2 +from app.backoff import BackoffError
2037 < 2 +from app.quota import QuotaExceededError
2038 < 2 +
2039 < 2 +
2040 < 2 +def setup_function(_fn):
2041 < 2 +    quota.reset()
2042 < 2 +
2043 < 2 +
2044 < 2 +def test_backoff_error_is_an_exception_subclass_distinct_from_quota_error():
2045 < 2 +    assert issubclass(BackoffError, Exception)
2046 < 2 +    assert not issubclass(BackoffError, QuotaExceededError)
2047 < 2 +
2048 < 2 +
2049 < 2 +def test_schedule_exact_values_and_types():
2050 < 2 +    result = backoff.schedule(1.0, 2.0, 3)
2051 < 2 +    assert result == [1.0, 2.0, 4.0]
2052 < 2 +    assert all(type(x) is float for x in result)
2053 < 2 +
2054 < 2 +    assert backoff.schedule(1.0, 2.0, 0) == []
2055 < 2 +
2056 < 2 +    with pytest.raises(BackoffError):
2057 < 2 +        backoff.schedule(0, 2.0, 3)
2058 < 2 +    with pytest.raises(BackoffError):
2059 < 2 +        backoff.schedule(1.0, 0.5, 3)
2060 < 2 +    with pytest.raises(BackoffError):
2061 < 2 +        backoff.schedule(1.0, 2.0, -1)
2062 < 2 +
2063 < 2 +
2064 < 2 +def test_capped_element_wise_min_and_input_unmutated():
2065 < 2 +    seq = [1.0, 2.0, 4.0]
2066 < 2 +    result = backoff.capped(seq, 3.0)
2067 < 2 +    assert result == [1.0, 2.0, 3.0]
2068 < 2 +    assert seq == [1.0, 2.0, 4.0]
2069 < 2 +
2070 < 2 +    with pytest.raises(BackoffError):
2071 < 2 +        backoff.capped(seq, 0)
2072 < 2 +
2073 < 2 +
2074 < 2 +def test_total_wait_sums_and_empty_is_zero():
2075 < 2 +    assert backoff.total_wait([1.0, 2.0, 3.0]) == 6.0
2076 < 2 +    assert backoff.total_wait([]) == 0.0
2077 < 2 +
2078 < 2 +
2079 < 2 +def test_next_delay_exact_values_and_negative_attempt_raises():
2080 < 2 +    assert backoff.next_delay(0, 1.0, 2.0, 60.0) == 1.0
2081 < 2 +    assert backoff.next_delay(6, 1.0, 2.0, 60.0) == 60.0
2082 < 2 +    with pytest.raises(BackoffError):
2083 < 2 +        backoff.next_delay(-1, 1.0, 2.0, 60.0)
2084 < 2 +
2085 < 2 +
2086 < 2 +def test_delay_until_free_delegates_and_end_to_end(monkeypatch):
2087 < 2 +    calls = []
2088 < 2 +
2089 < 2 +    def recorder(*args, **kwargs):
2090 < 2 +        calls.append((args, kwargs))
2091 < 2 +        return 0.0
2092 < 2 +
2093 < 2 +    monkeypatch.setattr(quota, "time_to_next_slot", recorder)
2094 < 2 +    config = {
2095 < 2 +        "rate_limit_max_per_window": 3,
2096 < 2 +        "rate_limit_window_seconds": 60,
2097 < 2 +        "rate_limit_burst": 1,
2098 < 2 +    }
2099 < 2 +    backoff.delay_until_free("k", config)
2100 < 2 +    assert calls == [(("k", 3, 60), {"burst": 1})]
2101 < 2 +
2102 < 2 +    monkeypatch.undo()
2103 < 2 +    quota.take("k", 2, 60)
2104 < 2 +    quota.take("k", 2, 60)
2105 < 2 +    quota.advance(10)
2106 < 2 +    minimal_config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
2107 < 2 +    assert backoff.delay_until_free("k", minimal_config) == 50.0
2108 < 2 +
2109 < 2 +
2110 < 2 +def test_retry_plan_exact_dict_fresh_and_exhausted():
2111 < 2 +    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
2112 < 2 +    assert backoff.retry_plan("k", config, retries=3) == {
2113 < 2 +        "immediate": True,
2114 < 2 +        "wait": 0.0,
2115 < 2 +        "backoff": [1.0, 2.0, 4.0],
2116 < 2 +    }
2117 < 2 +
2118 < 2 +    quota.take("k", 2, 60)
2119 < 2 +    quota.take("k", 2, 60)
2120 < 2 +    quota.advance(10)
2121 < 2 +    assert backoff.retry_plan("k", config, retries=3) == {
2122 < 2 +        "immediate": False,
2123 < 2 +        "wait": 50.0,
2124 < 2 +        "backoff": [1.0, 2.0, 4.0],
2125 < 2 +    }
2126 < 2 +    # read-only: no hit was ever recorded by retry_plan itself
2127 < 2 +    assert quota.remaining("k", 2, 60) == 0
2128 < 2 +    quota.advance(51)
2129 < 2 +    assert quota.remaining("k", 2, 60) == 2
2130 < 2 +
