845 < 2 +"""Per-actor POST rate limiting, built on `app.quota`'s windowed counter.
846 < 2 +
847 < 2 +This module keeps no counter state of its own: every count lives in
848 < 2 +`app.quota`'s module-global hits store, keyed directly by the request's
849 < 2 +actor (defaulting to "anonymous"). `dispatch_hook` is the DISPATCH_HOOKS
850 < 2 +entry point the registry wires in; it is a no-op for any method other
851 < 2 +than "POST" (rate limiting applies to writes, not reads).
852 < 2 +"""
853 < 2 +from app import quota
854 < 2 +
855 < 2 +
856 < 2 +class RateLimitExceededError(quota.QuotaExceededError):
857 < 2 +    """Raised when an actor has exhausted its rate-limit window."""
858 < 2 +
859 < 2 +
860 < 2 +def reset():
861 < 2 +    """Reset all rate-limit state. Delegates to `quota.reset()`, which
862 < 2 +    also resets the logical clock."""
863 < 2 +    quota.reset()
864 < 2 +
865 < 2 +
866 < 2 +def check_and_increment(key, limit, window_seconds=float("inf")):
867 < 2 +    """Record a hit for `key` against a plain call-counting quota
868 < 2 +    (unbounded window by default) and return the resulting count. Raises
869 < 2 +    RateLimitExceededError once `limit` is exceeded."""
870 < 2 +    try:
871 < 2 +        return quota.take(key, limit, window_seconds, burst=0)
872 < 2 +    except quota.QuotaExceededError as exc:
873 < 2 +        raise RateLimitExceededError(str(exc)) from exc
874 < 2 +
875 < 2 +
876 < 2 +def dispatch_hook(store, config, method, path, kwargs):
877 < 2 +    """DISPATCH_HOOKS entry point: rate-limits POST requests per actor.
878 < 2 +    Only `config["rate_limit_max_per_window"]` is required; window and
879 < 2 +    burst always fall back to defaults via `.get(...)`."""
880 < 2 +    if method != "POST":
881 < 2 +        return
882 < 2 +    actor = kwargs.get("actor", "anonymous")
883 < 2 +    limit = config["rate_limit_max_per_window"]
884 < 2 +    window_seconds = config.get("rate_limit_window_seconds", 60)
885 < 2 +    burst = config.get("rate_limit_burst", 0)
886 < 2 +    try:
887 < 2 +        quota.take(actor, limit, window_seconds, burst=burst)
888 < 2 +    except quota.QuotaExceededError as exc:
889 < 2 +        raise RateLimitExceededError(str(exc)) from exc
890 < 2 +
891 < 2 +
892 < 2 +def retry_after(key, config):
893 < 2 +    """Read-only: seconds until `key` next has a free slot, per `config`."""
894 < 2 +    limit = config["rate_limit_max_per_window"]
895 < 2 +    window_seconds = config.get("rate_limit_window_seconds", 60)
896 < 2 +    burst = config.get("rate_limit_burst", 0)
897 < 2 +    return quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
898 < 2 +
899 < 2 +
900 < 2 +def limit_headers(key, config):
901 < 2 +    """Read-only: rate-limit response headers for `key`, as strings."""
902 < 2 +    limit = config["rate_limit_max_per_window"]
903 < 2 +    window_seconds = config.get("rate_limit_window_seconds", 60)
904 < 2 +    burst = config.get("rate_limit_burst", 0)
905 < 2 +    rem = quota.remaining(key, limit, window_seconds, burst=burst)
906 < 2 +    reset_in = quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
907 < 2 +    return {
908 < 2 +        "X-RateLimit-Limit": str(limit),
909 < 2 +        "X-RateLimit-Remaining": str(rem),
910 < 2 +        "X-RateLimit-Reset": str(reset_in),
911 < 2 +    }
912 < 2 +
913 < 2 +
914 < 2 +def status_line(key, config):
915 < 2 +    """Read-only: a one-line human-readable usage summary for `key`."""
916 < 2 +    limit = config["rate_limit_max_per_window"]
917 < 2 +    window_seconds = config.get("rate_limit_window_seconds", 60)
918 < 2 +    burst = config.get("rate_limit_burst", 0)
919 < 2 +    u = quota.usage(key, limit, window_seconds, burst=burst)
920 < 2 +    return "%s: %s/%s, reset in %ss" % (key, u["used"], u["allowed"], u["reset_in"])
921 < 2 +
922 < 2 +
923 < 2 +def check_many(keys, config):
924 < 2 +    """Read-only: for each key in `keys`, whether a POST would currently
925 < 2 +    succeed."""
926 < 2 +    limit = config["rate_limit_max_per_window"]
927 < 2 +    window_seconds = config.get("rate_limit_window_seconds", 60)
928 < 2 +    burst = config.get("rate_limit_burst", 0)
929 < 2 +    return {
930 < 2 +        key: quota.remaining(key, limit, window_seconds, burst=burst) > 0
931 < 2 +        for key in keys
932 < 2 +    }
