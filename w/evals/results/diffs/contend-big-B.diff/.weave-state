1061 < 2 +"""Column-model toolkit shared by the export formatters.
1062 < 2 +
1063 < 2 +Pure helpers over lists of plain dict "records": figuring out the column
1064 < 2 +set, rendering a single cell, escaping for CSV/HTML, measuring/padding
1065 < 2 +column widths, and wrapping/truncating long values. `app/export.py` builds
1066 < 2 +every format on top of these — no duplicated key-union, escaping, or
1067 < 2 +str()-ing logic lives in export.py.
1068 < 2 +"""
1069 < 2 +
1070 < 2 +
1071 < 2 +def columns(records):
1072 < 2 +    """Sorted union of every key across all records."""
1073 < 2 +    keys = set()
1074 < 2 +    for r in records:
1075 < 2 +        keys.update(r.keys())
1076 < 2 +    return sorted(keys)
1077 < 2 +
1078 < 2 +
1079 < 2 +def cell(value):
1080 < 2 +    """Plain str() rendering of a value, except None -> ""."""
1081 < 2 +    if value is None:
1082 < 2 +        return ""
1083 < 2 +    return str(value)
1084 < 2 +
1085 < 2 +
1086 < 2 +def escape_csv(value):
1087 < 2 +    """CSV-escape a single cell's rendered text: quote the cell (doubling
1088 < 2 +    any inner quotes) only if it contains a comma, quote, or newline."""
1089 < 2 +    if any(ch in value for ch in (",", '"', "\n", "\r")):
1090 < 2 +        return '"' + value.replace('"', '""') + '"'
1091 < 2 +    return value
1092 < 2 +
1093 < 2 +
1094 < 2 +def widths(records, cols):
1095 < 2 +    """dict: column name -> max(len(header), max cell width)."""
1096 < 2 +    result = {}
1097 < 2 +    for c in cols:
1098 < 2 +        w = len(c)
1099 < 2 +        for r in records:
1100 < 2 +            cw = len(cell(r.get(c)))
1101 < 2 +            if cw > w:
1102 < 2 +                w = cw
1103 < 2 +        result[c] = w
1104 < 2 +    return result
1105 < 2 +
1106 < 2 +
1107 < 2 +def pad(value, width, align):
1108 < 2 +    """Pad `value` to `width` per `align` ("left" or "right"). A value
1109 < 2 +    already at or beyond `width` is returned unchanged (never truncated).
1110 < 2 +    `align` is validated before any short-circuit, so an invalid align
1111 < 2 +    always raises, even when the value already meets the width."""
1112 < 2 +    if align not in ("left", "right"):
1113 < 2 +        raise ValueError("invalid align: %s" % align)
1114 < 2 +    if len(value) >= width:
1115 < 2 +        return value
1116 < 2 +    fill = " " * (width - len(value))
1117 < 2 +    if align == "left":
1118 < 2 +        return value + fill
1119 < 2 +    return fill + value
1120 < 2 +
1121 < 2 +
1122 < 2 +def sanitize_flat(value):
1123 < 2 +    """cell(value) with every tab and newline replaced by a single space
1124 < 2 +    -- the helper flat single-line formats (TSV) build on."""
1125 < 2 +    s = cell(value)
1126 < 2 +    return s.replace("\t", " ").replace("\n", " ")
1127 < 2 +
1128 < 2 +
1129 < 2 +def escape_html(value):
1130 < 2 +    """cell(value) with &, <, >, " HTML-escaped (ampersand first)."""
1131 < 2 +    s = cell(value)
1132 < 2 +    s = s.replace("&", "&amp;")
1133 < 2 +    s = s.replace("<", "&lt;")
1134 < 2 +    s = s.replace(">", "&gt;")
1135 < 2 +    s = s.replace('"', "&quot;")
1136 < 2 +    return s
1137 < 2 +
1138 < 2 +
1139 < 2 +def truncate(value, width, marker="..."):
1140 < 2 +    """`value` unchanged if it already fits in `width`; otherwise the
1141 < 2 +    first `width - len(marker)` characters plus `marker`."""
1142 < 2 +    if width < len(marker):
1143 < 2 +        raise ValueError("width %r smaller than marker %r" % (width, marker))
1144 < 2 +    if len(value) <= width:
1145 < 2 +        return value
1146 < 2 +    return value[:width - len(marker)] + marker
1147 < 2 +
1148 < 2 +
1149 < 2 +def wrap(value, width):
1150 < 2 +    """Greedily wrap `value` on spaces into lines each <= width. A single
1151 < 2 +    word longer than `width` is hard-split at `width`."""
1152 < 2 +    if width < 1:
1153 < 2 +        raise ValueError("width must be >= 1: %r" % (width,))
1154 < 2 +    if value == "":
1155 < 2 +        return [""]
1156 < 2 +    words = value.split(" ")
1157 < 2 +    lines = []
1158 < 2 +    current = ""
1159 < 2 +    for word in words:
1160 < 2 +        while len(word) > width:
1161 < 2 +            if current:
1162 < 2 +                lines.append(current)
1163 < 2 +                current = ""
1164 < 2 +            lines.append(word[:width])
1165 < 2 +            word = word[width:]
1166 < 2 +        candidate = current + " " + word if current else word
1167 < 2 +        if len(candidate) <= width:
1168 < 2 +            current = candidate
1169 < 2 +        else:
1170 < 2 +            lines.append(current)
1171 < 2 +            current = word
1172 < 2 +    lines.append(current)
1173 < 2 +    return lines
1174 < 2 +
1175 < 2 +
1176 < 2 +def fit(value, width, align):
1177 < 2 +    """Compose truncate() then pad(): an over-long value is truncated to
1178 < 2 +    `width` (marker included), a short one padded per `align`."""
1179 < 2 +    return pad(truncate(value, width), width, align)
1180 < 2 +
1181 < 2 +
1182 < 2 +def render_row(cells, widths_list, align):
1183 < 2 +    """Render one pipe-table row: "| " + " | ".join(padded cells) + " |",
1184 < 2 +    each cell padded to its width."""
1185 < 2 +    if len(cells) != len(widths_list):
1186 < 2 +        raise ValueError("cells/widths length mismatch: %d != %d"
1187 < 2 +                          % (len(cells), len(widths_list)))
1188 < 2 +    padded = [pad(c, w, align) for c, w in zip(cells, widths_list)]
1189 < 2 +    return "| " + " | ".join(padded) + " |"
1190 < 2 diff --git a/app/throttle.py b/app/throttle.py
1191 < 2 new file mode 100644
1192 < 2 index 0000000..25c261f
1193 < 2 --- /dev/null
1194 < 2 +++ b/app/throttle.py
1195 < 2 @@ -0,0 +1,81 @@
1196 < 2 +"""Pure policy layer over `app.quota`'s windowed counter.
1197 < 2 +
1198 < 2 +Not wired into the registry: a library layer for future routes. Holds no
1199 < 2 +module state of its own beyond the `POLICIES` constant; every actual hit
1200 < 2 +lives in `app.quota`.
1201 < 2 +"""
1202 < 2 +from app import quota
1203 < 2 +
1204 < 2 +
1205 < 2 +class PolicyError(Exception):
1206 < 2 +    """Raised when a matched policy's quota is exhausted."""
1207 < 2 +
1208 < 2 +
1209 < 2 +POLICIES = {
1210 < 2 +    "POST /records": {"limit": 5, "window": 60, "burst": 0},
1211 < 2 +    "GET /export": {"limit": 10, "window": 60, "burst": 2},
1212 < 2 +}
1213 < 2 +
1214 < 2 +
1215 < 2 +def match_policy(method, path, policies):
1216 < 2 +    """Return the policy dict whose method equals `method` and whose
1217 < 2 +    path-prefix is a prefix of `path`, choosing the longest matching
1218 < 2 +    prefix. Returns None if nothing matches."""
1219 < 2 +    best_prefix_len = -1
1220 < 2 +    best_policy = None
1221 < 2 +    for key, policy in policies.items():
1222 < 2 +        pol_method, _, prefix = key.partition(" ")
1223 < 2 +        if pol_method != method:
1224 < 2 +            continue
1225 < 2 +        if path.startswith(prefix) and len(prefix) > best_prefix_len:
1226 < 2 +            best_prefix_len = len(prefix)
1227 < 2 +            best_policy = policy
1228 < 2 +    return best_policy
1229 < 2 +
1230 < 2 +
1231 < 2 +def key_for(method, path, actor):
1232 < 2 +    """The quota key a matched policy hit is recorded under."""
1233 < 2 +    return "%s %s:%s" % (method, path, actor)
1234 < 2 +
1235 < 2 +
1236 < 2 +def enforce(method, path, actor, policies):
1237 < 2 +    """Apply the policy (if any) matching `method`/`path` for `actor`.
1238 < 2 +    Returns None with no hit recorded when nothing matches. Otherwise
1239 < 2 +    delegates to `quota.take` and returns the in-window count, raising
1240 < 2 +    PolicyError (chained) once the policy's quota is exhausted."""
1241 < 2 +    policy = match_policy(method, path, policies)
1242 < 2 +    if policy is None:
1243 < 2 +        return None
1244 < 2 +    key = key_for(method, path, actor)
1245 < 2 +    try:
1246 < 2 +        return quota.take(
1247 < 2 +            key, policy["limit"], policy["window"], burst=policy.get("burst", 0)
1248 < 2 +        )
1249 < 2 +    except quota.QuotaExceededError as exc:
1250 < 2 +        raise PolicyError(str(exc)) from exc
1251 < 2 +
1252 < 2 +
1253 < 2 +def remaining_for(method, path, actor, policies):
1254 < 2 +    """Read-only: remaining allowance under the matched policy, or None
1255 < 2 +    if nothing matches."""
1256 < 2 +    policy = match_policy(method, path, policies)
1257 < 2 +    if policy is None:
1258 < 2 +        return None
1259 < 2 +    key = key_for(method, path, actor)
1260 < 2 +    return quota.remaining(
1261 < 2 +        key, policy["limit"], policy["window"], burst=policy.get("burst", 0)
1262 < 2 +    )
1263 < 2 +
1264 < 2 +
1265 < 2 +def describe_policies(policies):
1266 < 2 +    """Render `policies` as one sorted, human-readable line per key."""
1267 < 2 +    if not policies:
1268 < 2 +        return "(no policies)"
1269 < 2 +    lines = []
1270 < 2 +    for key in sorted(policies):
1271 < 2 +        p = policies[key]
1272 < 2 +        lines.append(
1273 < 2 +            "%s: limit=%s, window=%s, burst=%s"
1274 < 2 +            % (key, p["limit"], p["window"], p.get("burst", 0))
1275 < 2 +        )
1276 < 2 +    return "\n".join(lines)
1277 < 2 diff --git a/app/tiers.py b/app/tiers.py
1278 < 2 new file mode 100644
1279 < 2 index 0000000..3dfdc2e
1280 < 2 --- /dev/null
1281 < 2 +++ b/app/tiers.py
1282 < 2 @@ -0,0 +1,61 @@
1283 < 2 +"""Actor-tier policy layer over `app.throttle`.
1284 < 2 +
1285 < 2 +No module state of its own beyond the `TIERS` constant.
1286 < 2 +"""
1287 < 2 +import copy
1288 < 2 +
1289 < 2 +from app import throttle
1290 < 2 +
1291 < 2 +
1292 < 2 +class TierError(Exception):
1293 < 2 +    """Raised for an unassignable or unknown tier."""
1294 < 2 +
1295 < 2 +
1296 < 2 +TIERS = {
1297 < 2 +    "free": {"limit": 2, "window": 60, "burst": 0},
1298 < 2 +    "pro": {"limit": 10, "window": 60, "burst": 2},
1299 < 2 +    "internal": {"limit": 100, "window": 60, "burst": 10},
1300 < 2 +}
1301 < 2 +
1302 < 2 +_UPGRADE_PATH = {"free": "pro", "pro": "internal", "internal": None}
1303 < 2 +
1304 < 2 +
1305 < 2 +def tier_of(actor, assignments):
1306 < 2 +    """The tier name for `actor`, defaulting to "free" if unassigned.
1307 < 2 +    Raises TierError (naming both the actor and the bogus tier) if the
1308 < 2 +    assigned tier is not in TIERS."""
1309 < 2 +    tier = assignments.get(actor, "free")
1310 < 2 +    if tier not in TIERS:
1311 < 2 +        raise TierError("actor %r assigned unknown tier %r" % (actor, tier))
1312 < 2 +    return tier
1313 < 2 +
1314 < 2 +
1315 < 2 +def policy_for(actor, assignments):
1316 < 2 +    """A deep copy of `actor`'s tier policy dict."""
1317 < 2 +    return copy.deepcopy(TIERS[tier_of(actor, assignments)])
1318 < 2 +
1319 < 2 +
1320 < 2 +def enforce_tier(method, path, actor, assignments):
1321 < 2 +    """Apply `actor`'s tier policy to a `method`/`path` call, via
1322 < 2 +    `throttle.enforce` under a one-key policies dict."""
1323 < 2 +    policies = {"%s %s" % (method, path): policy_for(actor, assignments)}
1324 < 2 +    return throttle.enforce(method, path, actor, policies)
1325 < 2 +
1326 < 2 +
1327 < 2 +def remaining_tier(method, path, actor, assignments):
1328 < 2 +    """Read-only: remaining allowance under `actor`'s tier policy."""
1329 < 2 +    policies = {"%s %s" % (method, path): policy_for(actor, assignments)}
1330 < 2 +    return throttle.remaining_for(method, path, actor, policies)
1331 < 2 +
1332 < 2 +
1333 < 2 +def describe_tiers():
1334 < 2 +    """Render all TIERS via `throttle.describe_policies`."""
1335 < 2 +    return throttle.describe_policies(TIERS)
1336 < 2 +
1337 < 2 +
1338 < 2 +def upgrade_path(tier):
1339 < 2 +    """The next tier by allowance, or None for the top tier. Raises
1340 < 2 +    TierError (naming the tier) for an unknown tier."""
1341 < 2 +    if tier not in TIERS:
1342 < 2 +        raise TierError("unknown tier %r" % (tier,))
1343 < 2 +    return _UPGRADE_PATH[tier]
