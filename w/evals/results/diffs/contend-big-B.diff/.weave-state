2919 < 2 +    calls = []
2920 < 2 +    real_render_any = export.render_any
2921 < 2 +
2922 < 2 +    def recorder(records, fmt):
2923 < 2 +        calls.append((records, fmt))
2924 < 2 +        return real_render_any(records, fmt)
2925 < 2 +
2926 < 2 +    original = export.render_any
2927 < 2 +    export.render_any = recorder
2928 < 2 +    try:
2929 < 2 +        result = reportdoc.render_section(sec)
2930 < 2 +    finally:
2931 < 2 +        export.render_any = original
2932 < 2 +    assert calls == [([{"a": 1}], "csv")]
2933 < 2 +    assert result == "## Alpha\n\n" + real_render_any([{"a": 1}], "csv")
2934 < 2 +
2935 < 2 +    # An empty-records section never calls render_any.
2936 < 2 +    empty_sec = reportdoc.section("T", [])
2937 < 2 +    calls = []
2938 < 2 +    export.render_any = recorder
2939 < 2 +    try:
2940 < 2 +        empty_result = reportdoc.render_section(empty_sec)
2941 < 2 +    finally:
