535 < 2 @@ -0,0 +1,164 @@
536 < 2 +"""Export formatters: render a list of plain dict records as CSV, JSON,
537 < 2 +Markdown, NDJSON, TSV, or (extra, not route-reachable) HTML.
538 < 2 +
539 < 2 +Every formatter builds its column model and cell rendering through
540 < 2 +`app.tabular` -- no duplicated key-union, escaping, or str() logic lives
541 < 2 +here.
542 < 2 +"""
543 < 2 +import json
544 < 2 +
545 < 2 +from app import tabular
546 < 2 +
547 < 2 +
548 < 2 +def to_csv(records):
549 < 2 +    if not records:
550 < 2 +        return ""
551 < 2 +    cols = tabular.columns(records)
552 < 2 +    lines = [",".join(tabular.escape_csv(c) for c in cols)]
553 < 2 +    for r in records:
554 < 2 +        lines.append(",".join(
555 < 2 +            tabular.escape_csv(tabular.cell(r.get(c))) for c in cols))
556 < 2 +    return "\n".join(lines)
557 < 2 +
558 < 2 +
559 < 2 +def to_json(records):
560 < 2 +    return json.dumps(records, sort_keys=True)
561 < 2 +
562 < 2 +
563 < 2 +def to_markdown(records, align="left"):
564 < 2 +    if not records:
565 < 2 +        return ""
566 < 2 +    cols = tabular.columns(records)
567 < 2 +    w = tabular.widths(records, cols)
568 < 2 +    header_cells = [tabular.pad(c, w[c], align) for c in cols]
569 < 2 +    rows = ["| " + " | ".join(header_cells) + " |"]
570 < 2 +    if align == "left":
571 < 2 +        sep_cells = ["-" * w[c] for c in cols]
572 < 2 +    else:
573 < 2 +        sep_cells = ["-" * (w[c] - 1) + ":" for c in cols]
574 < 2 +    rows.append("| " + " | ".join(sep_cells) + " |")
575 < 2 +    for r in records:
576 < 2 +        cells = [tabular.pad(tabular.cell(r.get(c)), w[c], align)
577 < 2 +                 for c in cols]
578 < 2 +        rows.append("| " + " | ".join(cells) + " |")
579 < 2 +    return "\n".join(rows)
580 < 2 +
581 < 2 +
582 < 2 +def to_ndjson(records):
583 < 2 +    if not records:
584 < 2 +        return ""
585 < 2 +    return "\n".join(json.dumps(r, sort_keys=True) for r in records)
586 < 2 +
587 < 2 +
588 < 2 +def to_tsv(records):
589 < 2 +    if not records:
590 < 2 +        return ""
591 < 2 +    cols = tabular.columns(records)
592 < 2 +    lines = ["\t".join(tabular.sanitize_flat(c) for c in cols)]
593 < 2 +    for r in records:
594 < 2 +        lines.append("\t".join(
595 < 2 +            tabular.sanitize_flat(r.get(c)) for c in cols))
596 < 2 +    return "\n".join(lines)
597 < 2 +
598 < 2 +
599 < 2 +def to_html(records):
600 < 2 +    if not records:
601 < 2 +        return ""
602 < 2 +    cols = tabular.columns(records)
603 < 2 +    lines = ["<table>"]
604 < 2 +    lines.append("<tr>" + "".join(
605 < 2 +        "<th>%s</th>" % tabular.escape_html(c) for c in cols) + "</tr>")
606 < 2 +    for r in records:
607 < 2 +        lines.append("<tr>" + "".join(
608 < 2 +            "<td>%s</td>" % tabular.escape_html(r.get(c)) for c in cols)
609 < 2 +            + "</tr>")
610 < 2 +    lines.append("</table>")
611 < 2 +    return "\n".join(lines)
612 < 2 +
613 < 2 +
614 < 2 +def parse_csv(text):
615 < 2 +    """Inverse of to_csv: first line is the header, each further line
616 < 2 +    yields a dict of header -> cell string (values are never re-typed).
617 < 2 +    Handles quoted cells (embedded commas, doubled quotes, embedded
618 < 2 +    newlines) and raises ValueError on an unterminated quote."""
619 < 2 +    if text == "":
620 < 2 +        return []
621 < 2 +    rows = []
622 < 2 +    row = []
623 < 2 +    cell_chars = []
624 < 2 +    in_quotes = False
625 < 2 +    i = 0
626 < 2 +    n = len(text)
627 < 2 +    while i < n:
628 < 2 +        ch = text[i]
629 < 2 +        if in_quotes:
630 < 2 +            if ch == '"':
631 < 2 +                if i + 1 < n and text[i + 1] == '"':
632 < 2 +                    cell_chars.append('"')
633 < 2 +                    i += 2
634 < 2 +                    continue
635 < 2 +                in_quotes = False
636 < 2 +                i += 1
637 < 2 +                continue
638 < 2 +            cell_chars.append(ch)
639 < 2 +            i += 1
640 < 2 +            continue
641 < 2 +        if ch == '"':
642 < 2 +            in_quotes = True
643 < 2 +            i += 1
644 < 2 +            continue
645 < 2 +        if ch == ',':
646 < 2 +            row.append("".join(cell_chars))
647 < 2 +            cell_chars = []
648 < 2 +            i += 1
649 < 2 +            continue
650 < 2 +        if ch == '\n':
651 < 2 +            row.append("".join(cell_chars))
652 < 2 +            rows.append(row)
653 < 2 +            row = []
654 < 2 +            cell_chars = []
655 < 2 +            i += 1
656 < 2 +            continue
657 < 2 +        cell_chars.append(ch)
658 < 2 +        i += 1
659 < 2 +    if in_quotes:
660 < 2 +        raise ValueError("unterminated quote in CSV")
661 < 2 +    row.append("".join(cell_chars))
662 < 2 +    rows.append(row)
663 < 2 +
664 < 2 +    header = rows[0]
665 < 2 +    data_rows = rows[1:]
666 < 2 +    if not data_rows:
667 < 2 +        return []
668 < 2 +    return [dict(zip(header, r)) for r in data_rows]
669 < 2 +
670 < 2 +
671 < 2 +FORMATS = {
672 < 2 +    "csv": to_csv,
673 < 2 +    "json": to_json,
674 < 2 +    "md": to_markdown,
675 < 2 +    "ndjson": to_ndjson,
676 < 2 +    "tsv": to_tsv,
677 < 2 +}
678 < 2 +
679 < 2 +EXTRA_FORMATS = {
680 < 2 +    "html": to_html,
681 < 2 +}
682 < 2 +
683 < 2 +
684 < 2 +def render(records, fmt):
685 < 2 +    if fmt not in FORMATS:
686 < 2 +        raise ValueError("unknown export format: %s" % fmt)
687 < 2 +    return FORMATS[fmt](records)
688 < 2 +
689 < 2 +
690 < 2 +def render_any(records, fmt):
691 < 2 +    if fmt in FORMATS:
692 < 2 +        return FORMATS[fmt](records)
693 < 2 +    if fmt in EXTRA_FORMATS:
694 < 2 +        return EXTRA_FORMATS[fmt](records)
695 < 2 +    raise ValueError("unknown export format: %s" % fmt)
696 < 2 +
697 < 2 +
698 < 2 +def summary_line(records):
699 < 2 +    return "%d records, %d columns" % (len(records), len(tabular.columns(records)))
