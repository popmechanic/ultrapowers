1534 < 2 +"""Tests for app/audit_query.py — a pure read-side module over audit entry
1535 < 2 +lists. Every function takes a plain `entries` list and must never mutate
1536 < 2 +its input; every test that calls a query function re-asserts the fixture
1537 < 2 +is unchanged afterward.
1538 < 2 +"""
1539 < 2 +import pytest
1540 < 2 +
1541 < 2 +from app import audit_query as aq
1542 < 2 +
1543 < 2 +
1544 < 2 +def _fixture():
1545 < 2 +    return [
1546 < 2 +        {"method": "GET", "path": "/records", "actor": "alice"},
1547 < 2 +        {"method": "POST", "path": "/records", "actor": "bob"},
1548 < 2 +        {"method": "GET", "path": "/records/1", "actor": "alice"},
1549 < 2 +        {"method": "DELETE", "path": "/records/2", "actor": "carol"},
1550 < 2 +    ]
1551 < 2 +
1552 < 2 +
1553 < 2 +def _assert_unchanged(entries, original):
1554 < 2 +    assert entries == original
1555 < 2 +    for e, o in zip(entries, original):
1556 < 2 +        assert e == o
1557 < 2 +
