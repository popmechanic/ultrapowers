705 < 2 @@ -0,0 +1,133 @@
706 < 2 +"""Windowed hit counter over a deterministic logical clock.
707 < 2 +
708 < 2 +No wall-clock time is used anywhere in this module so tests (and any
709 < 2 +caller) can drive time deterministically via `advance()`. State is
710 < 2 +module-global: a float `_clock` and a `_hits` dict mapping key -> list of
711 < 2 +hit timestamps (in insertion order, never pruned in place except by
712 < 2 +`purge()` / `reset()`). Every read (take/remaining/snapshot/usage/
713 < 2 +time_to_next_slot) computes its own in-window view rather than mutating
714 < 2 +the stored list, so `purge()` remains the sole operation that actually
715 < 2 +shrinks storage.
716 < 2 +"""
717 < 2 +
718 < 2 +
719 < 2 +class QuotaExceededError(Exception):
720 < 2 +    """Raised by `take()` when a key has no room left in its window."""
721 < 2 +
722 < 2 +
723 < 2 +_clock = 0.0
724 < 2 +_hits = {}
725 < 2 +
726 < 2 +
727 < 2 +def reset():
728 < 2 +    """Reset the logical clock to 0.0 and clear every key's hits."""
729 < 2 +    global _clock
730 < 2 +    _clock = 0.0
731 < 2 +    _hits.clear()
732 < 2 +
733 < 2 +
734 < 2 +def now():
735 < 2 +    """Return the current logical clock value."""
736 < 2 +    return _clock
737 < 2 +
738 < 2 +
739 < 2 +def advance(seconds):
740 < 2 +    """Advance the logical clock by `seconds` (must be >= 0) and return
741 < 2 +    the new clock value. Raises ValueError, leaving the clock unchanged,
742 < 2 +    if `seconds` is negative (the clock is monotonic)."""
743 < 2 +    global _clock
744 < 2 +    if seconds < 0:
745 < 2 +        raise ValueError("advance: seconds must be non-negative, got %r" % (seconds,))
746 < 2 +    _clock += seconds
747 < 2 +    return _clock
748 < 2 +
749 < 2 +
750 < 2 +def _in_window(hits, window_seconds, at):
751 < 2 +    """Return the subset of `hits` that has not aged out of a window of
752 < 2 +    `window_seconds` ending at `at`. A hit sitting exactly at the
753 < 2 +    threshold (`at - window_seconds`) is kept; only strictly older hits
754 < 2 +    are dropped."""
755 < 2 +    if window_seconds == float("inf"):
756 < 2 +        return list(hits)
757 < 2 +    threshold = at - window_seconds
758 < 2 +    return [h for h in hits if h >= threshold]
759 < 2 +
760 < 2 +
761 < 2 +def take(key, limit, window_seconds, burst=0):
762 < 2 +    """Record a hit for `key` if there is room in the window, returning
763 < 2 +    the in-window hit count after recording. Raises QuotaExceededError
764 < 2 +    (without recording) once `limit + burst` in-window hits are already
765 < 2 +    present."""
766 < 2 +    hits = _hits.get(key, [])
767 < 2 +    in_window = _in_window(hits, window_seconds, _clock)
768 < 2 +    if len(in_window) >= limit + burst:
769 < 2 +        raise QuotaExceededError(
770 < 2 +            "quota exceeded for %r: limit=%s" % (key, limit)
771 < 2 +        )
772 < 2 +    hits = _hits.setdefault(key, [])
773 < 2 +    hits.append(_clock)
774 < 2 +    return len(_in_window(hits, window_seconds, _clock))
775 < 2 +
776 < 2 +
777 < 2 +def remaining(key, limit, window_seconds, burst=0):
778 < 2 +    """Read-only: how many more `take()` calls would currently succeed
779 < 2 +    for `key`. Never negative."""
780 < 2 +    hits = _hits.get(key, [])
781 < 2 +    in_window = _in_window(hits, window_seconds, _clock)
782 < 2 +    return max(0, limit + burst - len(in_window))
783 < 2 +
784 < 2 +
785 < 2 +def snapshot(window_seconds):
786 < 2 +    """Return a deep-copied dict mapping each key with at least one
787 < 2 +    in-window hit to the sorted list of its in-window hit timestamps.
788 < 2 +    Keys with no in-window hits are omitted."""
789 < 2 +    result = {}
790 < 2 +    for key, hits in _hits.items():
791 < 2 +        in_window = sorted(_in_window(hits, window_seconds, _clock))
792 < 2 +        if in_window:
793 < 2 +            result[key] = in_window
794 < 2 +    return result
795 < 2 +
796 < 2 +
797 < 2 +def time_to_next_slot(key, limit, window_seconds, burst=0):
798 < 2 +    """Read-only: seconds until one slot frees for `key`. 0.0 if a slot
799 < 2 +    is already free. float("inf") if the window never prunes, or if the
800 < 2 +    allowance (`limit + burst`) is zero so no slot can ever free."""
801 < 2 +    if limit + burst <= 0:
802 < 2 +        return float("inf")
803 < 2 +    hits = _hits.get(key, [])
804 < 2 +    in_window = _in_window(hits, window_seconds, _clock)
805 < 2 +    if len(in_window) < limit + burst:
806 < 2 +        return 0.0
807 < 2 +    if window_seconds == float("inf"):
808 < 2 +        return float("inf")
809 < 2 +    oldest = min(in_window)
810 < 2 +    return oldest + window_seconds - _clock
811 < 2 +
812 < 2 +
813 < 2 +def usage(key, limit, window_seconds, burst=0):
814 < 2 +    """Read-only summary of `key`'s current usage against `limit` /
815 < 2 +    `window_seconds` / `burst`."""
816 < 2 +    hits = _hits.get(key, [])
817 < 2 +    in_window = _in_window(hits, window_seconds, _clock)
818 < 2 +    return {
819 < 2 +        "used": len(in_window),
820 < 2 +        "allowed": limit + burst,
821 < 2 +        "remaining": remaining(key, limit, window_seconds, burst),
822 < 2 +        "reset_in": time_to_next_slot(key, limit, window_seconds, burst),
823 < 2 +    }
824 < 2 +
825 < 2 +
826 < 2 +def purge(window_seconds):
827 < 2 +    """Drop every key's aged-out hits (per `window_seconds`), removing
828 < 2 +    keys left with none. Returns the total number of hits dropped."""
829 < 2 +    dropped = 0
830 < 2 +    for key in list(_hits.keys()):
831 < 2 +        hits = _hits[key]
832 < 2 +        kept = _in_window(hits, window_seconds, _clock)
833 < 2 +        dropped += len(hits) - len(kept)
834 < 2 +        if kept:
835 < 2 +            _hits[key] = kept
836 < 2 +        else:
837 < 2 +            del _hits[key]
838 < 2 +    return dropped
