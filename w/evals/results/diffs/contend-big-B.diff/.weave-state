3093 < 2 +    assert tabular.pad("ab", 4, "right") == "  ab"
3094 < 2 +    # A 5-char value at width 4 is returned unchanged, never truncated.
3095 < 2 +    assert tabular.pad("abcde", 4, "left") == "abcde"
3096 < 2 +    # align is validated before any short-circuit: it raises even when
3097 < 2 +    # the value already meets (or exceeds) the width.
3098 < 2 +    with pytest.raises(ValueError) as exc:
3099 < 2 +        tabular.pad("abcde", 4, "center")
3100 < 2 +    assert "center" in str(exc.value)
