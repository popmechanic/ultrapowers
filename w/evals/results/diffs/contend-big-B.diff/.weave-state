427 < 2 +++ b/app/colspec.py
428 < 2 @@ -0,0 +1,101 @@
429 < 2 +"""Column-projection layer: parse a "source[:header],..." colspec string
430 < 2 +and project/select/drop record fields by it. Pure; imports app.tabular
431 < 2 +only.
432 < 2 +"""
433 < 2 +from app import tabular
434 < 2 +
435 < 2 +
436 < 2 +class ColspecError(Exception):
437 < 2 +    pass
438 < 2 +
439 < 2 +
440 < 2 +def parse_colspec(spec):
441 < 2 +    """Parse "a,b:B,c" into [(source, header), ...] -- a bare token uses
442 < 2 +    its own name as header. Whitespace around tokens and the ":" is
443 < 2 +    stripped. Raises ColspecError on an empty spec, an empty token, more
444 < 2 +    than one ":" in a token, or a duplicate source/header."""
445 < 2 +    if spec.strip() == "":
446 < 2 +        raise ColspecError("empty colspec")
447 < 2 +    pairs = []
448 < 2 +    seen_sources = set()
449 < 2 +    seen_headers = set()
450 < 2 +    for raw_tok in spec.split(","):
451 < 2 +        tok = raw_tok.strip()
452 < 2 +        if tok == "":
453 < 2 +            raise ColspecError("empty token in colspec")
454 < 2 +        parts = tok.split(":")
455 < 2 +        if len(parts) > 2:
456 < 2 +            raise ColspecError("too many ':' in token: %s" % tok)
457 < 2 +        if len(parts) == 2:
458 < 2 +            source, header = parts[0].strip(), parts[1].strip()
459 < 2 +        else:
460 < 2 +            source = header = parts[0].strip()
461 < 2 +        if source in seen_sources:
462 < 2 +            raise ColspecError("duplicate source: %s" % source)
463 < 2 +        if header in seen_headers:
464 < 2 +            raise ColspecError("duplicate header: %s" % header)
465 < 2 +        seen_sources.add(source)
466 < 2 +        seen_headers.add(header)
467 < 2 +        pairs.append((source, header))
468 < 2 +    return pairs
469 < 2 +
470 < 2 +
471 < 2 +def project(records, pairs):
472 < 2 +    """New list of dicts, one per record in input order, keyed by header
473 < 2 +    (in pair order), valued from the source field (None if absent).
474 < 2 +    Never mutates the input records."""
475 < 2 +    return [{header: r.get(source) for source, header in pairs}
476 < 2 +            for r in records]
477 < 2 +
478 < 2 +
479 < 2 +def available(records, pairs):
480 < 2 +    """(present, missing) -- sorted source-name lists split against
481 < 2 +    tabular.columns(records)."""
482 < 2 +    cols = set(tabular.columns(records))
483 < 2 +    sources = [source for source, header in pairs]
484 < 2 +    present = sorted(s for s in sources if s in cols)
485 < 2 +    missing = sorted(s for s in sources if s not in cols)
486 < 2 +    return (present, missing)
487 < 2 +
488 < 2 +
489 < 2 +def auto_colspec(records):
490 < 2 +    """[(c, c) for c in tabular.columns(records)]."""
491 < 2 +    return [(c, c) for c in tabular.columns(records)]
492 < 2 +
493 < 2 +
494 < 2 +def header_row(pairs):
495 < 2 +    return [header for source, header in pairs]
496 < 2 +
497 < 2 +
498 < 2 +def rename_map(pairs):
499 < 2 +    """{source: header} entries only for pairs that actually rename."""
500 < 2 +    return {source: header for source, header in pairs if source != header}
501 < 2 +
502 < 2 +
503 < 2 +def select(records, sources):
504 < 2 +    """Keep only the named source fields (present ones), order-preserving
505 < 2 +    new dicts. Raises ColspecError on an empty `sources`."""
506 < 2 +    if not sources:
507 < 2 +        raise ColspecError("empty sources")
508 < 2 +    return [{k: v for k, v in r.items() if k in sources} for r in records]
509 < 2 +
510 < 2 +
511 < 2 +def drop(records, sources):
512 < 2 +    """Remove the named source fields, order-preserving new dicts. Raises
513 < 2 +    ColspecError on an empty `sources`."""
514 < 2 +    if not sources:
515 < 2 +        raise ColspecError("empty sources")
516 < 2 +    return [{k: v for k, v in r.items() if k not in sources} for r in records]
517 < 2 +
518 < 2 +
519 < 2 +def sanitize_headers(pairs):
520 < 2 +    """New pairs list with every header passed through
521 < 2 +    tabular.sanitize_flat."""
522 < 2 +    return [(source, tabular.sanitize_flat(header)) for source, header in pairs]
523 < 2 +
524 < 2 +
525 < 2 +def describe_colspec(pairs):
526 < 2 +    """One line per pair, "<header> <- <source>"; "(no columns)" if empty."""
527 < 2 +    if not pairs:
528 < 2 +        return "(no columns)"
529 < 2 +    return "\n".join("%s <- %s" % (header, source) for source, header in pairs)
