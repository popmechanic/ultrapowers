2468 < 2 @@ -0,0 +1,202 @@
2469 < 2 +"""Tests for app/quota.py -- the windowed hit counter over a deterministic
2470 < 2 +logical clock that app/ratelimit.py delegates to."""
2471 < 2 +import pytest
2472 < 2 +
2473 < 2 +from app import quota
2474 < 2 +from app.quota import QuotaExceededError
2475 < 2 +
2476 < 2 +
2477 < 2 +def setup_function(_fn):
2478 < 2 +    quota.reset()
2479 < 2 +
2480 < 2 +
2481 < 2 +def test_quota_exceeded_error_is_an_exception_subclass():
2482 < 2 +    assert issubclass(QuotaExceededError, Exception)
2483 < 2 +
2484 < 2 +
2485 < 2 +def test_clock_starts_at_zero_and_advance_moves_it_forward():
2486 < 2 +    assert quota.now() == 0.0
2487 < 2 +    assert quota.advance(30) == 30.0
2488 < 2 +    assert quota.now() == 30.0
2489 < 2 +
2490 < 2 +
2491 < 2 +def test_advance_with_negative_seconds_raises_and_leaves_clock_unchanged():
2492 < 2 +    quota.advance(10)
2493 < 2 +    with pytest.raises(ValueError):
2494 < 2 +        quota.advance(-1)
2495 < 2 +    assert quota.now() == 10.0
2496 < 2 +
2497 < 2 +
2498 < 2 +def test_take_returns_in_window_count_then_raises_with_key_and_limit():
2499 < 2 +    assert quota.take("k", limit=2, window_seconds=60) == 1
2500 < 2 +    assert quota.take("k", limit=2, window_seconds=60) == 2
2501 < 2 +    with pytest.raises(QuotaExceededError) as exc_info:
2502 < 2 +        quota.take("k", limit=2, window_seconds=60)
2503 < 2 +    message = str(exc_info.value)
2504 < 2 +    assert "k" in message
2505 < 2 +    assert "2" in message
2506 < 2 +
2507 < 2 +
2508 < 2 +def test_window_pruning_ages_out_old_hits():
2509 < 2 +    quota.take("k", 2, 60)
2510 < 2 +    quota.take("k", 2, 60)
2511 < 2 +    quota.advance(61)
2512 < 2 +    assert quota.take("k", 2, 60) == 1
2513 < 2 +
2514 < 2 +    quota.reset()
2515 < 2 +    quota.advance(30)
2516 < 2 +    quota.take("hit30", 2, 60)
2517 < 2 +    quota.advance(31)  # now = 61
2518 < 2 +    assert quota.remaining("hit30", 1, 60) == 0
2519 < 2 +    quota.advance(30)  # now = 91
2520 < 2 +    assert quota.remaining("hit30", 1, 60) == 1
2521 < 2 +
2522 < 2 +
2523 < 2 +def test_infinite_window_never_prunes():
2524 < 2 +    quota.take("k", 1, float("inf"))
2525 < 2 +    with pytest.raises(QuotaExceededError):
2526 < 2 +        quota.take("k", 1, float("inf"))
2527 < 2 +    quota.advance(10**6)
2528 < 2 +    with pytest.raises(QuotaExceededError):
2529 < 2 +        quota.take("k", 1, float("inf"))
2530 < 2 +
2531 < 2 +
2532 < 2 +def test_burst_allows_extra_hits_burst_defaults_to_zero():
2533 < 2 +    quota.take("k", limit=2, window_seconds=60, burst=1)
2534 < 2 +    quota.take("k", limit=2, window_seconds=60, burst=1)
2535 < 2 +    quota.take("k", limit=2, window_seconds=60, burst=1)
2536 < 2 +    with pytest.raises(QuotaExceededError):
2537 < 2 +        quota.take("k", limit=2, window_seconds=60, burst=1)
