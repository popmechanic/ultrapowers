86 < 2 +++ b/app/audit_query.py
87 < 2 @@ -0,0 +1,254 @@
88 < 2 +"""Pure read-side queries over audit entry lists.
89 < 2 +
90 < 2 +Every function here takes a plain `entries` list (as produced by
91 < 2 +`app.audit.entries()`, but this module never imports `app.audit` and knows
92 < 2 +nothing about the live log) and returns a fresh value without mutating its
93 < 2 +input. Entry dicts always have exactly the three keys "method", "path",
94 < 2 +"actor".
95 < 2 +"""
96 < 2 +
97 < 2 +_FIELDS = ("method", "path", "actor")
98 < 2 +
99 < 2 +
100 < 2 +def _check_field(field):
101 < 2 +    if field not in _FIELDS:
102 < 2 +        raise ValueError("unknown field: %s" % field)
103 < 2 +
104 < 2 +
105 < 2 +def filter_entries(entries, method=None, path=None, actor=None):
106 < 2 +    """Return the copies of the entries matching every given criterion
107 < 2 +    (criteria not given are ignored); no criteria returns every entry."""
108 < 2 +    result = []
109 < 2 +    for e in entries:
110 < 2 +        if method is not None and e["method"] != method:
111 < 2 +            continue
112 < 2 +        if path is not None and e["path"] != path:
113 < 2 +            continue
114 < 2 +        if actor is not None and e["actor"] != actor:
115 < 2 +            continue
116 < 2 +        result.append(dict(e))
117 < 2 +    return result
118 < 2 +
119 < 2 +
120 < 2 +def counts_by(entries, field):
121 < 2 +    """Return {value: count} over `field` (one of method/path/actor)."""
122 < 2 +    _check_field(field)
123 < 2 +    counts = {}
124 < 2 +    for e in entries:
125 < 2 +        value = e[field]
126 < 2 +        counts[value] = counts.get(value, 0) + 1
127 < 2 +    return counts
128 < 2 +
129 < 2 +
130 < 2 +def last_n(entries, n):
131 < 2 +    """Return the final n entries (a copy), in order. n larger than the
132 < 2 +    list returns the whole list (a copy)."""
133 < 2 +    if n < 0:
134 < 2 +        raise ValueError("n must be >= 0")
135 < 2 +    if n == 0:
136 < 2 +        return []
137 < 2 +    return [dict(e) for e in entries[-n:]]
138 < 2 +
139 < 2 +
140 < 2 +def redact(entries, fields):
141 < 2 +    """Return new entry dicts with each name in `fields` replaced by
142 < 2 +    "***"; other keys untouched. `fields` must be a subset of
143 < 2 +    method/path/actor."""
144 < 2 +    for field in fields:
145 < 2 +        _check_field(field)
146 < 2 +    result = []
147 < 2 +    for e in entries:
148 < 2 +        copy = dict(e)
149 < 2 +        for field in fields:
150 < 2 +            copy[field] = "***"
151 < 2 +        result.append(copy)
152 < 2 +    return result
153 < 2 +
154 < 2 +
155 < 2 +def summary(entries):
156 < 2 +    """Return {"total", "by_method", "by_actor", "first", "last"} over
157 < 2 +    entries; first/last are copies of the first and last entry."""
158 < 2 +    if not entries:
159 < 2 +        return {"total": 0, "by_method": {}, "by_actor": {}, "first": None, "last": None}
160 < 2 +    return {
161 < 2 +        "total": len(entries),
162 < 2 +        "by_method": counts_by(entries, "method"),
163 < 2 +        "by_actor": counts_by(entries, "actor"),
164 < 2 +        "first": dict(entries[0]),
165 < 2 +        "last": dict(entries[-1]),
166 < 2 +    }
167 < 2 +
168 < 2 +
169 < 2 +def recent(entries, config):
170 < 2 +    """Return last_n(entries, config["audit_query_default_limit"])."""
171 < 2 +    return last_n(entries, config["audit_query_default_limit"])
172 < 2 +
173 < 2 +
174 < 2 +def paginate(entries, page, per_page):
175 < 2 +    """Return a 1-based page of entries: {"page", "pages", "total",
176 < 2 +    "items"}. "items" is always a copy."""
177 < 2 +    if page < 1:
178 < 2 +        raise ValueError("page must be >= 1")
179 < 2 +    if per_page < 1:
180 < 2 +        raise ValueError("per_page must be >= 1")
181 < 2 +    total = len(entries)
182 < 2 +    pages = (total + per_page - 1) // per_page if total else 0
183 < 2 +    start = (page - 1) * per_page
184 < 2 +    items = [dict(e) for e in entries[start:start + per_page]]
185 < 2 +    return {"page": page, "pages": pages, "total": total, "items": items}
186 < 2 +
187 < 2 +
188 < 2 +def to_report(entries):
189 < 2 +    """Render an exact plain-text report over entries."""
190 < 2 +    if not entries:
191 < 2 +        return "audit report\ntotal: %d" % len(entries)
192 < 2 +    by_method = counts_by(entries, "method")
193 < 2 +    by_actor = counts_by(entries, "actor")
194 < 2 +    lines = ["audit report", "total: %d" % len(entries), ""]
195 < 2 +    lines.append("by method:")
196 < 2 +    for value in sorted(by_method):
197 < 2 +        lines.append("  %s: %d" % (value, by_method[value]))
198 < 2 +    lines.append("")
199 < 2 +    lines.append("by actor:")
200 < 2 +    for value in sorted(by_actor):
201 < 2 +        lines.append("  %s: %d" % (value, by_actor[value]))
202 < 2 +    return "\n".join(lines)
203 < 2 +
204 < 2 +
205 < 2 +def to_csv_report(entries):
206 < 2 +    """Render an exact CSV report over entries: field,value,count rows."""
207 < 2 +    lines = ["field,value,count"]
208 < 2 +    if entries:
209 < 2 +        by_method = counts_by(entries, "method")
210 < 2 +        for value in sorted(by_method):
211 < 2 +            lines.append("method,%s,%d" % (value, by_method[value]))
212 < 2 +        by_actor = counts_by(entries, "actor")
213 < 2 +        for value in sorted(by_actor):
214 < 2 +            lines.append("actor,%s,%d" % (value, by_actor[value]))
215 < 2 +    return "\n".join(lines)
216 < 2 +
217 < 2 +
218 < 2 +def to_markdown_report(entries):
219 < 2 +    """Render an exact markdown pipe table over entries: field/value/count
220 < 2 +    rows in the same order as to_csv_report."""
221 < 2 +    lines = ["| field | value | count |", "| --- | --- | --- |"]
222 < 2 +    if entries:
223 < 2 +        by_method = counts_by(entries, "method")
224 < 2 +        for value in sorted(by_method):
225 < 2 +            lines.append("| method | %s | %d |" % (value, by_method[value]))
226 < 2 +        by_actor = counts_by(entries, "actor")
227 < 2 +        for value in sorted(by_actor):
228 < 2 +            lines.append("| actor | %s | %d |" % (value, by_actor[value]))
229 < 2 +    return "\n".join(lines)
230 < 2 +
231 < 2 +
232 < 2 +def top_actors(entries, n):
233 < 2 +    """Return [(actor, count), ...] sorted by count descending, ties
234 < 2 +    broken by actor ascending, truncated to n."""
235 < 2 +    if n < 0:
236 < 2 +        raise ValueError("n must be >= 0")
237 < 2 +    counts = counts_by(entries, "actor")
238 < 2 +    ordered = sorted(counts.items(), key=lambda pair: (-pair[1], pair[0]))
239 < 2 +    return ordered[:n]
240 < 2 +
241 < 2 +
242 < 2 +def merge_entries(*entry_lists):
243 < 2 +    """Return one new list concatenating the given entry lists, in
244 < 2 +    argument order, with copied entries."""
245 < 2 +    result = []
246 < 2 +    for entries in entry_lists:
247 < 2 +        result.extend(dict(e) for e in entries)
248 < 2 +    return result
249 < 2 +
250 < 2 +
251 < 2 +def diff_summaries(a, b):
252 < 2 +    """Return {"total", "by_method", "by_actor"} diffing two summary()
253 < 2 +    dicts: each sub-dict maps only values whose counts changed between a
254 < 2 +    and b to b_count - a_count (absent counts as 0; unchanged omitted)."""
255 < 2 +
256 < 2 +    def _diff(a_counts, b_counts):
257 < 2 +        diff = {}
258 < 2 +        for value in set(a_counts) | set(b_counts):
259 < 2 +            delta = b_counts.get(value, 0) - a_counts.get(value, 0)
260 < 2 +            if delta != 0:
261 < 2 +                diff[value] = delta
262 < 2 +        return diff
263 < 2 +
264 < 2 +    return {
265 < 2 +        "total": b["total"] - a["total"],
266 < 2 +        "by_method": _diff(a["by_method"], b["by_method"]),
267 < 2 +        "by_actor": _diff(a["by_actor"], b["by_actor"]),
268 < 2 +    }
269 < 2 +
270 < 2 +
271 < 2 +def counts_matrix(entries):
272 < 2 +    """Return the nested dict method -> actor -> count; only combinations
273 < 2 +    that occur appear."""
274 < 2 +    matrix = {}
275 < 2 +    for e in entries:
276 < 2 +        method = e["method"]
277 < 2 +        actor = e["actor"]
278 < 2 +        row = matrix.setdefault(method, {})
279 < 2 +        row[actor] = row.get(actor, 0) + 1
280 < 2 +    return matrix
281 < 2 +
282 < 2 +
283 < 2 +def rollup(entries, fields):
284 < 2 +    """Generalize counts_by / counts_matrix: nested counts by each field
285 < 2 +    in `fields`, in order. `fields` is a non-empty list of distinct names
286 < 2 +    drawn from method/path/actor."""
287 < 2 +    if not fields:
288 < 2 +        raise ValueError("fields must be non-empty")
289 < 2 +    seen = set()
290 < 2 +    for field in fields:
291 < 2 +        _check_field(field)
292 < 2 +        if field in seen:
293 < 2 +            raise ValueError("duplicate field: %s" % field)
294 < 2 +        seen.add(field)
295 < 2 +
296 < 2 +    result = {}
297 < 2 +    for e in entries:
298 < 2 +        node = result
299 < 2 +        for field in fields[:-1]:
300 < 2 +            node = node.setdefault(e[field], {})
301 < 2 +        last_field = fields[-1]
302 < 2 +        value = e[last_field]
303 < 2 +        node[value] = node.get(value, 0) + 1
304 < 2 +    return result
305 < 2 +
306 < 2 +
307 < 2 +def format_entry(entry):
308 < 2 +    """Return "<METHOD> <path> (<actor>)"; raises ValueError naming any of
309 < 2 +    the three keys missing from `entry`."""
310 < 2 +    for field in _FIELDS:
311 < 2 +        if field not in entry:
312 < 2 +            raise ValueError("missing field: %s" % field)
313 < 2 +    return "%s %s (%s)" % (entry["method"], entry["path"], entry["actor"])
314 < 2 +
315 < 2 +
316 < 2 +def to_lines(entries):
317 < 2 +    """Return [format_entry(e) for e in entries]."""
318 < 2 +    return [format_entry(e) for e in entries]
319 < 2 +
320 < 2 +
321 < 2 +def group_by(entries, field):
322 < 2 +    """Return {value: [entry copies]} grouping entries by `field`, in
323 < 2 +    original order within each group."""
324 < 2 +    _check_field(field)
325 < 2 +    groups = {}
326 < 2 +    for e in entries:
327 < 2 +        groups.setdefault(e[field], []).append(dict(e))
328 < 2 +    return groups
329 < 2 +
330 < 2 +
331 < 2 +def search(entries, needle):
332 < 2 +    """Return the entry copies where `needle` is a substring of any of the
333 < 2 +    three field values, in original order. Raises ValueError on an empty
334 < 2 +    needle."""
335 < 2 +    if not needle:
336 < 2 +        raise ValueError("needle must not be empty")
337 < 2 +    result = []
338 < 2 +    for e in entries:
339 < 2 +        if any(needle in e[field] for field in _FIELDS):
340 < 2 +            result.append(dict(e))
341 < 2 +    return result
342 < 2 diff --git a/app/backoff.py b/app/backoff.py
343 < 2 new file mode 100644
344 < 2 index 0000000..a7f8ed9
345 < 2 --- /dev/null
346 < 2 +++ b/app/backoff.py
347 < 2 @@ -0,0 +1,75 @@
348 < 2 +"""Deterministic retry-schedule calculator, built on `app.quota`.
349 < 2 +
350 < 2 +Pure functions only; no module state of its own.
351 < 2 +"""
352 < 2 +from app import quota
353 < 2 +
354 < 2 +
355 < 2 +class BackoffError(Exception):
356 < 2 +    """Raised for invalid backoff parameters."""
357 < 2 +
358 < 2 +
359 < 2 +def schedule(base, factor, retries):
360 < 2 +    """Return `[base * factor**i for i in range(retries)]` as floats."""
361 < 2 +    if base <= 0:
362 < 2 +        raise BackoffError("base must be positive, got %r" % (base,))
363 < 2 +    if factor < 1.0:
364 < 2 +        raise BackoffError("factor must be >= 1.0, got %r" % (factor,))
365 < 2 +    if retries < 0:
366 < 2 +        raise BackoffError("retries must be >= 0, got %r" % (retries,))
367 < 2 +    return [float(base * factor ** i) for i in range(retries)]
368 < 2 +
369 < 2 +
370 < 2 +def capped(seq, cap):
371 < 2 +    """Return a new list: the element-wise min of `seq` against `cap`."""
372 < 2 +    if cap <= 0:
373 < 2 +        raise BackoffError("cap must be positive, got %r" % (cap,))
374 < 2 +    return [min(x, cap) for x in seq]
375 < 2 +
376 < 2 +
377 < 2 +def total_wait(seq):
378 < 2 +    """The float sum of `seq`."""
379 < 2 +    return float(sum(seq))
380 < 2 +
381 < 2 +
382 < 2 +def next_delay(attempt, base, factor, cap):
383 < 2 +    """The delay for a single `attempt`: `min(base * factor**attempt, cap)`."""
384 < 2 +    if attempt < 0:
385 < 2 +        raise BackoffError("attempt must be >= 0, got %r" % (attempt,))
386 < 2 +    return min(base * factor ** attempt, cap)
387 < 2 +
388 < 2 +
389 < 2 +def delay_until_free(key, config):
390 < 2 +    """Read-only: seconds until `key` next has a free slot, per `config`."""
391 < 2 +    return quota.time_to_next_slot(
392 < 2 +        key,
393 < 2 +        config["rate_limit_max_per_window"],
394 < 2 +        config.get("rate_limit_window_seconds", 60),
395 < 2 +        burst=config.get("rate_limit_burst", 0),
396 < 2 +    )
397 < 2 +
398 < 2 +
399 < 2 +def retry_plan(key, config, retries):
400 < 2 +    """Read-only: a full retry plan for `key` combining current quota
401 < 2 +    state with a capped exponential backoff schedule."""
402 < 2 +    limit = config["rate_limit_max_per_window"]
403 < 2 +    window_seconds = config.get("rate_limit_window_seconds", 60)
404 < 2 +    burst = config.get("rate_limit_burst", 0)
405 < 2 +    immediate = quota.remaining(key, limit, window_seconds, burst=burst) > 0
406 < 2 +    wait = delay_until_free(key, config)
407 < 2 +    backoff = capped(
408 < 2 +        schedule(
409 < 2 +            config.get("backoff_base", 1.0),
410 < 2 +            config.get("backoff_factor", 2.0),
411 < 2 +            retries,
412 < 2 +        ),
413 < 2 +        config.get("backoff_cap", 60.0),
414 < 2 +    )
415 < 2 +    return {"immediate": immediate, "wait": wait, "backoff": backoff}
416 < 2 +
417 < 2 +
418 < 2 +def describe_schedule(seq):
419 < 2 +    """Render `seq` as a comma-joined, "s"-suffixed delay list."""
420 < 2 +    if not seq:
421 < 2 +        return "(no retries)"
422 < 2 +    return ", ".join("%ss" % (delay,) for delay in seq)
