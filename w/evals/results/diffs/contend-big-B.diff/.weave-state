970 < 2 +"""Multi-section report composer: several named record sets, each
971 < 2 +rendered through a chosen export format and assembled into one document.
972 < 2 +
973 < 2 +Imports app.export and app.colspec only. This is a NEW module -- the
974 < 2 +pre-existing app/report.py totals renderer and its /report route are
975 < 2 +untouched, and nothing here reuses its names from outside this module.
976 < 2 +"""
977 < 2 +from app import colspec
978 < 2 +from app import export
979 < 2 +
980 < 2 +
981 < 2 +class ReportError(Exception):
982 < 2 +    pass
983 < 2 +
984 < 2 +
985 < 2 +def section(title, records, fmt="md"):
986 < 2 +    if not title or not title.strip():
987 < 2 +        raise ReportError("empty section title")
988 < 2 +    if fmt not in export.FORMATS and fmt not in export.EXTRA_FORMATS:
989 < 2 +        raise ReportError(fmt)
990 < 2 +    return {"title": title, "records": records, "fmt": fmt}
991 < 2 +
992 < 2 +
993 < 2 +def render_section(sec):
994 < 2 +    title = sec["title"]
995 < 2 +    records = sec["records"]
996 < 2 +    if not records:
997 < 2 +        return "## " + title + "\n\n(no records)"
998 < 2 +    return "## " + title + "\n\n" + export.render_any(records, sec["fmt"])
999 < 2 +
1000 < 2 +
1001 < 2 +def _check_duplicate_titles(sections):
1002 < 2 +    seen = set()
1003 < 2 +    for sec in sections:
1004 < 2 +        title = sec["title"]
1005 < 2 +        if title in seen:
1006 < 2 +            raise ReportError(title)
1007 < 2 +        seen.add(title)
1008 < 2 +
1009 < 2 +
1010 < 2 +def render_report(title, sections):
1011 < 2 +    _check_duplicate_titles(sections)
1012 < 2 +    if not sections:
1013 < 2 +        return "# " + title + "\n\n(empty report)"
1014 < 2 +    rendered = [render_section(sec) for sec in sections]
1015 < 2 +    return "# " + title + "\n\n" + "\n\n".join(rendered)
1016 < 2 +
1017 < 2 +
1018 < 2 +def toc(sections):
1019 < 2 +    _check_duplicate_titles(sections)
1020 < 2 +    return [sec["title"] for sec in sections]
1021 < 2 +
1022 < 2 +
1023 < 2 +def record_counts(sections):
1024 < 2 +    return {sec["title"]: len(sec["records"]) for sec in sections}
1025 < 2 +
1026 < 2 +
1027 < 2 +def summary(sections):
1028 < 2 +    total = sum(len(sec["records"]) for sec in sections)
1029 < 2 +    return "%d sections, %d records" % (len(sections), total)
1030 < 2 +
1031 < 2 +
1032 < 2 +def render_index(sections):
1033 < 2 +    if not sections:
1034 < 2 +        return "(empty report)"
1035 < 2 +    lines = ["%d. %s (%d records)" % (i, sec["title"], len(sec["records"]))
1036 < 2 +              for i, sec in enumerate(sections, start=1)]
1037 < 2 +    return "\n".join(lines)
1038 < 2 +
1039 < 2 +
1040 < 2 +def projected_section(title, records, pairs, fmt="md"):
1041 < 2 +    return section(title, colspec.project(records, pairs), fmt)
1042 < 2 +
1043 < 2 +
1044 < 2 +def find_section(sections, title):
1045 < 2 +    for sec in sections:
1046 < 2 +        if sec["title"] == title:
1047 < 2 +            return sec
1048 < 2 +    raise ReportError(title)
1049 < 2 +
1050 < 2 +
1051 < 2 +def merge_reports(a, b):
1052 < 2 +    merged = list(a) + list(b)
1053 < 2 +    _check_duplicate_titles(merged)
1054 < 2 +    return merged
