2900 < 2 +def test_section_shape_and_title_and_fmt_validation():
2901 < 2 +    records = [{"a": 1}]
2902 < 2 +    sec = reportdoc.section("Alpha", records, fmt="csv")
2903 < 2 +    assert sec == {"title": "Alpha", "records": records, "fmt": "csv"}
2904 < 2 +    default_sec = reportdoc.section("Alpha", records)
2905 < 2 +    assert default_sec["fmt"] == "md"
2906 < 2 +    with pytest.raises(reportdoc.ReportError):
2907 < 2 +        reportdoc.section("", records)
2908 < 2 +    with pytest.raises(reportdoc.ReportError):
2909 < 2 +        reportdoc.section("   ", records)
2910 < 2 +    # "html" is an EXTRA_FORMATS format and is accepted here.
2911 < 2 +    reportdoc.section("Alpha", records, fmt="html")
2912 < 2 +    with pytest.raises(reportdoc.ReportError) as exc:
2913 < 2 +        reportdoc.section("Alpha", records, fmt="xml")
2914 < 2 +    assert "xml" in str(exc.value)
