1563 < 2 +def test_filter_entries_matches_actor_method_path_and_combines_and_copies():
1564 < 2 +    entries = _fixture()
1565 < 2 +    original = _fixture()
1566 < 2 +
1567 < 2 +    assert aq.filter_entries(entries, actor="alice") == [entries[0], entries[2]]
1568 < 2 +    assert aq.filter_entries(entries, method="POST") == [entries[1]]
1569 < 2 +    assert aq.filter_entries(entries, path="/records") == [entries[0], entries[1]]
