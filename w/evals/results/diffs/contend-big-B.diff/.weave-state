3080 < 2 +def test_widths_is_max_of_header_len_and_widest_cell_per_column():
3081 < 2 +    # "name" header (4 chars) is strictly wider than every cell in that
3082 < 2 +    # column ("Al", "Bo" -- both 2 chars): the header term wins, not tied.
3083 < 2 +    # "age" header (3 chars) is beaten by a cell ("100000", 6 chars): the
3084 < 2 +    # widest-cell term wins there.
3085 < 2 +    records = [{"name": "Al", "age": "100000"}, {"name": "Bo", "age": "2"}]
3086 < 2 +    cols = tabular.columns(records)
