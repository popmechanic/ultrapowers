3029 < 2 +def test_merge_reports_new_list_unmutated_inputs_and_shared_dup_check():
3030 < 2 +    sec_a = reportdoc.section("Alpha", [{"a": 1}], fmt="csv")
3031 < 2 +    sec_b = reportdoc.section("Beta", [{"b": 2}, {"b": 3}], fmt="csv")
