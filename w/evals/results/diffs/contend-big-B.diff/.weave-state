2998 < 2 +def test_projected_section_delegates_to_colspec_project_end_to_end():
2999 < 2 +    pairs = colspec.parse_colspec("a:A")
3000 < 2 +    records = [{"a": 1, "b": 2}]
3001 < 2 +    calls = []
3002 < 2 +    real_project = colspec.project
3003 < 2 +
3004 < 2 +    def recorder(recs, pairs_arg):
3005 < 2 +        calls.append((recs, pairs_arg))
3006 < 2 +        return real_project(recs, pairs_arg)
3007 < 2 +
3008 < 2 +    original = colspec.project
3009 < 2 +    colspec.project = recorder
3010 < 2 +    try:
3011 < 2 +        sec = reportdoc.projected_section("T", records, pairs, "csv")
3012 < 2 +    finally:
3013 < 2 +        colspec.project = original
3014 < 2 +    assert calls == [(records, pairs)]
3015 < 2 +    assert sec == {"title": "T", "records": [{"A": 1}], "fmt": "csv"}
3016 < 2 +    assert reportdoc.render_section(sec) == "## T\n\nA\n1"
