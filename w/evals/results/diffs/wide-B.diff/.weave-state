174 < 2 diff --git a/textkit/ngrams.py b/textkit/ngrams.py
175 < 2 new file mode 100644
176 < 2 index 0000000..570f399
177 < 2 --- /dev/null
178 < 2 +++ b/textkit/ngrams.py
179 < 2 @@ -0,0 +1,8 @@
180 < 2 +def ngrams(tokens, n):
181 < 2 +    """Return a list of tuples of n consecutive tokens.
182 < 2 +
183 < 2 +    Raises ValueError when n < 1. Returns [] when n > len(tokens).
184 < 2 +    """
185 < 2 +    if n < 1:
186 < 2 +        raise ValueError("n must be >= 1")
187 < 2 +    return [tuple(tokens[i : i + n]) for i in range(len(tokens) - n + 1)]
188 < 2 diff --git a/textkit/redact.py b/textkit/redact.py
189 < 2 new file mode 100644
190 < 2 index 0000000..c2a7ee4
191 < 2 --- /dev/null
192 < 2 +++ b/textkit/redact.py
193 < 2 @@ -0,0 +1,16 @@
194 < 2 +import re
195 < 2 +
196 < 2 +
197 < 2 +def redact(text, words):
198 < 2 +    """Replace each whole-word, case-insensitive occurrence of any word in
199 < 2 +    `words` with "*" repeated to the match's length."""
200 < 2 +    words = list(words)
201 < 2 +    if not words:
202 < 2 +        return text
203 < 2 +
204 < 2 +    pattern = r"\b(?:" + "|".join(re.escape(word) for word in words) + r")\b"
205 < 2 +
206 < 2 +    def _replace(match):
207 < 2 +        return "*" * len(match.group(0))
208 < 2 +
209 < 2 +    return re.sub(pattern, _replace, text, flags=re.IGNORECASE)
