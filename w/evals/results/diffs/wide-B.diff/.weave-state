216 < 2 +def reverse_words(text):
217 < 2 +    """Split on whitespace, reverse the word order, join with single spaces."""
218 < 2 +    return " ".join(reversed(text.split()))
219 < 2 diff --git a/textkit/titlecase.py b/textkit/titlecase.py
220 < 2 new file mode 100644
221 < 2 index 0000000..982bf7b
222 < 2 --- /dev/null
223 < 2 +++ b/textkit/titlecase.py
224 < 2 @@ -0,0 +1,19 @@
225 < 2 +MINOR_WORDS = {"a", "an", "and", "as", "at", "but", "by", "for", "in", "of", "on", "or", "the", "to"}
226 < 2 +
227 < 2 +
228 < 2 +def titlecase(text):
229 < 2 +    """Title-case text, lowercasing minor words except first/last word."""
230 < 2 +    words = text.split()
231 < 2 +    if not words:
232 < 2 +        return ""
233 < 2 +
234 < 2 +    last_index = len(words) - 1
235 < 2 +    result = []
236 < 2 +    for index, word in enumerate(words):
237 < 2 +        lower = word.lower()
238 < 2 +        if index in (0, last_index) or lower not in MINOR_WORDS:
239 < 2 +            result.append(lower[:1].upper() + lower[1:])
240 < 2 +        else:
241 < 2 +            result.append(lower)
242 < 2 +
243 < 2 +    return " ".join(result)
244 < 2 diff --git a/textkit/truncate.py b/textkit/truncate.py
245 < 2 new file mode 100644
246 < 2 index 0000000..ac05880
247 < 2 --- /dev/null
248 < 2 +++ b/textkit/truncate.py
249 < 2 @@ -0,0 +1,16 @@
250 < 2 +def truncate(text, limit, ellipsis="..."):
251 < 2 +    """Truncate text to at most limit characters, appending ellipsis if cut short.
252 < 2 +
253 < 2 +    If text already fits within limit, it is returned unchanged. Otherwise the
254 < 2 +    text is cut so that the result (including the ellipsis) fits within limit,
255 < 2 +    trailing whitespace before the ellipsis is stripped.
256 < 2 +
257 < 2 +    Raises ValueError if limit is smaller than the length of the ellipsis.
258 < 2 +    """
259 < 2 +    if limit < len(ellipsis):
260 < 2 +        raise ValueError("limit must be at least as long as the ellipsis")
261 < 2 +
262 < 2 +    if len(text) <= limit:
263 < 2 +        return text
264 < 2 +
265 < 2 +    return text[: limit - len(ellipsis)].rstrip() + ellipsis
266 < 2 diff --git a/textkit/word_count.py b/textkit/word_count.py
267 < 2 new file mode 100644
268 < 2 index 0000000..5d9eac6
269 < 2 --- /dev/null
270 < 2 +++ b/textkit/word_count.py
271 < 2 @@ -0,0 +1,12 @@
272 < 2 +import re
273 < 2 +
274 < 2 +
275 < 2 +def word_count(text):
276 < 2 +    """Return a dict mapping each word to its count.
277 < 2 +
278 < 2 +    Words are maximal runs matching [a-z0-9]+ after lowercasing the input.
279 < 2 +    """
280 < 2 +    counts = {}
281 < 2 +    for word in re.findall(r"[a-z0-9]+", text.lower()):
282 < 2 +        counts[word] = counts.get(word, 0) + 1
283 < 2 +    return counts
