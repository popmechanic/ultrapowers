69 < 2 diff --git a/ledger/parse.py b/ledger/parse.py
70 < 2 new file mode 100644
71 < 2 index 0000000..f230231
72 < 2 --- /dev/null
73 < 2 +++ b/ledger/parse.py
74 < 2 @@ -0,0 +1,24 @@
75 < 2 +import re
76 < 2 +
77 < 2 +from ledger.model import Entry
78 < 2 +
79 < 2 +_AMOUNT_RE = re.compile(r"-?\d+\.\d{2}")
80 < 2 +
81 < 2 +
82 < 2 +def parse_line(line: str) -> Entry:
83 < 2 +    fields = line.split("|")
84 < 2 +    if len(fields) != 3:
85 < 2 +        raise ValueError("bad line")
86 < 2 +
87 < 2 +    date, description, amount = fields
88 < 2 +
89 < 2 +    if not _AMOUNT_RE.fullmatch(amount):
90 < 2 +        raise ValueError("bad amount")
91 < 2 +
92 < 2 +    sign = -1 if amount.startswith("-") else 1
93 < 2 +    digits = amount.lstrip("-").replace(".", "")
94 < 2 +    amount_cents = sign * int(digits)
95 < 2 +
96 < 2 +    entry = Entry(date=date, description=description, amount_cents=amount_cents)
97 < 2 +    entry.validate()
98 < 2 +    return entry
99 < 2 diff --git a/ledger/report.py b/ledger/report.py
100 < 2 new file mode 100644
101 < 2 index 0000000..8c75410
102 < 2 --- /dev/null
103 < 2 +++ b/ledger/report.py
104 < 2 @@ -0,0 +1,21 @@
105 < 2 +from typing import List
106 < 2 +
107 < 2 +from ledger.balance import running_balance
108 < 2 +from ledger.model import Entry
109 < 2 +
110 < 2 +
111 < 2 +def format_cents(cents: int) -> str:
112 < 2 +    sign = "-" if cents < 0 else ""
113 < 2 +    dollars, remainder = divmod(abs(cents), 100)
114 < 2 +    return f"{sign}${dollars}.{remainder:02d}"
115 < 2 +
116 < 2 +
117 < 2 +def format_report(entries: List[Entry]) -> str:
118 < 2 +    lines = [
119 < 2 +        f"{entry.date} {entry.description} {format_cents(entry.amount_cents)}"
120 < 2 +        for entry in entries
121 < 2 +    ]
122 < 2 +    balances = running_balance(entries)
123 < 2 +    total = balances[-1] if balances else 0
124 < 2 +    lines.append(f"TOTAL {format_cents(total)}")
125 < 2 +    return "\n".join(lines)
