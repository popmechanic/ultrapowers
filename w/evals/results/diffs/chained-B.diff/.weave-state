4 < 2 +++ b/ledger/balance.py
5 < 2 @@ -0,0 +1,21 @@
6 < 2 +def running_balance(entries):
7 < 2 +    """Calculate running balance from a list of entries.
8 < 2 +
9 < 2 +    Args:
10 < 2 +        entries: A list of Entry objects with amount_cents attribute.
11 < 2 +
12 < 2 +    Returns:
13 < 2 +        A list of cumulative sums of amount_cents. Empty list if entries is empty.
14 < 2 +
15 < 2 +    Example:
16 < 2 +        >>> running_balance([Entry(..., amount_cents=1000), Entry(..., amount_cents=-450)])
17 < 2 +        [1000, 550]
18 < 2 +    """
19 < 2 +    result = []
20 < 2 +    cumulative = 0
21 < 2 +
22 < 2 +    for entry in entries:
23 < 2 +        cumulative += entry.amount_cents
24 < 2 +        result.append(cumulative)
25 < 2 +
26 < 2 +    return result
27 < 2 diff --git a/ledger/cli.py b/ledger/cli.py
28 < 2 new file mode 100644
29 < 2 index 0000000..9d13770
30 < 2 --- /dev/null
31 < 2 +++ b/ledger/cli.py
32 < 2 @@ -0,0 +1,50 @@
33 < 2 +import sys
34 < 2 +from ledger.parse import parse_line
35 < 2 +from ledger.report import format_report
36 < 2 +
37 < 2 +
38 < 2 +def main(argv):
39 < 2 +    """Main CLI entry point for the ledger application.
40 < 2 +
41 < 2 +    Args:
42 < 2 +        argv: A list where the first element is a path to a ledger file.
43 < 2 +
44 < 2 +    Returns:
45 < 2 +        0 on success, 1 on error.
46 < 2 +
47 < 2 +    Behavior:
48 < 2 +        - Reads the file specified in argv[0]
49 < 2 +        - Skips blank (whitespace-only) lines
50 < 2 +        - Parses each remaining line using parse_line()
51 < 2 +        - Prints the formatted report to stdout
52 < 2 +        - On any ValueError, prints "error: {message}" to stderr
53 < 2 +    """
54 < 2 +    # Get the ledger file path from argv
55 < 2 +    ledger_file = argv[0]
56 < 2 +
57 < 2 +    try:
58 < 2 +        # Read the file
59 < 2 +        with open(ledger_file, 'r') as f:
60 < 2 +            lines = f.readlines()
61 < 2 +
62 < 2 +        # Parse entries, skipping blank lines
63 < 2 +        entries = []
64 < 2 +        for line in lines:
65 < 2 +            # Skip blank (whitespace-only) lines
66 < 2 +            if not line.strip():
67 < 2 +                continue
68 < 2 +
69 < 2 +            # Parse the line
70 < 2 +            entry = parse_line(line.rstrip('\n'))
71 < 2 +            entries.append(entry)
72 < 2 +
73 < 2 +        # Format and print the report
74 < 2 +        report = format_report(entries)
75 < 2 +        print(report)
76 < 2 +
77 < 2 +        return 0
78 < 2 +
79 < 2 +    except ValueError as e:
80 < 2 +        # Print error message to stderr
81 < 2 +        print(f"error: {e}", file=sys.stderr)
82 < 2 +        return 1
83 < 2 diff --git a/ledger/model.py b/ledger/model.py
84 < 2 index d927cd3..a796132 100644
85 < 2 --- a/ledger/model.py
86 < 2 +++ b/ledger/model.py
87 < 2 @@ -1,4 +1,5 @@
88 < 2  from dataclasses import dataclass
89 < 2 +import re
90 < 2  
91 < 2  
92 < 2  @dataclass
93 < 2 @@ -6,3 +7,20 @@ class Entry:
94 < 2      date: str
95 < 2      description: str
96 < 2      amount_cents: int
97 < 2 +
98 < 2 +    def validate(self):
99 < 2 +        """Validate the entry.
100 < 2 +
101 < 2 +        Raises:
102 < 2 +            ValueError: If description is empty or date format is invalid.
103 < 2 +
104 < 2 +        Returns:
105 < 2 +            None on success.
106 < 2 +        """
107 < 2 +        if not self.description.strip():
108 < 2 +            raise ValueError("empty description")
109 < 2 +
110 < 2 +        if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', self.date):
111 < 2 +            raise ValueError("bad date")
112 < 2 +
113 < 2 +        return None
114 < 2 diff --git a/ledger/parse.py b/ledger/parse.py
115 < 2 new file mode 100644
116 < 2 index 0000000..37a599e
117 < 2 --- /dev/null
118 < 2 +++ b/ledger/parse.py
119 < 2 @@ -0,0 +1,41 @@
120 < 2 +import re
121 < 2 +from decimal import Decimal
122 < 2 +
123 < 2 +from ledger.model import Entry
124 < 2 +
125 < 2 +
126 < 2 +def parse_line(line):
127 < 2 +    """Parse a ledger line into an Entry object.
128 < 2 +
129 < 2 +    Args:
130 < 2 +        line: A string in format "DATE|DESCRIPTION|AMOUNT"
131 < 2 +
132 < 2 +    Returns:
133 < 2 +        Entry: A validated Entry object
134 < 2 +
135 < 2 +    Raises:
136 < 2 +        ValueError: If the line format is invalid, amount format is invalid,
137 < 2 +                    or the entry fails validation.
138 < 2 +    """
139 < 2 +    # Split on '|'
140 < 2 +    parts = line.split('|')
141 < 2 +
142 < 2 +    # Check for exactly 3 fields
143 < 2 +    if len(parts) != 3:
144 < 2 +        raise ValueError("bad line")
145 < 2 +
146 < 2 +    date, description, amount_str = parts
147 < 2 +
148 < 2 +    # Validate amount format: -?\d+\.\d{2}
149 < 2 +    if not re.fullmatch(r'-?\d+\.\d{2}', amount_str):
150 < 2 +        raise ValueError("bad amount")
151 < 2 +
152 < 2 +    # Convert dollars to cents (as integer). Use Decimal to avoid IEEE-754
153 < 2 +    # float rounding errors (e.g. "0.29" -> 28 instead of 29).
154 < 2 +    amount_cents = int(Decimal(amount_str) * 100)
155 < 2 +
156 < 2 +    # Create Entry and validate
157 < 2 +    entry = Entry(date=date, description=description, amount_cents=amount_cents)
158 < 2 +    entry.validate()
159 < 2 +
160 < 2 +    return entry
161 < 2 diff --git a/ledger/report.py b/ledger/report.py
162 < 2 new file mode 100644
163 < 2 index 0000000..bce9840
164 < 2 --- /dev/null
165 < 2 +++ b/ledger/report.py
166 < 2 @@ -0,0 +1,71 @@
167 < 2 +from ledger.balance import running_balance
168 < 2 +
169 < 2 +
170 < 2 +def format_cents(cents):
171 < 2 +    """Format an amount in cents as a dollar string.
172 < 2 +
173 < 2 +    Args:
174 < 2 +        cents: Integer amount in cents.
175 < 2 +
176 < 2 +    Returns:
177 < 2 +        Formatted string like "$10.00", "-$4.50", or "$0.00".
178 < 2 +
179 < 2 +    Examples:
180 < 2 +        >>> format_cents(1000)
181 < 2 +        '$10.00'
182 < 2 +        >>> format_cents(-450)
183 < 2 +        '-$4.50'
184 < 2 +        >>> format_cents(0)
185 < 2 +        '$0.00'
186 < 2 +    """
187 < 2 +    # Convert cents to dollars
188 < 2 +    dollars = cents / 100.0
189 < 2 +
190 < 2 +    # Handle negative amounts
191 < 2 +    if dollars < 0:
192 < 2 +        return f"-${abs(dollars):.2f}"
193 < 2 +    else:
194 < 2 +        return f"${dollars:.2f}"
195 < 2 +
196 < 2 +
197 < 2 +def format_report(entries):
198 < 2 +    """Format a report from a list of entries.
199 < 2 +
200 < 2 +    Args:
201 < 2 +        entries: A list of Entry objects.
202 < 2 +
203 < 2 +    Returns:
204 < 2 +        Formatted report string with one line per entry and a total line.
205 < 2 +        Lines are joined with "\n", no trailing newline.
206 < 2 +
207 < 2 +    Example:
208 < 2 +        >>> entries = [
209 < 2 +        ...     Entry(date="2026-01-15", description="coffee", amount_cents=-450),
210 < 2 +        ...     Entry(date="2026-01-16", description="salary", amount_cents=500000),
211 < 2 +        ... ]
212 < 2 +        >>> print(format_report(entries))
213 < 2 +        2026-01-15 coffee -$4.50
214 < 2 +        2026-01-16 salary $5000.00
215 < 2 +        TOTAL $4995.50
216 < 2 +    """
217 < 2 +    lines = []
218 < 2 +
219 < 2 +    # Format each entry
220 < 2 +    for entry in entries:
221 < 2 +        formatted_amount = format_cents(entry.amount_cents)
222 < 2 +        line = f"{entry.date} {entry.description} {formatted_amount}"
223 < 2 +        lines.append(line)
224 < 2 +
225 < 2 +    # Calculate total using running_balance
226 < 2 +    if entries:
227 < 2 +        balances = running_balance(entries)
228 < 2 +        total = balances[-1]  # Get the last (final) balance
229 < 2 +    else:
230 < 2 +        total = 0
231 < 2 +
232 < 2 +    # Add total line
233 < 2 +    formatted_total = format_cents(total)
234 < 2 +    lines.append(f"TOTAL {formatted_total}")
235 < 2 +
236 < 2 +    # Join with newline, no trailing newline
237 < 2 +    return "\n".join(lines)
