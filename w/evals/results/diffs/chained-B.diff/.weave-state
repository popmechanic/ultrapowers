782 < 2 +        "2026-01",        # missing day
783 < 2 +        "01-15",          # missing year
784 < 2 +        "2026-01-15-01",  # extra component
785 < 2 +        "not-a-date",     # invalid
786 < 2 +        "",               # empty
787 < 2 +    ]
788 < 2 +    for bad_date in bad_dates:
