577 < 2 +    def test_all_cents_convert_exactly(self):
578 < 2 +        """Every two-decimal amount in a range must convert to exact cents."""
579 < 2 +        for cents in range(-100000, 100001):
580 < 2 +            sign = "-" if cents < 0 else ""
581 < 2 +            whole, frac = divmod(abs(cents), 100)
582 < 2 +            amount_str = f"{sign}{whole}.{frac:02d}"
583 < 2 +            result = parse_line(f"2026-01-15|x|{amount_str}")
584 < 2 +            assert result.amount_cents == cents, amount_str
