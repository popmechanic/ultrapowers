90 < 2 +++ b/apistub/validate.py
91 < 2 @@ -0,0 +1,14 @@
92 < 2 +from apistub import schema
93 < 2 +
94 < 2 +
95 < 2 +def validate_payload(payload):
96 < 2 +    errors = []
97 < 2 +    for key, typ in schema.FIELDS.items():
98 < 2 +        if key not in payload:
99 < 2 +            errors.append(f"missing: {key}")
100 < 2 +        elif not isinstance(payload[key], typ):
101 < 2 +            errors.append(f"wrong type: {key}")
102 < 2 +    email = payload.get("email")
103 < 2 +    if isinstance(email, str) and "@" not in email:
104 < 2 +        errors.append("invalid: email")
105 < 2 +    return errors
