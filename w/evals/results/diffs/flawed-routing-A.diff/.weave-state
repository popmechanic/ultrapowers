116 < 2 +
117 < 2 +
118 < 2 +def test_post_and_get():
119 < 2 +    s = InMemoryStore()
120 < 2 +    code, body = route(s, "POST", "/users", {"name": "Ada", "email": "ada@ex.com"})
121 < 2 +    assert code == 201 and json.loads(body)["id"] == 1
122 < 2 +    code, body = route(s, "GET", "/users/1", None)
123 < 2 +    assert code == 200 and json.loads(body)["name"] == "Ada"
124 < 2 +    assert route(s, "GET", "/users/9", None) == (404, "{}")
125 < 2 +
126 < 2 +
