63 < 2 +++ b/apistub/store.py
64 < 2 @@ -0,0 +1,21 @@
65 < 2 +from apistub.schema import User
66 < 2 +
67 < 2 +SCHEMA_VERSION = 1  # wire schema version embedded by serialization
68 < 2 +
69 < 2 +
70 < 2 +class InMemoryStore:
71 < 2 +    def __init__(self):
72 < 2 +        self._users = {}
73 < 2 +        self._next = 1
74 < 2 +
75 < 2 +    def add(self, name, email):
76 < 2 +        user = User(self._next, name, email)
77 < 2 +        self._users[self._next] = user
78 < 2 +        self._next += 1
79 < 2 +        return user
80 < 2 +
81 < 2 +    def get(self, user_id):
82 < 2 +        return self._users.get(user_id)
83 < 2 +
84 < 2 +    def all(self):
85 < 2 +        return list(self._users.values())
