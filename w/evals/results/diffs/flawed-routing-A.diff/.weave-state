6 < 2 +import json
7 < 2 +
8 < 2 +from apistub.serialize import to_json
9 < 2 +from apistub.validate import validate_payload
10 < 2 +
11 < 2 +
12 < 2 +def route(store, method, path, payload):
13 < 2 +    if method == "POST" and path == "/users":
14 < 2 +        errors = validate_payload(payload or {})
15 < 2 +        if errors:
16 < 2 +            return 400, json.dumps({"errors": errors})
17 < 2 +        return 201, to_json(store.add(payload["name"], payload["email"]))
18 < 2 +    if method == "GET" and path.startswith("/users/"):
19 < 2 +        user = store.get(int(path.rsplit("/", 1)[1]))
20 < 2 +        return (200, to_json(user)) if user else (404, "{}")
21 < 2 +    return 405, "{}"
