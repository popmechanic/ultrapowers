2667 < 2 +def test_time_to_next_slot_reports_seconds_until_a_slot_frees():
2668 < 2 +    quota.reset()
2669 < 2 +    assert quota.time_to_next_slot("k", 2, 60) == 0.0
2670 < 2 +    quota.take("k", 2, 60)
2671 < 2 +    quota.take("k", 2, 60)
2672 < 2 +    assert quota.time_to_next_slot("k", 2, 60) == 60.0
2673 < 2 +    quota.advance(10)
2674 < 2 +    assert quota.time_to_next_slot("k", 2, 60) == 50.0
2675 < 2 +
2676 < 2 +    # Exhausted under an infinite window: never frees.
2677 < 2 +    quota.reset()
2678 < 2 +    quota.take("inf", 1, INF)
2679 < 2 +    assert quota.time_to_next_slot("inf", 1, INF) == INF
2680 < 2 +
2681 < 2 +    # A zero allowance can never record a hit, so no slot ever frees —
2682 < 2 +    # and it must not crash on an empty hit list.
2683 < 2 +    quota.reset()
2684 < 2 +    assert quota.time_to_next_slot("k", 0, 60) == INF
2685 < 2 +
2686 < 2 +    # Boundary: at exactly now - window the hit is still in-window, so the
2687 < 2 +    # reading is 0.0 while the take still raises.
2688 < 2 +    quota.reset()
2689 < 2 +    quota.take("edge", 2, 60)
2690 < 2 +    quota.take("edge", 2, 60)
2691 < 2 +    quota.advance(60)
2692 < 2 +    assert quota.time_to_next_slot("edge", 2, 60) == 0.0
2693 < 2 +    with pytest.raises(quota.QuotaExceededError):
2694 < 2 +        quota.take("edge", 2, 60)
2695 < 2 +
2696 < 2 +
2697 < 2 +def test_usage_reports_the_full_state_and_records_nothing():
2698 < 2 +    quota.reset()
2699 < 2 +    assert quota.usage("k", 2, 60) == {
2700 < 2 +        "used": 0, "allowed": 2, "remaining": 2, "reset_in": 0.0}
2701 < 2 +    quota.take("k", 2, 60)
2702 < 2 +    assert quota.usage("k", 2, 60) == {
2703 < 2 +        "used": 1, "allowed": 2, "remaining": 1, "reset_in": 0.0}
2704 < 2 +    quota.take("k", 2, 60)
2705 < 2 +    quota.advance(10)
2706 < 2 +    assert quota.usage("k", 2, 60) == {
2707 < 2 +        "used": 2, "allowed": 2, "remaining": 0, "reset_in": 50.0}
2708 < 2 +    assert quota.usage("k", 2, 60, burst=1) == {
2709 < 2 +        "used": 2, "allowed": 3, "remaining": 1, "reset_in": 0.0}
2710 < 2 +    assert quota.take("k", 2, 60, burst=1) == 3
