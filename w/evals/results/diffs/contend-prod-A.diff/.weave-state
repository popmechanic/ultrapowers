3653 < 2 +
3654 < 2 +
3655 < 2 +def test_enforce_end_to_end_recovers_after_the_window():
3656 < 2 +    quota.reset()
3657 < 2 +    assert throttle.enforce("POST", "/records", "mallory", ONE_PER_WINDOW) == 1
3658 < 2 +    with pytest.raises(throttle.PolicyError):
