109 < 2 @@ -0,0 +1,269 @@
110 < 2 +"""Pure read side over lists of audit entries.
111 < 2 +
112 < 2 +Every function here takes the entries as a plain list argument, never
113 < 2 +mutates that list or the dicts inside it, and returns fresh objects the
114 < 2 +caller may freely mutate. Nothing is imported from `app.audit`: this module
115 < 2 +holds no state and knows nothing about where the entries came from, so the
116 < 2 +same helpers serve a live log, an `export_state()` snapshot, or a fixture.
117 < 2 +
118 < 2 +An entry is `{"method": ..., "path": ..., "actor": ...}`; those three names
119 < 2 +in `FIELDS` are the only ones any field argument may name — anything else
120 < 2 +is a ValueError naming the offending field.
121 < 2 +
122 < 2 +The renderers (`to_report`, `to_csv_report`, `to_markdown_report`) all sort
123 < 2 +each section's values alphabetically and derive their numbers from
124 < 2 +`counts_by`, so no renderer ever re-counts entries itself.
125 < 2 +"""
126 < 2 +
127 < 2 +FIELDS = ("method", "path", "actor")
128 < 2 +
129 < 2 +REDACTED = "***"
130 < 2 +
131 < 2 +
132 < 2 +def _check_field(field):
133 < 2 +    """Raise ValueError naming `field` unless it is one of FIELDS."""
134 < 2 +    if field not in FIELDS:
135 < 2 +        raise ValueError("unknown audit field: %s" % field)
136 < 2 +    return field
137 < 2 +
138 < 2 +
139 < 2 +def _copies(entries):
140 < 2 +    """A new list of new dicts — the shape every function here returns."""
141 < 2 +    return [dict(entry) for entry in entries]
142 < 2 +
143 < 2 +
144 < 2 +def filter_entries(entries, actor=None, method=None, path=None):
145 < 2 +    """The entries matching every criterion given, in original order.
146 < 2 +
147 < 2 +    Criteria left as None are not applied, so no criteria at all matches
148 < 2 +    everything. The result is a fresh list of fresh entry dicts."""
149 < 2 +    criteria = [(name, value) for name, value in
150 < 2 +                (("actor", actor), ("method", method), ("path", path))
151 < 2 +                if value is not None]
152 < 2 +    return _copies(
153 < 2 +        entry for entry in entries
154 < 2 +        if all(entry.get(name) == value for name, value in criteria)
155 < 2 +    )
156 < 2 +
157 < 2 +
158 < 2 +def counts_by(entries, field):
159 < 2 +    """How many entries carry each distinct value of `field`."""
160 < 2 +    _check_field(field)
161 < 2 +    counts = {}
162 < 2 +    for entry in entries:
163 < 2 +        value = entry[field]
164 < 2 +        counts[value] = counts.get(value, 0) + 1
165 < 2 +    return counts
166 < 2 +
167 < 2 +
168 < 2 +def counts_matrix(entries):
169 < 2 +    """Counts nested method -> actor. Only pairs that occur appear; there
170 < 2 +    are no zero-filled cells."""
171 < 2 +    matrix = {}
172 < 2 +    for entry in entries:
173 < 2 +        by_actor = matrix.setdefault(entry["method"], {})
174 < 2 +        actor = entry["actor"]
175 < 2 +        by_actor[actor] = by_actor.get(actor, 0) + 1
176 < 2 +    return matrix
177 < 2 +
178 < 2 +
179 < 2 +def rollup(entries, fields):
180 < 2 +    """Counts nested by each name in `fields`, outermost first.
181 < 2 +
182 < 2 +    `fields` must be a non-empty list of distinct FIELDS names, so
183 < 2 +    `rollup(entries, ["method"])` is `counts_by(entries, "method")` and
184 < 2 +    `rollup(entries, ["method", "actor"])` is `counts_matrix(entries)`."""
185 < 2 +    if not fields:
186 < 2 +        raise ValueError("rollup needs at least one field")
187 < 2 +    seen = []
188 < 2 +    for field in fields:
189 < 2 +        _check_field(field)
190 < 2 +        if field in seen:
191 < 2 +            raise ValueError("duplicate audit field: %s" % field)
192 < 2 +        seen.append(field)
193 < 2 +
194 < 2 +    counts = {}
195 < 2 +    for entry in entries:
196 < 2 +        level = counts
197 < 2 +        for field in fields[:-1]:
198 < 2 +            level = level.setdefault(entry[field], {})
199 < 2 +        last = entry[fields[-1]]
200 < 2 +        level[last] = level.get(last, 0) + 1
201 < 2 +    return counts
202 < 2 +
203 < 2 +
204 < 2 +def last_n(entries, n):
205 < 2 +    """The final `n` entries in order, as copies. `n` past the end returns
206 < 2 +    them all; `n` of 0 returns []. A negative `n` is a ValueError."""
207 < 2 +    if n < 0:
208 < 2 +        raise ValueError("n must not be negative: %s" % n)
209 < 2 +    if n == 0:
210 < 2 +        return []
211 < 2 +    return _copies(entries[-n:])
212 < 2 +
213 < 2 +
214 < 2 +def redact(entries, fields):
215 < 2 +    """Copies of the entries with each named field replaced by "***".
216 < 2 +
217 < 2 +    The originals keep their real values; `fields` may be empty, which just
218 < 2 +    copies. Every name must be one of FIELDS."""
219 < 2 +    for field in fields:
220 < 2 +        _check_field(field)
221 < 2 +    redacted = _copies(entries)
222 < 2 +    for entry in redacted:
223 < 2 +        for field in fields:
224 < 2 +            entry[field] = REDACTED
225 < 2 +    return redacted
226 < 2 +
227 < 2 +
228 < 2 +def summary(entries):
229 < 2 +    """Totals, the method/actor breakdowns, and copies of the first and
230 < 2 +    last entries (both None when there are no entries)."""
231 < 2 +    return {
232 < 2 +        "total": len(entries),
233 < 2 +        "by_method": counts_by(entries, "method"),
234 < 2 +        "by_actor": counts_by(entries, "actor"),
235 < 2 +        "first": dict(entries[0]) if entries else None,
236 < 2 +        "last": dict(entries[-1]) if entries else None,
237 < 2 +    }
238 < 2 +
239 < 2 +
240 < 2 +def recent(entries, config):
241 < 2 +    """The last `config["audit_query_default_limit"]` entries."""
242 < 2 +    return last_n(entries, config["audit_query_default_limit"])
243 < 2 +
244 < 2 +
245 < 2 +def paginate(entries, page, per_page):
246 < 2 +    """One 1-based page of entries plus its metadata.
247 < 2 +
248 < 2 +    Returns `{"page", "pages", "total", "items"}`; a page past the end is
249 < 2 +    not an error, it just has no items. `page` and `per_page` must both be
250 < 2 +    at least 1."""
251 < 2 +    if page < 1:
252 < 2 +        raise ValueError("page must be at least 1: %s" % page)
253 < 2 +    if per_page < 1:
254 < 2 +        raise ValueError("per_page must be at least 1: %s" % per_page)
255 < 2 +    total = len(entries)
256 < 2 +    start = (page - 1) * per_page
257 < 2 +    return {
258 < 2 +        "page": page,
259 < 2 +        "pages": -(-total // per_page),
260 < 2 +        "total": total,
261 < 2 +        "items": _copies(entries[start:start + per_page]),
262 < 2 +    }
263 < 2 +
264 < 2 +
265 < 2 +def _count_lines(entries, field, template):
266 < 2 +    """One `template % (value, count)` line per distinct value of `field`,
267 < 2 +    sorted alphabetically by value."""
268 < 2 +    counts = counts_by(entries, field)
269 < 2 +    return [template % (value, counts[value]) for value in sorted(counts)]
270 < 2 +
271 < 2 +
272 < 2 +def to_report(entries):
273 < 2 +    """The plain-text report: a header, the total, then a "by method" and a
274 < 2 +    "by actor" section. A section with no counts is omitted entirely, so an
275 < 2 +    empty log renders as just the header and "total: 0"."""
276 < 2 +    lines = ["audit report", "total: %d" % len(entries)]
277 < 2 +    for field in ("method", "actor"):
278 < 2 +        section = _count_lines(entries, field, "  %s: %d")
279 < 2 +        if section:
280 < 2 +            lines.append("")
281 < 2 +            lines.append("by %s:" % field)
282 < 2 +            lines.extend(section)
283 < 2 +    return "\n".join(lines)
284 < 2 +
285 < 2 +
286 < 2 +def to_csv_report(entries):
287 < 2 +    """The counts as CSV: a `field,value,count` header, then the method
288 < 2 +    rows and the actor rows, each block sorted by value."""
289 < 2 +    lines = ["field,value,count"]
290 < 2 +    for field in ("method", "actor"):
291 < 2 +        lines.extend(_count_lines(entries, field, field + ",%s,%d"))
292 < 2 +    return "\n".join(lines)
293 < 2 +
294 < 2 +
295 < 2 +def to_markdown_report(entries):
296 < 2 +    """The same rows as `to_csv_report` as an unpadded Markdown table."""
297 < 2 +    lines = ["| field | value | count |", "| --- | --- | --- |"]
298 < 2 +    for field in ("method", "actor"):
299 < 2 +        lines.extend(
300 < 2 +            _count_lines(entries, field, "| " + field + " | %s | %d |"))
301 < 2 +    return "\n".join(lines)
302 < 2 +
303 < 2 +
304 < 2 +def top_actors(entries, n):
305 < 2 +    """The `n` busiest actors as `(actor, count)` pairs: most calls first,
306 < 2 +    ties broken by actor name ascending. A negative `n` is a ValueError."""
307 < 2 +    if n < 0:
308 < 2 +        raise ValueError("n must not be negative: %s" % n)
309 < 2 +    counts = counts_by(entries, "actor")
310 < 2 +    ranked = sorted(counts.items(), key=lambda pair: (-pair[1], pair[0]))
311 < 2 +    return ranked[:n]
312 < 2 +
313 < 2 +
314 < 2 +def merge_entries(*entry_lists):
315 < 2 +    """One new list concatenating every given list in argument order. The
316 < 2 +    entries are copies, so the sources stay untouched."""
317 < 2 +    merged = []
318 < 2 +    for entries in entry_lists:
319 < 2 +        merged.extend(_copies(entries))
320 < 2 +    return merged
321 < 2 +
322 < 2 +
323 < 2 +def _diff_counts(before, after):
324 < 2 +    """Value -> `after - before` for every value whose count changed; a
325 < 2 +    value missing from either side counts as 0. Unchanged values are
326 < 2 +    omitted entirely."""
327 < 2 +    diff = {}
328 < 2 +    for value in set(before) | set(after):
329 < 2 +        delta = after.get(value, 0) - before.get(value, 0)
330 < 2 +        if delta:
331 < 2 +            diff[value] = delta
332 < 2 +    return diff
333 < 2 +
334 < 2 +
335 < 2 +def diff_summaries(a, b):
336 < 2 +    """What changed from summary `a` to summary `b`: the total delta and,
337 < 2 +    per breakdown, only the values whose counts moved."""
338 < 2 +    return {
339 < 2 +        "total": b["total"] - a["total"],
340 < 2 +        "by_method": _diff_counts(a["by_method"], b["by_method"]),
341 < 2 +        "by_actor": _diff_counts(a["by_actor"], b["by_actor"]),
342 < 2 +    }
343 < 2 +
344 < 2 +
345 < 2 +def group_by(entries, field):
346 < 2 +    """Each distinct value of `field` mapped to copies of its entries, in
347 < 2 +    original order."""
348 < 2 +    _check_field(field)
349 < 2 +    groups = {}
350 < 2 +    for entry in entries:
351 < 2 +        groups.setdefault(entry[field], []).append(dict(entry))
352 < 2 +    return groups
353 < 2 +
354 < 2 +
355 < 2 +def search(entries, needle):
356 < 2 +    """Copies of the entries where `needle` is a substring of any of the
357 < 2 +    three field values, in original order. An empty needle is a ValueError
358 < 2 +    — it would match everything."""
359 < 2 +    if not needle:
360 < 2 +        raise ValueError("needle must not be empty")
361 < 2 +    return _copies(
362 < 2 +        entry for entry in entries
363 < 2 +        if any(needle in entry.get(field, "") for field in FIELDS)
364 < 2 +    )
365 < 2 +
366 < 2 +
367 < 2 +def format_entry(entry):
368 < 2 +    """One entry as `"<method> <path> (<actor>)"`, the method verb rendered
369 < 2 +    exactly as it was logged. A missing field is a ValueError naming it."""
370 < 2 +    for field in FIELDS:
371 < 2 +        if field not in entry:
372 < 2 +            raise ValueError("entry is missing field: %s" % field)
373 < 2 +    return "%s %s (%s)" % (entry["method"], entry["path"], entry["actor"])
374 < 2 +
375 < 2 +
376 < 2 +def to_lines(entries):
377 < 2 +    """`format_entry` for every entry, in order."""
378 < 2 +    return [format_entry(entry) for entry in entries]
