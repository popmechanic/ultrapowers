1319 < 2 +
1320 < 2 +
1321 < 2 +def truncate(value, width, marker="..."):
1322 < 2 +    """Shorten a rendered value to at most `width` characters.
1323 < 2 +
1324 < 2 +    A value that already fits is returned unchanged; a longer one keeps its
1325 < 2 +    first `width - len(marker)` characters and ends with `marker`, so the
1326 < 2 +    result is exactly `width` wide. A `width` too narrow to hold the marker
1327 < 2 +    is a caller error."""
