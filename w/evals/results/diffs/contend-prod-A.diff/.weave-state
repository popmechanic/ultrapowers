4 < 2 +++ b/app/audit.py
5 < 2 @@ -0,0 +1,98 @@
6 < 2 +"""Audit log of every dispatched call.
7 < 2 +
8 < 2 +`dispatch_hook` is the registry seam: it runs before every dispatch and
9 < 2 +records who called what. Unlike the rate-limit guard it never special-cases
10 < 2 +the method and never rejects a call — every dispatch is logged, always.
11 < 2 +(`audit_log_enabled` in DEFAULT_CONFIG is recorded for a future on/off
12 < 2 +switch and is deliberately not read here.)
13 < 2 +
14 < 2 +The log is module-global write-side state: a bounded list of entries, each
15 < 2 +exactly `{"method": ..., "path": ..., "actor": ...}`, never the record
16 < 2 +fields a create was called with. The cap is enforced after every single
17 < 2 +append — the log is never allowed to grow past it, not even transiently —
18 < 2 +and each eviction bumps the `dropped()` counter.
19 < 2 +
20 < 2 +Reading is somebody else's job: `app/audit_query.py` is a pure module over
21 < 2 +plain entry lists and imports nothing from here.
22 < 2 +"""
23 < 2 +
24 < 2 +ANONYMOUS_ACTOR = "anonymous"
25 < 2 +
26 < 2 +_log = []
27 < 2 +_dropped = 0
28 < 2 +
29 < 2 +
30 < 2 +def clear():
31 < 2 +    """Empty the log and reset the dropped counter."""
32 < 2 +    global _dropped
33 < 2 +    del _log[:]
34 < 2 +    _dropped = 0
35 < 2 +
36 < 2 +
37 < 2 +def entries():
38 < 2 +    """Every logged entry in call order, as a copy: neither the returned
39 < 2 +    list nor the dicts in it are the live log's."""
40 < 2 +    return [dict(entry) for entry in _log]
41 < 2 +
42 < 2 +
43 < 2 +def dropped():
44 < 2 +    """How many entries the cap has evicted since the last `clear()`."""
45 < 2 +    return _dropped
46 < 2 +
47 < 2 +
48 < 2 +def _enforce_cap(max_entries):
49 < 2 +    """Drop oldest-first until the log fits `max_entries`, counting each
50 < 2 +    eviction. Called after every append, never batched."""
51 < 2 +    global _dropped
52 < 2 +    while len(_log) > max_entries:
53 < 2 +        del _log[0]
54 < 2 +        _dropped += 1
55 < 2 +
56 < 2 +
57 < 2 +def record(method, path, actor, max_entries):
58 < 2 +    """Append one entry for `actor`'s `method` `path` call, then enforce
59 < 2 +    `max_entries` (oldest entries are evicted first). Returns None."""
60 < 2 +    _log.append({"method": method, "path": path, "actor": actor})
61 < 2 +    _enforce_cap(max_entries)
62 < 2 +    return None
63 < 2 +
64 < 2 +
65 < 2 +def record_many(triples, max_entries):
66 < 2 +    """Append each `(method, path, actor)` triple in order and return how
67 < 2 +    many were appended — always `len(triples)`, since an append that
68 < 2 +    immediately ages out under the cap still happened. The cap is enforced
69 < 2 +    after every append because each one goes through `record`."""
70 < 2 +    count = 0
71 < 2 +    for method, path, actor in triples:
72 < 2 +        record(method, path, actor, max_entries)
73 < 2 +        count += 1
74 < 2 +    return count
75 < 2 +
76 < 2 +
77 < 2 +def export_state():
78 < 2 +    """The whole log as a plain, detached dict: `{"entries": [...],
79 < 2 +    "dropped": n}`. Mutating it cannot reach the live log."""
80 < 2 +    return {"entries": entries(), "dropped": _dropped}
81 < 2 +
82 < 2 +
83 < 2 +def import_state(state):
84 < 2 +    """Replace the log and the dropped counter from an `export_state()`-
85 < 2 +    shaped dict, copying it in so later mutations of `state` do not leak
86 < 2 +    into the live log. Returns None."""
87 < 2 +    global _dropped
88 < 2 +    del _log[:]
89 < 2 +    _log.extend(dict(entry) for entry in state["entries"])
90 < 2 +    _dropped = state["dropped"]
91 < 2 +    return None
92 < 2 +
93 < 2 +
94 < 2 +def dispatch_hook(store, config, method, path, kwargs):
95 < 2 +    """Registry dispatch hook: log every call, whatever its method.
96 < 2 +
97 < 2 +    The actor comes from `kwargs["actor"]`, defaulting to "anonymous" — all
98 < 2 +    unattributed callers share that name. Only the three audit fields are
99 < 2 +    kept; the rest of `kwargs` (a create's record fields, say) is never
100 < 2 +    copied into the log. The cap is `config["audit_log_max_entries"]`."""
101 < 2 +    record(method, path, kwargs.get("actor", ANONYMOUS_ACTOR),
102 < 2 +           config["audit_log_max_entries"])
103 < 2 +    return None
