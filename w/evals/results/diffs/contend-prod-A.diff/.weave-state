876 < 2 @@ -0,0 +1,128 @@
877 < 2 +"""Pure rule combinators over app.schema's predicates.
878 < 2 +
879 < 2 +A *rule* is a plain dict ``{"name": str, "test": callable}``. Combinators
880 < 2 +build bigger rules out of smaller ones and name the result deterministically,
881 < 2 +so a failure message always spells out the rule that produced it. Every
882 < 2 +predicate that already exists in app.schema is called through the module
883 < 2 +(never copied here) so monkeypatching schema reaches these rules too.
884 < 2 +"""
885 < 2 +from app import schema
886 < 2 +
887 < 2 +
888 < 2 +class RuleError(Exception):
889 < 2 +    """Raised for rule-application problems (distinct from SchemaError)."""
890 < 2 +
891 < 2 +
892 < 2 +def rule(name, predicate):
893 < 2 +    """Build a rule from a non-empty name and a single-argument predicate."""
894 < 2 +    if not isinstance(name, str) or not name:
895 < 2 +        raise ValueError("rule name must be a non-empty string: %r" % (name,))
896 < 2 +    return {"name": name, "test": predicate}
897 < 2 +
898 < 2 +
899 < 2 +def check(value, r):
900 < 2 +    """Run a rule's predicate against `value` as a bool."""
901 < 2 +    return bool(r["test"](value))
902 < 2 +
903 < 2 +
904 < 2 +def _joined(kind, children):
905 < 2 +    return "%s(%s)" % (kind, ",".join(child["name"] for child in children))
906 < 2 +
907 < 2 +
908 < 2 +def all_of(*children):
909 < 2 +    """Passes iff every child passes. No children passes everything."""
910 < 2 +    return rule(_joined("all", children),
911 < 2 +                lambda value: all(check(value, c) for c in children))
912 < 2 +
913 < 2 +
914 < 2 +def any_of(*children):
915 < 2 +    """Passes iff at least one child passes. No children is a bug, not a
916 < 2 +    vacuous pass, so it raises."""
917 < 2 +    if not children:
918 < 2 +        raise ValueError("any_of requires at least one rule")
919 < 2 +    return rule(_joined("any", children),
920 < 2 +                lambda value: any(check(value, c) for c in children))
921 < 2 +
922 < 2 +
923 < 2 +def negate(r):
924 < 2 +    """The inverse of `r`."""
925 < 2 +    return rule("not(%s)" % r["name"], lambda value: not check(value, r))
926 < 2 +
927 < 2 +
928 < 2 +def when(cond, then):
929 < 2 +    """Material implication: passes when `cond` fails or `then` passes."""
930 < 2 +    return rule("when(%s,%s)" % (cond["name"], then["name"]),
931 < 2 +                lambda value: (not check(value, cond)) or check(value, then))
932 < 2 +
933 < 2 +
934 < 2 +def explain(value, r):
935 < 2 +    """``"<rule name>: pass"`` or ``"<rule name>: fail"``."""
936 < 2 +    return "%s: %s" % (r["name"], "pass" if check(value, r) else "fail")
937 < 2 +
938 < 2 +
939 < 2 +def apply_rules(fields, rules_by_field):
940 < 2 +    """``"field <f> failed <rule name>"`` for every failing field, in
941 < 2 +    rules_by_field insertion order. Fields absent from `fields` are skipped;
942 < 2 +    `fields` is never mutated."""
943 < 2 +    return ["field %s failed %s" % (field, r["name"])
944 < 2 +            for field, r in rules_by_field.items()
945 < 2 +            if field in fields and not check(fields[field], r)]
946 < 2 +
947 < 2 +
948 < 2 +def first_failure(fields, rules_by_field):
949 < 2 +    """The (field, rule name) of the first failure in insertion order, or
950 < 2 +    None when everything present passes."""
951 < 2 +    for field, r in rules_by_field.items():
952 < 2 +        if field in fields and not check(fields[field], r):
953 < 2 +            return (field, r["name"])
954 < 2 +    return None
955 < 2 +
956 < 2 +
957 < 2 +def explain_failures(fields, rules_by_field):
958 < 2 +    """explain() for the failing fields only, in insertion order."""
959 < 2 +    return [explain(fields[field], r)
960 < 2 +            for field, r in rules_by_field.items()
961 < 2 +            if field in fields and not check(fields[field], r)]
962 < 2 +
963 < 2 +
964 < 2 +def describe_rules(rules_by_field):
965 < 2 +    """One ``"<field>: <rule name>"`` line per field, in insertion order."""
966 < 2 +    if not rules_by_field:
967 < 2 +        return "(no rules)"
968 < 2 +    return "\n".join("%s: %s" % (field, r["name"])
969 < 2 +                     for field, r in rules_by_field.items())
970 < 2 +
971 < 2 +
972 < 2 +BUILTINS = {
973 < 2 +    "number": rule("number", lambda value: schema.is_valid_amount(value)),
974 < 2 +    "str": rule("str", lambda value: isinstance(value, str)),
975 < 2 +    "non_empty": rule("non_empty",
976 < 2 +                      lambda value: schema.is_non_empty_str(value)),
977 < 2 +}
978 < 2 +
979 < 2 +
980 < 2 +def parse_rule(text):
981 < 2 +    """Parse a ``&``-joined list of builtin names into a single rule (an
982 < 2 +    all_of composite when more than one). Unknown tokens raise ValueError
983 < 2 +    naming the token."""
984 < 2 +    if not isinstance(text, str) or not text.strip():
985 < 2 +        raise ValueError("empty rule text: %r" % (text,))
986 < 2 +    tokens = [token.strip() for token in text.split("&")]
987 < 2 +    for token in tokens:
988 < 2 +        if token not in BUILTINS:
989 < 2 +            raise ValueError("unknown rule token: %r" % (token,))
990 < 2 +    if len(tokens) == 1:
991 < 2 +        return BUILTINS[tokens[0]]
992 < 2 +    return all_of(*[BUILTINS[token] for token in tokens])
993 < 2 +
994 < 2 +
995 < 2 +def parse_rules(text_by_field):
996 < 2 +    """{field: parse_rule(text)} in insertion order. A bad token raises
997 < 2 +    ValueError naming both the field and the token."""
998 < 2 +    parsed = {}
999 < 2 +    for field, text in text_by_field.items():
1000 < 2 +        try:
1001 < 2 +            parsed[field] = parse_rule(text)
1002 < 2 +        except ValueError as err:
1003 < 2 +            raise ValueError("field %s: %s" % (field, err))
1004 < 2 +    return parsed
