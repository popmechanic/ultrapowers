2257 < 2 +"""Tests for the export/report formatter `app/export.py` and its wiring.
2258 < 2 +
2259 < 2 +Every expected table/table-ish value below is a literal string. Building an
2260 < 2 +expectation out of the same `tabular` helpers the implementation uses would
2261 < 2 +be a tautology that stays green under a broken `columns`/`widths`/`pad`.
2262 < 2 +"""
2263 < 2 +import json
2264 < 2 +
2265 < 2 +import pytest
2266 < 2 +
2267 < 2 +from app import export, tabular
2268 < 2 +from app.registry import DEFAULT_CONFIG, EXPORT_FORMATS, bootstrap
2269 < 2 +
2270 < 2 +
2271 < 2 +# Two records with deliberately unequal key sets: "note" is missing from the
2272 < 2 +# first, so every format has to render a missing field as an empty cell.
2273 < 2 +RECORDS = [
2274 < 2 +    {"name": "coffee", "amount": 3},
2275 < 2 +    {"name": "tea", "amount": 2, "note": "hot"},
2276 < 2 +]
2277 < 2 +
2278 < 2 +ONE_RECORD = [{"name": "coffee", "amount": 3}]
2279 < 2 +
