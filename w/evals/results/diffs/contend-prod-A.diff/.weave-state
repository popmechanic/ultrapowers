2920 < 2 +        "X-RateLimit-Remaining": "0",
2921 < 2 +        "X-RateLimit-Reset": "50.0",
2922 < 2 +    }
2923 < 2 +    # Read-only: the untouched key still has its full allowance.
2924 < 2 +    assert quota.take("fresh", 2, 60, burst=1) == 1
2925 < 2 +
2926 < 2 +
2927 < 2 +def test_status_line_renders_the_usage_summary():
2928 < 2 +    ratelimit.reset()
2929 < 2 +    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
2930 < 2 +    assert ratelimit.status_line("mallory", config) == \
2931 < 2 +        "mallory: 0/2, reset in 0.0s"
2932 < 2 +    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
2933 < 2 +    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
2934 < 2 +    quota.advance(10)
2935 < 2 +    assert ratelimit.status_line("mallory", config) == \
2936 < 2 +        "mallory: 2/2, reset in 50.0s"
2937 < 2 +    # Read-only: still exhausted, nothing recorded by the render.
2938 < 2 +    assert quota.remaining("mallory", 2, 60) == 0
2939 < 2 +
2940 < 2 +
2941 < 2 +def test_check_many_reports_who_would_pass_without_recording():
2942 < 2 +    ratelimit.reset()
2943 < 2 +    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
2944 < 2 +    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "b"})
2945 < 2 +    for _ in range(2):
2946 < 2 +        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "c"})
2947 < 2 +    assert ratelimit.check_many(["a", "b", "c"], config) == {
2948 < 2 +        "a": True, "b": True, "c": False}
2949 < 2 +    assert ratelimit.check_many(["a", "b", "c"], config) == {
2950 < 2 +        "a": True, "b": True, "c": False}
2951 < 2 +    # Nothing was recorded: each key behaves exactly as it did before.
2952 < 2 +    assert quota.take("a", 2, 60) == 1
2953 < 2 +    assert quota.take("b", 2, 60) == 2
2954 < 2 +    with pytest.raises(quota.QuotaExceededError):
2955 < 2 +        quota.take("c", 2, 60)
