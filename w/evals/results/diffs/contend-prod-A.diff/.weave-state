738 < 2 @@ -0,0 +1,99 @@
739 < 2 +"""Per-actor rate-limit guard for writes.
740 < 2 +
741 < 2 +`dispatch_hook` is the registry seam: it runs before every dispatch and
742 < 2 +rejects a POST once the calling actor has spent its configured allowance.
743 < 2 +Reads are never counted. All counting lives in `app.quota` — this module
744 < 2 +keeps no counter state of its own, so `reset()` is just `quota.reset()`.
745 < 2 +
746 < 2 +Config: only `rate_limit_max_per_window` is required. The window and the
747 < 2 +burst are always read with `.get(...)` defaults so an external caller can
748 < 2 +pass a limit-only config.
749 < 2 +"""
750 < 2 +from app import quota
751 < 2 +
752 < 2 +
753 < 2 +DEFAULT_WINDOW_SECONDS = 60
754 < 2 +DEFAULT_BURST = 0
755 < 2 +
756 < 2 +
757 < 2 +class RateLimitExceededError(quota.QuotaExceededError):
758 < 2 +    """Raised when a key exceeds its configured rate limit."""
759 < 2 +
760 < 2 +
761 < 2 +def reset():
762 < 2 +    """Clear every key's counter and reset the quota clock."""
763 < 2 +    quota.reset()
764 < 2 +
765 < 2 +
766 < 2 +def _limits(config):
767 < 2 +    """The (limit, window_seconds, burst) triple this config asks for."""
768 < 2 +    return (
769 < 2 +        config["rate_limit_max_per_window"],
770 < 2 +        config.get("rate_limit_window_seconds", DEFAULT_WINDOW_SECONDS),
771 < 2 +        config.get("rate_limit_burst", DEFAULT_BURST),
772 < 2 +    )
773 < 2 +
774 < 2 +
775 < 2 +def check_and_increment(key, limit, window_seconds=float("inf"), burst=0):
776 < 2 +    """Record a hit for `key` and return its in-window count.
777 < 2 +
778 < 2 +    Raises RateLimitExceededError once the allowance is spent. The default
779 < 2 +    window is infinite: plain call-counting unless a caller passes one."""
780 < 2 +    try:
781 < 2 +        return quota.take(key, limit, window_seconds, burst=burst)
782 < 2 +    except quota.QuotaExceededError as err:
783 < 2 +        raise RateLimitExceededError(str(err)) from err
784 < 2 +
785 < 2 +
786 < 2 +def dispatch_hook(store, config, method, path, kwargs):
787 < 2 +    """Registry dispatch hook: count writes per actor, ignore reads.
788 < 2 +
789 < 2 +    The actor comes from `kwargs["actor"]`, defaulting to "anonymous" — all
790 < 2 +    unattributed callers share one counter. Any method other than POST is a
791 < 2 +    no-op."""
792 < 2 +    if method != "POST":
793 < 2 +        return None
794 < 2 +    limit, window_seconds, burst = _limits(config)
795 < 2 +    check_and_increment(kwargs.get("actor", "anonymous"), limit,
796 < 2 +                        window_seconds, burst=burst)
797 < 2 +    return None
798 < 2 +
799 < 2 +
800 < 2 +def retry_after(key, config):
801 < 2 +    """Seconds until `key` may retry under `config`. Records nothing."""
802 < 2 +    limit, window_seconds, burst = _limits(config)
803 < 2 +    return quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
804 < 2 +
805 < 2 +
806 < 2 +def limit_headers(key, config):
807 < 2 +    """The X-RateLimit-* response headers for `key`, all values strings.
808 < 2 +
809 < 2 +    `X-RateLimit-Limit` is the configured limit alone; any burst shows up
810 < 2 +    only in the remaining allowance. Records nothing."""
811 < 2 +    limit, window_seconds, burst = _limits(config)
812 < 2 +    return {
813 < 2 +        "X-RateLimit-Limit": str(limit),
814 < 2 +        "X-RateLimit-Remaining": str(
815 < 2 +            quota.remaining(key, limit, window_seconds, burst=burst)),
816 < 2 +        "X-RateLimit-Reset": str(
817 < 2 +            quota.time_to_next_slot(key, limit, window_seconds, burst=burst)),
818 < 2 +    }
819 < 2 +
820 < 2 +
821 < 2 +def status_line(key, config):
822 < 2 +    """A one-line human-readable usage summary for `key`. Records nothing."""
823 < 2 +    limit, window_seconds, burst = _limits(config)
824 < 2 +    state = quota.usage(key, limit, window_seconds, burst=burst)
825 < 2 +    return "%s: %s/%s, reset in %ss" % (
826 < 2 +        key, state["used"], state["allowed"], state["reset_in"])
827 < 2 +
828 < 2 +
829 < 2 +def check_many(keys, config):
830 < 2 +    """Map each key to whether a POST for it would succeed right now.
831 < 2 +
832 < 2 +    Records nothing — a pure look-ahead over `quota.remaining`."""
833 < 2 +    limit, window_seconds, burst = _limits(config)
834 < 2 +    return {
835 < 2 +        key: quota.remaining(key, limit, window_seconds, burst=burst) > 0
836 < 2 +        for key in keys
837 < 2 +    }
