2639 < 2 +    assert quota.remaining("k", 2, 60) == 1
2640 < 2 +    assert quota.remaining("k", 2, 60, burst=1) == 2
2641 < 2 +    assert quota.take("k", 2, 60) == 2
2642 < 2 +    assert quota.remaining("k", 2, 60) == 0
2643 < 2 +    assert quota.remaining("k", 2, 60) == 0
