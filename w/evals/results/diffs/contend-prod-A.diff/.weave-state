1482 < 2 @@ -0,0 +1,102 @@
1483 < 2 +"""Input validation for record creation.
1484 < 2 +
1485 < 2 +`validate_fields` is the single entry point: it checks the configured
1486 < 2 +required fields first (in order), then the value rules for the `amount` and
1487 < 2 +`name` fields when those keys are present, and returns a normalized copy.
1488 < 2 +Every message it raises is built by `schema.format_error`, so the catalog
1489 < 2 +stays the one place a wording lives.
1490 < 2 +"""
1491 < 2 +import re
1492 < 2 +
1493 < 2 +from app import schema
1494 < 2 +
1495 < 2 +
1496 < 2 +class ValidationError(Exception):
1497 < 2 +    """Raised when a fields dict violates the configured validation policy."""
1498 < 2 +
1499 < 2 +
1500 < 2 +def validate_fields(fields, required_fields, max_amount):
1501 < 2 +    """Validate `fields` and return a normalized shallow copy.
1502 < 2 +
1503 < 2 +    Required fields are checked first, in `required_fields` order. `amount`
1504 < 2 +    and `name` are only checked when present, since a differently-configured
1505 < 2 +    caller may not require them. On success the copy has `name` stripped;
1506 < 2 +    every other key and value is passed through unchanged (mutable values
1507 < 2 +    are the same objects, not deep copies)."""
1508 < 2 +    missing = schema.check_required(fields, required_fields)
1509 < 2 +    if missing:
1510 < 2 +        raise ValidationError(schema.format_error("missing", field=missing[0]))
1511 < 2 +    if "amount" in fields:
1512 < 2 +        amount = fields["amount"]
1513 < 2 +        if not schema.is_valid_amount(amount):
1514 < 2 +            raise ValidationError(schema.format_error(
1515 < 2 +                "numeric", field="amount", got=type(amount).__name__))
1516 < 2 +        if amount < 0:
1517 < 2 +            raise ValidationError(
1518 < 2 +                schema.format_error("non_negative", field="amount"))
1519 < 2 +        if amount > max_amount:
1520 < 2 +            raise ValidationError(
1521 < 2 +                schema.format_error("max", field="amount", limit=max_amount))
1522 < 2 +    if "name" in fields:
1523 < 2 +        if not schema.is_non_empty_str(fields["name"]):
1524 < 2 +            raise ValidationError(
1525 < 2 +                schema.format_error("non_empty", field="name"))
1526 < 2 +    validated = dict(fields)
1527 < 2 +    if "name" in validated:
1528 < 2 +        validated["name"] = validated["name"].strip()
1529 < 2 +    return validated
1530 < 2 +
1531 < 2 +
1532 < 2 +def validate_many(entries, required_fields, max_amount):
1533 < 2 +    """Validate a list of fields dicts. Returns (validated, errors): the
1534 < 2 +    successfully validated new dicts in input order, and (index, message)
1535 < 2 +    pairs for the failures, also in input order."""
1536 < 2 +    validated = []
1537 < 2 +    errors = []
1538 < 2 +    for index, fields in enumerate(entries):
1539 < 2 +        try:
1540 < 2 +            validated.append(
1541 < 2 +                validate_fields(fields, required_fields, max_amount))
1542 < 2 +        except ValidationError as err:
1543 < 2 +            errors.append((index, str(err)))
1544 < 2 +    return (validated, errors)
1545 < 2 +
1546 < 2 +
1547 < 2 +def _template_pattern(template):
1548 < 2 +    """A regex matching a catalog template with its {placeholders} filled."""
1549 < 2 +    literals = re.split(r"\{[^{}]*\}", template)
1550 < 2 +    return re.compile(
1551 < 2 +        "\\A" + "(.+?)".join(re.escape(part) for part in literals) + "\\Z")
1552 < 2 +
1553 < 2 +
1554 < 2 +def _literal_length(template):
1555 < 2 +    return sum(len(part) for part in re.split(r"\{[^{}]*\}", template))
1556 < 2 +
1557 < 2 +
1558 < 2 +def error_code(message):
1559 < 2 +    """Map a rendered error message back to its ERROR_CATALOG code.
1560 < 2 +
1561 < 2 +    The matcher is derived from the catalog at call time, so it follows any
1562 < 2 +    change to the templates. Templates whose rendered forms can overlap (a
1563 < 2 +    field name may contain spaces) are disambiguated by preferring the most
1564 < 2 +    specific match — the one with the most literal text."""
1565 < 2 +    matches = [code for code, template in schema.ERROR_CATALOG.items()
1566 < 2 +               if _template_pattern(template).match(message)]
1567 < 2 +    if not matches:
1568 < 2 +        raise ValueError("unrecognized error message: %r" % (message,))
1569 < 2 +    return max(matches, key=lambda code: _literal_length(
1570 < 2 +        schema.ERROR_CATALOG[code]))
1571 < 2 +
1572 < 2 +
1573 < 2 +def explain_config(config):
1574 < 2 +    """Render the validation policy held in `config` as three lines."""
1575 < 2 +    return "validation config:\n  required: %s\n  max_amount: %s" % (
1576 < 2 +        ", ".join(config["validation_required_fields"]),
1577 < 2 +        config["validation_max_amount"])
1578 < 2 +
1579 < 2 +
1580 < 2 +def pre_create_hook(store, config, fields):
1581 < 2 +    """PRE_CREATE_HOOKS entry point: validate a create's fields against the
1582 < 2 +    configured policy. `store` is unused."""
1583 < 2 +    return validate_fields(fields, config["validation_required_fields"],
1584 < 2 +                           config["validation_max_amount"])
