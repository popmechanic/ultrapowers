1811 < 2 @@ -0,0 +1,439 @@
1812 < 2 +"""Tests for app/audit_query.py — the pure read side over audit entries.
1813 < 2 +
1814 < 2 +Every function under test takes a plain list of entry dicts and never
1815 < 2 +mutates it, so each test snapshots its fixture with `copy.deepcopy` and
1816 < 2 +asserts the input is unchanged afterwards. Only the final integration test
1817 < 2 +touches `app.audit`; the query module itself never imports it.
1818 < 2 +"""
1819 < 2 +import copy
1820 < 2 +
1821 < 2 +import pytest
1822 < 2 +
1823 < 2 +from app import audit, audit_query
1824 < 2 +
1825 < 2 +
1826 < 2 +def _entries():
1827 < 2 +    """The shared 4-entry fixture: one method used by two actors ("POST":
1828 < 2 +    bob and alice) and one actor using two methods (alice: GET, POST)."""
1829 < 2 +    return [
1830 < 2 +        {"method": "GET", "path": "/records", "actor": "alice"},
1831 < 2 +        {"method": "POST", "path": "/records", "actor": "bob"},
1832 < 2 +        {"method": "GET", "path": "/report", "actor": "alice"},
1833 < 2 +        {"method": "POST", "path": "/records", "actor": "alice"},
1834 < 2 +    ]
1835 < 2 +
1836 < 2 +
1837 < 2 +@pytest.fixture(autouse=True)
1838 < 2 +def _clean_audit_state():
1839 < 2 +    """The integration test writes the module-global log; leave it clean."""
1840 < 2 +    yield
1841 < 2 +    audit.clear()
1842 < 2 +
1843 < 2 +
1844 < 2 +def test_filter_entries_matches_each_criterion_ands_them_and_copies():
1845 < 2 +    entries = _entries()
1846 < 2 +    snapshot = copy.deepcopy(entries)
1847 < 2 +
1848 < 2 +    assert audit_query.filter_entries(entries, actor="alice") == [
1849 < 2 +        {"method": "GET", "path": "/records", "actor": "alice"},
1850 < 2 +        {"method": "GET", "path": "/report", "actor": "alice"},
1851 < 2 +        {"method": "POST", "path": "/records", "actor": "alice"},
1852 < 2 +    ]
1853 < 2 +    assert audit_query.filter_entries(entries, method="POST") == [
1854 < 2 +        {"method": "POST", "path": "/records", "actor": "bob"},
1855 < 2 +        {"method": "POST", "path": "/records", "actor": "alice"},
1856 < 2 +    ]
1857 < 2 +    assert audit_query.filter_entries(entries, path="/records") == [
1858 < 2 +        {"method": "GET", "path": "/records", "actor": "alice"},
1859 < 2 +        {"method": "POST", "path": "/records", "actor": "bob"},
1860 < 2 +        {"method": "POST", "path": "/records", "actor": "alice"},
1861 < 2 +    ]
1862 < 2 +    assert audit_query.filter_entries(entries, actor="alice",
1863 < 2 +                                      method="POST") == [
1864 < 2 +        {"method": "POST", "path": "/records", "actor": "alice"},
1865 < 2 +    ]
1866 < 2 +    assert audit_query.filter_entries(entries) == entries
1867 < 2 +
1868 < 2 +    first = audit_query.filter_entries(entries, method="GET")
1869 < 2 +    first.append({"method": "PUT", "path": "/x", "actor": "mallory"})
1870 < 2 +    assert len(audit_query.filter_entries(entries, method="GET")) == 2
1871 < 2 +    assert entries == snapshot
1872 < 2 +
1873 < 2 +
1874 < 2 +def test_counts_by_returns_value_to_count_and_rejects_other_fields():
1875 < 2 +    entries = _entries()
1876 < 2 +    snapshot = copy.deepcopy(entries)
1877 < 2 +
1878 < 2 +    assert audit_query.counts_by(entries, "method") == {"GET": 2, "POST": 2}
1879 < 2 +    assert audit_query.counts_by(entries, "actor") == {"alice": 3, "bob": 1}
1880 < 2 +    assert audit_query.counts_by(entries, "path") == {"/records": 3,
1881 < 2 +                                                      "/report": 1}
1882 < 2 +    assert audit_query.counts_by([], "method") == {}
1883 < 2 +
1884 < 2 +    with pytest.raises(ValueError) as err:
1885 < 2 +        audit_query.counts_by(entries, "status")
1886 < 2 +    assert "status" in str(err.value)
1887 < 2 +    assert entries == snapshot
1888 < 2 +
1889 < 2 +
1890 < 2 +def test_last_n_returns_the_final_entries_and_rejects_a_negative_n():
1891 < 2 +    entries = _entries()
1892 < 2 +    snapshot = copy.deepcopy(entries)
1893 < 2 +
1894 < 2 +    assert audit_query.last_n(entries, 2) == [
