1344 < 2 +        raise ValueError("width must be at least 1, got %s" % (width,))
1345 < 2 +    text = cell(value)
1346 < 2 +    lines = []
1347 < 2 +    current = ""
1348 < 2 +    for word in text.split():
1349 < 2 +        while len(word) > width:
1350 < 2 +            if current:
1351 < 2 +                lines.append(current)
1352 < 2 +                current = ""
1353 < 2 +            lines.append(word[:width])
1354 < 2 +            word = word[width:]
1355 < 2 +        if not current:
1356 < 2 +            current = word
1357 < 2 +        elif len(current) + 1 + len(word) <= width:
1358 < 2 +            current += " " + word
1359 < 2 +        else:
1360 < 2 +            lines.append(current)
1361 < 2 +            current = word
1362 < 2 +    if current or not lines:
1363 < 2 +        lines.append(current)
1364 < 2 +    return lines
1365 < 2 +
1366 < 2 +
1367 < 2 +def fit(value, width, align):
1368 < 2 +    """Render a value into exactly one `width`-wide column cell: truncated
1369 < 2 +    when it is too long, padded per `align` when it is too short."""
