1899 < 2 +    assert audit_query.last_n(entries, 99) == entries
1900 < 2 +
1901 < 2 +    whole = audit_query.last_n(entries, 99)
1902 < 2 +    whole.append({"method": "PUT", "path": "/x", "actor": "mallory"})
1903 < 2 +    assert len(audit_query.last_n(entries, 99)) == 4
1904 < 2 +
1905 < 2 +    with pytest.raises(ValueError):
1906 < 2 +        audit_query.last_n(entries, -1)
1907 < 2 +    assert entries == snapshot
1908 < 2 +
1909 < 2 +
1910 < 2 +def test_redact_replaces_only_the_named_fields_in_new_dicts():
