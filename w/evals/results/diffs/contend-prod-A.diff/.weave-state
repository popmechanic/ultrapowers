1917 < 2 +        {"method": "GET", "path": "/report", "actor": "***"},
1918 < 2 +        {"method": "POST", "path": "/records", "actor": "***"},
1919 < 2 +    ]
1920 < 2 +
1921 < 2 +    untouched = audit_query.redact(entries, [])
