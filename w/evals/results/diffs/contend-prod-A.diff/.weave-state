3459 < 2 +"""Tests for the column-model toolkit `app/tabular.py`.
3460 < 2 +
3461 < 2 +`app/export.py` builds every one of its formats on these helpers, so each
3462 < 2 +contract below is pinned with exact expected values rather than loose
3463 < 2 +containment.
3464 < 2 +"""
3465 < 2 +import pytest
3466 < 2 +
3467 < 2 +from app import tabular
3468 < 2 +
3469 < 2 +
3470 < 2 +def test_columns_returns_sorted_union_of_all_record_keys():
3471 < 2 +    assert tabular.columns([]) == []
3472 < 2 +    records = [{"name": "coffee", "amount": 3},
3473 < 2 +               {"note": "hot", "amount": 2}]
3474 < 2 +    assert tabular.columns(records) == ["amount", "name", "note"]
3475 < 2 +
3476 < 2 +
3477 < 2 +def test_cell_renders_none_as_empty_and_everything_else_via_str():
3478 < 2 +    assert tabular.cell(None) == ""
3479 < 2 +    assert tabular.cell(3) == "3"
3480 < 2 +    assert tabular.cell(3.5) == "3.5"
3481 < 2 +    assert tabular.cell("x") == "x"
3482 < 2 +
3483 < 2 +
3484 < 2 +def test_escape_csv_quotes_only_cells_that_need_it():
3485 < 2 +    assert tabular.escape_csv("plain") == "plain"
3486 < 2 +    assert tabular.escape_csv("a,b") == '"a,b"'
3487 < 2 +    assert tabular.escape_csv('say "hi"') == '"say ""hi"""'
3488 < 2 +    assert tabular.escape_csv("line1\nline2") == '"line1\nline2"'
3489 < 2 +    assert tabular.escape_csv("") == ""
3490 < 2 +
3491 < 2 +
3492 < 2 +def test_widths_takes_the_max_of_the_header_and_every_cell():
3493 < 2 +    records = [{"category": "a", "name": "espresso"},
3494 < 2 +               {"category": "bb", "name": "tea"}]
3495 < 2 +    cols = ["category", "name"]
3496 < 2 +    # "category" is strictly wider than every cell in its column (1, 2);
3497 < 2 +    # "name"'s width comes from the cell "espresso" instead.
3498 < 2 +    assert tabular.widths(records, cols) == {"category": 8, "name": 8}
3499 < 2 +
3500 < 2 +
3501 < 2 +def test_pad_aligns_never_truncates_and_validates_align_first():
3502 < 2 +    assert tabular.pad("ab", 4, "left") == "ab  "
3503 < 2 +    assert tabular.pad("ab", 4, "right") == "  ab"
3504 < 2 +    assert tabular.pad("abcde", 4, "left") == "abcde"
3505 < 2 +    assert tabular.pad("abcd", 4, "right") == "abcd"
3506 < 2 +    with pytest.raises(ValueError) as excinfo:
3507 < 2 +        tabular.pad("abcde", 4, "center")
3508 < 2 +    assert "center" in str(excinfo.value)
3509 < 2 +
3510 < 2 +
3511 < 2 +def test_sanitize_flat_replaces_tabs_and_newlines_with_single_spaces():
3512 < 2 +    assert tabular.sanitize_flat("a\tb\nc") == "a b c"
3513 < 2 +    assert tabular.sanitize_flat("clean value") == "clean value"
3514 < 2 +    assert tabular.sanitize_flat(3) == "3"
3515 < 2 +
3516 < 2 +
3517 < 2 +def test_escape_html_escapes_the_ampersand_first():
3518 < 2 +    assert tabular.escape_html('<a & "b">') == "&lt;a &amp; &quot;b&quot;&gt;"
3519 < 2 +    assert tabular.escape_html("clean value") == "clean value"
3520 < 2 +
3521 < 2 +
3522 < 2 +def test_truncate_shortens_only_over_long_values():
3523 < 2 +    assert tabular.truncate("abcdef", 6) == "abcdef"
3524 < 2 +    assert tabular.truncate("abcdefgh", 6) == "abc..."
3525 < 2 +    assert tabular.truncate("abcdefgh", 6, marker="~") == "abcde~"
3526 < 2 +    with pytest.raises(ValueError):
3527 < 2 +        tabular.truncate("x", 2)
3528 < 2 +
3529 < 2 +
3530 < 2 +def test_wrap_greedily_breaks_on_spaces_and_hard_splits_long_words():
3531 < 2 +    assert tabular.wrap("alpha beta gamma", 10) == ["alpha beta", "gamma"]
3532 < 2 +    assert tabular.wrap("alpha beta gamma", 5) == ["alpha", "beta", "gamma"]
3533 < 2 +    assert tabular.wrap("abcdefgh", 3) == ["abc", "def", "gh"]
3534 < 2 +    assert tabular.wrap("", 4) == [""]
3535 < 2 +    with pytest.raises(ValueError):
3536 < 2 +        tabular.wrap("x", 0)
3537 < 2 +
3538 < 2 +
3539 < 2 +def test_fit_composes_truncate_then_pad():
3540 < 2 +    assert tabular.fit("abcdefgh", 6, "left") == "abc..."
3541 < 2 +    assert tabular.fit("ab", 5, "right") == "   ab"
3542 < 2 +    assert tabular.fit("ab", 5, "left") == "ab   "
3543 < 2 +    with pytest.raises(ValueError):
3544 < 2 +        tabular.fit("ab", 5, "center")
3545 < 2 +
3546 < 2 +
3547 < 2 +def test_render_row_renders_one_padded_pipe_table_row():
3548 < 2 +    assert tabular.render_row(["a", "bb"], [3, 4], "left") == "| a   | bb   |"
3549 < 2 +    assert tabular.render_row(["a", "bb"], [3, 4], "right") == "|   a |   bb |"
3550 < 2 +    with pytest.raises(ValueError):
3551 < 2 +        tabular.render_row(["a"], [3, 4], "left")
