383 < 2 +++ b/app/export.py
384 < 2 @@ -0,0 +1,205 @@
385 < 2 +"""Machine-readable export formats for a list of records.
386 < 2 +
387 < 2 +Every format shares one column model: the sorted union of the keys across
388 < 2 +all records (`tabular.columns`), a missing field rendering as an empty
389 < 2 +cell. That model, the per-format escaping, and the padding all live in
390 < 2 +`app/tabular.py` — this module composes them and never re-derives a key
391 < 2 +union or re-implements an escape.
392 < 2 +
393 < 2 +`FORMATS` is the route-reachable table `app/registry.py` copies into
394 < 2 +`EXPORT_FORMATS`. `EXTRA_FORMATS` holds formats deliberately kept off that
395 < 2 +table (HTML), reachable only through `render_any` or a direct call.
396 < 2 +"""
397 < 2 +import json
398 < 2 +
399 < 2 +from app import tabular
400 < 2 +
401 < 2 +
402 < 2 +def _rows(records, cols, render_cell):
403 < 2 +    """Every record as a list of rendered cells, one per column, in input
404 < 2 +    order. `render_cell` is the per-format value renderer."""
405 < 2 +    return [[render_cell(record.get(col)) for col in cols]
406 < 2 +            for record in records]
407 < 2 +
408 < 2 +
409 < 2 +def to_csv(records):
410 < 2 +    """Render `records` as CSV: a sorted header row then one row per
411 < 2 +    record. An empty list has no columns, so it renders as ""."""
412 < 2 +    cols = tabular.columns(records)
413 < 2 +    if not cols:
414 < 2 +        return ""
415 < 2 +    lines = [",".join(tabular.escape_csv(col) for col in cols)]
416 < 2 +    for row in _rows(records, cols, tabular.escape_csv):
417 < 2 +        lines.append(",".join(row))
418 < 2 +    return "\n".join(lines)
419 < 2 +
420 < 2 +
421 < 2 +def to_json(records):
422 < 2 +    """Render `records` as a JSON array with each object's keys sorted."""
423 < 2 +    return json.dumps(list(records), sort_keys=True)
424 < 2 +
425 < 2 +
426 < 2 +def to_ndjson(records):
427 < 2 +    """Render `records` as newline-delimited JSON: one key-sorted object
428 < 2 +    per line, with no trailing newline."""
429 < 2 +    return "\n".join(json.dumps(record, sort_keys=True) for record in records)
430 < 2 +
431 < 2 +
432 < 2 +def _separator_cell(width, align):
433 < 2 +    """One markdown separator cell: dashes, ending in a colon when the
434 < 2 +    column is right-aligned. Always exactly `width` wide."""
435 < 2 +    if align == "right":
436 < 2 +        return "-" * (width - 1) + ":"
437 < 2 +    return "-" * width
438 < 2 +
439 < 2 +
440 < 2 +def to_markdown(records, align="left"):
441 < 2 +    """Render `records` as a padded pipe table.
442 < 2 +
443 < 2 +    Column widths come from `tabular.widths`, so every cell in a column is
444 < 2 +    padded to the same width. `align` is passed through to `tabular.pad`,
445 < 2 +    which is the only validator of it."""
446 < 2 +    cols = tabular.columns(records)
447 < 2 +    if not cols:
448 < 2 +        return ""
449 < 2 +    col_widths = tabular.widths(records, cols)
450 < 2 +    widths_list = [col_widths[col] for col in cols]
451 < 2 +    lines = [tabular.render_row(cols, widths_list, align)]
452 < 2 +    lines.append(tabular.render_row(
453 < 2 +        [_separator_cell(width, align) for width in widths_list],
454 < 2 +        widths_list, align))
455 < 2 +    for row in _rows(records, cols, tabular.cell):
456 < 2 +        lines.append(tabular.render_row(row, widths_list, align))
457 < 2 +    return "\n".join(lines)
458 < 2 +
459 < 2 +
460 < 2 +def to_tsv(records):
461 < 2 +    """Render `records` as tab-separated values. Column names and cells
462 < 2 +    alike go through `tabular.sanitize_flat`, so a tab or newline inside
463 < 2 +    either cannot break the grid."""
464 < 2 +    cols = tabular.columns(records)
465 < 2 +    if not cols:
466 < 2 +        return ""
467 < 2 +    lines = ["\t".join(tabular.sanitize_flat(col) for col in cols)]
468 < 2 +    for row in _rows(records, cols, tabular.sanitize_flat):
469 < 2 +        lines.append("\t".join(row))
470 < 2 +    return "\n".join(lines)
471 < 2 +
472 < 2 +
473 < 2 +def to_html(records):
474 < 2 +    """Render `records` as an HTML table, one element per line, with every
475 < 2 +    column name and cell escaped by `tabular.escape_html`."""
476 < 2 +    cols = tabular.columns(records)
477 < 2 +    if not cols:
478 < 2 +        return ""
479 < 2 +    lines = ["<table>"]
480 < 2 +    lines.append("<tr>" + "".join(
481 < 2 +        "<th>%s</th>" % tabular.escape_html(col) for col in cols) + "</tr>")
482 < 2 +    for row in _rows(records, cols, tabular.escape_html):
483 < 2 +        lines.append("<tr>" + "".join(
484 < 2 +            "<td>%s</td>" % value for value in row) + "</tr>")
485 < 2 +    lines.append("</table>")
486 < 2 +    return "\n".join(lines)
487 < 2 +
488 < 2 +
489 < 2 +def _parse_csv_rows(text):
490 < 2 +    """Split CSV text into rows of raw cells, honouring quoted cells.
491 < 2 +
492 < 2 +    Rows are newline-separated, so text ending in a newline yields a final
493 < 2 +    empty row — that is what makes `parse_csv("a\\n")` a header plus one
494 < 2 +    empty-cell row while `parse_csv("a")` is a header alone."""
495 < 2 +    rows = []
496 < 2 +    row = []
497 < 2 +    field = []
498 < 2 +    quoted = False
499 < 2 +    index = 0
500 < 2 +    while index < len(text):
501 < 2 +        char = text[index]
502 < 2 +        if quoted:
503 < 2 +            if char == '"':
504 < 2 +                if text[index + 1:index + 2] == '"':
505 < 2 +                    field.append('"')
506 < 2 +                    index += 2
507 < 2 +                    continue
508 < 2 +                quoted = False
509 < 2 +                index += 1
510 < 2 +                continue
511 < 2 +            field.append(char)
512 < 2 +            index += 1
513 < 2 +            continue
514 < 2 +        if char == '"' and not field:
515 < 2 +            quoted = True
516 < 2 +        elif char == ",":
517 < 2 +            row.append("".join(field))
518 < 2 +            field = []
519 < 2 +        elif char == "\n":
520 < 2 +            row.append("".join(field))
521 < 2 +            field = []
522 < 2 +            rows.append(row)
523 < 2 +            row = []
524 < 2 +        else:
525 < 2 +            field.append(char)
526 < 2 +        index += 1
527 < 2 +    if quoted:
528 < 2 +        raise ValueError("unterminated quoted cell in CSV input")
529 < 2 +    row.append("".join(field))
530 < 2 +    rows.append(row)
531 < 2 +    return rows
532 < 2 +
533 < 2 +
534 < 2 +def parse_csv(text):
535 < 2 +    """Parse CSV text back into a list of dicts — the inverse of `to_csv`.
536 < 2 +
537 < 2 +    The first row names the columns; every later row becomes one dict of
538 < 2 +    column name to cell. Cells stay strings: parsing never re-types a value,
539 < 2 +    so an exported `3` comes back as `"3"`. A row with fewer cells than the
540 < 2 +    header is filled out with empty cells."""
541 < 2 +    if not text:
542 < 2 +        return []
543 < 2 +    rows = _parse_csv_rows(text)
544 < 2 +    header = rows[0]
545 < 2 +    records = []
546 < 2 +    for row in rows[1:]:
547 < 2 +        values = row[:len(header)]
548 < 2 +        values += [""] * (len(header) - len(values))
549 < 2 +        records.append(dict(zip(header, values)))
550 < 2 +    return records
551 < 2 +
552 < 2 +
553 < 2 +def summary_line(records):
554 < 2 +    """A one-line description of what an export covers."""
555 < 2 +    return "%s records, %s columns" % (
556 < 2 +        len(records), len(tabular.columns(records)))
557 < 2 +
558 < 2 +
559 < 2 +FORMATS = {
560 < 2 +    "csv": to_csv,
561 < 2 +    "json": to_json,
562 < 2 +    "md": to_markdown,
563 < 2 +    "ndjson": to_ndjson,
564 < 2 +    "tsv": to_tsv,
565 < 2 +}
566 < 2 +
567 < 2 +# Formats deliberately kept out of FORMATS (and so out of the registry's
568 < 2 +# EXPORT_FORMATS): nothing route-reachable serves them.
569 < 2 +EXTRA_FORMATS = {
570 < 2 +    "html": to_html,
571 < 2 +}
572 < 2 +
573 < 2 +
574 < 2 +def render(records, fmt):
575 < 2 +    """Render `records` in one of the `FORMATS`. Anything else — including
576 < 2 +    an `EXTRA_FORMATS` name — is an unknown format."""
577 < 2 +    if fmt not in FORMATS:
578 < 2 +        raise ValueError("unknown export format: %s" % (fmt,))
579 < 2 +    return FORMATS[fmt](records)
580 < 2 +
581 < 2 +
582 < 2 +def render_any(records, fmt):
583 < 2 +    """Like `render`, but falls back to `EXTRA_FORMATS` for formats that
584 < 2 +    are not route-reachable."""
585 < 2 +    if fmt in FORMATS:
586 < 2 +        return FORMATS[fmt](records)
587 < 2 +    if fmt in EXTRA_FORMATS:
588 < 2 +        return EXTRA_FORMATS[fmt](records)
589 < 2 +    raise ValueError("unknown export format: %s" % (fmt,))
