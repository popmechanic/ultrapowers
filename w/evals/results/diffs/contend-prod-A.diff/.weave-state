2541 < 2 +
2542 < 2 +def test_quota_exceeded_error_is_an_exception_subclass():
2543 < 2 +    quota.reset()
2544 < 2 +    assert issubclass(quota.QuotaExceededError, Exception)
2545 < 2 +
2546 < 2 +
2547 < 2 +def test_logical_clock_starts_at_zero_advances_and_rejects_going_backwards():
2548 < 2 +    quota.reset()
2549 < 2 +    assert quota.now() == 0.0
2550 < 2 +    assert quota.advance(30) == 30.0
2551 < 2 +    assert quota.now() == 30.0
2552 < 2 +    with pytest.raises(ValueError):
2553 < 2 +        quota.advance(-1)
2554 < 2 +    assert quota.now() == 30.0
2555 < 2 +
2556 < 2 +
2557 < 2 +def test_take_counts_hits_then_raises_naming_the_key_and_the_limit():
2558 < 2 +    quota.reset()
2559 < 2 +    assert quota.take("k", limit=2, window_seconds=60) == 1
2560 < 2 +    assert quota.take("k", limit=2, window_seconds=60) == 2
2561 < 2 +    with pytest.raises(quota.QuotaExceededError) as err:
2562 < 2 +        quota.take("k", limit=2, window_seconds=60)
2563 < 2 +    assert "k" in str(err.value)
2564 < 2 +    assert "2" in str(err.value)
2565 < 2 +
2566 < 2 +
2567 < 2 +def test_hits_older_than_the_window_are_pruned():
2568 < 2 +    quota.reset()
2569 < 2 +    assert quota.take("k", 2, 60) == 1
2570 < 2 +    assert quota.take("k", 2, 60) == 2
2571 < 2 +    quota.advance(61)
2572 < 2 +    assert quota.take("k", 2, 60) == 1
2573 < 2 +
2574 < 2 +    # A hit recorded at t=30 still counts at t=61 but not at t=91: pruning
2575 < 2 +    # drops hits strictly older than now - window_seconds.
2576 < 2 +    quota.reset()
2577 < 2 +    quota.advance(30)
2578 < 2 +    assert quota.take("mid", 1, 60) == 1
2579 < 2 +    quota.advance(31)
2580 < 2 +    with pytest.raises(quota.QuotaExceededError):
2581 < 2 +        quota.take("mid", 1, 60)
2582 < 2 +    quota.advance(30)
2583 < 2 +    assert quota.take("mid", 1, 60) == 1
2584 < 2 +
2585 < 2 +
2586 < 2 +def test_infinite_window_never_prunes():
2587 < 2 +    quota.reset()
2588 < 2 +    assert quota.take("k", 1, INF) == 1
2589 < 2 +    with pytest.raises(quota.QuotaExceededError):
2590 < 2 +        quota.take("k", 1, INF)
2591 < 2 +    quota.advance(10 ** 6)
2592 < 2 +    with pytest.raises(quota.QuotaExceededError):
2593 < 2 +        quota.take("k", 1, INF)
2594 < 2 +
2595 < 2 +
2596 < 2 +def test_burst_adds_headroom_and_defaults_to_zero():
2597 < 2 +    quota.reset()
2598 < 2 +    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 1
2599 < 2 +    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 2
2600 < 2 +    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 3
2601 < 2 +    with pytest.raises(quota.QuotaExceededError):
2602 < 2 +        quota.take("k", limit=2, window_seconds=60, burst=1)
2603 < 2 +
2604 < 2 +    quota.reset()
2605 < 2 +    assert quota.take("d", limit=2, window_seconds=60) == 1
2606 < 2 +    assert quota.take("d", limit=2, window_seconds=60) == 2
2607 < 2 +    with pytest.raises(quota.QuotaExceededError):
2608 < 2 +        quota.take("d", limit=2, window_seconds=60)
