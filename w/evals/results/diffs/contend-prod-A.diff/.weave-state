1387 < 2 @@ -0,0 +1,89 @@
1388 < 2 +"""Per-route throttling policies over `app.quota`.
1389 < 2 +
1390 < 2 +A library layer for future routes: it is deliberately NOT wired into the
1391 < 2 +registry. Policy keys are "<METHOD> <path-prefix>" strings mapping to a
1392 < 2 +{"limit", "window", "burst"} dict; `match_policy` resolves a request to the
1393 < 2 +policy with the longest matching prefix.
1394 < 2 +
1395 < 2 +This module imports `app.quota` only — never `app.ratelimit` — and holds no
1396 < 2 +state of its own beyond the `POLICIES` constant; all counting lives in the
1397 < 2 +quota store.
1398 < 2 +"""
1399 < 2 +from app import quota
1400 < 2 +
1401 < 2 +
1402 < 2 +class PolicyError(Exception):
1403 < 2 +    """Raised when a request exceeds its matched throttling policy."""
1404 < 2 +
1405 < 2 +
1406 < 2 +POLICIES = {
1407 < 2 +    "POST /records": {"limit": 5, "window": 60, "burst": 0},
1408 < 2 +    "GET /export": {"limit": 10, "window": 60, "burst": 2},
1409 < 2 +}
1410 < 2 +
1411 < 2 +
1412 < 2 +def _policies(policies):
1413 < 2 +    return POLICIES if policies is None else policies
1414 < 2 +
1415 < 2 +
1416 < 2 +def match_policy(method, path, policies=None):
1417 < 2 +    """Return the policy for `method` + `path`, or None if none matches.
1418 < 2 +
1419 < 2 +    A policy key matches when its method is exactly `method` and its path
1420 < 2 +    prefix is a prefix of `path`; the longest matching prefix wins."""
1421 < 2 +    best_prefix = None
1422 < 2 +    best_policy = None
1423 < 2 +    for key, policy in _policies(policies).items():
1424 < 2 +        key_method, _, prefix = key.partition(" ")
1425 < 2 +        if key_method != method or not path.startswith(prefix):
1426 < 2 +            continue
1427 < 2 +        if best_prefix is None or len(prefix) > len(best_prefix):
1428 < 2 +            best_prefix = prefix
1429 < 2 +            best_policy = policy
1430 < 2 +    return best_policy
1431 < 2 +
1432 < 2 +
1433 < 2 +def key_for(method, path, actor):
1434 < 2 +    """The quota key a (method, path, actor) triple counts against."""
1435 < 2 +    return "%s %s:%s" % (method, path, actor)
1436 < 2 +
1437 < 2 +
1438 < 2 +def enforce(method, path, actor, policies=None):
1439 < 2 +    """Record a hit against the matched policy and return the count.
1440 < 2 +
1441 < 2 +    Returns None (recording nothing) when no policy matches; raises
1442 < 2 +    PolicyError when the matched policy is exhausted."""
1443 < 2 +    policy = match_policy(method, path, policies)
1444 < 2 +    if policy is None:
1445 < 2 +        return None
1446 < 2 +    key = key_for(method, path, actor)
1447 < 2 +    try:
1448 < 2 +        return quota.take(key, policy["limit"], policy["window"],
1449 < 2 +                          burst=policy.get("burst", 0))
1450 < 2 +    except quota.QuotaExceededError as err:
1451 < 2 +        raise PolicyError("policy limit exceeded for %s: limit %s" % (
1452 < 2 +            key, policy["limit"])) from err
1453 < 2 +
1454 < 2 +
1455 < 2 +def remaining_for(method, path, actor, policies=None):
1456 < 2 +    """How many calls the matched policy still allows, or None if no policy
1457 < 2 +    matches. Records nothing."""
1458 < 2 +    policy = match_policy(method, path, policies)
1459 < 2 +    if policy is None:
1460 < 2 +        return None
1461 < 2 +    return quota.remaining(key_for(method, path, actor), policy["limit"],
1462 < 2 +                           policy["window"], burst=policy.get("burst", 0))
1463 < 2 +
1464 < 2 +
1465 < 2 +def describe_policies(policies=None):
1466 < 2 +    """Render the policy table as one sorted line per key, or the literal
1467 < 2 +    "(no policies)" when the table is empty."""
1468 < 2 +    table = _policies(policies)
1469 < 2 +    if not table:
1470 < 2 +        return "(no policies)"
1471 < 2 +    return "\n".join(
1472 < 2 +        "%s: limit=%s, window=%s, burst=%s" % (
1473 < 2 +            key, table[key]["limit"], table[key]["window"],
1474 < 2 +            table[key].get("burst", 0))
1475 < 2 +        for key in sorted(table)
1476 < 2 +    )
