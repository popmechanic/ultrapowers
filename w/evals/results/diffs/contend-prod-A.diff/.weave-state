3576 < 2 +    assert issubclass(throttle.PolicyError, Exception)
3577 < 2 +
3578 < 2 +
3579 < 2 +def test_policies_constant_is_pinned():
3580 < 2 +    quota.reset()
3581 < 2 +    assert throttle.POLICIES == {
3582 < 2 +        "POST /records": {"limit": 5, "window": 60, "burst": 0},
3583 < 2 +        "GET /export": {"limit": 10, "window": 60, "burst": 2},
3584 < 2 +    }
3585 < 2 +
3586 < 2 +
3587 < 2 +def test_match_policy_picks_the_longest_matching_prefix():
3588 < 2 +    quota.reset()
3589 < 2 +    assert throttle.match_policy("GET", "/export/full", throttle.POLICIES) == \
3590 < 2 +        throttle.POLICIES["GET /export"]
3591 < 2 +
3592 < 2 +    longer = dict(throttle.POLICIES)
3593 < 2 +    longer["GET /export/full"] = {"limit": 1, "window": 5, "burst": 0}
3594 < 2 +    assert throttle.match_policy("GET", "/export/full", longer) == \
3595 < 2 +        longer["GET /export/full"]
3596 < 2 +
3597 < 2 +    assert throttle.match_policy("POST", "/export", throttle.POLICIES) is None
3598 < 2 +
3599 < 2 +
3600 < 2 +def test_key_for_renders_method_path_and_actor():
3601 < 2 +    quota.reset()
3602 < 2 +    assert throttle.key_for("POST", "/records", "mallory") == \
3603 < 2 +        "POST /records:mallory"
3604 < 2 +
3605 < 2 +
3606 < 2 +def test_enforce_delegates_to_quota_take_and_ignores_unmatched_routes(monkeypatch):
3607 < 2 +    quota.reset()
3608 < 2 +    assert throttle.enforce("DELETE", "/records", "a", throttle.POLICIES) is None
3609 < 2 +    assert quota.take("DELETE /records:a", 1, 60) == 1
3610 < 2 +
3611 < 2 +    calls = []
3612 < 2 +
3613 < 2 +    def recorder(*args, **kwargs):
3614 < 2 +        calls.append((args, kwargs))
3615 < 2 +        return 1
3616 < 2 +
3617 < 2 +    monkeypatch.setattr(quota, "take", recorder)
3618 < 2 +    assert throttle.enforce("GET", "/export/full", "mallory",
3619 < 2 +                            throttle.POLICIES) == 1
3620 < 2 +    assert calls == [(("GET /export/full:mallory", 10, 60), {"burst": 2})]
3621 < 2 +
3622 < 2 +
3623 < 2 +def test_enforce_raises_policy_error_when_the_policy_is_exhausted():
3624 < 2 +    quota.reset()
3625 < 2 +    assert throttle.enforce("POST", "/records", "mallory", ONE_PER_WINDOW) == 1
3626 < 2 +    with pytest.raises(throttle.PolicyError) as err:
3627 < 2 +        throttle.enforce("POST", "/records", "mallory", ONE_PER_WINDOW)
3628 < 2 +    assert "POST /records:mallory" in str(err.value)
3629 < 2 +    assert "1" in str(err.value)
3630 < 2 +    assert isinstance(err.value.__cause__, quota.QuotaExceededError)
3631 < 2 +
3632 < 2 +
3633 < 2 +def test_remaining_for_is_read_only_and_none_without_a_policy():
3634 < 2 +    quota.reset()
3635 < 2 +    assert throttle.remaining_for("DELETE", "/records", "a",
3636 < 2 +                                  throttle.POLICIES) is None
3637 < 2 +    assert throttle.remaining_for("POST", "/records", "mallory",
3638 < 2 +                                  ONE_PER_WINDOW) == 1
3639 < 2 +    assert throttle.remaining_for("POST", "/records", "mallory",
3640 < 2 +                                  ONE_PER_WINDOW) == 1
3641 < 2 +    assert throttle.enforce("POST", "/records", "mallory", ONE_PER_WINDOW) == 1
3642 < 2 +    assert throttle.remaining_for("POST", "/records", "mallory",
3643 < 2 +                                  ONE_PER_WINDOW) == 0
3644 < 2 +
3645 < 2 +
3646 < 2 +def test_describe_policies_renders_sorted_lines():
