1227 < 2 +"""Column-model toolkit shared by every export format.
1228 < 2 +
1229 < 2 +`app/export.py` builds all of its formats on these helpers, so the key
1230 < 2 +union, the `str()` rendering of a cell, and the per-format escaping live
1231 < 2 +here exactly once. Every helper that takes a `value` renders it through
1232 < 2 +`cell` first, which means `None` is uniformly an empty cell.
1233 < 2 +
1234 < 2 +Alignment is spelled with the strings "left" and "right"; `pad` is the one
1235 < 2 +place that vocabulary is validated, and everything that aligns (`fit`,
1236 < 2 +`render_row`, and `export.to_markdown`) delegates to it rather than
1237 < 2 +repeating the check.
1238 < 2 +"""
1239 < 2 +
1240 < 2 +ALIGNMENTS = ("left", "right")
1241 < 2 +
1242 < 2 +
1243 < 2 +def columns(records):
1244 < 2 +    """The sorted union of every key across `records`.
1245 < 2 +
1246 < 2 +    Records need not share a key set; a key present on any record earns a
1247 < 2 +    column, and `columns([])` is `[]` (an empty export has no columns)."""
1248 < 2 +    names = set()
1249 < 2 +    for record in records:
1250 < 2 +        names.update(record)
1251 < 2 +    return sorted(names)
1252 < 2 +
1253 < 2 +
1254 < 2 +def cell(value):
1255 < 2 +    """Render one value as text: `None` is the empty cell, everything else
1256 < 2 +    is plain `str()` (so an int renders without a trailing `.0`)."""
1257 < 2 +    if value is None:
1258 < 2 +        return ""
1259 < 2 +    return str(value)
1260 < 2 +
1261 < 2 +
1262 < 2 +def escape_csv(value):
1263 < 2 +    """Render `value` as a CSV cell, quoting only when it has to.
1264 < 2 +
1265 < 2 +    A cell containing a comma, a double-quote, or a newline is wrapped in
1266 < 2 +    double-quotes with its inner quotes doubled; anything else — including
1267 < 2 +    the empty cell — is returned as rendered."""
1268 < 2 +    text = cell(value)
1269 < 2 +    if any(ch in text for ch in (",", '"', "\n")):
1270 < 2 +        return '"' + text.replace('"', '""') + '"'
1271 < 2 +    return text
1272 < 2 +
1273 < 2 +
1274 < 2 +def widths(records, cols):
1275 < 2 +    """Map each column in `cols` to its display width: the longer of the
1276 < 2 +    column name and the widest rendered cell in that column."""
1277 < 2 +    result = {}
1278 < 2 +    for col in cols:
1279 < 2 +        widest = len(col)
1280 < 2 +        for record in records:
1281 < 2 +            widest = max(widest, len(cell(record.get(col))))
1282 < 2 +        result[col] = widest
1283 < 2 +    return result
1284 < 2 +
1285 < 2 +
1286 < 2 +def pad(value, width, align):
1287 < 2 +    """Pad a rendered value out to `width` per `align`.
1288 < 2 +
1289 < 2 +    A value already at or beyond `width` is returned unchanged — padding
1290 < 2 +    never truncates; use `truncate` or `fit` for that. `align` is validated
1291 < 2 +    before the width is even looked at, so an unknown alignment is reported
1292 < 2 +    rather than silently accepted on a value that needed no padding."""
1293 < 2 +    if align not in ALIGNMENTS:
1294 < 2 +        raise ValueError("unknown align: %s" % (align,))
1295 < 2 +    text = cell(value)
1296 < 2 +    if len(text) >= width:
1297 < 2 +        return text
1298 < 2 +    filler = " " * (width - len(text))
1299 < 2 +    if align == "left":
1300 < 2 +        return text + filler
1301 < 2 +    return filler + text
1302 < 2 +
1303 < 2 +
1304 < 2 +def sanitize_flat(value):
1305 < 2 +    """Render `value` for a single-line, character-delimited format: every
1306 < 2 +    tab and newline becomes one space so the grid can't be broken from
1307 < 2 +    inside a cell. A value with neither passes through unchanged."""
1308 < 2 +    text = cell(value)
1309 < 2 +    return text.replace("\t", " ").replace("\n", " ")
1310 < 2 +
1311 < 2 +
1312 < 2 +def escape_html(value):
1313 < 2 +    """Render `value` as HTML text content. The ampersand is escaped first
1314 < 2 +    so the escapes this introduces are not themselves re-escaped."""
1315 < 2 +    text = cell(value)
