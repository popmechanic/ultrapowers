2651 < 2 +def test_snapshot_lists_in_window_hits_per_key_and_is_a_deep_copy():
2652 < 2 +    quota.reset()
2653 < 2 +    quota.take("a", 5, 60)
2654 < 2 +    quota.advance(30)
2655 < 2 +    quota.take("a", 5, 60)
2656 < 2 +    quota.take("b", 5, 60)
2657 < 2 +    quota.advance(31)
2658 < 2 +    quota.take("b", 5, 60)
2659 < 2 +    assert quota.snapshot(60) == {"a": [30.0], "b": [30.0, 61.0]}
2660 < 2 +
2661 < 2 +    snap = quota.snapshot(60)
2662 < 2 +    snap["a"].append(999.0)
2663 < 2 +    assert quota.snapshot(60) == {"a": [30.0], "b": [30.0, 61.0]}
2664 < 2 +    assert quota.remaining("a", 5, 60) == 4
