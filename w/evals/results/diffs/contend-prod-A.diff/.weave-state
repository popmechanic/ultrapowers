594 < 2 +++ b/app/quota.py
595 < 2 @@ -0,0 +1,137 @@
596 < 2 +"""Windowed quota counter over a deterministic logical clock.
597 < 2 +
598 < 2 +This module owns all counting state for the rate-limit feature: a module
599 < 2 +global clock (`_clock`, seconds as a float) and a module global hits store
600 < 2 +(`_hits`, key -> list of hit timestamps). No wall-clock time is read
601 < 2 +anywhere, so behavior is fully deterministic: the clock only moves when a
602 < 2 +caller calls `advance()`, which makes tests reproducible and makes shipped
603 < 2 +behavior pure call-counting.
604 < 2 +
605 < 2 +A hit is "in window" when it is not strictly older than `now() -
606 < 2 +window_seconds`; a hit sitting exactly on that boundary still counts. A
607 < 2 +`window_seconds` of `float("inf")` therefore never prunes anything.
608 < 2 +
609 < 2 +`remaining`, `snapshot`, `time_to_next_slot` and `usage` are read-only:
610 < 2 +they never record a hit and never mutate the store.
611 < 2 +"""
612 < 2 +
613 < 2 +
614 < 2 +class QuotaExceededError(Exception):
615 < 2 +    """Raised when a key has no allowance left in the current window."""
616 < 2 +
617 < 2 +
618 < 2 +_clock = 0.0
619 < 2 +_hits = {}
620 < 2 +
621 < 2 +
622 < 2 +def reset():
623 < 2 +    """Reset the logical clock to 0.0 and drop every key's hits."""
624 < 2 +    global _clock
625 < 2 +    _clock = 0.0
626 < 2 +    _hits.clear()
627 < 2 +
628 < 2 +
629 < 2 +def now():
630 < 2 +    """Return the current logical clock value, in seconds."""
631 < 2 +    return _clock
632 < 2 +
633 < 2 +
634 < 2 +def advance(seconds):
635 < 2 +    """Move the logical clock forward by `seconds` and return the new value.
636 < 2 +
637 < 2 +    The clock is monotonic: a negative `seconds` raises ValueError and
638 < 2 +    leaves the clock unchanged."""
639 < 2 +    global _clock
640 < 2 +    if seconds < 0:
641 < 2 +        raise ValueError("clock is monotonic: cannot advance by %r" % (seconds,))
642 < 2 +    _clock = float(_clock + seconds)
643 < 2 +    return _clock
644 < 2 +
645 < 2 +
646 < 2 +def _cutoff(window_seconds):
647 < 2 +    """The oldest timestamp still in window (hits strictly older drop)."""
648 < 2 +    if window_seconds == float("inf"):
649 < 2 +        return float("-inf")
650 < 2 +    return _clock - window_seconds
651 < 2 +
652 < 2 +
653 < 2 +def _in_window(key, window_seconds):
654 < 2 +    """The key's in-window hits, oldest first. Does not mutate the store."""
655 < 2 +    cutoff = _cutoff(window_seconds)
656 < 2 +    return [hit for hit in _hits.get(key, ()) if hit >= cutoff]
657 < 2 +
658 < 2 +
659 < 2 +def take(key, limit, window_seconds, burst=0):
660 < 2 +    """Record a hit for `key` and return its in-window hit count.
661 < 2 +
662 < 2 +    Raises QuotaExceededError when `key` already holds `limit + burst`
663 < 2 +    in-window hits. Aged-out hits are pruned from the store as a side
664 < 2 +    effect of the call."""
665 < 2 +    hits = _in_window(key, window_seconds)
666 < 2 +    allowed = limit + burst
667 < 2 +    if len(hits) >= allowed:
668 < 2 +        _hits[key] = hits
669 < 2 +        raise QuotaExceededError(
670 < 2 +            "quota exceeded for %s: limit %s" % (key, limit))
671 < 2 +    hits.append(_clock)
672 < 2 +    _hits[key] = hits
673 < 2 +    return len(hits)
674 < 2 +
675 < 2 +
676 < 2 +def remaining(key, limit, window_seconds, burst=0):
677 < 2 +    """How many takes `key` has left, floored at 0. Records nothing."""
678 < 2 +    used = len(_in_window(key, window_seconds))
679 < 2 +    return max(0, limit + burst - used)
680 < 2 +
681 < 2 +
682 < 2 +def snapshot(window_seconds):
683 < 2 +    """Map every key with at least one in-window hit to its sorted in-window
684 < 2 +    hit timestamps. The returned lists are copies: mutating them does not
685 < 2 +    affect the store."""
686 < 2 +    result = {}
687 < 2 +    for key in _hits:
688 < 2 +        hits = _in_window(key, window_seconds)
689 < 2 +        if hits:
690 < 2 +            result[key] = sorted(hits)
691 < 2 +    return result
692 < 2 +
693 < 2 +
694 < 2 +def time_to_next_slot(key, limit, window_seconds, burst=0):
695 < 2 +    """Seconds until `key` regains an allowance. Records nothing.
696 < 2 +
697 < 2 +    Returns 0.0 while allowance is left. When exhausted, returns
698 < 2 +    `oldest_in_window_hit + window_seconds - now()` — the instant the oldest
699 < 2 +    hit ages out. Because that hit is still in window at exactly that
700 < 2 +    instant, a 0.0 reading means the slot is about to free: callers retry
701 < 2 +    strictly after it. Returns float("inf") when no hit can ever free a slot
702 < 2 +    (an infinite window, or a zero allowance that can hold no hits)."""
703 < 2 +    if remaining(key, limit, window_seconds, burst=burst) > 0:
704 < 2 +        return 0.0
705 < 2 +    hits = _in_window(key, window_seconds)
706 < 2 +    if not hits or window_seconds == float("inf"):
707 < 2 +        return float("inf")
708 < 2 +    return min(hits) + window_seconds - _clock
709 < 2 +
710 < 2 +
711 < 2 +def usage(key, limit, window_seconds, burst=0):
712 < 2 +    """Report `key`'s full quota state as a dict. Records nothing."""
713 < 2 +    return {
714 < 2 +        "used": len(_in_window(key, window_seconds)),
715 < 2 +        "allowed": limit + burst,
716 < 2 +        "remaining": remaining(key, limit, window_seconds, burst=burst),
717 < 2 +        "reset_in": time_to_next_slot(key, limit, window_seconds, burst=burst),
718 < 2 +    }
719 < 2 +
720 < 2 +
721 < 2 +def purge(window_seconds):
722 < 2 +    """Drop every key's aged-out hits, remove keys left with none, and
723 < 2 +    return the total number of hits dropped."""
724 < 2 +    dropped = 0
725 < 2 +    for key in list(_hits):
726 < 2 +        kept = _in_window(key, window_seconds)
727 < 2 +        dropped += len(_hits[key]) - len(kept)
728 < 2 +        if kept:
729 < 2 +            _hits[key] = kept
730 < 2 +        else:
731 < 2 +            del _hits[key]
732 < 2 +    return dropped
