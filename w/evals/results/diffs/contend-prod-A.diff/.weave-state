2526 < 2 +"""Tests for app/quota.py — the windowed counter over a logical clock."""
2527 < 2 +import pytest
2528 < 2 +
2529 < 2 +from app import quota
2530 < 2 +
2531 < 2 +
2532 < 2 +INF = float("inf")
2533 < 2 +
2534 < 2 +
2535 < 2 +@pytest.fixture(autouse=True)
2536 < 2 +def _clean_quota_state():
2537 < 2 +    """Leave no module-global quota state behind for later test files."""
2538 < 2 +    yield
2539 < 2 +    quota.reset()
