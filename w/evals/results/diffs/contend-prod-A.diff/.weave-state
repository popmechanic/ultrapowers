1009 < 2 +++ b/app/schema.py
1010 < 2 @@ -0,0 +1,210 @@
1011 < 2 +"""Declarative validation toolkit: the shared error catalog, the field
1012 < 2 +predicates every validator is built from, and a small spec algebra.
1013 < 2 +
1014 < 2 +A *spec* is a dict mapping a field name to a rules dict. The only legal
1015 < 2 +rule keys are:
1016 < 2 +
1017 < 2 +    "required"    bool   the field must be present
1018 < 2 +    "type"        str    "str" or "number"
1019 < 2 +    "non_empty"   bool   value must be a string with non-whitespace content
1020 < 2 +    "max"         number value must be <= the limit
1021 < 2 +
1022 < 2 +Rules on a present field are always evaluated in the fixed order
1023 < 2 +``type`` -> ``non_empty`` -> ``max`` so a field yields at most one error and
1024 < 2 +always the most fundamental one.
1025 < 2 +"""
1026 < 2 +import math
1027 < 2 +
1028 < 2 +
1029 < 2 +ERROR_CATALOG = {
1030 < 2 +    "missing": "missing field: {field}",
1031 < 2 +    "numeric": "field {field} must be numeric (got {got})",
1032 < 2 +    "non_negative": "field {field} must be non-negative",
1033 < 2 +    "max": "field {field} exceeds max_amount {limit}",
1034 < 2 +    "non_empty": "field {field} must be a non-empty string",
1035 < 2 +    "type_str": "field {field} must be a string",
1036 < 2 +}
1037 < 2 +
1038 < 2 +LEGAL_RULE_KEYS = ("required", "type", "non_empty", "max")
1039 < 2 +LEGAL_TYPES = ("str", "number")
1040 < 2 +RULE_ORDER = ("type", "non_empty", "max")
1041 < 2 +
1042 < 2 +
1043 < 2 +class SchemaError(Exception):
1044 < 2 +    """Raised by a compiled validator when a field violates its spec."""
1045 < 2 +
1046 < 2 +
1047 < 2 +def format_error(code, **params):
1048 < 2 +    """Render the catalog message for `code`. Unknown codes raise KeyError
1049 < 2 +    rather than degrading to a generic message."""
1050 < 2 +    return ERROR_CATALOG[code].format(**params)
1051 < 2 +
1052 < 2 +
1053 < 2 +def check_required(fields, required_fields):
1054 < 2 +    """Names from `required_fields` absent from `fields`, in
1055 < 2 +    required_fields order (never the dict's insertion order)."""
1056 < 2 +    return [name for name in required_fields if name not in fields]
1057 < 2 +
