50 < 2 diff --git a/apistub/store.py b/apistub/store.py
51 < 2 new file mode 100644
52 < 2 index 0000000..0e8915b
53 < 2 --- /dev/null
54 < 2 +++ b/apistub/store.py
55 < 2 @@ -0,0 +1,21 @@
56 < 2 +from apistub.schema import User
57 < 2 +
58 < 2 +SCHEMA_VERSION = 2  # wire schema version embedded by serialization
59 < 2 +
60 < 2 +
61 < 2 +class InMemoryStore:
62 < 2 +    def __init__(self):
63 < 2 +        self._users = {}
64 < 2 +        self._next = 1
65 < 2 +
66 < 2 +    def add(self, name, email):
67 < 2 +        user = User(self._next, name, email)
68 < 2 +        self._users[self._next] = user
69 < 2 +        self._next += 1
70 < 2 +        return user
71 < 2 +
72 < 2 +    def get(self, user_id):
73 < 2 +        return self._users.get(user_id)
74 < 2 +
75 < 2 +    def all(self):
76 < 2 +        return list(self._users.values())
77 < 2 diff --git a/apistub/validate.py b/apistub/validate.py
78 < 2 new file mode 100644
79 < 2 index 0000000..2fe4f0f
80 < 2 --- /dev/null
81 < 2 +++ b/apistub/validate.py
82 < 2 @@ -0,0 +1,14 @@
83 < 2 +from apistub import schema
84 < 2 +
85 < 2 +
86 < 2 +def validate_payload(payload):
87 < 2 +    errors = []
88 < 2 +    for key, typ in schema.FIELDS.items():
89 < 2 +        if key not in payload:
90 < 2 +            errors.append(f"missing: {key}")
91 < 2 +        elif not isinstance(payload[key], typ):
92 < 2 +            errors.append(f"wrong type: {key}")
93 < 2 +    email = payload.get("email")
94 < 2 +    if isinstance(email, str) and "@" not in email:
95 < 2 +        errors.append("invalid: email")
96 < 2 +    return errors
