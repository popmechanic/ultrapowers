107 < 2 +
108 < 2 +
109 < 2 +def test_post_and_get():
110 < 2 +    s = InMemoryStore()
111 < 2 +    code, body = route(s, "POST", "/users", {"name": "Ada", "email": "ada@ex.com"})
112 < 2 +    assert code == 201 and json.loads(body)["id"] == 1
113 < 2 +    code, body = route(s, "GET", "/users/1", None)
114 < 2 +    assert code == 200 and json.loads(body)["name"] == "Ada"
115 < 2 +    assert route(s, "GET", "/users/9", None) == (404, "{}")
116 < 2 +
117 < 2 +
