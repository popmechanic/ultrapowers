134 < 2 +    assert isinstance(result, list)
135 < 2 +
136 < 2 +
137 < 2 +def test_clamp_returns_first_limit_rows():
138 < 2 +    rows = [("ada", 3), ("bob", 5), ("eve", 1)]
139 < 2 +    assert clamp(rows, 1) == [("ada", 3)]
