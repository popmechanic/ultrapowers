195 < 2 +
196 < 2 +
197 < 2 +def test_pad_exact_width():
198 < 2 +    """pad returns text unchanged when it exactly matches width."""
199 < 2 +    assert pad("abcde", 5) == "abcde"
200 < 2 +
201 < 2 +
202 < 2 +def test_pad_beyond_width():
203 < 2 +    """pad returns text unchanged when it exceeds width."""
204 < 2 +    assert pad("abcdef", 3) == "abcdef"
205 < 2 +
206 < 2 +
