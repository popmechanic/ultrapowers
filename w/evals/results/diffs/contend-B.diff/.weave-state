44 < 2 diff --git a/clitool/textutil.py b/clitool/textutil.py
45 < 2 new file mode 100644
46 < 2 index 0000000..ed8ebeb
47 < 2 --- /dev/null
48 < 2 +++ b/clitool/textutil.py
49 < 2 @@ -0,0 +1,23 @@
50 < 2 +"""Text utility functions."""
51 < 2 +
52 < 2 +
53 < 2 +def pad(text, width):
54 < 2 +    """Pad text with trailing spaces to reach the specified width.
55 < 2 +
56 < 2 +    Args:
57 < 2 +        text: The input string to pad.
58 < 2 +        width: The target width. Must be >= 0.
59 < 2 +
60 < 2 +    Returns:
61 < 2 +        The text padded with trailing spaces, or unchanged if text length >= width.
62 < 2 +
63 < 2 +    Raises:
64 < 2 +        ValueError: If width < 0.
65 < 2 +    """
66 < 2 +    if width < 0:
67 < 2 +        raise ValueError("width must be >= 0")
68 < 2 +
69 < 2 +    if len(text) >= width:
70 < 2 +        return text
71 < 2 +
72 < 2 +    return text + " " * (width - len(text))
