0 < 1 import { createStore } from 'tinybase'
1 < 1 
2 < 1 // The potluck's store module. Every action is a WebMCP-shaped tool:
3 < 1 // a name, the piece it belongs to, a plain description, a typed input
4 < 1 // schema, and run(store, args) -> true when it changed the store.
5 < 1 // A guest's `answer` is '' until they say yes; a dish's `guestId` is ''
6 < 1 // until someone is bringing it.
7 < 1 export const TOOLS = [
9 > 1   {
10 < 1     name: 'setParty',
11 < 1     piece: 'party',
12 < 1     description: 'Name the party and say when it is.',
13 < 1     inputSchema: {
14 < 1       type: 'object',
15 < 1       properties: { title: { type: 'string' }, when: { type: 'string' } },
16 < 1       required: ['title']
17 < 1     },
18 < 1     run: (store, { title, when }) => {
19 < 1       const clean = String(title ?? '').trim()
20 < 1       if (clean === '') return false
21 < 1       store.transaction(() => {
22 < 1         store.setValue('title', clean)
23 < 1         store.setValue('when', String(when ?? '').trim())
24 < 1       })
25 < 1       return true
26 < 1     }
27 < 1   },
8 < 1   {
9 < 1     name: 'addGuest',
10 < 1     piece: 'guest',
11 < 1     description: 'Invite a guest by name; they have not answered yet.',
12 < 1     inputSchema: { type: 'object', properties: { name: { type: 'string' } }, required: ['name'] },
13 < 1     run: (store, { name }) => {
14 < 1       const clean = String(name ?? '').trim()
15 < 1       if (clean === '') return false
16 < 1       const listed = store.getRowIds('guests').some((id) => String(store.getCell('guests', id, 'name')).toLowerCase() === clean.toLowerCase())
17 < 1       if (listed) return false
18 < 1       store.addRow('guests', { name: clean, answer: '' })
19 < 1       return true
20 < 1     }
21 < 1   },
22 < 1   {
23 < 1     name: 'sayYes',
24 < 1     piece: 'guest',
25 < 1     description: 'Mark this guest as coming.',
26 < 1     inputSchema: { type: 'object', properties: { guestId: { type: 'string', 'x-row-of': 'guests' } }, required: ['guestId'] },
27 < 1     run: (store, { guestId }) => {
28 < 1       if (!store.hasRow('guests', guestId)) return false
29 < 1       store.setCell('guests', guestId, 'answer', 'yes')
30 < 1       return true
31 < 1     }
32 < 1   },
33 < 1   {
34 < 1     name: 'addDish',
35 < 1     piece: 'dish',
37 > 1     description: 'List a dish the party needs and how many it serves; nobody is bringing it yet.',
38 < 1     inputSchema: {
39 < 1       type: 'object',
40 < 1       properties: { name: { type: 'string' }, serves: { type: 'number' } },
41 < 1       required: ['name', 'serves']
42 < 1     },
43 < 1     run: (store, { name, serves }) => {
36 < 2     description: 'List a dish the party needs; nobody is bringing it yet.',
37 < 2     inputSchema: { type: 'object', properties: { name: { type: 'string' } }, required: ['name'] },
38 < 2     run: (store, { name }) => {
39 < 1       const clean = String(name ?? '').trim()
40 < 1       if (clean === '') return false
42 > 1       if (typeof serves !== 'number' || !Number.isInteger(serves) || serves < 1) return false
43 < 1       store.addRow('dishes', { name: clean, serves, guestId: '' })
41 < 2       store.addRow('dishes', { name: clean, guestId: '' })
42 < 1       return true
43 < 1     }
44 < 1   },
45 < 1   {
46 < 1     name: 'bringDish',
47 < 1     piece: 'dish',
48 < 1     description: 'Have this guest, who is coming, bring this dish nobody is bringing yet.',
49 < 1     inputSchema: {
50 < 1       type: 'object',
51 < 1       properties: { dishId: { type: 'string', 'x-row-of': 'dishes' }, guestId: { type: 'string', 'x-row-of': 'guests' } },
52 < 1       required: ['dishId', 'guestId']
53 < 1     },
54 < 1     run: (store, { dishId, guestId }) => {
55 < 1       if (!store.hasRow('dishes', dishId) || !store.hasRow('guests', guestId)) return false
56 < 1       if (store.getCell('dishes', dishId, 'guestId') !== '') return false
57 < 1       if (store.getCell('guests', guestId, 'answer') !== 'yes') return false
58 < 1       store.setCell('dishes', dishId, 'guestId', guestId)
59 < 1       return true
60 < 1     }
61 < 1   }
62 < 1 ]
63 < 1 
64 < 1 export function makeStore () {
66 > 1   return createStore()
67 < 1     .setTablesSchema({
68 < 1       guests: { name: { type: 'string' }, answer: { type: 'string', default: '' } },
69 < 1       dishes: { name: { type: 'string' }, serves: { type: 'number' }, guestId: { type: 'string', default: '' } }
70 < 1     })
71 < 1     .setValuesSchema({
72 < 1       title: { type: 'string', default: '' },
73 < 1       when: { type: 'string', default: '' }
74 < 1     })
65 < 2   return createStore().setTablesSchema({
66 < 2     guests: { name: { type: 'string' }, answer: { type: 'string', default: '' } },
68 > 2     dishes: { name: { type: 'string' }, serves: { type: 'number' }, guestId: { type: 'string', default: '' } }
67 < 2     dishes: { name: { type: 'string' }, guestId: { type: 'string', default: '' } }
68 < 2   })
69 < 1 }
70 < 1 