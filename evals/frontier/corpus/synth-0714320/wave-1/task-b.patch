diff --git a/tests/sim_workflow.mjs b/tests/sim_workflow.mjs
index 2bb991701d491ad7b118a9dc0e945d6dae89268a..33b6dc08806a3769778f4aa4a9c1bac410b8d5ae 100644
--- a/tests/sim_workflow.mjs
