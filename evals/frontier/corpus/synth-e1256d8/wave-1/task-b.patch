diff --git a/tests/test_run_acceptance.py b/tests/test_run_acceptance.py
index 58b8091cf8ddbade39ea373123f77b1ac50c63c1..9dde765767ce32f606760157472a2fdd0805777f 100644
--- a/tests/test_run_acceptance.py
