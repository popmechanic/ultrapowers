+    for value in ("filed:", "waived:", "waived: ", "Fixed",
+                  "acked because reasons"):
+        m = tmp_path / "residual-manifest.md"
+        m.write_text(row + " " + value + "\n")
+        r = run("--check", m)
+        assert r.returncode == 2, (value, r.stdout, r.stderr)
+        assert row.split()[1] in r.stderr, value
