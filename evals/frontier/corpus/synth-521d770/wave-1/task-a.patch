+    if t == "tool_use":
+        return ("tool_use", _oneline(b.get("name") or "?"))
+    if t == "tool_result":
+        c = b.get("content")
+        if isinstance(c, list):
+            c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
+        return ("tool_result", _oneline(c if isinstance(c, str) else str(c)))
+    return None
