+    ring.sort(key=lambda e: e["ts"])
+    if len(ring) > RING_MAX:
+        del ring[:-RING_MAX]
+    return {"runId": transcript_dir.name, "ts": time.time(),
+            "agents": agents, "recentEvents": list(ring)}
+
