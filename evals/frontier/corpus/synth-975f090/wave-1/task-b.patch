+    r = Router()
+    r.register("GET", "/x", lambda: "ok")
+    with pytest.raises(RouteAlreadyRegisteredError):
+        r.register("GET", "/x", lambda: "again")
+
+
+def test_routes_lists_sorted_method_path_pairs():
+    r = Router()
+    r.register("GET", "/b", lambda: None)
