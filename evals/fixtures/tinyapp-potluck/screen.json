{
 "root": "page",
 "elements": {
  "page": {
   "type": "Stack",
   "props": {
    "gap": 3
   },
   "children": [
    "title",
    "partyForm",
    "when",
    "guestForm",
    "guests",
    "dishForm",
    "dishes",
    "food"
   ]
  },
  "title": {
   "type": "Heading",
   "props": {
    "text": {
     "$computed": "format",
     "args": {
      "template": "${title}",
      "title": {
       "$computed": "words",
       "args": {
        "value": {
         "$state": "/values/title"
        },
        "words": {
         "": "Potluck"
        }
       }
      }
     }
    },
    "level": 1
   },
   "children": []
  },
  "partyForm": {
   "type": "Row",
   "props": {
    "gap": 2,
    "align": "center"
   },
   "children": [
    "partyName",
    "partyWhen",
    "saveParty"
   ]
  },
  "partyName": {
   "type": "DraftInput",
   "props": {
    "label": "Party name",
    "value": {
     "$bindState": "/draft/title"
    }
   },
   "children": []
  },
  "partyWhen": {
   "type": "DraftInput",
   "props": {
    "label": "When",
    "value": {
     "$bindState": "/draft/when"
    }
   },
   "children": []
  },
  "saveParty": {
   "type": "ActionButton",
   "props": {
    "label": "Save party",
    "action": "setParty",
    "args": {
     "title": {
      "$state": "/draft/title"
     },
     "when": {
      "$state": "/draft/when"
     }
    }
   },
   "on": {
    "press": [
     {
      "action": "setState",
      "params": {
       "statePath": "/draft/title",
       "value": ""
      }
     },
     {
      "action": "setState",
      "params": {
       "statePath": "/draft/when",
       "value": ""
      }
     }
    ]
   },
   "children": []
  },
  "when": {
   "type": "Text",
   "props": {
    "text": {
     "$computed": "format",
     "args": {
      "template": "${when}",
      "when": {
       "$computed": "words",
       "args": {
        "value": {
         "$state": "/values/when"
        },
        "words": {
         "": "No time set yet"
        }
       }
      }
     }
    }
   },
   "children": []
  },
  "guestForm": {
   "type": "Row",
   "props": {
    "gap": 2,
    "align": "center"
   },
   "children": [
    "guestName",
    "invite"
   ]
  },
  "guestName": {
   "type": "DraftInput",
   "props": {
    "label": "Guest name",
    "value": {
     "$bindState": "/draft/addGuest.name"
    }
   },
   "children": []
  },
  "invite": {
   "type": "ActionButton",
   "props": {
    "label": "Invite",
    "action": "addGuest",
    "args": {
     "name": {
      "$state": "/draft/addGuest.name"
     }
    }
   },
   "on": {
    "press": {
     "action": "setState",
     "params": {
      "statePath": "/draft/addGuest.name",
      "value": ""
     }
    }
   },
   "children": []
  },
  "guests": {
   "type": "Stack",
   "props": {
    "gap": 2
   },
   "repeat": {
    "statePath": "/tables/guests",
    "key": "id"
   },
   "children": [
    "guestRow"
   ]
  },
  "guestRow": {
   "type": "Row",
   "props": {
    "gap": 2,
    "align": "center",
    "justify": "between"
   },
   "children": [
    "guestText",
    "yes"
   ]
  },
  "guestText": {
   "type": "Text",
   "props": {
    "text": {
     "$computed": "format",
     "args": {
      "template": "${name} · ${answer}",
      "name": {
       "$item": "name"
      },
      "answer": {
       "$computed": "words",
       "args": {
        "value": {
         "$item": "answer"
        },
        "words": {
         "yes": "Coming",
         "": "No answer yet"
        }
       }
      }
     }
    }
   },
   "children": []
  },
  "yes": {
   "type": "ActionButton",
   "props": {
    "label": {
     "$template": "${name} is coming"
    },
    "action": "sayYes",
    "args": {
     "guestId": {
      "$item": "id"
     }
    }
   },
   "children": []
  },
  "dishForm": {
   "type": "Row",
   "props": {
    "gap": 2,
    "align": "center"
   },
   "children": [
    "dishName",
    "dishServes",
    "addDish"
   ]
  },
  "dishName": {
   "type": "DraftInput",
   "props": {
    "label": "Dish",
    "value": {
     "$bindState": "/draft/addDish.name"
    }
   },
   "children": []
  },
  "dishServes": {
   "type": "DraftNumber",
   "props": {
    "label": "Serves",
    "value": {
     "$bindState": "/draft/serves"
    }
   },
   "children": []
  },
  "addDish": {
   "type": "ActionButton",
   "props": {
    "label": "Add dish",
    "action": "addDish",
    "args": {
     "name": {
      "$state": "/draft/addDish.name"
     },
     "serves": {
      "$state": "/draft/serves"
     }
    }
   },
   "on": {
    "press": [
     {
      "action": "setState",
      "params": {
       "statePath": "/draft/addDish.name",
       "value": ""
      }
     },
     {
      "action": "setState",
      "params": {
       "statePath": "/draft/serves",
       "value": ""
      }
     }
    ]
   },
   "children": []
  },
  "dishes": {
   "type": "Stack",
   "props": {
    "gap": 2
   },
   "repeat": {
    "statePath": "/tables/dishes",
    "key": "id"
   },
   "children": [
    "dishRow"
   ]
  },
  "dishRow": {
   "type": "Row",
   "props": {
    "gap": 2,
    "align": "center",
    "justify": "between"
   },
   "children": [
    "dishText",
    "bring"
   ]
  },
  "dishText": {
   "type": "Text",
   "props": {
    "text": {
     "$computed": "format",
     "args": {
      "template": "${name}, serves ${serves} · ${guestId.name} is bringing it",
      "name": {
       "$item": "name"
      },
      "serves": {
       "$item": "serves"
      },
      "guestId.name": {
       "$computed": "words",
       "args": {
        "value": {
         "$computed": "lookup",
         "args": {
          "rows": {
           "$state": "/tables/guests"
          },
          "id": {
           "$item": "guestId"
          },
          "column": "name"
         }
        },
        "words": {
         "": "Nobody"
        }
       }
      }
     }
    }
   },
   "children": []
  },
  "bring": {
   "type": "ActionSelect",
   "props": {
    "label": {
     "$template": "Who's bringing ${name}?"
    },
    "action": "bringDish",
    "args": {
     "dishId": {
      "$item": "id"
     }
    },
    "pick": "guestId",
    "options": {
     "$computed": "rowsWhere",
     "args": {
      "rows": {
       "$state": "/tables/guests"
      },
      "where": {
       "answer": "yes"
      }
     }
    },
    "optionLabel": "name",
    "value": {
     "$item": "guestId"
    },
    "placeholder": "Nobody yet"
   },
   "children": []
  },
  "food": {
   "type": "Text",
   "props": {
    "text": {
     "$computed": "format",
     "args": {
      "template": "Food for ${sum dishes.serves} · ${count guests answer=yes} coming",
      "sum dishes.serves": {
       "$computed": "sum",
       "args": {
        "rows": {
         "$state": "/tables/dishes"
        },
        "column": "serves"
       }
      },
      "count guests answer=yes": {
       "$computed": "count",
       "args": {
        "rows": {
         "$state": "/tables/guests"
        },
        "where": {
         "answer": "yes"
        }
       }
      }
     }
    }
   },
   "children": []
  }
 }
}
