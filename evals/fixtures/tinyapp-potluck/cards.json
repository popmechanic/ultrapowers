[
 {
  "piece": "party",
  "concept": "party",
  "purpose": "Give the potluck a name and a time.",
  "depends_on": [],
  "state": {
   "tables": {},
   "values": [
    "title",
    "when"
   ]
  },
  "actions": [
   {
    "name": "setParty",
    "description": "Name the party and say when it is.",
    "label": "Save party",
    "inputSchema": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string",
       "x-label": "Party name"
      },
      "when": {
       "type": "string",
       "x-label": "When"
      }
     },
     "required": [
      "title"
     ]
    },
    "refuses": [
     "blank party name"
    ]
   }
  ],
  "shows": [
   {
    "heading": "${title}"
   },
   {
    "text": "${when}"
   }
  ],
  "words": {
   "title": {
    "": "Potluck"
   },
   "when": {
    "": "No time set yet"
   }
  },
  "main_story": "S3"
 },
 {
  "piece": "guest",
  "concept": "guest",
  "purpose": "The host keeps the list of who is invited and who is coming.",
  "depends_on": [],
  "state": {
   "tables": {
    "guests": [
     "name",
     "answer"
    ]
   },
   "values": []
  },
  "actions": [
   {
    "name": "addGuest",
    "description": "Invite a guest by name; they have not answered yet.",
    "label": "Invite",
    "inputSchema": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string",
       "x-label": "Guest name"
      }
     },
     "required": [
      "name"
     ]
    },
    "refuses": [
     "blank guest name",
     "a guest already on the list"
    ]
   },
   {
    "name": "sayYes",
    "description": "Mark this guest as coming.",
    "label": "${name} is coming",
    "inputSchema": {
     "type": "object",
     "properties": {
      "guestId": {
       "type": "string",
       "x-row-of": "guests"
      }
     },
     "required": [
      "guestId"
     ]
    },
    "refuses": [
     "a guest who does not exist"
    ]
   }
  ],
  "shows": [
   {
    "text": "${name} · ${answer}",
    "in": "guests"
   }
  ],
  "words": {
   "answer": {
    "yes": "Coming",
    "": "No answer yet"
   }
  }
 },
 {
  "piece": "dish",
  "concept": "dish",
  "purpose": "Each dish the party needs, and who is bringing it.",
  "depends_on": [
   "guest"
  ],
  "state": {
   "tables": {
    "dishes": [
     "name",
     "serves",
     "guestId"
    ]
   },
   "values": []
  },
  "actions": [
   {
    "name": "addDish",
    "description": "List a dish the party needs and how many it serves; nobody is bringing it yet.",
    "label": "Add dish",
    "inputSchema": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string",
       "x-label": "Dish"
      },
      "serves": {
       "type": "number",
       "x-label": "Serves"
      }
     },
     "required": [
      "name",
      "serves"
     ]
    },
    "refuses": [
     "blank dish name",
     "a dish that serves nobody"
    ]
   },
   {
    "name": "bringDish",
    "description": "Have this guest, who is coming, bring this dish nobody is bringing yet.",
    "label": "Who's bringing ${name}?",
    "inputSchema": {
     "type": "object",
     "properties": {
      "dishId": {
       "type": "string",
       "x-row-of": "dishes"
      },
      "guestId": {
       "type": "string",
       "x-row-of": "guests",
       "x-where": {
        "answer": "yes"
       }
      }
     },
     "required": [
      "dishId",
      "guestId"
     ]
    },
    "refuses": [
     "a dish someone is already bringing",
     "a guest who has not said yes",
     "a dish that does not exist",
     "a guest who does not exist"
    ]
   }
  ],
  "shows": [
   {
    "text": "${name}, serves ${serves} · ${guestId.name} is bringing it",
    "in": "dishes"
   },
   {
    "text": "Food for ${sum dishes.serves} · ${count guests answer=yes} coming"
   }
  ],
  "words": {
   "guestId.name": {
    "": "Nobody"
   }
  }
 }
]
