new file mode 100644
index 0000000..b9d74b4
--- /dev/null
+++ b/tests/test_validation.py
@@ -0,0 +1,208 @@
+"""Tests for app/validation.py -- the record input-validation layer."""
+import pytest
+
+from app import schema, validation
+
+
+REQUIRED = ["name", "amount"]
+MAX = 100
+CONFIG = {"validation_required_fields": REQUIRED, "validation_max_amount": MAX}
+
+
+def test_validation_error_is_an_exception_subclass():
+    assert issubclass(validation.ValidationError, Exception)
+
+
+def test_missing_name_is_reported_by_field_name():
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"amount": 1}, REQUIRED, MAX)
+    assert str(err.value) == "missing field: name"
+
+
+def test_missing_amount_and_both_missing_follow_required_fields_order():
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a"}, REQUIRED, MAX)
+    assert str(err.value) == "missing field: amount"
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({}, REQUIRED, MAX)
+    assert str(err.value) == "missing field: name"
+
+
+def test_string_amount_is_not_numeric():
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a", "amount": "3"}, REQUIRED, MAX)
+    assert "numeric" in str(err.value)
+
+
+def test_bool_amount_is_not_numeric():
+    for value in (True, False):
+        with pytest.raises(validation.ValidationError) as err:
+            validation.validate_fields({"name": "a", "amount": value}, REQUIRED, MAX)
+        assert "numeric" in str(err.value)
+
+
+def test_negative_amount_is_rejected_and_zero_is_accepted():
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a", "amount": -1}, REQUIRED, MAX)
+    assert "non-negative" in str(err.value)
+    assert validation.validate_fields({"name": "a", "amount": 0}, REQUIRED, MAX) == {
+        "name": "a", "amount": 0,
+    }
+
+
+def test_max_amount_boundary():
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a", "amount": MAX + 1}, REQUIRED, MAX)
+    assert "max_amount" in str(err.value)
+    assert validation.validate_fields(
+        {"name": "a", "amount": MAX}, REQUIRED, MAX) == {"name": "a", "amount": MAX}
+
+
+def test_bad_names_are_rejected():
+    for bad in ("", "   ", 42):
+        with pytest.raises(validation.ValidationError) as err:
+            validation.validate_fields({"name": bad, "amount": 1}, REQUIRED, MAX)
+        assert "non-empty string" in str(err.value)
+
+
+def test_success_returns_a_new_stripped_dict_preserving_other_keys():
+    fields = {"name": "  ada  ", "amount": 3, "category": "coffee"}
+    result = validation.validate_fields(fields, REQUIRED, MAX)
+    assert result == {"name": "ada", "amount": 3, "category": "coffee"}
+    assert fields == {"name": "  ada  ", "amount": 3, "category": "coffee"}
+    assert result is not fields
+
+
+def test_extra_keys_pass_through_untouched():
+    fields = {"name": "a", "amount": 1, "extra": "kept", "n": 9}
+    assert validation.validate_fields(fields, REQUIRED, MAX) == {
+        "name": "a", "amount": 1, "extra": "kept", "n": 9,
+    }
+
+
+def test_pre_create_hook_reads_the_config_keys():
+    fields = {"name": " a ", "amount": 1}
+    assert validation.pre_create_hook(None, CONFIG, fields) == (
+        validation.validate_fields(fields, REQUIRED, MAX)
+    )
+    with pytest.raises(validation.ValidationError) as hook_err:
+        validation.pre_create_hook(None, CONFIG, {"name": "a", "amount": MAX + 1})
+    with pytest.raises(validation.ValidationError) as direct_err:
+        validation.validate_fields({"name": "a", "amount": MAX + 1}, REQUIRED, MAX)
+    assert str(hook_err.value) == str(direct_err.value)
+
+
+def test_exact_messages_come_from_the_catalog():
+    def message(fields):
+        with pytest.raises(validation.ValidationError) as err:
+            validation.validate_fields(fields, REQUIRED, MAX)
+        return str(err.value)
+
+    assert message({"amount": 1}) == "missing field: name"
+    assert message({"name": "a", "amount": True}) == (
+        "field amount must be numeric (got bool)"
+    )
+    assert message({"name": "a", "amount": -1}) == (
+        "field amount must be non-negative"
+    )
+    assert message({"name": "a", "amount": MAX + 1}) == (
+        "field amount exceeds max_amount 100"
+    )
+    assert message({"name": 42, "amount": 1}) == (
+        "field name must be a non-empty string"
+    )
+
+
+def test_float_amounts_are_legal_including_the_boundary():
+    assert validation.validate_fields(
+        {"name": "a", "amount": 3.5}, REQUIRED, MAX) == {"name": "a", "amount": 3.5}
+    assert validation.validate_fields(
+        {"name": "a", "amount": float(MAX)}, REQUIRED, MAX) == {
+            "name": "a", "amount": float(MAX)}
+
+
+def test_none_nan_and_infinities_are_not_numeric():
+    for bad in (None, float("nan"), float("inf"), float("-inf")):
+        with pytest.raises(validation.ValidationError) as err:
+            validation.validate_fields({"name": "a", "amount": bad}, REQUIRED, MAX)
+        assert "numeric" in str(err.value)
+
+
+def test_internal_whitespace_and_non_ascii_names_survive():
+    assert validation.validate_fields(
+        {"name": "  ada lovelace  ", "amount": 1}, REQUIRED, MAX)["name"] == (
+            "ada lovelace")
+    assert validation.validate_fields(
+        {"name": "Δ", "amount": 1}, REQUIRED, MAX)["name"] == "Δ"
+
+
+def test_no_required_fields_and_empty_fields_passes():
+    assert validation.validate_fields({}, [], MAX) == {}
+
+
+def test_max_amount_of_zero():
+    assert validation.validate_fields({"name": "a", "amount": 0}, REQUIRED, 0) == {
+        "name": "a", "amount": 0,
+    }
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a", "amount": 1}, REQUIRED, 0)
+    assert "max_amount" in str(err.value)
+
+
+def test_the_returned_dict_is_a_shallow_copy():
+    fields = {"name": "a", "amount": 1, "tags": [1, 2]}
+    result = validation.validate_fields(fields, REQUIRED, MAX)
+    assert result["tags"] is fields["tags"]
+
+
+def test_validate_fields_delegates_to_schema_is_valid_amount(monkeypatch):
+    assert validation.validate_fields({"name": "a", "amount": 1}, REQUIRED, MAX)
+    monkeypatch.setattr(schema, "is_valid_amount", lambda value: False)
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a", "amount": 1}, REQUIRED, MAX)
+    assert "numeric" in str(err.value)
+
+
+def test_validate_many_splits_successes_from_indexed_errors():
+    entries = [
+        {"name": " a ", "amount": 1},
+        {"name": "b", "amount": -1},
+        {"name": "c", "amount": 2},
+        {"amount": 3},
+    ]
+    snapshot = [dict(e) for e in entries]
+    validated, errors = validation.validate_many(entries, REQUIRED, MAX)
+    assert validated == [{"name": "a", "amount": 1}, {"name": "c", "amount": 2}]
+    assert errors == [
+        (1, "field amount must be non-negative"),
+        (3, "missing field: name"),
+    ]
+    assert entries == snapshot
+
+
+def test_error_code_maps_every_catalog_message_back_to_its_code():
+    assert validation.error_code("missing field: name") == "missing"
+    assert validation.error_code("field amount must be numeric (got str)") == "numeric"
+    assert validation.error_code("field amount must be non-negative") == "non_negative"
+    assert validation.error_code("field amount exceeds max_amount 100") == "max"
+    assert validation.error_code("field name must be a non-empty string") == "non_empty"
+    assert validation.error_code("field name must be a string") == "type_str"
+    with pytest.raises(ValueError):
+        validation.error_code("something else entirely")
+
+
+def test_error_code_reads_the_catalog_at_call_time(monkeypatch):
+    monkeypatch.setitem(schema.ERROR_CATALOG, "missing", "no {field} here")
+    assert validation.error_code("no name here") == "missing"
+    with pytest.raises(ValueError):
+        validation.error_code("missing field: name")
