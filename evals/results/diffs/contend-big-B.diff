new file mode 100644
index 0000000..c58f5a5
--- /dev/null
+++ b/tests/test_quota.py
@@ -0,0 +1,202 @@
+"""Tests for app/quota.py -- the windowed hit counter over a deterministic
+logical clock that app/ratelimit.py delegates to."""
+import pytest
+
+from app import quota
+from app.quota import QuotaExceededError
+
+
+def setup_function(_fn):
+    quota.reset()
+
+
+def test_quota_exceeded_error_is_an_exception_subclass():
+    assert issubclass(QuotaExceededError, Exception)
+
+
+def test_clock_starts_at_zero_and_advance_moves_it_forward():
+    assert quota.now() == 0.0
+    assert quota.advance(30) == 30.0
+    assert quota.now() == 30.0
+
+
+def test_advance_with_negative_seconds_raises_and_leaves_clock_unchanged():
+    quota.advance(10)
+    with pytest.raises(ValueError):
+        quota.advance(-1)
+    assert quota.now() == 10.0
+
+
+def test_take_returns_in_window_count_then_raises_with_key_and_limit():
+    assert quota.take("k", limit=2, window_seconds=60) == 1
+    assert quota.take("k", limit=2, window_seconds=60) == 2
+    with pytest.raises(QuotaExceededError) as exc_info:
+        quota.take("k", limit=2, window_seconds=60)
+    message = str(exc_info.value)
+    assert "k" in message
+    assert "2" in message
+
+
+def test_window_pruning_ages_out_old_hits():
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(61)
+    assert quota.take("k", 2, 60) == 1
+
+    quota.reset()
+    quota.advance(30)
+    quota.take("hit30", 2, 60)
+    quota.advance(31)  # now = 61
+    assert quota.remaining("hit30", 1, 60) == 0
+    quota.advance(30)  # now = 91
+    assert quota.remaining("hit30", 1, 60) == 1
+
+
+def test_infinite_window_never_prunes():
+    quota.take("k", 1, float("inf"))
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", 1, float("inf"))
+    quota.advance(10**6)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", 1, float("inf"))
+
+
+def test_burst_allows_extra_hits_burst_defaults_to_zero():
+    quota.take("k", limit=2, window_seconds=60, burst=1)
+    quota.take("k", limit=2, window_seconds=60, burst=1)
+    quota.take("k", limit=2, window_seconds=60, burst=1)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60, burst=1)
+
+
+def test_per_key_independence():
+    quota.take("a", 1, 60)
+    with pytest.raises(QuotaExceededError):
+        quota.take("a", 1, 60)
+    # "b" is untouched by "a"'s exhaustion, same clock and window.
+    assert quota.take("b", 1, 60) == 1
+    with pytest.raises(QuotaExceededError):
+        quota.take("b", 1, 60)
+
+
+def test_reset_clears_clock_and_all_keys_hits():
+    quota.advance(5)
+    quota.take("k", 1, 60)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", 1, 60)
+    quota.reset()
+    assert quota.now() == 0.0
+    assert quota.take("k", 1, 60) == 1
+
+
+def test_remaining_is_read_only_and_recovers_after_window():
+    assert quota.remaining("k", 2, 60) == 2
+    quota.take("k", 2, 60)
+    assert quota.remaining("k", 2, 60) == 1
+    assert quota.remaining("k", 2, 60) == 1
+    quota.take("k", 2, 60)
+    assert quota.remaining("k", 2, 60) == 0
+    # exhausted -- read-only, doesn't change anything
+    assert quota.remaining("k", 2, 60) == 0
+    quota.advance(61)
+    assert quota.remaining("k", 2, 60) == 2
+    assert quota.take("k", 2, 60) == 1
+
+
+def test_remaining_floors_at_zero_with_burst():
+    quota.take("k", 1, 60, burst=1)
+    quota.take("k", 1, 60, burst=1)
+    assert quota.remaining("k", 1, 60, burst=1) == 0
+
+
+def test_snapshot_returns_exact_dict_and_is_a_deep_copy():
+    quota.take("a", 5, 60)
+    quota.advance(10)
+    quota.take("a", 5, 60)
+    quota.take("b", 5, 60)
+
+    snap = quota.snapshot(60)
+    assert snap == {"a": [0.0, 10.0], "b": [10.0]}
+
+    snap["a"].append(999.0)
+    later = quota.snapshot(60)
+    assert later == {"a": [0.0, 10.0], "b": [10.0]}
+    assert quota.remaining("a", 5, 60) == 3
+
+
+def test_snapshot_omits_aged_out_keys():
+    quota.take("a", 5, 60)
+    quota.advance(61)
+    quota.take("b", 5, 60)
+    assert quota.snapshot(60) == {"b": [61.0]}
+
+
+def test_time_to_next_slot_zero_when_remaining_positive():
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+    quota.take("k", 2, 60)
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+
+
+def test_time_to_next_slot_exact_value_when_exhausted():
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    assert quota.time_to_next_slot("k", 2, 60) == 50.0
+
+
+def test_time_to_next_slot_infinite_window_exhausted_returns_inf():
+    quota.take("k", 1, float("inf"))
+    assert quota.time_to_next_slot("k", 1, float("inf")) == float("inf")
+
+
+def test_time_to_next_slot_zero_allowance_returns_inf_never_raises():
+    assert quota.time_to_next_slot("k", 0, 60) == float("inf")
+
+
+def test_time_to_next_slot_boundary_exactly_at_window_reset_instant():
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(60)
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", 2, 60)
+
+
+def test_usage_exact_dict_in_three_states():
+    assert quota.usage("k", 2, 60) == {
+        "used": 0,
+        "allowed": 2,
+        "remaining": 2,
+        "reset_in": 0.0,
+    }
+
+    quota.take("k", 2, 60)
+    assert quota.usage("k", 2, 60) == {
+        "used": 1,
+        "allowed": 2,
+        "remaining": 1,
+        "reset_in": 0.0,
+    }
+
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    assert quota.usage("k", 2, 60) == {
+        "used": 2,
+        "allowed": 2,
+        "remaining": 0,
+        "reset_in": 50.0,
+    }
+    # read-only
+    assert quota.remaining("k", 2, 60) == 0
+
+
+def test_purge_drops_aged_out_hits_and_returns_count():
+    quota.take("a", 5, 60)
+    quota.take("a", 5, 60)
+    quota.advance(61)
+    quota.take("b", 5, 60)
+
+    dropped = quota.purge(60)
+    assert dropped == 2
+    assert quota.snapshot(60) == {"b": [61.0]}
+    assert quota.purge(60) == 0
diff --git a/tests/test_ratelimit.py b/tests/test_ratelimit.py
new file mode 100644
index 0000000..9ed3834
--- /dev/null
+++ b/tests/test_ratelimit.py
@@ -0,0 +1,207 @@
+"""Tests for app/ratelimit.py -- per-actor POST rate limiting built on
+app/quota.py's windowed counter."""
+import pytest
+
+from app import quota, ratelimit
+from app.quota import QuotaExceededError
+from app.ratelimit import RateLimitExceededError
+
+
+def setup_function(_fn):
+    ratelimit.reset()
+
+
+def test_rate_limit_exceeded_error_is_an_exception_subclass():
+    assert issubclass(RateLimitExceededError, Exception)
+
+
+def test_check_and_increment_counts_up_then_raises_with_key_and_limit():
+    assert ratelimit.check_and_increment("k", 3) == 1
+    assert ratelimit.check_and_increment("k", 3) == 2
+    assert ratelimit.check_and_increment("k", 3) == 3
+    with pytest.raises(RateLimitExceededError) as exc_info:
+        ratelimit.check_and_increment("k", 3)
+    message = str(exc_info.value)
+    assert "k" in message
+    assert "3" in message
+
+
+def test_counter_is_per_key():
+    ratelimit.check_and_increment("a", 1)
+    ratelimit.check_and_increment("b", 1)
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("a", 1)
+    # "b" wasn't touched by "a" exceeding its limit.
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("b", 1)
+
+
+def test_reset_clears_all_keys_not_just_one():
+    ratelimit.check_and_increment("a", 1)
+    ratelimit.check_and_increment("b", 1)
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("a", 1) == 1
+    assert ratelimit.check_and_increment("b", 1) == 1
+
+
+def test_dispatch_hook_never_raises_or_increments_for_get():
+    store, config = None, {"rate_limit_max_per_window": 3}
+    for _ in range(8):
+        ratelimit.dispatch_hook(store, config, "GET", "/records", {})
+    # GET calls never touched the "anonymous" counter used internally.
+    assert ratelimit.check_and_increment("anonymous", 3) == 1
+
+
+def test_dispatch_hook_reads_actor_key_from_kwargs():
+    store, config = None, {"rate_limit_max_per_window": 5}
+    ratelimit.dispatch_hook(store, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(store, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(store, config, "POST", "/records", {"actor": "x"})
+    # "anonymous" (2 hits) and "x" (1 hit) are independent counters.
+    assert quota.remaining("anonymous", 5, 60) == 3
+    assert quota.remaining("x", 5, 60) == 4
+
+
+def test_dispatch_hook_reads_limit_from_config():
+    store = None
+    config1 = {"rate_limit_max_per_window": 1}
+    ratelimit.dispatch_hook(store, config1, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(store, config1, "POST", "/records", {"actor": "a"})
+
+    ratelimit.reset()
+    config2 = {"rate_limit_max_per_window": 2}
+    ratelimit.dispatch_hook(store, config2, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(store, config2, "POST", "/records", {"actor": "a"})
+
+
+def test_ratelimit_reset_also_resets_quota_clock():
+    ratelimit.check_and_increment("k", 1)
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("k", 1)
+    quota.advance(100)
+    ratelimit.reset()
+    assert quota.now() == 0.0
+    assert ratelimit.check_and_increment("k", 1) == 1
+
+
+def test_rate_limit_exceeded_error_subclasses_quota_exceeded_error():
+    assert issubclass(RateLimitExceededError, QuotaExceededError)
+    ratelimit.check_and_increment("k", 1)
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("k", 1)
+    with pytest.raises(QuotaExceededError):
+        ratelimit.check_and_increment("k", 1)
+
+
+def test_check_and_increment_delegates_to_quota_take(monkeypatch):
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", recorder)
+    ratelimit.check_and_increment("k", 3)
+    assert calls == [(("k", 3, float("inf")), {"burst": 0})]
+
+
+def test_windowed_end_to_end_through_the_hook():
+    store = None
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(store, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(store, config, "POST", "/records", {"actor": "a"})
+    quota.advance(61)
+    ratelimit.dispatch_hook(store, config, "POST", "/records", {"actor": "a"})
+
+
+def test_minimal_config_compatibility_only_limit_key_required():
+    store = None
+    config = {"rate_limit_max_per_window": 1}
+    ratelimit.dispatch_hook(store, config, "POST", "/records", {})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(store, config, "POST", "/records", {})
+
+
+def test_burst_through_the_hook():
+    store = None
+    config = {
+        "rate_limit_max_per_window": 1,
+        "rate_limit_burst": 1,
+        "rate_limit_window_seconds": 60,
+    }
+    ratelimit.dispatch_hook(store, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(store, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(store, config, "POST", "/records", {"actor": "a"})
+
+    ratelimit.reset()
+    config_no_burst = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(store, config_no_burst, "POST", "/records", {"actor": "b"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(store, config_no_burst, "POST", "/records", {"actor": "b"})
+
+
+def test_retry_after_delegates_and_end_to_end(monkeypatch):
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 0.0
+
+    monkeypatch.setattr(quota, "time_to_next_slot", recorder)
+    config = {
+        "rate_limit_max_per_window": 3,
+        "rate_limit_window_seconds": 60,
+        "rate_limit_burst": 1,
+    }
+    ratelimit.retry_after("k", config)
+    assert calls == [(("k", 3, 60), {"burst": 1})]
+
+    monkeypatch.undo()
+    store = None
+    config2 = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(store, config2, "POST", "/records", {"actor": "a"})
+    quota.advance(10)
+    assert ratelimit.retry_after("a", config2) == 50.0
+
+
+def test_limit_headers_exact_dict_fresh_and_exhausted():
+    config = {"rate_limit_max_per_window": 2, "rate_limit_burst": 1}
+    assert ratelimit.limit_headers("k", config) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "3",
+        "X-RateLimit-Reset": "0.0",
+    }
+    # fresh key, still succeeds afterwards -- headers recorded no hit
+    assert quota.remaining("k", 2, 60, burst=1) == 3
+
+    config2 = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config2, "POST", "/records", {"actor": "m"})
+    ratelimit.dispatch_hook(None, config2, "POST", "/records", {"actor": "m"})
+    quota.advance(10)
+    assert ratelimit.limit_headers("m", config2) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "0",
+        "X-RateLimit-Reset": "50.0",
+    }
+
+
+def test_status_line_exact_literal_fresh_and_exhausted():
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert ratelimit.status_line("mallory", config) == "mallory: 0/2, reset in 0.0s"
+
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
+    quota.advance(10)
+    assert ratelimit.status_line("mallory", config) == "mallory: 2/2, reset in 50.0s"
+
+
+def test_check_many_exact_dict_no_hits_recorded():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    result = ratelimit.check_many(["a", "b", "c"], config)
+    assert result == {"a": False, "b": True, "c": True}
+    # no hit was recorded for any of them
+    assert ratelimit.check_and_increment("b", 1, window_seconds=60) == 1
