@@ -0,0 +1,186 @@
+"""Tests for `app.audit` — the module-global audit log of dispatched calls.
+
+The log is module state, so every test starts with `audit.clear()`; tests
+must never leak entries into each other.
+"""
+from app import audit
+
+
+CONFIG = {"audit_log_max_entries": 500}
+
+
+def test_entries_on_a_fresh_log_is_empty():
+    audit.clear()
+    assert audit.entries() == []
+
+
+def test_record_appends_exactly_one_entry():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+    ]
+
+
+def test_entries_are_returned_in_call_order():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    audit.record("POST", "/records", "bob", 500)
+    audit.record("DELETE", "/records/1", "carol", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+
+
+def test_entries_returns_a_copy():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    returned = audit.entries()
+    returned.append({"method": "POST", "path": "/x", "actor": "mallory"})
+    returned[0]["actor"] = "mallory"
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+    ]
+
+
+def test_cap_keeps_only_the_last_max_entries():
+    audit.clear()
+    audit.record("GET", "/a", "alice", 3)
+    audit.record("GET", "/b", "bob", 3)
+    audit.record("GET", "/c", "carol", 3)
+    audit.record("GET", "/d", "dan", 3)
+    assert len(audit.entries()) == 3
+    assert audit.entries() == [
+        {"method": "GET", "path": "/b", "actor": "bob"},
+        {"method": "GET", "path": "/c", "actor": "carol"},
+        {"method": "GET", "path": "/d", "actor": "dan"},
+    ]
+
+
+def test_cap_is_enforced_after_every_record_not_just_at_the_end():
+    audit.clear()
+    lengths = []
+    for name in ("a", "b", "c", "d", "e"):
+        audit.record("GET", "/" + name, name, 2)
+        lengths.append(len(audit.entries()))
+    assert lengths == [1, 2, 2, 2, 2]
+
+
+def test_dispatch_hook_defaults_the_actor_to_anonymous():
+    audit.clear()
+    audit.dispatch_hook(None, CONFIG, "GET", "/records", {})
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "anonymous"},
+    ]
+
+
+def test_dispatch_hook_uses_the_actor_kwarg_and_never_logs_record_fields():
+    audit.clear()
+    audit.dispatch_hook(None, CONFIG, "POST", "/records",
+                        {"actor": "bob", "name": "x"})
+    assert audit.entries() == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+    ]
+    assert set(audit.entries()[0]) == {"method", "path", "actor"}
+
+
+def test_dispatch_hook_reads_its_cap_from_config():
+    audit.clear()
+    config = {"audit_log_max_entries": 1}
+    audit.dispatch_hook(None, config, "GET", "/records", {"actor": "alice"})
+    audit.dispatch_hook(None, config, "GET", "/report", {"actor": "bob"})
+    assert audit.entries() == [
+        {"method": "GET", "path": "/report", "actor": "bob"},
+    ]
+
+
+def test_dispatch_hook_fires_for_every_method():
+    audit.clear()
+    audit.dispatch_hook(None, CONFIG, "DELETE", "/records/1", {"actor": "alice"})
+    audit.dispatch_hook(None, CONFIG, "PUT", "/records/1", {"actor": "bob"})
+    assert audit.entries() == [
+        {"method": "DELETE", "path": "/records/1", "actor": "alice"},
+        {"method": "PUT", "path": "/records/1", "actor": "bob"},
+    ]
+
+
+def test_record_many_appends_in_order_capping_after_every_append(monkeypatch):
+    audit.clear()
+    real_record = audit.record
+    lengths = []
+
+    def spy(method, path, actor, max_entries):
+        result = real_record(method, path, actor, max_entries)
+        lengths.append(len(audit.entries()))
+        return result
+
+    monkeypatch.setattr(audit, "record", spy)
+    triples = [
+        ("GET", "/a", "alice"),
+        ("POST", "/b", "bob"),
+        ("GET", "/c", "carol"),
+        ("DELETE", "/d", "dan"),
+    ]
+    assert audit.record_many(triples, 2) == 4
+    assert lengths == [1, 2, 2, 2]
+    assert audit.entries() == [
+        {"method": "GET", "path": "/c", "actor": "carol"},
+        {"method": "DELETE", "path": "/d", "actor": "dan"},
+    ]
+
+
+def test_dropped_counts_evictions_and_is_reset_by_clear():
+    audit.clear()
+    assert audit.dropped() == 0
+    for name in ("a", "b", "c", "d", "e"):
+        audit.record("GET", "/" + name, name, 3)
+    assert audit.dropped() == 2
+    audit.clear()
+    assert audit.dropped() == 0
+
+
+def test_export_state_returns_the_log_and_dropped_count_as_a_copy():
+    audit.clear()
+    audit.record("GET", "/a", "alice", 2)
+    audit.record("GET", "/b", "bob", 2)
+    audit.record("GET", "/c", "carol", 2)
+    state = audit.export_state()
+    assert state == {
+        "entries": [
+            {"method": "GET", "path": "/b", "actor": "bob"},
+            {"method": "GET", "path": "/c", "actor": "carol"},
+        ],
+        "dropped": 1,
+    }
+    state["entries"].append({"method": "GET", "path": "/x", "actor": "mallory"})
+    state["entries"][0]["actor"] = "mallory"
+    assert audit.entries() == [
+        {"method": "GET", "path": "/b", "actor": "bob"},
+        {"method": "GET", "path": "/c", "actor": "carol"},
+    ]
+
+
+def test_import_state_round_trips_and_copies_the_incoming_dict():
+    audit.clear()
+    audit.record("GET", "/a", "alice", 2)
+    audit.record("GET", "/b", "bob", 2)
+    audit.record("GET", "/c", "carol", 2)
+    state = audit.export_state()
+    audit.clear()
+    assert audit.entries() == []
+    assert audit.dropped() == 0
+
+    audit.import_state(state)
+    assert audit.entries() == state["entries"]
+    assert audit.dropped() == 1
+
+    state["entries"].append({"method": "GET", "path": "/x", "actor": "mallory"})
+    state["entries"][0]["actor"] = "mallory"
+    state["dropped"] = 99
+    assert audit.entries() == [
+        {"method": "GET", "path": "/b", "actor": "bob"},
+        {"method": "GET", "path": "/c", "actor": "carol"},
+    ]
+    assert audit.dropped() == 1
