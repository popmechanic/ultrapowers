diff --git a/app/audit.py b/app/audit.py
new file mode 100644
index 0000000..98a854b
--- /dev/null
+++ b/app/audit.py
@@ -0,0 +1,73 @@
+"""Audit log of every dispatched call.
+
+`dispatch_hook` is registered into `registry.DISPATCH_HOOKS`, so it runs
+before EVERY dispatch — unlike rate limiting, the audit log does not
+special-case the method. It always logs: `"audit_log_enabled"` exists in
+DEFAULT_CONFIG as a recorded switch for a future release and is not read
+here.
+
+An entry is exactly `{"method": ..., "path": ..., "actor": ...}`; the
+dispatch kwargs (the record fields) are never logged. The log is a
+module-global list capped at `max_entries` — the oldest entry is evicted
+first, and every eviction bumps the `dropped()` counter.
+"""
+
+_log = []
+_dropped = 0
+
+
+def clear():
+    """Empty the log and reset the dropped counter."""
+    global _dropped
+    del _log[:]
+    _dropped = 0
+
+
+def entries():
+    """Return a copy of the log: neither the returned list nor the entry
+    dicts in it are the live ones, so mutating them is harmless."""
+    return [dict(entry) for entry in _log]
+
+
+def record(method, path, actor, max_entries):
+    """Append one entry and immediately enforce the cap (oldest first)."""
+    global _dropped
+    _log.append({"method": method, "path": path, "actor": actor})
+    while len(_log) > max_entries:
+        del _log[0]
+        _dropped += 1
+
+
+def record_many(triples, max_entries):
+    """Append each `(method, path, actor)` triple in order, enforcing the
+    cap after every append. Returns the number appended — entries that age
+    out immediately still count."""
+    for method, path, actor in triples:
+        record(method, path, actor, max_entries)
+    return len(triples)
+
+
+def dropped():
+    """Number of entries evicted by the cap since the last `clear()`."""
+    return _dropped
+
+
+def export_state():
+    """Serialize the log: `{"entries": [...], "dropped": n}`, copied deeply
+    enough that mutating the result cannot reach the live log."""
+    return {"entries": entries(), "dropped": dropped()}
+
+
+def import_state(state):
+    """Replace the log and the dropped counter from an `export_state()`
+    shaped dict, copying so later mutations of `state` do not leak in."""
+    global _dropped
+    del _log[:]
+    _log.extend(dict(entry) for entry in state["entries"])
+    _dropped = state["dropped"]
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS entry point: log the call, capped by config."""
+    record(method, path, kwargs.get("actor", "anonymous"),
+           config["audit_log_max_entries"])
diff --git a/app/audit_query.py b/app/audit_query.py
new file mode 100644
index 0000000..dba14c0
--- /dev/null
+++ b/app/audit_query.py
@@ -0,0 +1,237 @@
+"""Pure read-side queries over a list of audit entries.
+
+Every function takes the entry list as a plain argument and returns new
+data: nothing here reads or writes the live log, and no input list or entry
+dict is ever mutated. This module deliberately does not import `app.audit`
+— callers compose the two (`audit_query.summary(audit.entries())`).
+
+An entry is `{"method": ..., "path": ..., "actor": ...}`; those three names
+are the only legal field names, and every function that takes a field name
+raises ValueError naming an illegal one.
+"""
+
+FIELDS = ("method", "path", "actor")
+
+REDACTED = "***"
+
+
+def _check_field(field):
+    if field not in FIELDS:
+        raise ValueError("unknown audit field: %s" % (field,))
+    return field
+
+
+def filter_entries(entries, actor=None, method=None, path=None):
+    """Entries matching every criterion given (AND), in original order. No
+    criteria matches everything. The result is always a fresh list."""
+    criteria = [(name, value) for name, value in
+                (("actor", actor), ("method", method), ("path", path))
+                if value is not None]
+    return [dict(entry) for entry in entries
+            if all(entry.get(name) == value for name, value in criteria)]
+
+
+def counts_by(entries, field):
+    """`{value: count}` over one field."""
+    _check_field(field)
+    counts = {}
+    for entry in entries:
+        value = entry[field]
+        counts[value] = counts.get(value, 0) + 1
+    return counts
+
+
+def counts_matrix(entries):
+    """Nested `{method: {actor: count}}`. Only combinations that actually
+    occur appear — no zero-filled cells."""
+    matrix = {}
+    for entry in entries:
+        row = matrix.setdefault(entry["method"], {})
+        actor = entry["actor"]
+        row[actor] = row.get(actor, 0) + 1
+    return matrix
+
+
+def rollup(entries, fields):
+    """Counts nested by each field of `fields`, in order. `fields` must be
+    non-empty, drawn from FIELDS, and free of duplicates."""
+    if not fields:
+        raise ValueError("rollup requires at least one field")
+    seen = set()
+    for field in fields:
+        _check_field(field)
+        if field in seen:
+            raise ValueError("duplicate audit field: %s" % (field,))
+        seen.add(field)
+    leaf = fields[-1]
+    result = {}
+    for entry in entries:
+        node = result
+        for field in fields[:-1]:
+            node = node.setdefault(entry[field], {})
+        value = entry[leaf]
+        node[value] = node.get(value, 0) + 1
+    return result
+
+
+def last_n(entries, n):
+    """The final `n` entries, in order. `n` past the end returns them all."""
+    if n < 0:
+        raise ValueError("n must not be negative: %r" % (n,))
+    start = max(0, len(entries) - n)
+    return [dict(entry) for entry in entries[start:]]
+
+
+def redact(entries, fields):
+    """New entry dicts with each named field replaced by `"***"`."""
+    for field in fields:
+        _check_field(field)
+    redacted = []
+    for entry in entries:
+        copy = dict(entry)
+        for field in fields:
+            copy[field] = REDACTED
+        redacted.append(copy)
+    return redacted
+
+
+def summary(entries):
+    """Totals, per-method and per-actor counts, and copies of the first and
+    last entries (`None` each when there are no entries)."""
+    return {
+        "total": len(entries),
+        "by_method": counts_by(entries, "method"),
+        "by_actor": counts_by(entries, "actor"),
+        "first": dict(entries[0]) if entries else None,
+        "last": dict(entries[-1]) if entries else None,
+    }
+
+
+def recent(entries, config):
+    """The most recent entries, limited by `audit_query_default_limit`."""
+    return last_n(entries, config["audit_query_default_limit"])
+
+
+def paginate(entries, page, per_page):
+    """One 1-based page of entries plus its metadata. A page past the end
+    still reports the real totals, with no items."""
+    if page < 1:
+        raise ValueError("page must be 1 or greater: %r" % (page,))
+    if per_page < 1:
+        raise ValueError("per_page must be 1 or greater: %r" % (per_page,))
+    total = len(entries)
+    start = (page - 1) * per_page
+    return {
+        "page": page,
+        "pages": (total + per_page - 1) // per_page,
+        "total": total,
+        "items": [dict(entry) for entry in entries[start:start + per_page]],
+    }
+
+
+def _count_sections(entries):
+    """The report sections shared by every renderer: `(label, counts)` per
+    section, values sorted alphabetically by the caller."""
+    return [
+        ("method", counts_by(entries, "method")),
+        ("actor", counts_by(entries, "actor")),
+    ]
+
+
+def to_report(entries):
+    """Plain-text report; sections are omitted entirely when empty."""
+    lines = ["audit report", "total: %d" % len(entries)]
+    for label, counts in _count_sections(entries):
+        if not counts:
+            continue
+        lines.append("")
+        lines.append("by %s:" % label)
+        for value in sorted(counts):
+            lines.append("  %s: %d" % (value, counts[value]))
+    return "\n".join(lines)
+
+
+def to_csv_report(entries):
+    """CSV report: one `field,value,count` row per counted value."""
+    lines = ["field,value,count"]
+    for label, counts in _count_sections(entries):
+        for value in sorted(counts):
+            lines.append("%s,%s,%d" % (label, value, counts[value]))
+    return "\n".join(lines)
+
+
+def to_markdown_report(entries):
+    """Markdown pipe table with the same rows as `to_csv_report`."""
+    lines = ["| field | value | count |", "| --- | --- | --- |"]
+    for label, counts in _count_sections(entries):
+        for value in sorted(counts):
+            lines.append("| %s | %s | %d |" % (label, value, counts[value]))
+    return "\n".join(lines)
+
+
+def top_actors(entries, n):
+    """The `n` busiest actors as `(actor, count)`, most first, ties broken
+    by actor name ascending."""
+    if n < 0:
+        raise ValueError("n must not be negative: %r" % (n,))
+    counts = counts_by(entries, "actor")
+    ranked = sorted(counts.items(), key=lambda item: (-item[1], item[0]))
+    return ranked[:n]
+
+
+def merge_entries(*entry_lists):
+    """One new list of entry copies, concatenated in argument order."""
+    merged = []
+    for entries in entry_lists:
+        merged.extend(dict(entry) for entry in entries)
+    return merged
+
+
+def _diff_counts(before, after):
+    """Only the values whose count changed, mapped to the delta. A value
+    missing from either side counts as 0."""
+    deltas = {}
+    for value in list(before) + [v for v in after if v not in before]:
+        delta = after.get(value, 0) - before.get(value, 0)
+        if delta:
+            deltas[value] = delta
+    return deltas
+
+
+def diff_summaries(a, b):
+    """What changed from summary `a` to summary `b`."""
+    return {
+        "total": b["total"] - a["total"],
+        "by_method": _diff_counts(a["by_method"], b["by_method"]),
+        "by_actor": _diff_counts(a["by_actor"], b["by_actor"]),
+    }
+
+
+def group_by(entries, field):
+    """`{value: [entry copies]}`, each bucket in original order."""
+    _check_field(field)
+    grouped = {}
+    for entry in entries:
+        grouped.setdefault(entry[field], []).append(dict(entry))
+    return grouped
+
+
+def search(entries, needle):
+    """Entry copies where `needle` is a substring of any field value."""
+    if not needle:
+        raise ValueError("needle must not be empty")
+    return [dict(entry) for entry in entries
+            if any(needle in str(entry.get(field, "")) for field in FIELDS)]
+
+
+def format_entry(entry):
+    """`"<METHOD> <path> (<actor>)"` for one entry."""
+    for field in FIELDS:
+        if field not in entry:
+            raise ValueError("entry is missing field: %s" % (field,))
+    return "%s %s (%s)" % (entry["method"], entry["path"], entry["actor"])
+
+
+def to_lines(entries):
+    """One `format_entry` line per entry, in order."""
+    return [format_entry(entry) for entry in entries]
diff --git a/app/backoff.py b/app/backoff.py
new file mode 100644
index 0000000..a2e375e
--- /dev/null
+++ b/app/backoff.py
@@ -0,0 +1,85 @@
+"""Deterministic retry-schedule calculator.
+
+Pure functions plus read-only reads of `app.quota` -- no module state, and
+never an import of `app.ratelimit`.
+"""
+from app import quota
+
+
+DEFAULT_WINDOW_SECONDS = 60
+DEFAULT_BURST = 0
+DEFAULT_BASE = 1.0
+DEFAULT_FACTOR = 2.0
+DEFAULT_CAP = 60.0
+
+
+class BackoffError(Exception):
+    """Raised for an invalid backoff parameter."""
+
+
+def schedule(base, factor, retries):
+    """Return the exponential delay schedule `[base * factor**i]` as floats."""
+    if base <= 0:
+        raise BackoffError("base must be > 0, got %r" % (base,))
+    if factor < 1.0:
+        raise BackoffError("factor must be >= 1.0, got %r" % (factor,))
+    if retries < 0:
+        raise BackoffError("retries must be >= 0, got %r" % (retries,))
+    return [float(base * factor ** i) for i in range(retries)]
+
+
+def capped(seq, cap):
+    """Return a new schedule with every delay clamped to `cap`."""
+    if cap <= 0:
+        raise BackoffError("cap must be > 0, got %r" % (cap,))
+    return [float(min(delay, cap)) for delay in seq]
+
+
+def total_wait(seq):
+    """Return the total seconds a schedule spends waiting."""
+    return float(sum(seq))
+
+
+def next_delay(attempt, base, factor, cap):
+    """Return the capped delay for a single retry attempt."""
+    if attempt < 0:
+        raise BackoffError("attempt must be >= 0, got %r" % (attempt,))
+    return float(min(base * factor ** attempt, cap))
+
+
+def delay_until_free(key, config):
+    """Return the seconds until `key` regains quota. Records nothing."""
+    return quota.time_to_next_slot(
+        key,
+        config["rate_limit_max_per_window"],
+        config.get("rate_limit_window_seconds", DEFAULT_WINDOW_SECONDS),
+        burst=config.get("rate_limit_burst", DEFAULT_BURST),
+    )
+
+
+def retry_plan(key, config, retries):
+    """Return the retry plan for `key`: immediacy, wait, backoff schedule."""
+    return {
+        "immediate": quota.remaining(
+            key,
+            config["rate_limit_max_per_window"],
+            config.get("rate_limit_window_seconds", DEFAULT_WINDOW_SECONDS),
+            burst=config.get("rate_limit_burst", DEFAULT_BURST),
+        ) > 0,
+        "wait": delay_until_free(key, config),
+        "backoff": capped(
+            schedule(
+                config.get("backoff_base", DEFAULT_BASE),
+                config.get("backoff_factor", DEFAULT_FACTOR),
+                retries,
+            ),
+            config.get("backoff_cap", DEFAULT_CAP),
+        ),
+    }
+
+
+def describe_schedule(seq):
+    """Render a schedule as comma-separated second values."""
+    if not seq:
+        return "(no retries)"
+    return ", ".join("%ss" % (delay,) for delay in seq)
diff --git a/app/coerce.py b/app/coerce.py
new file mode 100644
index 0000000..02f9953
--- /dev/null
+++ b/app/coerce.py
@@ -0,0 +1,105 @@
+"""Pre-validation coercion: turn wire-shaped strings into real values.
+
+Transport layers hand everything over as text. This module converts the
+text a spec expects to be numeric (or boolean) *before* validation runs,
+so app.schema only ever sees real Python values. Every result is checked
+against ``schema.is_valid_amount``, so a coercion can never produce a
+value the validator would then reject.
+"""
+from app import schema
+
+
+class CoerceError(Exception):
+    """Raised when a value cannot be coerced to the requested shape."""
+
+
+COERCE_CATALOG = {
+    "amount": "cannot coerce {field} to a number (got {value!r})",
+    "flag": "cannot coerce {field} to a flag (got {value!r})",
+}
+
+TRUE_WORDS = ("true", "yes", "1", "on")
+FALSE_WORDS = ("false", "no", "0", "off")
+
+
+def _error(code, field, value):
+    return CoerceError(COERCE_CATALOG[code].format(field=field, value=value))
+
+
+def _parse_number(text):
+    """`text` as an int if it looks like one, else a float, else None."""
+    try:
+        return int(text)
+    except ValueError:
+        pass
+    try:
+        return float(text)
+    except ValueError:
+        return None
+
+
+def parse_amount(value, field):
+    """Coerce `value` to a number, or raise CoerceError naming `field`."""
+    if isinstance(value, bool):
+        raise _error("amount", field, value)
+    if isinstance(value, str):
+        parsed = _parse_number(value.strip())
+        if parsed is None:
+            raise _error("amount", field, value)
+    else:
+        parsed = value
+    if not schema.is_valid_amount(parsed):
+        raise _error("amount", field, value)
+    return parsed
+
+
+def parse_flag(value, field):
+    """Coerce `value` to a bool, or raise CoerceError naming `field`."""
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        word = value.strip().lower()
+        if word in TRUE_WORDS:
+            return True
+        if word in FALSE_WORDS:
+            return False
+    raise _error("flag", field, value)
+
+
+def _number_fields(spec):
+    return [field for field, rules in spec.items() if rules.get("type") == "number"]
+
+
+def coerce_fields(fields, spec):
+    """A new dict with every number-typed string value parsed."""
+    coerced = dict(fields)
+    for field in _number_fields(spec):
+        if isinstance(coerced.get(field), str):
+            coerced[field] = parse_amount(coerced[field], field=field)
+    return coerced
+
+
+def coerce_report(fields, spec):
+    """``(coerced, errors)``: failures are collected, not raised.
+
+    Every failed field is copied through unchanged, and its
+    ``(field, message)`` tuple is recorded in spec insertion order.
+    """
+    coerced = dict(fields)
+    errors = []
+    for field in _number_fields(spec):
+        if not isinstance(coerced.get(field), str):
+            continue
+        try:
+            coerced[field] = parse_amount(coerced[field], field=field)
+        except CoerceError as err:
+            errors.append((field, str(err)))
+    return coerced, errors
+
+
+def describe_coercions(spec):
+    """One ``"<field>: number"`` line per number-typed field, sorted."""
+    fields = sorted(_number_fields(spec))
+    if not fields:
+        return "(no coercions)"
+    return "\n".join("%s: number" % field for field in fields)
diff --git a/app/colspec.py b/app/colspec.py
new file mode 100644
index 0000000..5efd9f4
--- /dev/null
+++ b/app/colspec.py
@@ -0,0 +1,103 @@
+"""Column projection: parse a "a,b:B,c" colspec and reshape records with it.
+
+A colspec is a comma-separated list of tokens; each token is either a bare
+source field name or `source:header`. Parsing yields `(source, header)`
+pairs, which `project` uses to build renamed, column-limited records ready
+for `app.export`. Pure: this layer imports `app.tabular` and nothing else.
+"""
+from app import tabular
+
+
+class ColspecError(Exception):
+    pass
+
+
+def parse_colspec(spec):
+    """Parse a colspec string into ordered (source, header) pairs."""
+    if not spec or not spec.strip():
+        raise ColspecError("empty colspec")
+    pairs = []
+    seen_sources = set()
+    seen_headers = set()
+    for token in spec.split(","):
+        token = token.strip()
+        if not token:
+            raise ColspecError("empty column token in colspec: %s" % spec)
+        parts = [part.strip() for part in token.split(":")]
+        if len(parts) > 2:
+            raise ColspecError("malformed column token: %s" % token)
+        source = parts[0]
+        header = parts[1] if len(parts) == 2 else parts[0]
+        if not source or not header:
+            raise ColspecError("empty column name in token: %s" % token)
+        if source in seen_sources:
+            raise ColspecError("duplicate source column: %s" % source)
+        if header in seen_headers:
+            raise ColspecError("duplicate header column: %s" % header)
+        seen_sources.add(source)
+        seen_headers.add(header)
+        pairs.append((source, header))
+    return pairs
+
+
+def project(records, pairs):
+    """New records keyed by header, valued from source (absent -> None)."""
+    return [dict((header, record.get(source)) for source, header in pairs)
+            for record in records]
+
+
+def available(records, pairs):
+    """(present, missing) sorted source names, split against the record keys."""
+    cols = set(tabular.columns(records))
+    present = sorted(source for source, _ in pairs if source in cols)
+    missing = sorted(source for source, _ in pairs if source not in cols)
+    return present, missing
+
+
+def auto_colspec(records):
+    """The identity colspec over every column the records carry."""
+    return [(name, name) for name in tabular.columns(records)]
+
+
+def header_row(pairs):
+    """The headers, in pair order."""
+    return [header for _, header in pairs]
+
+
+def rename_map(pairs):
+    """{source: header} for the pairs that actually rename something."""
+    return dict((source, header) for source, header in pairs
+                if source != header)
+
+
+def select(records, sources):
+    """New records keeping only the named source fields that are present."""
+    wanted = _require_sources(sources)
+    return [dict((key, value) for key, value in record.items() if key in wanted)
+            for record in records]
+
+
+def drop(records, sources):
+    """New records with the named source fields removed."""
+    unwanted = _require_sources(sources)
+    return [dict((key, value) for key, value in record.items()
+                 if key not in unwanted)
+            for record in records]
+
+
+def _require_sources(sources):
+    if not sources:
+        raise ColspecError("no source columns given")
+    return set(sources)
+
+
+def sanitize_headers(pairs):
+    """New pairs with every header flattened onto a single line."""
+    return [(source, tabular.sanitize_flat(header)) for source, header in pairs]
+
+
+def describe_colspec(pairs):
+    """One "<header> <- <source>" line per pair, in order."""
+    if not pairs:
+        return "(no columns)"
+    return "\n".join("%s <- %s" % (header, source) for source, header in pairs)
diff --git a/app/export.py b/app/export.py
new file mode 100644
index 0000000..8f6260d
--- /dev/null
+++ b/app/export.py
@@ -0,0 +1,182 @@
+"""Record export formatter: CSV / JSON / Markdown / NDJSON / TSV (+ HTML).
+
+Every column model, cell rendering and escape here comes from
+`app.tabular`; this module only decides how the rendered cells are joined.
+
+`FORMATS` is the route-reachable table the registry copies into
+`EXPORT_FORMATS`. `EXTRA_FORMATS` holds formats that are deliberately kept
+off that table (HTML) and reachable only through `render_any`.
+"""
+import json
+
+from app import tabular
+
+
+def to_csv(records):
+    """Comma-separated rows: sorted header union, then one row per record."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = [",".join(tabular.escape_csv(name) for name in cols)]
+    for record in records:
+        lines.append(",".join(tabular.escape_csv(record.get(name))
+                              for name in cols))
+    return "\n".join(lines)
+
+
+def to_json(records):
+    """A JSON array of the records, keys sorted."""
+    return json.dumps(records, sort_keys=True)
+
+
+def to_markdown(records, align="left"):
+    """A width-padded Markdown pipe table. `align` is validated by tabular.pad."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    col_widths = tabular.widths(records, cols)
+    sizes = [col_widths[name] for name in cols]
+    lines = [tabular.render_row(cols, sizes, align)]
+    lines.append(tabular.render_row(
+        [_separator_cell(width, align) for width in sizes], sizes, align))
+    for record in records:
+        lines.append(tabular.render_row(
+            [record.get(name) for name in cols], sizes, align))
+    return "\n".join(lines)
+
+
+def _separator_cell(width, align):
+    if align == "right":
+        return "-" * max(width - 1, 0) + ":"
+    return "-" * width
+
+
+def to_ndjson(records):
+    """One key-sorted JSON object per line, no trailing newline."""
+    return "\n".join(json.dumps(record, sort_keys=True) for record in records)
+
+
+def to_tsv(records):
+    """Tab-separated rows; every header and cell flattened onto one line."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = ["\t".join(tabular.sanitize_flat(name) for name in cols)]
+    for record in records:
+        lines.append("\t".join(tabular.sanitize_flat(record.get(name))
+                               for name in cols))
+    return "\n".join(lines)
+
+
+def to_html(records):
+    """A minimal `<table>` with every header and cell HTML-escaped."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = ["<table>"]
+    lines.append("<tr>" + "".join("<th>%s</th>" % tabular.escape_html(name)
+                                  for name in cols) + "</tr>")
+    for record in records:
+        lines.append("<tr>" + "".join(
+            "<td>%s</td>" % tabular.escape_html(record.get(name))
+            for name in cols) + "</tr>")
+    lines.append("</table>")
+    return "\n".join(lines)
+
+
+def parse_csv(text):
+    """Parse `to_csv` output back into a list of dicts of cell strings.
+
+    Values are never re-typed: an exported 3 comes back as "3". Quoted
+    cells may contain commas, doubled quotes and newlines.
+    """
+    if text == "":
+        return []
+    rows = _parse_csv_rows(text)
+    header = rows[0]
+    records = []
+    for row in rows[1:]:
+        record = {}
+        for index, name in enumerate(header):
+            record[name] = row[index] if index < len(row) else ""
+        records.append(record)
+    return records
+
+
+def _parse_csv_rows(text):
+    """Split CSV text into rows of raw cells. A newline always opens a new
+    row, and the final row is kept even when it is a single empty cell."""
+    rows = []
+    row = []
+    field = []
+    quoted = False
+    index = 0
+    length = len(text)
+    while index < length:
+        char = text[index]
+        if quoted:
+            if char == '"':
+                if index + 1 < length and text[index + 1] == '"':
+                    field.append('"')
+                    index += 2
+                    continue
+                quoted = False
+                index += 1
+                continue
+            field.append(char)
+            index += 1
+            continue
+        if char == '"' and not field:
+            quoted = True
+        elif char == ",":
+            row.append("".join(field))
+            field = []
+        elif char == "\n":
+            row.append("".join(field))
+            field = []
+            rows.append(row)
+            row = []
+        else:
+            field.append(char)
+        index += 1
+    if quoted:
+        raise ValueError("unterminated quoted cell in CSV input")
+    row.append("".join(field))
+    rows.append(row)
+    return rows
+
+
+FORMATS = {
+    "csv": to_csv,
+    "json": to_json,
+    "md": to_markdown,
+    "ndjson": to_ndjson,
+    "tsv": to_tsv,
+}
+
+# Deliberately kept out of FORMATS (and so out of the registry's
+# EXPORT_FORMATS): reachable through render_any only.
+EXTRA_FORMATS = {
+    "html": to_html,
+}
+
+
+def render(records, fmt):
+    """Render `records` with one of the FORMATS renderers."""
+    if fmt not in FORMATS:
+        raise ValueError("unknown export format: %s" % fmt)
+    return FORMATS[fmt](records)
+
+
+def render_any(records, fmt):
+    """Render `records` with a FORMATS renderer, falling back to EXTRA_FORMATS."""
+    if fmt in FORMATS:
+        return FORMATS[fmt](records)
+    if fmt in EXTRA_FORMATS:
+        return EXTRA_FORMATS[fmt](records)
+    raise ValueError("unknown export format: %s" % fmt)
+
+
+def summary_line(records):
+    """A one-line shape description of an export."""
+    return "%s records, %s columns" % (len(records), len(tabular.columns(records)))
