@@ -0,0 +1,88 @@
+"""Tests for the column-model toolkit app/tabular.py that app/export.py
+builds on."""
+import pytest
+
+from app import tabular
+
+
+def test_columns_empty_and_sorted_union_of_differing_key_sets():
+    assert tabular.columns([]) == []
+    records = [{"a": 1, "x": 9}, {"b": 2}]
+    assert tabular.columns(records) == ["a", "b", "x"]
+
+
+def test_cell_renders_plain_str_except_none():
+    assert tabular.cell(None) == ""
+    assert tabular.cell(3) == "3"
+    assert tabular.cell(3.5) == "3.5"
+    assert tabular.cell("x") == "x"
+
+
+def test_escape_csv_quotes_only_when_needed():
+    assert tabular.escape_csv("plain") == "plain"
+    assert tabular.escape_csv("a,b") == '"a,b"'
+    assert tabular.escape_csv('say "hi"') == '"say ""hi"""'
+    assert tabular.escape_csv("line1\nline2") == '"line1\nline2"'
+    assert tabular.escape_csv("") == ""
+
+
+def test_widths_is_max_of_header_len_and_widest_cell_per_column():
+    # "name" header (4 chars) is strictly wider than every cell in that
+    # column ("Al", "Bo" -- both 2 chars): the header term wins, not tied.
+    # "age" header (3 chars) is beaten by a cell ("100000", 6 chars): the
+    # widest-cell term wins there.
+    records = [{"name": "Al", "age": "100000"}, {"name": "Bo", "age": "2"}]
+    cols = tabular.columns(records)
+    assert cols == ["age", "name"]
+    assert tabular.widths(records, cols) == {"age": 6, "name": 4}
+
+
+def test_pad_left_and_right_and_never_truncates_and_validates_align_first():
+    assert tabular.pad("ab", 4, "left") == "ab  "
+    assert tabular.pad("ab", 4, "right") == "  ab"
+    # A 5-char value at width 4 is returned unchanged, never truncated.
+    assert tabular.pad("abcde", 4, "left") == "abcde"
+    # align is validated before any short-circuit: it raises even when
+    # the value already meets (or exceeds) the width.
+    with pytest.raises(ValueError) as exc:
+        tabular.pad("abcde", 4, "center")
+    assert "center" in str(exc.value)
+
+
+def test_sanitize_flat_replaces_tabs_and_newlines_with_a_space():
+    assert tabular.sanitize_flat("a\tb\nc") == "a b c"
+    assert tabular.sanitize_flat("clean") == "clean"
+
+
+def test_escape_html_escapes_ampersand_first():
+    assert tabular.escape_html('<a & "b">') == "&lt;a &amp; &quot;b&quot;&gt;"
+    assert tabular.escape_html("clean") == "clean"
+
+
+def test_truncate_unchanged_or_marker_suffixed_exact_strings():
+    assert tabular.truncate("abcdefgh", 5) == "ab..."
+    assert tabular.truncate("ab", 5) == "ab"
+    with pytest.raises(ValueError):
+        tabular.truncate("abcdefgh", 2, marker="...")
+
+
+def test_wrap_greedy_hard_split_and_edge_cases():
+    assert tabular.wrap("aa bb cc", 5) == ["aa bb", "cc"]
+    assert tabular.wrap("aa bb cc", 8) == ["aa bb cc"]
+    assert tabular.wrap("abcdefgh", 3) == ["abc", "def", "gh"]
+    assert tabular.wrap("", 5) == [""]
+    with pytest.raises(ValueError):
+        tabular.wrap("x", 0)
+
+
+def test_fit_composes_truncate_then_pad_and_delegates_bad_align_to_pad():
+    assert tabular.fit("abcdefgh", 5, "left") == "ab..."
+    assert tabular.fit("ab", 5, "left") == "ab   "
+    with pytest.raises(ValueError):
+        tabular.fit("abcde", 4, "center")
+
+
+def test_render_row_exact_string_and_mismatched_lengths_raise():
+    assert tabular.render_row(["a", "bb"], [3, 4], "left") == "| a   | bb   |"
+    with pytest.raises(ValueError):
+        tabular.render_row(["a"], [3, 4], "left")
