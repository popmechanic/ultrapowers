index 0000000..0e52b4c
--- /dev/null
+++ b/app/throttle.py
@@ -0,0 +1,80 @@
+"""Route-policy layer over `app.quota`.
+
+A policy table maps `"<METHOD> <path-prefix>"` to an allowance
+(`limit` / `window` / `burst`). This is a library layer for future
+routes -- it is not wired into the registry, and it never imports
+`app.ratelimit`.
+"""
+from app import quota
+
+
+POLICIES = {
+    "POST /records": {"limit": 5, "window": 60, "burst": 0},
+    "GET /export": {"limit": 10, "window": 60, "burst": 2},
+}
+
+
+class PolicyError(Exception):
+    """Raised when a request exceeds its matching policy's allowance."""
+
+
+def match_policy(method, path, policies):
+    """Return the policy for `method`/`path`, longest prefix wins, else None."""
+    best_key = None
+    best_prefix = None
+    for key in policies:
+        key_method, _, prefix = key.partition(" ")
+        if key_method != method or not path.startswith(prefix):
+            continue
+        if best_prefix is None or len(prefix) > len(best_prefix):
+            best_key = key
+            best_prefix = prefix
+    if best_key is None:
+        return None
+    return policies[best_key]
+
+
+def key_for(method, path, actor):
+    """Return the quota key a policy counts against."""
+    return "%s %s:%s" % (method, path, actor)
+
+
+def enforce(method, path, actor, policies):
+    """Count one request against its policy and return the in-window count.
+
+    Returns None when no policy matches (nothing is recorded); raises
+    PolicyError once the matching policy's allowance is spent.
+    """
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    key = key_for(method, path, actor)
+    try:
+        return quota.take(
+            key, policy["limit"], policy["window"],
+            burst=policy.get("burst", 0))
+    except quota.QuotaExceededError as exc:
+        raise PolicyError(
+            "policy exceeded for %s: limit %s" % (key, policy["limit"])) from exc
+
+
+def remaining_for(method, path, actor, policies):
+    """Return the requests left under the matching policy, else None."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    return quota.remaining(
+        key_for(method, path, actor), policy["limit"], policy["window"],
+        burst=policy.get("burst", 0))
+
+
+def describe_policies(policies):
+    """Render the policy table, one sorted line per key."""
+    if not policies:
+        return "(no policies)"
+    return "\n".join(
+        "%s: limit=%s, window=%s, burst=%s" % (
+            key, policies[key]["limit"], policies[key]["window"],
+            policies[key].get("burst", 0))
+        for key in sorted(policies)
+    )
