@@ -0,0 +1,120 @@
+import pytest
+
+from app import quota, throttle, tiers
+
+
+def test_tier_error_is_a_distinct_exception_subclass():
+    quota.reset()
+    assert issubclass(tiers.TierError, Exception)
+    assert not issubclass(tiers.TierError, throttle.PolicyError)
+    assert not issubclass(throttle.PolicyError, tiers.TierError)
+
+
+def test_tiers_constant():
+    quota.reset()
+    assert tiers.TIERS == {
+        "free": {"limit": 2, "window": 60, "burst": 0},
+        "pro": {"limit": 10, "window": 60, "burst": 2},
+        "internal": {"limit": 100, "window": 60, "burst": 10},
+    }
+
+
+def test_tier_of_defaults_to_free_and_rejects_unknown_tiers():
+    quota.reset()
+    assert tiers.tier_of("mallory", {}) == "free"
+    assert tiers.tier_of("mallory", {"mallory": "pro"}) == "pro"
+    with pytest.raises(tiers.TierError) as excinfo:
+        tiers.tier_of("mallory", {"mallory": "platinum"})
+    message = str(excinfo.value)
+    assert "mallory" in message
+    assert "platinum" in message
+
+
+def test_policy_for_returns_a_deep_copy():
+    quota.reset()
+    policy = tiers.policy_for("mallory", {})
+    assert policy == {"limit": 2, "window": 60, "burst": 0}
+    policy["limit"] = 999
+    assert tiers.TIERS["free"] == {"limit": 2, "window": 60, "burst": 0}
+    assert tiers.policy_for("mallory", {}) == {"limit": 2, "window": 60, "burst": 0}
+
+
+def test_enforce_tier_delegates_to_throttle_enforce(monkeypatch):
+    quota.reset()
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(throttle, "enforce", recorder)
+    assert tiers.enforce_tier("POST", "/records", "a", {}) == 1
+    assert calls == [(
+        ("POST", "/records", "a",
+         {"POST /records": {"limit": 2, "window": 60, "burst": 0}}),
+        {},
+    )]
+    monkeypatch.undo()
+
+    quota.reset()
+    assignments = {"b": "pro"}
+    assert tiers.enforce_tier("POST", "/records", "a", assignments) == 1
+    assert tiers.enforce_tier("POST", "/records", "b", assignments) == 1
+    assert tiers.enforce_tier("POST", "/records", "a", assignments) == 2
+    with pytest.raises(throttle.PolicyError):
+        tiers.enforce_tier("POST", "/records", "a", assignments)
+    assert tiers.enforce_tier("POST", "/records", "b", assignments) == 2
+
+
+def test_remaining_tier_reads_without_recording(monkeypatch):
+    quota.reset()
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 2
+
+    monkeypatch.setattr(throttle, "remaining_for", recorder)
+    assert tiers.remaining_tier("POST", "/records", "a", {}) == 2
+    assert calls == [(
+        ("POST", "/records", "a",
+         {"POST /records": {"limit": 2, "window": 60, "burst": 0}}),
+        {},
+    )]
+    monkeypatch.undo()
+
+    quota.reset()
+    assert tiers.remaining_tier("POST", "/records", "a", {}) == 2
+    assert tiers.remaining_tier("POST", "/records", "a", {}) == 2
+    assert tiers.enforce_tier("POST", "/records", "a", {}) == 1
+    assert tiers.remaining_tier("POST", "/records", "a", {}) == 1
+    assert tiers.enforce_tier("POST", "/records", "a", {}) == 2
+
+
+def test_describe_tiers_renders_the_tier_table(monkeypatch):
+    quota.reset()
+    assert tiers.describe_tiers() == (
+        "free: limit=2, window=60, burst=0\n"
+        "internal: limit=100, window=60, burst=10\n"
+        "pro: limit=10, window=60, burst=2"
+    )
+
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return "rendered"
+
+    monkeypatch.setattr(throttle, "describe_policies", recorder)
+    assert tiers.describe_tiers() == "rendered"
+    assert calls == [((tiers.TIERS,), {})]
+
+
+def test_upgrade_path_walks_the_tiers_by_allowance():
+    quota.reset()
+    assert tiers.upgrade_path("free") == "pro"
+    assert tiers.upgrade_path("pro") == "internal"
+    assert tiers.upgrade_path("internal") is None
+    with pytest.raises(tiers.TierError) as excinfo:
+        tiers.upgrade_path("platinum")
+    assert "platinum" in str(excinfo.value)
