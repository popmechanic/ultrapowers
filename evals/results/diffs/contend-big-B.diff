diff --git a/app/reportdoc.py b/app/reportdoc.py
new file mode 100644
index 0000000..d849201
--- /dev/null
+++ b/app/reportdoc.py
@@ -0,0 +1,99 @@
+"""Multi-section report composer.
+
+A section is a plain dict {"title", "records", "fmt"}; a report is an
+ordered list of them. Rendering delegates every table to `app.export`
+(`render_any`, so HTML sections work too) and every column projection to
+`app.colspec`. Section titles are the report's identity: they must be
+unique, and that check is shared by every entry point that treats a list of
+sections as one report.
+
+This is a new composer that sits beside the pre-existing `app.report`
+totals renderer; it neither imports nor changes it.
+"""
+from app import colspec
+from app import export
+
+
+class ReportError(Exception):
+    pass
+
+
+def section(title, records, fmt="md"):
+    """Build one validated report section."""
+    if not title or not title.strip():
+        raise ReportError("section title must not be empty")
+    if fmt not in export.FORMATS and fmt not in export.EXTRA_FORMATS:
+        raise ReportError("unknown section format: %s" % fmt)
+    return {"title": title, "records": records, "fmt": fmt}
+
+
+def render_section(sec):
+    """Render one section: an H2 title, a blank line, then its table."""
+    if not sec["records"]:
+        return "## %s\n\n(no records)" % sec["title"]
+    return "## %s\n\n%s" % (sec["title"],
+                            export.render_any(sec["records"], sec["fmt"]))
+
+
+def render_report(title, sections):
+    """Render an H1 title followed by every section, blank-line separated."""
+    _check_titles(sections)
+    if not sections:
+        return "# %s\n\n(empty report)" % title
+    body = "\n\n".join(render_section(sec) for sec in sections)
+    return "# %s\n\n%s" % (title, body)
+
+
+def toc(sections):
+    """The section titles, in order."""
+    _check_titles(sections)
+    return [sec["title"] for sec in sections]
+
+
+def record_counts(sections):
+    """{title: number of records} for every section."""
+    return dict((sec["title"], len(sec["records"])) for sec in sections)
+
+
+def summary(sections):
+    """A one-line shape description of a report."""
+    total = sum(len(sec["records"]) for sec in sections)
+    return "%s sections, %s records" % (len(sections), total)
+
+
+def render_index(sections):
+    """A 1-based "<i>. <title> (<n> records)" line per section."""
+    if not sections:
+        return "(empty report)"
+    return "\n".join(
+        "%s. %s (%s records)" % (number, sec["title"], len(sec["records"]))
+        for number, sec in enumerate(sections, 1))
+
+
+def projected_section(title, records, pairs, fmt="md"):
+    """A section over records projected through a colspec."""
+    return section(title, colspec.project(records, pairs), fmt)
+
+
+def find_section(sections, title):
+    """The section with this title (the stored dict itself, not a copy)."""
+    for sec in sections:
+        if sec["title"] == title:
+            return sec
+    raise ReportError("no such section: %s" % title)
+
+
+def merge_reports(a, b):
+    """A new sections list concatenating two reports, titles still unique."""
+    merged = list(a) + list(b)
+    _check_titles(merged)
+    return merged
+
+
+def _check_titles(sections):
+    seen = set()
+    for sec in sections:
+        title = sec["title"]
+        if title in seen:
+            raise ReportError("duplicate section title: %s" % title)
+        seen.add(title)
diff --git a/app/rules.py b/app/rules.py
new file mode 100644
index 0000000..e878a7f
--- /dev/null
+++ b/app/rules.py
@@ -0,0 +1,126 @@
+"""Pure rule combinators layered on app.schema's value predicates.
+
+A *rule* is a plain dict ``{"name": str, "test": callable}``. Combinators
+(all_of / any_of / negate / when) build composite rules whose names spell
+out how they were assembled, so a failure message is self-describing.
+
+Every primitive predicate is called through ``schema`` at test time --
+nothing here reimplements a check that app.schema already owns.
+"""
+from app import schema
+
+
+class RuleError(Exception):
+    """Raised for rule-layer misuse that is not a plain ValueError."""
+
+
+def rule(name, predicate):
+    """A named rule wrapping `predicate`."""
+    if not isinstance(name, str) or not name:
+        raise ValueError("rule name must be a non-empty string: %r" % (name,))
+    return {"name": name, "test": predicate}
+
+
+def check(value, r):
+    """Whether `value` passes rule `r`."""
+    return bool(r["test"](value))
+
+
+def _joined_name(kind, children):
+    return "%s(%s)" % (kind, ",".join(child["name"] for child in children))
+
+
+def all_of(*children):
+    """A rule passing iff every child passes; vacuously true with none."""
+    return rule(_joined_name("all", children),
+                lambda value: all(check(value, child) for child in children))
+
+
+def any_of(*children):
+    """A rule passing iff at least one child passes.
+
+    No children is rejected: a vacuously-failing `any` silently rejects
+    everything, which is a bug rather than a policy anyone means.
+    """
+    if not children:
+        raise ValueError("any_of() requires at least one rule")
+    return rule(_joined_name("any", children),
+                lambda value: any(check(value, child) for child in children))
+
+
+def negate(r):
+    """A rule passing exactly when `r` fails."""
+    return rule("not(%s)" % r["name"], lambda value: not check(value, r))
+
+
+def when(cond, then):
+    """Material implication: passes when `cond` fails or `then` passes."""
+    return rule("when(%s,%s)" % (cond["name"], then["name"]),
+                lambda value: (not check(value, cond)) or check(value, then))
+
+
+def explain(value, r):
+    """``"<rule name>: pass"`` or ``"<rule name>: fail"``."""
+    return "%s: %s" % (r["name"], "pass" if check(value, r) else "fail")
+
+
+def _failures(fields, rules_by_field):
+    """(field, rule) pairs that fail, in rules_by_field insertion order."""
+    return [(field, r) for field, r in rules_by_field.items()
+            if field in fields and not check(fields[field], r)]
+
+
+def apply_rules(fields, rules_by_field):
+    """One ``"field <f> failed <rule name>"`` per failing field."""
+    return ["field %s failed %s" % (field, r["name"])
+            for field, r in _failures(fields, rules_by_field)]
+
+
+def first_failure(fields, rules_by_field):
+    """The first ``(field, rule name)`` that fails, or None."""
+    for field, r in _failures(fields, rules_by_field):
+        return (field, r["name"])
+    return None
+
+
+def explain_failures(fields, rules_by_field):
+    """``explain`` output for the failing fields only, in insertion order."""
+    return [explain(fields[field], r)
+            for field, r in _failures(fields, rules_by_field)]
+
+
+def describe_rules(rules_by_field):
+    """One ``"<field>: <rule name>"`` line per field, in insertion order."""
+    if not rules_by_field:
+        return "(no rules)"
+    return "\n".join("%s: %s" % (field, r["name"])
+                     for field, r in rules_by_field.items())
+
+
+BUILTINS = {
+    "number": rule("number", lambda value: schema.is_valid_amount(value)),
+    "str": rule("str", lambda value: isinstance(value, str)),
+    "non_empty": rule("non_empty", lambda value: schema.is_non_empty_str(value)),
+}
+
+
+def parse_rule(text):
+    """Parse a ``&``-joined list of builtin names into a single rule."""
+    tokens = [token.strip() for token in text.split("&")]
+    for token in tokens:
+        if token not in BUILTINS:
+            raise ValueError("unknown rule token: %r" % (token,))
+    if len(tokens) == 1:
+        return BUILTINS[tokens[0]]
+    return all_of(*[BUILTINS[token] for token in tokens])
+
+
+def parse_rules(text_by_field):
+    """Map field -> ``&``-joined rule text through ``parse_rule``."""
+    parsed = {}
+    for field, text in text_by_field.items():
+        try:
+            parsed[field] = parse_rule(text)
+        except ValueError as err:
+            raise ValueError("field %s: %s" % (field, err))
+    return parsed
diff --git a/app/schema.py b/app/schema.py
new file mode 100644
index 0000000..3e56194
--- /dev/null
+++ b/app/schema.py
@@ -0,0 +1,231 @@
+"""Declarative validation toolkit: the error catalog, the primitive value
+predicates, and a small spec algebra (compile / merge / diff / describe).
+
+A *spec* is a plain dict mapping a field name to a *rules* dict. The only
+legal rule keys are:
+
+    "required"    bool   -- the field must be present in `fields`
+    "type"        str    -- "str" or "number"
+    "non_empty"   bool   -- the value must be a non-whitespace string
+    "max"         number -- the value must be <= this limit
+
+Rules for a present field are always checked in the fixed order
+``type`` -> ``non_empty`` -> ``max`` and only the first failure is
+reported, so a field never produces two contradictory messages.
+
+Every user-visible message in the app is built here, from ERROR_CATALOG,
+so callers never hand-write message strings.
+"""
+import math
+
+
+ERROR_CATALOG = {
+    "missing": "missing field: {field}",
+    "numeric": "field {field} must be numeric (got {got})",
+    "non_negative": "field {field} must be non-negative",
+    "max": "field {field} exceeds max_amount {limit}",
+    "non_empty": "field {field} must be a non-empty string",
+    "type_str": "field {field} must be a string",
+}
+
+LEGAL_RULE_KEYS = ("required", "type", "non_empty", "max")
+LEGAL_TYPES = ("str", "number")
+RULE_ORDER = ("type", "non_empty", "max")
+
+
+class SchemaError(Exception):
+    """Raised by a compiled validator when `fields` violates its spec."""
+
+
+def format_error(code, **kwargs):
+    """Render the catalog message for `code`.
+
+    An unknown code raises KeyError -- there is deliberately no silent
+    fallback message, because a typo'd code must fail loudly.
+    """
+    return ERROR_CATALOG[code].format(**kwargs)
+
+
+def check_required(fields, required_fields):
+    """Names from `required_fields`, in that order, absent from `fields`."""
+    return [field for field in required_fields if field not in fields]
+
+
+def is_valid_amount(value):
+    """True for a finite, non-bool int or float.
+
+    Bools are excluded even though `isinstance(True, int)` is True, and
+    NaN/infinities are excluded because they slip silently through
+    comparison chains. Ints are finite by construction and are never
+    routed through math.isfinite, which raises OverflowError on an int
+    too large to convert to float.
+    """
+    if isinstance(value, bool):
+        return False
+    if isinstance(value, int):
+        return True
+    if isinstance(value, float):
+        return math.isfinite(value)
+    return False
+
+
+def is_non_empty_str(value):
+    """True for a string with at least one non-whitespace character."""
+    return isinstance(value, str) and value.strip() != ""
+
+
+def _check_rules(field, rules, value):
+    """The first failing rule's message for `value`, or None if it passes.
+
+    Rules are evaluated in the fixed RULE_ORDER so a field with both a
+    `type` and a `non_empty` rule reports the type failure only.
+    """
+    for key in RULE_ORDER:
+        if key not in rules:
+            continue
+        if key == "type":
+            if rules["type"] == "number":
+                if not is_valid_amount(value):
+                    return format_error("numeric", field=field,
+                                        got=type(value).__name__)
+            elif not isinstance(value, str):
+                return format_error("type_str", field=field)
+        elif key == "non_empty":
+            if rules["non_empty"] and not is_non_empty_str(value):
+                return format_error("non_empty", field=field)
+        elif key == "max":
+            # A value that is not a number is not comparable to the limit;
+            # report it as non-numeric rather than raising TypeError.
+            if not is_valid_amount(value):
+                return format_error("numeric", field=field,
+                                    got=type(value).__name__)
+            if value > rules["max"]:
+                return format_error("max", field=field, limit=rules["max"])
+    return None
+
+
+def _validate_spec(spec):
+    """Reject illegal rule keys / type values at compile time."""
+    for field, rules in spec.items():
+        for key in rules:
+            if key not in LEGAL_RULE_KEYS:
+                raise ValueError("unknown rule key %r on field %r" % (key, field))
+        if "type" in rules and rules["type"] not in LEGAL_TYPES:
+            raise ValueError("unknown type %r on field %r" % (rules["type"], field))
+
+
+def _strip_fields(spec, fields):
+    """A new dict with every non_empty-ruled field stripped."""
+    result = dict(fields)
+    for field, rules in spec.items():
+        if rules.get("non_empty") and field in result:
+            result[field] = result[field].strip()
+    return result
+
+
+def compile_spec(spec):
+    """Compile `spec` into a reusable ``validator(fields) -> dict``.
+
+    The validator checks required fields first (in spec insertion order),
+    raising SchemaError for the first absent one, then each present
+    field's rules, raising on the first failure. On success it returns a
+    new dict -- non_empty fields stripped, everything else copied through
+    -- and never mutates its argument. Fields absent from the spec pass
+    through untouched: a spec constrains, it does not whitelist.
+    """
+    _validate_spec(spec)
+    compiled = {field: dict(rules) for field, rules in spec.items()}
+
+    def validator(fields):
+        for field, rules in compiled.items():
+            if rules.get("required") and field not in fields:
+                raise SchemaError(format_error("missing", field=field))
+        for field, rules in compiled.items():
+            if field not in fields:
+                continue
+            message = _check_rules(field, rules, fields[field])
+            if message is not None:
+                raise SchemaError(message)
+        return _strip_fields(compiled, fields)
+
+    return validator
+
+
+def validate_collect(spec, fields):
+    """Every error message for `fields`, instead of raising on the first.
+
+    Missing-required messages come first in spec order, then at most one
+    message per present field (its first failing rule), also in spec
+    order. Returns [] when `fields` is clean.
+    """
+    _validate_spec(spec)
+    errors = [format_error("missing", field=field)
+              for field, rules in spec.items()
+              if rules.get("required") and field not in fields]
+    for field, rules in spec.items():
+        if field not in fields:
+            continue
+        message = _check_rules(field, rules, fields[field])
+        if message is not None:
+            errors.append(message)
+    return errors
+
+
+def merge_specs(a, b):
+    """A new spec unioning `a` and `b`; neither input is mutated.
+
+    Fields unique to either side copy through; a field in both merges its
+    rules dicts. The same rule key with unequal values is a conflict and
+    raises ValueError naming the field and the key.
+    """
+    merged = {field: dict(rules) for field, rules in a.items()}
+    for field, rules in b.items():
+        if field not in merged:
+            merged[field] = dict(rules)
+            continue
+        target = merged[field]
+        for key, value in rules.items():
+            if key in target and target[key] != value:
+                raise ValueError(
+                    "conflicting rule %r on field %r: %r != %r"
+                    % (key, field, target[key], value))
+            target[key] = value
+    return merged
+
+
+def describe_spec(spec):
+    """One line per field, fields sorted and rule keys sorted."""
+    if not spec:
+        return "(empty spec)"
+    lines = []
+    for field in sorted(spec):
+        rules = spec[field]
+        rendered = ", ".join("%s=%s" % (key, rules[key]) for key in sorted(rules))
+        lines.append("%s: %s" % (field, rendered))
+    return "\n".join(lines)
+
+
+def diff_specs(a, b):
+    """Field names added / removed / changed going from `a` to `b`."""
+    return {
+        "added": sorted(field for field in b if field not in a),
+        "removed": sorted(field for field in a if field not in b),
+        "changed": sorted(field for field in a if field in b and a[field] != b[field]),
+    }
+
+
+def spec_from_config(config, prefix):
+    """The spec described by every `prefix`-prefixed key of `config`."""
+    return {key[len(prefix):]: dict(value)
+            for key, value in config.items() if key.startswith(prefix)}
+
+
+def spec_to_config(spec, prefix):
+    """The inverse of spec_from_config: prefixed keys -> rules-dict copies."""
+    return {prefix + field: dict(rules) for field, rules in spec.items()}
+
+
+def spec_summary_line(spec):
+    """``"<field count> fields, <rule count> rules"``."""
+    return "%d fields, %d rules" % (
+        len(spec), sum(len(rules) for rules in spec.values()))
diff --git a/app/tabular.py b/app/tabular.py
new file mode 100644
index 0000000..e92f424
--- /dev/null
+++ b/app/tabular.py
@@ -0,0 +1,130 @@
+"""Column-model toolkit: the shared cell/column primitives export.py builds on.
+
+Pure functions over lists of plain dicts. Nothing here knows about a
+specific output format; `export.py` composes these into CSV/Markdown/TSV/
+HTML renderings so no format duplicates the key-union, escaping, or
+str() logic.
+"""
+
+ALIGNMENTS = ("left", "right")
+
+
+def columns(records):
+    """The sorted union of every key across `records`."""
+    names = set()
+    for record in records:
+        names.update(record.keys())
+    return sorted(names)
+
+
+def cell(value):
+    """Render one value: None becomes the empty cell, everything else str()."""
+    if value is None:
+        return ""
+    return str(value)
+
+
+def escape_csv(value):
+    """Quote a cell for CSV only when it needs it, doubling inner quotes."""
+    text = cell(value)
+    if text == "":
+        return ""
+    if any(ch in text for ch in (",", '"', "\n", "\r")):
+        return '"' + text.replace('"', '""') + '"'
+    return text
+
+
+def widths(records, cols):
+    """Map each column to max(len(header), widest rendered cell)."""
+    result = {}
+    for name in cols:
+        widest = len(name)
+        for record in records:
+            widest = max(widest, len(cell(record.get(name))))
+        result[name] = widest
+    return result
+
+
+def pad(value, width, align="left"):
+    """Pad a rendered cell to `width`. Never truncates; `align` is validated
+    before the already-wide-enough short-circuit."""
+    if align not in ALIGNMENTS:
+        raise ValueError("unknown align: %s" % align)
+    text = cell(value)
+    if len(text) >= width:
+        return text
+    filler = " " * (width - len(text))
+    if align == "left":
+        return text + filler
+    return filler + text
+
+
+def sanitize_flat(value):
+    """Render a value onto a single line: tabs and newlines become spaces."""
+    return cell(value).replace("\t", " ").replace("\n", " ")
+
+
+def escape_html(value):
+    """Render a value with HTML's five-ish specials escaped (& first)."""
+    text = cell(value)
+    text = text.replace("&", "&amp;")
+    text = text.replace("<", "&lt;")
+    text = text.replace(">", "&gt;")
+    return text.replace('"', "&quot;")
+
+
+def truncate(value, width, marker="..."):
+    """Cut an over-long rendering down to `width`, marker included."""
+    if width < len(marker):
+        raise ValueError("width %s is narrower than marker %r" % (width, marker))
+    text = cell(value)
+    if len(text) <= width:
+        return text
+    return text[:width - len(marker)] + marker
+
+
+def wrap(value, width):
+    """Greedily wrap a rendering onto lines of at most `width` characters.
+
+    Words longer than `width` are hard-split rather than overflowing.
+    """
+    if width < 1:
+        raise ValueError("width must be at least 1: %s" % width)
+    text = cell(value)
+    if text == "":
+        return [""]
+    lines = []
+    current = ""
+    for word in text.split(" "):
+        while len(word) > width:
+            if current:
+                lines.append(current)
+                current = ""
+            lines.append(word[:width])
+            word = word[width:]
+        if not current:
+            current = word
+        elif len(current) + 1 + len(word) <= width:
+            current = current + " " + word
+        else:
+            lines.append(current)
+            current = word
+    if current or not lines:
+        lines.append(current)
+    return lines
+
+
+def fit(value, width, align="left"):
+    """Truncate a rendering to `width`, then pad it out per `align`."""
+    return pad(truncate(value, width), width, align)
+
+
+def render_row(cells, widths_list, align="left"):
+    """Render one pipe-table row of width-padded cells."""
+    if len(cells) != len(widths_list):
+        raise ValueError(
+            "cell/width count mismatch: %s != %s" % (len(cells), len(widths_list))
+        )
+    padded = [pad(value, width, align)
+              for value, width in zip(cells, widths_list)]
+    return "| " + " | ".join(padded) + " |"
