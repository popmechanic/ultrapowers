new file mode 100644
index 0000000..4e8fba6
--- /dev/null
+++ b/app/profiles.py
@@ -0,0 +1,79 @@
+"""Named validation profiles: a thin naming layer over app.schema specs.
+
+PROFILES is the only module state; every spec operation is delegated to
+app.schema so a profile can never drift from the toolkit's semantics.
+"""
+import copy
+
+from app import schema
+
+
+class ProfileError(Exception):
+    """Raised for an unknown profile name or an empty profile selection."""
+
+
+PROFILES = {
+    "record": {
+        "name": {"required": True, "type": "str", "non_empty": True},
+        "amount": {"required": True, "type": "number", "max": 100000},
+    },
+    "draft": {
+        "name": {"type": "str"},
+    },
+    "import": {
+        "name": {"required": True, "type": "str", "non_empty": True},
+        "amount": {"type": "number"},
+    },
+}
+
+
+def get_profile(name):
+    """A deep copy of the named spec, so callers cannot edit PROFILES."""
+    if name not in PROFILES:
+        raise ProfileError("unknown profile: %s" % (name,))
+    return copy.deepcopy(PROFILES[name])
+
+
+def validate_profile(fields, name):
+    """Validate `fields` against the named profile's compiled validator."""
+    return schema.compile_spec(get_profile(name))(fields)
+
+
+def merge_profiles(a, b):
+    """The union of two named profiles' specs."""
+    return schema.merge_specs(get_profile(a), get_profile(b))
+
+
+def describe_profile(name):
+    """The named profile rendered by ``schema.describe_spec``."""
+    return schema.describe_spec(get_profile(name))
+
+
+def compare_profiles(a, b):
+    """The added / removed / changed fields going from profile `a` to `b`."""
+    return schema.diff_specs(get_profile(a), get_profile(b))
+
+
+def profile_from_config(config, name):
+    """The spec described by `config`'s ``profile_<name>_*`` keys."""
+    return schema.spec_from_config(config, "profile_%s_" % (name,))
+
+
+def profile_summary(name):
+    """``"<name>: <N> fields, <M> rules"``."""
+    return "%s: %s" % (name, schema.spec_summary_line(get_profile(name)))
+
+
+def validate_all_profiles(fields):
+    """Every profile name mapped to its full error list for `fields`."""
+    return {name: schema.validate_collect(get_profile(name), fields)
+            for name in PROFILES}
+
+
+def strictest(names):
+    """The named profile carrying the most rules; ties break alphabetically."""
+    if not names:
+        raise ProfileError("strictest() requires at least one profile name")
+    counts = {name: sum(len(rules) for rules in get_profile(name).values())
+              for name in names}
+    return max(sorted(counts), key=lambda name: counts[name])
diff --git a/app/quota.py b/app/quota.py
new file mode 100644
index 0000000..e0b602d
--- /dev/null
+++ b/app/quota.py
@@ -0,0 +1,131 @@
+"""Windowed quota counter over a deterministic logical clock.
+
+All counting in the rate-limit feature lives here: `app/ratelimit.py`,
+`app/throttle.py`, `app/backoff.py` and `app/tiers.py` are policy layers
+that delegate to these functions and keep no counters of their own.
+
+Time is a module-global logical clock (seconds, a float) that only moves
+when `advance()` is called -- no wall time is read anywhere, so every
+behavior is deterministic and testable.
+"""
+
+
+class QuotaExceededError(Exception):
+    """Raised by `take()` when a key has no allowance left in its window."""
+
+
+# --- module state ---------------------------------------------------------
+# `_clock` is the logical now; `_hits` maps key -> list of hit timestamps.
+_clock = 0.0
+_hits = {}
+
+
+def reset():
+    """Reset the logical clock to 0.0 and drop every key's hits."""
+    global _clock
+    _clock = 0.0
+    _hits.clear()
+
+
+def now():
+    """Return the current logical clock value in seconds."""
+    return _clock
+
+
+def advance(seconds):
+    """Move the logical clock forward by `seconds` and return the new value.
+
+    The clock is monotonic: a negative step raises ValueError and leaves
+    the clock unchanged.
+    """
+    global _clock
+    if seconds < 0:
+        raise ValueError("clock is monotonic: cannot advance by %r" % (seconds,))
+    _clock = float(_clock + seconds)
+    return _clock
+
+
+def _in_window(key, window_seconds):
+    """Return the key's hits that are still inside the window.
+
+    Pruning is strictly-older-than: a hit sitting exactly at
+    `now - window_seconds` is kept.
+    """
+    cutoff = _clock - window_seconds
+    return [hit for hit in _hits.get(key, []) if hit >= cutoff]
+
+
+def take(key, limit, window_seconds, burst=0):
+    """Record a hit for `key` and return its in-window hit count.
+
+    Raises QuotaExceededError when the key already holds `limit + burst`
+    in-window hits.
+    """
+    hits = _in_window(key, window_seconds)
+    if len(hits) >= limit + burst:
+        _hits[key] = hits
+        raise QuotaExceededError(
+            "quota exceeded for %s: limit %s" % (key, limit))
+    hits.append(_clock)
+    _hits[key] = hits
+    return len(hits)
+
+
+def remaining(key, limit, window_seconds, burst=0):
+    """Return how many takes `key` has left, floored at 0. Records nothing."""
+    used = len(_in_window(key, window_seconds))
+    return max(0, limit + burst - used)
+
+
+def snapshot(window_seconds):
+    """Return {key: sorted in-window hit timestamps} for keys with any.
+
+    The returned lists are copies: mutating them cannot corrupt the store.
+    """
+    result = {}
+    for key in _hits:
+        hits = _in_window(key, window_seconds)
+        if hits:
+            result[key] = sorted(hits)
+    return result
+
+
+def time_to_next_slot(key, limit, window_seconds, burst=0):
+    """Return the seconds until `key` regains an allowance. Records nothing.
+
+    0.0 while the key still has headroom; otherwise the oldest in-window
+    hit's expiry. An exhausted key under an infinite window -- or one whose
+    allowance is zero, so no hit can ever free a slot -- never frees: inf.
+    """
+    if remaining(key, limit, window_seconds, burst=burst) > 0:
+        return 0.0
+    hits = _in_window(key, window_seconds)
+    if not hits or window_seconds == float("inf"):
+        return float("inf")
+    return float(min(hits) + window_seconds - _clock)
+
+
+def usage(key, limit, window_seconds, burst=0):
+    """Return the key's full quota state as a dict. Records nothing."""
+    return {
+        "used": len(_in_window(key, window_seconds)),
+        "allowed": limit + burst,
+        "remaining": remaining(key, limit, window_seconds, burst=burst),
+        "reset_in": time_to_next_slot(key, limit, window_seconds, burst=burst),
+    }
+
+
+def purge(window_seconds):
+    """Drop every key's aged-out hits and return how many were dropped.
+
+    Keys left with no hits are removed from the store entirely.
+    """
+    dropped = 0
+    for key in list(_hits):
+        kept = _in_window(key, window_seconds)
+        dropped += len(_hits[key]) - len(kept)
+        if kept:
+            _hits[key] = kept
+        else:
+            del _hits[key]
+    return dropped
diff --git a/app/ratelimit.py b/app/ratelimit.py
new file mode 100644
index 0000000..e8d5d75
--- /dev/null
+++ b/app/ratelimit.py
@@ -0,0 +1,105 @@
+"""Per-actor rate limiting for writes, layered over `app.quota`.
+
+The dispatch hook guards `POST` only -- reads are never counted. All
+counter state lives in `app.quota`; this module is policy plus rendering.
+
+Config keys (only the limit is required; the rest carry `.get` defaults):
+
+  rate_limit_max_per_window   int, required
+  rate_limit_window_seconds   float seconds, default 60
+  rate_limit_burst            int, default 0
+"""
+from app import quota
+
+
+DEFAULT_WINDOW_SECONDS = 60
+DEFAULT_BURST = 0
+
+
+class RateLimitExceededError(quota.QuotaExceededError):
+    """Raised when an actor exceeds its write allowance for the window."""
+
+
+def reset():
+    """Clear every key's counter and the quota clock."""
+    quota.reset()
+
+
+def check_and_increment(key, limit, window_seconds=float("inf"), burst=0):
+    """Record one write for `key` and return its in-window count.
+
+    Raises RateLimitExceededError (a QuotaExceededError subclass) once the
+    key's allowance is spent.
+    """
+    try:
+        return quota.take(key, limit, window_seconds, burst=burst)
+    except quota.QuotaExceededError as exc:
+        raise RateLimitExceededError(
+            "rate limit exceeded for %s: limit %s" % (key, limit)) from exc
+
+
+def _limit_of(config):
+    return config["rate_limit_max_per_window"]
+
+
+def _window_of(config):
+    return config.get("rate_limit_window_seconds", DEFAULT_WINDOW_SECONDS)
+
+
+def _burst_of(config):
+    return config.get("rate_limit_burst", DEFAULT_BURST)
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """Dispatch hook: count writes per actor, ignore every other method."""
+    if method != "POST":
+        return None
+    key = kwargs.get("actor", "anonymous")
+    check_and_increment(
+        key,
+        _limit_of(config),
+        window_seconds=_window_of(config),
+        burst=_burst_of(config),
+    )
+    return None
+
+
+def retry_after(key, config):
+    """Return the seconds until `key` may write again. Records nothing."""
+    return quota.time_to_next_slot(
+        key, _limit_of(config), _window_of(config), burst=_burst_of(config))
+
+
+def limit_headers(key, config):
+    """Return the X-RateLimit-* response headers for `key`, all strings.
+
+    `X-RateLimit-Limit` is the configured limit alone; any burst shows up
+    only in the remaining allowance. Records nothing.
+    """
+    limit = _limit_of(config)
+    return {
+        "X-RateLimit-Limit": str(limit),
+        "X-RateLimit-Remaining": str(quota.remaining(
+            key, limit, _window_of(config), burst=_burst_of(config))),
+        "X-RateLimit-Reset": str(quota.time_to_next_slot(
+            key, limit, _window_of(config), burst=_burst_of(config))),
+    }
+
+
+def status_line(key, config):
+    """Return a one-line human summary of `key`'s usage. Records nothing."""
+    state = quota.usage(
+        key, _limit_of(config), _window_of(config), burst=_burst_of(config))
+    return "%s: %s/%s, reset in %ss" % (
+        key, state["used"], state["allowed"], state["reset_in"])
+
+
+def check_many(keys, config):
+    """Return {key: would a write succeed right now}. Records nothing."""
+    limit = _limit_of(config)
+    window = _window_of(config)
+    burst = _burst_of(config)
+    return {
+        key: quota.remaining(key, limit, window, burst=burst) > 0
+        for key in keys
+    }
