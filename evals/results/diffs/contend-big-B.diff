@@ -0,0 +1,156 @@
+"""Tests for the multi-section report composer app/reportdoc.py."""
+import pytest
+
+from app import colspec, export, reportdoc
+
+
+def test_report_error_is_an_exception_subclass():
+    assert issubclass(reportdoc.ReportError, Exception)
+
+
+def test_section_shape_and_title_and_fmt_validation():
+    records = [{"a": 1}]
+    sec = reportdoc.section("Alpha", records, fmt="csv")
+    assert sec == {"title": "Alpha", "records": records, "fmt": "csv"}
+    default_sec = reportdoc.section("Alpha", records)
+    assert default_sec["fmt"] == "md"
+    with pytest.raises(reportdoc.ReportError):
+        reportdoc.section("", records)
+    with pytest.raises(reportdoc.ReportError):
+        reportdoc.section("   ", records)
+    # "html" is an EXTRA_FORMATS format and is accepted here.
+    reportdoc.section("Alpha", records, fmt="html")
+    with pytest.raises(reportdoc.ReportError) as exc:
+        reportdoc.section("Alpha", records, fmt="xml")
+    assert "xml" in str(exc.value)
+
+
+def test_render_section_delegates_to_export_render_any():
+    sec = reportdoc.section("Alpha", [{"a": 1}], fmt="csv")
+    calls = []
+    real_render_any = export.render_any
+
+    def recorder(records, fmt):
+        calls.append((records, fmt))
+        return real_render_any(records, fmt)
+
+    original = export.render_any
+    export.render_any = recorder
+    try:
+        result = reportdoc.render_section(sec)
+    finally:
+        export.render_any = original
+    assert calls == [([{"a": 1}], "csv")]
+    assert result == "## Alpha\n\n" + real_render_any([{"a": 1}], "csv")
+
+    # An empty-records section never calls render_any.
+    empty_sec = reportdoc.section("T", [])
+    calls = []
+    export.render_any = recorder
+    try:
+        empty_result = reportdoc.render_section(empty_sec)
+    finally:
+        export.render_any = original
+    assert calls == []
+    assert empty_result == "## T\n\n(no records)"
+
+
+def test_render_report_exact_string_and_empty_sections_marker():
+    sections = [
+        reportdoc.section("Alpha", [{"a": 1}], fmt="csv"),
+        reportdoc.section("Beta", [{"b": 2}, {"b": 3}], fmt="csv"),
+    ]
+    expected = "# R\n\n## Alpha\n\na\n1\n\n## Beta\n\nb\n2\n3"
+    assert reportdoc.render_report("R", sections) == expected
+    assert reportdoc.render_report("R", []) == "# R\n\n(empty report)"
+
+
+def test_duplicate_section_titles_raise_from_render_report_and_toc():
+    sections = [
+        reportdoc.section("Alpha", [{"a": 1}], fmt="csv"),
+        reportdoc.section("Alpha", [{"a": 2}], fmt="csv"),
+    ]
+    with pytest.raises(reportdoc.ReportError) as exc:
+        reportdoc.render_report("R", sections)
+    assert "Alpha" in str(exc.value)
+    with pytest.raises(reportdoc.ReportError) as exc:
+        reportdoc.toc(sections)
+    assert "Alpha" in str(exc.value)
+
+
+def test_toc_and_record_counts():
+    sections = [
+        reportdoc.section("Alpha", [{"a": 1}], fmt="csv"),
+        reportdoc.section("Beta", [{"b": 2}, {"b": 3}], fmt="csv"),
+    ]
+    assert reportdoc.toc(sections) == ["Alpha", "Beta"]
+    assert reportdoc.record_counts(sections) == {"Alpha": 1, "Beta": 2}
+
+
+def test_summary_exact_literal_and_empty():
+    sections = [
+        reportdoc.section("Alpha", [{"a": 1}], fmt="csv"),
+        reportdoc.section("Beta", [{"b": 2}, {"b": 3}], fmt="csv"),
+    ]
+    assert reportdoc.summary(sections) == "2 sections, 3 records"
+    assert reportdoc.summary([]) == "0 sections, 0 records"
+
+
+def test_render_index_one_based_lines_and_empty_marker():
+    sections = [
+        reportdoc.section("Alpha", [{"a": 1}], fmt="csv"),
+        reportdoc.section("Beta", [{"b": 2}, {"b": 3}], fmt="csv"),
+    ]
+    expected = "1. Alpha (1 records)\n2. Beta (2 records)"
+    assert reportdoc.render_index(sections) == expected
+    assert reportdoc.render_index([]) == "(empty report)"
+
+
+def test_projected_section_delegates_to_colspec_project_end_to_end():
+    pairs = colspec.parse_colspec("a:A")
+    records = [{"a": 1, "b": 2}]
+    calls = []
+    real_project = colspec.project
+
+    def recorder(recs, pairs_arg):
+        calls.append((recs, pairs_arg))
+        return real_project(recs, pairs_arg)
+
+    original = colspec.project
+    colspec.project = recorder
+    try:
+        sec = reportdoc.projected_section("T", records, pairs, "csv")
+    finally:
+        colspec.project = original
+    assert calls == [(records, pairs)]
+    assert sec == {"title": "T", "records": [{"A": 1}], "fmt": "csv"}
+    assert reportdoc.render_section(sec) == "## T\n\nA\n1"
+
+
+def test_find_section_returns_same_object_or_raises_naming_title():
+    sec_a = reportdoc.section("Alpha", [{"a": 1}], fmt="csv")
+    sec_b = reportdoc.section("Beta", [{"b": 2}], fmt="csv")
+    sections = [sec_a, sec_b]
+    assert reportdoc.find_section(sections, "Beta") is sec_b
+    with pytest.raises(reportdoc.ReportError) as exc:
+        reportdoc.find_section(sections, "Gamma")
+    assert "Gamma" in str(exc.value)
+
+
+def test_merge_reports_new_list_unmutated_inputs_and_shared_dup_check():
+    sec_a = reportdoc.section("Alpha", [{"a": 1}], fmt="csv")
+    sec_b = reportdoc.section("Beta", [{"b": 2}, {"b": 3}], fmt="csv")
+    a = [sec_a]
+    b = [sec_b]
+    merged = reportdoc.merge_reports(a, b)
+    assert merged == [sec_a, sec_b]
+    assert a == [sec_a]
+    assert b == [sec_b]
+    assert merged is not a
+    assert merged is not b
+
+    dup_a = [reportdoc.section("Same", [{"a": 1}], fmt="csv")]
+    dup_b = [reportdoc.section("Same", [{"a": 2}], fmt="csv")]
+    with pytest.raises(reportdoc.ReportError) as exc:
+        reportdoc.merge_reports(dup_a, dup_b)
+    assert "Same" in str(exc.value)
