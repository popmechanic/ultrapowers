@@ -0,0 +1,204 @@
+"""Tests for the export formatters in app/export.py."""
+import json
+
+import pytest
+
+from app import export
+
+
+def test_to_csv_empty_list_has_no_header_row():
+    assert export.to_csv([]) == ""
+
+
+def test_to_csv_header_is_sorted_union_and_missing_fields_are_empty():
+    records = [{"name": "coffee", "amount": 3}, {"name": "tea"}]
+    assert export.to_csv(records) == "amount,name\n3,coffee\n,tea"
+
+
+def test_to_csv_renders_int_and_float_via_plain_str():
+    assert export.to_csv([{"amount": 5}]) == "amount\n5"
+    assert export.to_csv([{"amount": 5.5}]) == "amount\n5.5"
+
+
+def test_to_json_empty_list():
+    assert export.to_json([]) == "[]"
+
+
+def test_to_json_round_trips_and_keys_are_sorted():
+    records = [{"b": 1, "a": 2}]
+    raw = export.to_json(records)
+    assert raw == '[{"a": 2, "b": 1}]'
+    assert json.loads(raw) == records
+
+
+def test_to_csv_escapes_cells_via_tabular_escape_csv():
+    comma_line = export.to_csv([{"name": "a,b", "amount": 1}])
+    assert comma_line == 'amount,name\n1,"a,b"'
+    quote_line = export.to_csv([{"name": 'say "hi"', "amount": 1}])
+    assert quote_line == 'amount,name\n1,"say ""hi"""'
+    # A simple record with no special characters is byte-identical to the
+    # unescaped join -- escaping never changes the plain case.
+    simple_line = export.to_csv([{"name": "plain", "amount": 1}])
+    assert simple_line == "amount,name\n1,plain"
+    unescaped_join = "amount,name\n" + "1,plain"
+    assert simple_line == unescaped_join
+
+
+def test_to_markdown_empty_list():
+    assert export.to_markdown([]) == ""
+
+
+def test_to_markdown_pads_to_column_widths_with_missing_fields_empty():
+    records = [{"a": 1, "b": 22}, {"a": 333, "c": 4}]
+    expected = (
+        "| a   | b  | c |\n"
+        "| --- | -- | - |\n"
+        "| 1   | 22 |   |\n"
+        "| 333 |    | 4 |"
+    )
+    assert export.to_markdown(records) == expected
+
+
+def test_to_ndjson_empty_list():
+    assert export.to_ndjson([]) == ""
+
+
+def test_to_ndjson_one_object_per_line_no_trailing_newline():
+    records = [{"a": 1}, {"b": 2}]
+    raw = export.to_ndjson(records)
+    assert raw == '{"a": 1}\n{"b": 2}'
+    lines = raw.split("\n")
+    assert len(lines) == 2
+    assert [json.loads(line) for line in lines] == records
+
+
+def test_to_markdown_align_left_and_right_exact_strings_and_bad_align_raises():
+    records = [{"a": 1, "b": 22}, {"a": 333, "c": 4}]
+    left_expected = (
+        "| a   | b  | c |\n"
+        "| --- | -- | - |\n"
+        "| 1   | 22 |   |\n"
+        "| 333 |    | 4 |"
+    )
+    right_expected = (
+        "|   a |  b | c |\n"
+        "| --: | -: | : |\n"
+        "|   1 | 22 |   |\n"
+        "| 333 |    | 4 |"
+    )
+    assert export.to_markdown(records, align="left") == left_expected
+    assert export.to_markdown(records) == left_expected
+    assert export.to_markdown(records, align="right") == right_expected
+    # Bad align raises even on a fixture whose cells already meet their
+    # column widths -- the delegation to tabular.pad is not skippable by
+    # pad's width short-circuit.
+    already_fit = [{"a": "x"}]
+    with pytest.raises(ValueError):
+        export.to_markdown(already_fit, align="center")
+    with pytest.raises(ValueError):
+        export.to_markdown(records, align="center")
+
+
+def test_to_tsv_empty_list():
+    assert export.to_tsv([]) == ""
+
+
+def test_to_tsv_sanitizes_cells_and_header_names_and_pads_missing_as_empty():
+    records = [{"na\tme": "a\tb\nc", "note": "clean"}]
+    assert export.to_tsv(records) == "na me\tnote\na b c\tclean"
+
+
+def test_to_html_empty_list():
+    assert export.to_html([]) == ""
+
+
+def test_to_html_exact_multiline_literal_with_escaped_special_chars():
+    records = [{"a": "<x>", "b": "y&z"}, {"a": "p"}]
+    expected = (
+        "<table>\n"
+        "<tr><th>a</th><th>b</th></tr>\n"
+        "<tr><td>&lt;x&gt;</td><td>y&amp;z</td></tr>\n"
+        "<tr><td>p</td><td></td></tr>\n"
+        "</table>"
+    )
+    assert export.to_html(records) == expected
+
+
+def test_parse_csv_inverse_of_to_csv_with_quoted_comma_quote_and_newline():
+    assert export.parse_csv("") == []
+    record = {"name": 'a,"b"\nc', "amount": 3}
+    csv_text = export.to_csv([record])
+    assert csv_text == 'amount,name\n3,"a,""b""\nc"'
+    parsed = export.parse_csv(csv_text)
+    # parse_csv never re-types values -- everything comes back as a string.
+    expected = {k: str(v) for k, v in record.items()}
+    assert parsed == [expected]
+
+
+def test_parse_csv_unterminated_quote_raises():
+    with pytest.raises(ValueError):
+        export.parse_csv('"abc')
+
+
+def test_parse_csv_single_column_trailing_newline_corner():
+    assert export.parse_csv("a\n") == [{"a": ""}]
+    assert export.parse_csv("a") == []
+
+
+def test_formats_dict_has_exactly_the_five_keys():
+    assert set(export.FORMATS) == {"csv", "json", "md", "ndjson", "tsv"}
+    assert export.FORMATS["csv"] is export.to_csv
+    assert export.FORMATS["json"] is export.to_json
+    assert export.FORMATS["md"] is export.to_markdown
+    assert export.FORMATS["ndjson"] is export.to_ndjson
+    assert export.FORMATS["tsv"] is export.to_tsv
+
+
+def test_extra_formats_has_exactly_html_kept_out_of_formats():
+    assert set(export.EXTRA_FORMATS) == {"html"}
+    assert export.EXTRA_FORMATS["html"] is export.to_html
+    assert "html" not in export.FORMATS
+
+
+def test_render_delegates_to_matching_function_for_all_formats():
+    records = [{"a": 1, "b": 2}]
+    for fmt, fn in export.FORMATS.items():
+        assert export.render(records, fmt) == fn(records)
+
+
+def test_render_rejects_unknown_and_extra_only_formats():
+    with pytest.raises(ValueError) as exc:
+        export.render([], "xml")
+    assert "xml" in str(exc.value)
+    with pytest.raises(ValueError):
+        export.render([], "html")
+
+
+def test_render_any_serves_formats_then_extra_formats():
+    records = [{"a": 1, "b": 2}]
+    assert export.render_any(records, "csv") == export.to_csv(records)
+    assert export.render_any(records, "html") == export.to_html(records)
+    with pytest.raises(ValueError) as exc:
+        export.render_any(records, "xml")
+    assert "xml" in str(exc.value)
+
+
+def test_summary_line_exact_format():
+    records = [{"a": 1, "b": 22}, {"a": 333, "c": 4}]
+    assert export.summary_line(records) == "2 records, 3 columns"
+    assert export.summary_line([]) == "0 records, 0 columns"
+
+
+def test_single_record_coverage_for_all_formats_and_html():
+    record = [{"a": 1, "b": 2}]
+    assert export.to_csv(record) == "a,b\n1,2"
+    assert export.to_json(record) == '[{"a": 1, "b": 2}]'
+    assert export.to_markdown(record) == "| a | b |\n| - | - |\n| 1 | 2 |"
+    assert export.to_ndjson(record) == '{"a": 1, "b": 2}'
+    assert export.to_tsv(record) == "a\tb\n1\t2"
+    assert export.to_html(record) == (
+        "<table>\n"
+        "<tr><th>a</th><th>b</th></tr>\n"
+        "<tr><td>1</td><td>2</td></tr>\n"
+        "</table>"
+    )
