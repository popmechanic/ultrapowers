+"""Tests for app/backoff.py -- a deterministic retry-schedule calculator
+built on app/quota.py."""
+import pytest
+
+from app import backoff, quota
+from app.backoff import BackoffError
+from app.quota import QuotaExceededError
+
+
+def setup_function(_fn):
+    quota.reset()
+
+
+def test_backoff_error_is_an_exception_subclass_distinct_from_quota_error():
+    assert issubclass(BackoffError, Exception)
+    assert not issubclass(BackoffError, QuotaExceededError)
+
+
+def test_schedule_exact_values_and_types():
+    result = backoff.schedule(1.0, 2.0, 3)
+    assert result == [1.0, 2.0, 4.0]
+    assert all(type(x) is float for x in result)
+
+    assert backoff.schedule(1.0, 2.0, 0) == []
+
+    with pytest.raises(BackoffError):
+        backoff.schedule(0, 2.0, 3)
+    with pytest.raises(BackoffError):
+        backoff.schedule(1.0, 0.5, 3)
+    with pytest.raises(BackoffError):
+        backoff.schedule(1.0, 2.0, -1)
+
+
+def test_capped_element_wise_min_and_input_unmutated():
+    seq = [1.0, 2.0, 4.0]
+    result = backoff.capped(seq, 3.0)
+    assert result == [1.0, 2.0, 3.0]
+    assert seq == [1.0, 2.0, 4.0]
+
+    with pytest.raises(BackoffError):
+        backoff.capped(seq, 0)
+
+
+def test_total_wait_sums_and_empty_is_zero():
+    assert backoff.total_wait([1.0, 2.0, 3.0]) == 6.0
+    assert backoff.total_wait([]) == 0.0
+
+
+def test_next_delay_exact_values_and_negative_attempt_raises():
+    assert backoff.next_delay(0, 1.0, 2.0, 60.0) == 1.0
+    assert backoff.next_delay(6, 1.0, 2.0, 60.0) == 60.0
+    with pytest.raises(BackoffError):
+        backoff.next_delay(-1, 1.0, 2.0, 60.0)
+
+
+def test_delay_until_free_delegates_and_end_to_end(monkeypatch):
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 0.0
+
+    monkeypatch.setattr(quota, "time_to_next_slot", recorder)
+    config = {
+        "rate_limit_max_per_window": 3,
+        "rate_limit_window_seconds": 60,
+        "rate_limit_burst": 1,
+    }
+    backoff.delay_until_free("k", config)
+    assert calls == [(("k", 3, 60), {"burst": 1})]
+
+    monkeypatch.undo()
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    minimal_config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert backoff.delay_until_free("k", minimal_config) == 50.0
+
+
+def test_retry_plan_exact_dict_fresh_and_exhausted():
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert backoff.retry_plan("k", config, retries=3) == {
+        "immediate": True,
+        "wait": 0.0,
+        "backoff": [1.0, 2.0, 4.0],
+    }
+
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    assert backoff.retry_plan("k", config, retries=3) == {
+        "immediate": False,
+        "wait": 50.0,
+        "backoff": [1.0, 2.0, 4.0],
+    }
+    # read-only: no hit was ever recorded by retry_plan itself
+    assert quota.remaining("k", 2, 60) == 0
+    quota.advance(51)
+    assert quota.remaining("k", 2, 60) == 2
+
+
+def test_describe_schedule_exact_literal_and_empty():
+    assert backoff.describe_schedule([1.0, 2.0, 4.0]) == "1.0s, 2.0s, 4.0s"
+    assert backoff.describe_schedule([]) == "(no retries)"
