+
+
+def test_filter_entries_reads_a_live_audit_log():
+    """The one non-pure test: audit_query composed over app.audit."""
+    from app import audit
+
+    audit.clear()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(None, config, "GET", "/records", {"actor": "alice"})
+    audit.dispatch_hook(None, config, "POST", "/records", {"actor": "bob"})
+
+    assert q.filter_entries(audit.entries(), actor="bob") == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+    ]
+    audit.clear()
diff --git a/tests/test_backoff.py b/tests/test_backoff.py
new file mode 100644
index 0000000..d898536
--- /dev/null
+++ b/tests/test_backoff.py
@@ -0,0 +1,104 @@
+import pytest
+
+from app import backoff, quota
+
+
+def test_backoff_error_is_a_distinct_exception_subclass():
+    quota.reset()
+    assert issubclass(backoff.BackoffError, Exception)
+    assert not issubclass(backoff.BackoffError, quota.QuotaExceededError)
+    assert not issubclass(quota.QuotaExceededError, backoff.BackoffError)
+
+
+def test_schedule_returns_exponential_float_delays():
+    quota.reset()
+    seq = backoff.schedule(1.0, 2.0, 3)
+    assert seq == [1.0, 2.0, 4.0]
+    assert all(type(delay) is float for delay in seq)
+    assert backoff.schedule(1.0, 2.0, 0) == []
+    with pytest.raises(backoff.BackoffError) as excinfo:
+        backoff.schedule(0, 2.0, 3)
+    assert "base" in str(excinfo.value)
+    with pytest.raises(backoff.BackoffError) as excinfo:
+        backoff.schedule(1.0, 0.5, 3)
+    assert "factor" in str(excinfo.value)
+    with pytest.raises(backoff.BackoffError) as excinfo:
+        backoff.schedule(1.0, 2.0, -1)
+    assert "retries" in str(excinfo.value)
+
+
+def test_capped_clamps_element_wise():
+    quota.reset()
+    seq = [1.0, 2.0, 4.0]
+    assert backoff.capped(seq, 3.0) == [1.0, 2.0, 3.0]
+    assert seq == [1.0, 2.0, 4.0]
+    with pytest.raises(backoff.BackoffError) as excinfo:
+        backoff.capped(seq, 0)
+    assert "cap" in str(excinfo.value)
+
+
+def test_total_wait_sums_the_schedule():
+    quota.reset()
+    assert backoff.total_wait([1.0, 2.0, 3.0]) == 6.0
+    assert backoff.total_wait([]) == 0.0
+
+
+def test_next_delay_is_the_capped_exponential_term():
+    quota.reset()
+    assert backoff.next_delay(0, 1.0, 2.0, 60.0) == 1.0
+    assert backoff.next_delay(6, 1.0, 2.0, 60.0) == 60.0
+    with pytest.raises(backoff.BackoffError) as excinfo:
+        backoff.next_delay(-1, 1.0, 2.0, 60.0)
+    assert "attempt" in str(excinfo.value)
+
+
+def test_delay_until_free_delegates_to_time_to_next_slot(monkeypatch):
+    quota.reset()
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 7.5
+
+    monkeypatch.setattr(quota, "time_to_next_slot", recorder)
+    assert backoff.delay_until_free("k", {"rate_limit_max_per_window": 2}) == 7.5
+    assert calls == [(("k", 2, 60), {"burst": 0})]
+    monkeypatch.undo()
+
+    quota.reset()
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert backoff.delay_until_free("k", config) == 50.0
+    assert backoff.delay_until_free("k", {"rate_limit_max_per_window": 2}) == 50.0
+
+
+def test_retry_plan_reports_immediacy_wait_and_backoff():
+    quota.reset()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert backoff.retry_plan("k", config, 3) == {
+        "immediate": True,
+        "wait": 0.0,
+        "backoff": [1.0, 2.0, 4.0],
+    }
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    assert backoff.retry_plan("k", config, 3) == {
+        "immediate": False,
+        "wait": 50.0,
+        "backoff": [1.0, 2.0, 4.0],
+    }
+    assert backoff.retry_plan("k", config, 3) == {
+        "immediate": False,
+        "wait": 50.0,
+        "backoff": [1.0, 2.0, 4.0],
+    }
+    assert quota.take("other", 2, 60) == 1
+
+
+def test_describe_schedule_renders_the_delays():
+    quota.reset()
+    assert backoff.describe_schedule([1.0, 2.0, 4.0]) == "1.0s, 2.0s, 4.0s"
+    assert backoff.describe_schedule([]) == "(no retries)"
diff --git a/tests/test_coerce.py b/tests/test_coerce.py
new file mode 100644
index 0000000..c978ae1
--- /dev/null
+++ b/tests/test_coerce.py
@@ -0,0 +1,103 @@
+"""Tests for app/coerce.py -- the pre-validation coercion layer."""
+import pytest
+
+from app import coerce, schema
+
+
+def test_coerce_error_is_distinct_from_schema_error():
+    assert issubclass(coerce.CoerceError, Exception)
+    assert not issubclass(coerce.CoerceError, schema.SchemaError)
+    assert not issubclass(schema.SchemaError, coerce.CoerceError)
+
+
+def test_coerce_catalog_is_pinned():
+    assert coerce.COERCE_CATALOG == {
+        "amount": "cannot coerce {field} to a number (got {value!r})",
+        "flag": "cannot coerce {field} to a flag (got {value!r})",
+    }
+
+
+def test_parse_amount_accepts_numeric_strings_and_numbers():
+    assert coerce.parse_amount("3", field="amount") == 3
+    assert type(coerce.parse_amount("3", field="amount")) is int
+    assert coerce.parse_amount("3.5", field="amount") == 3.5
+    assert coerce.parse_amount("  7 ", field="amount") == 7
+    assert coerce.parse_amount(4, field="amount") == 4
+    assert coerce.parse_amount(3.5, field="amount") == 3.5
+    for bad in (True, False, "abc", "", None, "nan", "inf"):
+        with pytest.raises(coerce.CoerceError):
+            coerce.parse_amount(bad, field="amount")
+
+
+def test_parse_amount_delegates_to_schema_is_valid_amount(monkeypatch):
+    assert coerce.parse_amount("3", field="a") == 3
+    monkeypatch.setattr(schema, "is_valid_amount", lambda value: False)
+    with pytest.raises(coerce.CoerceError):
+        coerce.parse_amount("3", field="a")
+
+
+def test_parse_amount_error_message_is_exact():
+    with pytest.raises(coerce.CoerceError) as err:
+        coerce.parse_amount("abc", field="amount")
+    assert str(err.value) == "cannot coerce amount to a number (got 'abc')"
+
+
+def test_parse_flag_reads_the_usual_spellings():
+    for truthy in ("true", "yes", "1", "on", "  YES "):
+        assert coerce.parse_flag(truthy, field="active") is True
+    for falsy in ("false", "no", "0", "off"):
+        assert coerce.parse_flag(falsy, field="active") is False
+    assert coerce.parse_flag(True, field="active") is True
+    assert coerce.parse_flag(False, field="active") is False
+    for bad in ("maybe", None, 3, []):
+        with pytest.raises(coerce.CoerceError):
+            coerce.parse_flag(bad, field="active")
+    with pytest.raises(coerce.CoerceError) as err:
+        coerce.parse_flag("maybe", field="active")
+    assert str(err.value) == "cannot coerce active to a flag (got 'maybe')"
+
+
+def test_coerce_fields_only_touches_number_typed_strings():
+    spec = {
+        "amount": {"type": "number"},
+        "name": {"type": "str"},
+        "size": {"type": "number"},
+    }
+    fields = {"amount": "42", "name": "  7 ", "size": 3.5, "extra": "9"}
+    result = coerce.coerce_fields(fields, spec)
+    assert result == {"amount": 42, "name": "  7 ", "size": 3.5, "extra": "9"}
+    assert fields == {"amount": "42", "name": "  7 ", "size": 3.5, "extra": "9"}
+    assert result is not fields
+
+
+def test_coerce_report_collects_failures_in_spec_order():
+    spec = {
+        "amount": {"type": "number"},
+        "size": {"type": "number"},
+        "weight": {"type": "number"},
+    }
+    fields = {"amount": "abc", "size": "5", "weight": ""}
+    coerced, errors = coerce.coerce_report(fields, spec)
+    assert coerced == {"amount": "abc", "size": 5, "weight": ""}
+    assert errors == [
+        ("amount", "cannot coerce amount to a number (got 'abc')"),
+        ("weight", "cannot coerce weight to a number (got '')"),
+    ]
+
+
+def test_coercion_makes_a_spec_validator_accept_a_string_amount():
+    spec = {"amount": {"required": True, "type": "number"}}
+    validator = schema.compile_spec(spec)
+    assert validator(coerce.coerce_fields({"amount": "42"}, spec)) == {"amount": 42}
+    with pytest.raises(schema.SchemaError) as err:
+        validator({"amount": "42"})
+    assert str(err.value) == "field amount must be numeric (got str)"
+
+
+def test_describe_coercions_lists_number_typed_fields_in_sorted_order():
+    assert coerce.describe_coercions(
+        {"amount": {"type": "number"}, "name": {"type": "str"}}) == "amount: number"
+    assert coerce.describe_coercions(
+        {"size": {"type": "number"}, "amount": {"type": "number"}}) == (
+            "amount: number\nsize: number")
+    assert coerce.describe_coercions({"name": {"type": "str"}}) == "(no coercions)"
diff --git a/tests/test_colspec.py b/tests/test_colspec.py
new file mode 100644
index 0000000..33c557c
--- /dev/null
+++ b/tests/test_colspec.py
@@ -0,0 +1,101 @@
+"""Tests for app/colspec.py — the column-projection layer."""
+import pytest
+
+from app import colspec
+from app import tabular
+
+
+# Two records with unequal key sets: tabular.columns() is ["a", "b", "x"].
+FIX = [{"a": 1, "x": 9}, {"b": 2}]
+
+
+def test_colspec_error_is_an_exception():
+    assert issubclass(colspec.ColspecError, Exception)
+
+
+def test_parse_colspec_reads_source_header_pairs():
+    assert colspec.parse_colspec("a,b:B,c") == [("a", "a"), ("b", "B"), ("c", "c")]
+    assert colspec.parse_colspec("a , b : B") == [("a", "a"), ("b", "B")]
+    with pytest.raises(colspec.ColspecError):
+        colspec.parse_colspec("")
+    with pytest.raises(colspec.ColspecError):
+        colspec.parse_colspec("a,,b")
+    with pytest.raises(colspec.ColspecError):
+        colspec.parse_colspec("a:b:c")
+
+
+def test_parse_colspec_rejects_duplicate_sources_and_headers():
+    with pytest.raises(colspec.ColspecError) as excinfo:
+        colspec.parse_colspec("a,a:A")
+    assert "a" in str(excinfo.value)
+    with pytest.raises(colspec.ColspecError) as excinfo:
+        colspec.parse_colspec("a:X,b:X")
+    assert "X" in str(excinfo.value)
+
+
+def test_project_renames_fields_and_fills_absent_sources_with_none():
+    pairs = colspec.parse_colspec("a,b:B,c")
+    before = [dict(r) for r in FIX]
+    assert colspec.project(FIX, pairs) == [
+        {"a": 1, "B": None, "c": None},
+        {"a": None, "B": 2, "c": None},
+    ]
+    assert FIX == before
+
+
+def test_available_splits_sources_against_tabular_columns(monkeypatch):
+    calls = []
+    real_columns = tabular.columns
+
+    def recorder(records):
+        calls.append(records)
+        return real_columns(records)
+
+    monkeypatch.setattr(tabular, "columns", recorder)
+    pairs = colspec.parse_colspec("a,b:B,c")
+    assert colspec.available(FIX, pairs) == (["a", "b"], ["c"])
+    assert calls == [FIX]
+
+
+def test_auto_colspec_mirrors_every_column():
+    assert colspec.auto_colspec(FIX) == [("a", "a"), ("b", "b"), ("x", "x")]
+    assert colspec.auto_colspec([]) == []
+
+
+def test_header_row_and_rename_map():
+    pairs = colspec.parse_colspec("a,b:B,c")
+    assert colspec.header_row(pairs) == ["a", "B", "c"]
+    assert colspec.rename_map(pairs) == {"b": "B"}
+
+
+def test_select_and_drop_keep_or_remove_named_sources():
+    before = [dict(r) for r in FIX]
+    assert colspec.select(FIX, ["a", "b"]) == [{"a": 1}, {"b": 2}]
+    assert colspec.drop(FIX, ["a", "b"]) == [{"x": 9}, {}]
+    assert FIX == before
+    with pytest.raises(colspec.ColspecError):
+        colspec.select(FIX, [])
+    with pytest.raises(colspec.ColspecError):
+        colspec.drop(FIX, [])
+
+
+def test_sanitize_headers_flattens_every_header(monkeypatch):
+    calls = []
+    real_sanitize = tabular.sanitize_flat
+
+    def recorder(value):
+        calls.append(value)
+        return real_sanitize(value)
+
+    monkeypatch.setattr(tabular, "sanitize_flat", recorder)
+    pairs = [("a", "a"), ("b", "B\tC")]
+    assert colspec.sanitize_headers(pairs) == [("a", "a"), ("b", "B C")]
+    assert calls == ["a", "B\tC"]
+    clean = colspec.parse_colspec("a,b:B")
+    assert colspec.sanitize_headers(clean) == clean
+
+
+def test_describe_colspec_renders_one_line_per_pair():
+    pairs = colspec.parse_colspec("a,b:B,c")
+    assert colspec.describe_colspec(pairs) == "a <- a\nB <- b\nc <- c"
+    assert colspec.describe_colspec([]) == "(no columns)"
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..d940e25
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,204 @@
+"""Tests for app/export.py — the record export formatter."""
+import json
+
+import pytest
+
+from app import export
+from app import tabular
+from app.registry import bootstrap
+
+
+# Two records with deliberately unequal key sets: the union is
+# ["amount", "name", "note"].
+UNEQUAL = [{"name": "coffee", "amount": 3}, {"name": "tea", "note": "x"}]
+
+
+def test_to_csv_of_an_empty_list_is_the_empty_string():
+    assert export.to_csv([]) == ""
+
+
+def test_to_csv_emits_the_sorted_column_union_then_one_row_per_record():
+    assert export.to_csv(UNEQUAL) == "amount,name,note\n3,coffee,\n,tea,x"
+
+
+def test_to_csv_renders_numbers_via_plain_str():
+    assert export.to_csv([{"amount": 3}]) == "amount\n3"
+    assert export.to_csv([{"amount": 3.5}]) == "amount\n3.5"
+
+
+def test_to_json_of_an_empty_list_is_an_empty_json_array():
+    assert export.to_json([]) == "[]"
+
+
+def test_to_json_sorts_keys_and_round_trips():
+    raw = export.to_json([{"name": "coffee", "amount": 3}])
+    assert raw == '[{"amount": 3, "name": "coffee"}]'
+    assert json.loads(raw) == [{"name": "coffee", "amount": 3}]
+    assert json.loads(export.to_json(UNEQUAL)) == UNEQUAL
+
+
+def test_to_csv_escapes_cells_and_leaves_plain_ones_byte_identical():
+    assert export.to_csv([{"amount": 1, "name": "a,b"}]) == 'amount,name\n1,"a,b"'
+    assert export.to_csv([{"name": 'say "hi"'}]) == 'name\n"say ""hi"""'
+    # A record with nothing special is byte-identical to the unescaped join.
+    assert export.to_csv([{"a": "x", "b": "y"}]) == "a,b\nx,y"
+
+
+def test_to_markdown_renders_a_width_padded_pipe_table():
+    assert export.to_markdown([]) == ""
+    assert export.to_markdown(UNEQUAL) == (
+        "| amount | name   | note |\n"
+        "| ------ | ------ | ---- |\n"
+        "| 3      | coffee |      |\n"
+        "|        | tea    | x    |"
+    )
+
+
+def test_to_ndjson_renders_one_sorted_json_object_per_line():
+    assert export.to_ndjson([]) == ""
+    raw = export.to_ndjson(UNEQUAL)
+    assert raw == (
+        '{"amount": 3, "name": "coffee"}\n'
+        '{"name": "tea", "note": "x"}'
+    )
+    assert [json.loads(line) for line in raw.split("\n")] == UNEQUAL
+
+
+def test_to_markdown_honours_the_align_keyword():
+    records = [{"item": "x", "qty": 5}]
+    assert export.to_markdown(records) == (
+        "| item | qty |\n"
+        "| ---- | --- |\n"
+        "| x    | 5   |"
+    )
+    assert export.to_markdown(records, align="left") == export.to_markdown(records)
+    assert export.to_markdown(records, align="right") == (
+        "| item | qty |\n"
+        "| ---: | --: |\n"
+        "|    x |   5 |"
+    )
+    with pytest.raises(ValueError) as excinfo:
+        export.to_markdown(records, align="center")
+    assert "center" in str(excinfo.value)
+    # Even when every cell already meets its column width, the delegation to
+    # tabular.pad must still reject the bad align.
+    with pytest.raises(ValueError):
+        export.to_markdown([{"ab": "cd"}], align="center")
+
+
+def test_to_tsv_sanitizes_both_cells_and_column_names():
+    assert export.to_tsv([]) == ""
+    assert export.to_tsv(UNEQUAL) == "amount\tname\tnote\n3\tcoffee\t\n\ttea\tx"
+    assert export.to_tsv([{"a": "x\ty", "b": "p\nq"}]) == "a\tb\nx y\tp q"
+    assert export.to_tsv([{"a\tb": 1}]) == "a b\n1"
+    assert export.to_tsv([{"a\nb": 1}]) == "a b\n1"
+
+
+def test_to_html_renders_an_escaped_table():
+    assert export.to_html([]) == ""
+    records = [{"name": "a & b", "amount": 1}, {"name": "<x>", "note": "n"}]
+    assert export.to_html(records) == (
+        "<table>\n"
+        "<tr><th>amount</th><th>name</th><th>note</th></tr>\n"
+        "<tr><td>1</td><td>a &amp; b</td><td></td></tr>\n"
+        "<tr><td></td><td>&lt;x&gt;</td><td>n</td></tr>\n"
+        "</table>"
+    )
+
+
+def test_parse_csv_is_the_inverse_of_to_csv():
+    assert export.parse_csv("") == []
+    assert export.parse_csv("amount,name\n3,coffee") == [
+        {"amount": "3", "name": "coffee"},
+    ]
+    # Parsing never re-types values.
+    assert export.parse_csv(export.to_csv([{"amount": 3}])) == [{"amount": "3"}]
+    # Quoted cells.
+    assert export.parse_csv('a,b\n"x,y",z') == [{"a": "x,y", "b": "z"}]
+    assert export.parse_csv('a\n"say ""hi"""') == [{"a": 'say "hi"'}]
+    record = {"amount": 3, "name": 'a,b "q"\nz'}
+    assert export.parse_csv(export.to_csv([record])) == [
+        {"amount": "3", "name": 'a,b "q"\nz'},
+    ]
+    with pytest.raises(ValueError):
+        export.parse_csv('a\n"unterminated')
+    # Single-column corners.
+    assert export.parse_csv("a\n") == [{"a": ""}]
+    assert export.parse_csv("a") == []
+
+
+def test_formats_maps_the_five_route_reachable_names():
+    assert export.FORMATS == {
+        "csv": export.to_csv,
+        "json": export.to_json,
+        "md": export.to_markdown,
+        "ndjson": export.to_ndjson,
+        "tsv": export.to_tsv,
+    }
+
+
+def test_extra_formats_holds_html_only_and_stays_out_of_formats():
+    assert export.EXTRA_FORMATS == {"html": export.to_html}
+    assert "html" not in export.FORMATS
+
+
+def test_render_delegates_to_every_format_function():
+    assert export.render(UNEQUAL, "csv") == export.to_csv(UNEQUAL)
+    assert export.render(UNEQUAL, "json") == export.to_json(UNEQUAL)
+    assert export.render(UNEQUAL, "md") == export.to_markdown(UNEQUAL)
+    assert export.render(UNEQUAL, "ndjson") == export.to_ndjson(UNEQUAL)
+    assert export.render(UNEQUAL, "tsv") == export.to_tsv(UNEQUAL)
+
+
+def test_render_rejects_unknown_and_extra_formats():
+    with pytest.raises(ValueError) as excinfo:
+        export.render(UNEQUAL, "xml")
+    assert "xml" in str(excinfo.value)
+    with pytest.raises(ValueError) as excinfo:
+        export.render(UNEQUAL, "html")
+    assert "html" in str(excinfo.value)
+
+
+def test_render_any_serves_formats_then_extra_formats():
+    assert export.render_any(UNEQUAL, "csv") == export.to_csv(UNEQUAL)
+    assert export.render_any(UNEQUAL, "html") == export.to_html(UNEQUAL)
+    with pytest.raises(ValueError) as excinfo:
+        export.render_any(UNEQUAL, "xml")
+    assert "xml" in str(excinfo.value)
+
+
+def test_summary_line_counts_records_and_columns():
+    assert export.summary_line(UNEQUAL) == "2 records, 3 columns"
+    assert export.summary_line([]) == "0 records, 0 columns"
+    assert len(tabular.columns(UNEQUAL)) == 3
+
+
+def test_single_record_exports():
+    records = [{"amount": 3, "name": "coffee"}]
+    assert export.to_csv(records) == "amount,name\n3,coffee"
+    assert export.to_json(records) == '[{"amount": 3, "name": "coffee"}]'
+    assert export.to_markdown(records) == (
+        "| amount | name   |\n"
+        "| ------ | ------ |\n"
+        "| 3      | coffee |"
+    )
+    assert export.to_ndjson(records) == '{"amount": 3, "name": "coffee"}'
+    assert export.to_tsv(records) == "amount\tname\n3\tcoffee"
+    assert export.to_html(records) == (
+        "<table>\n"
+        "<tr><th>amount</th><th>name</th></tr>\n"
+        "<tr><td>3</td><td>coffee</td></tr>\n"
+        "</table>"
+    )
+
+
+def test_export_route_serves_csv_by_default_and_rejects_unenabled_formats():
+    app = bootstrap()
+    app.call("POST", "/records", name="coffee", amount=3)
+    app.call("POST", "/records", name="tea", amount=2)
+    records = app.call("GET", "/records")
+    assert app.call("GET", "/export") == export.to_csv(records)
+    assert app.call("GET", "/export", fmt="json") == export.to_json(records)
+    # Registered in EXPORT_FORMATS but not enabled in config.
+    with pytest.raises(ValueError):
+        app.call("GET", "/export", fmt="md")
diff --git a/tests/test_profiles.py b/tests/test_profiles.py
new file mode 100644
index 0000000..153d6d5
--- /dev/null
+++ b/tests/test_profiles.py
@@ -0,0 +1,118 @@
+"""Tests for app/profiles.py -- named specs layered over app/schema.py."""
+import pytest
+
+from app import profiles, schema
+
+
+def test_profile_error_is_distinct_from_schema_error():
+    assert issubclass(profiles.ProfileError, Exception)
+    assert not issubclass(profiles.ProfileError, schema.SchemaError)
+    assert not issubclass(schema.SchemaError, profiles.ProfileError)
+
+
+def test_profiles_constant_is_pinned():
+    assert profiles.PROFILES == {
+        "record": {
+            "name": {"required": True, "type": "str", "non_empty": True},
+            "amount": {"required": True, "type": "number", "max": 100000},
+        },
+        "draft": {"name": {"type": "str"}},
+        "import": {
+            "name": {"required": True, "type": "str", "non_empty": True},
+            "amount": {"type": "number"},
+        },
+    }
+
+
+def test_get_profile_returns_a_deep_copy_and_rejects_unknown_names():
+    spec = profiles.get_profile("draft")
+    assert spec == {"name": {"type": "str"}}
+    spec["name"]["type"] = "tampered"
+    spec["extra"] = {}
+    assert profiles.PROFILES["draft"] == {"name": {"type": "str"}}
+    with pytest.raises(profiles.ProfileError) as err:
+        profiles.get_profile("nope")
+    assert "nope" in str(err.value)
+
+
+def test_validate_profile_delegates_to_compile_spec(monkeypatch):
+    seen = []
+
+    def recorder(spec):
+        seen.append(spec)
+        return lambda fields: "sentinel"
+
+    monkeypatch.setattr(schema, "compile_spec", recorder)
+    assert profiles.validate_profile({"name": "a"}, "draft") == "sentinel"
+    assert seen == [{"name": {"type": "str"}}]
+    monkeypatch.undo()
+    assert profiles.validate_profile(
+        {"name": "  ada  ", "amount": 5}, "record") == {"name": "ada", "amount": 5}
+    with pytest.raises(schema.SchemaError) as err:
+        profiles.validate_profile({}, "record")
+    assert str(err.value) == "missing field: name"
+
+
+def test_merge_profiles_delegates_to_merge_specs(monkeypatch):
+    seen = []
+
+    def recorder(a, b):
+        seen.append((a, b))
+        return {"merged": True}
+
+    monkeypatch.setattr(schema, "merge_specs", recorder)
+    assert profiles.merge_profiles("draft", "import") == {"merged": True}
+    assert seen == [({"name": {"type": "str"}}, profiles.PROFILES["import"])]
+    monkeypatch.undo()
+    assert profiles.merge_profiles("draft", "import") == profiles.PROFILES["import"]
+    assert profiles.PROFILES["draft"] == {"name": {"type": "str"}}
+
+
+def test_describe_profile_matches_describe_spec():
+    assert profiles.describe_profile("draft") == "name: type=str"
+
+
+def test_compare_profiles_matches_diff_specs():
+    assert profiles.compare_profiles("draft", "import") == {
+        "added": ["amount"],
+        "removed": [],
+        "changed": ["name"],
+    }
+
+
+def test_profile_from_config_uses_the_prefixed_keys(monkeypatch):
+    seen = []
+
+    def recorder(config, prefix):
+        seen.append((config, prefix))
+        return {"derived": True}
+
+    monkeypatch.setattr(schema, "spec_from_config", recorder)
+    config = {"profile_x_name": {"required": True}, "other": 1}
+    assert profiles.profile_from_config(config, "x") == {"derived": True}
+    assert seen == [(config, "profile_x_")]
+    monkeypatch.undo()
+    spec = profiles.profile_from_config(config, "x")
+    assert spec == {"name": {"required": True}}
+    with pytest.raises(schema.SchemaError) as err:
+        schema.compile_spec(spec)({})
+    assert str(err.value) == "missing field: name"
+
+
+def test_profile_summary_line():
+    assert profiles.profile_summary("draft") == "draft: 1 fields, 1 rules"
+
+
+def test_validate_all_profiles_collects_errors_for_every_profile():
+    assert profiles.validate_all_profiles({}) == {
+        "draft": [],
+        "import": ["missing field: name"],
+        "record": ["missing field: name", "missing field: amount"],
+    }
+
+
+def test_strictest_picks_the_profile_with_the_most_rules():
+    assert profiles.strictest(["draft", "import"]) == "import"
+    assert profiles.strictest(["record", "import", "draft"]) == "record"
+    with pytest.raises(profiles.ProfileError):
+        profiles.strictest([])
diff --git a/tests/test_quota.py b/tests/test_quota.py
new file mode 100644
index 0000000..b6b6080
--- /dev/null
+++ b/tests/test_quota.py
@@ -0,0 +1,187 @@
+import pytest
+
+from app import quota
+
+
+def test_quota_exceeded_error_is_exception_subclass():
+    quota.reset()
+    assert issubclass(quota.QuotaExceededError, Exception)
+
+
+def test_clock_starts_at_zero_and_advances_monotonically():
+    quota.reset()
+    assert quota.now() == 0.0
+    assert quota.advance(30) == 30.0
+    assert quota.now() == 30.0
+    with pytest.raises(ValueError):
+        quota.advance(-1)
+    assert quota.now() == 30.0
+
+
+def test_take_returns_in_window_count_then_raises():
+    quota.reset()
+    assert quota.take("k", limit=2, window_seconds=60) == 1
+    assert quota.take("k", limit=2, window_seconds=60) == 2
+    with pytest.raises(quota.QuotaExceededError) as excinfo:
+        quota.take("k", limit=2, window_seconds=60)
+    message = str(excinfo.value)
+    assert "k" in message
+    assert "2" in message
+
+
+def test_take_prunes_hits_older_than_the_window():
+    quota.reset()
+    assert quota.take("k", 2, 60) == 1
+    assert quota.take("k", 2, 60) == 2
+    quota.advance(61)
+    assert quota.take("k", 2, 60) == 1
+
+    quota.reset()
+    quota.advance(30)
+    assert quota.take("j", 2, 60) == 1
+    quota.advance(31)  # now == 61, the t=30 hit is still in window
+    assert quota.take("j", 2, 60) == 2
+
+    quota.reset()
+    quota.advance(30)
+    assert quota.take("j", 2, 60) == 1
+    quota.advance(61)  # now == 91, the t=30 hit has aged out
+    assert quota.take("j", 2, 60) == 1
+
+
+def test_infinite_window_never_prunes():
+    quota.reset()
+    quota.take("k", 1, float("inf"))
+    quota.advance(10 ** 6)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 1, float("inf"))
+
+
+def test_burst_extends_the_allowance_and_defaults_to_zero():
+    quota.reset()
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 1
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 2
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 3
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60, burst=1)
+
+    quota.reset()
+    assert quota.take("b", 2, 60) == 1
+    assert quota.take("b", 2, 60) == 2
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("b", 2, 60)
+
+
+def test_keys_are_independent():
+    quota.reset()
+    assert quota.take("a", 2, 60) == 1
+    assert quota.take("b", 2, 60) == 1
+    assert quota.take("a", 2, 60) == 2
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("a", 2, 60)
+    assert quota.take("b", 2, 60) == 2
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("b", 2, 60)
+
+
+def test_reset_clears_clock_and_every_key():
+    quota.reset()
+    quota.take("a", 1, 60)
+    quota.take("b", 1, 60)
+    quota.advance(5)
+    quota.reset()
+    assert quota.now() == 0.0
+    assert quota.take("a", 1, 60) == 1
+    assert quota.take("b", 1, 60) == 1
+
+
+def test_remaining_is_read_only_and_recovers_after_the_window():
+    quota.reset()
+    assert quota.remaining("k", 2, 60) == 2
+    assert quota.remaining("k", 2, 60) == 2
+    quota.take("k", 2, 60)
+    assert quota.remaining("k", 2, 60) == 1
+    assert quota.remaining("k", 2, 60, burst=1) == 2
+    quota.take("k", 2, 60)
+    assert quota.remaining("k", 2, 60) == 0
+    assert quota.remaining("k", 2, 60) == 0
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 2, 60)
+    quota.advance(61)
+    assert quota.remaining("k", 2, 60) == 2
+    assert quota.take("k", 2, 60) == 1
+
+
+def test_snapshot_lists_in_window_hits_and_is_a_deep_copy():
+    quota.reset()
+    quota.take("a", 5, 60)          # t=0
+    quota.take("b", 5, 60)          # t=0
+    quota.advance(30)
+    quota.take("a", 5, 60)          # t=30
+    quota.advance(31)               # now == 61; the t=0 hits have aged out
+    quota.take("a", 5, 60)          # t=61
+    assert quota.snapshot(60) == {"a": [30.0, 61.0]}
+
+    snap = quota.snapshot(60)
+    snap["a"].append(999.0)
+    assert quota.snapshot(60) == {"a": [30.0, 61.0]}
+    assert quota.remaining("a", 5, 60) == 3
+
+
+def test_time_to_next_slot_reports_seconds_until_a_slot_frees():
+    quota.reset()
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    assert quota.time_to_next_slot("k", 2, 60) == 50.0
+    assert quota.time_to_next_slot("k", 2, 60) == 50.0
+    assert quota.remaining("k", 2, 60) == 0
+
+    quota.reset()
+    quota.take("i", 1, float("inf"))
+    assert quota.time_to_next_slot("i", 1, float("inf")) == float("inf")
+
+    quota.reset()
+    assert quota.time_to_next_slot("k", 0, 60) == float("inf")
+
+    quota.reset()
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(60)
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 2, 60)
+
+
+def test_usage_reports_the_full_state_without_recording():
+    quota.reset()
+    assert quota.usage("k", 2, 60) == {
+        "used": 0, "allowed": 2, "remaining": 2, "reset_in": 0.0,
+    }
+    quota.take("k", 2, 60)
+    assert quota.usage("k", 2, 60) == {
+        "used": 1, "allowed": 2, "remaining": 1, "reset_in": 0.0,
+    }
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    assert quota.usage("k", 2, 60) == {
+        "used": 2, "allowed": 2, "remaining": 0, "reset_in": 50.0,
+    }
+    assert quota.usage("k", 2, 60, burst=1) == {
+        "used": 2, "allowed": 3, "remaining": 1, "reset_in": 0.0,
+    }
+    assert quota.take("k", 2, 60, burst=1) == 3
+
+
+def test_purge_drops_aged_out_hits_and_empty_keys():
+    quota.reset()
+    quota.take("a", 5, 60)      # t=0
+    quota.take("a", 5, 60)      # t=0
+    quota.take("b", 5, 60)      # t=0
+    quota.advance(30)
+    quota.take("b", 5, 60)      # t=30
+    quota.advance(31)           # now == 61; the three t=0 hits have aged out
+    assert quota.purge(60) == 3
+    assert quota.snapshot(60) == {"b": [30.0]}
+    assert quota.purge(60) == 0
diff --git a/tests/test_ratelimit.py b/tests/test_ratelimit.py
new file mode 100644
index 0000000..4f48d13
--- /dev/null
+++ b/tests/test_ratelimit.py
@@ -0,0 +1,228 @@
+import pytest
+
+from app import quota, ratelimit
+
+
+def test_rate_limit_exceeded_error_is_exception_subclass():
+    ratelimit.reset()
+    assert issubclass(ratelimit.RateLimitExceededError, Exception)
+
+
+def test_check_and_increment_counts_then_raises():
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("k", 3) == 1
+    assert ratelimit.check_and_increment("k", 3) == 2
+    assert ratelimit.check_and_increment("k", 3) == 3
+    with pytest.raises(ratelimit.RateLimitExceededError) as excinfo:
+        ratelimit.check_and_increment("k", 3)
+    message = str(excinfo.value)
+    assert "k" in message
+    assert "3" in message
+
+
+def test_check_and_increment_counts_per_key():
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("a", 2) == 1
+    assert ratelimit.check_and_increment("b", 2) == 1
+    assert ratelimit.check_and_increment("a", 2) == 2
+    assert ratelimit.check_and_increment("b", 2) == 2
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("a", 2)
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("b", 2)
+
+
+def test_reset_clears_all_keys():
+    ratelimit.reset()
+    ratelimit.check_and_increment("a", 1)
+    ratelimit.check_and_increment("b", 1)
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("a", 1) == 1
+    assert ratelimit.check_and_increment("b", 1) == 1
+
+
+def test_dispatch_hook_ignores_reads():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    for _ in range(config["rate_limit_max_per_window"] + 5):
+        assert ratelimit.dispatch_hook(None, config, "GET", "/records", {}) is None
+    assert ratelimit.check_and_increment("anonymous", 2) == 1
+
+
+def test_dispatch_hook_keys_off_the_actor_kwarg():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    # a named actor has its own counter
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+
+
+def test_dispatch_hook_reads_the_limit_from_config():
+    ratelimit.reset()
+    one = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, one, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, one, "POST", "/records", {"actor": "a"})
+
+    ratelimit.reset()
+    two = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, two, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, two, "POST", "/records", {"actor": "a"})
+
+
+def test_reset_also_resets_the_quota_clock():
+    ratelimit.reset()
+    ratelimit.check_and_increment("k", 1)
+    quota.advance(30)
+    ratelimit.reset()
+    assert quota.now() == 0.0
+    assert ratelimit.check_and_increment("k", 1) == 1
+
+
+def test_rate_limit_error_subclasses_quota_error():
+    ratelimit.reset()
+    assert issubclass(ratelimit.RateLimitExceededError, quota.QuotaExceededError)
+    ratelimit.check_and_increment("k", 1)
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("k", 1)
+    with pytest.raises(quota.QuotaExceededError):
+        ratelimit.check_and_increment("k", 1)
+
+
+def test_check_and_increment_delegates_to_quota_take(monkeypatch):
+    ratelimit.reset()
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", recorder)
+    assert ratelimit.check_and_increment("k", 3) == 1
+    assert calls == [(("k", 3, float("inf")), {"burst": 0})]
+
+
+def test_dispatch_hook_window_frees_the_quota():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(61)
+    assert ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"}) is None
+
+
+def test_dispatch_hook_works_with_a_limit_only_config():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 1}
+    assert ratelimit.dispatch_hook(None, config, "POST", "/records", {}) is None
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    quota.advance(61)
+    assert ratelimit.dispatch_hook(None, config, "POST", "/records", {}) is None
+
+
+def test_dispatch_hook_reads_the_burst_from_config():
+    ratelimit.reset()
+    config = {
+        "rate_limit_max_per_window": 1,
+        "rate_limit_burst": 1,
+        "rate_limit_window_seconds": 60,
+    }
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+    ratelimit.reset()
+    no_burst = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, no_burst, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, no_burst, "POST", "/records", {"actor": "a"})
+
+
+def test_retry_after_delegates_to_time_to_next_slot(monkeypatch):
+    ratelimit.reset()
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 12.5
+
+    config = {
+        "rate_limit_max_per_window": 2,
+        "rate_limit_window_seconds": 60,
+        "rate_limit_burst": 1,
+    }
+    monkeypatch.setattr(quota, "time_to_next_slot", recorder)
+    assert ratelimit.retry_after("k", config) == 12.5
+    assert calls == [(("k", 2, 60), {"burst": 1})]
+    monkeypatch.undo()
+
+    ratelimit.reset()
+    plain = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, plain, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, plain, "POST", "/records", {"actor": "a"})
+    quota.advance(10)
+    assert ratelimit.retry_after("a", plain) == 50.0
+
+
+def test_limit_headers_render_strings_without_recording():
+    ratelimit.reset()
+    config = {
+        "rate_limit_max_per_window": 1,
+        "rate_limit_burst": 1,
+        "rate_limit_window_seconds": 60,
+    }
+    assert ratelimit.limit_headers("a", config) == {
+        "X-RateLimit-Limit": "1",
+        "X-RateLimit-Remaining": "2",
+        "X-RateLimit-Reset": "0.0",
+    }
+
+    ratelimit.reset()
+    plain = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, plain, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, plain, "POST", "/records", {"actor": "a"})
+    quota.advance(10)
+    assert ratelimit.limit_headers("a", plain) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "0",
+        "X-RateLimit-Reset": "50.0",
+    }
+    assert ratelimit.limit_headers("a", plain) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "0",
+        "X-RateLimit-Reset": "50.0",
+    }
+    assert quota.take("b", 2, 60) == 1
+
+
+def test_status_line_renders_the_usage_summary():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert ratelimit.status_line("mallory", config) == "mallory: 0/2, reset in 0.0s"
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
+    quota.advance(10)
+    assert ratelimit.status_line("mallory", config) == "mallory: 2/2, reset in 50.0s"
+    assert ratelimit.status_line("mallory", config) == "mallory: 2/2, reset in 50.0s"
+
+
+def test_check_many_reports_per_key_headroom_without_recording():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    assert ratelimit.check_many(["a", "b", "c"], config) == {
+        "a": False, "b": True, "c": True,
+    }
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    assert ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "b"}) is None
+    assert ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "c"}) is None
diff --git a/tests/test_reportdoc.py b/tests/test_reportdoc.py
new file mode 100644
index 0000000..d1d39ce
--- /dev/null
+++ b/tests/test_reportdoc.py
@@ -0,0 +1,143 @@
+"""Tests for app/reportdoc.py — the multi-section report composer."""
+import pytest
+
+from app import colspec
+from app import export
+from app import reportdoc
+
+
+def _two_sections():
+    return [
+        reportdoc.section("Alpha", [{"a": 1}], "csv"),
+        reportdoc.section("Beta", [{"b": 2}, {"b": 3}], "csv"),
+    ]
+
+
+def test_report_error_is_an_exception():
+    assert issubclass(reportdoc.ReportError, Exception)
+
+
+def test_section_builds_a_validated_section_dict():
+    records = [{"a": 1}]
+    assert reportdoc.section("Alpha", records) == {
+        "title": "Alpha",
+        "records": records,
+        "fmt": "md",
+    }
+    assert reportdoc.section("Alpha", records, "csv")["fmt"] == "csv"
+    assert reportdoc.section("Alpha", records, "html")["fmt"] == "html"
+    with pytest.raises(reportdoc.ReportError):
+        reportdoc.section("", records)
+    with pytest.raises(reportdoc.ReportError):
+        reportdoc.section("   ", records)
+    with pytest.raises(reportdoc.ReportError) as excinfo:
+        reportdoc.section("Alpha", records, "xml")
+    assert "xml" in str(excinfo.value)
+
+
+def test_render_section_delegates_to_render_any_but_not_when_empty(monkeypatch):
+    calls = []
+    real_render_any = export.render_any
+
+    def recorder(records, fmt):
+        calls.append((records, fmt))
+        return real_render_any(records, fmt)
+
+    monkeypatch.setattr(export, "render_any", recorder)
+    records = [{"a": 1}]
+    sec = reportdoc.section("Alpha", records, "csv")
+    assert reportdoc.render_section(sec) == "## Alpha\n\na\n1"
+    assert calls == [(records, "csv")]
+
+    empty = reportdoc.section("Beta", [], "csv")
+    assert reportdoc.render_section(empty) == "## Beta\n\n(no records)"
+    assert calls == [(records, "csv")]
+
+
+def test_render_report_renders_a_title_and_the_joined_sections():
+    sections = [
+        reportdoc.section("Alpha", [{"a": 1}], "csv"),
+        reportdoc.section("Beta", [], "md"),
+    ]
+    assert reportdoc.render_report("R", sections) == (
+        "# R\n"
+        "\n"
+        "## Alpha\n"
+        "\n"
+        "a\n"
+        "1\n"
+        "\n"
+        "## Beta\n"
+        "\n"
+        "(no records)"
+    )
+    assert reportdoc.render_report("R", []) == "# R\n\n(empty report)"
+
+
+def test_duplicate_section_titles_are_rejected():
+    dupes = [
+        reportdoc.section("Alpha", [{"a": 1}], "csv"),
+        reportdoc.section("Alpha", [{"a": 2}], "csv"),
+    ]
+    with pytest.raises(reportdoc.ReportError) as excinfo:
+        reportdoc.render_report("R", dupes)
+    assert "Alpha" in str(excinfo.value)
+    with pytest.raises(reportdoc.ReportError) as excinfo:
+        reportdoc.toc(dupes)
+    assert "Alpha" in str(excinfo.value)
+
+
+def test_toc_and_record_counts():
+    sections = _two_sections()
+    assert reportdoc.toc(sections) == ["Alpha", "Beta"]
+    assert reportdoc.record_counts(sections) == {"Alpha": 1, "Beta": 2}
+
+
+def test_summary_counts_sections_and_records():
+    assert reportdoc.summary(_two_sections()) == "2 sections, 3 records"
+    assert reportdoc.summary([]) == "0 sections, 0 records"
+
+
+def test_render_index_numbers_the_sections():
+    assert reportdoc.render_index(_two_sections()) == (
+        "1. Alpha (1 records)\n"
+        "2. Beta (2 records)"
+    )
+    assert reportdoc.render_index([]) == "(empty report)"
+
+
+def test_projected_section_projects_records_through_colspec(monkeypatch):
+    calls = []
+    real_project = colspec.project
+
+    def recorder(records, pairs):
+        calls.append((records, pairs))
+        return real_project(records, pairs)
+
+    monkeypatch.setattr(colspec, "project", recorder)
+    records = [{"a": 1, "b": 2}]
+    pairs = colspec.parse_colspec("a:A")
+    sec = reportdoc.projected_section("T", records, pairs, "csv")
+    assert calls == [(records, pairs)]
+    assert sec == {"title": "T", "records": [{"A": 1}], "fmt": "csv"}
+    assert reportdoc.render_section(sec) == "## T\n\nA\n1"
+
+
+def test_find_section_returns_the_matching_section_object():
+    sections = _two_sections()
+    assert reportdoc.find_section(sections, "Beta") is sections[1]
+    with pytest.raises(reportdoc.ReportError) as excinfo:
+        reportdoc.find_section(sections, "Gamma")
+    assert "Gamma" in str(excinfo.value)
+
+
+def test_merge_reports_concatenates_and_rechecks_titles():
+    left = [reportdoc.section("Alpha", [{"a": 1}], "csv")]
+    right = [reportdoc.section("Beta", [{"b": 2}], "csv")]
+    merged = reportdoc.merge_reports(left, right)
+    assert merged == [left[0], right[0]]
+    assert merged is not left and merged is not right
+    assert len(left) == 1 and len(right) == 1
+    with pytest.raises(reportdoc.ReportError) as excinfo:
+        reportdoc.merge_reports(left, [reportdoc.section("Alpha", [], "csv")])
+    assert "Alpha" in str(excinfo.value)
diff --git a/tests/test_rules.py b/tests/test_rules.py
new file mode 100644
index 0000000..538f876
--- /dev/null
+++ b/tests/test_rules.py
@@ -0,0 +1,171 @@
+"""Tests for app/rules.py -- the pure rule-combinator layer."""
+import pytest
+
+from app import rules, schema
+
+
+def _true():
+    return rules.rule("T", lambda value: True)
+
+
+def _false():
+    return rules.rule("F", lambda value: False)
+
+
+def test_rule_error_is_distinct_from_schema_error():
+    assert issubclass(rules.RuleError, Exception)
+    assert not issubclass(rules.RuleError, schema.SchemaError)
+    assert not issubclass(schema.SchemaError, rules.RuleError)
+
+
+def test_rule_builds_a_named_predicate_and_rejects_bad_names():
+    predicate = lambda value: True
+    assert rules.rule("n", predicate) == {"name": "n", "test": predicate}
+    with pytest.raises(ValueError):
+        rules.rule("", predicate)
+    with pytest.raises(ValueError):
+        rules.rule(42, predicate)
+
+
+def test_check_coerces_the_predicate_result_to_bool():
+    assert rules.check(1, rules.rule("truthy", lambda value: value)) is True
+    assert rules.check(0, rules.rule("truthy", lambda value: value)) is False
+
+
+def test_all_of_passes_only_when_every_child_passes():
+    both = rules.all_of(_true(), _true())
+    assert both["name"] == "all(T,T)"
+    assert rules.check(1, both) is True
+    mixed = rules.all_of(_true(), _false())
+    assert mixed["name"] == "all(T,F)"
+    assert rules.check(1, mixed) is False
+    empty = rules.all_of()
+    assert empty["name"] == "all()"
+    assert rules.check("anything", empty) is True
+
+
+def test_any_of_passes_when_one_child_passes_and_rejects_no_children():
+    mixed = rules.any_of(_false(), _true())
+    assert mixed["name"] == "any(F,T)"
+    assert rules.check(1, mixed) is True
+    none = rules.any_of(_false(), _false())
+    assert none["name"] == "any(F,F)"
+    assert rules.check(1, none) is False
+    with pytest.raises(ValueError):
+        rules.any_of()
+
+
+def test_negate_inverts_and_renames():
+    negated = rules.negate(_true())
+    assert negated["name"] == "not(T)"
+    assert rules.check(1, negated) is False
+    assert rules.check(1, rules.negate(_false())) is True
+
+
+def test_when_is_material_implication():
+    cases = {
+        ("T", "T"): True,
+        ("T", "F"): False,
+        ("F", "T"): True,
+        ("F", "F"): True,
+    }
+    for (cond_name, then_name), expected in cases.items():
+        cond = _true() if cond_name == "T" else _false()
+        then = _true() if then_name == "T" else _false()
+        composite = rules.when(cond, then)
+        assert composite["name"] == "when(%s,%s)" % (cond_name, then_name)
+        assert rules.check(1, composite) is expected
+
+
+def test_explain_renders_pass_or_fail():
+    assert rules.explain(1, _true()) == "T: pass"
+    assert rules.explain(1, _false()) == "F: fail"
+
+
+def test_apply_rules_reports_failures_in_insertion_order():
+    fields = {"a": 1, "b": 2, "c": 3}
+    by_field = {"b": _false(), "a": _true(), "c": _false(), "absent": _false()}
+    assert rules.apply_rules(fields, by_field) == [
+        "field b failed F",
+        "field c failed F",
+    ]
+    assert fields == {"a": 1, "b": 2, "c": 3}
+    assert rules.apply_rules(fields, {"a": _true()}) == []
+
+
+def test_first_failure_returns_the_first_failing_pair_or_none():
+    fields = {"a": 1, "b": 2}
+    assert rules.first_failure(fields, {"a": _true(), "b": _false()}) == ("b", "F")
+    assert rules.first_failure(fields, {"a": _true(), "b": _true()}) is None
+    assert rules.first_failure(fields, {"absent": _false()}) is None
+
+
+def test_explain_failures_lists_only_failing_fields():
+    fields = {"a": 1, "b": 2, "c": 3}
+    by_field = {
+        "a": rules.rule("first", lambda value: False),
+        "b": _true(),
+        "c": rules.rule("third", lambda value: False),
+        "absent": _false(),
+    }
+    assert rules.explain_failures(fields, by_field) == [
+        "first: fail",
+        "third: fail",
+    ]
+    assert rules.explain_failures(fields, {"a": _true()}) == []
+
+
+def test_builtins_wrap_the_schema_predicates():
+    assert set(rules.BUILTINS) == {"number", "str", "non_empty"}
+    assert rules.BUILTINS["number"]["name"] == "number"
+    assert rules.BUILTINS["str"]["name"] == "str"
+    assert rules.BUILTINS["non_empty"]["name"] == "non_empty"
+    assert rules.check(3, rules.BUILTINS["number"]) is True
+    assert rules.check(True, rules.BUILTINS["number"]) is False
+    assert rules.check("a", rules.BUILTINS["str"]) is True
+    assert rules.check(3, rules.BUILTINS["str"]) is False
+    assert rules.check(" a ", rules.BUILTINS["non_empty"]) is True
+    assert rules.check("   ", rules.BUILTINS["non_empty"]) is False
+
+
+def test_parse_rule_reads_ampersand_joined_builtins():
+    assert rules.parse_rule("number") is rules.BUILTINS["number"]
+    composite = rules.parse_rule("number&non_empty")
+    assert composite["name"] == "all(number,non_empty)"
+    assert rules.check(3, composite) is False
+    with pytest.raises(ValueError) as err:
+        rules.parse_rule("bogus")
+    assert "bogus" in str(err.value)
+    with pytest.raises(ValueError):
+        rules.parse_rule("")
+
+
+def test_parse_rules_maps_a_whole_field_mapping():
+    parsed = rules.parse_rules({"amount": "number", "name": "str&non_empty"})
+    assert list(parsed) == ["amount", "name"]
+    assert parsed["amount"]["name"] == "number"
+    assert parsed["name"]["name"] == "all(str,non_empty)"
+    assert rules.parse_rules({}) == {}
+    with pytest.raises(ValueError) as err:
+        rules.parse_rules({"amount": "bogus"})
+    assert "amount" in str(err.value)
+    assert "bogus" in str(err.value)
+    fields = {"amount": "3", "name": "ada"}
+    assert rules.apply_rules(fields, rules.parse_rules(
+        {"amount": "number", "name": "str&non_empty"})) == [
+        "field amount failed number",
+    ]
+
+
+def test_describe_rules_renders_one_line_per_field_in_insertion_order():
+    by_field = {"amount": rules.parse_rule("number"),
+                "name": rules.parse_rule("str&non_empty")}
+    assert rules.describe_rules(by_field) == (
+        "amount: number\nname: all(str,non_empty)"
+    )
+    assert rules.describe_rules({}) == "(no rules)"
+
+
+def test_builtin_number_delegates_to_schema_at_call_time(monkeypatch):
+    monkeypatch.setattr(schema, "is_valid_amount", lambda value: False)
+    assert rules.check(5, rules.parse_rule("number")) is False
diff --git a/tests/test_schema.py b/tests/test_schema.py
new file mode 100644
index 0000000..b39e050
--- /dev/null
+++ b/tests/test_schema.py
@@ -0,0 +1,288 @@
+"""Tests for app/schema.py -- the declarative validation toolkit."""
+import pytest
+
+from app import schema
+
+
+def test_error_catalog_has_exactly_the_expected_codes():
+    assert set(schema.ERROR_CATALOG) == {
+        "missing", "numeric", "non_negative", "max", "non_empty", "type_str",
+    }
+    for template in schema.ERROR_CATALOG.values():
+        assert isinstance(template, str)
+
+
+def test_format_error_missing():
+    assert schema.format_error("missing", field="name") == "missing field: name"
+
+
+def test_format_error_numeric():
+    assert schema.format_error("numeric", field="amount", got="str") == (
+        "field amount must be numeric (got str)"
+    )
+
+
+def test_format_error_non_negative():
+    assert schema.format_error("non_negative", field="amount") == (
+        "field amount must be non-negative"
+    )
+
+
+def test_format_error_max():
+    assert schema.format_error("max", field="amount", limit=100) == (
+        "field amount exceeds max_amount 100"
+    )
+
+
+def test_format_error_non_empty():
+    assert schema.format_error("non_empty", field="name") == (
+        "field name must be a non-empty string"
+    )
+
+
+def test_format_error_type_str():
+    assert schema.format_error("type_str", field="name") == (
+        "field name must be a string"
+    )
+
+
+def test_format_error_unknown_code_raises_key_error():
+    with pytest.raises(KeyError):
+        schema.format_error("nope")
+
+
+def test_check_required_reports_missing_in_required_fields_order():
+    assert schema.check_required({"amount": 1}, ["name", "amount"]) == ["name"]
+    # A fields dict whose key order disagrees with required_fields order:
+    # the result follows required_fields, never the dict.
+    fields = {"zzz": 1}
+    assert schema.check_required(fields, ["name", "amount"]) == ["name", "amount"]
+    assert schema.check_required(fields, ["amount", "name"]) == ["amount", "name"]
+    assert schema.check_required({"name": "a", "amount": 1}, ["name", "amount"]) == []
+
+
+def test_is_valid_amount():
+    assert schema.is_valid_amount(0) is True
+    assert schema.is_valid_amount(5) is True
+    assert schema.is_valid_amount(3.5) is True
+    assert schema.is_valid_amount(True) is False
+    assert schema.is_valid_amount(False) is False
+    assert schema.is_valid_amount("3") is False
+    assert schema.is_valid_amount(None) is False
+    assert schema.is_valid_amount(float("nan")) is False
+    assert schema.is_valid_amount(float("inf")) is False
+    assert schema.is_valid_amount(float("-inf")) is False
+
+
+def test_is_valid_amount_huge_int_does_not_overflow():
+    # math.isfinite(10**400) raises OverflowError; ints are finite by
+    # construction and must never be routed through it.
+    assert schema.is_valid_amount(10 ** 400) is True
+
+
+def test_is_non_empty_str():
+    assert schema.is_non_empty_str("a") is True
+    assert schema.is_non_empty_str(" a ") is True
+    assert schema.is_non_empty_str("") is False
+    assert schema.is_non_empty_str("   ") is False
+    assert schema.is_non_empty_str(42) is False
+    assert schema.is_non_empty_str(None) is False
+
+
+def test_schema_error_is_a_distinct_exception_type():
+    assert issubclass(schema.SchemaError, Exception)
+    assert not issubclass(schema.SchemaError, KeyError)
+    assert not issubclass(schema.SchemaError, ValueError)
+
+
+def test_compile_spec_rejects_unknown_rule_key():
+    with pytest.raises(ValueError) as err:
+        schema.compile_spec({"name": {"bogus": True}})
+    assert "bogus" in str(err.value)
+
+
+def test_compile_spec_rejects_unknown_type_value():
+    with pytest.raises(ValueError) as err:
+        schema.compile_spec({"name": {"type": "int"}})
+    assert "int" in str(err.value)
+
+
+def test_compile_spec_empty_spec_accepts_anything():
+    validator = schema.compile_spec({})
+    assert validator({"anything": 1, "else": "x"}) == {"anything": 1, "else": "x"}
+    assert validator({}) == {}
+
+
+def test_compiled_validator_checks_required_first_in_spec_order():
+    validator = schema.compile_spec({
+        "name": {"required": True},
+        "amount": {"required": True},
+    })
+    with pytest.raises(schema.SchemaError) as err:
+        validator({})
+    assert str(err.value) == "missing field: name"
+    with pytest.raises(schema.SchemaError) as err:
+        validator({"name": "a"})
+    assert str(err.value) == "missing field: amount"
+
+
+def test_compiled_validator_number_rule():
+    validator = schema.compile_spec({"amount": {"type": "number"}})
+    for bad, got in [("3", "str"), (True, "bool"), (float("nan"), "float"),
+                     (float("inf"), "float"), (float("-inf"), "float")]:
+        with pytest.raises(schema.SchemaError) as err:
+            validator({"amount": bad})
+        assert str(err.value) == "field amount must be numeric (got %s)" % got
+    assert validator({"amount": 3.5}) == {"amount": 3.5}
+
+
+def test_compiled_validator_type_rule_beats_non_empty_rule():
+    validator = schema.compile_spec({"n": {"type": "str", "non_empty": True}})
+    with pytest.raises(schema.SchemaError) as err:
+        validator({"n": 42})
+    assert str(err.value) == "field n must be a string"
+
+
+def test_compiled_validator_non_empty_rule():
+    validator = schema.compile_spec({"n": {"non_empty": True}})
+    with pytest.raises(schema.SchemaError) as err:
+        validator({"n": "   "})
+    assert str(err.value) == "field n must be a non-empty string"
+
+
+def test_compiled_validator_max_rule_boundary():
+    validator = schema.compile_spec({"amount": {"max": 100}})
+    assert validator({"amount": 100}) == {"amount": 100}
+    with pytest.raises(schema.SchemaError) as err:
+        validator({"amount": 101})
+    assert str(err.value) == "field amount exceeds max_amount 100"
+
+
+def test_max_rule_on_a_non_numeric_value_reports_numeric_not_type_error():
+    spec = {"amount": {"max": 100}}
+    validator = schema.compile_spec(spec)
+    with pytest.raises(schema.SchemaError) as err:
+        validator({"amount": "abc"})
+    assert str(err.value) == "field amount must be numeric (got str)"
+    assert schema.validate_collect(spec, {"amount": "abc"}) == [
+        "field amount must be numeric (got str)"
+    ]
+
+
+def test_compiled_validator_strips_non_empty_fields_without_mutating_input():
+    validator = schema.compile_spec({
+        "name": {"type": "str", "non_empty": True},
+        "amount": {"type": "number"},
+    })
+    fields = {"name": "  ada lovelace  ", "amount": 3, "extra": [1, 2]}
+    result = validator(fields)
+    assert result == {"name": "ada lovelace", "amount": 3, "extra": [1, 2]}
+    assert fields == {"name": "  ada lovelace  ", "amount": 3, "extra": [1, 2]}
+    assert result is not fields
+    # Reusable and deterministic: a second call on an equal input agrees.
+    assert validator(dict(fields)) == result
+
+
+def test_compiled_validator_passes_through_fields_absent_from_spec():
+    validator = schema.compile_spec({"name": {"type": "str"}})
+    assert validator({"name": "a", "other": 42}) == {"name": "a", "other": 42}
+
+
+def test_merge_specs_unions_and_rejects_conflicts():
+    a = {"name": {"required": True}}
+    b = {"name": {"non_empty": True}, "amount": {"type": "number"}}
+    assert schema.merge_specs(a, b) == {
+        "name": {"required": True, "non_empty": True},
+        "amount": {"type": "number"},
+    }
+    assert a == {"name": {"required": True}}
+    assert b == {"name": {"non_empty": True}, "amount": {"type": "number"}}
+    # Equal values on the same rule key merge silently.
+    assert schema.merge_specs({"n": {"type": "str"}}, {"n": {"type": "str"}}) == (
+        {"n": {"type": "str"}}
+    )
+    with pytest.raises(ValueError) as err:
+        schema.merge_specs({"n": {"type": "str"}}, {"n": {"type": "number"}})
+    assert "n" in str(err.value)
+    assert "type" in str(err.value)
+
+
+def test_describe_spec_renders_sorted_fields_and_sorted_rule_keys():
+    spec = {"name": {"required": True}, "amount": {"type": "number", "max": 100}}
+    assert schema.describe_spec(spec) == (
+        "amount: max=100, type=number\nname: required=True"
+    )
+
+
+def test_describe_spec_of_empty_spec():
+    assert schema.describe_spec({}) == "(empty spec)"
+
+
+def test_diff_specs_reports_added_removed_and_changed():
+    a = {"name": {"required": True}, "gone": {"type": "str"}}
+    b = {"name": {"required": False}, "amount": {"type": "number"}}
+    assert schema.diff_specs(a, b) == {
+        "added": ["amount"],
+        "removed": ["gone"],
+        "changed": ["name"],
+    }
+    assert a == {"name": {"required": True}, "gone": {"type": "str"}}
+    assert b == {"name": {"required": False}, "amount": {"type": "number"}}
+    assert schema.diff_specs(a, a) == {"added": [], "removed": [], "changed": []}
+
+
+def test_spec_from_config_collects_prefixed_keys_and_compiles():
+    config = {
+        "s_name": {"required": True, "type": "str"},
+        "s_amount": {"type": "number"},
+        "unrelated": 1,
+    }
+    spec = schema.spec_from_config(config, "s_")
+    assert spec == {
+        "name": {"required": True, "type": "str"},
+        "amount": {"type": "number"},
+    }
+    validator = schema.compile_spec(spec)
+    assert validator({"name": "a", "amount": 2}) == {"name": "a", "amount": 2}
+    with pytest.raises(schema.SchemaError) as err:
+        validator({"amount": 2})
+    assert str(err.value) == "missing field: name"
+
+
+def test_spec_to_config_is_the_inverse_of_spec_from_config():
+    spec = {"name": {"required": True}, "amount": {"type": "number"}}
+    config = schema.spec_to_config(spec, "s_")
+    assert config == {
+        "s_name": {"required": True},
+        "s_amount": {"type": "number"},
+    }
+    config["s_name"]["required"] = "tampered"
+    assert spec == {"name": {"required": True}, "amount": {"type": "number"}}
+    assert schema.spec_from_config(schema.spec_to_config(spec, "s_"), "s_") == spec
+    source = {"s_name": {"required": True}, "s_amount": {"type": "number"}}
+    assert schema.spec_to_config(schema.spec_from_config(source, "s_"), "s_") == source
+
+
+def test_spec_summary_line():
+    spec = {"name": {"required": True, "type": "str"}, "amount": {"type": "number"}}
+    assert schema.spec_summary_line(spec) == "2 fields, 3 rules"
+    assert schema.spec_summary_line({}) == "0 fields, 0 rules"
+
+
+def test_validate_collect_returns_every_error_in_spec_order():
+    spec = {
+        "name": {"required": True, "type": "str"},
+        "amount": {"type": "number"},
+        "note": {"non_empty": True},
+    }
+    assert schema.validate_collect(spec, {"amount": "x", "note": "  "}) == [
+        "missing field: name",
+        "field amount must be numeric (got str)",
+        "field note must be a non-empty string",
+    ]
+    assert schema.validate_collect(spec, {"name": "a", "amount": 1, "note": "n"}) == []
+
+
+def test_validate_collect_reports_at_most_one_message_per_field():
+    spec = {"n": {"type": "str", "non_empty": True}}
+    assert schema.validate_collect(spec, {"n": 42}) == ["field n must be a string"]
diff --git a/tests/test_tabular.py b/tests/test_tabular.py
new file mode 100644
index 0000000..49529dc
--- /dev/null
+++ b/tests/test_tabular.py
@@ -0,0 +1,89 @@
+"""Tests for app/tabular.py — the column-model toolkit export.py builds on."""
+import pytest
+
+from app import tabular
+
+
+def test_columns_is_the_sorted_union_of_every_record_key():
+    assert tabular.columns([]) == []
+    records = [{"name": "coffee", "amount": 3}, {"note": "x", "amount": 1}]
+    assert tabular.columns(records) == ["amount", "name", "note"]
+
+
+def test_cell_renders_none_as_empty_and_everything_else_via_str():
+    assert tabular.cell(None) == ""
+    assert tabular.cell(3) == "3"
+    assert tabular.cell(3.5) == "3.5"
+    assert tabular.cell("x") == "x"
+
+
+def test_escape_csv_quotes_only_when_required():
+    assert tabular.escape_csv("plain") == "plain"
+    assert tabular.escape_csv("a,b") == '"a,b"'
+    assert tabular.escape_csv('say "hi"') == '"say ""hi"""'
+    assert tabular.escape_csv("line1\nline2") == '"line1\nline2"'
+    assert tabular.escape_csv("") == ""
+
+
+def test_widths_takes_the_max_of_header_and_cell_widths():
+    # "amount": the header (6) is strictly wider than its widest cell ("3", 1).
+    # "name": the widest cell ("coffee", 6) beats the header (4).
+    records = [{"amount": 3, "name": "coffee"}]
+    assert tabular.widths(records, ["amount", "name"]) == {"amount": 6, "name": 6}
+
+
+def test_pad_never_truncates_and_validates_align_first():
+    assert tabular.pad("ab", 4, "left") == "ab  "
+    assert tabular.pad("ab", 4, "right") == "  ab"
+    assert tabular.pad("abcde", 4, "left") == "abcde"
+    assert tabular.pad("abcde", 4, "right") == "abcde"
+    # align is validated before the "already wide enough" short-circuit.
+    with pytest.raises(ValueError) as excinfo:
+        tabular.pad("abcde", 4, "center")
+    assert "center" in str(excinfo.value)
+    with pytest.raises(ValueError) as excinfo:
+        tabular.pad("ab", 4, "center")
+    assert "center" in str(excinfo.value)
+
+
+def test_sanitize_flat_replaces_tabs_and_newlines_with_spaces():
+    assert tabular.sanitize_flat("a\tb\nc") == "a b c"
+    assert tabular.sanitize_flat("plain value") == "plain value"
+    assert tabular.sanitize_flat(None) == ""
+
+
+def test_escape_html_escapes_the_ampersand_first():
+    assert tabular.escape_html('<a & "b">') == "&lt;a &amp; &quot;b&quot;&gt;"
+    assert tabular.escape_html("plain") == "plain"
+
+
+def test_truncate_marks_overlong_values_and_rejects_a_too_small_width():
+    assert tabular.truncate("abcdef", 6) == "abcdef"
+    assert tabular.truncate("abcdefgh", 6) == "abc..."
+    with pytest.raises(ValueError):
+        tabular.truncate("abcdefgh", 2)
+
+
+def test_wrap_greedily_wraps_on_spaces_and_hard_splits_long_words():
+    assert tabular.wrap("alpha beta gamma", 11) == ["alpha beta", "gamma"]
+    assert tabular.wrap("alpha beta gamma", 5) == ["alpha", "beta", "gamma"]
+    assert tabular.wrap("abcdefgh", 3) == ["abc", "def", "gh"]
+    assert tabular.wrap("", 4) == [""]
+    with pytest.raises(ValueError):
+        tabular.wrap("x", 0)
+
+
+def test_fit_composes_truncate_then_pad():
+    assert tabular.fit("abcdefgh", 6, "left") == "abc..."
+    assert tabular.fit("ab", 5, "left") == "ab   "
+    assert tabular.fit("ab", 5, "right") == "   ab"
+    with pytest.raises(ValueError) as excinfo:
+        tabular.fit("ab", 5, "center")
+    assert "center" in str(excinfo.value)
+
+
+def test_render_row_renders_one_pipe_table_row():
+    assert tabular.render_row(["a", "bb"], [3, 4], "left") == "| a   | bb   |"
+    assert tabular.render_row(["a", "bb"], [3, 4], "right") == "|   a |   bb |"
+    with pytest.raises(ValueError):
+        tabular.render_row(["a"], [3, 4], "left")
diff --git a/tests/test_throttle.py b/tests/test_throttle.py
new file mode 100644
index 0000000..7e71d1e
--- /dev/null
+++ b/tests/test_throttle.py
@@ -0,0 +1,101 @@
+import pytest
+
+from app import quota, throttle
+
+
+def test_policy_error_is_exception_subclass():
+    quota.reset()
+    assert issubclass(throttle.PolicyError, Exception)
+
+
+def test_policies_constant():
+    quota.reset()
+    assert throttle.POLICIES == {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+
+
+def test_match_policy_picks_the_longest_matching_prefix():
+    quota.reset()
+    policies = {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+    assert throttle.match_policy("GET", "/export/full", policies) == {
+        "limit": 10, "window": 60, "burst": 2,
+    }
+
+    longer = dict(policies)
+    longer["GET /export/full"] = {"limit": 1, "window": 30, "burst": 0}
+    assert throttle.match_policy("GET", "/export/full", longer) == {
+        "limit": 1, "window": 30, "burst": 0,
+    }
+
+    assert throttle.match_policy("POST", "/export", policies) is None
+
+
+def test_key_for_renders_method_path_and_actor():
+    quota.reset()
+    assert throttle.key_for("POST", "/records", "mallory") == "POST /records:mallory"
+
+
+def test_enforce_delegates_to_quota_take(monkeypatch):
+    quota.reset()
+    policies = {"POST /records": {"limit": 5, "window": 60, "burst": 2}}
+
+    assert throttle.enforce("DELETE", "/records", "a", policies) is None
+    assert quota.take("DELETE /records:a", 1, 60) == 1
+
+    quota.reset()
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", recorder)
+    assert throttle.enforce("POST", "/records", "mallory", policies) == 1
+    assert calls == [(("POST /records:mallory", 5, 60), {"burst": 2})]
+
+
+def test_enforce_raises_policy_error_when_exhausted():
+    quota.reset()
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    assert throttle.enforce("POST", "/records", "mallory", policies) == 1
+    with pytest.raises(throttle.PolicyError) as excinfo:
+        throttle.enforce("POST", "/records", "mallory", policies)
+    message = str(excinfo.value)
+    assert "POST /records:mallory" in message
+    assert "1" in message
+    assert isinstance(excinfo.value.__cause__, quota.QuotaExceededError)
+
+
+def test_remaining_for_reads_without_recording():
+    quota.reset()
+    policies = {"POST /records": {"limit": 2, "window": 60, "burst": 0}}
+    assert throttle.remaining_for("GET", "/records", "a", policies) is None
+    assert throttle.remaining_for("POST", "/records", "a", policies) == 2
+    assert throttle.remaining_for("POST", "/records", "a", policies) == 2
+    throttle.enforce("POST", "/records", "a", policies)
+    assert throttle.remaining_for("POST", "/records", "a", policies) == 1
+    assert throttle.enforce("POST", "/records", "a", policies) == 2
+
+
+def test_describe_policies_renders_sorted_lines():
+    quota.reset()
+    assert throttle.describe_policies(throttle.POLICIES) == (
+        "GET /export: limit=10, window=60, burst=2\n"
+        "POST /records: limit=5, window=60, burst=0"
+    )
+    assert throttle.describe_policies({}) == "(no policies)"
+
+
+def test_enforce_end_to_end_window_frees_the_policy():
+    quota.reset()
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    assert throttle.enforce("POST", "/records", "mallory", policies) == 1
+    with pytest.raises(throttle.PolicyError):
+        throttle.enforce("POST", "/records", "mallory", policies)
+    quota.advance(61)
+    assert throttle.enforce("POST", "/records", "mallory", policies) == 1
