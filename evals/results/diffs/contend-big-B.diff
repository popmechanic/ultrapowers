new file mode 100644
index 0000000..d4c6070
--- /dev/null
+++ b/app/tiers.py
@@ -0,0 +1,67 @@
+"""Actor-tier policy layer over `app.throttle`.
+
+Each actor belongs to a tier; the tier supplies the allowance the throttle
+layer enforces. Library layer only -- not wired into the registry.
+"""
+import copy
+
+from app import throttle
+
+
+TIERS = {
+    "free": {"limit": 2, "window": 60, "burst": 0},
+    "pro": {"limit": 10, "window": 60, "burst": 2},
+    "internal": {"limit": 100, "window": 60, "burst": 10},
+}
+
+DEFAULT_TIER = "free"
+
+
+class TierError(Exception):
+    """Raised for an unknown tier name."""
+
+
+def tier_of(actor, assignments):
+    """Return `actor`'s tier name, defaulting to the free tier."""
+    tier = assignments.get(actor, DEFAULT_TIER)
+    if tier not in TIERS:
+        raise TierError("actor %s assigned unknown tier %s" % (actor, tier))
+    return tier
+
+
+def policy_for(actor, assignments):
+    """Return a deep copy of `actor`'s tier policy."""
+    return copy.deepcopy(TIERS[tier_of(actor, assignments)])
+
+
+def _policies_for(method, path, actor, assignments):
+    return {"%s %s" % (method, path): policy_for(actor, assignments)}
+
+
+def enforce_tier(method, path, actor, assignments):
+    """Count one request against `actor`'s tier allowance for this route."""
+    return throttle.enforce(
+        method, path, actor, _policies_for(method, path, actor, assignments))
+
+
+def remaining_tier(method, path, actor, assignments):
+    """Return the requests `actor` has left on this route. Records nothing."""
+    return throttle.remaining_for(
+        method, path, actor, _policies_for(method, path, actor, assignments))
+
+
+def describe_tiers():
+    """Render the tier table, one sorted line per tier."""
+    return throttle.describe_policies(TIERS)
+
+
+def upgrade_path(tier):
+    """Return the next tier up by total allowance, or None for the top tier."""
+    if tier not in TIERS:
+        raise TierError("unknown tier %s" % (tier,))
+    ordered = sorted(
+        TIERS, key=lambda name: TIERS[name]["limit"] + TIERS[name]["burst"])
+    index = ordered.index(tier)
+    if index + 1 >= len(ordered):
+        return None
+    return ordered[index + 1]
diff --git a/app/validation.py b/app/validation.py
new file mode 100644
index 0000000..4d201c3
--- /dev/null
+++ b/app/validation.py
@@ -0,0 +1,102 @@
+"""Record input validation: the pre-create hook and its helpers.
+
+Every check and every message here is delegated to app.schema -- this
+module owns the *policy* (which fields matter, in what order, against
+which config keys), never the predicates or the message wording.
+"""
+import re
+import string
+
+from app import schema
+
+
+class ValidationError(Exception):
+    """Raised when a record's fields fail validation."""
+
+
+def validate_fields(fields, required_fields, max_amount):
+    """Validate `fields`, returning a new normalized dict.
+
+    Required-field presence is checked first, in `required_fields` order.
+    `name` and `amount` are only validated when actually present, since a
+    differently-configured caller may not require them at all. Extra keys
+    are preserved untouched: validation is additive, not a whitelist.
+    """
+    missing = schema.check_required(fields, required_fields)
+    if missing:
+        raise ValidationError(schema.format_error("missing", field=missing[0]))
+
+    if "name" in fields:
+        if not schema.is_non_empty_str(fields["name"]):
+            raise ValidationError(schema.format_error("non_empty", field="name"))
+
+    if "amount" in fields:
+        amount = fields["amount"]
+        if not schema.is_valid_amount(amount):
+            raise ValidationError(schema.format_error(
+                "numeric", field="amount", got=type(amount).__name__))
+        if amount < 0:
+            raise ValidationError(schema.format_error(
+                "non_negative", field="amount"))
+        if amount > max_amount:
+            raise ValidationError(schema.format_error(
+                "max", field="amount", limit=max_amount))
+
+    validated = dict(fields)
+    if "name" in validated:
+        validated["name"] = validated["name"].strip()
+    return validated
+
+
+def validate_many(entries, required_fields, max_amount):
+    """Validate a list of field dicts.
+
+    Returns ``(validated, errors)``: the successfully-validated new dicts
+    in input order, and ``(index, message)`` tuples for the failures, also
+    in input order. The input list and its dicts are never mutated.
+    """
+    validated = []
+    errors = []
+    for index, fields in enumerate(entries):
+        try:
+            validated.append(validate_fields(fields, required_fields, max_amount))
+        except ValidationError as err:
+            errors.append((index, str(err)))
+    return validated, errors
+
+
+def _catalog_pattern(template):
+    """A regex matching messages rendered from `template`."""
+    parts = []
+    for literal, field_name, _spec, _conversion in string.Formatter().parse(template):
+        parts.append(re.escape(literal))
+        if field_name is not None:
+            parts.append("(.+?)")
+    return re.compile("^" + "".join(parts) + "$", re.DOTALL)
+
+
+def error_code(message):
+    """The ERROR_CATALOG code `message` was rendered from.
+
+    The matcher is derived from the catalog on every call, so a catalog
+    edit is reflected here without a second hand-written table.
+    """
+    for code, template in schema.ERROR_CATALOG.items():
+        if _catalog_pattern(template).match(message):
+            return code
+    raise ValueError("unrecognized validation message: %r" % (message,))
+
+
+def explain_config(config):
+    """A human-readable summary of the validation config block."""
+    return "validation config:\n  required: %s\n  max_amount: %s" % (
+        ", ".join(config["validation_required_fields"]),
+        config["validation_max_amount"],
+    )
+
+
+def pre_create_hook(store, config, fields):
+    """PRE_CREATE_HOOKS entry: validate a create against the config."""
+    return validate_fields(fields,
+                           config["validation_required_fields"],
+                           config["validation_max_amount"])
