+"""Tests for `app.audit_query` — a pure read-side module over audit entries.
+
+Every function takes the entry list as a plain argument; the module imports
+nothing from `app.audit` and never mutates its input. Each test snapshots
+its fixture and asserts the input list (and its dicts) came back unchanged.
+"""
+import copy
+
+import pytest
+
+from app import audit_query as q
+
+
+def four_entries():
+    """GET is used by two actors; alice and bob each use two methods."""
+    return [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "GET", "path": "/report", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/1", "actor": "alice"},
+    ]
+
+
+def three_entries():
+    return [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/carts", "actor": "bob"},
+        {"method": "GET", "path": "/health", "actor": "carol"},
+    ]
+
+
+def five_entries():
+    return [
+        {"method": "GET", "path": "/a", "actor": "alice"},
+        {"method": "GET", "path": "/b", "actor": "bob"},
+        {"method": "POST", "path": "/c", "actor": "carol"},
+        {"method": "POST", "path": "/d", "actor": "dan"},
+        {"method": "DELETE", "path": "/e", "actor": "erin"},
+    ]
+
+
+def test_filter_entries_matches_each_criterion_and_ands_them_together():
+    entries = four_entries()
+    before = copy.deepcopy(entries)
+
+    assert q.filter_entries(entries, actor="alice") == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "DELETE", "path": "/records/1", "actor": "alice"},
+    ]
+    assert q.filter_entries(entries, method="POST") == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+    ]
+    assert q.filter_entries(entries, path="/records") == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+    ]
+    assert q.filter_entries(entries, actor="bob", method="GET") == [
+        {"method": "GET", "path": "/report", "actor": "bob"},
+    ]
+    assert q.filter_entries(entries, actor="bob", method="DELETE") == []
+    assert q.filter_entries(entries) == four_entries()
+
+    first = q.filter_entries(entries)
+    first.append({"method": "GET", "path": "/x", "actor": "mallory"})
+    assert q.filter_entries(entries) == four_entries()
+
+    assert entries == before
+
+
+def test_counts_by_counts_each_legal_field_and_rejects_others():
+    entries = four_entries()
+    before = copy.deepcopy(entries)
+
+    assert q.counts_by(entries, "method") == {"GET": 2, "POST": 1, "DELETE": 1}
+    assert q.counts_by(entries, "actor") == {"alice": 2, "bob": 2}
+    assert q.counts_by(entries, "path") == {
+        "/records": 2, "/report": 1, "/records/1": 1,
+    }
+    assert q.counts_by([], "method") == {}
+
+    with pytest.raises(ValueError) as excinfo:
+        q.counts_by(entries, "status")
+    assert "status" in str(excinfo.value)
+
+    assert entries == before
+
+
+def test_last_n_returns_the_final_entries_and_rejects_a_negative_n():
+    entries = four_entries()
+    before = copy.deepcopy(entries)
+
+    assert q.last_n(entries, 2) == [
+        {"method": "GET", "path": "/report", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/1", "actor": "alice"},
+    ]
+    assert q.last_n(entries, 0) == []
+    assert q.last_n(entries, 99) == four_entries()
+
+    whole = q.last_n(entries, 99)
+    whole.append({"method": "GET", "path": "/x", "actor": "mallory"})
+    assert len(entries) == 4
+
+    with pytest.raises(ValueError):
+        q.last_n(entries, -1)
+
+    assert entries == before
+
+
+def test_redact_replaces_the_named_fields_in_new_dicts():
+    entries = four_entries()
+    before = copy.deepcopy(entries)
+
+    assert q.redact(entries, ["actor"]) == [
+        {"method": "GET", "path": "/records", "actor": "***"},
+        {"method": "POST", "path": "/records", "actor": "***"},
+        {"method": "GET", "path": "/report", "actor": "***"},
+        {"method": "DELETE", "path": "/records/1", "actor": "***"},
+    ]
+
+    untouched = q.redact(entries, [])
+    assert untouched == four_entries()
+    for original, produced in zip(entries, untouched):
+        assert produced is not original
+
+    with pytest.raises(ValueError) as excinfo:
+        q.redact(entries, ["status"])
+    assert "status" in str(excinfo.value)
+
+    assert entries == before
+
+
+def test_summary_reports_totals_counts_and_first_last_copies():
+    assert q.summary([]) == {
+        "total": 0,
+        "by_method": {},
+        "by_actor": {},
+        "first": None,
+        "last": None,
+    }
+
+    entries = four_entries()
+    before = copy.deepcopy(entries)
+    result = q.summary(entries)
+    assert result == {
+        "total": 4,
+        "by_method": {"GET": 2, "POST": 1, "DELETE": 1},
+        "by_actor": {"alice": 2, "bob": 2},
+        "first": {"method": "GET", "path": "/records", "actor": "alice"},
+        "last": {"method": "DELETE", "path": "/records/1", "actor": "alice"},
+    }
+    assert result["first"] is not entries[0]
+    assert result["last"] is not entries[-1]
+    result["first"]["actor"] = "mallory"
+
+    assert entries == before
+
+
+def test_recent_returns_the_configured_default_limit():
+    entries = three_entries()
+    before = copy.deepcopy(entries)
+    config = {"audit_query_default_limit": 2}
+
+    assert q.recent(entries, config) == q.last_n(entries, 2)
+    assert q.recent(entries, config) == [
+        {"method": "POST", "path": "/carts", "actor": "bob"},
+        {"method": "GET", "path": "/health", "actor": "carol"},
+    ]
+
+    assert entries == before
+
+
+def test_paginate_returns_one_based_pages_with_metadata():
+    entries = five_entries()
+    before = copy.deepcopy(entries)
+
+    assert q.paginate(entries, 1, 2) == {
+        "page": 1,
+        "pages": 3,
+        "total": 5,
+        "items": [
+            {"method": "GET", "path": "/a", "actor": "alice"},
+            {"method": "GET", "path": "/b", "actor": "bob"},
+        ],
+    }
+    assert q.paginate(entries, 2, 2) == {
+        "page": 2,
+        "pages": 3,
+        "total": 5,
+        "items": [
+            {"method": "POST", "path": "/c", "actor": "carol"},
+            {"method": "POST", "path": "/d", "actor": "dan"},
+        ],
+    }
+    assert q.paginate(entries, 3, 2) == {
+        "page": 3,
+        "pages": 3,
+        "total": 5,
+        "items": [{"method": "DELETE", "path": "/e", "actor": "erin"}],
+    }
+    assert q.paginate(entries, 4, 2) == {
+        "page": 4,
+        "pages": 3,
+        "total": 5,
+        "items": [],
+    }
+    assert q.paginate([], 1, 2) == {
+        "page": 1,
+        "pages": 0,
+        "total": 0,
+        "items": [],
+    }
+
+    page = q.paginate(entries, 1, 2)
+    page["items"].append({"method": "GET", "path": "/x", "actor": "mallory"})
+    assert len(entries) == 5
+
+    with pytest.raises(ValueError):
+        q.paginate(entries, 0, 2)
+    with pytest.raises(ValueError):
+        q.paginate(entries, 1, 0)
+
+    assert entries == before
+
+
+def test_to_report_renders_the_exact_plain_text_report():
+    entries = four_entries()
+    before = copy.deepcopy(entries)
+
+    assert q.to_report(entries) == (
+        "audit report\n"
+        "total: 4\n"
+        "\n"
+        "by method:\n"
+        "  DELETE: 1\n"
+        "  GET: 2\n"
+        "  POST: 1\n"
+        "\n"
+        "by actor:\n"
+        "  alice: 2\n"
+        "  bob: 2"
+    )
+    assert q.to_report([]) == "audit report\ntotal: 0"
+
+    assert entries == before
+
+
+def test_to_csv_report_renders_the_exact_csv():
+    entries = four_entries()
+    before = copy.deepcopy(entries)
+
+    assert q.to_csv_report(entries) == (
+        "field,value,count\n"
+        "method,DELETE,1\n"
+        "method,GET,2\n"
+        "method,POST,1\n"
+        "actor,alice,2\n"
+        "actor,bob,2"
+    )
+    assert q.to_csv_report([]) == "field,value,count"
+
+    assert entries == before
+
+
+def test_to_markdown_report_renders_the_exact_pipe_table():
+    entries = four_entries()
+    before = copy.deepcopy(entries)
+
+    assert q.to_markdown_report(entries) == (
+        "| field | value | count |\n"
+        "| --- | --- | --- |\n"
+        "| method | DELETE | 1 |\n"
+        "| method | GET | 2 |\n"
+        "| method | POST | 1 |\n"
+        "| actor | alice | 2 |\n"
+        "| actor | bob | 2 |"
+    )
+    assert q.to_markdown_report([]) == (
+        "| field | value | count |\n"
+        "| --- | --- | --- |"
+    )
+
+    assert entries == before
+
+
+def test_top_actors_sorts_by_count_desc_then_actor_asc():
+    entries = [
+        {"method": "POST", "path": "/a", "actor": "bob"},
+        {"method": "GET", "path": "/b", "actor": "bob"},
+        {"method": "GET", "path": "/c", "actor": "alice"},
+        {"method": "POST", "path": "/d", "actor": "alice"},
+        {"method": "GET", "path": "/e", "actor": "carol"},
+    ]
+    before = copy.deepcopy(entries)
+
+    assert q.top_actors(entries, 3) == [("alice", 2), ("bob", 2), ("carol", 1)]
+    assert q.top_actors(entries, 2) == [("alice", 2), ("bob", 2)]
+    assert q.top_actors(entries, 0) == []
+
+    with pytest.raises(ValueError):
+        q.top_actors(entries, -1)
+
+    assert entries == before
+
+
+def test_merge_entries_concatenates_copies_in_argument_order():
+    left = three_entries()[:2]
+    right = [{"method": "DELETE", "path": "/records/1", "actor": "carol"}]
+    before_left = copy.deepcopy(left)
+    before_right = copy.deepcopy(right)
+
+    merged = q.merge_entries(left, right)
+    assert merged == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/carts", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+    merged[0]["actor"] = "mallory"
+    merged.append({"method": "GET", "path": "/x", "actor": "mallory"})
+
+    assert q.merge_entries() == []
+    assert left == before_left
+    assert right == before_right
+
+
+def test_diff_summaries_reports_only_changed_counts():
+    a_entries = [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    b_entries = [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "DELETE", "path": "/records/1", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/2", "actor": "carol"},
+    ]
+    a = q.summary(a_entries)
+    b = q.summary(b_entries)
+    before_a = copy.deepcopy(a)
+    before_b = copy.deepcopy(b)
+
+    assert q.diff_summaries(a, b) == {
+        "total": 1,
+        "by_method": {"POST": -1, "DELETE": 2},
+        "by_actor": {"alice": -1, "bob": 1, "carol": 1},
+    }
+
+    assert a == before_a
+    assert b == before_b
+
+
+def test_counts_matrix_nests_method_then_actor_without_zero_cells():
+    entries = four_entries()
+    before = copy.deepcopy(entries)
+
+    assert q.counts_matrix(entries) == {
+        "GET": {"alice": 1, "bob": 1},
+        "POST": {"bob": 1},
+        "DELETE": {"alice": 1},
+    }
+    assert q.counts_matrix([]) == {}
+
+    assert entries == before
+
+
+def test_rollup_generalizes_counts_by_and_counts_matrix():
+    entries = four_entries()
+    before = copy.deepcopy(entries)
+
+    assert q.rollup(entries, ["method"]) == q.counts_by(entries, "method")
+    assert q.rollup(entries, ["method", "actor"]) == q.counts_matrix(entries)
+    assert q.rollup(entries, ["actor", "method", "path"]) == {
+        "alice": {
+            "GET": {"/records": 1},
+            "DELETE": {"/records/1": 1},
+        },
+        "bob": {
+            "POST": {"/records": 1},
+            "GET": {"/report": 1},
+        },
+    }
+    assert q.rollup([], ["method"]) == {}
+
+    with pytest.raises(ValueError):
+        q.rollup(entries, [])
+    with pytest.raises(ValueError) as excinfo:
+        q.rollup(entries, ["status"])
+    assert "status" in str(excinfo.value)
+    with pytest.raises(ValueError):
+        q.rollup(entries, ["method", "method"])
+
+    assert entries == before
+
+
+def test_format_entry_and_to_lines_render_one_line_per_entry():
+    entries = three_entries()
+    before = copy.deepcopy(entries)
+
+    assert q.format_entry(entries[0]) == "GET /records (alice)"
+    assert q.to_lines(entries) == [
+        "GET /records (alice)",
+        "POST /carts (bob)",
+        "GET /health (carol)",
+    ]
+    assert q.to_lines([]) == []
+
+    with pytest.raises(ValueError) as excinfo:
