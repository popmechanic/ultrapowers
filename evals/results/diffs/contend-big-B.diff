+"""Tests for app/audit_query.py — a pure read-side module over audit entry
+lists. Every function takes a plain `entries` list and must never mutate
+its input; every test that calls a query function re-asserts the fixture
+is unchanged afterward.
+"""
+import pytest
+
+from app import audit_query as aq
+
+
+def _fixture():
+    return [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "GET", "path": "/records/1", "actor": "alice"},
+        {"method": "DELETE", "path": "/records/2", "actor": "carol"},
+    ]
+
+
+def _assert_unchanged(entries, original):
+    assert entries == original
+    for e, o in zip(entries, original):
+        assert e == o
+
+
+# ---------------------------------------------------------------------
+# filter_entries
+# ---------------------------------------------------------------------
+
+def test_filter_entries_matches_actor_method_path_and_combines_and_copies():
+    entries = _fixture()
+    original = _fixture()
+
+    assert aq.filter_entries(entries, actor="alice") == [entries[0], entries[2]]
+    assert aq.filter_entries(entries, method="POST") == [entries[1]]
+    assert aq.filter_entries(entries, path="/records") == [entries[0], entries[1]]
+    assert aq.filter_entries(entries, method="GET", actor="alice") == [entries[0], entries[2]]
+    assert aq.filter_entries(entries) == entries
+
+    result1 = aq.filter_entries(entries)
+    result1.append({"method": "X", "path": "Y", "actor": "Z"})
+    result2 = aq.filter_entries(entries)
+    assert result2 == entries
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# counts_by
+# ---------------------------------------------------------------------
+
+def test_counts_by_exact_dicts_and_unknown_field_raises():
+    entries = _fixture()
+    original = _fixture()
+
+    assert aq.counts_by(entries, "method") == {"GET": 2, "POST": 1, "DELETE": 1}
+    assert aq.counts_by(entries, "actor") == {"alice": 2, "bob": 1, "carol": 1}
+    assert aq.counts_by(entries, "path") == {
+        "/records": 2, "/records/1": 1, "/records/2": 1,
+    }
+    assert aq.counts_by([], "method") == {}
+
+    with pytest.raises(ValueError, match="nope"):
+        aq.counts_by(entries, "nope")
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# last_n
+# ---------------------------------------------------------------------
+
+def test_last_n_returns_final_entries_and_validates_n():
+    entries = _fixture()
+    original = _fixture()
+
+    assert aq.last_n(entries, 2) == [entries[2], entries[3]]
+    assert aq.last_n(entries, 0) == []
+    result = aq.last_n(entries, 100)
+    assert result == entries
+    assert result is not entries
+
+    with pytest.raises(ValueError):
+        aq.last_n(entries, -1)
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# redact
+# ---------------------------------------------------------------------
+
+def test_redact_replaces_field_leaves_originals_and_validates_field():
+    entries = _fixture()
+    original = _fixture()
+
+    redacted = aq.redact(entries, ["actor"])
+    assert redacted == [
+        {"method": "GET", "path": "/records", "actor": "***"},
+        {"method": "POST", "path": "/records", "actor": "***"},
+        {"method": "GET", "path": "/records/1", "actor": "***"},
+        {"method": "DELETE", "path": "/records/2", "actor": "***"},
+    ]
+    assert entries == original
+
+    same = aq.redact(entries, [])
+    assert same == entries
+    assert same is not entries
+    assert same[0] is not entries[0]
+
+    with pytest.raises(ValueError):
+        aq.redact(entries, ["id"])
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# summary
+# ---------------------------------------------------------------------
+
+def test_summary_empty_and_exact_dict_on_fixture():
+    assert aq.summary([]) == {
+        "total": 0, "by_method": {}, "by_actor": {}, "first": None, "last": None,
+    }
+
+    entries = _fixture()
+    original = _fixture()
+
+    result = aq.summary(entries)
+    assert result == {
+        "total": 4,
+        "by_method": {"GET": 2, "POST": 1, "DELETE": 1},
+        "by_actor": {"alice": 2, "bob": 1, "carol": 1},
+        "first": entries[0],
+        "last": entries[3],
+    }
+    assert result["first"] is not entries[0]
+    assert result["last"] is not entries[3]
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# recent
+# ---------------------------------------------------------------------
+
+def test_recent_delegates_to_last_n_with_configured_limit():
+    entries = [
+        {"method": "GET", "path": "/a", "actor": "u1"},
+        {"method": "GET", "path": "/b", "actor": "u2"},
+        {"method": "GET", "path": "/c", "actor": "u3"},
+    ]
+    original = [dict(e) for e in entries]
+    config = {"audit_query_default_limit": 2}
+
+    assert aq.recent(entries, config) == aq.last_n(entries, 2)
+    assert aq.recent(entries, config) == entries[1:]
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# paginate
+# ---------------------------------------------------------------------
+
+def test_paginate_exact_pages_and_validation():
+    entries = [
+        {"method": "GET", "path": "/%d" % i, "actor": "u%d" % i} for i in range(5)
+    ]
+    original = [dict(e) for e in entries]
+
+    page1 = aq.paginate(entries, 1, 2)
+    assert page1 == {
+        "page": 1, "pages": 3, "total": 5, "items": [entries[0], entries[1]],
+    }
+
+    page2 = aq.paginate(entries, 2, 2)
+    assert page2 == {
+        "page": 2, "pages": 3, "total": 5, "items": [entries[2], entries[3]],
+    }
+
+    page4 = aq.paginate(entries, 4, 2)
+    assert page4 == {"page": 4, "pages": 3, "total": 5, "items": []}
+
+    assert aq.paginate([], 1, 2) == {"page": 1, "pages": 0, "total": 0, "items": []}
+
+    with pytest.raises(ValueError):
+        aq.paginate(entries, 0, 2)
+    with pytest.raises(ValueError):
+        aq.paginate(entries, 1, 0)
+
+    items = page1["items"]
+    items.append({"method": "X", "path": "Y", "actor": "Z"})
+    assert entries == original
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# to_report
+# ---------------------------------------------------------------------
+
+def test_to_report_exact_text_and_empty():
+    entries = _fixture()
+    original = _fixture()
+
+    expected = (
+        "audit report\n"
+        "total: 4\n"
+        "\n"
+        "by method:\n"
+        "  DELETE: 1\n"
+        "  GET: 2\n"
+        "  POST: 1\n"
+        "\n"
+        "by actor:\n"
+        "  alice: 2\n"
+        "  bob: 1\n"
+        "  carol: 1"
+    )
+    assert aq.to_report(entries) == expected
+    assert aq.to_report([]) == "audit report\ntotal: 0"
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# to_csv_report
+# ---------------------------------------------------------------------
+
+def test_to_csv_report_exact_text_and_empty():
+    entries = _fixture()
+    original = _fixture()
+
+    expected = (
+        "field,value,count\n"
+        "method,DELETE,1\n"
+        "method,GET,2\n"
+        "method,POST,1\n"
+        "actor,alice,2\n"
+        "actor,bob,1\n"
+        "actor,carol,1"
+    )
+    assert aq.to_csv_report(entries) == expected
+    assert aq.to_csv_report([]) == "field,value,count"
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# top_actors
+# ---------------------------------------------------------------------
+
+def test_top_actors_sorted_desc_count_tie_ascending_actor_and_validates_n():
+    entries = [
+        {"method": "GET", "path": "/x", "actor": "bob"},
+        {"method": "GET", "path": "/x", "actor": "alice"},
+        {"method": "GET", "path": "/x", "actor": "bob"},
+        {"method": "GET", "path": "/x", "actor": "alice"},
+        {"method": "GET", "path": "/x", "actor": "carol"},
+    ]
+    original = [dict(e) for e in entries]
+
+    assert aq.top_actors(entries, 3) == [("alice", 2), ("bob", 2), ("carol", 1)]
+    assert aq.top_actors(entries, 2) == [("alice", 2), ("bob", 2)]
+    assert aq.top_actors(entries, 0) == []
+
+    with pytest.raises(ValueError):
+        aq.top_actors(entries, -1)
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# merge_entries
+# ---------------------------------------------------------------------
+
+def test_merge_entries_concatenates_copies_and_empty_call():
+    a = [{"method": "GET", "path": "/a", "actor": "u1"}]
+    b = [{"method": "POST", "path": "/b", "actor": "u2"}]
+    orig_a = [dict(e) for e in a]
+    orig_b = [dict(e) for e in b]
+
+    merged = aq.merge_entries(a, b)
+    assert merged == a + b
+    merged[0]["actor"] = "mutated"
+    assert a == orig_a
+    assert b == orig_b
+
+    assert aq.merge_entries() == []
+
+
+# ---------------------------------------------------------------------
+# diff_summaries
+# ---------------------------------------------------------------------
+
+def test_diff_summaries_added_actor_removed_method_unchanged_pair():
+    entries_a = [
+        {"method": "GET", "path": "/r", "actor": "alice"},
+        {"method": "POST", "path": "/r", "actor": "bob"},
+    ]
+    entries_b = [
+        {"method": "GET", "path": "/r", "actor": "alice"},
+        {"method": "GET", "path": "/r", "actor": "carol"},
+    ]
+    summary_a = aq.summary(entries_a)
+    summary_b = aq.summary(entries_b)
+
+    result = aq.diff_summaries(summary_a, summary_b)
+    assert result == {
+        "total": 0,
+        "by_method": {"GET": 1, "POST": -1},
+        "by_actor": {"bob": -1, "carol": 1},
+    }
+
+
+# ---------------------------------------------------------------------
+# counts_matrix
+# ---------------------------------------------------------------------
+
+def test_counts_matrix_exact_nested_dict_and_empty():
+    entries = [
+        {"method": "GET", "path": "/a", "actor": "alice"},
+        {"method": "GET", "path": "/a", "actor": "bob"},
+        {"method": "POST", "path": "/b", "actor": "alice"},
+        {"method": "DELETE", "path": "/c", "actor": "carol"},
+    ]
+    original = [dict(e) for e in entries]
+
+    assert aq.counts_matrix(entries) == {
+        "GET": {"alice": 1, "bob": 1},
+        "POST": {"alice": 1},
+        "DELETE": {"carol": 1},
+    }
+    assert aq.counts_matrix([]) == {}
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# rollup
+# ---------------------------------------------------------------------
+
+def test_rollup_matches_helpers_and_three_level_and_validates_fields():
+    entries = _fixture()
+    original = _fixture()
+
+    assert aq.rollup(entries, ["method"]) == aq.counts_by(entries, "method")
+    assert aq.rollup(entries, ["method", "actor"]) == aq.counts_matrix(entries)
+
+    assert aq.rollup(entries, ["actor", "method", "path"]) == {
+        "alice": {"GET": {"/records": 1, "/records/1": 1}},
+        "bob": {"POST": {"/records": 1}},
+        "carol": {"DELETE": {"/records/2": 1}},
+    }
+
+    assert aq.rollup([], ["method"]) == {}
+
+    with pytest.raises(ValueError):
+        aq.rollup(entries, [])
+    with pytest.raises(ValueError):
+        aq.rollup(entries, ["nope"])
+    with pytest.raises(ValueError):
+        aq.rollup(entries, ["method", "method"])
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# format_entry / to_lines
+# ---------------------------------------------------------------------
+
+def test_format_entry_exact_string_and_missing_key_raises():
+    entry = {"method": "GET", "path": "/records", "actor": "alice"}
+    assert aq.format_entry(entry) == "GET /records (alice)"
+
+    with pytest.raises(ValueError, match="actor"):
+        aq.format_entry({"method": "GET", "path": "/records"})
+    with pytest.raises(ValueError, match="method"):
+        aq.format_entry({"path": "/records", "actor": "alice"})
+    with pytest.raises(ValueError, match="path"):
+        aq.format_entry({"method": "GET", "actor": "alice"})
+
+
+def test_to_lines_exact_list_and_empty():
+    entries = [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/2", "actor": "carol"},
+    ]
+    original = [dict(e) for e in entries]
+
+    assert aq.to_lines(entries) == [
+        "GET /records (alice)",
+        "POST /records (bob)",
+        "DELETE /records/2 (carol)",
+    ]
+    assert aq.to_lines([]) == []
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# group_by
+# ---------------------------------------------------------------------
+
+def test_group_by_exact_dict_copies_and_validates_field():
+    entries = _fixture()
+    original = _fixture()
+
+    grouped = aq.group_by(entries, "method")
+    assert grouped == {
+        "GET": [entries[0], entries[2]],
+        "POST": [entries[1]],
+        "DELETE": [entries[3]],
+    }
+    grouped["GET"][0]["actor"] = "mutated"
+    assert entries[0]["actor"] == "alice"
+
+    assert aq.group_by([], "method") == {}
+
+    with pytest.raises(ValueError):
+        aq.group_by(entries, "nope")
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# search
+# ---------------------------------------------------------------------
+
+def test_search_matches_any_field_validates_needle_and_no_match():
+    entries = [
+        {"method": "GET", "path": "/orders", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "mork"},
+        {"method": "GET", "path": "/tickets", "actor": "zoe"},
+    ]
+    original = [dict(e) for e in entries]
+
+    result = aq.search(entries, "or")
+    assert result == [entries[0], entries[1]]
+
+    assert aq.search(entries, "xyz123") == []
+
+    with pytest.raises(ValueError):
+        aq.search(entries, "")
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# to_markdown_report
+# ---------------------------------------------------------------------
+
+def test_to_markdown_report_exact_table_and_empty():
+    entries = _fixture()
+    original = _fixture()
+
+    expected = (
+        "| field | value | count |\n"
+        "| --- | --- | --- |\n"
+        "| method | DELETE | 1 |\n"
+        "| method | GET | 2 |\n"
+        "| method | POST | 1 |\n"
+        "| actor | alice | 2 |\n"
+        "| actor | bob | 1 |\n"
+        "| actor | carol | 1 |"
+    )
+    assert aq.to_markdown_report(entries) == expected
+    assert aq.to_markdown_report([]) == (
+        "| field | value | count |\n| --- | --- | --- |"
+    )
+
+    _assert_unchanged(entries, original)
+
+
+# ---------------------------------------------------------------------
+# integration: composed with app.audit (the one non-pure test)
+# ---------------------------------------------------------------------
+
+def test_integration_with_audit_dispatch_hook():
+    from app import audit
+
+    audit.clear()
+    store = object()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(store, config, "GET", "/records", {"actor": "alice"})
+    audit.dispatch_hook(store, config, "POST", "/records", {"actor": "bob"})
+
+    result = aq.filter_entries(audit.entries(), actor="bob")
+    assert result == [{"method": "POST", "path": "/records", "actor": "bob"}]
