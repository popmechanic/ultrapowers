@@ -0,0 +1,112 @@
+"""Tests for the column-projection layer app/colspec.py."""
+import pytest
+
+from app import colspec, tabular
+
+
+def test_colspec_error_is_an_exception_subclass():
+    assert issubclass(colspec.ColspecError, Exception)
+
+
+def test_parse_colspec_pairs_and_whitespace_and_malformed_tokens():
+    assert colspec.parse_colspec("a,b:B,c") == [
+        ("a", "a"), ("b", "B"), ("c", "c"),
+    ]
+    # Whitespace around tokens and around ":" is stripped.
+    assert colspec.parse_colspec("a , b : B") == [("a", "a"), ("b", "B")]
+    with pytest.raises(colspec.ColspecError):
+        colspec.parse_colspec("")
+    with pytest.raises(colspec.ColspecError):
+        colspec.parse_colspec("a,,b")
+    with pytest.raises(colspec.ColspecError):
+        colspec.parse_colspec("a:B:C")
+
+
+def test_parse_colspec_duplicate_source_and_header_name_the_offender():
+    with pytest.raises(colspec.ColspecError) as exc:
+        colspec.parse_colspec("a,a:A")
+    assert "a" in str(exc.value)
+    with pytest.raises(colspec.ColspecError) as exc:
+        colspec.parse_colspec("a:X,b:X")
+    assert "X" in str(exc.value)
+
+
+def test_project_new_dicts_headers_in_pair_order_missing_source_is_none():
+    records = [{"a": 1, "x": 9}, {"b": 2}]
+    pairs = colspec.parse_colspec("a,b:B,c")
+    projected = colspec.project(records, pairs)
+    assert projected == [
+        {"a": 1, "B": None, "c": None},
+        {"a": None, "B": 2, "c": None},
+    ]
+    # Inputs are never mutated.
+    assert records == [{"a": 1, "x": 9}, {"b": 2}]
+
+
+def test_available_delegates_to_tabular_columns_and_splits_present_missing():
+    records = [{"a": 1, "x": 9}, {"b": 2}]
+    pairs = colspec.parse_colspec("a,b:B,c")
+    calls = []
+    real_columns = tabular.columns
+
+    def recorder(recs):
+        calls.append(recs)
+        return real_columns(recs)
+
+    original = tabular.columns
+    tabular.columns = recorder
+    try:
+        result = colspec.available(records, pairs)
+    finally:
+        tabular.columns = original
+    assert calls == [records]
+    assert result == (["a", "b"], ["c"])
+
+
+def test_auto_colspec_pairs_every_column_with_itself():
+    records = [{"a": 1, "x": 9}, {"b": 2}]
+    assert colspec.auto_colspec(records) == [
+        ("a", "a"), ("b", "b"), ("x", "x"),
+    ]
+
+
+def test_header_row_and_rename_map():
+    pairs = colspec.parse_colspec("a,b:B,c")
+    assert colspec.header_row(pairs) == ["a", "B", "c"]
+    assert colspec.rename_map(pairs) == {"b": "B"}
+
+
+def test_select_and_drop_keep_or_remove_named_sources_and_reject_empty():
+    records = [{"a": 1, "x": 9}, {"b": 2}]
+    assert colspec.select(records, ["a"]) == [{"a": 1}, {}]
+    assert colspec.drop(records, ["a"]) == [{"x": 9}, {"b": 2}]
+    assert records == [{"a": 1, "x": 9}, {"b": 2}]
+    with pytest.raises(colspec.ColspecError):
+        colspec.select(records, [])
+    with pytest.raises(colspec.ColspecError):
+        colspec.drop(records, [])
+
+
+def test_sanitize_headers_delegates_to_tabular_sanitize_flat():
+    pairs = [("a", "a\tb"), ("c", "clean")]
+    calls = []
+    real_sanitize = tabular.sanitize_flat
+
+    def recorder(value):
+        calls.append(value)
+        return real_sanitize(value)
+
+    original = tabular.sanitize_flat
+    tabular.sanitize_flat = recorder
+    try:
+        result = colspec.sanitize_headers(pairs)
+    finally:
+        tabular.sanitize_flat = original
+    assert calls == ["a\tb", "clean"]
+    assert result == [("a", "a b"), ("c", "clean")]
+
+
+def test_describe_colspec_one_line_per_pair_and_empty_marker():
+    pairs = colspec.parse_colspec("a,b:B,c")
+    assert colspec.describe_colspec(pairs) == "a <- a\nB <- b\nc <- c"
+    assert colspec.describe_colspec([]) == "(no columns)"
