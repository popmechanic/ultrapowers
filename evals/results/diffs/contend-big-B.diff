+    assert "actor" in str(excinfo.value)
+    with pytest.raises(ValueError) as excinfo:
+        q.format_entry({"path": "/records", "actor": "alice"})
+    assert "method" in str(excinfo.value)
+    with pytest.raises(ValueError) as excinfo:
+        q.format_entry({"method": "GET", "actor": "alice"})
+    assert "path" in str(excinfo.value)
+
+    assert entries == before
+
+
+def test_group_by_buckets_entry_copies_by_field_value():
+    entries = four_entries()
+    before = copy.deepcopy(entries)
+
+    grouped = q.group_by(entries, "method")
+    assert grouped == {
+        "GET": [
+            {"method": "GET", "path": "/records", "actor": "alice"},
+            {"method": "GET", "path": "/report", "actor": "bob"},
+        ],
+        "POST": [{"method": "POST", "path": "/records", "actor": "bob"}],
+        "DELETE": [{"method": "DELETE", "path": "/records/1", "actor": "alice"}],
+    }
+    grouped["GET"][0]["actor"] = "mallory"
+    assert q.group_by([], "method") == {}
+
+    with pytest.raises(ValueError) as excinfo:
