+"""Tests for app/tiers.py -- an actor-tier policy layer over app/throttle.py."""
+import pytest
+
+from app import quota, throttle, tiers
+from app.tiers import TierError
+
+
+def setup_function(_fn):
+    quota.reset()
+
+
+def test_tier_error_is_an_exception_subclass_distinct_from_policy_error():
+    assert issubclass(TierError, Exception)
+    assert not issubclass(TierError, throttle.PolicyError)
+
+
+def test_tiers_constant_pinned():
+    assert tiers.TIERS == {
+        "free": {"limit": 2, "window": 60, "burst": 0},
+        "pro": {"limit": 10, "window": 60, "burst": 2},
+        "internal": {"limit": 100, "window": 60, "burst": 10},
+    }
+
+
+def test_tier_of_defaults_to_free_and_raises_naming_actor_and_bogus_tier():
+    assert tiers.tier_of("someone", {}) == "free"
+    assert tiers.tier_of("someone", {"someone": "pro"}) == "pro"
+    with pytest.raises(TierError) as exc_info:
+        tiers.tier_of("mallory", {"mallory": "evil-tier"})
+    message = str(exc_info.value)
+    assert "mallory" in message
+    assert "evil-tier" in message
+
+
+def test_policy_for_returns_deep_copy():
+    policy = tiers.policy_for("a", {"a": "free"})
+    assert policy == {"limit": 2, "window": 60, "burst": 0}
+    policy["limit"] = 999
+    assert tiers.TIERS["free"] == {"limit": 2, "window": 60, "burst": 0}
+
+
+def test_enforce_tier_delegates_to_throttle_enforce(monkeypatch):
+    calls = []
+
+    def recorder(method, path, actor, policies):
+        calls.append((method, path, actor, policies))
+        return 1
+
+    monkeypatch.setattr(throttle, "enforce", recorder)
+    tiers.enforce_tier("POST", "/records", "mallory", {"mallory": "pro"})
+    assert calls == [
+        (
+            "POST",
+            "/records",
+            "mallory",
+            {"POST /records": {"limit": 10, "window": 60, "burst": 2}},
+        )
+    ]
+
+
+def test_enforce_tier_end_to_end_free_vs_pro_independence():
+    assignments = {"pro_actor": "pro"}
+    tiers.enforce_tier("POST", "/records", "free_actor", assignments)
+    tiers.enforce_tier("POST", "/records", "free_actor", assignments)
+    with pytest.raises(throttle.PolicyError):
+        tiers.enforce_tier("POST", "/records", "free_actor", assignments)
+
+    # "pro_actor"'s counter is independent of "free_actor"'s exhaustion.
+    tiers.enforce_tier("POST", "/records", "pro_actor", assignments)
+    tiers.enforce_tier("POST", "/records", "pro_actor", assignments)
+    tiers.enforce_tier("POST", "/records", "pro_actor", assignments)
+
+
+def test_remaining_tier_delegates_to_throttle_remaining_for_and_is_read_only():
+    assert tiers.remaining_tier("POST", "/records", "a", {}) == 2
+    tiers.enforce_tier("POST", "/records", "a", {})
+    assert tiers.remaining_tier("POST", "/records", "a", {}) == 1
+    # read-only: a subsequent enforce_tier still succeeds
+    tiers.enforce_tier("POST", "/records", "a", {})
+
+
+def test_describe_tiers_exact_literal():
+    assert tiers.describe_tiers() == (
+        "free: limit=2, window=60, burst=0\n"
+        "internal: limit=100, window=60, burst=10\n"
+        "pro: limit=10, window=60, burst=2"
+    )
+
+
+def test_upgrade_path_exact_chain_and_unknown_tier_raises():
+    assert tiers.upgrade_path("free") == "pro"
+    assert tiers.upgrade_path("pro") == "internal"
+    assert tiers.upgrade_path("internal") is None
+    with pytest.raises(TierError) as exc_info:
+        tiers.upgrade_path("bogus")
+    assert "bogus" in str(exc_info.value)
