diff --git a/app/audit.py b/app/audit.py
new file mode 100644
index 0000000..519ae02
--- /dev/null
+++ b/app/audit.py
@@ -0,0 +1,76 @@
+"""Audit log of every dispatched call.
+
+`dispatch_hook` is registered into `app.registry.DISPATCH_HOOKS` and fires
+for every dispatch, regardless of method — unlike rate limiting, the audit
+log does not special-case which HTTP verbs it logs. It always records; the
+`audit_log_enabled` config key is reserved for a future on/off switch and
+is not read by this module in this plan.
+
+The log is module-global state (a single process-wide audit trail) capped
+at `audit_log_max_entries` (or an explicit `max_entries` argument): once
+full, the oldest entry is evicted for each new one appended. `dropped()`
+reports how many entries have been evicted since the last `clear()`.
+"""
+
+_log = []
+_dropped = 0
+
+
+def clear():
+    """Reset the log and the dropped counter."""
+    global _log, _dropped
+    _log = []
+    _dropped = 0
+
+
+def entries():
+    """Return a copy of the log, in append order."""
+    return [dict(e) for e in _log]
+
+
+def record(method, path, actor, max_entries):
+    """Append one entry, then evict from the front until the log is at
+    most `max_entries` long, incrementing the dropped counter for each
+    eviction."""
+    global _dropped
+    _log.append({"method": method, "path": path, "actor": actor})
+    while len(_log) > max_entries:
+        _log.pop(0)
+        _dropped += 1
+
+
+def record_many(triples, max_entries):
+    """Append each (method, path, actor) triple in order, enforcing the
+    cap after every append. Returns the number of triples appended (always
+    len(triples) — appends that immediately age out still count)."""
+    for method, path, actor in triples:
+        record(method, path, actor, max_entries)
+    return len(triples)
+
+
+def dropped():
+    """Number of entries evicted by the cap since the last clear()."""
+    return _dropped
+
+
+def export_state():
+    """Return {"entries": entries(), "dropped": dropped()} — a copy safe
+    to mutate without affecting the live log."""
+    return {"entries": entries(), "dropped": dropped()}
+
+
+def import_state(state):
+    """Replace the log and dropped counter from an export_state()-shaped
+    dict. Copies its input so later mutation of `state` does not leak into
+    the live log."""
+    global _log, _dropped
+    _log = [dict(e) for e in state["entries"]]
+    _dropped = state["dropped"]
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS-shaped hook: records every dispatch, actor defaulting
+    to "anonymous" when kwargs carries none. Never logs record fields —
+    only method/path/actor."""
+    actor = kwargs.get("actor", "anonymous")
+    record(method, path, actor, config["audit_log_max_entries"])
diff --git a/app/audit_query.py b/app/audit_query.py
new file mode 100644
index 0000000..e309074
--- /dev/null
+++ b/app/audit_query.py
@@ -0,0 +1,254 @@
+"""Pure read-side queries over audit entry lists.
+
+Every function here takes a plain `entries` list (as produced by
+`app.audit.entries()`, but this module never imports `app.audit` and knows
+nothing about the live log) and returns a fresh value without mutating its
+input. Entry dicts always have exactly the three keys "method", "path",
+"actor".
+"""
+
+_FIELDS = ("method", "path", "actor")
+
+
+def _check_field(field):
+    if field not in _FIELDS:
+        raise ValueError("unknown field: %s" % field)
+
+
+def filter_entries(entries, method=None, path=None, actor=None):
+    """Return the copies of the entries matching every given criterion
+    (criteria not given are ignored); no criteria returns every entry."""
+    result = []
+    for e in entries:
+        if method is not None and e["method"] != method:
+            continue
+        if path is not None and e["path"] != path:
+            continue
+        if actor is not None and e["actor"] != actor:
+            continue
+        result.append(dict(e))
+    return result
+
+
+def counts_by(entries, field):
+    """Return {value: count} over `field` (one of method/path/actor)."""
+    _check_field(field)
+    counts = {}
+    for e in entries:
+        value = e[field]
+        counts[value] = counts.get(value, 0) + 1
+    return counts
+
+
+def last_n(entries, n):
+    """Return the final n entries (a copy), in order. n larger than the
+    list returns the whole list (a copy)."""
+    if n < 0:
+        raise ValueError("n must be >= 0")
+    if n == 0:
+        return []
+    return [dict(e) for e in entries[-n:]]
+
+
+def redact(entries, fields):
+    """Return new entry dicts with each name in `fields` replaced by
+    "***"; other keys untouched. `fields` must be a subset of
+    method/path/actor."""
+    for field in fields:
+        _check_field(field)
+    result = []
+    for e in entries:
+        copy = dict(e)
+        for field in fields:
+            copy[field] = "***"
+        result.append(copy)
+    return result
+
+
+def summary(entries):
+    """Return {"total", "by_method", "by_actor", "first", "last"} over
+    entries; first/last are copies of the first and last entry."""
+    if not entries:
+        return {"total": 0, "by_method": {}, "by_actor": {}, "first": None, "last": None}
+    return {
+        "total": len(entries),
+        "by_method": counts_by(entries, "method"),
+        "by_actor": counts_by(entries, "actor"),
+        "first": dict(entries[0]),
+        "last": dict(entries[-1]),
+    }
+
+
+def recent(entries, config):
+    """Return last_n(entries, config["audit_query_default_limit"])."""
+    return last_n(entries, config["audit_query_default_limit"])
+
+
+def paginate(entries, page, per_page):
+    """Return a 1-based page of entries: {"page", "pages", "total",
+    "items"}. "items" is always a copy."""
+    if page < 1:
+        raise ValueError("page must be >= 1")
+    if per_page < 1:
+        raise ValueError("per_page must be >= 1")
+    total = len(entries)
+    pages = (total + per_page - 1) // per_page if total else 0
+    start = (page - 1) * per_page
+    items = [dict(e) for e in entries[start:start + per_page]]
+    return {"page": page, "pages": pages, "total": total, "items": items}
+
+
+def to_report(entries):
+    """Render an exact plain-text report over entries."""
+    if not entries:
+        return "audit report\ntotal: %d" % len(entries)
+    by_method = counts_by(entries, "method")
+    by_actor = counts_by(entries, "actor")
+    lines = ["audit report", "total: %d" % len(entries), ""]
+    lines.append("by method:")
+    for value in sorted(by_method):
+        lines.append("  %s: %d" % (value, by_method[value]))
+    lines.append("")
+    lines.append("by actor:")
+    for value in sorted(by_actor):
+        lines.append("  %s: %d" % (value, by_actor[value]))
+    return "\n".join(lines)
+
+
+def to_csv_report(entries):
+    """Render an exact CSV report over entries: field,value,count rows."""
+    lines = ["field,value,count"]
+    if entries:
+        by_method = counts_by(entries, "method")
+        for value in sorted(by_method):
+            lines.append("method,%s,%d" % (value, by_method[value]))
+        by_actor = counts_by(entries, "actor")
+        for value in sorted(by_actor):
+            lines.append("actor,%s,%d" % (value, by_actor[value]))
+    return "\n".join(lines)
+
+
+def to_markdown_report(entries):
+    """Render an exact markdown pipe table over entries: field/value/count
+    rows in the same order as to_csv_report."""
+    lines = ["| field | value | count |", "| --- | --- | --- |"]
+    if entries:
+        by_method = counts_by(entries, "method")
+        for value in sorted(by_method):
+            lines.append("| method | %s | %d |" % (value, by_method[value]))
+        by_actor = counts_by(entries, "actor")
+        for value in sorted(by_actor):
+            lines.append("| actor | %s | %d |" % (value, by_actor[value]))
+    return "\n".join(lines)
+
+
+def top_actors(entries, n):
+    """Return [(actor, count), ...] sorted by count descending, ties
+    broken by actor ascending, truncated to n."""
+    if n < 0:
+        raise ValueError("n must be >= 0")
+    counts = counts_by(entries, "actor")
+    ordered = sorted(counts.items(), key=lambda pair: (-pair[1], pair[0]))
+    return ordered[:n]
+
+
+def merge_entries(*entry_lists):
+    """Return one new list concatenating the given entry lists, in
+    argument order, with copied entries."""
+    result = []
+    for entries in entry_lists:
+        result.extend(dict(e) for e in entries)
+    return result
+
+
+def diff_summaries(a, b):
+    """Return {"total", "by_method", "by_actor"} diffing two summary()
+    dicts: each sub-dict maps only values whose counts changed between a
+    and b to b_count - a_count (absent counts as 0; unchanged omitted)."""
+
+    def _diff(a_counts, b_counts):
+        diff = {}
+        for value in set(a_counts) | set(b_counts):
+            delta = b_counts.get(value, 0) - a_counts.get(value, 0)
+            if delta != 0:
+                diff[value] = delta
+        return diff
+
+    return {
+        "total": b["total"] - a["total"],
+        "by_method": _diff(a["by_method"], b["by_method"]),
+        "by_actor": _diff(a["by_actor"], b["by_actor"]),
+    }
+
+
+def counts_matrix(entries):
+    """Return the nested dict method -> actor -> count; only combinations
+    that occur appear."""
+    matrix = {}
+    for e in entries:
+        method = e["method"]
+        actor = e["actor"]
+        row = matrix.setdefault(method, {})
+        row[actor] = row.get(actor, 0) + 1
+    return matrix
+
+
+def rollup(entries, fields):
+    """Generalize counts_by / counts_matrix: nested counts by each field
+    in `fields`, in order. `fields` is a non-empty list of distinct names
+    drawn from method/path/actor."""
+    if not fields:
+        raise ValueError("fields must be non-empty")
+    seen = set()
+    for field in fields:
+        _check_field(field)
+        if field in seen:
+            raise ValueError("duplicate field: %s" % field)
+        seen.add(field)
+
+    result = {}
+    for e in entries:
+        node = result
+        for field in fields[:-1]:
+            node = node.setdefault(e[field], {})
+        last_field = fields[-1]
+        value = e[last_field]
+        node[value] = node.get(value, 0) + 1
+    return result
+
+
+def format_entry(entry):
+    """Return "<METHOD> <path> (<actor>)"; raises ValueError naming any of
+    the three keys missing from `entry`."""
+    for field in _FIELDS:
+        if field not in entry:
+            raise ValueError("missing field: %s" % field)
+    return "%s %s (%s)" % (entry["method"], entry["path"], entry["actor"])
+
+
+def to_lines(entries):
+    """Return [format_entry(e) for e in entries]."""
+    return [format_entry(e) for e in entries]
+
+
+def group_by(entries, field):
+    """Return {value: [entry copies]} grouping entries by `field`, in
+    original order within each group."""
+    _check_field(field)
+    groups = {}
+    for e in entries:
+        groups.setdefault(e[field], []).append(dict(e))
+    return groups
+
+
+def search(entries, needle):
+    """Return the entry copies where `needle` is a substring of any of the
+    three field values, in original order. Raises ValueError on an empty
+    needle."""
+    if not needle:
+        raise ValueError("needle must not be empty")
+    result = []
+    for e in entries:
+        if any(needle in e[field] for field in _FIELDS):
+            result.append(dict(e))
+    return result
diff --git a/app/backoff.py b/app/backoff.py
new file mode 100644
index 0000000..a7f8ed9
--- /dev/null
+++ b/app/backoff.py
@@ -0,0 +1,75 @@
+"""Deterministic retry-schedule calculator, built on `app.quota`.
+
+Pure functions only; no module state of its own.
+"""
+from app import quota
+
+
+class BackoffError(Exception):
+    """Raised for invalid backoff parameters."""
+
+
+def schedule(base, factor, retries):
+    """Return `[base * factor**i for i in range(retries)]` as floats."""
+    if base <= 0:
+        raise BackoffError("base must be positive, got %r" % (base,))
+    if factor < 1.0:
+        raise BackoffError("factor must be >= 1.0, got %r" % (factor,))
+    if retries < 0:
+        raise BackoffError("retries must be >= 0, got %r" % (retries,))
+    return [float(base * factor ** i) for i in range(retries)]
+
+
+def capped(seq, cap):
+    """Return a new list: the element-wise min of `seq` against `cap`."""
+    if cap <= 0:
+        raise BackoffError("cap must be positive, got %r" % (cap,))
+    return [min(x, cap) for x in seq]
+
+
+def total_wait(seq):
+    """The float sum of `seq`."""
+    return float(sum(seq))
+
+
+def next_delay(attempt, base, factor, cap):
+    """The delay for a single `attempt`: `min(base * factor**attempt, cap)`."""
+    if attempt < 0:
+        raise BackoffError("attempt must be >= 0, got %r" % (attempt,))
+    return min(base * factor ** attempt, cap)
+
+
+def delay_until_free(key, config):
+    """Read-only: seconds until `key` next has a free slot, per `config`."""
+    return quota.time_to_next_slot(
+        key,
+        config["rate_limit_max_per_window"],
+        config.get("rate_limit_window_seconds", 60),
+        burst=config.get("rate_limit_burst", 0),
+    )
+
+
+def retry_plan(key, config, retries):
+    """Read-only: a full retry plan for `key` combining current quota
+    state with a capped exponential backoff schedule."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    immediate = quota.remaining(key, limit, window_seconds, burst=burst) > 0
+    wait = delay_until_free(key, config)
+    backoff = capped(
+        schedule(
+            config.get("backoff_base", 1.0),
+            config.get("backoff_factor", 2.0),
+            retries,
+        ),
+        config.get("backoff_cap", 60.0),
+    )
+    return {"immediate": immediate, "wait": wait, "backoff": backoff}
+
+
+def describe_schedule(seq):
+    """Render `seq` as a comma-joined, "s"-suffixed delay list."""
+    if not seq:
+        return "(no retries)"
+    return ", ".join("%ss" % (delay,) for delay in seq)
diff --git a/app/colspec.py b/app/colspec.py
new file mode 100644
index 0000000..1d67681
--- /dev/null
+++ b/app/colspec.py
@@ -0,0 +1,101 @@
+"""Column-projection layer: parse a "source[:header],..." colspec string
+and project/select/drop record fields by it. Pure; imports app.tabular
+only.
+"""
+from app import tabular
+
+
+class ColspecError(Exception):
+    pass
+
+
+def parse_colspec(spec):
+    """Parse "a,b:B,c" into [(source, header), ...] -- a bare token uses
+    its own name as header. Whitespace around tokens and the ":" is
+    stripped. Raises ColspecError on an empty spec, an empty token, more
+    than one ":" in a token, or a duplicate source/header."""
+    if spec.strip() == "":
+        raise ColspecError("empty colspec")
+    pairs = []
+    seen_sources = set()
+    seen_headers = set()
+    for raw_tok in spec.split(","):
+        tok = raw_tok.strip()
+        if tok == "":
+            raise ColspecError("empty token in colspec")
+        parts = tok.split(":")
+        if len(parts) > 2:
+            raise ColspecError("too many ':' in token: %s" % tok)
+        if len(parts) == 2:
+            source, header = parts[0].strip(), parts[1].strip()
+        else:
+            source = header = parts[0].strip()
+        if source in seen_sources:
+            raise ColspecError("duplicate source: %s" % source)
+        if header in seen_headers:
+            raise ColspecError("duplicate header: %s" % header)
+        seen_sources.add(source)
+        seen_headers.add(header)
+        pairs.append((source, header))
+    return pairs
+
+
+def project(records, pairs):
+    """New list of dicts, one per record in input order, keyed by header
+    (in pair order), valued from the source field (None if absent).
+    Never mutates the input records."""
+    return [{header: r.get(source) for source, header in pairs}
+            for r in records]
+
+
+def available(records, pairs):
+    """(present, missing) -- sorted source-name lists split against
+    tabular.columns(records)."""
+    cols = set(tabular.columns(records))
+    sources = [source for source, header in pairs]
+    present = sorted(s for s in sources if s in cols)
+    missing = sorted(s for s in sources if s not in cols)
+    return (present, missing)
+
+
+def auto_colspec(records):
+    """[(c, c) for c in tabular.columns(records)]."""
+    return [(c, c) for c in tabular.columns(records)]
+
+
+def header_row(pairs):
+    return [header for source, header in pairs]
+
+
+def rename_map(pairs):
+    """{source: header} entries only for pairs that actually rename."""
+    return {source: header for source, header in pairs if source != header}
+
+
+def select(records, sources):
+    """Keep only the named source fields (present ones), order-preserving
+    new dicts. Raises ColspecError on an empty `sources`."""
+    if not sources:
+        raise ColspecError("empty sources")
+    return [{k: v for k, v in r.items() if k in sources} for r in records]
+
+
+def drop(records, sources):
+    """Remove the named source fields, order-preserving new dicts. Raises
+    ColspecError on an empty `sources`."""
+    if not sources:
+        raise ColspecError("empty sources")
+    return [{k: v for k, v in r.items() if k not in sources} for r in records]
+
+
+def sanitize_headers(pairs):
+    """New pairs list with every header passed through
+    tabular.sanitize_flat."""
+    return [(source, tabular.sanitize_flat(header)) for source, header in pairs]
+
+
+def describe_colspec(pairs):
+    """One line per pair, "<header> <- <source>"; "(no columns)" if empty."""
+    if not pairs:
+        return "(no columns)"
+    return "\n".join("%s <- %s" % (header, source) for source, header in pairs)
diff --git a/app/export.py b/app/export.py
new file mode 100644
index 0000000..9d974a4
--- /dev/null
+++ b/app/export.py
@@ -0,0 +1,164 @@
+"""Export formatters: render a list of plain dict records as CSV, JSON,
+Markdown, NDJSON, TSV, or (extra, not route-reachable) HTML.
+
+Every formatter builds its column model and cell rendering through
+`app.tabular` -- no duplicated key-union, escaping, or str() logic lives
+here.
+"""
+import json
+
+from app import tabular
+
+
+def to_csv(records):
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = [",".join(tabular.escape_csv(c) for c in cols)]
+    for r in records:
+        lines.append(",".join(
+            tabular.escape_csv(tabular.cell(r.get(c))) for c in cols))
+    return "\n".join(lines)
+
+
+def to_json(records):
+    return json.dumps(records, sort_keys=True)
+
+
+def to_markdown(records, align="left"):
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    w = tabular.widths(records, cols)
+    header_cells = [tabular.pad(c, w[c], align) for c in cols]
+    rows = ["| " + " | ".join(header_cells) + " |"]
+    if align == "left":
+        sep_cells = ["-" * w[c] for c in cols]
+    else:
+        sep_cells = ["-" * (w[c] - 1) + ":" for c in cols]
+    rows.append("| " + " | ".join(sep_cells) + " |")
+    for r in records:
+        cells = [tabular.pad(tabular.cell(r.get(c)), w[c], align)
+                 for c in cols]
+        rows.append("| " + " | ".join(cells) + " |")
+    return "\n".join(rows)
+
+
+def to_ndjson(records):
+    if not records:
+        return ""
+    return "\n".join(json.dumps(r, sort_keys=True) for r in records)
+
+
+def to_tsv(records):
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = ["\t".join(tabular.sanitize_flat(c) for c in cols)]
+    for r in records:
+        lines.append("\t".join(
+            tabular.sanitize_flat(r.get(c)) for c in cols))
+    return "\n".join(lines)
+
+
+def to_html(records):
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = ["<table>"]
+    lines.append("<tr>" + "".join(
+        "<th>%s</th>" % tabular.escape_html(c) for c in cols) + "</tr>")
+    for r in records:
+        lines.append("<tr>" + "".join(
+            "<td>%s</td>" % tabular.escape_html(r.get(c)) for c in cols)
+            + "</tr>")
+    lines.append("</table>")
+    return "\n".join(lines)
+
+
+def parse_csv(text):
+    """Inverse of to_csv: first line is the header, each further line
+    yields a dict of header -> cell string (values are never re-typed).
+    Handles quoted cells (embedded commas, doubled quotes, embedded
+    newlines) and raises ValueError on an unterminated quote."""
+    if text == "":
+        return []
+    rows = []
+    row = []
+    cell_chars = []
+    in_quotes = False
+    i = 0
+    n = len(text)
+    while i < n:
+        ch = text[i]
+        if in_quotes:
+            if ch == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    cell_chars.append('"')
+                    i += 2
+                    continue
+                in_quotes = False
+                i += 1
+                continue
+            cell_chars.append(ch)
+            i += 1
+            continue
+        if ch == '"':
+            in_quotes = True
+            i += 1
+            continue
+        if ch == ',':
+            row.append("".join(cell_chars))
+            cell_chars = []
+            i += 1
+            continue
+        if ch == '\n':
+            row.append("".join(cell_chars))
+            rows.append(row)
+            row = []
+            cell_chars = []
+            i += 1
+            continue
+        cell_chars.append(ch)
+        i += 1
+    if in_quotes:
+        raise ValueError("unterminated quote in CSV")
+    row.append("".join(cell_chars))
+    rows.append(row)
+
+    header = rows[0]
+    data_rows = rows[1:]
+    if not data_rows:
+        return []
+    return [dict(zip(header, r)) for r in data_rows]
+
+
+FORMATS = {
+    "csv": to_csv,
+    "json": to_json,
+    "md": to_markdown,
+    "ndjson": to_ndjson,
+    "tsv": to_tsv,
+}
+
+EXTRA_FORMATS = {
+    "html": to_html,
+}
+
+
+def render(records, fmt):
+    if fmt not in FORMATS:
+        raise ValueError("unknown export format: %s" % fmt)
+    return FORMATS[fmt](records)
+
+
+def render_any(records, fmt):
+    if fmt in FORMATS:
+        return FORMATS[fmt](records)
+    if fmt in EXTRA_FORMATS:
+        return EXTRA_FORMATS[fmt](records)
+    raise ValueError("unknown export format: %s" % fmt)
+
+
+def summary_line(records):
+    return "%d records, %d columns" % (len(records), len(tabular.columns(records)))
diff --git a/app/quota.py b/app/quota.py
new file mode 100644
index 0000000..6b46f56
--- /dev/null
+++ b/app/quota.py
@@ -0,0 +1,133 @@
+"""Windowed hit counter over a deterministic logical clock.
+
+No wall-clock time is used anywhere in this module so tests (and any
+caller) can drive time deterministically via `advance()`. State is
+module-global: a float `_clock` and a `_hits` dict mapping key -> list of
+hit timestamps (in insertion order, never pruned in place except by
+`purge()` / `reset()`). Every read (take/remaining/snapshot/usage/
+time_to_next_slot) computes its own in-window view rather than mutating
+the stored list, so `purge()` remains the sole operation that actually
+shrinks storage.
+"""
+
+
+class QuotaExceededError(Exception):
+    """Raised by `take()` when a key has no room left in its window."""
+
+
+_clock = 0.0
+_hits = {}
+
+
+def reset():
+    """Reset the logical clock to 0.0 and clear every key's hits."""
+    global _clock
+    _clock = 0.0
+    _hits.clear()
+
+
+def now():
+    """Return the current logical clock value."""
+    return _clock
+
+
+def advance(seconds):
+    """Advance the logical clock by `seconds` (must be >= 0) and return
+    the new clock value. Raises ValueError, leaving the clock unchanged,
+    if `seconds` is negative (the clock is monotonic)."""
+    global _clock
+    if seconds < 0:
+        raise ValueError("advance: seconds must be non-negative, got %r" % (seconds,))
+    _clock += seconds
+    return _clock
+
+
+def _in_window(hits, window_seconds, at):
+    """Return the subset of `hits` that has not aged out of a window of
+    `window_seconds` ending at `at`. A hit sitting exactly at the
+    threshold (`at - window_seconds`) is kept; only strictly older hits
+    are dropped."""
+    if window_seconds == float("inf"):
+        return list(hits)
+    threshold = at - window_seconds
+    return [h for h in hits if h >= threshold]
+
+
+def take(key, limit, window_seconds, burst=0):
+    """Record a hit for `key` if there is room in the window, returning
+    the in-window hit count after recording. Raises QuotaExceededError
+    (without recording) once `limit + burst` in-window hits are already
+    present."""
+    hits = _hits.get(key, [])
+    in_window = _in_window(hits, window_seconds, _clock)
+    if len(in_window) >= limit + burst:
+        raise QuotaExceededError(
+            "quota exceeded for %r: limit=%s" % (key, limit)
+        )
+    hits = _hits.setdefault(key, [])
+    hits.append(_clock)
+    return len(_in_window(hits, window_seconds, _clock))
+
+
+def remaining(key, limit, window_seconds, burst=0):
+    """Read-only: how many more `take()` calls would currently succeed
+    for `key`. Never negative."""
+    hits = _hits.get(key, [])
+    in_window = _in_window(hits, window_seconds, _clock)
+    return max(0, limit + burst - len(in_window))
+
+
+def snapshot(window_seconds):
+    """Return a deep-copied dict mapping each key with at least one
+    in-window hit to the sorted list of its in-window hit timestamps.
+    Keys with no in-window hits are omitted."""
+    result = {}
+    for key, hits in _hits.items():
+        in_window = sorted(_in_window(hits, window_seconds, _clock))
+        if in_window:
+            result[key] = in_window
+    return result
+
+
+def time_to_next_slot(key, limit, window_seconds, burst=0):
+    """Read-only: seconds until one slot frees for `key`. 0.0 if a slot
+    is already free. float("inf") if the window never prunes, or if the
+    allowance (`limit + burst`) is zero so no slot can ever free."""
+    if limit + burst <= 0:
+        return float("inf")
+    hits = _hits.get(key, [])
+    in_window = _in_window(hits, window_seconds, _clock)
+    if len(in_window) < limit + burst:
+        return 0.0
+    if window_seconds == float("inf"):
+        return float("inf")
+    oldest = min(in_window)
+    return oldest + window_seconds - _clock
+
+
+def usage(key, limit, window_seconds, burst=0):
+    """Read-only summary of `key`'s current usage against `limit` /
+    `window_seconds` / `burst`."""
+    hits = _hits.get(key, [])
+    in_window = _in_window(hits, window_seconds, _clock)
+    return {
+        "used": len(in_window),
+        "allowed": limit + burst,
+        "remaining": remaining(key, limit, window_seconds, burst),
+        "reset_in": time_to_next_slot(key, limit, window_seconds, burst),
+    }
+
+
+def purge(window_seconds):
+    """Drop every key's aged-out hits (per `window_seconds`), removing
+    keys left with none. Returns the total number of hits dropped."""
+    dropped = 0
+    for key in list(_hits.keys()):
+        hits = _hits[key]
+        kept = _in_window(hits, window_seconds, _clock)
+        dropped += len(hits) - len(kept)
+        if kept:
+            _hits[key] = kept
+        else:
+            del _hits[key]
+    return dropped
diff --git a/app/ratelimit.py b/app/ratelimit.py
new file mode 100644
index 0000000..0b41864
--- /dev/null
+++ b/app/ratelimit.py
@@ -0,0 +1,88 @@
+"""Per-actor POST rate limiting, built on `app.quota`'s windowed counter.
+
+This module keeps no counter state of its own: every count lives in
+`app.quota`'s module-global hits store, keyed directly by the request's
+actor (defaulting to "anonymous"). `dispatch_hook` is the DISPATCH_HOOKS
+entry point the registry wires in; it is a no-op for any method other
+than "POST" (rate limiting applies to writes, not reads).
+"""
+from app import quota
+
+
+class RateLimitExceededError(quota.QuotaExceededError):
+    """Raised when an actor has exhausted its rate-limit window."""
+
+
+def reset():
+    """Reset all rate-limit state. Delegates to `quota.reset()`, which
+    also resets the logical clock."""
+    quota.reset()
+
+
+def check_and_increment(key, limit, window_seconds=float("inf")):
+    """Record a hit for `key` against a plain call-counting quota
+    (unbounded window by default) and return the resulting count. Raises
+    RateLimitExceededError once `limit` is exceeded."""
+    try:
+        return quota.take(key, limit, window_seconds, burst=0)
+    except quota.QuotaExceededError as exc:
+        raise RateLimitExceededError(str(exc)) from exc
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS entry point: rate-limits POST requests per actor.
+    Only `config["rate_limit_max_per_window"]` is required; window and
+    burst always fall back to defaults via `.get(...)`."""
+    if method != "POST":
+        return
+    actor = kwargs.get("actor", "anonymous")
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    try:
+        quota.take(actor, limit, window_seconds, burst=burst)
+    except quota.QuotaExceededError as exc:
+        raise RateLimitExceededError(str(exc)) from exc
+
+
+def retry_after(key, config):
+    """Read-only: seconds until `key` next has a free slot, per `config`."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    return quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
+
+
+def limit_headers(key, config):
+    """Read-only: rate-limit response headers for `key`, as strings."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    rem = quota.remaining(key, limit, window_seconds, burst=burst)
+    reset_in = quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
+    return {
+        "X-RateLimit-Limit": str(limit),
+        "X-RateLimit-Remaining": str(rem),
+        "X-RateLimit-Reset": str(reset_in),
+    }
+
+
+def status_line(key, config):
+    """Read-only: a one-line human-readable usage summary for `key`."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    u = quota.usage(key, limit, window_seconds, burst=burst)
+    return "%s: %s/%s, reset in %ss" % (key, u["used"], u["allowed"], u["reset_in"])
+
+
+def check_many(keys, config):
+    """Read-only: for each key in `keys`, whether a POST would currently
+    succeed."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    return {
+        key: quota.remaining(key, limit, window_seconds, burst=burst) > 0
+        for key in keys
+    }
