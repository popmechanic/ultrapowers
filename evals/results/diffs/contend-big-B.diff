index 0000000..eb4a90b
--- /dev/null
+++ b/app/reportdoc.py
@@ -0,0 +1,85 @@
+"""Multi-section report composer: several named record sets, each
+rendered through a chosen export format and assembled into one document.
+
+Imports app.export and app.colspec only. This is a NEW module -- the
+pre-existing app/report.py totals renderer and its /report route are
+untouched, and nothing here reuses its names from outside this module.
+"""
+from app import colspec
+from app import export
+
+
+class ReportError(Exception):
+    pass
+
+
+def section(title, records, fmt="md"):
+    if not title or not title.strip():
+        raise ReportError("empty section title")
+    if fmt not in export.FORMATS and fmt not in export.EXTRA_FORMATS:
+        raise ReportError(fmt)
+    return {"title": title, "records": records, "fmt": fmt}
+
+
+def render_section(sec):
+    title = sec["title"]
+    records = sec["records"]
+    if not records:
+        return "## " + title + "\n\n(no records)"
+    return "## " + title + "\n\n" + export.render_any(records, sec["fmt"])
+
+
+def _check_duplicate_titles(sections):
+    seen = set()
+    for sec in sections:
+        title = sec["title"]
+        if title in seen:
+            raise ReportError(title)
+        seen.add(title)
+
+
+def render_report(title, sections):
+    _check_duplicate_titles(sections)
+    if not sections:
+        return "# " + title + "\n\n(empty report)"
+    rendered = [render_section(sec) for sec in sections]
+    return "# " + title + "\n\n" + "\n\n".join(rendered)
+
+
+def toc(sections):
+    _check_duplicate_titles(sections)
+    return [sec["title"] for sec in sections]
+
+
+def record_counts(sections):
+    return {sec["title"]: len(sec["records"]) for sec in sections}
+
+
+def summary(sections):
+    total = sum(len(sec["records"]) for sec in sections)
+    return "%d sections, %d records" % (len(sections), total)
+
+
+def render_index(sections):
+    if not sections:
+        return "(empty report)"
+    lines = ["%d. %s (%d records)" % (i, sec["title"], len(sec["records"]))
+              for i, sec in enumerate(sections, start=1)]
+    return "\n".join(lines)
+
+
+def projected_section(title, records, pairs, fmt="md"):
+    return section(title, colspec.project(records, pairs), fmt)
+
+
+def find_section(sections, title):
+    for sec in sections:
+        if sec["title"] == title:
+            return sec
+    raise ReportError(title)
+
+
+def merge_reports(a, b):
+    merged = list(a) + list(b)
+    _check_duplicate_titles(merged)
+    return merged
diff --git a/app/tabular.py b/app/tabular.py
new file mode 100644
index 0000000..999b07e
--- /dev/null
+++ b/app/tabular.py
@@ -0,0 +1,129 @@
+"""Column-model toolkit shared by the export formatters.
+
+Pure helpers over lists of plain dict "records": figuring out the column
+set, rendering a single cell, escaping for CSV/HTML, measuring/padding
+column widths, and wrapping/truncating long values. `app/export.py` builds
+every format on top of these — no duplicated key-union, escaping, or
+str()-ing logic lives in export.py.
+"""
+
+
+def columns(records):
+    """Sorted union of every key across all records."""
+    keys = set()
+    for r in records:
+        keys.update(r.keys())
+    return sorted(keys)
+
+
+def cell(value):
+    """Plain str() rendering of a value, except None -> ""."""
+    if value is None:
+        return ""
+    return str(value)
+
+
+def escape_csv(value):
+    """CSV-escape a single cell's rendered text: quote the cell (doubling
+    any inner quotes) only if it contains a comma, quote, or newline."""
+    if any(ch in value for ch in (",", '"', "\n", "\r")):
+        return '"' + value.replace('"', '""') + '"'
+    return value
+
+
+def widths(records, cols):
+    """dict: column name -> max(len(header), max cell width)."""
+    result = {}
+    for c in cols:
+        w = len(c)
+        for r in records:
+            cw = len(cell(r.get(c)))
+            if cw > w:
+                w = cw
+        result[c] = w
+    return result
+
+
+def pad(value, width, align):
+    """Pad `value` to `width` per `align` ("left" or "right"). A value
+    already at or beyond `width` is returned unchanged (never truncated).
+    `align` is validated before any short-circuit, so an invalid align
+    always raises, even when the value already meets the width."""
+    if align not in ("left", "right"):
+        raise ValueError("invalid align: %s" % align)
+    if len(value) >= width:
+        return value
+    fill = " " * (width - len(value))
+    if align == "left":
+        return value + fill
+    return fill + value
+
+
+def sanitize_flat(value):
+    """cell(value) with every tab and newline replaced by a single space
+    -- the helper flat single-line formats (TSV) build on."""
+    s = cell(value)
+    return s.replace("\t", " ").replace("\n", " ")
+
+
+def escape_html(value):
+    """cell(value) with &, <, >, " HTML-escaped (ampersand first)."""
+    s = cell(value)
+    s = s.replace("&", "&amp;")
+    s = s.replace("<", "&lt;")
+    s = s.replace(">", "&gt;")
+    s = s.replace('"', "&quot;")
+    return s
+
+
+def truncate(value, width, marker="..."):
+    """`value` unchanged if it already fits in `width`; otherwise the
+    first `width - len(marker)` characters plus `marker`."""
+    if width < len(marker):
+        raise ValueError("width %r smaller than marker %r" % (width, marker))
+    if len(value) <= width:
+        return value
+    return value[:width - len(marker)] + marker
+
+
+def wrap(value, width):
+    """Greedily wrap `value` on spaces into lines each <= width. A single
+    word longer than `width` is hard-split at `width`."""
+    if width < 1:
+        raise ValueError("width must be >= 1: %r" % (width,))
+    if value == "":
+        return [""]
+    words = value.split(" ")
+    lines = []
+    current = ""
+    for word in words:
+        while len(word) > width:
+            if current:
+                lines.append(current)
+                current = ""
+            lines.append(word[:width])
+            word = word[width:]
+        candidate = current + " " + word if current else word
+        if len(candidate) <= width:
+            current = candidate
+        else:
+            lines.append(current)
+            current = word
+    lines.append(current)
+    return lines
+
+
+def fit(value, width, align):
+    """Compose truncate() then pad(): an over-long value is truncated to
+    `width` (marker included), a short one padded per `align`."""
+    return pad(truncate(value, width), width, align)
+
+
+def render_row(cells, widths_list, align):
+    """Render one pipe-table row: "| " + " | ".join(padded cells) + " |",
+    each cell padded to its width."""
+    if len(cells) != len(widths_list):
+        raise ValueError("cells/widths length mismatch: %d != %d"
+                          % (len(cells), len(widths_list)))
+    padded = [pad(c, w, align) for c, w in zip(cells, widths_list)]
+    return "| " + " | ".join(padded) + " |"
diff --git a/app/throttle.py b/app/throttle.py
new file mode 100644
index 0000000..25c261f
--- /dev/null
+++ b/app/throttle.py
@@ -0,0 +1,81 @@
+"""Pure policy layer over `app.quota`'s windowed counter.
+
+Not wired into the registry: a library layer for future routes. Holds no
+module state of its own beyond the `POLICIES` constant; every actual hit
+lives in `app.quota`.
+"""
+from app import quota
+
+
+class PolicyError(Exception):
+    """Raised when a matched policy's quota is exhausted."""
+
+
+POLICIES = {
+    "POST /records": {"limit": 5, "window": 60, "burst": 0},
+    "GET /export": {"limit": 10, "window": 60, "burst": 2},
+}
+
+
+def match_policy(method, path, policies):
+    """Return the policy dict whose method equals `method` and whose
+    path-prefix is a prefix of `path`, choosing the longest matching
+    prefix. Returns None if nothing matches."""
+    best_prefix_len = -1
+    best_policy = None
+    for key, policy in policies.items():
+        pol_method, _, prefix = key.partition(" ")
+        if pol_method != method:
+            continue
+        if path.startswith(prefix) and len(prefix) > best_prefix_len:
+            best_prefix_len = len(prefix)
+            best_policy = policy
+    return best_policy
+
+
+def key_for(method, path, actor):
+    """The quota key a matched policy hit is recorded under."""
+    return "%s %s:%s" % (method, path, actor)
+
+
+def enforce(method, path, actor, policies):
+    """Apply the policy (if any) matching `method`/`path` for `actor`.
+    Returns None with no hit recorded when nothing matches. Otherwise
+    delegates to `quota.take` and returns the in-window count, raising
+    PolicyError (chained) once the policy's quota is exhausted."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    key = key_for(method, path, actor)
+    try:
+        return quota.take(
+            key, policy["limit"], policy["window"], burst=policy.get("burst", 0)
+        )
+    except quota.QuotaExceededError as exc:
+        raise PolicyError(str(exc)) from exc
+
+
+def remaining_for(method, path, actor, policies):
+    """Read-only: remaining allowance under the matched policy, or None
+    if nothing matches."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    key = key_for(method, path, actor)
+    return quota.remaining(
+        key, policy["limit"], policy["window"], burst=policy.get("burst", 0)
+    )
+
+
+def describe_policies(policies):
+    """Render `policies` as one sorted, human-readable line per key."""
+    if not policies:
+        return "(no policies)"
+    lines = []
+    for key in sorted(policies):
+        p = policies[key]
+        lines.append(
+            "%s: limit=%s, window=%s, burst=%s"
+            % (key, p["limit"], p["window"], p.get("burst", 0))
+        )
+    return "\n".join(lines)
diff --git a/app/tiers.py b/app/tiers.py
new file mode 100644
index 0000000..3dfdc2e
--- /dev/null
+++ b/app/tiers.py
@@ -0,0 +1,61 @@
+"""Actor-tier policy layer over `app.throttle`.
+
+No module state of its own beyond the `TIERS` constant.
+"""
+import copy
+
+from app import throttle
+
+
+class TierError(Exception):
+    """Raised for an unassignable or unknown tier."""
+
+
+TIERS = {
+    "free": {"limit": 2, "window": 60, "burst": 0},
+    "pro": {"limit": 10, "window": 60, "burst": 2},
+    "internal": {"limit": 100, "window": 60, "burst": 10},
+}
+
+_UPGRADE_PATH = {"free": "pro", "pro": "internal", "internal": None}
+
+
+def tier_of(actor, assignments):
+    """The tier name for `actor`, defaulting to "free" if unassigned.
+    Raises TierError (naming both the actor and the bogus tier) if the
+    assigned tier is not in TIERS."""
+    tier = assignments.get(actor, "free")
+    if tier not in TIERS:
+        raise TierError("actor %r assigned unknown tier %r" % (actor, tier))
+    return tier
+
+
+def policy_for(actor, assignments):
+    """A deep copy of `actor`'s tier policy dict."""
+    return copy.deepcopy(TIERS[tier_of(actor, assignments)])
+
+
+def enforce_tier(method, path, actor, assignments):
+    """Apply `actor`'s tier policy to a `method`/`path` call, via
+    `throttle.enforce` under a one-key policies dict."""
+    policies = {"%s %s" % (method, path): policy_for(actor, assignments)}
+    return throttle.enforce(method, path, actor, policies)
+
+
+def remaining_tier(method, path, actor, assignments):
+    """Read-only: remaining allowance under `actor`'s tier policy."""
+    policies = {"%s %s" % (method, path): policy_for(actor, assignments)}
+    return throttle.remaining_for(method, path, actor, policies)
+
+
+def describe_tiers():
+    """Render all TIERS via `throttle.describe_policies`."""
+    return throttle.describe_policies(TIERS)
+
+
+def upgrade_path(tier):
+    """The next tier by allowance, or None for the top tier. Raises
+    TierError (naming the tier) for an unknown tier."""
+    if tier not in TIERS:
+        raise TierError("unknown tier %r" % (tier,))
+    return _UPGRADE_PATH[tier]
diff --git a/tests/test_audit.py b/tests/test_audit.py
new file mode 100644
index 0000000..478e98b
--- /dev/null
+++ b/tests/test_audit.py
@@ -0,0 +1,178 @@
+"""Tests for app/audit.py — the module-global audit log.
+
+Every test calls clear() first: the log is module-global state and tests
+must not leak into each other.
+"""
+from app import audit
+
+
+def test_entries_on_fresh_log_returns_empty_list():
+    audit.clear()
+    assert audit.entries() == []
+
+
+def test_record_appends_exactly_one_entry():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
+
+
+def test_entries_returns_entries_in_call_order():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    audit.record("POST", "/records", "bob", 500)
+    audit.record("DELETE", "/records/1", "carol", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+
+
+def test_entries_returns_a_copy():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    first = audit.entries()
+    first.append({"method": "X", "path": "Y", "actor": "Z"})
+    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
+
+
+def test_cap_keeps_last_n_entries():
+    audit.clear()
+    audit.record("GET", "/a", "u1", 3)
+    audit.record("GET", "/b", "u2", 3)
+    audit.record("GET", "/c", "u3", 3)
+    audit.record("GET", "/d", "u4", 3)
+    assert len(audit.entries()) == 3
+    assert audit.entries() == [
+        {"method": "GET", "path": "/b", "actor": "u2"},
+        {"method": "GET", "path": "/c", "actor": "u3"},
+        {"method": "GET", "path": "/d", "actor": "u4"},
+    ]
+
+
+def test_cap_enforced_on_every_call_not_just_at_the_end():
+    audit.clear()
+    for i in range(5):
+        audit.record("GET", "/p%d" % i, "u%d" % i, 2)
+        assert len(audit.entries()) <= 2
+
+
+def test_dispatch_hook_defaults_actor_to_anonymous():
+    audit.clear()
+    store = object()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(store, config, "GET", "/records", {})
+    entries = audit.entries()
+    assert len(entries) == 1
+    assert entries[0]["actor"] == "anonymous"
+    assert entries[0]["method"] == "GET"
+    assert entries[0]["path"] == "/records"
+
+
+def test_dispatch_hook_uses_actor_kwarg_and_does_not_leak_other_fields():
+    audit.clear()
+    store = object()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(store, config, "POST", "/records", {"actor": "bob", "name": "x"})
+    entries = audit.entries()
+    assert len(entries) == 1
+    assert entries[0]["actor"] == "bob"
+    assert set(entries[0].keys()) == {"method", "path", "actor"}
+
+
+def test_dispatch_hook_reads_cap_from_config():
+    audit.clear()
+    store = object()
+    config = {"audit_log_max_entries": 1}
+    audit.dispatch_hook(store, config, "GET", "/records", {"actor": "a"})
+    audit.dispatch_hook(store, config, "GET", "/records", {"actor": "b"})
+    assert len(audit.entries()) == 1
+
+
+def test_dispatch_hook_fires_for_every_method():
+    audit.clear()
+    store = object()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(store, config, "DELETE", "/records/1", {"actor": "a"})
+    audit.dispatch_hook(store, config, "PUT", "/records/1", {"actor": "b"})
+    entries = audit.entries()
+    assert len(entries) == 2
+    assert entries[0]["method"] == "DELETE"
+    assert entries[1]["method"] == "PUT"
+
+
+def test_record_many_appends_in_order_enforcing_cap_after_every_append():
+    audit.clear()
+    triples = [
+        ("GET", "/a", "u1"),
+        ("GET", "/b", "u2"),
+        ("GET", "/c", "u3"),
+        ("GET", "/d", "u4"),
+    ]
+    seen_max = []
+    original_record = audit.record
+
+    def recording_record(method, path, actor, max_entries):
+        original_record(method, path, actor, max_entries)
+        seen_max.append(len(audit.entries()))
+
+    audit.record = recording_record
+    try:
+        count = audit.record_many(triples, 2)
+    finally:
+        audit.record = original_record
+
+    assert count == 4
+    assert all(n <= 2 for n in seen_max)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/c", "actor": "u3"},
+        {"method": "GET", "path": "/d", "actor": "u4"},
+    ]
+
+
+def test_dropped_counts_evicted_entries_since_last_clear():
+    audit.clear()
+    assert audit.dropped() == 0
+    for i in range(5):
+        audit.record("GET", "/p%d" % i, "u%d" % i, 3)
+    assert audit.dropped() == 2
+    audit.clear()
+    assert audit.dropped() == 0
+
+
+def test_export_state_returns_deep_enough_copy():
+    audit.clear()
+    audit.record("GET", "/a", "u1", 500)
+    state = audit.export_state()
+    assert state == {
+        "entries": [{"method": "GET", "path": "/a", "actor": "u1"}],
+        "dropped": 0,
+    }
+    state["entries"][0]["actor"] = "mutated"
+    state["entries"].append({"method": "X", "path": "Y", "actor": "Z"})
+    assert audit.entries() == [{"method": "GET", "path": "/a", "actor": "u1"}]
+
+
+def test_import_state_round_trip_and_no_leak_from_source_dict():
+    audit.clear()
+    audit.record("GET", "/a", "u1", 500)
+    audit.record("POST", "/b", "u2", 500)
+    for i in range(3):
+        audit.record("GET", "/x%d" % i, "u", 1)
+    state = audit.export_state()
+    expected_entries = audit.entries()
+    expected_dropped = audit.dropped()
+
+    audit.clear()
+    assert audit.entries() == []
+    assert audit.dropped() == 0
+
+    audit.import_state(state)
+    assert audit.entries() == expected_entries
+    assert audit.dropped() == expected_dropped
+
+    state["entries"].append({"method": "X", "path": "Y", "actor": "Z"})
+    state["dropped"] = 999
+    assert audit.entries() == expected_entries
+    assert audit.dropped() == expected_dropped
