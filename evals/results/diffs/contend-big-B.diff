@@ -0,0 +1,95 @@
+"""Tests for app/throttle.py -- a pure policy layer over app/quota.py."""
+import pytest
+
+from app import quota, throttle
+from app.throttle import PolicyError
+
+
+def setup_function(_fn):
+    quota.reset()
+
+
+def test_policy_error_is_an_exception_subclass():
+    assert issubclass(PolicyError, Exception)
+
+
+def test_policies_constant_pinned():
+    assert throttle.POLICIES == {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+
+
+def test_match_policy_longest_prefix_and_method_mismatch():
+    assert throttle.match_policy(
+        "GET", "/export/full", throttle.POLICIES
+    ) == throttle.POLICIES["GET /export"]
+
+    policies = dict(throttle.POLICIES)
+    longer = {"limit": 1, "window": 5, "burst": 0}
+    policies["GET /export/full"] = longer
+    assert throttle.match_policy("GET", "/export/full", policies) == longer
+
+    assert throttle.match_policy("POST", "/export", throttle.POLICIES) is None
+
+
+def test_key_for_exact_format():
+    assert throttle.key_for("POST", "/records", "mallory") == "POST /records:mallory"
+
+
+def test_enforce_no_match_returns_none_and_records_nothing():
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    assert throttle.enforce("GET", "/records", "a", policies) is None
+    # nothing recorded: a subsequent matching enforce still succeeds
+    assert throttle.enforce("POST", "/records", "a", policies) == 1
+
+
+def test_enforce_delegates_to_quota_take(monkeypatch):
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", recorder)
+    policies = {"POST /records": {"limit": 5, "window": 60, "burst": 2}}
+    result = throttle.enforce("POST", "/records", "mallory", policies)
+    assert result == 1
+    assert calls == [
+        (("POST /records:mallory", 5, 60), {"burst": 2})
+    ]
+
+
+def test_enforce_raises_policy_error_when_exhausted():
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    throttle.enforce("POST", "/records", "mallory", policies)
+    with pytest.raises(PolicyError) as exc_info:
+        throttle.enforce("POST", "/records", "mallory", policies)
+    message = str(exc_info.value)
+    assert "mallory" in message
+    assert "1" in message
+
+
+def test_remaining_for_none_when_no_match_and_read_only():
+    policies = {"POST /records": {"limit": 2, "window": 60, "burst": 0}}
+    assert throttle.remaining_for("GET", "/records", "a", policies) is None
+    assert throttle.remaining_for("POST", "/records", "a", policies) == 2
+    assert throttle.remaining_for("POST", "/records", "a", policies) == 2
+    assert throttle.enforce("POST", "/records", "a", policies) == 1
+
+
+def test_describe_policies_exact_literal_and_empty():
+    assert throttle.describe_policies(throttle.POLICIES) == (
+        "GET /export: limit=10, window=60, burst=2\n"
+        "POST /records: limit=5, window=60, burst=0"
+    )
+    assert throttle.describe_policies({}) == "(no policies)"
+
+
+def test_end_to_end_enforce_and_window_recovery():
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    throttle.enforce("POST", "/records", "mallory", policies)
+    with pytest.raises(PolicyError):
+        throttle.enforce("POST", "/records", "mallory", policies)
+    quota.advance(61)
+    throttle.enforce("POST", "/records", "mallory", policies)
