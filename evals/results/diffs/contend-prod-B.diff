--- /dev/null
+++ b/tests/test_schema.py
@@ -0,0 +1,321 @@
+"""Tests for app/schema.py — the declarative validation toolkit."""
+import pytest
+
+from app import schema
+
+
+# --- error catalog --------------------------------------------------------
+
+def test_error_catalog_has_exactly_the_six_codes():
+    assert isinstance(schema.ERROR_CATALOG, dict)
+    assert set(schema.ERROR_CATALOG) == {
+        "missing", "numeric", "non_negative", "max", "non_empty", "type_str",
+    }
+    for template in schema.ERROR_CATALOG.values():
+        assert isinstance(template, str)
+
+
+def test_format_error_missing():
+    assert schema.format_error("missing", field="name") == "missing field: name"
+
+
+def test_format_error_numeric():
+    assert schema.format_error("numeric", field="amount", got="str") == (
+        "field amount must be numeric (got str)")
+
+
+def test_format_error_non_negative():
+    assert schema.format_error("non_negative", field="amount") == (
+        "field amount must be non-negative")
+
+
+def test_format_error_max():
+    assert schema.format_error("max", field="amount", limit=100) == (
+        "field amount exceeds max_amount 100")
+
+
+def test_format_error_non_empty():
+    assert schema.format_error("non_empty", field="name") == (
+        "field name must be a non-empty string")
+
+
+def test_format_error_type_str():
+    assert schema.format_error("type_str", field="name") == (
+        "field name must be a string")
+
+
+def test_format_error_unknown_code_raises_key_error():
+    with pytest.raises(KeyError):
+        schema.format_error("nope")
+
+
+# --- primitives -----------------------------------------------------------
+
+def test_check_required_reports_the_single_missing_field():
+    assert schema.check_required({"amount": 1}, ["name", "amount"]) == ["name"]
+
+
+def test_check_required_uses_required_fields_order_not_dict_order():
+    assert schema.check_required({"note": "n"}, ["name", "amount", "note"]) == [
+        "name", "amount"]
+    # not sorted order either
+    assert schema.check_required({}, ["z", "a"]) == ["z", "a"]
+    # a fields dict whose insertion order disagrees with required order
+    assert schema.check_required({"amount": 1, "name": "x"},
+                                 ["name", "amount"]) == []
+
+
+def test_check_required_returns_empty_list_when_nothing_is_missing():
+    assert schema.check_required({"name": "n", "amount": 1},
+                                 ["name", "amount"]) == []
+
+
+def test_is_valid_amount_accepts_finite_numbers():
+    assert schema.is_valid_amount(0) is True
+    assert schema.is_valid_amount(5) is True
+    assert schema.is_valid_amount(3.5) is True
+
+
+def test_is_valid_amount_rejects_bools_strings_none_and_non_finite_floats():
+    assert schema.is_valid_amount(True) is False
+    assert schema.is_valid_amount(False) is False
+    assert schema.is_valid_amount("3") is False
+    assert schema.is_valid_amount(None) is False
+    assert schema.is_valid_amount(float("nan")) is False
+    assert schema.is_valid_amount(float("inf")) is False
+    assert schema.is_valid_amount(float("-inf")) is False
+
+
+def test_is_valid_amount_handles_huge_ints_without_overflow():
+    # An int is always finite; only floats go through math.isfinite. A naive
+    # math.isfinite(value) on this int raises OverflowError.
+    assert schema.is_valid_amount(10 ** 400) is True
+
+
+def test_is_non_empty_str():
+    assert schema.is_non_empty_str("a") is True
+    assert schema.is_non_empty_str(" a ") is True
+    assert schema.is_non_empty_str("") is False
+    assert schema.is_non_empty_str("   ") is False
+    assert schema.is_non_empty_str(42) is False
+    assert schema.is_non_empty_str(None) is False
+
+
+def test_schema_error_is_a_distinct_exception_subclass():
+    assert issubclass(schema.SchemaError, Exception)
+    assert not issubclass(schema.SchemaError, KeyError)
+    assert not issubclass(schema.SchemaError, ValueError)
+
+
+# --- compile_spec ---------------------------------------------------------
+
+def test_compile_spec_rejects_an_unknown_rule_key():
+    with pytest.raises(ValueError) as exc:
+        schema.compile_spec({"amount": {"minimum": 3}})
+    assert "minimum" in str(exc.value)
+
+
+def test_compile_spec_rejects_an_unknown_type_value():
+    with pytest.raises(ValueError) as exc:
+        schema.compile_spec({"amount": {"type": "integer"}})
+    assert "integer" in str(exc.value)
+
+
+def test_compile_spec_of_an_empty_spec_accepts_any_dict_unchanged():
+    validator = schema.compile_spec({})
+    fields = {"anything": 1, "else": "two"}
+    result = validator(fields)
+    assert result == {"anything": 1, "else": "two"}
+    assert result is not fields
+
+
+def test_validator_checks_required_fields_first_in_spec_order():
+    validator = schema.compile_spec({
+        "name": {"required": True},
+        "amount": {"required": True, "type": "number"},
+    })
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"amount": "not a number"})
+    assert str(exc.value) == "missing field: name"
+
+
+def test_validator_number_type_rejects_bools_strings_and_non_finite():
+    validator = schema.compile_spec({"amount": {"type": "number"}})
+    for bad in (True, "3", float("nan"), float("inf")):
+        with pytest.raises(schema.SchemaError) as exc:
+            validator({"amount": bad})
+        assert str(exc.value) == (
+            "field amount must be numeric (got %s)" % type(bad).__name__)
+
+
+def test_validator_type_str_fires_before_non_empty():
+    validator = schema.compile_spec({"n": {"type": "str", "non_empty": True}})
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"n": 42})
+    assert str(exc.value) == "field n must be a string"
+
+
+def test_validator_non_empty_rule_message():
+    validator = schema.compile_spec({"n": {"non_empty": True}})
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"n": "   "})
+    assert str(exc.value) == "field n must be a non-empty string"
+
+
+def test_validator_max_rule_boundary_and_message():
+    validator = schema.compile_spec({"amount": {"max": 100}})
+    assert validator({"amount": 100}) == {"amount": 100}
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"amount": 101})
+    assert str(exc.value) == "field amount exceeds max_amount 100"
+
+
+def test_max_rule_on_a_non_numeric_value_reports_numeric_not_type_error():
+    spec = {"amount": {"max": 100}}
+    validator = schema.compile_spec(spec)
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"amount": "abc"})
+    assert str(exc.value) == "field amount must be numeric (got str)"
+    assert schema.validate_collect(spec, {"amount": "abc"}) == [
+        "field amount must be numeric (got str)"]
+
+
+def test_validator_strips_non_empty_fields_without_mutating_the_input():
+    validator = schema.compile_spec({
+        "name": {"non_empty": True},
+        "amount": {"type": "number"},
+    })
+    fields = {"name": "  ada  ", "amount": 3}
+    result = validator(fields)
+    assert result == {"name": "ada", "amount": 3}
+    assert fields == {"name": "  ada  ", "amount": 3}
+    assert result is not fields
+
+
+def test_compiled_validator_is_reusable_and_deterministic():
+    validator = schema.compile_spec({"name": {"non_empty": True}})
+    assert validator({"name": " a "}) == validator({"name": " a "})
+    assert validator({"name": " a "}) == {"name": "a"}
+
+
+def test_fields_absent_from_the_spec_pass_through_untouched():
+    validator = schema.compile_spec({"name": {"non_empty": True}})
+    assert validator({"name": "a", "extra": "  kept  "}) == {
+        "name": "a", "extra": "  kept  "}
+
+
+# --- spec algebra ---------------------------------------------------------
+
+def test_merge_specs_unions_fields_and_rules():
+    a = {"name": {"required": True}}
+    b = {"name": {"non_empty": True}, "amount": {"type": "number"}}
+    assert schema.merge_specs(a, b) == {
+        "name": {"required": True, "non_empty": True},
+        "amount": {"type": "number"},
+    }
+    assert a == {"name": {"required": True}}
+    assert b == {"name": {"non_empty": True}, "amount": {"type": "number"}}
+
+
+def test_merge_specs_conflicting_rule_values_raise_naming_field_and_key():
+    with pytest.raises(ValueError) as exc:
+        schema.merge_specs({"amount": {"max": 10}}, {"amount": {"max": 20}})
+    assert "amount" in str(exc.value)
+    assert "max" in str(exc.value)
+    # equal values merge silently
+    assert schema.merge_specs({"amount": {"max": 10}},
+                              {"amount": {"max": 10}}) == {"amount": {"max": 10}}
+
+
+def test_describe_spec_renders_sorted_fields_and_sorted_rule_keys():
+    spec = {"name": {"required": True}, "amount": {"type": "number", "max": 100}}
+    assert schema.describe_spec(spec) == (
+        "amount: max=100, type=number\nname: required=True")
+
+
+def test_describe_spec_of_empty_spec():
+    assert schema.describe_spec({}) == "(empty spec)"
+
+
+def test_diff_specs_reports_added_removed_and_changed():
+    a = {"gone": {"required": True}, "same": {"max": 1}, "moved": {"max": 1}}
+    b = {"same": {"max": 1}, "moved": {"max": 2}, "new": {"type": "str"}}
+    assert schema.diff_specs(a, b) == {
+        "added": ["new"], "removed": ["gone"], "changed": ["moved"]}
+    assert a == {"gone": {"required": True}, "same": {"max": 1},
+                 "moved": {"max": 1}}
+    assert b == {"same": {"max": 1}, "moved": {"max": 2},
+                 "new": {"type": "str"}}
+
+
+def test_diff_specs_of_identical_specs_is_three_empty_lists():
+    spec = {"a": {"max": 1}, "b": {"type": "str"}}
+    assert schema.diff_specs(spec, dict(spec)) == {
+        "added": [], "removed": [], "changed": []}
+
+
+def test_spec_from_config_collects_prefixed_keys_and_compiles():
+    config = {
+        "s_name": {"required": True, "non_empty": True},
+        "s_amount": {"type": "number", "max": 10},
+        "unrelated": "ignored",
+    }
+    spec = schema.spec_from_config(config, "s_")
+    assert spec == {
+        "name": {"required": True, "non_empty": True},
+        "amount": {"type": "number", "max": 10},
+    }
+    validator = schema.compile_spec(spec)
+    assert validator({"name": " ok ", "amount": 10}) == {
+        "name": "ok", "amount": 10}
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"name": "ok", "amount": 11})
+    assert str(exc.value) == "field amount exceeds max_amount 10"
+
+
+def test_spec_to_config_copies_rules_and_round_trips():
+    spec = {"name": {"required": True}, "amount": {"type": "number"}}
+    config = schema.spec_to_config(spec, "s_")
+    assert config == {
+        "s_name": {"required": True}, "s_amount": {"type": "number"}}
+    config["s_name"]["required"] = False
+    assert spec == {"name": {"required": True}, "amount": {"type": "number"}}
+    assert schema.spec_from_config(
+        schema.spec_to_config(spec, "s_"), "s_") == spec
+    source = {"s_name": {"required": True}, "s_amount": {"type": "number"}}
+    assert schema.spec_to_config(
+        schema.spec_from_config(source, "s_"), "s_") == source
+
+
+def test_spec_summary_line():
+    spec = {"name": {"required": True, "non_empty": True},
+            "amount": {"type": "number"}}
+    assert schema.spec_summary_line(spec) == "2 fields, 3 rules"
+    assert schema.spec_summary_line({}) == "0 fields, 0 rules"
+
+
+# --- validate_collect -----------------------------------------------------
+
+def test_validate_collect_returns_all_errors_required_first_then_spec_order():
+    spec = {
+        "name": {"required": True, "non_empty": True},
+        "amount": {"type": "number"},
+        "note": {"non_empty": True},
+    }
+    assert schema.validate_collect(spec, {"amount": "3", "note": "  "}) == [
+        "missing field: name",
+        "field amount must be numeric (got str)",
+        "field note must be a non-empty string",
+    ]
+
+
+def test_validate_collect_reports_at_most_one_message_per_field():
+    spec = {"n": {"type": "str", "non_empty": True}}
+    assert schema.validate_collect(spec, {"n": 42}) == [
+        "field n must be a string"]
+
+
+def test_validate_collect_returns_empty_list_when_clean():
+    spec = {"name": {"required": True, "non_empty": True},
+            "amount": {"type": "number", "max": 10}}
+    assert schema.validate_collect(spec, {"name": "a", "amount": 10}) == []
