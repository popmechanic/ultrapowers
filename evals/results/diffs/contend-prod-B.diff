@@ -0,0 +1,93 @@
+"""Tests for the column-model toolkit `app.tabular`."""
+import pytest
+
+from app import tabular
+
+
+def test_columns_returns_sorted_union_of_all_record_keys():
+    assert tabular.columns([]) == []
+    records = [{"name": "coffee", "amount": 3}, {"note": "x", "name": "tea"}]
+    assert tabular.columns(records) == ["amount", "name", "note"]
+
+
+def test_cell_renders_none_as_empty_and_everything_else_via_str():
+    assert tabular.cell(None) == ""
+    assert tabular.cell(3) == "3"
+    assert tabular.cell(3.5) == "3.5"
+    assert tabular.cell("x") == "x"
+
+
+def test_escape_csv_quotes_only_cells_that_need_it():
+    assert tabular.escape_csv("plain") == "plain"
+    assert tabular.escape_csv("a,b") == '"a,b"'
+    assert tabular.escape_csv('say "hi"') == '"say ""hi"""'
+    assert tabular.escape_csv("line1\nline2") == '"line1\nline2"'
+    assert tabular.escape_csv("") == ""
+
+
+def test_widths_takes_the_max_of_header_and_cell_widths():
+    records = [{"name": "espresso", "amount": 100},
+               {"name": "tea", "amount": 250}]
+    cols = ["amount", "name"]
+    # "amount": header (6) is strictly wider than every cell (3).
+    # "name": the widest cell ("espresso", 8) beats the header (4).
+    assert tabular.widths(records, cols) == {"amount": 6, "name": 8}
+
+
+def test_pad_aligns_never_truncates_and_validates_align_first():
+    assert tabular.pad("ab", 4, "left") == "ab  "
+    assert tabular.pad("ab", 4, "right") == "  ab"
+    assert tabular.pad("abcd", 4, "left") == "abcd"
+    assert tabular.pad("abcde", 4, "left") == "abcde"
+    assert tabular.pad("abcde", 4, "right") == "abcde"
+    with pytest.raises(ValueError) as exc:
+        tabular.pad("abcde", 4, "center")
+    assert "center" in str(exc.value)
+    with pytest.raises(ValueError):
+        tabular.pad("ab", 4, "center")
+
+
+def test_sanitize_flat_replaces_tabs_and_newlines_with_single_spaces():
+    assert tabular.sanitize_flat("a\tb\nc") == "a b c"
+    assert tabular.sanitize_flat("clean value") == "clean value"
+    assert tabular.sanitize_flat(None) == ""
+    assert tabular.sanitize_flat(3) == "3"
+
+
+def test_escape_html_escapes_ampersand_first():
+    assert tabular.escape_html('<a & "b">') == "&lt;a &amp; &quot;b&quot;&gt;"
+    assert tabular.escape_html("clean") == "clean"
+    assert tabular.escape_html(None) == ""
+
+
+def test_truncate_shortens_with_a_marker_and_rejects_tiny_widths():
+    assert tabular.truncate("abc", 5) == "abc"
+    assert tabular.truncate("abcde", 5) == "abcde"
+    assert tabular.truncate("abcdefgh", 5) == "ab..."
+    assert tabular.truncate("abcdefgh", 4, marker="*") == "abc*"
+    with pytest.raises(ValueError):
+        tabular.truncate("abcdefgh", 2)
+
+
+def test_wrap_greedily_wraps_on_spaces_and_hard_splits_long_words():
+    assert tabular.wrap("alpha beta gamma", 11) == ["alpha beta", "gamma"]
+    assert tabular.wrap("alpha beta gamma", 5) == ["alpha", "beta", "gamma"]
+    assert tabular.wrap("abcdefg", 3) == ["abc", "def", "g"]
+    assert tabular.wrap("", 4) == [""]
+    with pytest.raises(ValueError):
+        tabular.wrap("abc", 0)
+
+
+def test_fit_composes_truncate_then_pad():
+    assert tabular.fit("abcdefgh", 5, "left") == "ab..."
+    assert tabular.fit("ab", 5, "left") == "ab   "
+    assert tabular.fit("ab", 5, "right") == "   ab"
+    with pytest.raises(ValueError):
+        tabular.fit("ab", 5, "center")
+
+
+def test_render_row_renders_one_padded_pipe_table_row():
+    assert tabular.render_row(["a", "bb"], [3, 2], "left") == "| a   | bb |"
+    assert tabular.render_row(["a", "bb"], [3, 2], "right") == "|   a | bb |"
+    with pytest.raises(ValueError):
+        tabular.render_row(["a", "bb"], [3], "left")
diff --git a/tests/test_throttle.py b/tests/test_throttle.py
new file mode 100644
index 0000000..655f586
--- /dev/null
+++ b/tests/test_throttle.py
@@ -0,0 +1,105 @@
+"""Tests for the route-policy layer over the quota counter (`app.throttle`).
+
+`throttle` is pure policy: it holds no counters, so every test starts with
+`quota.reset()` to clear the shared clock and hit store.
+"""
+import pytest
+
+from app import quota, throttle
+
+
+def test_policy_error_is_an_exception_subclass():
+    assert issubclass(throttle.PolicyError, Exception)
+
+
+def test_policies_constant_holds_the_shipped_route_policies():
+    assert throttle.POLICIES == {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+
+
+def test_match_policy_picks_the_longest_matching_prefix():
+    quota.reset()
+    policies = {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+    assert throttle.match_policy("GET", "/export/full", policies) == \
+        policies["GET /export"]
+
+    longer = dict(policies)
+    longer["GET /export/full"] = {"limit": 1, "window": 30, "burst": 0}
+    assert throttle.match_policy("GET", "/export/full", longer) == \
+        longer["GET /export/full"]
+
+    assert throttle.match_policy("POST", "/export", policies) is None
+
+
+def test_key_for_renders_method_path_and_actor():
+    assert throttle.key_for("POST", "/records", "mallory") == \
+        "POST /records:mallory"
+
+
+def test_enforce_delegates_to_quota_take_and_ignores_unmatched_routes(monkeypatch):
+    quota.reset()
+    policies = {"POST /records": {"limit": 5, "window": 60, "burst": 0}}
+
+    assert throttle.enforce("DELETE", "/records/1", "mallory", policies) is None
+    # nothing was recorded for the unmatched route
+    assert quota.snapshot(60) == {}
+
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", recorder)
+    assert throttle.enforce("POST", "/records", "mallory", policies) == 1
+    assert calls == [(("POST /records:mallory", 5, 60), {"burst": 0})]
+
+
+def test_enforce_raises_policy_error_when_the_policy_is_exhausted():
+    quota.reset()
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    assert throttle.enforce("POST", "/records", "mallory", policies) == 1
+
+    with pytest.raises(throttle.PolicyError) as excinfo:
+        throttle.enforce("POST", "/records", "mallory", policies)
+    message = str(excinfo.value)
+    assert "POST /records:mallory" in message
+    assert "1" in message
+    assert isinstance(excinfo.value.__cause__, quota.QuotaExceededError)
+
+
+def test_remaining_for_reads_the_policy_allowance_without_recording():
+    quota.reset()
+    policies = {"POST /records": {"limit": 2, "window": 60, "burst": 0}}
+    assert throttle.remaining_for("GET", "/records", "mallory", policies) is None
+
+    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 2
+    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 2
+    assert throttle.enforce("POST", "/records", "mallory", policies) == 1
+    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 1
+    assert throttle.enforce("POST", "/records", "mallory", policies) == 2
+    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 0
+
+
+def test_describe_policies_renders_sorted_lines():
+    assert throttle.describe_policies(throttle.POLICIES) == (
+        "GET /export: limit=10, window=60, burst=2\n"
+        "POST /records: limit=5, window=60, burst=0"
+    )
+    assert throttle.describe_policies({}) == "(no policies)"
+
+
+def test_enforce_frees_the_key_once_the_window_elapses():
+    quota.reset()
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    assert throttle.enforce("POST", "/records", "mallory", policies) == 1
+    with pytest.raises(throttle.PolicyError):
+        throttle.enforce("POST", "/records", "mallory", policies)
+
+    quota.advance(61)
+    assert throttle.enforce("POST", "/records", "mallory", policies) == 1
