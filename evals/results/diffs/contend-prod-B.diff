diff --git a/app/audit.py b/app/audit.py
new file mode 100644
index 0000000..3df8772
--- /dev/null
+++ b/app/audit.py
@@ -0,0 +1,79 @@
+"""Audit log of every dispatched call.
+
+`dispatch_hook` is registered into `app.registry.DISPATCH_HOOKS` and runs
+on every dispatch regardless of HTTP method -- unlike rate limiting, the
+audit log does not special-case which methods it logs. It is unconditional:
+`audit_log_enabled` in the config is recorded for a future on/off switch
+but is not read by any code in this plan.
+
+The log is module-global state: a bounded list of entries plus a running
+count of how many entries have been evicted by the cap since the last
+`clear()`. Each entry is a plain dict with exactly the keys `method`,
+`path`, and `actor`.
+"""
+
+_log = []
+_dropped = 0
+
+
+def clear():
+    """Reset the log and the dropped counter."""
+    global _log, _dropped
+    _log = []
+    _dropped = 0
+
+
+def entries():
+    """Return a copy of the log, oldest first."""
+    return list(_log)
+
+
+def dropped():
+    """Number of entries evicted by the cap since the last clear()."""
+    return _dropped
+
+
+def record(method, path, actor, max_entries):
+    """Append one entry and enforce the cap, dropping the oldest entry
+    first if the log is now over `max_entries`."""
+    global _dropped
+    _log.append({"method": method, "path": path, "actor": actor})
+    while len(_log) > max_entries:
+        _log.pop(0)
+        _dropped += 1
+
+
+def record_many(triples, max_entries):
+    """Append each (method, path, actor) triple in order, enforcing the
+    cap after every append. Returns the number appended."""
+    for method, path, actor in triples:
+        record(method, path, actor, max_entries)
+    return len(triples)
+
+
+def export_state():
+    """Return {"entries": entries(), "dropped": dropped()} -- a deep-enough
+    copy that mutating the returned entries (the list or its dicts) never
+    affects the live log."""
+    return {"entries": [dict(entry) for entry in _log], "dropped": dropped()}
+
+
+def import_state(state):
+    """Replace the log and dropped counter from an export_state()-shaped
+    dict. Copies its input so later mutations of `state` do not leak into
+    the live log."""
+    global _log, _dropped
+    _log = [dict(entry) for entry in state["entries"]]
+    _dropped = state["dropped"]
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS entry point: log every dispatched call.
+
+    The actor is taken from kwargs["actor"] if present, else "anonymous".
+    Only method/path/actor are ever logged -- other kwargs (e.g. record
+    fields on create) never leak into the audit entry.
+    """
+    actor = kwargs.get("actor", "anonymous")
+    max_entries = config.get("audit_log_max_entries", 500)
+    record(method, path, actor, max_entries)
diff --git a/app/audit_query.py b/app/audit_query.py
new file mode 100644
index 0000000..7def98e
--- /dev/null
+++ b/app/audit_query.py
@@ -0,0 +1,262 @@
+"""Pure read-side queries over audit entry lists.
+
+Every function here takes `entries` as a plain list argument -- this
+module never imports `app.audit` and never mutates its inputs. Each entry
+is expected to be a dict with (at least) the keys `method`, `path`, and
+`actor`.
+"""
+
+_FIELDS = ("method", "path", "actor")
+
+
+def _check_field(field):
+    if field not in _FIELDS:
+        raise ValueError("unknown field: %s" % field)
+
+
+def filter_entries(entries, actor=None, method=None, path=None):
+    """Return the entries matching all given criteria (AND), in order, as
+    a fresh list."""
+    result = []
+    for entry in entries:
+        if actor is not None and entry["actor"] != actor:
+            continue
+        if method is not None and entry["method"] != method:
+            continue
+        if path is not None and entry["path"] != path:
+            continue
+        result.append(entry)
+    return list(result)
+
+
+def counts_by(entries, field):
+    """Return {value: count} over `field` ('method', 'path', or
+    'actor')."""
+    _check_field(field)
+    counts = {}
+    for entry in entries:
+        value = entry[field]
+        counts[value] = counts.get(value, 0) + 1
+    return counts
+
+
+def counts_matrix(entries):
+    """Return the nested dict method -> actor -> count. Only combinations
+    that occur appear (no zero-filled cells)."""
+    matrix = {}
+    for entry in entries:
+        method = entry["method"]
+        actor = entry["actor"]
+        by_actor = matrix.setdefault(method, {})
+        by_actor[actor] = by_actor.get(actor, 0) + 1
+    return matrix
+
+
+def rollup(entries, fields):
+    """Generalized counts_by/counts_matrix: nest counts by each field in
+    `fields`, in order. `fields` must be a non-empty list of distinct
+    names drawn from method/path/actor."""
+    if not fields:
+        raise ValueError("fields must be non-empty")
+    if len(set(fields)) != len(fields):
+        raise ValueError("fields must not contain duplicates")
+    for field in fields:
+        _check_field(field)
+
+    result = {}
+    for entry in entries:
+        node = result
+        for field in fields[:-1]:
+            node = node.setdefault(entry[field], {})
+        last_field = fields[-1]
+        value = entry[last_field]
+        node[value] = node.get(value, 0) + 1
+    return result
+
+
+def last_n(entries, n):
+    """Return the final `n` entries, in order, as a fresh list."""
+    if n < 0:
+        raise ValueError("n must not be negative")
+    if n == 0:
+        return []
+    return list(entries[-n:])
+
+
+def redact(entries, fields):
+    """Return new entry dicts with each field in `fields` replaced by
+    '***'; other keys are untouched. Originals are never mutated."""
+    for field in fields:
+        _check_field(field)
+    result = []
+    for entry in entries:
+        copy = dict(entry)
+        for field in fields:
+            copy[field] = "***"
+        result.append(copy)
+    return result
+
+
+def summary(entries):
+    """Return {"total", "by_method", "by_actor", "first", "last"}."""
+    if not entries:
+        return {
+            "total": 0,
+            "by_method": {},
+            "by_actor": {},
+            "first": None,
+            "last": None,
+        }
+    return {
+        "total": len(entries),
+        "by_method": counts_by(entries, "method"),
+        "by_actor": counts_by(entries, "actor"),
+        "first": dict(entries[0]),
+        "last": dict(entries[-1]),
+    }
+
+
+def recent(entries, config):
+    """The last config["audit_query_default_limit"] entries."""
+    return last_n(entries, config["audit_query_default_limit"])
+
+
+def paginate(entries, page, per_page):
+    """1-based pagination: {"page", "pages", "total", "items"}."""
+    if page < 1:
+        raise ValueError("page must be >= 1")
+    if per_page < 1:
+        raise ValueError("per_page must be >= 1")
+    total = len(entries)
+    pages = (total + per_page - 1) // per_page if total else 0
+    start = (page - 1) * per_page
+    items = list(entries[start:start + per_page])
+    return {"page": page, "pages": pages, "total": total, "items": items}
+
+
+def _sorted_lines(entries, field, prefix, fmt):
+    counts = counts_by(entries, field)
+    lines = []
+    for value in sorted(counts):
+        lines.append(fmt % (prefix, value, counts[value]))
+    return lines
+
+
+def to_report(entries):
+    """Exact plain-text report: title, total, then alphabetically-sorted
+    per-method and per-actor count sections (omitted entirely when
+    empty)."""
+    lines = ["audit report", "total: %d" % len(entries)]
+    if not entries:
+        return "\n".join(lines)
+    method_counts = counts_by(entries, "method")
+    actor_counts = counts_by(entries, "actor")
+    lines.append("")
+    lines.append("by method:")
+    for method in sorted(method_counts):
+        lines.append("  %s: %d" % (method, method_counts[method]))
+    lines.append("")
+    lines.append("by actor:")
+    for actor in sorted(actor_counts):
+        lines.append("  %s: %d" % (actor, actor_counts[actor]))
+    return "\n".join(lines)
+
+
+def to_csv_report(entries):
+    """Exact CSV report: header row, then one row per method (sorted),
+    then one row per actor (sorted)."""
+    lines = ["field,value,count"]
+    method_counts = counts_by(entries, "method")
+    actor_counts = counts_by(entries, "actor")
+    for method in sorted(method_counts):
+        lines.append("method,%s,%d" % (method, method_counts[method]))
+    for actor in sorted(actor_counts):
+        lines.append("actor,%s,%d" % (actor, actor_counts[actor]))
+    return "\n".join(lines)
+
+
+def to_markdown_report(entries):
+    """Exact pipe-table report matching to_csv_report's row order."""
+    lines = ["| field | value | count |", "| --- | --- | --- |"]
+    method_counts = counts_by(entries, "method")
+    actor_counts = counts_by(entries, "actor")
+    for method in sorted(method_counts):
+        lines.append("| method | %s | %d |" % (method, method_counts[method]))
+    for actor in sorted(actor_counts):
+        lines.append("| actor | %s | %d |" % (actor, actor_counts[actor]))
+    return "\n".join(lines)
+
+
+def top_actors(entries, n):
+    """List of (actor, count) sorted by count desc, ties broken by actor
+    ascending, truncated to `n`."""
+    if n < 0:
+        raise ValueError("n must not be negative")
+    counts = counts_by(entries, "actor")
+    ordered = sorted(counts.items(), key=lambda pair: (-pair[1], pair[0]))
+    return ordered[:n]
+
+
+def merge_entries(*entry_lists):
+    """Concatenate the given entry lists (in argument order) into one new
+    list of copies."""
+    result = []
+    for entry_list in entry_lists:
+        for entry in entry_list:
+            result.append(dict(entry))
+    return result
+
+
+def diff_summaries(a, b):
+    """Diff two summary() dicts: total delta plus per-value deltas for
+    values whose count changed (absent on one side counts as 0; unchanged
+    values are omitted)."""
+
+    def _diff(a_counts, b_counts):
+        diff = {}
+        for key in set(a_counts) | set(b_counts):
+            delta = b_counts.get(key, 0) - a_counts.get(key, 0)
+            if delta != 0:
+                diff[key] = delta
+        return diff
+
+    return {
+        "total": b["total"] - a["total"],
+        "by_method": _diff(a["by_method"], b["by_method"]),
+        "by_actor": _diff(a["by_actor"], b["by_actor"]),
+    }
+
+
+def format_entry(entry):
+    """Exact '<METHOD> <path> (<actor>)' rendering of one entry; raises
+    ValueError naming the missing key if method/path/actor is absent."""
+    for field in _FIELDS:
+        if field not in entry:
+            raise ValueError("missing field: %s" % field)
+    return "%s %s (%s)" % (entry["method"], entry["path"], entry["actor"])
+
+
+def to_lines(entries):
+    """format_entry() for every entry, in order."""
+    return [format_entry(entry) for entry in entries]
+
+
+def group_by(entries, field):
+    """{value: [matching entry copies in original order]}."""
+    _check_field(field)
+    result = {}
+    for entry in entries:
+        result.setdefault(entry[field], []).append(dict(entry))
+    return result
+
+
+def search(entries, needle):
+    """Entry copies where `needle` is a substring of any of the three
+    field values, in original order."""
+    if not needle:
+        raise ValueError("needle must not be empty")
+    result = []
+    for entry in entries:
+        if any(needle in entry[field] for field in _FIELDS):
+            result.append(dict(entry))
+    return result
diff --git a/app/export.py b/app/export.py
new file mode 100644
index 0000000..087d445
--- /dev/null
+++ b/app/export.py
@@ -0,0 +1,202 @@
+"""Export/report formatter: CSV/JSON/Markdown/NDJSON/TSV/HTML renderers over
+a list of record dicts, plus a CSV parser and the format lookup tables the
+registry's pre-wired /export route reads.
+
+Every renderer builds its column model and cells through `app.tabular` —
+no duplicated key-union, escaping, or str() logic lives here.
+"""
+import json
+
+from app import tabular
+
+
+def to_csv(records):
+    """Header row of every field name across ALL records, sorted
+    alphabetically, then one row per record in input order. A missing
+    field on a given record renders as an empty cell."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = [",".join(tabular.escape_csv(c) for c in cols)]
+    for record in records:
+        lines.append(",".join(tabular.escape_csv(record.get(c)) for c in cols))
+    return "\n".join(lines)
+
+
+def to_json(records):
+    """Round-trips through json.loads back to the same list of dicts, with
+    sorted keys."""
+    return json.dumps(records, sort_keys=True)
+
+
+def to_markdown(records, align="left"):
+    """Pipe table: header row of sorted column names, a separator row, then
+    one row per record. Every cell padded to its tabular.widths column
+    width. `align` is "left" (default, "---" separator) or "right" ("--:"
+    style separator); any other value raises ValueError, delegated to
+    tabular.pad via tabular.render_row."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    col_widths = tabular.widths(records, cols)
+    widths_list = [col_widths[c] for c in cols]
+
+    header_line = tabular.render_row(cols, widths_list, align)
+    if align == "right":
+        sep_cells = ["-" * (width - 1) + ":" for width in widths_list]
+    else:
+        sep_cells = ["-" * width for width in widths_list]
+    sep_line = "| " + " | ".join(sep_cells) + " |"
+
+    lines = [header_line, sep_line]
+    for record in records:
+        cells = [tabular.cell(record.get(c)) for c in cols]
+        lines.append(tabular.render_row(cells, widths_list, align))
+    return "\n".join(lines)
+
+
+def to_ndjson(records):
+    """One JSON object per line (sort_keys=True), no trailing newline."""
+    if not records:
+        return ""
+    return "\n".join(json.dumps(r, sort_keys=True) for r in records)
+
+
+def to_tsv(records):
+    """Sorted-column header then one tab-joined row per record; every cell
+    and every header name passed through tabular.sanitize_flat."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = ["\t".join(tabular.sanitize_flat(c) for c in cols)]
+    for record in records:
+        lines.append("\t".join(tabular.sanitize_flat(record.get(c)) for c in cols))
+    return "\n".join(lines)
+
+
+def to_html(records):
+    """"<table>", a header row of <th> sorted column names, one <tr> of
+    <td> per record in input order (missing fields as empty <td></td>),
+    and "</table>", newline-joined. Every cell and header passed through
+    tabular.escape_html."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = ["<table>"]
+    header_cells = "".join("<th>%s</th>" % tabular.escape_html(c) for c in cols)
+    lines.append("<tr>%s</tr>" % header_cells)
+    for record in records:
+        row_cells = "".join(
+            "<td>%s</td>" % tabular.escape_html(record.get(c)) for c in cols
+        )
+        lines.append("<tr>%s</tr>" % row_cells)
+    lines.append("</table>")
+    return "\n".join(lines)
+
+
+def _parse_csv_rows(text):
+    """Tokenize CSV text into a list of rows (each a list of field
+    strings), honoring quoted cells (embedded commas/newlines, doubled
+    quotes). Raises ValueError on an unterminated quote."""
+    rows = []
+    row = []
+    field_chars = []
+    in_quotes = False
+    i = 0
+    n = len(text)
+    while i < n:
+        char = text[i]
+        if in_quotes:
+            if char == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    field_chars.append('"')
+                    i += 2
+                    continue
+                in_quotes = False
+                i += 1
+                continue
+            field_chars.append(char)
+            i += 1
+            continue
+        if char == '"':
+            in_quotes = True
+            i += 1
+            continue
+        if char == ",":
+            row.append("".join(field_chars))
+            field_chars = []
+            i += 1
+            continue
+        if char == "\r":
+            i += 1
+            continue
+        if char == "\n":
+            row.append("".join(field_chars))
+            field_chars = []
+            rows.append(row)
+            row = []
+            i += 1
+            continue
+        field_chars.append(char)
+        i += 1
+
+    if in_quotes:
+        raise ValueError("unterminated quote in CSV input")
+
+    row.append("".join(field_chars))
+    rows.append(row)
+    return rows
+
+
+def parse_csv(text):
+    """Inverse of to_csv: the first line is the header, each further line
+    yields a dict of header -> cell string (values are never re-typed)."""
+    if text == "":
+        return []
+    rows = _parse_csv_rows(text)
+    if len(rows) < 2:
+        return []
+    header = rows[0]
+    records = []
+    for row in rows[1:]:
+        record = {}
+        for idx, key in enumerate(header):
+            record[key] = row[idx] if idx < len(row) else ""
+        records.append(record)
+    return records
+
+
+FORMATS = {
+    "csv": to_csv,
+    "json": to_json,
+    "md": to_markdown,
+    "ndjson": to_ndjson,
+    "tsv": to_tsv,
+}
+
+EXTRA_FORMATS = {
+    "html": to_html,
+}
+
+
+def render(records, fmt):
+    """Delegate to the matching FORMATS function; unknown fmt raises
+    ValueError naming it."""
+    if fmt not in FORMATS:
+        raise ValueError("unknown export format: %s" % fmt)
+    return FORMATS[fmt](records)
+
+
+def render_any(records, fmt):
+    """Serve FORMATS first, then EXTRA_FORMATS; unknown fmt raises
+    ValueError naming it."""
+    if fmt in FORMATS:
+        return FORMATS[fmt](records)
+    if fmt in EXTRA_FORMATS:
+        return EXTRA_FORMATS[fmt](records)
+    raise ValueError("unknown export format: %s" % fmt)
+
+
+def summary_line(records):
+    """"<N> records, <M> columns" with M from tabular.columns."""
+    return "%d records, %d columns" % (len(records), len(tabular.columns(records)))
diff --git a/app/quota.py b/app/quota.py
new file mode 100644
index 0000000..98de2c9
--- /dev/null
+++ b/app/quota.py
@@ -0,0 +1,140 @@
+"""A windowed hit-counter with a module-global logical clock.
+
+No wall-clock time is used anywhere: the clock is a float advanced only
+via `advance()`, making all quota behavior deterministic under test. This
+module keeps two pieces of module-global state: `_clock` (the current
+logical time) and `_hits` (a dict mapping key -> list of hit timestamps).
+
+`app/ratelimit.py` delegates its per-key counting to this module; it keeps
+no counter state of its own.
+"""
+import copy
+
+
+class QuotaExceededError(Exception):
+    pass
+
+
+_clock = 0.0
+_hits = {}
+
+
+def reset():
+    """Clear the logical clock back to 0.0 and drop every key's hits."""
+    global _clock, _hits
+    _clock = 0.0
+    _hits = {}
+
+
+def now():
+    """Return the current logical clock value."""
+    return _clock
+
+
+def advance(seconds):
+    """Advance the logical clock by `seconds` (must be >= 0) and return the
+    new clock value. Raises ValueError, leaving the clock unchanged, if
+    `seconds` would move the clock backwards."""
+    global _clock
+    if seconds < 0:
+        raise ValueError("clock is monotonic: advance() cannot go backwards")
+    _clock += seconds
+    return _clock
+
+
+def _prune(key, window_seconds):
+    """Drop hits for `key` strictly older than now - window_seconds."""
+    if window_seconds == float("inf"):
+        return
+    cutoff = _clock - window_seconds
+    hits = _hits.get(key)
+    if hits is None:
+        return
+    kept = [h for h in hits if h >= cutoff]
+    if kept:
+        _hits[key] = kept
+    else:
+        _hits.pop(key, None)
+
+
+def take(key, limit, window_seconds, burst=0):
+    """Record a hit for `key` if the in-window count is under `limit +
+    burst`, and return the new in-window count. Raises QuotaExceededError
+    (message contains the key and the limit) if the allowance is
+    exhausted."""
+    _prune(key, window_seconds)
+    hits = _hits.setdefault(key, [])
+    allowed = limit + burst
+    if len(hits) >= allowed:
+        raise QuotaExceededError(
+            "quota exceeded for key=%r (limit=%s)" % (key, limit)
+        )
+    hits.append(_clock)
+    return len(hits)
+
+
+def remaining(key, limit, window_seconds, burst=0):
+    """Return how many takes are left for `key` right now, without
+    recording a hit. Floors at 0."""
+    _prune(key, window_seconds)
+    hits = _hits.get(key, [])
+    allowed = limit + burst
+    left = allowed - len(hits)
+    return left if left > 0 else 0
+
+
+def snapshot(window_seconds):
+    """Return a dict mapping each key with at least one in-window hit to
+    the sorted list of its in-window hit timestamps. A deep copy: mutating
+    the returned lists never affects later readings."""
+    result = {}
+    for key in list(_hits):
+        _prune(key, window_seconds)
+        hits = _hits.get(key)
+        if hits:
+            result[key] = sorted(hits)
+    return copy.deepcopy(result)
+
+
+def time_to_next_slot(key, limit, window_seconds, burst=0):
+    """Return the number of seconds until a slot frees for `key`. 0.0 if a
+    slot is available now. float('inf') if the window never prunes, or if
+    the allowance is zero (no hit can ever be recorded, so no hit can ever
+    free a slot). Read-only."""
+    allowed = limit + burst
+    if allowed <= 0:
+        return float("inf")
+    if remaining(key, limit, window_seconds, burst) > 0:
+        return 0.0
+    if window_seconds == float("inf"):
+        return float("inf")
+    hits = _hits.get(key, [])
+    if not hits:
+        return 0.0
+    oldest = min(hits)
+    return oldest + window_seconds - _clock
+
+
+def usage(key, limit, window_seconds, burst=0):
+    """Return {"used", "allowed", "remaining", "reset_in"} for `key`.
+    Read-only."""
+    _prune(key, window_seconds)
+    hits = _hits.get(key, [])
+    return {
+        "used": len(hits),
+        "allowed": limit + burst,
+        "remaining": remaining(key, limit, window_seconds, burst),
+        "reset_in": time_to_next_slot(key, limit, window_seconds, burst),
+    }
+
+
+def purge(window_seconds):
+    """Drop every key's aged-out hits, removing keys left with none.
+    Returns the total number of hits dropped."""
+    dropped = 0
+    for key in list(_hits):
+        before = len(_hits.get(key, []))
+        _prune(key, window_seconds)
+        after = len(_hits.get(key, []))
+        dropped += before - after
+    return dropped
