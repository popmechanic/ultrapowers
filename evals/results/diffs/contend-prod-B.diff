+    assert errors == [
+        (1, "missing field: name"),
+        (3, "field amount must be non-negative"),
+    ]
+    # inputs unmutated
+    assert entries == [
+        {"name": "a", "amount": 1},
+        {"amount": 1},
+        {"name": "b", "amount": 2},
+        {"name": "c", "amount": -1},
