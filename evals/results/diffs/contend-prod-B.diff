+def test_exact_messages_come_from_the_catalog():
+    def message(fields):
+        with pytest.raises(validation.ValidationError) as exc:
+            validation.validate_fields(fields, REQUIRED, MAX)
+        return str(exc.value)
+
+    assert message({"amount": 1}) == "missing field: name"
+    assert message({"name": "ada", "amount": True}) == (
+        "field amount must be numeric (got bool)")
+    assert message({"name": "ada", "amount": -1}) == (
+        "field amount must be non-negative")
+    assert message({"name": "ada", "amount": 101}) == (
+        "field amount exceeds max_amount 100")
+    assert message({"name": "", "amount": 1}) == (
+        "field name must be a non-empty string")
