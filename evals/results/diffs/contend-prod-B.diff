+
+def test_check_required_order_follows_required_fields_not_dict_order():
+    # dict insertion order disagrees with required_fields order
+    fields = {"zzz": 1}
+    assert check_required(fields, ["amount", "name"]) == ["amount", "name"]
+
+
+def test_is_valid_amount_true_cases():
+    assert is_valid_amount(0) is True
+    assert is_valid_amount(5) is True
+    assert is_valid_amount(3.5) is True
+
+
+def test_is_valid_amount_false_cases():
+    assert is_valid_amount(True) is False
+    assert is_valid_amount(False) is False
+    assert is_valid_amount("3") is False
+    assert is_valid_amount(None) is False
+    assert is_valid_amount(float("nan")) is False
+    assert is_valid_amount(float("inf")) is False
+    assert is_valid_amount(float("-inf")) is False
+
+
+def test_is_valid_amount_huge_int_does_not_raise_overflow():
+    # A naive implementation piping every value through math.isfinite
+    # raises OverflowError converting a too-large int to float.
+    assert is_valid_amount(10 ** 400) is True
+
+
+def test_is_non_empty_str():
+    assert is_non_empty_str("a") is True
+    assert is_non_empty_str(" a ") is True
+    assert is_non_empty_str("") is False
+    assert is_non_empty_str("   ") is False
+    assert is_non_empty_str(42) is False
+    assert is_non_empty_str(None) is False
+
+
+def test_schema_error_is_exception_subclass_distinct_from_others():
+    assert issubclass(SchemaError, Exception)
+    assert not issubclass(SchemaError, KeyError)
+    assert not issubclass(SchemaError, ValueError)
+
+
+def test_compile_spec_rejects_unknown_rule_key():
+    with pytest.raises(ValueError, match="bogus"):
+        compile_spec({"name": {"bogus": True}})
+
+
+def test_compile_spec_rejects_unknown_type_value():
+    with pytest.raises(ValueError, match="int"):
+        compile_spec({"amount": {"type": "int"}})
