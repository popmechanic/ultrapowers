@@ -0,0 +1,225 @@
+"""Tests for app/validation.py — the input-validation layer."""
+import pytest
+
+from app import schema, validation
+
+
+REQUIRED = ["name", "amount"]
+MAX = 100
+
+
+def test_validation_error_is_an_exception_subclass():
+    assert issubclass(validation.ValidationError, Exception)
+
+
+def test_missing_name_names_the_field():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"amount": 1}, REQUIRED, MAX)
+    assert "name" in str(exc.value)
+
+
+def test_missing_amount_and_both_missing_reports_required_order():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"name": "ada"}, REQUIRED, MAX)
+    assert str(exc.value) == "missing field: amount"
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({}, REQUIRED, MAX)
+    assert str(exc.value) == "missing field: name"
+
+
+def test_string_amount_is_not_numeric():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"name": "ada", "amount": "3"}, REQUIRED, MAX)
+    assert "numeric" in str(exc.value)
+
+
+def test_bool_amount_is_not_numeric():
+    for value in (True, False):
+        with pytest.raises(validation.ValidationError) as exc:
+            validation.validate_fields(
+                {"name": "ada", "amount": value}, REQUIRED, MAX)
+        assert "numeric" in str(exc.value)
+
+
+def test_negative_amount_is_rejected_and_zero_is_accepted():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"name": "ada", "amount": -1}, REQUIRED, MAX)
+    assert "non-negative" in str(exc.value)
+    assert validation.validate_fields(
+        {"name": "ada", "amount": 0}, REQUIRED, MAX) == {
+            "name": "ada", "amount": 0}
+
+
+def test_amount_above_max_is_rejected_and_the_boundary_is_accepted():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields(
+            {"name": "ada", "amount": MAX + 1}, REQUIRED, MAX)
+    assert "max_amount" in str(exc.value)
+    assert validation.validate_fields(
+        {"name": "ada", "amount": MAX}, REQUIRED, MAX) == {
+            "name": "ada", "amount": MAX}
+
+
+def test_empty_whitespace_and_non_string_names_are_rejected():
+    for bad in ("", "   ", 42):
+        with pytest.raises(validation.ValidationError) as exc:
+            validation.validate_fields(
+                {"name": bad, "amount": 1}, REQUIRED, MAX)
+        assert "non-empty string" in str(exc.value)
+
+
+def test_success_returns_a_new_dict_with_a_stripped_name():
+    fields = {"name": "  ada  ", "amount": 3, "category": "books"}
+    result = validation.validate_fields(fields, REQUIRED, MAX)
+    assert result == {"name": "ada", "amount": 3, "category": "books"}
+    assert fields == {"name": "  ada  ", "amount": 3, "category": "books"}
+    assert result is not fields
+
+
+def test_extra_keys_pass_through_untouched():
+    fields = {"name": "ada", "amount": 1, "extra": "  kept  ", "n": None}
+    assert validation.validate_fields(fields, REQUIRED, MAX) == {
+        "name": "ada", "amount": 1, "extra": "  kept  ", "n": None}
+
+
+def test_pre_create_hook_reads_the_config_keys():
+    config = {"validation_required_fields": REQUIRED,
+              "validation_max_amount": MAX}
+    assert validation.pre_create_hook(
+        None, config, {"name": " ada ", "amount": 5}) == {
+            "name": "ada", "amount": 5}
+    with pytest.raises(validation.ValidationError) as hook_exc:
+        validation.pre_create_hook(None, config, {"name": "ada", "amount": 101})
+    with pytest.raises(validation.ValidationError) as direct_exc:
+        validation.validate_fields({"name": "ada", "amount": 101}, REQUIRED, MAX)
+    assert str(hook_exc.value) == str(direct_exc.value)
+
