diff --git a/app/rules.py b/app/rules.py
new file mode 100644
index 0000000..6e7fa56
--- /dev/null
+++ b/app/rules.py
@@ -0,0 +1,127 @@
+"""Rule combinators: a pure, composable layer over app.schema's predicates.
+
+A *rule* is a plain dict `{"name": str, "test": callable}`. Rules compose
+into named composites (`all_of`, `any_of`, `negate`, `when`) whose names
+render the tree they were built from, so a failure report can name the
+exact rule that rejected a value.
+
+The builtin rules delegate to `app.schema` at call time — this module never
+reimplements a predicate that already exists there.
+"""
+from app import schema
+
+
+class RuleError(Exception):
+    """Raised when a rule is applied in a way its definition forbids."""
+
+
+def rule(name, predicate):
+    """A named rule. `name` must be a non-empty string."""
+    if not isinstance(name, str) or not name:
+        raise ValueError("rule name must be a non-empty string: %r" % (name,))
+    return {"name": name, "test": predicate}
+
+
+def check(value, r):
+    """Run rule `r` against `value`, coerced to a bool."""
+    return bool(r["test"](value))
+
+
+def _joined(children):
+    return ",".join(child["name"] for child in children)
+
+
+def all_of(*children):
+    """A rule passing iff every child passes. `all_of()` passes everything."""
+    return rule("all(%s)" % _joined(children),
+                lambda value: all(check(value, c) for c in children))
+
+
+def any_of(*children):
+    """A rule passing iff at least one child passes. No children is a bug,
+    not a policy: a vacuous `any` would reject every value."""
+    if not children:
+        raise ValueError("any_of requires at least one rule")
+    return rule("any(%s)" % _joined(children),
+                lambda value: any(check(value, c) for c in children))
+
+
+def negate(r):
+    """A rule passing exactly when `r` fails."""
+    return rule("not(%s)" % r["name"], lambda value: not check(value, r))
+
+
+def when(cond, then):
+    """Material implication: passes when `cond` fails or `then` passes."""
+    return rule("when(%s,%s)" % (cond["name"], then["name"]),
+                lambda value: (not check(value, cond)) or check(value, then))
+
+
+def explain(value, r):
+    """"<rule name>: pass" or "<rule name>: fail"."""
+    return "%s: %s" % (r["name"], "pass" if check(value, r) else "fail")
+
+
+def apply_rules(fields, rules_by_field):
+    """Failure messages for `fields`, in `rules_by_field` insertion order.
+    Fields absent from `fields` are skipped; `fields` is never mutated."""
+    return ["field %s failed %s" % (field, r["name"])
+            for field, r in rules_by_field.items()
+            if field in fields and not check(fields[field], r)]
+
+
+def first_failure(fields, rules_by_field):
+    """The (field, rule name) of the first failure in insertion order."""
+    for field, r in rules_by_field.items():
+        if field in fields and not check(fields[field], r):
+            return (field, r["name"])
+    return None
+
+
+def explain_failures(fields, rules_by_field):
+    """`explain` lines for the failing fields only, in insertion order."""
+    return [explain(fields[field], r)
+            for field, r in rules_by_field.items()
+            if field in fields and not check(fields[field], r)]
+
+
+BUILTINS = {
+    "number": rule("number", lambda value: schema.is_valid_amount(value)),
+    "str": rule("str", lambda value: isinstance(value, str)),
+    "non_empty": rule("non_empty", lambda value: schema.is_non_empty_str(value)),
+}
+
+
+def parse_rule(text):
+    """Parse a `&`-joined list of builtin names into a single rule. One
+    token yields that builtin; several yield an `all_of` in text order."""
+    tokens = [token.strip() for token in text.split("&")]
+    if text.strip() == "":
+        raise ValueError("empty rule text")
+    for token in tokens:
+        if token not in BUILTINS:
+            raise ValueError("unknown rule token: %s" % token)
+    if len(tokens) == 1:
+        return BUILTINS[tokens[0]]
+    return all_of(*[BUILTINS[token] for token in tokens])
+
+
+def parse_rules(text_by_field):
+    """`parse_rule` every value, keeping insertion order. An unknown token
+    is reported with both the field and the token."""
+    parsed = {}
+    for field, text in text_by_field.items():
+        try:
+            parsed[field] = parse_rule(text)
+        except ValueError as err:
+            raise ValueError("field %s: %s" % (field, err))
+    return parsed
+
+
+def describe_rules(rules_by_field):
+    """One "<field>: <rule name>" line per field, in insertion order.
+    An empty mapping renders as "(no rules)"."""
+    if not rules_by_field:
+        return "(no rules)"
+    return "\n".join("%s: %s" % (field, r["name"])
+                     for field, r in rules_by_field.items())
diff --git a/app/schema.py b/app/schema.py
new file mode 100644
index 0000000..68d783a
--- /dev/null
+++ b/app/schema.py
@@ -0,0 +1,228 @@
+"""Declarative validation toolkit: the error catalog, the shared value
+predicates, and a small spec algebra the feature layers build on.
+
+A *spec* is a plain dict mapping a field name to a rules dict. The only
+legal rule keys are:
+
+    "required"   bool    the field must be present in the input
+    "type"       str     "str" or "number"
+    "non_empty"  bool    the value must be a string with non-whitespace text
+    "max"        number  the value must be <= this limit
+
+`compile_spec` turns a spec into a reusable validator that raises on the
+first problem; `validate_collect` runs the same rules but returns every
+message. Both check required fields first (in spec insertion order), then
+each present field's rules in the fixed order type -> non_empty -> max,
+reporting at most one message per field.
+
+Every user-facing message in the app is built here, via `format_error`, so
+there is exactly one place where wording lives.
+"""
+import math
+
+
+ERROR_CATALOG = {
+    "missing": "missing field: {field}",
+    "numeric": "field {field} must be numeric (got {got})",
+    "non_negative": "field {field} must be non-negative",
+    "max": "field {field} exceeds max_amount {limit}",
+    "non_empty": "field {field} must be a non-empty string",
+    "type_str": "field {field} must be a string",
+}
+
+LEGAL_RULE_KEYS = ("required", "type", "non_empty", "max")
+LEGAL_TYPES = ("str", "number")
+
+# The order rules are evaluated in for a present field. Fixed, so the
+# message a caller sees for a multi-rule field is predictable.
+RULE_ORDER = ("type", "non_empty", "max")
+
+
+class SchemaError(Exception):
+    """A spec violation found while validating a fields dict."""
+
+
+def format_error(code, **kwargs):
+    """Render the catalog message for `code`. Raises KeyError for an
+    unknown code — a typo must never degrade into a silent fallback."""
+    return ERROR_CATALOG[code].format(**kwargs)
+
+
+def check_required(fields, required_fields):
+    """Names in `required_fields` absent from `fields`, in required order."""
+    return [name for name in required_fields if name not in fields]
+
+
+def is_valid_amount(value):
+    """True for finite ints/floats. Bools are not amounts even though
+    `isinstance(True, int)` is True; NaN and the infinities are not either.
+
+    Only floats go through `math.isfinite`: an int is always finite, and
+    converting a huge int to float to test it would raise OverflowError.
+    """
+    if isinstance(value, bool):
+        return False
+    if isinstance(value, int):
+        return True
+    if isinstance(value, float):
+        return math.isfinite(value)
+    return False
+
+
+def is_non_empty_str(value):
+    """True for a string with at least one non-whitespace character."""
+    return isinstance(value, str) and value.strip() != ""
+
+
+def _check_rules(field, value, rules):
+    """The first (code, kwargs) failure among `rules` for `value`, or None."""
+    for key in RULE_ORDER:
+        if key not in rules:
+            continue
+        if key == "type":
+            if rules["type"] == "number":
+                if not is_valid_amount(value):
+                    return ("numeric", {"field": field,
+                                        "got": type(value).__name__})
+            elif not isinstance(value, str):
+                return ("type_str", {"field": field})
+        elif key == "non_empty":
+            if rules["non_empty"] and not is_non_empty_str(value):
+                return ("non_empty", {"field": field})
+        elif key == "max":
+            # A value that is not a number cannot be compared to the limit;
+            # report it as non-numeric rather than raising TypeError.
+            if not is_valid_amount(value):
+                return ("numeric", {"field": field,
+                                    "got": type(value).__name__})
+            if value > rules["max"]:
+                return ("max", {"field": field, "limit": rules["max"]})
+    return None
+
+
+def _validate_spec(spec):
+    """Compile-time check of a spec's shape."""
+    for field, rules in spec.items():
+        for key in rules:
+            if key not in LEGAL_RULE_KEYS:
+                raise ValueError(
+                    "unknown rule key %r for field %r" % (key, field))
+        if "type" in rules and rules["type"] not in LEGAL_TYPES:
+            raise ValueError(
+                "unknown type %r for field %r" % (rules["type"], field))
+
+
+def _apply(spec, fields):
+    """The stripped result dict, or raise SchemaError on the first failure."""
+    for field in spec:
+        if spec[field].get("required") and field not in fields:
+            raise SchemaError(format_error("missing", field=field))
+    for field, rules in spec.items():
+        if field not in fields:
+            continue
+        failure = _check_rules(field, fields[field], rules)
+        if failure is not None:
+            code, kwargs = failure
+            raise SchemaError(format_error(code, **kwargs))
+    result = dict(fields)
+    for field, rules in spec.items():
+        if rules.get("non_empty") and field in result:
+            result[field] = result[field].strip()
+    return result
+
+
+def compile_spec(spec):
+    """Compile `spec` into a reusable `validator(fields) -> fields` callable.
+
+    The validator raises SchemaError on the first problem and otherwise
+    returns a new dict: `non_empty` fields stripped, everything else copied
+    through. The input dict is never mutated, and fields absent from the
+    spec pass through untouched (a spec constrains, it does not whitelist).
+    """
+    _validate_spec(spec)
+    compiled = {field: dict(rules) for field, rules in spec.items()}
+
+    def validator(fields):
+        return _apply(compiled, fields)
+
+    return validator
+
+
+def validate_collect(spec, fields):
+    """Every error message for `fields`: required-misses first in spec
+    order, then at most one message per present field, also in spec order.
+    Returns [] when `fields` is clean."""
+    _validate_spec(spec)
+    errors = [format_error("missing", field=field)
+              for field in spec
+              if spec[field].get("required") and field not in fields]
+    for field, rules in spec.items():
+        if field not in fields:
+            continue
+        failure = _check_rules(field, fields[field], rules)
+        if failure is not None:
+            code, kwargs = failure
+            errors.append(format_error(code, **kwargs))
+    return errors
+
+
+def merge_specs(a, b):
+    """A new spec unioning `a` and `b`. Fields unique to either side copy
+    through; a field in both merges its rules. The same rule key on the
+    same field with unequal values is a conflict: ValueError."""
+    merged = {field: dict(rules) for field, rules in a.items()}
+    for field, rules in b.items():
+        if field not in merged:
+            merged[field] = dict(rules)
+            continue
+        target = merged[field]
+        for key, value in rules.items():
+            if key in target and target[key] != value:
+                raise ValueError(
+                    "conflicting rule %r for field %r: %r != %r"
+                    % (key, field, target[key], value))
+            target[key] = value
+    return merged
+
+
+def describe_spec(spec):
+    """One line per field in sorted order: "<field>: <key>=<value>, ...",
+    rule keys sorted. Empty specs render as "(empty spec)"."""
+    if not spec:
+        return "(empty spec)"
+    lines = []
+    for field in sorted(spec):
+        rules = spec[field]
+        rendered = ", ".join("%s=%s" % (key, rules[key])
+                             for key in sorted(rules))
+        lines.append("%s: %s" % (field, rendered))
+    return "\n".join(lines)
+
+
+def diff_specs(a, b):
+    """{"added": [...], "removed": [...], "changed": [...]} — field names
+    only in `b`, only in `a`, and in both with unequal rules. All sorted."""
+    return {
+        "added": sorted(field for field in b if field not in a),
+        "removed": sorted(field for field in a if field not in b),
+        "changed": sorted(field for field in a
+                          if field in b and a[field] != b[field]),
+    }
+
+
+def spec_from_config(config, prefix):
+    """Every `prefix`-prefixed config key as a spec field (prefix stripped,
+    value used as that field's rules). Unprefixed keys are ignored."""
+    return {key[len(prefix):]: dict(value)
+            for key, value in config.items() if key.startswith(prefix)}
+
+
+def spec_to_config(spec, prefix):
+    """The inverse of `spec_from_config`: {prefix + field: rules copy}."""
+    return {prefix + field: dict(rules) for field, rules in spec.items()}
+
+
+def spec_summary_line(spec):
+    """"<N> fields, <M> rules" — M totalled across every field."""
+    return "%d fields, %d rules" % (
+        len(spec), sum(len(rules) for rules in spec.values()))
diff --git a/app/tabular.py b/app/tabular.py
new file mode 100644
index 0000000..95dcb6c
--- /dev/null
+++ b/app/tabular.py
@@ -0,0 +1,150 @@
+"""Column-model toolkit: the shared cell/column primitives every export
+format is built from.
+
+`app.export` owns the per-format assembly (which rows, which separators);
+this module owns the column model itself — the key union, cell rendering,
+per-format escaping, column widths, and padding/fitting. Keeping it here
+means no format duplicates key-union, escaping, or `str()` logic.
+"""
+
+_ALIGNMENTS = ("left", "right")
+
+_HTML_ESCAPES = (
+    ("&", "&amp;"),   # ampersand first: later replacements emit "&" too
+    ("<", "&lt;"),
+    (">", "&gt;"),
+    ('"', "&quot;"),
+)
+
+
+def columns(records):
+    """Sorted union of every key across `records`. Records need not share
+    keys; `columns([])` is `[]`."""
+    names = set()
+    for record in records:
+        names.update(record)
+    return sorted(names)
+
+
+def cell(value):
+    """Render one value as a string: `None` becomes the empty cell, every
+    other value goes through plain `str()` (so `3` is "3", not "3.0")."""
+    if value is None:
+        return ""
+    return str(value)
+
+
+def escape_csv(value):
+    """Quote a cell for CSV only when it needs it — i.e. when it contains a
+    comma, a double quote, or a newline. Inner double quotes are doubled.
+    An empty cell stays unquoted."""
+    text = cell(value)
+    if any(ch in text for ch in (",", '"', "\n", "\r")):
+        return '"%s"' % text.replace('"', '""')
+    return text
+
+
+def widths(records, cols):
+    """Map each column name in `cols` to `max(len(header), widest cell)`.
+    Missing keys count as empty cells."""
+    result = {}
+    for col in cols:
+        widest = len(col)
+        for record in records:
+            widest = max(widest, len(cell(record.get(col))))
+        result[col] = widest
+    return result
+
+
+def pad(value, width, align="left"):
+    """Pad a value out to `width`, left- or right-aligned. A value already
+    at or beyond `width` is returned unchanged — padding never truncates.
+
+    `align` is validated before the width short-circuit, so an unknown
+    alignment always raises, even for a value that needs no padding.
+    """
+    if align not in _ALIGNMENTS:
+        raise ValueError("unknown align: %s" % align)
+    text = cell(value)
+    if len(text) >= width:
+        return text
+    if align == "right":
+        return text.rjust(width)
+    return text.ljust(width)
+
+
+def sanitize_flat(value):
+    """Render a value for a single-line (flat) format: every tab and
+    newline becomes a single space so it cannot break the row grid."""
+    text = cell(value)
+    for ch in ("\t", "\r\n", "\n", "\r"):
+        text = text.replace(ch, " ")
+    return text
+
+
+def escape_html(value):
+    """Render a value as HTML text: `&`, `<`, `>` and `"` escaped, with the
+    ampersand replaced first so the other escapes are not re-escaped."""
+    text = cell(value)
+    for raw, escaped in _HTML_ESCAPES:
+        text = text.replace(raw, escaped)
+    return text
+
+
+def truncate(value, width, marker="..."):
+    """Shorten a value to `width` characters, ending in `marker` when it
+    had to be cut. A value that already fits is returned unchanged.
+    `width` shorter than `marker` leaves no room to mark the cut and
+    raises ValueError."""
+    if width < len(marker):
+        raise ValueError("width %s is narrower than marker %r" % (width, marker))
+    text = cell(value)
+    if len(text) <= width:
+        return text
+    return text[:width - len(marker)] + marker
+
+
+def wrap(value, width):
+    """Greedily wrap a value on spaces into lines of at most `width`
+    characters. A single word wider than `width` is hard-split. An empty
+    value wraps to `[""]` — one empty line, not zero lines."""
+    if width < 1:
+        raise ValueError("width must be at least 1, got %s" % width)
+    text = cell(value)
+    if text == "":
+        return [""]
+    lines = []
+    current = ""
+    for word in text.split(" "):
+        while len(word) > width:
+            if current:
+                lines.append(current)
+                current = ""
+            lines.append(word[:width])
+            word = word[width:]
+        if not current:
+            current = word
+        elif len(current) + 1 + len(word) <= width:
+            current = current + " " + word
+        else:
+            lines.append(current)
+            current = word
+    lines.append(current)
+    return lines
+
+
+def fit(value, width, align="left"):
+    """Force a value to exactly `width` columns: truncated when too long,
+    padded per `align` when too short."""
+    return pad(truncate(value, width), width, align)
+
+
+def render_row(cells, widths_list, align="left"):
+    """Render one pipe-table row: each cell padded to its column width,
+    joined by " | " and fenced with "| " / " |"."""
+    if len(cells) != len(widths_list):
+        raise ValueError("got %s cells for %s columns"
+                         % (len(cells), len(widths_list)))
+    padded = [pad(value, width, align)
+              for value, width in zip(cells, widths_list)]
+    return "| " + " | ".join(padded) + " |"
