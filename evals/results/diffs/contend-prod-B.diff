@@ -0,0 +1,340 @@
+"""Tests for app/schema.py — the declarative schema toolkit."""
+import math
+
+import pytest
+
+from app import schema
+from app.schema import (
+    ERROR_CATALOG,
+    SchemaError,
+    check_required,
+    compile_spec,
+    describe_spec,
+    diff_specs,
+    format_error,
+    is_non_empty_str,
+    is_valid_amount,
+    merge_specs,
+    spec_from_config,
+    spec_summary_line,
+    spec_to_config,
+    validate_collect,
+)
+
+
+def test_error_catalog_has_exactly_the_expected_keys():
+    assert set(ERROR_CATALOG.keys()) == {
+        "missing",
+        "numeric",
+        "non_negative",
+        "max",
+        "non_empty",
+        "type_str",
+    }
+    for tmpl in ERROR_CATALOG.values():
+        assert isinstance(tmpl, str)
+
+
+def test_format_error_missing():
+    assert format_error("missing", field="name") == "missing field: name"
+
+
+def test_format_error_numeric():
+    assert format_error("numeric", field="amount", got="str") == (
+        "field amount must be numeric (got str)"
+    )
+
+
+def test_format_error_non_negative():
+    assert format_error("non_negative", field="amount") == (
+        "field amount must be non-negative"
+    )
+
+
+def test_format_error_max():
+    assert format_error("max", field="amount", limit=100) == (
+        "field amount exceeds max_amount 100"
+    )
+
+
+def test_format_error_non_empty():
+    assert format_error("non_empty", field="name") == (
+        "field name must be a non-empty string"
+    )
+
+
+def test_format_error_type_str():
+    assert format_error("type_str", field="name") == "field name must be a string"
+
+
+def test_format_error_unknown_code_raises_key_error():
+    with pytest.raises(KeyError):
+        format_error("nope")
+
+
+def test_check_required_various():
+    assert check_required({"amount": 1}, ["name", "amount"]) == ["name"]
+    # insertion order disagrees with required_fields order
+    both_missing = {"zzz": 1}
+    assert check_required(both_missing, ["name", "amount"]) == ["name", "amount"]
+    assert check_required({"name": "a", "amount": 1}, ["name", "amount"]) == []
+
+
+def test_is_valid_amount_true_cases():
+    assert is_valid_amount(0) is True
+    assert is_valid_amount(5) is True
+    assert is_valid_amount(3.5) is True
+
+
+def test_is_valid_amount_false_cases():
+    assert is_valid_amount(True) is False
+    assert is_valid_amount(False) is False
+    assert is_valid_amount("3") is False
+    assert is_valid_amount(None) is False
+    assert is_valid_amount(float("nan")) is False
+    assert is_valid_amount(float("inf")) is False
+    assert is_valid_amount(float("-inf")) is False
+
+
+def test_is_valid_amount_overflow_int_does_not_raise():
+    assert is_valid_amount(10**400) is True
+
+
+def test_is_non_empty_str():
+    assert is_non_empty_str("a") is True
+    assert is_non_empty_str(" a ") is True
+    assert is_non_empty_str("") is False
+    assert is_non_empty_str("   ") is False
+    assert is_non_empty_str(42) is False
+    assert is_non_empty_str(None) is False
+
+
+def test_schema_error_is_exception_subclass_distinct():
+    assert issubclass(SchemaError, Exception)
+    assert not issubclass(SchemaError, KeyError)
+    assert not issubclass(SchemaError, ValueError)
+
+
+def test_compile_spec_unknown_rule_key_raises_value_error():
+    with pytest.raises(ValueError):
+        compile_spec({"name": {"bogus": True}})
+
+
+def test_compile_spec_unknown_type_value_raises_value_error():
+    with pytest.raises(ValueError):
+        compile_spec({"name": {"type": "int"}})
+
+
+def test_compile_spec_empty_spec_accepts_any_dict_unchanged():
+    validator = compile_spec({})
+    fields = {"a": 1, "b": "x"}
+    result = validator(fields)
+    assert result == fields
+    assert result is not fields
+
+
+def test_compiled_validator_checks_required_in_spec_order():
+    spec = {"name": {"required": True}, "amount": {"required": True}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError) as exc:
+        validator({})
+    assert str(exc.value) == format_error("missing", field="name")
+
+
+def test_compiled_validator_type_number_rule():
+    spec = {"amount": {"type": "number"}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError) as exc:
+        validator({"amount": "3"})
+    assert str(exc.value) == format_error("numeric", field="amount", got="str")
+    with pytest.raises(SchemaError):
+        validator({"amount": True})
+    with pytest.raises(SchemaError):
+        validator({"amount": float("nan")})
+    with pytest.raises(SchemaError):
+        validator({"amount": float("inf")})
+    assert validator({"amount": 5})["amount"] == 5
+
+
+def test_compiled_validator_type_str_before_non_empty():
+    spec = {"name": {"type": "str", "non_empty": True}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError) as exc:
+        validator({"name": 42})
+    assert str(exc.value) == format_error("type_str", field="name")
+
+
+def test_compiled_validator_non_empty_rule():
+    spec = {"name": {"non_empty": True}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError) as exc:
+        validator({"name": "   "})
+    assert str(exc.value) == format_error("non_empty", field="name")
+
+
+def test_compiled_validator_max_rule_boundary():
+    spec = {"amount": {"max": 100}}
+    validator = compile_spec(spec)
+    assert validator({"amount": 100})["amount"] == 100
+    with pytest.raises(SchemaError) as exc:
+        validator({"amount": 101})
+    assert str(exc.value) == format_error("max", field="amount", limit=100)
+
+
+def test_compiled_validator_max_on_non_comparable_value_raises_numeric():
+    spec = {"amount": {"max": 100}}
+    with pytest.raises(SchemaError) as exc:
+        compile_spec(spec)({"amount": "abc"})
+    assert str(exc.value) == format_error("numeric", field="amount", got="str")
+
+    errs = validate_collect(spec, {"amount": "abc"})
+    assert errs == [format_error("numeric", field="amount", got="str")]
+
+
+def test_compiled_validator_strips_non_empty_fields_only_and_does_not_mutate_input():
+    spec = {"name": {"non_empty": True}, "note": {}}
+    validator = compile_spec(spec)
+    fields = {"name": "  hi  ", "note": "  keep  "}
+    result = validator(fields)
+    assert result == {"name": "hi", "note": "  keep  "}
+    assert fields == {"name": "  hi  ", "note": "  keep  "}
+    # deterministic / reusable
+    result2 = validator(dict(fields))
+    assert result2 == result
+
+
+def test_compiled_validator_passes_through_fields_absent_from_spec():
+    spec = {"name": {"required": True}}
+    validator = compile_spec(spec)
+    result = validator({"name": "a", "extra": [1, 2]})
+    assert result["extra"] == [1, 2]
+
+
+def test_merge_specs_union_and_conflict():
+    a = {"name": {"required": True}}
+    b = {"name": {"non_empty": True}, "amount": {"type": "number"}}
+    merged = merge_specs(a, b)
+    assert merged == {
+        "name": {"required": True, "non_empty": True},
+        "amount": {"type": "number"},
+    }
+    assert a == {"name": {"required": True}}
+    assert b == {"name": {"non_empty": True}, "amount": {"type": "number"}}
+
+
+def test_merge_specs_conflicting_values_raise_value_error():
+    a = {"name": {"max": 10}}
+    b = {"name": {"max": 20}}
+    with pytest.raises(ValueError):
+        merge_specs(a, b)
+
+
+def test_merge_specs_equal_values_merge_silently():
+    a = {"name": {"max": 10}}
+    b = {"name": {"max": 10}}
+    merged = merge_specs(a, b)
+    assert merged == {"name": {"max": 10}}
+
+
+def test_describe_spec_two_fields_literal():
+    spec = {"amount": {"max": 100, "type": "number"}, "name": {"required": True}}
+    expected = "amount: max=100, type=number\nname: required=True"
+    assert describe_spec(spec) == expected
+
+
+def test_describe_spec_empty():
+    assert describe_spec({}) == "(empty spec)"
+
+
+def test_diff_specs_all_three_buckets():
+    a = {
+        "gone": {"required": True},
+        "changed": {"max": 10},
+        "same": {"required": True},
+    }
+    b = {
+        "new": {"required": True},
+        "changed": {"max": 20},
+        "same": {"required": True},
+    }
+    result = diff_specs(a, b)
+    assert result == {
+        "added": ["new"],
+        "removed": ["gone"],
+        "changed": ["changed"],
+    }
+
+
+def test_diff_specs_identical_specs_yield_empty_lists():
+    spec = {"name": {"required": True}}
+    result = diff_specs(spec, dict(spec))
+    assert result == {"added": [], "removed": [], "changed": []}
+    assert spec == {"name": {"required": True}}
+
+
+def test_spec_from_config_end_to_end():
+    config = {
+        "s_name": {"required": True},
+        "s_amount": {"type": "number"},
+        "other_key": "ignored",
+    }
+    spec = spec_from_config(config, "s_")
+    assert spec == {"name": {"required": True}, "amount": {"type": "number"}}
+    validator = compile_spec(spec)
+    assert validator({"name": "a", "amount": 1})["name"] == "a"
+    with pytest.raises(SchemaError):
+        validator({"amount": "x"})
+
+
+def test_spec_to_config_exact_and_independent_copies():
+    spec = {"name": {"required": True}, "amount": {"type": "number"}}
+    config = spec_to_config(spec, "s_")
+    assert config == {
+        "s_name": {"required": True},
+        "s_amount": {"type": "number"},
+    }
+    config["s_name"]["required"] = False
+    assert spec["name"]["required"] is True
+
+
+def test_spec_roundtrip_both_ways():
+    spec = {"name": {"required": True}, "amount": {"type": "number"}}
+    config = spec_to_config(spec, "s_")
+    assert spec_from_config(config, "s_") == spec
+
+    config2 = {"s_name": {"required": True}, "s_amount": {"type": "number"}}
+    assert spec_to_config(spec_from_config(config2, "s_"), "s_") == config2
+
+
+def test_spec_summary_line():
+    spec = {"name": {"required": True}, "amount": {"type": "number", "max": 100}}
+    assert spec_summary_line(spec) == "2 fields, 3 rules"
+
+
+def test_spec_summary_line_empty():
+    assert spec_summary_line({}) == "0 fields, 0 rules"
+
+
+def test_validate_collect_missing_then_field_errors_in_spec_order():
+    spec = {
+        "name": {"required": True, "type": "str"},
+        "amount": {"required": True, "type": "number"},
+        "note": {"type": "str"},
+    }
+    fields = {"amount": "bad", "note": 42}
+    errs = validate_collect(spec, fields)
+    assert errs == [
+        format_error("missing", field="name"),
+        format_error("numeric", field="amount", got="str"),
+        format_error("type_str", field="note"),
+    ]
+
+
+def test_validate_collect_clean_is_empty():
+    spec = {"name": {"required": True}}
+    assert validate_collect(spec, {"name": "a"}) == []
+
+
+def test_validate_collect_one_message_per_field_type_before_non_empty():
+    spec = {"n": {"type": "str", "non_empty": True}}
+    assert validate_collect(spec, {"n": 42}) == ["field n must be a string"]
