+def test_validate_many_splits_successes_and_indexed_errors():
+    entries = [
+        {"name": " a ", "amount": 1},
+        {"name": "b", "amount": "3"},
+        {"name": "c", "amount": 2},
+        {"amount": 4},
+    ]
+    validated, errors = validation.validate_many(entries, REQUIRED, MAX)
+    assert validated == [{"name": "a", "amount": 1}, {"name": "c", "amount": 2}]
+    assert errors == [
+        (1, "field amount must be numeric (got str)"),
+        (3, "missing field: name"),
+    ]
+    assert entries == [
+        {"name": " a ", "amount": 1},
+        {"name": "b", "amount": "3"},
+        {"name": "c", "amount": 2},
+        {"amount": 4},
+    ]
