+++ b/tests/test_export.py
@@ -0,0 +1,255 @@
+"""Tests for app/export.py: CSV/JSON/MD/NDJSON/TSV/HTML export formatter."""
+import json
+
+import pytest
+
+from app import export
+
+
+def test_to_csv_empty_list():
+    assert export.to_csv([]) == ""
+
+
+def test_to_csv_header_sorted_and_missing_field_empty_cell():
+    records = [{"b": 1, "a": 2}, {"c": 3, "a": 4}]
+    out = export.to_csv(records)
+    lines = out.split("\r\n") if "\r\n" in out else out.split("\n")
+    assert lines[0] == "a,b,c"
+    assert lines[1] == "2,1,"
+    assert lines[2] == "4,,3"
+
+
+def test_to_csv_int_and_float_no_dot_zero_suffix():
+    out = export.to_csv([{"amount": 5}])
+    lines = out.splitlines()
+    assert lines[0] == "amount"
+    assert lines[1] == "5"
+
+
+def test_to_json_empty_list():
+    assert export.to_json([]) == "[]"
+
+
+def test_to_json_round_trips_and_sorted_keys():
+    records = [{"b": 1, "a": 2}]
+    out = export.to_json(records)
+    assert json.loads(out) == records
+    assert out == json.dumps(records, sort_keys=True)
+
+
+def test_to_csv_escapes_comma_and_quote_cells():
+    records = [{"name": "a,b"}]
+    out = export.to_csv(records)
+    lines = out.splitlines()
+    assert lines[0] == "name"
+    assert lines[1] == '"a,b"'
+
+    records2 = [{"name": 'say "hi"'}]
+    out2 = export.to_csv(records2)
+    assert out2.splitlines()[1] == '"say ""hi"""'
+
+
+def test_to_csv_plain_case_byte_identical_to_unescaped_join():
+    records = [{"name": "plain", "amount": 3}]
+    out = export.to_csv(records)
+    assert out.splitlines() == ["amount,name", "3,plain"]
+
+
+def test_to_markdown_empty_list():
+    assert export.to_markdown([]) == ""
+
+
+def test_to_markdown_exact_two_record_unequal_keys():
+    records = [{"a": "1", "bb": "x"}, {"a": "22"}]
+    expected = (
+        "| a  | bb |\n"
+        "| -- | -- |\n"
+        "| 1  | x  |\n"
+        "| 22 |    |"
+    )
+    assert export.to_markdown(records) == expected
+
+
+def test_to_ndjson_empty_list():
+    assert export.to_ndjson([]) == ""
+
+
+def test_to_ndjson_exact_two_records():
+    records = [{"b": 1, "a": 2}, {"a": 3}]
+    expected = '{"a": 2, "b": 1}\n{"a": 3}'
+    out = export.to_ndjson(records)
+    assert out == expected
+    for line in out.splitlines():
+        assert isinstance(json.loads(line), dict)
+
+
+def test_to_markdown_align_left_exact():
+    records = [{"a": "1"}, {"a": "22"}]
+    expected = (
+        "| a  |\n"
+        "| -- |\n"
+        "| 1  |\n"
+        "| 22 |"
+    )
+    assert export.to_markdown(records, align="left") == expected
+
+
+def test_to_markdown_align_right_exact():
+    records = [{"a": "1"}, {"a": "22"}]
+    expected = (
+        "|  a |\n"
+        "| -: |\n"
+        "|  1 |\n"
+        "| 22 |"
+    )
+    assert export.to_markdown(records, align="right") == expected
+
+
+def test_to_markdown_bad_align_raises_even_when_cells_meet_width():
+    records = [{"a": "1"}]
+    with pytest.raises(ValueError):
+        export.to_markdown(records, align="center")
+
+
+def test_to_tsv_empty_list():
+    assert export.to_tsv([]) == ""
+
+
+def test_to_tsv_sanitizes_cells_and_headers():
+    records = [{"a\tb": "1\n2"}]
+    out = export.to_tsv(records)
+    lines = out.splitlines()
+    assert lines[0] == "a b"
+    assert lines[1] == "1 2"
+
+
+def test_to_tsv_missing_fields_empty_cells():
+    records = [{"a": 1, "b": 2}, {"a": 3}]
+    out = export.to_tsv(records)
+    lines = out.splitlines()
+    assert lines[0] == "a\tb"
+    assert lines[1] == "1\t2"
+    assert lines[2] == "3\t"
+
+
+def test_to_html_empty_list():
+    assert export.to_html([]) == ""
+
+
+def test_to_html_exact_two_record_unequal_keys_with_escaping():
+    records = [{"a": "x & y", "b": "1"}, {"a": "<z>"}]
+    expected = "\n".join([
+        "<table>",
+        "<tr><th>a</th><th>b</th></tr>",
+        "<tr><td>x &amp; y</td><td>1</td></tr>",
+        "<tr><td>&lt;z&gt;</td><td></td></tr>",
+        "</table>",
+    ])
+    assert export.to_html(records) == expected
+
+
+def test_parse_csv_empty_string():
+    assert export.parse_csv("") == []
+
+
+def test_parse_csv_header_only_no_trailing_newline():
+    assert export.parse_csv("a") == []
+
+
+def test_parse_csv_single_column_header_plus_empty_row():
+    assert export.parse_csv("a\n") == [{"a": ""}]
+
+
+def test_parse_csv_quoted_cells_and_doubled_quotes():
+    text = 'a,b\n"1,2","say ""hi"""'
+    result = export.parse_csv(text)
+    assert result == [{"a": "1,2", "b": 'say "hi"'}]
+
+
+def test_parse_csv_unterminated_quote_raises():
+    with pytest.raises(ValueError):
+        export.parse_csv('a\n"unterminated\n')
+
+
+def test_parse_csv_round_trip_with_comma_quote_and_newline():
+    rec = {"name": 'a,b"c\nd', "amount": 3}
+    out = export.to_csv([rec])
+    parsed = export.parse_csv(out)
+    assert parsed == [{"amount": "3", "name": 'a,b"c\nd'}]
+
+
+def test_formats_dict_exact_keys():
+    assert set(export.FORMATS.keys()) == {"csv", "json", "md", "ndjson", "tsv"}
+    assert export.FORMATS["csv"] is export.to_csv
+    assert export.FORMATS["json"] is export.to_json
+    assert export.FORMATS["md"] is export.to_markdown
+    assert export.FORMATS["ndjson"] is export.to_ndjson
+    assert export.FORMATS["tsv"] is export.to_tsv
+
+
+def test_extra_formats_dict_exact_keys():
+    assert set(export.EXTRA_FORMATS.keys()) == {"html"}
+    assert export.EXTRA_FORMATS["html"] is export.to_html
+    assert "html" not in export.FORMATS
+
+
+def test_render_delegates_to_matching_function():
+    records = [{"a": 1, "b": 2}]
+    for name, fn in export.FORMATS.items():
+        assert export.render(records, name) == fn(records)
+
+
+def test_render_unknown_format_raises_naming_it():
+    with pytest.raises(ValueError, match="xml"):
+        export.render([], "xml")
+
+
+def test_render_rejects_html():
+    with pytest.raises(ValueError, match="html"):
+        export.render([], "html")
+
+
+def test_render_any_serves_formats_then_extra_formats():
+    records = [{"a": 1}]
+    assert export.render_any(records, "csv") == export.to_csv(records)
+    assert export.render_any(records, "html") == export.to_html(records)
+
+
+def test_render_any_unknown_format_raises_naming_it():
+    with pytest.raises(ValueError, match="xml"):
+        export.render_any([], "xml")
+
+
+def test_summary_line_exact_for_unequal_keys_fixture():
+    records = [{"a": 1, "b": 2}, {"a": 3}]
+    assert export.summary_line(records) == "2 records, 2 columns"
+
+
+def test_summary_line_empty():
+    assert export.summary_line([]) == "0 records, 0 columns"
+
+
+def test_single_record_coverage_all_formats():
+    records = [{"a": 1, "b": 2}]
+    csv_out = export.to_csv(records)
+    assert csv_out.splitlines() == ["a,b", "1,2"]
+
+    json_out = export.to_json(records)
+    assert json.loads(json_out) == records
+
+    md_out = export.to_markdown(records)
+    assert md_out == "| a | b |\n| - | - |\n| 1 | 2 |"
+
+    ndjson_out = export.to_ndjson(records)
+    assert ndjson_out == '{"a": 1, "b": 2}'
+
+    tsv_out = export.to_tsv(records)
+    assert tsv_out.splitlines() == ["a\tb", "1\t2"]
+
+    html_out = export.to_html(records)
+    assert html_out == "\n".join([
+        "<table>",
+        "<tr><th>a</th><th>b</th></tr>",
+        "<tr><td>1</td><td>2</td></tr>",
+        "</table>",
+    ])
diff --git a/tests/test_quota.py b/tests/test_quota.py
new file mode 100644
index 0000000..fb8d4ec
--- /dev/null
+++ b/tests/test_quota.py
@@ -0,0 +1,208 @@
+import pytest
+
+from app import quota
+
+
+@pytest.fixture(autouse=True)
+def _reset():
+    quota.reset()
+
+
+def test_quota_exceeded_error_is_exception_subclass():
+    assert issubclass(quota.QuotaExceededError, Exception)
+
+
+def test_clock_starts_at_zero_and_advances_and_rejects_backwards():
+    assert quota.now() == 0.0
+    assert quota.advance(30) == 30.0
+    assert quota.now() == 30.0
+    with pytest.raises(ValueError):
+        quota.advance(-1)
+    assert quota.now() == 30.0
+
+
+def test_take_records_hits_and_raises_when_exhausted():
+    assert quota.take("k", limit=2, window_seconds=60) == 1
+    assert quota.take("k", limit=2, window_seconds=60) == 2
+    with pytest.raises(quota.QuotaExceededError) as exc_info:
+        quota.take("k", limit=2, window_seconds=60)
+    message = str(exc_info.value)
+    assert "k" in message
+    assert "2" in message
+
+
+def test_window_pruning_ages_out_old_hits():
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(61)
+    assert quota.take("k", 2, 60) == 1
+
+
+def test_hit_ages_out_strictly_after_window():
+    quota.advance(30)
+    quota.take("k", 5, 60)  # hit recorded at t=30
+    quota.advance(31)  # now = 61: hit still in window (cutoff = 1 <= 30)
+    assert quota.remaining("k", 5, 60) == 4
+    quota.advance(30)  # now = 91: hit aged out (cutoff = 31 > 30)
+    assert quota.remaining("k", 5, 60) == 5
+
+
+def test_infinite_window_never_prunes():
+    quota.take("k", 2, float("inf"))
+    quota.take("k", 2, float("inf"))
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 2, float("inf"))
+    quota.advance(10 ** 6)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 2, float("inf"))
+
+
+def test_burst_allows_extra_hits():
+    quota.take("k", limit=2, window_seconds=60, burst=1)
+    quota.take("k", limit=2, window_seconds=60, burst=1)
+    quota.take("k", limit=2, window_seconds=60, burst=1)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60, burst=1)
+
+
+def test_burst_defaults_to_zero():
+    quota.take("k", limit=1, window_seconds=60)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", limit=1, window_seconds=60)
+
+
+def test_per_key_independence():
+    quota.take("a", 1, 60)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("a", 1, 60)
+    # "b" is untouched, same clock and window
+    assert quota.take("b", 1, 60) == 1
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("b", 1, 60)
+
+
+def test_reset_clears_clock_and_all_keys():
+    quota.take("k", 1, 60)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 1, 60)
+    quota.advance(5)
+    quota.reset()
+    assert quota.now() == 0.0
+    assert quota.take("k", 1, 60) == 1
+
+
+def test_remaining_is_read_only_and_reports_left_over():
+    assert quota.remaining("k", limit=2, window_seconds=60) == 2
+    quota.take("k", 2, 60)
+    assert quota.remaining("k", 2, 60) == 1
+    assert quota.remaining("k", 2, 60) == 1
+    quota.take("k", 2, 60)
+    assert quota.remaining("k", 2, 60) == 0
+    assert quota.remaining("k", 2, 60) == 0
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 2, 60)
+
+
+def test_remaining_recovers_after_window_passes():
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    assert quota.remaining("k", 2, 60) == 0
+    quota.advance(61)
+    assert quota.remaining("k", 2, 60) == 2
+    assert quota.take("k", 2, 60) == 1
+
+
+def test_snapshot_exact_dict_and_deep_copy():
+    quota.take("a", 5, 60)  # t=0
+    quota.advance(10)
+    quota.take("b", 5, 60)  # t=10
+    quota.advance(10)
+    quota.take("a", 5, 60)  # t=20
+
+    snap = quota.snapshot(60)
+    assert snap == {"a": [0.0, 20.0], "b": [10.0]}
+
+    snap["a"].append(999.0)
+    snap2 = quota.snapshot(60)
+    assert snap2 == {"a": [0.0, 20.0], "b": [10.0]}
+    assert quota.remaining("a", 5, 60) == 3
+
+
+def test_snapshot_excludes_aged_out_hits_and_empty_keys():
+    quota.take("a", 5, 60)  # t=0
+    quota.advance(61)
+    quota.take("b", 5, 60)  # t=61
+    snap = quota.snapshot(60)
+    assert snap == {"b": [61.0]}
+
+
+def test_time_to_next_slot_zero_when_remaining():
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+    quota.take("k", 2, 60)
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+
+
+def test_time_to_next_slot_exact_value_when_exhausted():
+    quota.take("k", 2, 60)  # t=0
+    quota.take("k", 2, 60)  # t=0
+    quota.advance(10)
+    assert quota.time_to_next_slot("k", 2, 60) == 50.0
+
+
+def test_time_to_next_slot_infinite_window_and_exhausted():
+    quota.take("k", 1, float("inf"))
+    assert quota.time_to_next_slot("k", 1, float("inf")) == float("inf")
+
+
+def test_time_to_next_slot_zero_allowance_never_crashes():
+    assert quota.time_to_next_slot("k", 0, 60) == float("inf")
+
+
+def test_time_to_next_slot_boundary_at_exact_reset_instant():
+    quota.take("k", 2, 60)  # t=0
+    quota.take("k", 2, 60)  # t=0
+    quota.advance(60)
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 2, 60)
+
+
+def test_usage_exact_dict_in_three_states():
+    assert quota.usage("k", 2, 60) == {
+        "used": 0,
+        "allowed": 2,
+        "remaining": 2,
+        "reset_in": 0.0,
+    }
+
+    quota.take("k", 2, 60)  # t=0
+    assert quota.usage("k", 2, 60) == {
+        "used": 1,
+        "allowed": 2,
+        "remaining": 1,
+        "reset_in": 0.0,
+    }
+    # read-only: a subsequent take still succeeds
+    assert quota.take("k", 2, 60) == 2
+
+    quota.advance(10)
+    assert quota.usage("k", 2, 60) == {
+        "used": 2,
+        "allowed": 2,
+        "remaining": 0,
+        "reset_in": 50.0,
+    }
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 2, 60)
+
+
+def test_purge_drops_aged_out_hits_and_returns_count():
+    quota.take("a", 5, 60)  # t=0
+    quota.take("a", 5, 60)  # t=0
+    quota.advance(10)
+    quota.take("b", 5, 60)  # t=10
+    quota.advance(51)  # now = 61
+    dropped = quota.purge(60)
+    assert dropped == 2
+    assert quota.snapshot(60) == {"b": [10.0]}
+    assert quota.purge(60) == 0
diff --git a/tests/test_ratelimit.py b/tests/test_ratelimit.py
new file mode 100644
index 0000000..c1b828f
--- /dev/null
+++ b/tests/test_ratelimit.py
@@ -0,0 +1,218 @@
+import pytest
+
+from app import quota
+from app import ratelimit
+from app.ratelimit import RateLimitExceededError
+
+
+@pytest.fixture(autouse=True)
+def _reset():
+    ratelimit.reset()
+
+
+def test_rate_limit_exceeded_error_is_exception_subclass():
+    assert issubclass(RateLimitExceededError, Exception)
+
+
+def test_check_and_increment_counts_up_then_raises():
+    assert ratelimit.check_and_increment("k", 3) == 1
+    assert ratelimit.check_and_increment("k", 3) == 2
+    assert ratelimit.check_and_increment("k", 3) == 3
+    with pytest.raises(RateLimitExceededError) as exc_info:
+        ratelimit.check_and_increment("k", 3)
+    message = str(exc_info.value)
+    assert "k" in message
+    assert "3" in message
+
+
+def test_counter_is_per_key():
+    assert ratelimit.check_and_increment("a", 2) == 1
+    assert ratelimit.check_and_increment("b", 2) == 1
+    assert ratelimit.check_and_increment("a", 2) == 2
+    assert ratelimit.check_and_increment("b", 2) == 2
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("a", 2)
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("b", 2)
+
+
+def test_reset_clears_all_keys():
+    ratelimit.check_and_increment("a", 1)
+    ratelimit.check_and_increment("b", 1)
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("a", 1)
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("a", 1) == 1
+    assert ratelimit.check_and_increment("b", 1) == 1
+
+
+def test_dispatch_hook_never_raises_or_increments_on_get():
+    config = {"rate_limit_max_per_window": 1}
+    for _ in range(6):
+        ratelimit.dispatch_hook(None, config, "GET", "/records", {})
+    # GET never touched the counter: subsequent check_and_increment on the
+    # same key ("anonymous") starts at 1.
+    assert ratelimit.check_and_increment("anonymous", 1) == 1
+
+
+def test_dispatch_hook_post_keys_by_actor():
+    config = {"rate_limit_max_per_window": 5, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+    # "anonymous" has had 2 hits, "x" has had 1 -- independent counters.
+    assert quota.remaining("anonymous", 5, 60) == 3
+    assert quota.remaining("x", 5, 60) == 4
+
+
+def test_dispatch_hook_reads_limit_from_config():
+    config1 = {"rate_limit_max_per_window": 1}
+    ratelimit.dispatch_hook(None, config1, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config1, "POST", "/records", {"actor": "a"})
+
+    config2 = {"rate_limit_max_per_window": 2}
+    ratelimit.dispatch_hook(None, config2, "POST", "/records", {"actor": "b"})
+    ratelimit.dispatch_hook(None, config2, "POST", "/records", {"actor": "b"})
+
+
+def test_reset_also_resets_quota_clock():
+    config = {"rate_limit_max_per_window": 1}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(5)
+    ratelimit.reset()
+    assert quota.now() == 0.0
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+
+def test_rate_limit_exceeded_error_subclasses_quota_exceeded_error():
+    assert issubclass(RateLimitExceededError, quota.QuotaExceededError)
+    ratelimit.check_and_increment("k", 1)
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("k", 1)
+    with pytest.raises(quota.QuotaExceededError):
+        ratelimit.check_and_increment("k", 1)
+
+
+def test_check_and_increment_delegates_to_quota_take(monkeypatch):
+    calls = []
+
+    def fake_take(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", fake_take)
+    ratelimit.check_and_increment("k", 3)
+    assert calls == [(("k", 3, float("inf")), {"burst": 0})]
+
+
+def test_windowed_end_to_end_through_hook():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(61)
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+
+def test_minimal_config_compatibility():
+    config = {"rate_limit_max_per_window": 1}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+
+
+def test_burst_through_the_hook():
+    config = {
+        "rate_limit_max_per_window": 1,
+        "rate_limit_burst": 1,
+        "rate_limit_window_seconds": 60,
+    }
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+
+def test_burst_defaults_to_zero_through_the_hook():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+
+def test_retry_after_delegates_to_quota_time_to_next_slot(monkeypatch):
+    calls = []
+
+    def fake_time_to_next_slot(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 42.0
+
+    monkeypatch.setattr(quota, "time_to_next_slot", fake_time_to_next_slot)
+    config = {
+        "rate_limit_max_per_window": 1,
+        "rate_limit_window_seconds": 60,
+        "rate_limit_burst": 0,
+    }
+    result = ratelimit.retry_after("k", config)
+    assert result == 42.0
+    assert calls == [(("k", 1, 60), {"burst": 0})]
+
+
+def test_retry_after_end_to_end():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(10)
+    assert ratelimit.retry_after("a", config) == 50.0
+
+
+def test_limit_headers_exact_dict_fresh_and_exhausted():
+    config = {
+        "rate_limit_max_per_window": 2,
+        "rate_limit_window_seconds": 60,
+        "rate_limit_burst": 1,
+    }
+    headers = ratelimit.limit_headers("mallory", config)
+    assert headers == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "3",
+        "X-RateLimit-Reset": "0.0",
+    }
+    # read-only: a subsequent take still succeeds
+    assert quota.take("mallory", 2, 60, burst=1) == 1
+
+    quota.take("mallory", 2, 60, burst=1)
+    quota.take("mallory", 2, 60, burst=1)
+    headers2 = ratelimit.limit_headers("mallory", config)
+    assert headers2 == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "0",
+        "X-RateLimit-Reset": "60.0",
+    }
+
+
+def test_status_line_exact_literal_string():
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert ratelimit.status_line("mallory", config) == "mallory: 0/2, reset in 0.0s"
+
+    quota.take("mallory", 2, 60)
+    quota.take("mallory", 2, 60)
+    quota.advance(10)
+    assert ratelimit.status_line("mallory", config) == "mallory: 2/2, reset in 50.0s"
+
+
+def test_check_many_exact_dict_no_hits_recorded():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    quota.take("a", 1, 60)  # exhaust "a"
+    result = ratelimit.check_many(["a", "b", "c"], config)
+    assert result == {"a": False, "b": True, "c": True}
+    # no hit recorded for any key
+    assert quota.remaining("a", 1, 60) == 0
+    assert quota.remaining("b", 1, 60) == 1
+    assert quota.remaining("c", 1, 60) == 1
+    quota.take("b", 1, 60)
+    quota.take("c", 1, 60)
