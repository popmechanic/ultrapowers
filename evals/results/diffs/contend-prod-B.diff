+"""Failing-first tests for app/validation.py."""
+import pytest
+
+from app import schema
+from app.validation import (
+    ValidationError,
+    error_code,
+    explain_config,
+    pre_create_hook,
+    validate_fields,
+    validate_many,
+)
+
+
+REQUIRED = ["name", "amount"]
+MAX_AMOUNT = 100
+
+
+def test_validation_error_is_exception_subclass():
+    assert issubclass(ValidationError, Exception)
+
+
+def test_missing_name_raises_naming_the_field():
+    with pytest.raises(ValidationError) as exc_info:
+        validate_fields({"amount": 1}, REQUIRED, MAX_AMOUNT)
+    assert str(exc_info.value) == "missing field: name"
+
+
+def test_missing_amount_raises_naming_the_field():
+    with pytest.raises(ValidationError) as exc_info:
+        validate_fields({"name": "a"}, REQUIRED, MAX_AMOUNT)
+    assert str(exc_info.value) == "missing field: amount"
+
+
+def test_both_missing_names_name_first_required_fields_order():
+    with pytest.raises(ValidationError) as exc_info:
+        validate_fields({}, REQUIRED, MAX_AMOUNT)
+    assert str(exc_info.value) == "missing field: name"
+
+
+def test_amount_string_raises_numeric():
+    with pytest.raises(ValidationError, match="numeric"):
+        validate_fields({"name": "a", "amount": "3"}, REQUIRED, MAX_AMOUNT)
+
+
+def test_amount_bool_raises_numeric():
+    with pytest.raises(ValidationError, match="numeric"):
+        validate_fields({"name": "a", "amount": True}, REQUIRED, MAX_AMOUNT)
+    with pytest.raises(ValidationError, match="numeric"):
+        validate_fields({"name": "a", "amount": False}, REQUIRED, MAX_AMOUNT)
+
+
+def test_negative_amount_raises_non_negative():
+    with pytest.raises(ValidationError, match="non-negative"):
+        validate_fields({"name": "a", "amount": -1}, REQUIRED, MAX_AMOUNT)
+
+
+def test_zero_amount_is_accepted():
+    result = validate_fields({"name": "a", "amount": 0}, REQUIRED, MAX_AMOUNT)
+    assert result["amount"] == 0
+
+
+def test_amount_over_max_raises_and_exact_max_accepted():
+    with pytest.raises(ValidationError, match="max_amount"):
+        validate_fields({"name": "a", "amount": MAX_AMOUNT + 1}, REQUIRED, MAX_AMOUNT)
+    result = validate_fields({"name": "a", "amount": MAX_AMOUNT}, REQUIRED, MAX_AMOUNT)
+    assert result["amount"] == MAX_AMOUNT
+
+
+def test_bad_name_raises_non_empty_string():
+    with pytest.raises(ValidationError, match="non-empty string"):
+        validate_fields({"name": "", "amount": 1}, REQUIRED, MAX_AMOUNT)
+    with pytest.raises(ValidationError, match="non-empty string"):
+        validate_fields({"name": "   ", "amount": 1}, REQUIRED, MAX_AMOUNT)
+    with pytest.raises(ValidationError, match="non-empty string"):
+        validate_fields({"name": 42, "amount": 1}, REQUIRED, MAX_AMOUNT)
+
+
+def test_success_returns_new_dict_with_stripped_name_and_preserved_keys():
+    fields = {"name": "  ada  ", "amount": 5, "note": "hi"}
+    result = validate_fields(fields, REQUIRED, MAX_AMOUNT)
+    assert result == {"name": "ada", "amount": 5, "note": "hi"}
