index 0000000..2b9b875
--- /dev/null
+++ b/app/rules.py
@@ -0,0 +1,140 @@
+"""Pure rule-combinator layer on top of app/schema.py's predicates.
+
+A "rule" is a plain dict ``{"name": str, "test": callable}``. Combinators
+(``all_of``, ``any_of``, ``negate``, ``when``) build composite rules whose
+names are deterministic strings derived from their children's names, so
+composed rules stay introspectable (``explain``, ``describe_rules``).
+"""
+from app import schema
+
+
+class RuleError(Exception):
+    """Raised for structural problems building/using a rule (not for a
+    failed check — a failed check is just `False`)."""
+
+
+def rule(name, predicate):
+    """Build a rule dict. name must be a non-empty string."""
+    if not isinstance(name, str) or name == "":
+        raise ValueError("rule name must be a non-empty string")
+    return {"name": name, "test": predicate}
+
+
+def check(value, r):
+    """Run r's predicate against value, coerced to bool."""
+    return bool(r["test"](value))
+
+
+def all_of(*rules):
+    """Composite rule passing iff every child passes. Named
+    "all(" + ",".join(child names) + ")". No children -> passes always."""
+    name = "all(%s)" % ",".join(r["name"] for r in rules)
+    return rule(name, lambda value: all(check(value, r) for r in rules))
+
+
+def any_of(*rules):
+    """Composite rule passing iff at least one child passes. No children
+    raises ValueError (vacuous any is a bug, not a policy)."""
+    if not rules:
+        raise ValueError("any_of() requires at least one rule")
+    name = "any(%s)" % ",".join(r["name"] for r in rules)
+    return rule(name, lambda value: any(check(value, r) for r in rules))
+
+
+def negate(r):
+    """Invert a rule. Named "not(<name>)"."""
+    return rule("not(%s)" % r["name"], lambda value: not check(value, r))
+
+
+def when(cond, then):
+    """Material implication: passes when cond fails OR then passes. Named
+    "when(<cond name>,<then name>)"."""
+    name = "when(%s,%s)" % (cond["name"], then["name"])
+    return rule(name, lambda value: (not check(value, cond)) or check(value, then))
+
+
+def explain(value, r):
+    """Return "<name>: pass" or "<name>: fail"."""
+    return "%s: %s" % (r["name"], "pass" if check(value, r) else "fail")
+
+
+def apply_rules(fields, rules_by_field):
+    """Return the list of "field <f> failed <rule name>" strings, in
+    rules_by_field insertion order, skipping fields absent from fields.
+    fields is never mutated."""
+    errors = []
+    for field, r in rules_by_field.items():
+        if field not in fields:
+            continue
+        if not check(fields[field], r):
+            errors.append("field %s failed %s" % (field, r["name"]))
+    return errors
+
+
+def first_failure(fields, rules_by_field):
+    """Return the (field, rule name) tuple of the first failure in
+    insertion order, or None."""
+    for field, r in rules_by_field.items():
+        if field not in fields:
+            continue
+        if not check(fields[field], r):
+            return (field, r["name"])
+    return None
+
+
+def explain_failures(fields, rules_by_field):
+    """Return explain(value, rule) strings for failing fields only, in
+    rules_by_field insertion order."""
+    result = []
+    for field, r in rules_by_field.items():
+        if field not in fields:
+            continue
+        if not check(fields[field], r):
+            result.append(explain(fields[field], r))
+    return result
+
+
+BUILTINS = {
+    "number": rule("number", lambda value: schema.is_valid_amount(value)),
+    "str": rule("str", lambda value: isinstance(value, str)),
+    "non_empty": rule("non_empty", lambda value: schema.is_non_empty_str(value)),
+}
+
+
+def parse_rule(text):
+    """Parse a "&"-joined builtin list into a single rule (all_of for more
+    than one token). Unknown token raises ValueError naming the token;
+    "" raises ValueError."""
+    if text == "":
+        raise ValueError("rule text must not be empty")
+    tokens = text.split("&")
+    parsed = []
+    for token in tokens:
+        if token not in BUILTINS:
+            raise ValueError("unknown rule token: %s" % token)
+        parsed.append(BUILTINS[token])
+    if len(parsed) == 1:
+        return parsed[0]
+    return all_of(*parsed)
+
+
+def parse_rules(text_by_field):
+    """Map a dict of field name -> "&"-joined rule text through
+    parse_rule, preserving insertion order. Unknown token raises
+    ValueError naming both the field and the token."""
+    result = {}
+    for field, text in text_by_field.items():
+        try:
+            result[field] = parse_rule(text)
+        except ValueError as err:
+            raise ValueError("field %s: %s" % (field, err))
+    return result
+
+
+def describe_rules(rules_by_field):
+    """Render "<field>: <rule name>" one per line, insertion order."""
+    if not rules_by_field:
+        return "(no rules)"
+    return "\n".join(
+        "%s: %s" % (field, r["name"]) for field, r in rules_by_field.items()
+    )
diff --git a/app/schema.py b/app/schema.py
new file mode 100644
index 0000000..0e5b217
--- /dev/null
+++ b/app/schema.py
@@ -0,0 +1,204 @@
+"""Declarative schema toolkit: error catalog, field predicates, and a
+compact "spec" mini-language for describing per-field validation rules.
+
+A spec is a plain dict: ``{field_name: rules_dict}`` where a rules dict may
+contain any of ``required`` (bool), ``type`` ("str" or "number"),
+``non_empty`` (bool), and ``max`` (number). ``compile_spec`` turns a spec
+into a reusable validator callable; ``validate_collect`` runs the same
+checks but collects every error instead of raising on the first.
+"""
+import math
+
+
+class SchemaError(Exception):
+    """Raised by a compiled validator when a field fails a spec rule."""
+
+
+ERROR_CATALOG = {
+    "missing": "missing field: {field}",
+    "numeric": "field {field} must be numeric (got {got})",
+    "non_negative": "field {field} must be non-negative",
+    "max": "field {field} exceeds max_amount {limit}",
+    "non_empty": "field {field} must be a non-empty string",
+    "type_str": "field {field} must be a string",
+}
+
+_LEGAL_RULE_KEYS = {"required", "type", "non_empty", "max"}
+_LEGAL_TYPE_VALUES = {"str", "number"}
+
+
+def format_error(code, **kwargs):
+    """Render the named catalog template with kwargs. Raises KeyError for
+    an unknown code (never a silent fallback message)."""
+    template = ERROR_CATALOG[code]
+    return template.format(**kwargs)
+
+
+def check_required(fields, required_fields):
+    """Return the list of required_fields absent from fields, in
+    required_fields order (not dict order)."""
+    return [name for name in required_fields if name not in fields]
+
+
+def is_valid_amount(value):
+    """True for a non-bool int/float that is finite. Overflowing ints are
+    always finite in Python (they don't go through math.isfinite, which
+    would raise OverflowError trying to convert to a float)."""
+    if isinstance(value, bool):
+        return False
+    if isinstance(value, int):
+        return True
+    if isinstance(value, float):
+        return math.isfinite(value)
+    return False
+
+
+def is_non_empty_str(value):
+    """True iff value is a str with non-whitespace content."""
+    return isinstance(value, str) and value.strip() != ""
+
+
+def compile_spec(spec):
+    """Compile a declarative field spec into a validator callable.
+
+    Compile-time checks: an unknown rule key raises ValueError naming the
+    key; an unknown "type" value raises ValueError naming the value.
+    """
+    _check_spec_legal(spec)
+
+    def validator(fields):
+        _check_required_or_raise(spec, fields)
+        result = dict(fields)
+        for field, rules in spec.items():
+            if field not in fields:
+                continue
+            result[field] = _apply_field_rules_or_raise(field, rules, fields[field])
+        return result
+
+    return validator
+
+
+def _check_spec_legal(spec):
+    for field, rules in spec.items():
+        for key, value in rules.items():
+            if key not in _LEGAL_RULE_KEYS:
+                raise ValueError("unknown rule key: %s" % key)
+            if key == "type" and value not in _LEGAL_TYPE_VALUES:
+                raise ValueError("unknown type value: %s" % value)
+
+
+def _check_required_or_raise(spec, fields):
+    for field, rules in spec.items():
+        if rules.get("required") and field not in fields:
+            raise SchemaError(format_error("missing", field=field))
+
+
+def _apply_field_rules_or_raise(field, rules, value):
+    if rules.get("type") == "number":
+        if not is_valid_amount(value):
+            raise SchemaError(
+                format_error("numeric", field=field, got=type(value).__name__)
+            )
+    elif rules.get("type") == "str":
+        if not isinstance(value, str):
+            raise SchemaError(format_error("type_str", field=field))
+    if rules.get("non_empty"):
+        if not is_non_empty_str(value):
+            raise SchemaError(format_error("non_empty", field=field))
+    if "max" in rules:
+        if not is_valid_amount(value):
+            raise SchemaError(
+                format_error("numeric", field=field, got=type(value).__name__)
+            )
+        if value > rules["max"]:
+            raise SchemaError(format_error("max", field=field, limit=rules["max"]))
+    if rules.get("non_empty"):
+        return value.strip()
+    return value
+
+
+def merge_specs(a, b):
+    """Return a new spec that is the union of a and b. A field/key present
+    in both with unequal values raises ValueError naming both; equal
+    values merge silently. Neither input is mutated."""
+    merged = {field: dict(rules) for field, rules in a.items()}
+    for field, rules in b.items():
+        if field not in merged:
+            merged[field] = dict(rules)
+            continue
+        existing = merged[field]
+        for key, value in rules.items():
+            if key in existing and existing[key] != value:
+                raise ValueError(
+                    "conflicting rule for field %s, key %s" % (field, key)
+                )
+            existing[key] = value
+    return merged
+
+
+def describe_spec(spec):
+    """Render an exact multi-line string: one line per field in sorted
+    field order, rule keys sorted and comma-joined."""
+    if not spec:
+        return "(empty spec)"
+    lines = []
+    for field in sorted(spec):
+        rules = spec[field]
+        rule_str = ", ".join(
+            "%s=%s" % (key, rules[key]) for key in sorted(rules)
+        )
+        lines.append("%s: %s" % (field, rule_str))
+    return "\n".join(lines)
+
+
+def diff_specs(a, b):
+    """Return {"added": [...], "removed": [...], "changed": [...]} — field
+    names only in b, only in a, and in both with unequal rules dicts, each
+    sorted. Neither input is mutated."""
+    a_keys = set(a)
+    b_keys = set(b)
+    added = sorted(b_keys - a_keys)
+    removed = sorted(a_keys - b_keys)
+    changed = sorted(field for field in (a_keys & b_keys) if a[field] != b[field])
+    return {"added": added, "removed": removed, "changed": changed}
+
+
+def spec_from_config(config, prefix):
+    """Collect every config key starting with prefix, strip the prefix to
+    get the field name, and use the value as that field's rules."""
+    spec = {}
+    for key, value in config.items():
+        if key.startswith(prefix):
+            spec[key[len(prefix):]] = value
+    return spec
+
+
+def spec_to_config(spec, prefix):
+    """Inverse of spec_from_config: {prefix + field: rules_copy}."""
+    return {prefix + field: dict(rules) for field, rules in spec.items()}
+
+
+def spec_summary_line(spec):
+    """Return "<N> fields, <M> rules"."""
+    n = len(spec)
+    m = sum(len(rules) for rules in spec.values())
+    return "%d fields, %d rules" % (n, m)
+
+
+def validate_collect(spec, fields):
+    """Like a compiled validator but collects every error into a list
+    instead of raising on the first. Required-miss messages first in spec
+    order, then at most one message per present field (first failing rule
+    in type -> non_empty -> max order), [] when clean."""
+    errors = []
+    for field, rules in spec.items():
+        if rules.get("required") and field not in fields:
+            errors.append(format_error("missing", field=field))
+    for field, rules in spec.items():
+        if field not in fields:
+            continue
+        try:
+            _apply_field_rules_or_raise(field, rules, fields[field])
+        except SchemaError as err:
+            errors.append(str(err))
+    return errors
diff --git a/app/tabular.py b/app/tabular.py
new file mode 100644
index 0000000..7e53bd6
--- /dev/null
+++ b/app/tabular.py
@@ -0,0 +1,129 @@
+"""Column-model toolkit: the shared building blocks app/export.py's
+format renderers (CSV/JSON/MD/NDJSON/TSV/HTML) are built from.
+
+Nothing here is route-reachable on its own; it exists so export.py never
+duplicates key-union, cell-stringification, or escaping logic across its
+six renderers.
+"""
+
+
+def columns(records):
+    """Sorted union of every key across all records."""
+    keys = set()
+    for record in records:
+        keys.update(record.keys())
+    return sorted(keys)
+
+
+def cell(value):
+    """Plain str() rendering of a value, except None -> ""."""
+    if value is None:
+        return ""
+    return str(value)
+
+
+def escape_csv(value):
+    """CSV-escape a cell: quote the whole cell and double inner quotes if
+    it contains a comma, quote, or newline. Plain cells pass through
+    unquoted, including the empty string."""
+    text = cell(value)
+    if any(ch in text for ch in (",", '"', "\n", "\r")):
+        return '"' + text.replace('"', '""') + '"'
+    return text
+
+
+def widths(records, cols):
+    """Map each column name to max(len(header), max cell width)."""
+    result = {}
+    for col in cols:
+        widest = len(col)
+        for record in records:
+            widest = max(widest, len(cell(record.get(col))))
+        result[col] = widest
+    return result
+
+
+def pad(value, width, align):
+    """Pad `value` to `width` using `align` ("left" or "right"). A value
+    already at or beyond `width` is returned unchanged. `align` is
+    validated before any short-circuit on width."""
+    if align not in ("left", "right"):
+        raise ValueError("unknown align: %s" % align)
+    if len(value) >= width:
+        return value
+    padding = " " * (width - len(value))
+    if align == "left":
+        return value + padding
+    return padding + value
+
+
+def sanitize_flat(value):
+    """Render `cell(value)` with every tab/newline replaced by a single
+    space, for flat single-line formats (TSV)."""
+    text = cell(value)
+    return text.replace("\t", " ").replace("\n", " ").replace("\r", " ")
+
+
+def escape_html(value):
+    """Render `cell(value)` HTML-escaped: & first, then < > "."""
+    text = cell(value)
+    text = text.replace("&", "&amp;")
+    text = text.replace("<", "&lt;")
+    text = text.replace(">", "&gt;")
+    text = text.replace('"', "&quot;")
+    return text
+
+
+def truncate(value, width, marker="..."):
+    """Return `value` unchanged if it fits in `width`; otherwise the first
+    `width - len(marker)` characters plus `marker`."""
+    if width < len(marker):
+        raise ValueError("width %d is narrower than marker %r" % (width, marker))
+    if len(value) <= width:
+        return value
+    return value[: width - len(marker)] + marker
+
+
+def wrap(value, width):
+    """Greedily wrap `value` on spaces into lines each <= width. A single
+    word longer than `width` is hard-split at `width`."""
+    if width < 1:
+        raise ValueError("width must be >= 1: %r" % width)
+    if value == "":
+        return [""]
+
+    lines = []
+    current = ""
+    for word in value.split(" "):
+        while len(word) > width:
+            if current:
+                lines.append(current)
+                current = ""
+            lines.append(word[:width])
+            word = word[width:]
+        candidate = word if not current else current + " " + word
+        if len(candidate) <= width:
+            current = candidate
+        else:
+            if current:
+                lines.append(current)
+            current = word
+    if current or not lines:
+        lines.append(current)
+    return lines
+
+
+def fit(value, width, align):
+    """Compose truncate() then pad(): an over-long value is truncated to
+    `width` (marker included); a short one is padded per `align`."""
+    return pad(truncate(value, width), width, align)
+
+
+def render_row(cells, widths_list, align):
+    """Render one pipe-table row: "| " + " | ".join(padded cells) + " |"."""
+    if len(cells) != len(widths_list):
+        raise ValueError(
+            "cells/widths length mismatch: %d != %d" % (len(cells), len(widths_list))
+        )
+    padded = [pad(c, w, align) for c, w in zip(cells, widths_list)]
+    return "| " + " | ".join(padded) + " |"
diff --git a/app/throttle.py b/app/throttle.py
new file mode 100644
index 0000000..72e9e80
--- /dev/null
+++ b/app/throttle.py
@@ -0,0 +1,84 @@
+"""A pure policy layer over `app/quota.py`'s windowed counter.
+
+This module has no module state of its own beyond the `POLICIES`
+constant, and never imports `app.ratelimit` -- it is a library layer for
+future routes, not wired into the registry.
+"""
+from app import quota
+
+
+class PolicyError(Exception):
+    pass
+
+
+POLICIES = {
+    "POST /records": {"limit": 5, "window": 60, "burst": 0},
+    "GET /export": {"limit": 10, "window": 60, "burst": 2},
+}
+
+
+def match_policy(method, path, policies):
+    """Return the policy dict for the longest "<method> <prefix>" key
+    whose method matches `method` and whose prefix is a prefix of `path`.
+    None if nothing matches."""
+    best_key = None
+    best_policy = None
+    for key, policy in policies.items():
+        pmethod, _, prefix = key.partition(" ")
+        if pmethod != method:
+            continue
+        if not path.startswith(prefix):
+            continue
+        if best_key is None or len(prefix) > len(best_key.partition(" ")[2]):
+            best_key = key
+            best_policy = policy
+    return best_policy
+
+
+def key_for(method, path, actor):
+    """Return the quota key for a (method, path, actor) triple."""
+    return "%s %s:%s" % (method, path, actor)
+
+
+def enforce(method, path, actor, policies):
+    """Enforce whichever policy matches (method, path). Returns None (and
+    records nothing) if no policy matches. Otherwise records a hit via
+    quota.take and returns the new in-window count, or raises PolicyError
+    (chained from quota.QuotaExceededError) once exhausted."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    key = key_for(method, path, actor)
+    try:
+        return quota.take(
+            key, policy["limit"], policy["window"], burst=policy["burst"]
+        )
+    except quota.QuotaExceededError as exc:
+        raise PolicyError(str(exc)) from exc
+
+
+def remaining_for(method, path, actor, policies):
+    """Remaining allowance for (method, path, actor), or None if no
+    policy matches. Read-only."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    key = key_for(method, path, actor)
+    return quota.remaining(
+        key, policy["limit"], policy["window"], burst=policy["burst"]
+    )
+
+
+def describe_policies(policies):
+    """Render an exact multi-line description of `policies`, one line per
+    key, sorted. "(no policies)" when empty."""
+    if not policies:
+        return "(no policies)"
+    lines = []
+    for key in sorted(policies):
+        policy = policies[key]
+        lines.append(
+            "%s: limit=%s, window=%s, burst=%s"
+            % (key, policy["limit"], policy["window"], policy["burst"])
+        )
+    return "\n".join(lines)
diff --git a/app/validation.py b/app/validation.py
new file mode 100644
index 0000000..e928490
--- /dev/null
+++ b/app/validation.py
@@ -0,0 +1,102 @@
+"""Input-validation layer wired into PRE_CREATE_HOOKS: validates `name`/
+`amount` on record creation using app/schema.py's catalog and predicates.
+
+No error-message string literals live in this module — every message is
+built by `schema.format_error` so the catalog is the single source of
+truth for wording.
+"""
+import re
+
+from app import schema
+
+
+class ValidationError(Exception):
+    """Raised by validate_fields when a field fails validation."""
+
+
+def validate_fields(fields, required_fields, max_amount):
+    """Validate fields against required_fields presence and, when present,
+    amount/name-specific rules. Returns a new dict (shallow copy) with
+    `name` stripped; other keys/values pass through unchanged."""
+    missing = schema.check_required(fields, required_fields)
+    if missing:
+        raise ValidationError(schema.format_error("missing", field=missing[0]))
+
+    result = dict(fields)
+
+    if "amount" in fields:
+        amount = fields["amount"]
+        if not schema.is_valid_amount(amount):
+            raise ValidationError(
+                schema.format_error(
+                    "numeric", field="amount", got=type(amount).__name__
+                )
+            )
+        if amount < 0:
+            raise ValidationError(schema.format_error("non_negative", field="amount"))
+        if amount > max_amount:
+            raise ValidationError(
+                schema.format_error("max", field="amount", limit=max_amount)
+            )
+
+    if "name" in fields:
+        name = fields["name"]
+        if not schema.is_non_empty_str(name):
+            raise ValidationError(schema.format_error("non_empty", field="name"))
+        result["name"] = name.strip()
+
+    return result
+
+
+def pre_create_hook(store, config, fields):
+    """PRE_CREATE_HOOKS-shaped wrapper around validate_fields; `store` is
+    unused."""
+    return validate_fields(
+        fields,
+        config["validation_required_fields"],
+        config["validation_max_amount"],
+    )
+
+
+def validate_many(entries, required_fields, max_amount):
+    """Validate a list of fields dicts. Returns (validated, errors):
+    validated is the list of successfully-validated new dicts in input
+    order; errors is a list of (index, str(err)) tuples for failures, also
+    in input order."""
+    validated = []
+    errors = []
+    for index, fields in enumerate(entries):
+        try:
+            validated.append(validate_fields(fields, required_fields, max_amount))
+        except ValidationError as err:
+            errors.append((index, str(err)))
+    return validated, errors
+
+
+def _template_to_regex(template):
+    """Turn a str.format template into a regex that matches any rendering
+    of it: literal parts are escaped, each {placeholder} becomes a
+    non-greedy wildcard."""
+    parts = re.split(r"\{[^{}]*\}", template)
+    return "^" + ".*?".join(re.escape(part) for part in parts) + "$"
+
+
+def error_code(message):
+    """Map an error message string back to its ERROR_CATALOG code by
+    matching against the catalog's templates (built at call time, not a
+    second hand-written table)."""
+    for code, template in schema.ERROR_CATALOG.items():
+        if re.match(_template_to_regex(template), message):
+            return code
+    raise ValueError("unrecognized error message: %s" % message)
+
+
+def explain_config(config):
+    """Render "validation config:\\n  required: <fields>\\n  max_amount:
+    <value>" from config."""
+    required = ",".join(config["validation_required_fields"])
+    max_amount = config["validation_max_amount"]
+    return "validation config:\n  required: %s\n  max_amount: %s" % (
+        required,
+        max_amount,
+    )
diff --git a/tests/test_audit.py b/tests/test_audit.py
new file mode 100644
index 0000000..5efb43b
--- /dev/null
+++ b/tests/test_audit.py
@@ -0,0 +1,157 @@
+"""Tests for app/audit.py -- the module-global dispatch audit log."""
+from app import audit
+
+
+def test_entries_empty_on_fresh_log():
+    audit.clear()
+    assert audit.entries() == []
+
+
+def test_record_appends_one_entry():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
+
+
+def test_entries_are_in_call_order():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    audit.record("POST", "/records", "bob", 500)
+    audit.record("DELETE", "/records/1", "carol", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+
+
+def test_entries_returns_a_copy():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    first = audit.entries()
+    first.append({"method": "X", "path": "Y", "actor": "Z"})
+    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
+
+
+def test_cap_drops_oldest_first():
+    audit.clear()
+    audit.record("GET", "/a", "a1", 3)
+    audit.record("GET", "/b", "a2", 3)
+    audit.record("GET", "/c", "a3", 3)
+    audit.record("GET", "/d", "a4", 3)
+    assert len(audit.entries()) == 3
+    assert audit.entries() == [
+        {"method": "GET", "path": "/b", "actor": "a2"},
+        {"method": "GET", "path": "/c", "actor": "a3"},
+        {"method": "GET", "path": "/d", "actor": "a4"},
+    ]
+
+
+def test_cap_enforced_on_every_call_not_just_at_the_end():
+    audit.clear()
+    for i in range(5):
+        audit.record("GET", "/p%d" % i, "actor%d" % i, 2)
+        assert len(audit.entries()) <= 2
+
+
+def test_dispatch_hook_defaults_actor_to_anonymous():
+    audit.clear()
+    audit.dispatch_hook(None, {}, "GET", "/records", {})
+    entries = audit.entries()
+    assert len(entries) == 1
+    assert entries[0]["actor"] == "anonymous"
+    assert entries[0]["method"] == "GET"
+    assert entries[0]["path"] == "/records"
+
+
+def test_dispatch_hook_uses_actor_kwarg_and_only_logs_three_keys():
+    audit.clear()
+    audit.dispatch_hook(None, {}, "POST", "/records", {"actor": "bob", "name": "x"})
+    entries = audit.entries()
+    assert len(entries) == 1
+    assert entries[0] == {"method": "POST", "path": "/records", "actor": "bob"}
+    assert "name" not in entries[0]
+
+
+def test_dispatch_hook_reads_cap_from_config():
+    audit.clear()
+    config = {"audit_log_max_entries": 1}
+    audit.dispatch_hook(None, config, "GET", "/records", {})
+    audit.dispatch_hook(None, config, "GET", "/records", {})
+    assert len(audit.entries()) == 1
+
+
+def test_dispatch_hook_fires_for_every_method():
+    audit.clear()
+    audit.dispatch_hook(None, {}, "DELETE", "/records/1", {})
+    audit.dispatch_hook(None, {}, "PUT", "/records/1", {})
+    methods = [e["method"] for e in audit.entries()]
+    assert methods == ["DELETE", "PUT"]
+
+
+def test_record_many_enforces_cap_after_every_append_and_returns_count():
+    audit.clear()
+    triples = [
+        ("GET", "/a", "a1"),
+        ("GET", "/b", "a2"),
+        ("GET", "/c", "a3"),
+        ("GET", "/d", "a4"),
+    ]
+    seen_max_len = []
+    original_record = audit.record
+
+    def recording_record(method, path, actor, max_entries):
+        original_record(method, path, actor, max_entries)
+        seen_max_len.append(len(audit.entries()))
+
+    audit.record = recording_record
+    try:
+        count = audit.record_many(triples, 2)
+    finally:
+        audit.record = original_record
+    assert count == 4
+    assert all(n <= 2 for n in seen_max_len)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/c", "actor": "a3"},
+        {"method": "GET", "path": "/d", "actor": "a4"},
+    ]
+
+
+def test_dropped_tracks_evictions_since_clear():
+    audit.clear()
+    assert audit.dropped() == 0
+    for i in range(5):
+        audit.record("GET", "/p%d" % i, "actor%d" % i, 3)
+    assert audit.dropped() == 2
+    audit.clear()
+    assert audit.dropped() == 0
+
+
+def test_export_state_is_a_deep_enough_copy():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    state = audit.export_state()
+    assert state == {
+        "entries": [{"method": "GET", "path": "/records", "actor": "alice"}],
+        "dropped": 0,
+    }
+    state["entries"].append({"method": "X", "path": "Y", "actor": "Z"})
+    state["entries"][0]["actor"] = "mutated"
+    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
+
+
+def test_import_state_round_trip_and_does_not_leak_later_mutations():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    audit.record("POST", "/records", "bob", 500)
+    for i in range(3):
+        audit.record("GET", "/x%d" % i, "actorx", 3)
+    exported = audit.export_state()
+    audit.clear()
+    audit.import_state(exported)
+    assert audit.entries() == exported["entries"]
+    assert audit.dropped() == exported["dropped"]
+    exported["entries"].append({"method": "X", "path": "Y", "actor": "Z"})
+    exported["dropped"] = 999
+    assert len(audit.entries()) != len(exported["entries"])
+    assert audit.dropped() != 999
diff --git a/tests/test_audit_query.py b/tests/test_audit_query.py
new file mode 100644
index 0000000..08e3c4a
--- /dev/null
+++ b/tests/test_audit_query.py
@@ -0,0 +1,351 @@
+"""Tests for app/audit_query.py -- a pure read-side module over audit
+entry lists. Every function takes `entries` as a plain list argument; this
+module must never import app.audit (the one integration test at the
+bottom composes the two modules itself)."""
+import pytest
+
+from app import audit_query
+
+
+def _canonical():
+    """4-entry fixture reused by several tests."""
+    return [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "GET", "path": "/report", "actor": "alice"},
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+
+
+def _matrix_fixture():
+    """One method (GET) used by two actors; one actor (alice) uses two
+    methods."""
+    return [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "GET", "path": "/records", "actor": "bob"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+
+
+def test_filter_entries_by_each_criterion_and_combined():
+    entries = _canonical()
+    assert audit_query.filter_entries(entries, actor="alice") == [
+        entries[0], entries[2],
+    ]
+    assert audit_query.filter_entries(entries, method="POST") == [entries[1]]
+    assert audit_query.filter_entries(entries, path="/records") == [
+        entries[0], entries[1],
+    ]
+    assert audit_query.filter_entries(entries, actor="alice", method="GET") == [
+        entries[0], entries[2],
+    ]
+    assert audit_query.filter_entries(entries) == entries
+    result = audit_query.filter_entries(entries, actor="alice")
+    result.append({"method": "X", "path": "Y", "actor": "Z"})
+    assert audit_query.filter_entries(entries, actor="alice") == [
+        entries[0], entries[2],
+    ]
+    # input unmutated
+    assert entries == _canonical()
+
+
+def test_counts_by_each_field_and_errors():
+    entries = _canonical()
+    assert audit_query.counts_by(entries, "method") == {
+        "GET": 2, "POST": 1, "DELETE": 1,
+    }
+    assert audit_query.counts_by(entries, "actor") == {
+        "alice": 2, "bob": 1, "carol": 1,
+    }
+    assert audit_query.counts_by(entries, "path") == {
+        "/records": 2, "/report": 1, "/records/1": 1,
+    }
+    with pytest.raises(ValueError):
+        audit_query.counts_by(entries, "nope")
+    assert audit_query.counts_by([], "method") == {}
+    assert entries == _canonical()
+
+
+def test_last_n():
+    entries = _canonical()
+    assert audit_query.last_n(entries, 2) == entries[2:]
+    assert audit_query.last_n(entries, 0) == []
+    result = audit_query.last_n(entries, 100)
+    assert result == entries
+    assert result is not entries
+    with pytest.raises(ValueError):
+        audit_query.last_n(entries, -1)
+    assert entries == _canonical()
+
+
+def test_redact():
+    entries = _canonical()
+    redacted = audit_query.redact(entries, ["actor"])
+    assert redacted == [
+        {"method": "GET", "path": "/records", "actor": "***"},
+        {"method": "POST", "path": "/records", "actor": "***"},
+        {"method": "GET", "path": "/report", "actor": "***"},
+        {"method": "DELETE", "path": "/records/1", "actor": "***"},
+    ]
+    assert entries == _canonical()
+
+    unredacted = audit_query.redact(entries, [])
+    assert unredacted == entries
+    assert unredacted is not entries
+    assert all(a is not b for a, b in zip(unredacted, entries))
+
+    with pytest.raises(ValueError):
+        audit_query.redact(entries, ["nope"])
+
+
+def test_summary():
+    assert audit_query.summary([]) == {
+        "total": 0, "by_method": {}, "by_actor": {}, "first": None, "last": None,
+    }
+    entries = _canonical()
+    result = audit_query.summary(entries)
+    assert result == {
+        "total": 4,
+        "by_method": {"GET": 2, "POST": 1, "DELETE": 1},
+        "by_actor": {"alice": 2, "bob": 1, "carol": 1},
+        "first": entries[0],
+        "last": entries[3],
+    }
+    assert result["first"] is not entries[0]
+    assert result["last"] is not entries[3]
+
+
+def test_recent():
+    entries = [
+        {"method": "GET", "path": "/a", "actor": "x"},
+        {"method": "GET", "path": "/b", "actor": "y"},
+        {"method": "GET", "path": "/c", "actor": "z"},
+    ]
+    config = {"audit_query_default_limit": 2}
+    assert audit_query.recent(entries, config) == audit_query.last_n(entries, 2)
+    assert audit_query.recent(entries, config) == entries[1:]
+
+
+def test_paginate():
+    entries = [
+        {"method": "GET", "path": "/%d" % i, "actor": "a%d" % i} for i in range(5)
+    ]
+    assert audit_query.paginate(entries, 1, 2) == {
+        "page": 1, "pages": 3, "total": 5, "items": entries[0:2],
+    }
+    assert audit_query.paginate(entries, 2, 2) == {
+        "page": 2, "pages": 3, "total": 5, "items": entries[2:4],
+    }
+    assert audit_query.paginate(entries, 3, 2) == {
+        "page": 3, "pages": 3, "total": 5, "items": entries[4:5],
+    }
+    assert audit_query.paginate(entries, 4, 2) == {
+        "page": 4, "pages": 3, "total": 5, "items": [],
+    }
+    assert audit_query.paginate([], 1, 2) == {
+        "page": 1, "pages": 0, "total": 0, "items": [],
+    }
+    with pytest.raises(ValueError):
+        audit_query.paginate(entries, 0, 2)
+    with pytest.raises(ValueError):
+        audit_query.paginate(entries, 1, 0)
+    result = audit_query.paginate(entries, 1, 2)
+    result["items"].append({"method": "X", "path": "Y", "actor": "Z"})
+    assert entries == [
+        {"method": "GET", "path": "/%d" % i, "actor": "a%d" % i} for i in range(5)
+    ]
+
+
+def test_to_report():
+    entries = _canonical()
+    expected = (
+        "audit report\n"
+        "total: 4\n"
+        "\n"
+        "by method:\n"
+        "  DELETE: 1\n"
+        "  GET: 2\n"
+        "  POST: 1\n"
+        "\n"
+        "by actor:\n"
+        "  alice: 2\n"
+        "  bob: 1\n"
+        "  carol: 1"
+    )
+    assert audit_query.to_report(entries) == expected
+    assert audit_query.to_report([]) == "audit report\ntotal: 0"
+
+
+def test_to_csv_report():
+    entries = _canonical()
+    expected = (
+        "field,value,count\n"
+        "method,DELETE,1\n"
+        "method,GET,2\n"
+        "method,POST,1\n"
+        "actor,alice,2\n"
+        "actor,bob,1\n"
+        "actor,carol,1"
+    )
+    assert audit_query.to_csv_report(entries) == expected
+    assert audit_query.to_csv_report([]) == "field,value,count"
+
+
+def test_to_markdown_report():
+    entries = _canonical()
+    expected = (
+        "| field | value | count |\n"
+        "| --- | --- | --- |\n"
+        "| method | DELETE | 1 |\n"
+        "| method | GET | 2 |\n"
+        "| method | POST | 1 |\n"
+        "| actor | alice | 2 |\n"
+        "| actor | bob | 1 |\n"
+        "| actor | carol | 1 |"
+    )
+    assert audit_query.to_markdown_report(entries) == expected
+    assert audit_query.to_markdown_report([]) == (
+        "| field | value | count |\n"
+        "| --- | --- | --- |"
+    )
+
+
+def test_top_actors_tie_break():
+    entries = [
+        {"method": "GET", "path": "/r", "actor": "bob"},
+        {"method": "GET", "path": "/r", "actor": "alice"},
+        {"method": "GET", "path": "/r", "actor": "alice"},
+        {"method": "GET", "path": "/r", "actor": "bob"},
+        {"method": "GET", "path": "/r", "actor": "carol"},
+    ]
+    assert audit_query.top_actors(entries, 3) == [
+        ("alice", 2), ("bob", 2), ("carol", 1),
+    ]
+    assert audit_query.top_actors(entries, 2) == [("alice", 2), ("bob", 2)]
+    assert audit_query.top_actors(entries, 0) == []
+    with pytest.raises(ValueError):
+        audit_query.top_actors(entries, -1)
+
+
+def test_merge_entries():
+    a = [{"method": "GET", "path": "/a", "actor": "x"}]
+    b = [{"method": "POST", "path": "/b", "actor": "y"}]
+    merged = audit_query.merge_entries(a, b)
+    assert merged == [
+        {"method": "GET", "path": "/a", "actor": "x"},
+        {"method": "POST", "path": "/b", "actor": "y"},
+    ]
+    merged[0]["actor"] = "mutated"
+    assert a == [{"method": "GET", "path": "/a", "actor": "x"}]
+    assert b == [{"method": "POST", "path": "/b", "actor": "y"}]
+    assert audit_query.merge_entries() == []
+
+
+def test_diff_summaries():
+    a_entries = [
+        {"method": "GET", "path": "/r", "actor": "alice"},
+        {"method": "GET", "path": "/r", "actor": "bob"},
+        {"method": "POST", "path": "/r", "actor": "alice"},
+    ]
+    b_entries = [
+        {"method": "GET", "path": "/r", "actor": "alice"},
+        {"method": "GET", "path": "/r", "actor": "bob"},
+        {"method": "GET", "path": "/r", "actor": "dave"},
+    ]
+    a_summary = audit_query.summary(a_entries)
+    b_summary = audit_query.summary(b_entries)
+    assert audit_query.diff_summaries(a_summary, b_summary) == {
+        "total": 0,
+        "by_method": {"GET": 1, "POST": -1},
+        "by_actor": {"alice": -1, "dave": 1},
+    }
+
+
+def test_counts_matrix():
+    entries = _matrix_fixture()
+    assert audit_query.counts_matrix(entries) == {
+        "GET": {"alice": 1, "bob": 1},
+        "POST": {"alice": 1},
+        "DELETE": {"carol": 1},
+    }
+    assert audit_query.counts_matrix([]) == {}
+
+
+def test_rollup():
+    entries = _matrix_fixture()
+    assert audit_query.rollup(entries, ["method"]) == audit_query.counts_by(
+        entries, "method"
+    )
+    assert audit_query.rollup(entries, ["method", "actor"]) == audit_query.counts_matrix(
+        entries
+    )
+    assert audit_query.rollup(entries, ["actor", "method", "path"]) == {
+        "alice": {
+            "GET": {"/records": 1},
+            "POST": {"/records": 1},
+        },
+        "bob": {
+            "GET": {"/records": 1},
+        },
+        "carol": {
+            "DELETE": {"/records/1": 1},
+        },
+    }
+    assert audit_query.rollup([], ["method"]) == {}
+    with pytest.raises(ValueError):
+        audit_query.rollup(entries, [])
+    with pytest.raises(ValueError):
+        audit_query.rollup(entries, ["nope"])
+    with pytest.raises(ValueError):
+        audit_query.rollup(entries, ["method", "method"])
+
+
+def test_format_entry_and_to_lines():
+    entries = _canonical()[:3]
+    assert audit_query.format_entry(entries[0]) == "GET /records (alice)"
+    with pytest.raises(ValueError):
+        audit_query.format_entry({"method": "GET", "path": "/records"})
+    assert audit_query.to_lines(entries) == [
+        "GET /records (alice)",
+        "POST /records (bob)",
+        "GET /report (alice)",
+    ]
+    assert audit_query.to_lines([]) == []
+
+
+def test_group_by():
+    entries = _canonical()
+    grouped = audit_query.group_by(entries, "actor")
+    assert grouped == {
+        "alice": [entries[0], entries[2]],
+        "bob": [entries[1]],
+        "carol": [entries[3]],
+    }
+    grouped["alice"][0]["actor"] = "mutated"
+    assert entries[0]["actor"] == "alice"
+    assert audit_query.group_by([], "method") == {}
+    with pytest.raises(ValueError):
+        audit_query.group_by(entries, "nope")
+
+
+def test_search():
+    entries = [
+        {"method": "GET", "path": "/widgets", "actor": "nina"},
+        {"method": "POST", "path": "/records", "actor": "widgetfan"},
+        {"method": "DELETE", "path": "/other", "actor": "carol"},
+    ]
+    assert audit_query.search(entries, "widget") == [entries[0], entries[1]]
+    assert audit_query.search(entries, "zzz") == []
+    with pytest.raises(ValueError):
+        audit_query.search(entries, "")
+
+
+def test_integration_with_audit_module():
+    from app import audit
+
+    audit.clear()
+    audit.dispatch_hook(None, {}, "GET", "/records", {"actor": "alice"})
+    audit.dispatch_hook(None, {}, "GET", "/records", {"actor": "bob"})
+    result = audit_query.filter_entries(audit.entries(), actor="bob")
+    assert result == [{"method": "GET", "path": "/records", "actor": "bob"}]
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..5f8fe74
