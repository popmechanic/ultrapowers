new file mode 100644
index 0000000..873e985
--- /dev/null
+++ b/app/throttle.py
@@ -0,0 +1,83 @@
+"""Route-policy layer over the quota counter.
+
+A policy table maps `"<METHOD> <path-prefix>"` to a dict of quota params
+(`limit`, `window`, `burst`). `enforce` looks up the most specific matching
+policy and spends one slot against `app.quota`.
+
+This is a library layer for future routes: it is deliberately not wired
+into the registry, holds no state beyond the `POLICIES` constant, and
+imports `app.quota` only — never `app.ratelimit`.
+"""
+from app import quota
+
+POLICIES = {
+    "POST /records": {"limit": 5, "window": 60, "burst": 0},
+    "GET /export": {"limit": 10, "window": 60, "burst": 2},
+}
+
+
+class PolicyError(Exception):
+    """Raised when a request exceeds the policy governing its route."""
+
+
+def match_policy(method, path, policies):
+    """The policy for `method`/`path`, or None.
+
+    A policy key matches when its method is `method` and its path-prefix is
+    a prefix of `path`; the longest matching prefix wins.
+    """
+    best_prefix = None
+    best_policy = None
+    for key, policy in policies.items():
+        key_method, _, prefix = key.partition(" ")
+        if key_method != method or not path.startswith(prefix):
+            continue
+        if best_prefix is None or len(prefix) > len(best_prefix):
+            best_prefix = prefix
+            best_policy = policy
+    return best_policy
+
+
+def key_for(method, path, actor):
+    """The quota key a request is counted under."""
+    return "%s %s:%s" % (method, path, actor)
+
+
+def enforce(method, path, actor, policies):
+    """Spend one slot for this request; return its in-window count.
+
+    Returns None when no policy matches (nothing is recorded); raises
+    PolicyError when the matching policy is exhausted.
+    """
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    key = key_for(method, path, actor)
+    try:
+        return quota.take(key, policy["limit"], policy["window"],
+                          burst=policy.get("burst", 0))
+    except quota.QuotaExceededError as exc:
+        raise PolicyError(
+            "policy limit exceeded for %s: limit %s"
+            % (key, policy["limit"])) from exc
+
+
+def remaining_for(method, path, actor, policies):
+    """Slots left for this request's policy, or None when none matches."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    return quota.remaining(key_for(method, path, actor), policy["limit"],
+                           policy["window"], burst=policy.get("burst", 0))
+
+
+def describe_policies(policies):
+    """Render the policy table as one sorted line per key."""
+    if not policies:
+        return "(no policies)"
+    return "\n".join(
+        "%s: limit=%s, window=%s, burst=%s"
+        % (key, policies[key]["limit"], policies[key]["window"],
+           policies[key].get("burst", 0))
+        for key in sorted(policies)
+    )
diff --git a/app/validation.py b/app/validation.py
new file mode 100644
index 0000000..942c652
--- /dev/null
+++ b/app/validation.py
@@ -0,0 +1,121 @@
+"""Input validation for record creation.
+
+`validate_fields` is the single entry point: it checks required-field
+presence first (in `required_fields` order), then the `amount` and `name`
+fields *only when they are present* — a differently-configured caller may
+not require either — and returns a normalized copy of the input.
+
+Every message this module produces comes from `schema.format_error`; there
+are no message string literals here, so wording stays in one place and
+`error_code` can map a message back to its catalog code.
+"""
+import re
+from string import Formatter
+
+from app import schema
+
+
+class ValidationError(Exception):
+    """A field failed validation. The message is a catalog message."""
+
+
+def _error(code, **kwargs):
+    return ValidationError(schema.format_error(code, **kwargs))
+
+
+def validate_fields(fields, required_fields, max_amount):
+    """Validate `fields`, returning a new normalized dict.
+
+    Raises ValidationError on the first problem: a missing required field
+    (in `required_fields` order), then `name` (must be a non-empty string),
+    then `amount` (must be a finite non-bool number, non-negative and at
+    most `max_amount`). Keys beyond `required_fields` pass through
+    untouched — validation is additive, not a schema whitelist. The result
+    is a shallow copy, so mutable values are shared with the input.
+    """
+    missing = schema.check_required(fields, required_fields)
+    if missing:
+        raise _error("missing", field=missing[0])
+
+    if "name" in fields:
+        if not schema.is_non_empty_str(fields["name"]):
+            raise _error("non_empty", field="name")
+
+    if "amount" in fields:
+        amount = fields["amount"]
+        if not schema.is_valid_amount(amount):
+            raise _error("numeric", field="amount",
+                         got=type(amount).__name__)
+        if amount < 0:
+            raise _error("non_negative", field="amount")
+        if amount > max_amount:
+            raise _error("max", field="amount", limit=max_amount)
+
+    validated = dict(fields)
+    if "name" in validated:
+        validated["name"] = validated["name"].strip()
+    return validated
+
+
+def validate_many(entries, required_fields, max_amount):
+    """Validate a list of fields dicts. Returns (validated, errors): the
+    successfully validated new dicts in input order, and (index, message)
+    pairs for the failures, also in input order. Nothing is mutated."""
+    validated = []
+    errors = []
+    for index, fields in enumerate(entries):
+        try:
+            validated.append(validate_fields(fields, required_fields,
+                                             max_amount))
+        except ValidationError as err:
+            errors.append((index, str(err)))
+    return validated, errors
+
+
+def _template_pattern(template):
+    """A regex matching exactly the messages `template` can render."""
+    parts = ["^"]
+    for literal, field, _spec, _conv in Formatter().parse(template):
+        parts.append(re.escape(literal))
+        if field is not None:
+            parts.append("(.+?)")
+    parts.append("$")
+    return re.compile("".join(parts), re.DOTALL)
+
+
+def error_code(message):
+    """The ERROR_CATALOG code whose template renders `message`.
+
+    The matcher is built from `schema.ERROR_CATALOG` on every call, so it
+    always reflects the live catalog. Raises ValueError if no template
+    matches.
+    """
+    best = None
+    best_weight = -1
+    for code, template in schema.ERROR_CATALOG.items():
+        if _template_pattern(template).match(message) is None:
+            continue
+        # Prefer the most specific template (most literal text) when more
+        # than one catalog entry can render the same message.
+        weight = sum(len(literal) for literal, _f, _s, _c
+                     in Formatter().parse(template))
+        if weight > best_weight:
+            best, best_weight = code, weight
+    if best is None:
+        raise ValueError("unrecognized error message: %s" % message)
+    return best
+
+
+def explain_config(config):
+    """Render the validation block of a config as a three-line string."""
+    return "validation config:\n  required: %s\n  max_amount: %s" % (
+        ", ".join(config["validation_required_fields"]),
+        config["validation_max_amount"])
+
+
+def pre_create_hook(store, config, fields):
+    """PRE_CREATE_HOOKS entry: validate a create's fields against config.
+    `store` is unused; the hook returns the normalized fields dict."""
+    return validate_fields(fields,
+                           config["validation_required_fields"],
+                           config["validation_max_amount"])
diff --git a/tests/test_audit.py b/tests/test_audit.py
new file mode 100644
index 0000000..f380c08
--- /dev/null
+++ b/tests/test_audit.py
@@ -0,0 +1,191 @@
+"""Tests for the module-global audit log (`app.audit`).
+
+Every test calls `audit.clear()` first: the log is module state and must
+not leak between tests.
+"""
+from app import audit
+
+
+def test_entries_on_fresh_log_is_empty():
+    audit.clear()
+    assert audit.entries() == []
+
+
+def test_record_appends_one_entry():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+    ]
+
+
+def test_entries_are_returned_in_call_order():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    audit.record("POST", "/records", "bob", 500)
+    audit.record("DELETE", "/records/1", "carol", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+
+
+def test_entries_returns_a_copy():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    got = audit.entries()
+    got.append({"method": "POST", "path": "/records", "actor": "mallory"})
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+    ]
+
+
+def test_cap_keeps_the_last_entries_and_drops_the_oldest():
+    audit.clear()
+    audit.record("GET", "/1", "a", 3)
+    audit.record("GET", "/2", "b", 3)
+    audit.record("GET", "/3", "c", 3)
+    audit.record("GET", "/4", "d", 3)
+    got = audit.entries()
+    assert len(got) == 3
+    assert got == [
+        {"method": "GET", "path": "/2", "actor": "b"},
+        {"method": "GET", "path": "/3", "actor": "c"},
+        {"method": "GET", "path": "/4", "actor": "d"},
+    ]
+
+
+def test_cap_is_enforced_after_every_single_call():
+    audit.clear()
+    lengths = []
+    for i in range(5):
+        audit.record("GET", "/%d" % i, "a", 2)
+        lengths.append(len(audit.entries()))
+    assert lengths == [1, 2, 2, 2, 2]
+    assert audit.entries() == [
+        {"method": "GET", "path": "/3", "actor": "a"},
+        {"method": "GET", "path": "/4", "actor": "a"},
+    ]
+
+
+def test_dispatch_hook_defaults_actor_to_anonymous():
+    audit.clear()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(object(), config, "GET", "/records", {})
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "anonymous"},
+    ]
+
+
+def test_dispatch_hook_uses_actor_kwarg_and_logs_only_three_keys():
+    audit.clear()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(object(), config, "POST", "/records",
+                        {"actor": "bob", "name": "x"})
+    assert audit.entries() == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+    ]
+    assert sorted(audit.entries()[0]) == ["actor", "method", "path"]
+
+
+def test_dispatch_hook_reads_its_cap_from_config():
+    audit.clear()
+    config = {"audit_log_max_entries": 1}
+    audit.dispatch_hook(object(), config, "GET", "/records", {"actor": "a"})
+    audit.dispatch_hook(object(), config, "GET", "/report", {"actor": "b"})
+    assert audit.entries() == [
+        {"method": "GET", "path": "/report", "actor": "b"},
+    ]
+
+
+def test_dispatch_hook_fires_for_every_method():
+    audit.clear()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(object(), config, "DELETE", "/records/1", {})
+    audit.dispatch_hook(object(), config, "PUT", "/records/1", {})
+    assert audit.entries() == [
+        {"method": "DELETE", "path": "/records/1", "actor": "anonymous"},
+        {"method": "PUT", "path": "/records/1", "actor": "anonymous"},
+    ]
+
+
+def test_record_many_appends_in_order_capping_after_every_append(monkeypatch):
+    audit.clear()
+    real_record = audit.record
+    lengths = []
+
+    def spy(method, path, actor, max_entries):
+        real_record(method, path, actor, max_entries)
+        lengths.append(len(audit.entries()))
+
+    monkeypatch.setattr(audit, "record", spy)
+    triples = [
+        ("GET", "/1", "a"),
+        ("GET", "/2", "b"),
+        ("GET", "/3", "c"),
+        ("GET", "/4", "d"),
+    ]
+    appended = audit.record_many(triples, 2)
+    assert appended == 4
+    assert lengths == [1, 2, 2, 2]
+    assert audit.entries() == [
+        {"method": "GET", "path": "/3", "actor": "c"},
+        {"method": "GET", "path": "/4", "actor": "d"},
+    ]
+
+
+def test_dropped_counts_evictions_since_the_last_clear():
+    audit.clear()
+    assert audit.dropped() == 0
+    for i in range(5):
+        audit.record("GET", "/%d" % i, "a", 3)
+    assert audit.dropped() == 2
+    audit.clear()
+    assert audit.dropped() == 0
+
+
+def test_export_state_returns_entries_and_dropped_as_copies():
+    audit.clear()
+    for i in range(4):
+        audit.record("GET", "/%d" % i, "a", 3)
+    state = audit.export_state()
+    assert state == {
+        "entries": [
+            {"method": "GET", "path": "/1", "actor": "a"},
+            {"method": "GET", "path": "/2", "actor": "a"},
+            {"method": "GET", "path": "/3", "actor": "a"},
+        ],
+        "dropped": 1,
+    }
+    state["entries"].append({"method": "POST", "path": "/x", "actor": "z"})
+    state["entries"][0]["actor"] = "mutated"
+    assert audit.entries() == [
+        {"method": "GET", "path": "/1", "actor": "a"},
+        {"method": "GET", "path": "/2", "actor": "a"},
+        {"method": "GET", "path": "/3", "actor": "a"},
+    ]
+
+
+def test_import_state_round_trips_and_copies_the_input():
+    audit.clear()
+    for i in range(4):
+        audit.record("GET", "/%d" % i, "a", 3)
+    state = audit.export_state()
+    audit.clear()
+    assert audit.entries() == []
+    assert audit.dropped() == 0
+
+    audit.import_state(state)
+    assert audit.entries() == state["entries"]
+    assert audit.dropped() == 1
+
+    state["entries"][0]["actor"] = "mutated"
+    state["entries"].append({"method": "POST", "path": "/x", "actor": "z"})
+    state["dropped"] = 99
+    assert audit.entries() == [
+        {"method": "GET", "path": "/1", "actor": "a"},
+        {"method": "GET", "path": "/2", "actor": "a"},
+        {"method": "GET", "path": "/3", "actor": "a"},
+    ]
+    assert audit.dropped() == 1
diff --git a/tests/test_audit_query.py b/tests/test_audit_query.py
new file mode 100644
index 0000000..8068e78
--- /dev/null
+++ b/tests/test_audit_query.py
@@ -0,0 +1,446 @@
+"""Tests for the pure read-side audit query module (`app.audit_query`).
+
+Every function under test takes an entry list as a plain argument, never
+touches `app.audit`, and never mutates its input; each test snapshots the
+fixture and asserts it is unchanged afterwards.
+"""
+import pytest
+
+from app import audit_query as q
+
+
+_RAW = [
+    {"method": "GET", "path": "/records", "actor": "alice"},
+    {"method": "POST", "path": "/records", "actor": "bob"},
+    {"method": "GET", "path": "/report", "actor": "alice"},
+    {"method": "POST", "path": "/records", "actor": "alice"},
+]
+
+
+def fixture():
+    """A fresh 4-entry log: GET x2 / POST x2, alice x3 / bob x1."""
+    return [dict(e) for e in _RAW]
+
+
+def snapshot(entries):
+    return [dict(e) for e in entries]
+
+
+def test_module_does_not_import_the_audit_log():
+    assert not hasattr(q, "audit")
+    assert not hasattr(q, "entries")
+
+
+def test_filter_entries():
+    entries = fixture()
+    before = snapshot(entries)
+
+    assert q.filter_entries(entries, actor="alice") == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "GET", "path": "/report", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    assert q.filter_entries(entries, method="POST") == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    assert q.filter_entries(entries, path="/records") == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    assert q.filter_entries(entries, method="POST", actor="alice") == [
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    assert q.filter_entries(entries) == before
+    assert q.filter_entries(entries, actor="nobody") == []
+
+    got = q.filter_entries(entries, actor="bob")
+    got.append({"method": "GET", "path": "/x", "actor": "x"})
+    assert q.filter_entries(entries, actor="bob") == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+    ]
+    assert entries == before
+
+
+def test_counts_by():
+    entries = fixture()
+    before = snapshot(entries)
+
+    assert q.counts_by(entries, "method") == {"GET": 2, "POST": 2}
+    assert q.counts_by(entries, "actor") == {"alice": 3, "bob": 1}
+    assert q.counts_by(entries, "path") == {"/records": 3, "/report": 1}
+    assert q.counts_by([], "method") == {}
+
+    with pytest.raises(ValueError) as exc:
+        q.counts_by(entries, "amount")
+    assert "amount" in str(exc.value)
+    assert entries == before
+
+
+def test_last_n():
+    entries = fixture()
+    before = snapshot(entries)
+
+    assert q.last_n(entries, 2) == [
+        {"method": "GET", "path": "/report", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    assert q.last_n(entries, 0) == []
+    assert q.last_n(entries, 99) == before
+
+    got = q.last_n(entries, 99)
+    got.append({"method": "GET", "path": "/x", "actor": "x"})
+    assert len(q.last_n(entries, 99)) == 4
+
+    with pytest.raises(ValueError):
+        q.last_n(entries, -1)
+    assert entries == before
+
+
+def test_redact():
+    entries = fixture()
+    before = snapshot(entries)
+
+    got = q.redact(entries, ["actor"])
+    assert got == [
+        {"method": "GET", "path": "/records", "actor": "***"},
+        {"method": "POST", "path": "/records", "actor": "***"},
+        {"method": "GET", "path": "/report", "actor": "***"},
+        {"method": "POST", "path": "/records", "actor": "***"},
+    ]
+
+    plain = q.redact(entries, [])
+    assert plain == before
+    assert all(a is not b for a, b in zip(plain, entries))
+
+    with pytest.raises(ValueError) as exc:
+        q.redact(entries, ["amount"])
+    assert "amount" in str(exc.value)
+    assert entries == before
+
+
+def test_summary():
+    entries = fixture()
+    before = snapshot(entries)
+
+    assert q.summary([]) == {
+        "total": 0,
+        "by_method": {},
+        "by_actor": {},
+        "first": None,
+        "last": None,
+    }
+    got = q.summary(entries)
+    assert got == {
+        "total": 4,
+        "by_method": {"GET": 2, "POST": 2},
+        "by_actor": {"alice": 3, "bob": 1},
+        "first": {"method": "GET", "path": "/records", "actor": "alice"},
+        "last": {"method": "POST", "path": "/records", "actor": "alice"},
+    }
+    assert got["first"] is not entries[0]
+    assert got["last"] is not entries[-1]
+    got["first"]["actor"] = "mutated"
+    assert entries == before
+
+
+def test_recent():
+    entries = fixture()[:3]
+    before = snapshot(entries)
+    config = {"audit_query_default_limit": 2}
+
+    assert q.recent(entries, config) == q.last_n(entries, 2)
+    assert q.recent(entries, config) == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "GET", "path": "/report", "actor": "alice"},
+    ]
+    assert entries == before
+
+
+def test_paginate():
+    entries = fixture() + [
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+    before = snapshot(entries)
+
+    assert q.paginate(entries, 1, 2) == {
+        "page": 1,
+        "pages": 3,
+        "total": 5,
+        "items": [
+            {"method": "GET", "path": "/records", "actor": "alice"},
+            {"method": "POST", "path": "/records", "actor": "bob"},
+        ],
+    }
+    assert q.paginate(entries, 2, 2) == {
+        "page": 2,
+        "pages": 3,
+        "total": 5,
+        "items": [
+            {"method": "GET", "path": "/report", "actor": "alice"},
+            {"method": "POST", "path": "/records", "actor": "alice"},
+        ],
+    }
+    assert q.paginate(entries, 3, 2) == {
+        "page": 3,
+        "pages": 3,
+        "total": 5,
+        "items": [
+            {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+        ],
+    }
+    assert q.paginate(entries, 4, 2) == {
+        "page": 4,
+        "pages": 3,
+        "total": 5,
+        "items": [],
+    }
+    assert q.paginate([], 1, 2) == {
+        "page": 1,
+        "pages": 0,
+        "total": 0,
+        "items": [],
+    }
+
+    page = q.paginate(entries, 1, 2)
+    page["items"][0]["actor"] = "mutated"
+    page["items"].append({"method": "GET", "path": "/x", "actor": "x"})
+    assert entries == before
+
+    with pytest.raises(ValueError):
+        q.paginate(entries, 0, 2)
+    with pytest.raises(ValueError):
+        q.paginate(entries, 1, 0)
+    assert entries == before
+
+
+def test_to_report():
+    entries = fixture()
+    before = snapshot(entries)
+
+    assert q.to_report(entries) == (
+        "audit report\n"
+        "total: 4\n"
+        "\n"
+        "by method:\n"
+        "  GET: 2\n"
+        "  POST: 2\n"
+        "\n"
+        "by actor:\n"
+        "  alice: 3\n"
+        "  bob: 1"
+    )
+    assert q.to_report([]) == "audit report\ntotal: 0"
+    assert entries == before
+
+
+def test_to_csv_report():
+    entries = fixture()
+    before = snapshot(entries)
+
+    assert q.to_csv_report(entries) == (
+        "field,value,count\n"
+        "method,GET,2\n"
+        "method,POST,2\n"
+        "actor,alice,3\n"
+        "actor,bob,1"
+    )
+    assert q.to_csv_report([]) == "field,value,count"
+    assert entries == before
+
+
+def test_to_markdown_report():
+    entries = fixture()
+    before = snapshot(entries)
+
+    assert q.to_markdown_report(entries) == (
+        "| field | value | count |\n"
+        "| --- | --- | --- |\n"
+        "| method | GET | 2 |\n"
+        "| method | POST | 2 |\n"
+        "| actor | alice | 3 |\n"
+        "| actor | bob | 1 |"
+    )
+    assert q.to_markdown_report([]) == (
+        "| field | value | count |\n"
+        "| --- | --- | --- |"
+    )
+    assert entries == before
+
+
+def test_top_actors():
+    entries = fixture() + [
+        {"method": "GET", "path": "/report", "actor": "carol"},
+    ]
+    before = snapshot(entries)
+
+    assert q.top_actors(entries, 5) == [("alice", 3), ("bob", 1), ("carol", 1)]
+    assert q.top_actors(entries, 2) == [("alice", 3), ("bob", 1)]
+    assert q.top_actors(entries, 0) == []
+
+    with pytest.raises(ValueError):
+        q.top_actors(entries, -1)
+    assert entries == before
+
+
+def test_merge_entries():
+    left = fixture()[:2]
+    right = fixture()[2:]
+    before_left, before_right = snapshot(left), snapshot(right)
+
+    merged = q.merge_entries(left, right)
+    assert merged == before_left + before_right
+    merged[0]["actor"] = "mutated"
+    merged.append({"method": "GET", "path": "/x", "actor": "x"})
+    assert left == before_left
+    assert right == before_right
+    assert q.merge_entries() == []
+
+
+def test_diff_summaries():
+    a_entries = [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+    ]
+    b_entries = [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+    assert q.diff_summaries(q.summary(a_entries), q.summary(b_entries)) == {
+        "total": 0,
+        "by_method": {"DELETE": 1, "POST": -1},
+        "by_actor": {"bob": -1, "carol": 1},
+    }
+    assert q.diff_summaries(q.summary([]), q.summary(a_entries)) == {
+        "total": 2,
+        "by_method": {"GET": 1, "POST": 1},
+        "by_actor": {"alice": 1, "bob": 1},
+    }
+
+
+def test_counts_matrix():
+    entries = fixture()
+    before = snapshot(entries)
+
+    assert q.counts_matrix(entries) == {
+        "GET": {"alice": 2},
+        "POST": {"bob": 1, "alice": 1},
+    }
+    assert q.counts_matrix([]) == {}
+    assert entries == before
+
+
+def test_rollup():
+    entries = fixture()
+    before = snapshot(entries)
+
+    assert q.rollup(entries, ["method"]) == q.counts_by(entries, "method")
+    assert q.rollup(entries, ["method", "actor"]) == q.counts_matrix(entries)
+    assert q.rollup(entries, ["actor", "method", "path"]) == {
+        "alice": {
+            "GET": {"/records": 1, "/report": 1},
+            "POST": {"/records": 1},
+        },
+        "bob": {"POST": {"/records": 1}},
+    }
+    assert q.rollup([], ["method"]) == {}
+
+    with pytest.raises(ValueError):
+        q.rollup(entries, [])
+    with pytest.raises(ValueError) as exc:
+        q.rollup(entries, ["amount"])
+    assert "amount" in str(exc.value)
+    with pytest.raises(ValueError):
+        q.rollup(entries, ["method", "method"])
+    assert entries == before
+
+
+def test_format_entry_and_to_lines():
+    entries = [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "delete", "path": "/records/1", "actor": "carol"},
+    ]
+    before = snapshot(entries)
+
+    assert q.format_entry(entries[0]) == "GET /records (alice)"
+    assert q.format_entry(entries[2]) == "DELETE /records/1 (carol)"
+    assert q.to_lines(entries) == [
+        "GET /records (alice)",
+        "POST /records (bob)",
+        "DELETE /records/1 (carol)",
+    ]
+    assert q.to_lines([]) == []
+
+    with pytest.raises(ValueError) as exc:
+        q.format_entry({"path": "/records", "actor": "alice"})
+    assert "method" in str(exc.value)
+    with pytest.raises(ValueError) as exc:
+        q.format_entry({"method": "GET", "actor": "alice"})
+    assert "path" in str(exc.value)
+    with pytest.raises(ValueError) as exc:
+        q.format_entry({"method": "GET", "path": "/records"})
+    assert "actor" in str(exc.value)
+    assert entries == before
+
+
+def test_group_by():
+    entries = fixture()
+    before = snapshot(entries)
+
+    assert q.group_by(entries, "method") == {
+        "GET": [
+            {"method": "GET", "path": "/records", "actor": "alice"},
+            {"method": "GET", "path": "/report", "actor": "alice"},
+        ],
+        "POST": [
+            {"method": "POST", "path": "/records", "actor": "bob"},
+            {"method": "POST", "path": "/records", "actor": "alice"},
+        ],
+    }
+    assert q.group_by([], "method") == {}
+
+    grouped = q.group_by(entries, "actor")
+    grouped["alice"][0]["actor"] = "mutated"
+    assert entries == before
+
+    with pytest.raises(ValueError) as exc:
+        q.group_by(entries, "amount")
+    assert "amount" in str(exc.value)
+    assert entries == before
+
+
+def test_search():
+    entries = [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/alice-list", "actor": "bob"},
+        {"method": "GET", "path": "/report", "actor": "carol"},
+    ]
+    before = snapshot(entries)
+
+    found = q.search(entries, "alice")
+    assert found == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/alice-list", "actor": "bob"},
+    ]
+    found[0]["actor"] = "mutated"
+    assert entries == before
+
+    assert q.search(entries, "nothing") == []
+    with pytest.raises(ValueError):
+        q.search(entries, "")
+    assert entries == before
+
+
+def test_filter_entries_over_a_live_audit_log():
+    from app import audit
+
+    audit.clear()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(object(), config, "GET", "/records", {"actor": "amy"})
+    audit.dispatch_hook(object(), config, "POST", "/records", {"actor": "bob"})
+    assert q.filter_entries(audit.entries(), actor="bob") == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+    ]
+    audit.clear()
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..66d0b19
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,206 @@
+"""Tests for the export/report formatter `app.export`."""
+import json
+
+import pytest
+
+from app import export
+
+
+# Two records with deliberately unequal key sets.
+RECORDS = [{"name": "coffee", "amount": 3}, {"name": "tea", "note": "x"}]
+
+
+def test_to_csv_of_an_empty_list_is_the_empty_string():
+    assert export.to_csv([]) == ""
+
+
+def test_to_csv_emits_sorted_union_header_then_rows_in_input_order():
+    assert export.to_csv(RECORDS) == "amount,name,note\n3,coffee,\n,tea,x"
+
+
+def test_to_csv_renders_numbers_with_plain_str():
+    assert export.to_csv([{"amount": 3}]) == "amount\n3"
+    assert export.to_csv([{"amount": 3.5}]) == "amount\n3.5"
+
+
+def test_to_json_of_an_empty_list():
+    assert export.to_json([]) == "[]"
+
+
+def test_to_json_round_trips_and_sorts_keys():
+    raw = export.to_json(RECORDS)
+    assert json.loads(raw) == RECORDS
+    assert raw == ('[{"amount": 3, "name": "coffee"}, '
+                   '{"name": "tea", "note": "x"}]')
+
+
+def test_to_csv_escapes_cells_and_leaves_plain_ones_untouched():
+    assert export.to_csv([{"amount": 3, "name": "a,b"}]) == \
+        'amount,name\n3,"a,b"'
+    assert export.to_csv([{"amount": 3, "name": 'say "hi"'}]) == \
+        'amount,name\n3,"say ""hi"""'
+    # No special characters: byte-identical to the unescaped join.
+    assert export.to_csv([{"amount": 3, "name": "tea"}]) == "amount,name\n3,tea"
+
+
+def test_to_markdown_of_an_empty_list_is_the_empty_string():
+    assert export.to_markdown([]) == ""
+
+
+def test_to_markdown_renders_a_padded_pipe_table():
+    expected = (
+        "| amount | name   | note |\n"
+        "| ------ | ------ | ---- |\n"
+        "| 3      | coffee |      |\n"
+        "|        | tea    | x    |"
+    )
+    assert export.to_markdown(RECORDS) == expected
+
+
+def test_to_markdown_honours_the_align_keyword():
+    records = [{"name": "tea", "amount": 3}]
+    left = (
+        "| amount | name |\n"
+        "| ------ | ---- |\n"
+        "| 3      | tea  |"
+    )
+    right = (
+        "| amount | name |\n"
+        "| -----: | ---: |\n"
+        "|      3 |  tea |"
+    )
+    assert export.to_markdown(records) == left
+    assert export.to_markdown(records, align="left") == left
+    assert export.to_markdown(records, align="right") == right
+    with pytest.raises(ValueError):
+        export.to_markdown(records, align="center")
+    # Every cell already meets its column width: the delegation to
+    # tabular.pad must not be skippable by pad's width short-circuit.
+    with pytest.raises(ValueError):
+        export.to_markdown([{"ab": "cd"}], align="center")
+
+
+def test_to_ndjson_renders_one_sorted_json_object_per_line():
+    assert export.to_ndjson([]) == ""
+    raw = export.to_ndjson(RECORDS)
+    assert raw == ('{"amount": 3, "name": "coffee"}\n'
+                   '{"name": "tea", "note": "x"}')
+    assert [json.loads(line) for line in raw.split("\n")] == RECORDS
+
+
+def test_to_tsv_sanitizes_every_cell_and_header_name():
+    assert export.to_tsv([]) == ""
+    assert export.to_tsv(RECORDS) == "amount\tname\tnote\n3\tcoffee\t\n\ttea\tx"
+    assert export.to_tsv([{"name": "a\tb\nc"}]) == "name\na b c"
+    assert export.to_tsv([{"a\tb": 1}]) == "a b\n1"
+
+
+def test_to_html_renders_an_escaped_table():
+    records = [{"name": "a & b", "amount": 3}, {"name": "<tag>"}]
+    expected = (
+        "<table>\n"
+        "<tr><th>amount</th><th>name</th></tr>\n"
+        "<tr><td>3</td><td>a &amp; b</td></tr>\n"
+        "<tr><td></td><td>&lt;tag&gt;</td></tr>\n"
+        "</table>"
+    )
+    assert export.to_html([]) == ""
+    assert export.to_html(records) == expected
+
+
+def test_parse_csv_is_the_inverse_of_to_csv():
+    assert export.parse_csv("") == []
+    assert export.parse_csv("amount,name\n3,tea") == [
+        {"amount": "3", "name": "tea"}]
+
+
+def test_parse_csv_handles_quoted_cells():
+    assert export.parse_csv('name\n"a,b"') == [{"name": "a,b"}]
+    assert export.parse_csv('name\n"say ""hi"""') == [{"name": 'say "hi"'}]
+    assert export.parse_csv('name\n"line1\nline2"') == [
+        {"name": "line1\nline2"}]
+    record = {"amount": 3, "name": 'a,b "c"\nd'}
+    assert export.parse_csv(export.to_csv([record])) == [
+        {"amount": "3", "name": 'a,b "c"\nd'}]
+    with pytest.raises(ValueError):
+        export.parse_csv('name\n"unterminated')
+
+
+def test_parse_csv_single_column_trailing_newline_corner():
+    assert export.parse_csv("a\n") == [{"a": ""}]
+    assert export.parse_csv("a") == []
+
+
+def test_formats_table_exposes_exactly_the_five_route_formats():
+    assert export.FORMATS == {
+        "csv": export.to_csv,
+        "json": export.to_json,
+        "md": export.to_markdown,
+        "ndjson": export.to_ndjson,
+        "tsv": export.to_tsv,
+    }
+
+
+def test_extra_formats_holds_html_only():
+    assert export.EXTRA_FORMATS == {"html": export.to_html}
+
+
+def test_render_delegates_to_each_registered_format():
+    assert export.render(RECORDS, "csv") == export.to_csv(RECORDS)
+    assert export.render(RECORDS, "json") == export.to_json(RECORDS)
+    assert export.render(RECORDS, "md") == export.to_markdown(RECORDS)
+    assert export.render(RECORDS, "ndjson") == export.to_ndjson(RECORDS)
+    assert export.render(RECORDS, "tsv") == export.to_tsv(RECORDS)
+
+
+def test_render_rejects_unknown_and_extra_formats():
+    with pytest.raises(ValueError) as exc:
+        export.render(RECORDS, "xml")
+    assert "xml" in str(exc.value)
+    with pytest.raises(ValueError):
+        export.render(RECORDS, "html")
+
+
+def test_render_any_serves_formats_then_extra_formats():
+    assert export.render_any(RECORDS, "csv") == export.to_csv(RECORDS)
+    assert export.render_any(RECORDS, "html") == export.to_html(RECORDS)
+    with pytest.raises(ValueError) as exc:
+        export.render_any(RECORDS, "xml")
+    assert "xml" in str(exc.value)
+
+
+def test_summary_line_counts_records_and_columns():
+    assert export.summary_line(RECORDS) == "2 records, 3 columns"
+    assert export.summary_line([]) == "0 records, 0 columns"
+
+
+def test_single_record_renders_in_every_format():
+    records = [{"name": "tea", "amount": 3}]
+    assert export.to_csv(records) == "amount,name\n3,tea"
+    assert export.to_json(records) == '[{"amount": 3, "name": "tea"}]'
+    assert export.to_markdown(records) == (
+        "| amount | name |\n"
+        "| ------ | ---- |\n"
+        "| 3      | tea  |"
+    )
+    assert export.to_ndjson(records) == '{"amount": 3, "name": "tea"}'
+    assert export.to_tsv(records) == "amount\tname\n3\ttea"
+    assert export.to_html(records) == (
+        "<table>\n"
+        "<tr><th>amount</th><th>name</th></tr>\n"
+        "<tr><td>3</td><td>tea</td></tr>\n"
+        "</table>"
+    )
+
+
+def test_export_route_serves_csv_by_default_and_rejects_unenabled_formats():
+    from app.registry import bootstrap
+
+    app = bootstrap()
+    app.call("POST", "/records", name="coffee", amount=3)
+    app.call("POST", "/records", name="tea", amount=4)
+    records = app.call("GET", "/records")
+    assert app.call("GET", "/export") == export.to_csv(records)
+    assert app.call("GET", "/export", fmt="json") == export.to_json(records)
+    with pytest.raises(ValueError):
+        app.call("GET", "/export", fmt="md")
diff --git a/tests/test_quota.py b/tests/test_quota.py
new file mode 100644
index 0000000..8877d72
--- /dev/null
+++ b/tests/test_quota.py
@@ -0,0 +1,210 @@
+"""Tests for the deterministic windowed quota counter (`app.quota`).
+
+Every test starts with `quota.reset()` because the module keeps its clock
+and hit store as module globals; no test may leak into another.
+"""
+import pytest
+
+from app import quota
+
+
+def test_quota_exceeded_error_is_an_exception_subclass():
+    assert issubclass(quota.QuotaExceededError, Exception)
+
+
+def test_logical_clock_starts_at_zero_and_only_moves_forward():
+    quota.reset()
+    assert quota.now() == 0.0
+    assert quota.advance(30) == 30.0
+    assert quota.now() == 30.0
+    with pytest.raises(ValueError):
+        quota.advance(-1)
+    assert quota.now() == 30.0
+
+
+def test_take_counts_in_window_hits_then_raises_at_the_limit():
+    quota.reset()
+    assert quota.take("k", limit=2, window_seconds=60) == 1
+    assert quota.take("k", limit=2, window_seconds=60) == 2
+    with pytest.raises(quota.QuotaExceededError) as excinfo:
+        quota.take("k", limit=2, window_seconds=60)
+    message = str(excinfo.value)
+    assert "k" in message
+    assert "2" in message
+
+
+def test_take_prunes_hits_older_than_the_window():
+    quota.reset()
+    assert quota.take("k", 2, 60) == 1
+    assert quota.take("k", 2, 60) == 2
+    quota.advance(61)
+    assert quota.take("k", 2, 60) == 1
+
+    # A hit recorded at t=30 still counts at t=61 but not at t=91: pruning
+    # drops hits strictly older than `now - window_seconds`.
+    quota.reset()
+    quota.advance(30)
+    assert quota.take("h", 2, 60) == 1
+    quota.advance(31)
+    assert quota.remaining("h", 2, 60) == 1
+    quota.advance(30)
+    assert quota.remaining("h", 2, 60) == 2
+
+
+def test_infinite_window_never_prunes():
+    quota.reset()
+    assert quota.take("k", 1, float("inf")) == 1
+    quota.advance(10 ** 6)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 1, float("inf"))
+
+
+def test_burst_extends_the_allowance_and_defaults_to_zero():
+    quota.reset()
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 1
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 2
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 3
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60, burst=1)
+
+    quota.reset()
+    assert quota.take("d", 2, 60) == 1
+    assert quota.take("d", 2, 60) == 2
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("d", 2, 60)
+
+
+def test_quotas_are_independent_per_key():
+    quota.reset()
+    assert quota.take("a", 2, 60) == 1
+    assert quota.take("b", 2, 60) == 1
+    assert quota.take("a", 2, 60) == 2
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("a", 2, 60)
+    assert quota.take("b", 2, 60) == 2
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("b", 2, 60)
+
+
+def test_reset_clears_the_clock_and_every_key():
+    quota.reset()
+    quota.take("a", 1, 60)
+    quota.take("b", 1, 60)
+    quota.advance(5)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("a", 1, 60)
+
+    quota.reset()
+    assert quota.now() == 0.0
+    assert quota.take("a", 1, 60) == 1
+    assert quota.take("b", 1, 60) == 1
+
+
+def test_remaining_reports_the_left_allowance_without_recording():
+    quota.reset()
+    assert quota.remaining("k", 2, 60) == 2
+    assert quota.remaining("k", 2, 60) == 2
+    assert quota.remaining("k", 2, 60, burst=1) == 3
+
+    assert quota.take("k", 2, 60) == 1
+    assert quota.remaining("k", 2, 60) == 1
+    assert quota.remaining("k", 2, 60) == 1
+    assert quota.take("k", 2, 60) == 2
+
+    assert quota.remaining("k", 2, 60) == 0
+    assert quota.remaining("k", 2, 60) == 0
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 2, 60)
+
+    quota.advance(61)
+    assert quota.remaining("k", 2, 60) == 2
+    assert quota.take("k", 2, 60) == 1
+
+
+def test_snapshot_lists_in_window_hits_and_is_a_deep_copy():
+    quota.reset()
+    quota.take("a", 5, 60)
+    quota.advance(30)
+    quota.take("a", 5, 60)
+    quota.take("b", 5, 60)
+    quota.advance(31)
+    assert quota.snapshot(60) == {"a": [30.0], "b": [30.0]}
+
+    snap = quota.snapshot(60)
+    snap["a"].append(999.0)
+    snap["a"][0] = -1.0
+    assert quota.snapshot(60) == {"a": [30.0], "b": [30.0]}
+    assert quota.remaining("a", 5, 60) == 4
+
+
+def test_time_to_next_slot_reports_seconds_until_a_slot_frees():
+    quota.reset()
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+    assert quota.take("k", 2, 60) == 1
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+    # read-only: the two readings above recorded nothing
+    assert quota.take("k", 2, 60) == 2
+    quota.advance(10)
+    assert quota.time_to_next_slot("k", 2, 60) == 50.0
+    assert quota.time_to_next_slot("k", 2, 60) == 50.0
+
+    # An exhausted key under an infinite window never frees a slot.
+    quota.reset()
+    quota.take("i", 1, float("inf"))
+    assert quota.time_to_next_slot("i", 1, float("inf")) == float("inf")
+
+    # A zero allowance can never record a hit, so no slot ever frees.
+    quota.reset()
+    assert quota.time_to_next_slot("k", 0, 60) == float("inf")
+
+    # Boundary: a hit sitting exactly at `now - window_seconds` is still in
+    # window, so the reset instant reads 0.0 while `take` still raises.
+    quota.reset()
+    quota.take("b", 2, 60)
+    quota.take("b", 2, 60)
+    quota.advance(60)
+    assert quota.time_to_next_slot("b", 2, 60) == 0.0
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("b", 2, 60)
+
+
+def test_usage_reports_the_exact_state_dict():
+    quota.reset()
+    assert quota.usage("k", 2, 60) == {
+        "used": 0,
+        "allowed": 2,
+        "remaining": 2,
+        "reset_in": 0.0,
+    }
+
+    assert quota.take("k", 2, 60) == 1
+    assert quota.usage("k", 2, 60) == {
+        "used": 1,
+        "allowed": 2,
+        "remaining": 1,
+        "reset_in": 0.0,
+    }
+    # read-only: the reading above recorded nothing
+    assert quota.take("k", 2, 60) == 2
+
+    quota.advance(10)
+    assert quota.usage("k", 2, 60) == {
+        "used": 2,
+        "allowed": 2,
+        "remaining": 0,
+        "reset_in": 50.0,
+    }
+
+
+def test_purge_drops_aged_out_hits_and_reports_how_many():
+    quota.reset()
+    quota.take("a", 5, 60)
+    quota.take("a", 5, 60)
+    quota.advance(30)
+    quota.take("b", 5, 60)
+    quota.advance(31)
+
+    assert quota.purge(60) == 2
+    assert quota.snapshot(60) == {"b": [30.0]}
+    assert quota.purge(60) == 0
