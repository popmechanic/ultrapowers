+++ b/tests/test_ratelimit.py
@@ -0,0 +1,204 @@
+"""Tests for app/ratelimit.py."""
+import pytest
+
+from app import quota, ratelimit
+from app.ratelimit import RateLimitExceededError
+from app.quota import QuotaExceededError
+
+
+@pytest.fixture(autouse=True)
+def _reset():
+    ratelimit.reset()
+
+
+def test_rate_limit_exceeded_error_is_exception_subclass():
+    assert issubclass(RateLimitExceededError, Exception)
+
+
+def test_check_and_increment_counts_then_raises_with_key_and_limit():
+    assert ratelimit.check_and_increment("k", 3) == 1
+    assert ratelimit.check_and_increment("k", 3) == 2
+    assert ratelimit.check_and_increment("k", 3) == 3
+    with pytest.raises(RateLimitExceededError) as exc_info:
+        ratelimit.check_and_increment("k", 3)
+    msg = str(exc_info.value)
+    assert "k" in msg
+    assert "3" in msg
+
+
+def test_counter_is_per_key():
+    assert ratelimit.check_and_increment("a", 2) == 1
+    assert ratelimit.check_and_increment("b", 2) == 1
+    assert ratelimit.check_and_increment("a", 2) == 2
+    assert ratelimit.check_and_increment("b", 2) == 2
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("a", 2)
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("b", 2)
+
+
+def test_reset_clears_all_keys_not_just_one():
+    ratelimit.check_and_increment("a", 1)
+    ratelimit.check_and_increment("b", 1)
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("a", 1) == 1
+    assert ratelimit.check_and_increment("b", 1) == 1
+
+
+def test_dispatch_hook_never_raises_or_increments_on_get():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    for _ in range(1 + 5):
+        ratelimit.dispatch_hook(None, config, "GET", "/records", {})
+    # GET calls never touched the counter used internally by POST dispatch
+    # (the "anonymous" key) -- it still starts at 1.
+    assert ratelimit.check_and_increment("anonymous", 1) == 1
+
+
+def test_dispatch_hook_post_keys_by_actor_with_anonymous_default():
+    config = {"rate_limit_max_per_window": 5, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+    # "anonymous" has 2 hits, "x" has 1
+    assert ratelimit.check_and_increment("anonymous", 5) == 3
+    assert ratelimit.check_and_increment("x", 5) == 2
+
+
+def test_dispatch_hook_reads_limit_from_config():
+    config1 = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config1, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config1, "POST", "/records", {"actor": "a"})
+
+    ratelimit.reset()
+    config2 = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config2, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config2, "POST", "/records", {"actor": "a"})
+
+
+def test_ratelimit_reset_also_resets_quota_clock():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(30)
+    ratelimit.reset()
+    assert quota.now() == 0.0
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})  # succeeds again
+
+
+def test_rate_limit_exceeded_error_subclasses_quota_exceeded_error():
+    assert issubclass(RateLimitExceededError, QuotaExceededError)
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("k", 0)
+    with pytest.raises(QuotaExceededError):
+        ratelimit.check_and_increment("k", 0)
+
+
+def test_check_and_increment_delegates_to_quota_take(monkeypatch):
+    calls = []
+
+    def recorder(key, limit, window_seconds, burst=0):
+        calls.append((key, limit, window_seconds, burst))
+        return 1
+
+    monkeypatch.setattr(quota, "take", recorder)
+    ratelimit.check_and_increment("k", 3)
+    assert calls == [("k", 3, float("inf"), 0)]
+
+
+def test_windowed_end_to_end_through_the_hook():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(61)
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})  # passes
+
+
+def test_minimal_config_compatibility_only_limit_key_required():
+    config = {"rate_limit_max_per_window": 1}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+
+
+def test_burst_through_the_hook():
+    config = {
+        "rate_limit_max_per_window": 1,
+        "rate_limit_burst": 1,
+        "rate_limit_window_seconds": 60,
+    }
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+
+def test_retry_after_delegates_to_quota_time_to_next_slot(monkeypatch):
+    calls = []
+
+    def recorder(key, limit, window_seconds, burst=0):
+        calls.append((key, limit, window_seconds, burst))
+        return 42.0
+
+    monkeypatch.setattr(quota, "time_to_next_slot", recorder)
+    config = {
+        "rate_limit_max_per_window": 3,
+        "rate_limit_window_seconds": 60,
+        "rate_limit_burst": 1,
+    }
+    result = ratelimit.retry_after("k", config)
+    assert calls == [("k", 3, 60, 1)]
+    assert result == 42.0
+    monkeypatch.undo()
+
+    # end-to-end
+    config2 = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config2, "POST", "/records", {"actor": "mallory"})
+    quota.advance(10)
+    assert ratelimit.retry_after("mallory", config2) == 50.0
+
+
+def test_limit_headers_exact_dict_fresh_and_exhausted():
+    config = {
+        "rate_limit_max_per_window": 2,
+        "rate_limit_window_seconds": 60,
+        "rate_limit_burst": 1,
+    }
+    assert ratelimit.limit_headers("k", config) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "3",
+        "X-RateLimit-Reset": "0.0",
+    }
+    # a subsequent take still succeeds (nothing consumed by limit_headers)
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "k"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "k"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "k"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "k"})
+    quota.advance(10)
+    assert ratelimit.limit_headers("k", config) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "0",
+        "X-RateLimit-Reset": "50.0",
+    }
+
+
+def test_status_line_literal_fresh_and_exhausted():
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert ratelimit.status_line("mallory", config) == "mallory: 0/2, reset in 0.0s"
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
+    quota.advance(10)
+    assert ratelimit.status_line("mallory", config) == "mallory: 2/2, reset in 50.0s"
+
+
+def test_check_many_exact_dict_no_hits_recorded():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "b"})  # exhaust b
+    result = ratelimit.check_many(["a", "b", "c"], config)
+    assert result == {"a": True, "b": False, "c": True}
+    # no hit was recorded for any of them: a, c can still take, b still raises
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "b"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "c"})
