diff --git a/app/audit.py b/app/audit.py
new file mode 100644
index 0000000..669856b
--- /dev/null
+++ b/app/audit.py
@@ -0,0 +1,96 @@
+"""Audit log of every dispatched call.
+
+`dispatch_hook` is registered into `registry.DISPATCH_HOOKS`, so it runs
+before EVERY dispatch — unlike rate limiting, the audit log does not
+special-case the method. It never raises: it only appends. The
+`audit_log_enabled` config key is recorded for a future on/off switch and
+is deliberately not read here; this hook always logs.
+
+The log lives in a module-global list, so callers that need isolation
+(tests, in particular) must call `clear()` first. An entry is exactly
+three keys — `method`, `path` and `actor` — and never the dispatched
+record's own fields.
+
+The cap is passed in on every write (`max_entries`) and is enforced after
+every single append, oldest first; `dropped()` counts the entries the cap
+evicted since the last `clear()`.
+
+The read side lives in `app/audit_query.py`, which is pure over the entry
+lists this module hands out and imports nothing from here.
+"""
+
+#: The three keys of an audit entry, in render order.
+FIELDS = ("method", "path", "actor")
+
+#: Cap used when a config does not carry `audit_log_max_entries`.
+DEFAULT_MAX_ENTRIES = 500
+
+#: Actor recorded when a dispatch carries no `actor` kwarg.
+ANONYMOUS = "anonymous"
+
+_log = []
+_dropped = 0
+
+
+def clear():
+    """Empty the log and reset the dropped counter."""
+    global _dropped
+    del _log[:]
+    _dropped = 0
+
+
+def entries():
+    """The logged entries, oldest first, as a copy the caller may mutate."""
+    return [dict(entry) for entry in _log]
+
+
+def _enforce_cap(max_entries):
+    global _dropped
+    if max_entries is None:
+        return
+    while len(_log) > max(max_entries, 0):
+        _log.pop(0)
+        _dropped += 1
+
+
+def record(method, path, actor, max_entries):
+    """Append one entry, then evict oldest entries down to `max_entries`."""
+    _log.append({"method": method, "path": path, "actor": actor})
+    _enforce_cap(max_entries)
+
+
+def record_many(triples, max_entries):
+    """Append each `(method, path, actor)` triple in order, enforcing the
+    cap after every append. Returns the number appended — which is always
+    `len(triples)`, even for appends that immediately age out."""
+    appended = 0
+    for method, path, actor in triples:
+        record(method, path, actor, max_entries)
+        appended += 1
+    return appended
+
+
+def dropped():
+    """How many entries the cap has evicted since the last `clear()`."""
+    return _dropped
+
+
+def export_state():
+    """A snapshot of the whole log: `{"entries": [...], "dropped": n}`.
+    The entries are copies, so mutating them cannot touch the live log."""
+    return {"entries": entries(), "dropped": _dropped}
+
+
+def import_state(state):
+    """Replace the log and the dropped counter from an `export_state()`
+    shaped dict, copying it so later mutations of `state` do not leak."""
+    global _dropped
+    _log[:] = [dict(entry) for entry in state["entries"]]
+    _dropped = state["dropped"]
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS entry point: log the call and return None."""
+    actor = kwargs.get("actor", ANONYMOUS)
+    record(method, path, actor,
+           config.get("audit_log_max_entries", DEFAULT_MAX_ENTRIES))
diff --git a/app/audit_query.py b/app/audit_query.py
new file mode 100644
index 0000000..566027b
--- /dev/null
+++ b/app/audit_query.py
@@ -0,0 +1,247 @@
+"""Pure read-side queries over audit entry lists.
+
+Every function here takes the entry list as a plain argument, imports
+nothing from `app.audit`, never touches module state, and never mutates
+its input: entries handed back are always fresh dicts in fresh lists, so
+a caller may mutate a result without disturbing the source log.
+
+An entry is a dict with the three keys `method`, `path` and `actor`;
+`FIELDS` is the legal field-name set every field argument is validated
+against, and it also fixes the section order of the rendered reports
+(method rows before actor rows).
+"""
+
+#: The legal field names, in report order.
+FIELDS = ("method", "path", "actor")
+
+#: Replacement value written by `redact`.
+REDACTED = "***"
+
+
+def _check_field(field):
+    if field not in FIELDS:
+        raise ValueError("unknown audit field: %s" % (field,))
+    return field
+
+
+def _copy(entry):
+    return dict(entry)
+
+
+def filter_entries(entries, actor=None, method=None, path=None):
+    """The entries matching every criterion given, in order. Criteria left
+    as None are ignored; no criteria at all keeps everything."""
+    criteria = [(name, value) for name, value in
+                (("actor", actor), ("method", method), ("path", path))
+                if value is not None]
+    return [_copy(entry) for entry in entries
+            if all(entry.get(name) == value for name, value in criteria)]
+
+
+def counts_by(entries, field):
+    """`{value: count}` over one field. Raises ValueError on any other."""
+    _check_field(field)
+    counts = {}
+    for entry in entries:
+        if field in entry:
+            value = entry[field]
+            counts[value] = counts.get(value, 0) + 1
+    return counts
+
+
+def counts_matrix(entries):
+    """Nested `{method: {actor: count}}`; only combinations that actually
+    occur appear — there are no zero-filled cells."""
+    matrix = {}
+    for entry in entries:
+        if "method" in entry and "actor" in entry:
+            row = matrix.setdefault(entry["method"], {})
+            actor = entry["actor"]
+            row[actor] = row.get(actor, 0) + 1
+    return matrix
+
+
+def rollup(entries, fields):
+    """Counts nested by each of `fields` in order — the generalisation of
+    `counts_by` (one field) and `counts_matrix` (method then actor).
+    `fields` must be a non-empty list of distinct legal field names."""
+    if not fields:
+        raise ValueError("rollup needs at least one field")
+    seen = set()
+    for field in fields:
+        _check_field(field)
+        if field in seen:
+            raise ValueError("duplicate audit field: %s" % (field,))
+        seen.add(field)
+
+    counts = {}
+    for entry in entries:
+        if any(field not in entry for field in fields):
+            continue
+        node = counts
+        for field in fields[:-1]:
+            node = node.setdefault(entry[field], {})
+        leaf = entry[fields[-1]]
+        node[leaf] = node.get(leaf, 0) + 1
+    return counts
+
+
+def last_n(entries, n):
+    """The final `n` entries in order; `n` past the end returns them all."""
+    if n < 0:
+        raise ValueError("n must not be negative: %s" % (n,))
+    if n == 0:
+        return []
+    return [_copy(entry) for entry in entries[-n:]]
+
+
+def redact(entries, fields):
+    """New entries with each of `fields` replaced by `***`; the originals
+    keep their real values."""
+    for field in fields:
+        _check_field(field)
+    redacted = []
+    for entry in entries:
+        copy = _copy(entry)
+        for field in fields:
+            if field in copy:
+                copy[field] = REDACTED
+        redacted.append(copy)
+    return redacted
+
+
+def summary(entries):
+    """Totals plus the first and last entries (copies, or None if empty)."""
+    return {
+        "total": len(entries),
+        "by_method": counts_by(entries, "method"),
+        "by_actor": counts_by(entries, "actor"),
+        "first": _copy(entries[0]) if entries else None,
+        "last": _copy(entries[-1]) if entries else None,
+    }
+
+
+def recent(entries, config):
+    """The most recent entries, capped by `audit_query_default_limit`."""
+    return last_n(entries, config["audit_query_default_limit"])
+
+
+def paginate(entries, page, per_page):
+    """One 1-based page of entries plus its metadata."""
+    if page < 1:
+        raise ValueError("page must be 1 or greater: %s" % (page,))
+    if per_page < 1:
+        raise ValueError("per_page must be 1 or greater: %s" % (per_page,))
+    total = len(entries)
+    pages = (total + per_page - 1) // per_page
+    start = (page - 1) * per_page
+    return {
+        "page": page,
+        "pages": pages,
+        "total": total,
+        "items": [_copy(entry) for entry in entries[start:start + per_page]],
+    }
+
+
+def _sorted_counts(entries, field):
+    counts = counts_by(entries, field)
+    return [(value, counts[value]) for value in sorted(counts)]
+
+
+def to_report(entries):
+    """The plain-text audit report: a total, then a method section and an
+    actor section, each sorted alphabetically. Empty counts get no
+    section header at all."""
+    lines = ["audit report", "total: %d" % len(entries)]
+    for field, heading in (("method", "by method:"), ("actor", "by actor:")):
+        rows = _sorted_counts(entries, field)
+        if rows:
+            lines.append("")
+            lines.append(heading)
+            lines.extend("  %s: %d" % row for row in rows)
+    return "\n".join(lines)
+
+
+def to_csv_report(entries):
+    """The same counts as `to_report`, as `field,value,count` rows."""
+    lines = ["field,value,count"]
+    for field in ("method", "actor"):
+        lines.extend("%s,%s,%d" % (field, value, count)
+                     for value, count in _sorted_counts(entries, field))
+    return "\n".join(lines)
+
+
+def to_markdown_report(entries):
+    """The same rows as `to_csv_report`, as an unpadded pipe table."""
+    lines = ["| field | value | count |", "| --- | --- | --- |"]
+    for field in ("method", "actor"):
+        lines.extend("| %s | %s | %d |" % (field, value, count)
+                     for value, count in _sorted_counts(entries, field))
+    return "\n".join(lines)
+
+
+def top_actors(entries, n):
+    """The `n` busiest actors as `(actor, count)`, most calls first, ties
+    broken by actor name ascending."""
+    if n < 0:
+        raise ValueError("n must not be negative: %s" % (n,))
+    counts = counts_by(entries, "actor")
+    ranked = sorted(counts.items(), key=lambda item: (-item[1], item[0]))
+    return ranked[:n]
+
+
+def merge_entries(*entry_lists):
+    """One new list of entry copies, concatenated in argument order."""
+    return [_copy(entry) for entries in entry_lists for entry in entries]
+
+
+def _diff_counts(a_counts, b_counts):
+    diff = {}
+    for value in set(a_counts) | set(b_counts):
+        delta = b_counts.get(value, 0) - a_counts.get(value, 0)
+        if delta:
+            diff[value] = delta
+    return diff
+
+
+def diff_summaries(a, b):
+    """What changed from summary `a` to summary `b`: the total delta plus,
+    per section, only the values whose counts moved."""
+    return {
+        "total": b["total"] - a["total"],
+        "by_method": _diff_counts(a["by_method"], b["by_method"]),
+        "by_actor": _diff_counts(a["by_actor"], b["by_actor"]),
+    }
+
+
+def group_by(entries, field):
+    """`{value: [entries]}` for one field, each group in original order."""
+    _check_field(field)
+    groups = {}
+    for entry in entries:
+        if field in entry:
+            groups.setdefault(entry[field], []).append(_copy(entry))
+    return groups
+
+
+def search(entries, needle):
+    """The entries where `needle` is a substring of any field value."""
+    if not needle:
+        raise ValueError("needle must not be empty")
+    return [_copy(entry) for entry in entries
+            if any(needle in str(entry[field])
+                   for field in FIELDS if field in entry)]
+
+
+def format_entry(entry):
+    """One entry as `"<METHOD> <path> (<actor>)"`."""
+    for field in FIELDS:
+        if field not in entry:
+            raise ValueError("entry is missing %s" % (field,))
+    return "%s %s (%s)" % (str(entry["method"]).upper(),
+                           entry["path"], entry["actor"])
+
+
+def to_lines(entries):
+    """`format_entry` for every entry, in order."""
+    return [format_entry(entry) for entry in entries]
diff --git a/app/export.py b/app/export.py
new file mode 100644
index 0000000..1284931
--- /dev/null
+++ b/app/export.py
@@ -0,0 +1,205 @@
+"""Machine-readable export formatters.
+
+`app.report` renders the human-facing plain-text summary; this module adds
+the machine-readable formats alongside it: CSV, JSON, Markdown, NDJSON, TSV
+and HTML. Every format builds its column model through `app.tabular` — the
+key union, cell rendering, escaping and widths all live there, so no format
+re-implements them.
+
+`FORMATS` is the table `app.registry` publishes to the pre-wired /export
+route. `EXTRA_FORMATS` holds formats that exist but are deliberately not
+route-reachable (`html`); `render` serves `FORMATS` only, `render_any`
+serves both.
+"""
+import json
+
+from app import tabular
+
+
+def to_csv(records):
+    """Comma-separated values: a sorted-union header row, then one row per
+    record in input order. Missing fields render as empty cells; every cell
+    is escaped by `tabular.escape_csv`. An empty export has no columns, so
+    it has no header row either."""
+    cols = tabular.columns(records)
+    if not cols:
+        return ""
+    lines = [",".join(tabular.escape_csv(col) for col in cols)]
+    for record in records:
+        lines.append(",".join(tabular.escape_csv(record.get(col))
+                              for col in cols))
+    return "\n".join(lines)
+
+
+def to_json(records):
+    """The records as one JSON array, keys sorted."""
+    return json.dumps(records, sort_keys=True)
+
+
+def to_markdown(records, align="left"):
+    """A Markdown pipe table: header row, dash separator row, then one row
+    per record, every cell padded to its `tabular.widths` column width.
+
+    `align` is passed straight through to `tabular.pad` (via
+    `tabular.render_row`), which rejects anything but "left"/"right"; a
+    right-aligned table marks its separator cells with a trailing colon.
+    """
+    cols = tabular.columns(records)
+    if not cols:
+        return ""
+    col_widths = tabular.widths(records, cols)
+    widths_list = [col_widths[col] for col in cols]
+    lines = [tabular.render_row(cols, widths_list, align)]
+    lines.append(tabular.render_row(
+        [_separator_cell(width, align) for width in widths_list],
+        widths_list, align))
+    for record in records:
+        lines.append(tabular.render_row(
+            [record.get(col) for col in cols], widths_list, align))
+    return "\n".join(lines)
+
+
+def _separator_cell(width, align):
+    """One Markdown separator cell, width-matched: plain dashes for a
+    left-aligned column, dashes ending in a colon for a right-aligned one."""
+    if align == "right":
+        return "-" * (width - 1) + ":"
+    return "-" * width
+
+
+def to_ndjson(records):
+    """Newline-delimited JSON: one sorted-key JSON object per line, no
+    trailing newline."""
+    return "\n".join(json.dumps(record, sort_keys=True) for record in records)
+
+
+def to_tsv(records):
+    """Tab-separated values. Column names as well as cells go through
+    `tabular.sanitize_flat`: a tab or newline anywhere — including in a
+    column name — would otherwise break the grid."""
+    cols = tabular.columns(records)
+    if not cols:
+        return ""
+    lines = ["\t".join(tabular.sanitize_flat(col) for col in cols)]
+    for record in records:
+        lines.append("\t".join(tabular.sanitize_flat(record.get(col))
+                               for col in cols))
+    return "\n".join(lines)
+
+
+def to_html(records):
+    """An HTML `<table>`: a `<th>` header row of the sorted column names,
+    then one `<tr>` of `<td>` cells per record, all HTML-escaped."""
+    cols = tabular.columns(records)
+    if not cols:
+        return ""
+    lines = ["<table>"]
+    lines.append("<tr>%s</tr>" % "".join(
+        "<th>%s</th>" % tabular.escape_html(col) for col in cols))
+    for record in records:
+        lines.append("<tr>%s</tr>" % "".join(
+            "<td>%s</td>" % tabular.escape_html(record.get(col))
+            for col in cols))
+    lines.append("</table>")
+    return "\n".join(lines)
+
+
+def parse_csv(text):
+    """The inverse of `to_csv`: the first line is the header, each further
+    line becomes a dict of header name -> cell string.
+
+    Parsing never re-types values — an exported `3` comes back as "3".
+    Quoted cells are understood: they may contain commas, newlines, and
+    doubled double-quotes. An unterminated quote raises ValueError.
+    """
+    if text == "":
+        return []
+    rows = _parse_rows(text)
+    header = rows[0]
+    records = []
+    for row in rows[1:]:
+        record = {}
+        for index, name in enumerate(header):
+            record[name] = row[index] if index < len(row) else ""
+        records.append(record)
+    return records
+
+
+def _parse_rows(text):
+    """Split CSV text into rows of cells, honouring quoted cells. The final
+    row is always emitted, so a trailing newline yields a last row of empty
+    cells (that row is a real, if empty, record)."""
+    rows = []
+    row = []
+    field = []
+    quoted = False
+    index = 0
+    while index < len(text):
+        char = text[index]
+        if quoted:
+            if char == '"':
+                if text[index + 1:index + 2] == '"':
+                    field.append('"')
+                    index += 1
+                else:
+                    quoted = False
+            else:
+                field.append(char)
+        elif char == '"':
+            quoted = True
+        elif char == ",":
+            row.append("".join(field))
+            field = []
+        elif char == "\n":
+            row.append("".join(field))
+            field = []
+            rows.append(row)
+            row = []
+        elif char == "\r" and text[index + 1:index + 2] == "\n":
+            pass
+        else:
+            field.append(char)
+        index += 1
+    if quoted:
+        raise ValueError("unterminated quoted cell")
+    row.append("".join(field))
+    rows.append(row)
+    return rows
+
+
+FORMATS = {
+    "csv": to_csv,
+    "json": to_json,
+    "md": to_markdown,
+    "ndjson": to_ndjson,
+    "tsv": to_tsv,
+}
+
+# Formats that exist but are deliberately kept out of FORMATS — and so out
+# of the registry and off the /export route. Reachable via render_any only.
+EXTRA_FORMATS = {
+    "html": to_html,
+}
+
+
+def render(records, fmt):
+    """Render `records` in one of the `FORMATS`. Anything else — including
+    an `EXTRA_FORMATS` name — raises ValueError."""
+    if fmt not in FORMATS:
+        raise ValueError("unknown export format: %s" % fmt)
+    return FORMATS[fmt](records)
+
+
+def render_any(records, fmt):
+    """Like `render`, but falls through to `EXTRA_FORMATS` as well."""
+    if fmt in FORMATS:
+        return FORMATS[fmt](records)
+    if fmt in EXTRA_FORMATS:
+        return EXTRA_FORMATS[fmt](records)
+    raise ValueError("unknown export format: %s" % fmt)
+
+
+def summary_line(records):
+    """A one-line description of what an export would contain."""
+    return "%s records, %s columns" % (len(records),
+                                       len(tabular.columns(records)))
diff --git a/app/quota.py b/app/quota.py
new file mode 100644
index 0000000..9fb9d50
--- /dev/null
+++ b/app/quota.py
@@ -0,0 +1,134 @@
+"""Windowed quota counter with a logical clock.
+
+This module is the single place where rate-limit counting happens; every
+consumer (`app.ratelimit`, `app.throttle`) delegates here and keeps no
+counters of its own.
+
+Time is *logical*: no wall clock is ever read. `now()` starts at 0.0 and
+only moves when `advance()` is called, which keeps every consumer fully
+deterministic and testable. In a shipped process the clock never moves, so
+a window becomes plain call-counting for the life of the process.
+
+Both the clock and the hit store are module globals cleared by `reset()`.
+
+A hit is kept in the window while its timestamp is `>= now() - window`:
+pruning drops hits *strictly older* than that boundary, so a hit sitting
+exactly on it still counts. `window_seconds=float("inf")` never prunes.
+
+Read-only helpers (`remaining`, `snapshot`, `time_to_next_slot`, `usage`)
+never record a hit and never mutate the store; `take` and `purge` are the
+only mutators.
+"""
+
+_clock = 0.0
+_hits = {}
+
+
+class QuotaExceededError(Exception):
+    """Raised by `take` when a key has no allowance left in its window."""
+
+
+def reset():
+    """Clear the logical clock and every key's recorded hits."""
+    global _clock, _hits
+    _clock = 0.0
+    _hits = {}
+
+
+def now():
+    """The current logical time, in seconds since the last `reset()`."""
+    return _clock
+
+
+def advance(seconds):
+    """Move the logical clock forward by `seconds` and return the new time.
+
+    Raises ValueError for a negative step: the clock is monotonic. The
+    clock is left unchanged when the step is rejected.
+    """
+    global _clock
+    if seconds < 0:
+        raise ValueError("cannot advance the clock backwards: %r" % (seconds,))
+    _clock = float(_clock + seconds)
+    return _clock
+
+
+def _in_window(key, window_seconds):
+    """The key's hit timestamps that are still inside `window_seconds`."""
+    cutoff = _clock - window_seconds
+    return [hit for hit in _hits.get(key, []) if hit >= cutoff]
+
+
+def take(key, limit, window_seconds, burst=0):
+    """Record a hit for `key` and return its in-window hit count.
+
+    Raises QuotaExceededError — without recording — when the key already
+    holds `limit + burst` in-window hits.
+    """
+    kept = _in_window(key, window_seconds)
+    _hits[key] = kept
+    if len(kept) >= limit + burst:
+        raise QuotaExceededError(
+            "quota exceeded for %s: limit %s" % (key, limit))
+    kept.append(_clock)
+    return len(kept)
+
+
+def remaining(key, limit, window_seconds, burst=0):
+    """How many takes `key` has left in the window; floors at 0."""
+    used = len(_in_window(key, window_seconds))
+    return max(0, limit + burst - used)
+
+
+def snapshot(window_seconds):
+    """Map every key with in-window hits to its sorted hit timestamps.
+
+    Keys whose hits have all aged out are omitted. The returned lists are
+    copies: mutating them cannot corrupt the store.
+    """
+    result = {}
+    for key in _hits:
+        kept = sorted(_in_window(key, window_seconds))
+        if kept:
+            result[key] = kept
+    return result
+
+
+def time_to_next_slot(key, limit, window_seconds, burst=0):
+    """Seconds until `key` regains a slot: 0.0 while it still has one.
+
+    Returns `inf` when no hit can ever free a slot — an infinite window, or
+    an allowance of zero (which can never record a hit in the first place).
+    """
+    if remaining(key, limit, window_seconds, burst) > 0:
+        return 0.0
+    kept = _in_window(key, window_seconds)
+    if not kept or window_seconds == float("inf"):
+        return float("inf")
+    return min(kept) + window_seconds - _clock
+
+
+def usage(key, limit, window_seconds, burst=0):
+    """A read-only report of the key's window: used/allowed/remaining/reset_in."""
+    return {
+        "used": len(_in_window(key, window_seconds)),
+        "allowed": limit + burst,
+        "remaining": remaining(key, limit, window_seconds, burst),
+        "reset_in": time_to_next_slot(key, limit, window_seconds, burst),
+    }
+
+
+def purge(window_seconds):
+    """Drop every key's aged-out hits; return how many hits were dropped.
+
+    Keys left with no hits are removed from the store entirely.
+    """
+    dropped = 0
+    for key in list(_hits):
+        kept = _in_window(key, window_seconds)
+        dropped += len(_hits[key]) - len(kept)
+        if kept:
+            _hits[key] = kept
+        else:
+            del _hits[key]
+    return dropped
diff --git a/app/ratelimit.py b/app/ratelimit.py
new file mode 100644
index 0000000..7950e62
--- /dev/null
+++ b/app/ratelimit.py
@@ -0,0 +1,97 @@
+"""Per-actor rate-limit guard for writes.
+
+`dispatch_hook` is registered into the registry's DISPATCH_HOOKS and guards
+POST dispatches only — reads are never counted. The actor is read from the
+dispatch kwargs (`actor`, defaulting to `"anonymous"`), and all counting is
+delegated to `app.quota`: this module holds no counter state of its own.
+
+Config is read with `rate_limit_max_per_window` as the only required key;
+the window and burst always fall back to their defaults, so a caller may
+pass a limit-only config.
+"""
+from app import quota
+
+DEFAULT_WINDOW_SECONDS = 60
+DEFAULT_BURST = 0
+
+
+class RateLimitExceededError(quota.QuotaExceededError):
+    """Raised when an actor exceeds its write allowance for the window."""
+
+
+def reset():
+    """Clear every key's counter and the shared logical clock."""
+    quota.reset()
+
+
+def check_and_increment(key, limit, window_seconds=float("inf"), burst=0):
+    """Record one hit for `key`; return its in-window count.
+
+    Raises RateLimitExceededError once the key has used `limit + burst`
+    hits inside the window.
+    """
+    try:
+        return quota.take(key, limit, window_seconds, burst=burst)
+    except quota.QuotaExceededError as exc:
+        raise RateLimitExceededError(
+            "rate limit exceeded for %s: limit %s" % (key, limit)) from exc
+
+
+def _limit(config):
+    return config["rate_limit_max_per_window"]
+
+
+def _window(config):
+    return config.get("rate_limit_window_seconds", DEFAULT_WINDOW_SECONDS)
+
+
+def _burst(config):
+    return config.get("rate_limit_burst", DEFAULT_BURST)
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS entry: count POSTs per actor, ignore everything else."""
+    if method != "POST":
+        return None
+    key = kwargs.get("actor", "anonymous")
+    check_and_increment(key, _limit(config), _window(config),
+                        burst=_burst(config))
+    return None
+
+
+def retry_after(key, config):
+    """Seconds until `key` regains a slot under `config`'s window."""
+    return quota.time_to_next_slot(key, _limit(config), _window(config),
+                                   burst=_burst(config))
+
+
+def limit_headers(key, config):
+    """The three `X-RateLimit-*` response headers for `key`, as strings.
+
+    `X-RateLimit-Limit` is the configured limit alone; any burst shows up
+    only in the full allowance reported by `X-RateLimit-Remaining`.
+    """
+    return {
+        "X-RateLimit-Limit": str(_limit(config)),
+        "X-RateLimit-Remaining": str(
+            quota.remaining(key, _limit(config), _window(config),
+                            burst=_burst(config))),
+        "X-RateLimit-Reset": str(retry_after(key, config)),
+    }
+
+
+def status_line(key, config):
+    """A one-line human-readable summary of `key`'s current window."""
+    state = quota.usage(key, _limit(config), _window(config),
+                        burst=_burst(config))
+    return "%s: %s/%s, reset in %ss" % (
+        key, state["used"], state["allowed"], state["reset_in"])
+
+
+def check_many(keys, config):
+    """Map each key to whether a POST for it would pass right now."""
+    return {
+        key: quota.remaining(key, _limit(config), _window(config),
+                             burst=_burst(config)) > 0
+        for key in keys
+    }
