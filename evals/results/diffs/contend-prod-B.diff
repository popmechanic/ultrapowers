+++ b/tests/test_tabular.py
@@ -0,0 +1,146 @@
+"""Tests for app/tabular.py: the column-model toolkit app/export.py builds on."""
+import pytest
+
+from app import tabular
+
+
+def test_columns_empty():
+    assert tabular.columns([]) == []
+
+
+def test_columns_sorted_union_of_differing_keys():
+    records = [{"b": 1, "a": 2}, {"c": 3, "a": 4}]
+    assert tabular.columns(records) == ["a", "b", "c"]
+
+
+def test_cell_none_is_empty_string():
+    assert tabular.cell(None) == ""
+
+
+def test_cell_int_no_dot_zero_suffix():
+    assert tabular.cell(3) == "3"
+
+
+def test_cell_float():
+    assert tabular.cell(3.5) == "3.5"
+
+
+def test_cell_string():
+    assert tabular.cell("x") == "x"
+
+
+def test_escape_csv_plain_unquoted():
+    assert tabular.escape_csv("plain") == "plain"
+
+
+def test_escape_csv_comma_quoted():
+    assert tabular.escape_csv("a,b") == '"a,b"'
+
+
+def test_escape_csv_inner_quotes_doubled():
+    assert tabular.escape_csv('say "hi"') == '"say ""hi"""'
+
+
+def test_escape_csv_newline_quoted():
+    assert tabular.escape_csv("line1\nline2") == '"line1\nline2"'
+
+
+def test_escape_csv_empty_stays_unquoted():
+    assert tabular.escape_csv("") == ""
+
+
+def test_widths_header_strictly_wider_than_cells_and_cell_wider_than_header():
+    records = [{"name": "a", "id": "1"}, {"name": "bb", "id": "22222"}]
+    cols = ["id", "name"]
+    w = tabular.widths(records, cols)
+    # "name" header (len 4) is strictly wider than every cell ("a", "bb")
+    assert w["name"] == 4
+    # "id" header (len 2) is narrower than widest cell ("22222" len 5)
+    assert w["id"] == 5
+
+
+def test_pad_left():
+    assert tabular.pad("ab", 4, "left") == "ab  "
+
+
+def test_pad_right():
+    assert tabular.pad("ab", 4, "right") == "  ab"
+
+
+def test_pad_value_beyond_width_unchanged():
+    assert tabular.pad("abcde", 4, "left") == "abcde"
+
+
+def test_pad_invalid_align_raises_even_when_width_already_met():
+    with pytest.raises(ValueError, match="center"):
+        tabular.pad("abcde", 4, "center")
+
+
+def test_sanitize_flat_replaces_tabs_and_newlines():
+    assert tabular.sanitize_flat("a\tb\nc") == "a b c"
+
+
+def test_sanitize_flat_clean_value_passes_through():
+    assert tabular.sanitize_flat("clean") == "clean"
+
+
+def test_escape_html_ampersand_first():
+    assert tabular.escape_html('<a & "b">') == "&lt;a &amp; &quot;b&quot;&gt;"
+
+
+def test_escape_html_clean_value_passes_through():
+    assert tabular.escape_html("clean") == "clean"
+
+
+def test_truncate_short_value_unchanged():
+    assert tabular.truncate("ab", 5) == "ab"
+
+
+def test_truncate_long_value_with_marker():
+    assert tabular.truncate("abcdefgh", 5, marker="...") == "ab..."
+
+
+def test_truncate_width_less_than_marker_raises():
+    with pytest.raises(ValueError):
+        tabular.truncate("abcdefgh", 2, marker="...")
+
+
+def test_wrap_three_word_value_two_widths():
+    assert tabular.wrap("aa bb cc", 5) == ["aa bb", "cc"]
+    assert tabular.wrap("aa bb cc", 8) == ["aa bb cc"]
+
+
+def test_wrap_hard_split_long_word():
+    assert tabular.wrap("abcdefgh", 3) == ["abc", "def", "gh"]
+
+
+def test_wrap_empty_string():
+    assert tabular.wrap("", 5) == [""]
+
+
+def test_wrap_width_less_than_one_raises():
+    with pytest.raises(ValueError):
+        tabular.wrap("abc", 0)
+
+
+def test_fit_truncates_over_long_value():
+    assert tabular.fit("abcdefgh", 5, "left") == "ab..."
+
+
+def test_fit_pads_short_value():
+    assert tabular.fit("ab", 4, "left") == "ab  "
+    assert tabular.fit("ab", 4, "right") == "  ab"
+
+
+def test_fit_bad_align_raises():
+    with pytest.raises(ValueError):
+        tabular.fit("ab", 4, "center")
+
+
+def test_render_row_exact_string():
+    assert tabular.render_row(["a", "bb"], [2, 3], "left") == "| a  | bb  |"
+
+
+def test_render_row_mismatched_lengths_raises():
+    with pytest.raises(ValueError):
+        tabular.render_row(["a", "bb"], [2], "left")
diff --git a/tests/test_throttle.py b/tests/test_throttle.py
new file mode 100644
index 0000000..d453df2
--- /dev/null
+++ b/tests/test_throttle.py
@@ -0,0 +1,109 @@
+import pytest
+
+from app import quota
+from app import throttle
+from app.throttle import PolicyError
+
+
+@pytest.fixture(autouse=True)
+def _reset():
+    quota.reset()
+
+
+def test_policy_error_is_exception_subclass():
+    assert issubclass(PolicyError, Exception)
+
+
+def test_policies_constant_is_exact():
+    assert throttle.POLICIES == {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+
+
+def test_match_policy_longest_prefix_and_method_and_no_match():
+    policies = dict(throttle.POLICIES)
+    assert throttle.match_policy("GET", "/export/full", policies) == {
+        "limit": 10, "window": 60, "burst": 2,
+    }
+
+    policies_with_longer = dict(policies)
+    policies_with_longer["GET /export/full"] = {
+        "limit": 1, "window": 5, "burst": 0,
+    }
+    assert throttle.match_policy(
+        "GET", "/export/full", policies_with_longer
+    ) == {"limit": 1, "window": 5, "burst": 0}
+
+    assert throttle.match_policy("POST", "/export", policies) is None
+
+
+def test_key_for_exact_format():
+    assert throttle.key_for("POST", "/records", "mallory") == "POST /records:mallory"
+
+
+def test_enforce_no_match_returns_none_and_records_nothing():
+    policies = {"GET /export": throttle.POLICIES["GET /export"]}
+    assert throttle.enforce("POST", "/records", "mallory", policies) is None
+    # nothing recorded: a subsequent take with the would-be key still starts fresh
+    assert quota.remaining(
+        throttle.key_for("POST", "/records", "mallory"), 5, 60
+    ) == 5
+
+
+def test_enforce_delegates_to_quota_take(monkeypatch):
+    calls = []
+
+    def fake_take(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", fake_take)
+    policies = {"POST /records": {"limit": 5, "window": 60, "burst": 0}}
+    result = throttle.enforce("POST", "/records", "mallory", policies)
+    assert result == 1
+    assert calls == [
+        (("POST /records:mallory", 5, 60), {"burst": 0})
+    ]
+
+
+def test_enforce_raises_policy_error_when_exhausted():
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    throttle.enforce("POST", "/records", "mallory", policies)
+    with pytest.raises(PolicyError) as exc_info:
+        throttle.enforce("POST", "/records", "mallory", policies)
+    message = str(exc_info.value)
+    assert "POST /records:mallory" in message
+    assert "1" in message
+
+
+def test_remaining_for_none_when_no_match_and_read_only():
+    policies = {"POST /records": {"limit": 2, "window": 60, "burst": 0}}
+    assert throttle.remaining_for("GET", "/export", "mallory", policies) is None
+
+    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 2
+    # read-only: a subsequent enforce still succeeds
+    throttle.enforce("POST", "/records", "mallory", policies)
+    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 1
+    throttle.enforce("POST", "/records", "mallory", policies)
+
+
+def test_describe_policies_exact_multiline_string_sorted():
+    policies = {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+    assert throttle.describe_policies(policies) == (
+        "GET /export: limit=10, window=60, burst=2\n"
+        "POST /records: limit=5, window=60, burst=0"
+    )
+    assert throttle.describe_policies({}) == "(no policies)"
+
+
+def test_end_to_end_enforce_and_advance_frees_slot():
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    throttle.enforce("POST", "/records", "mallory", policies)
+    with pytest.raises(PolicyError):
+        throttle.enforce("POST", "/records", "mallory", policies)
+    quota.advance(61)
+    throttle.enforce("POST", "/records", "mallory", policies)
diff --git a/tests/test_validation.py b/tests/test_validation.py
new file mode 100644
index 0000000..a77dc34
--- /dev/null
+++ b/tests/test_validation.py
@@ -0,0 +1,239 @@
+"""Tests for app/validation.py — input-validation layer used by PRE_CREATE_HOOKS."""
+import pytest
+
+from app import schema, validation
+from app.validation import (
+    ValidationError,
+    error_code,
+    explain_config,
+    pre_create_hook,
+    validate_fields,
+    validate_many,
+)
+
+REQUIRED = ["name", "amount"]
+MAX_AMOUNT = 100
+
+
+def test_validation_error_is_exception_subclass():
+    assert issubclass(ValidationError, Exception)
+
+
+def test_missing_name_raises_with_field_name():
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({"amount": 1}, REQUIRED, MAX_AMOUNT)
+    assert "name" in str(exc.value)
+
+
+def test_missing_amount_raises_with_field_name():
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({"name": "a"}, REQUIRED, MAX_AMOUNT)
+    assert "amount" in str(exc.value)
+
+
+def test_both_missing_names_name_first():
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({}, REQUIRED, MAX_AMOUNT)
+    assert str(exc.value) == "missing field: name"
+
+
+def test_amount_as_string_raises_numeric():
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({"name": "a", "amount": "3"}, REQUIRED, MAX_AMOUNT)
+    assert "numeric" in str(exc.value)
+
+
+def test_amount_as_bool_raises_numeric():
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({"name": "a", "amount": True}, REQUIRED, MAX_AMOUNT)
+    assert "numeric" in str(exc.value)
+
+
+def test_negative_amount_raises_non_negative():
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({"name": "a", "amount": -1}, REQUIRED, MAX_AMOUNT)
+    assert "non-negative" in str(exc.value)
+
+
+def test_zero_amount_is_accepted():
+    result = validate_fields({"name": "a", "amount": 0}, REQUIRED, MAX_AMOUNT)
+    assert result["amount"] == 0
+
+
+def test_over_max_amount_raises_and_boundary_accepted():
+    with pytest.raises(ValidationError) as exc:
+        validate_fields(
+            {"name": "a", "amount": MAX_AMOUNT + 1}, REQUIRED, MAX_AMOUNT
+        )
+    assert "max_amount" in str(exc.value)
+    result = validate_fields({"name": "a", "amount": MAX_AMOUNT}, REQUIRED, MAX_AMOUNT)
+    assert result["amount"] == MAX_AMOUNT
+
+
+def test_bad_name_raises_non_empty_string():
+    for bad_name in ["", "   ", 42]:
+        with pytest.raises(ValidationError) as exc:
+            validate_fields({"name": bad_name, "amount": 1}, REQUIRED, MAX_AMOUNT)
+        assert "non-empty string" in str(exc.value)
+
+
+def test_success_returns_new_dict_with_stripped_name():
+    fields = {"name": "  ada  ", "amount": 1, "extra": "x"}
+    result = validate_fields(fields, REQUIRED, MAX_AMOUNT)
+    assert result is not fields
+    assert result["name"] == "ada"
+    assert result["amount"] == 1
+    assert result["extra"] == "x"
+    assert fields["name"] == "  ada  "
+
+
+def test_extra_keys_pass_untouched():
+    fields = {"name": "a", "amount": 1, "note": "hi", "tags": [1, 2]}
+    result = validate_fields(fields, REQUIRED, MAX_AMOUNT)
+    assert result["note"] == "hi"
+    assert result["tags"] == [1, 2]
+
+
+def test_pre_create_hook_matches_direct_validate_fields_calls():
+    config = {"validation_required_fields": REQUIRED, "validation_max_amount": MAX_AMOUNT}
+    good = {"name": "a", "amount": 1}
+    assert pre_create_hook(None, config, good) == validate_fields(
+        good, REQUIRED, MAX_AMOUNT
+    )
+    bad = {"amount": 1}
+    with pytest.raises(ValidationError):
+        pre_create_hook(None, config, bad)
+    with pytest.raises(ValidationError):
+        validate_fields(bad, REQUIRED, MAX_AMOUNT)
+
+
+def test_exact_messages_via_catalog():
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({"amount": 1}, REQUIRED, MAX_AMOUNT)
+    assert str(exc.value) == "missing field: name"
+
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({"name": "a", "amount": True}, REQUIRED, MAX_AMOUNT)
+    assert str(exc.value) == "field amount must be numeric (got bool)"
+
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({"name": "a", "amount": -1}, REQUIRED, MAX_AMOUNT)
+    assert str(exc.value) == "field amount must be non-negative"
+
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({"name": "a", "amount": MAX_AMOUNT + 1}, REQUIRED, MAX_AMOUNT)
+    assert str(exc.value) == "field amount exceeds max_amount %d" % MAX_AMOUNT
+
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({"name": "", "amount": 1}, REQUIRED, MAX_AMOUNT)
+    assert str(exc.value) == "field name must be a non-empty string"
+
+
+def test_float_amounts_are_legal_including_boundary():
+    result = validate_fields({"name": "a", "amount": 3.5}, REQUIRED, MAX_AMOUNT)
+    assert result["amount"] == 3.5
+    result = validate_fields(
+        {"name": "a", "amount": float(MAX_AMOUNT)}, REQUIRED, MAX_AMOUNT
+    )
+    assert result["amount"] == float(MAX_AMOUNT)
+
+
+def test_non_finite_and_none_amounts_raise_numeric():
+    for bad in [None, float("nan"), float("inf"), float("-inf")]:
+        with pytest.raises(ValidationError) as exc:
+            validate_fields({"name": "a", "amount": bad}, REQUIRED, MAX_AMOUNT)
+        assert "numeric" in str(exc.value)
+
+
+def test_name_internal_whitespace_preserved_and_non_ascii_accepted():
+    result = validate_fields(
+        {"name": "  ada lovelace  ", "amount": 1}, REQUIRED, MAX_AMOUNT
+    )
+    assert result["name"] == "ada lovelace"
+
+    result = validate_fields({"name": "Δ", "amount": 1}, REQUIRED, MAX_AMOUNT)
+    assert result["name"] == "Δ"
+
+
+def test_empty_required_fields_with_empty_fields_passes():
+    result = validate_fields({}, [], MAX_AMOUNT)
+    assert result == {}
+
+
+def test_max_amount_zero_boundary():
+    result = validate_fields({"name": "a", "amount": 0}, ["name"], 0)
+    assert result["amount"] == 0
+    with pytest.raises(ValidationError):
+        validate_fields({"name": "a", "amount": 1}, ["name"], 0)
+
+
+def test_returned_dict_is_shallow_copy():
+    tags = [1, 2]
+    fields = {"name": "a", "amount": 1, "tags": tags}
+    result = validate_fields(fields, REQUIRED, MAX_AMOUNT)
+    assert result["tags"] is tags
+
+
+def test_delegation_is_real_not_a_reimplementation(monkeypatch):
+    monkeypatch.setattr(schema, "is_valid_amount", lambda v: False)
+    with pytest.raises(ValidationError) as exc:
+        validate_fields({"name": "a", "amount": 5}, REQUIRED, MAX_AMOUNT)
+    assert "numeric" in str(exc.value)
+
+
+def test_validate_many_returns_validated_and_errors_in_order():
+    entries = [
+        {"name": "a", "amount": 1},
+        {"amount": 1},  # missing name
+        {"name": "b", "amount": 2},
+        {"name": "c", "amount": -1},  # negative
+    ]
+    validated, errors = validate_many(entries, REQUIRED, MAX_AMOUNT)
+    assert validated == [
+        {"name": "a", "amount": 1},
+        {"name": "b", "amount": 2},
+    ]
+    assert errors == [
+        (1, "missing field: name"),
+        (3, "field amount must be non-negative"),
+    ]
+    # inputs unmutated
+    assert entries[0] == {"name": "a", "amount": 1}
+    assert entries[1] == {"amount": 1}
+
+
+def test_error_code_maps_each_catalog_code():
+    assert error_code("missing field: name") == "missing"
+    assert error_code("field amount must be numeric (got str)") == "numeric"
+    assert error_code("field amount must be non-negative") == "non_negative"
+    assert error_code("field amount exceeds max_amount 100") == "max"
+    assert error_code("field name must be a non-empty string") == "non_empty"
+    assert error_code("field name must be a string") == "type_str"
+
+
+def test_error_code_unmatchable_message_raises_value_error():
+    with pytest.raises(ValueError):
+        error_code("totally unrelated message")
+
+
+def test_error_code_built_from_catalog_at_call_time(monkeypatch):
+    monkeypatch.setitem(schema.ERROR_CATALOG, "missing", "custom missing: {field}")
+    assert error_code("custom missing: name") == "missing"
+
+
+def test_explain_config_literal():
+    config1 = {
+        "validation_required_fields": ["name", "amount"],
+        "validation_max_amount": 100,
+    }
+    assert explain_config(config1) == (
+        "validation config:\n  required: name,amount\n  max_amount: 100"
+    )
+
+    config2 = {
+        "validation_required_fields": ["title"],
+        "validation_max_amount": 50,
+    }
+    assert explain_config(config2) == (
+        "validation config:\n  required: title\n  max_amount: 50"
+    )
