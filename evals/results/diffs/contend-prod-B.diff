@@ -0,0 +1,221 @@
+"""Tests for app/rules.py — a pure rule-combinator layer on schema predicates."""
+import pytest
+
+from app import rules, schema
+from app.rules import (
+    BUILTINS,
+    RuleError,
+    all_of,
+    any_of,
+    apply_rules,
+    check,
+    describe_rules,
+    explain,
+    explain_failures,
+    first_failure,
+    negate,
+    parse_rule,
+    parse_rules,
+    rule,
+    when,
+)
+
+
+def test_rule_error_is_exception_subclass_distinct_from_schema_error():
+    assert issubclass(RuleError, Exception)
+    assert not issubclass(RuleError, schema.SchemaError)
+
+
+def test_rule_constructor():
+    r = rule("positive", lambda v: v > 0)
+    assert r == {"name": "positive", "test": r["test"]}
+    assert r["name"] == "positive"
+    assert r["test"](5) is True
+
+
+def test_rule_constructor_rejects_bad_names():
+    with pytest.raises(ValueError):
+        rule("", lambda v: True)
+    with pytest.raises(ValueError):
+        rule(None, lambda v: True)
+
+
+def test_check():
+    r = rule("truthy", lambda v: v)
+    assert check(1, r) is True
+    assert check(0, r) is False
+
+
+def test_all_of_composite():
+    a = rule("a", lambda v: v > 0)
+    b = rule("b", lambda v: v < 10)
+    composite = all_of(a, b)
+    assert composite["name"] == "all(a,b)"
+    assert check(5, composite) is True
+    assert check(-1, composite) is False
+    assert check(20, composite) is False
+
+
+def test_all_of_no_children_passes_everything():
+    composite = all_of()
+    assert composite["name"] == "all()"
+    assert check("anything", composite) is True
+    assert check(None, composite) is True
+
+
+def test_any_of_composite():
+    a = rule("a", lambda v: v > 100)
+    b = rule("b", lambda v: v < 10)
+    composite = any_of(a, b)
+    assert composite["name"] == "any(a,b)"
+    assert check(5, composite) is True
+    assert check(50, composite) is False
+
+
+def test_any_of_no_children_raises_value_error():
+    with pytest.raises(ValueError):
+        any_of()
+
+
+def test_negate():
+    a = rule("a", lambda v: v > 0)
+    n = negate(a)
+    assert n["name"] == "not(a)"
+    assert check(5, n) is False
+    assert check(-5, n) is True
+
+
+def test_when_truth_table():
+    cond = rule("cond", lambda v: v["c"])
+    then = rule("then", lambda v: v["t"])
+    w = when(cond, then)
+    assert w["name"] == "when(cond,then)"
+    assert check({"c": True, "t": True}, w) is True
+    assert check({"c": True, "t": False}, w) is False
+    assert check({"c": False, "t": True}, w) is True
+    assert check({"c": False, "t": False}, w) is True
+
+
+def test_explain():
+    a = rule("a", lambda v: v > 0)
+    assert explain(5, a) == "a: pass"
+    assert explain(-5, a) == "a: fail"
+
+
+def test_apply_rules_insertion_order_and_no_mutation():
+    positive = rule("positive", lambda v: v > 0)
+    non_empty = rule("non_empty", lambda v: bool(v))
+    rules_by_field = {"amount": positive, "name": non_empty}
+    fields = {"amount": -1, "name": ""}
+    result = apply_rules(fields, rules_by_field)
+    assert result == [
+        "field amount failed positive",
+        "field name failed non_empty",
+    ]
+    assert fields == {"amount": -1, "name": ""}
+
+
+def test_apply_rules_skips_absent_fields_and_empty_when_all_pass():
+    positive = rule("positive", lambda v: v > 0)
+    assert apply_rules({}, {"amount": positive}) == []
+    assert apply_rules({"amount": 5}, {"amount": positive}) == []
+
+
+def test_first_failure():
+    positive = rule("positive", lambda v: v > 0)
+    non_empty = rule("non_empty", lambda v: bool(v))
+    rules_by_field = {"amount": positive, "name": non_empty}
+    assert first_failure({"amount": -1, "name": ""}, rules_by_field) == (
+        "amount",
+        "positive",
+    )
+    assert first_failure({"amount": 1, "name": "a"}, rules_by_field) is None
+
+
+def test_explain_failures():
+    positive = rule("positive", lambda v: v > 0)
+    non_empty = rule("non_empty", lambda v: bool(v))
+    rules_by_field = {"amount": positive, "name": non_empty, "note": positive}
+    fields = {"amount": -1, "name": "ok", "note": -5}
+    assert explain_failures(fields, rules_by_field) == [
+        "positive: fail",
+        "positive: fail",
+    ]
+
+
+def test_explain_failures_all_pass_is_empty():
+    positive = rule("positive", lambda v: v > 0)
+    assert explain_failures({"amount": 5}, {"amount": positive}) == []
+
+
+def test_builtins_keys_and_behavior():
+    assert set(BUILTINS.keys()) == {"number", "str", "non_empty"}
+    assert check(5, BUILTINS["number"]) is True
+    assert check("3", BUILTINS["number"]) is False
+    assert check("a", BUILTINS["str"]) is True
+    assert check(5, BUILTINS["str"]) is False
+    assert check("a", BUILTINS["non_empty"]) is True
+    assert check("  ", BUILTINS["non_empty"]) is False
+
+
+def test_parse_rule_single_builtin():
+    r = parse_rule("number")
+    assert r["name"] == BUILTINS["number"]["name"]
+    assert check(5, r) is True
+
+
+def test_parse_rule_composite_in_text_order():
+    r = parse_rule("number&non_empty")
+    assert r["name"] == all_of(BUILTINS["number"], BUILTINS["non_empty"])["name"]
+
+
+def test_parse_rule_unknown_token_raises_value_error_naming_token():
+    with pytest.raises(ValueError) as exc:
+        parse_rule("bogus")
+    assert "bogus" in str(exc.value)
+
+
+def test_parse_rule_empty_string_raises_value_error():
+    with pytest.raises(ValueError):
+        parse_rule("")
+
+
+def test_parse_rules_maps_dict_and_composes_end_to_end():
+    text_by_field = {"amount": "number", "name": "str&non_empty"}
+    parsed = parse_rules(text_by_field)
+    assert list(parsed.keys()) == ["amount", "name"]
+
+    fields = {"amount": "bad", "name": ""}
+    result = apply_rules(fields, parsed)
+    assert result == [
+        "field amount failed %s" % BUILTINS["number"]["name"],
+        "field name failed %s" % parsed["name"]["name"],
+    ]
+
+
+def test_parse_rules_unknown_token_names_field_and_token():
+    with pytest.raises(ValueError) as exc:
+        parse_rules({"amount": "bogus"})
+    msg = str(exc.value)
+    assert "amount" in msg
+    assert "bogus" in msg
+
+
+def test_parse_rules_empty_dict():
+    assert parse_rules({}) == {}
+
+
+def test_describe_rules_literal():
+    rules_by_field = {"amount": BUILTINS["number"], "name": parse_rule("str&non_empty")}
+    expected = "amount: number\nname: all(str,non_empty)"
+    assert describe_rules(rules_by_field) == expected
+
+
+def test_describe_rules_empty():
+    assert describe_rules({}) == "(no rules)"
+
+
+def test_delegation_is_real_not_a_private_copy(monkeypatch):
+    monkeypatch.setattr(schema, "is_valid_amount", lambda v: False)
+    r = parse_rule("number")
+    assert check(5, r) is False
