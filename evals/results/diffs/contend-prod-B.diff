+++ b/tests/test_export.py
@@ -0,0 +1,242 @@
+"""Tests for the export formatters in app/export.py."""
+import json
+
+import pytest
+
+from app import export, tabular
+
+
+TWO_RECORDS = [
+    {"name": "Alice", "age": 30},
+    {"name": "Bob", "score": 5},
+]
+
+
+def test_to_csv_empty():
+    assert export.to_csv([]) == ""
+
+
+def test_to_csv_header_sorted_and_missing_fields_blank():
+    assert export.to_csv(TWO_RECORDS) == "age,name,score\n30,Alice,\n,Bob,5"
+
+
+def test_to_csv_int_round_trips_without_dot_zero():
+    records = [{"amount": 42}]
+    assert export.to_csv(records) == "amount\n42"
+
+
+def test_to_json_empty():
+    assert export.to_json([]) == "[]"
+
+
+def test_to_json_round_trips_and_sorts_keys():
+    text = export.to_json(TWO_RECORDS)
+    assert json.loads(text) == TWO_RECORDS
+    assert text == json.dumps(TWO_RECORDS, sort_keys=True)
+
+
+def test_to_csv_escapes_comma_and_quote_cells():
+    records = [{"name": "Smith, Jane"}]
+    assert export.to_csv(records) == 'name\n"Smith, Jane"'
+
+    records = [{"name": 'Say "hi"'}]
+    assert export.to_csv(records) == 'name\n"Say ""hi"""'
+
+
+def test_to_csv_plain_record_byte_identical_to_unescaped_join():
+    records = [{"name": "Alice", "age": 30}]
+    assert export.to_csv(records) == "age,name\n30,Alice"
+
+
+def test_to_markdown_empty():
+    assert export.to_markdown([]) == ""
+
+
+def test_to_markdown_two_records_unequal_keys():
+    expected = (
+        "| age | name  | score |\n"
+        "| --- | ----- | ----- |\n"
+        "| 30  | Alice |       |\n"
+        "|     | Bob   | 5     |"
+    )
+    assert export.to_markdown(TWO_RECORDS) == expected
+
+
+def test_to_ndjson_empty():
+    assert export.to_ndjson([]) == ""
+
+
+def test_to_ndjson_two_records():
+    expected = '{"age": 30, "name": "Alice"}\n{"name": "Bob", "score": 5}'
+    text = export.to_ndjson(TWO_RECORDS)
+    assert text == expected
+    for line in text.split("\n"):
+        json.loads(line)
+
+
+def test_to_markdown_left_align_exact():
+    records = [{"a": 1}, {"a": 22}]
+    expected = "| a  |\n| -- |\n| 1  |\n| 22 |"
+    assert export.to_markdown(records, align="left") == expected
+
+
+def test_to_markdown_right_align_exact():
+    records = [{"a": 1}, {"a": 22}]
+    expected = "|  a |\n| -: |\n|  1 |\n| 22 |"
+    assert export.to_markdown(records, align="right") == expected
+
+
+def test_to_markdown_invalid_align_raises_even_when_widths_already_met():
+    records = [{"a": 1}, {"a": 2}]
+    with pytest.raises(ValueError):
+        export.to_markdown(records, align="center")
+
+
+def test_to_tsv_empty():
+    assert export.to_tsv([]) == ""
+
+
+def test_to_tsv_two_records():
+    assert export.to_tsv(TWO_RECORDS) == "age\tname\tscore\n30\tAlice\t\n\tBob\t5"
+
+
+def test_to_tsv_sanitizes_cells_and_headers():
+    records = [{"a\tb": "line1\nline2"}]
+    assert export.to_tsv(records) == "a b\nline1 line2"
+
+
+def test_to_html_empty():
+    assert export.to_html([]) == ""
+
+
+def test_to_html_two_records_with_special_chars():
+    records = [
+        {"name": "A & <B>", "age": 1},
+        {"name": "C", "score": 2},
+    ]
+    expected = (
+        "<table>\n"
+        "<tr><th>age</th><th>name</th><th>score</th></tr>\n"
+        "<tr><td>1</td><td>A &amp; &lt;B&gt;</td><td></td></tr>\n"
+        "<tr><td></td><td>C</td><td>2</td></tr>\n"
+        "</table>"
+    )
+    assert export.to_html(records) == expected
+
+
+def test_parse_csv_empty():
+    assert export.parse_csv("") == []
+
+
+def test_parse_csv_is_inverse_of_to_csv():
+    records = [{"amount": 3, "name": "ab"}]
+    text = export.to_csv(records)
+    assert export.parse_csv(text) == [{"amount": "3", "name": "ab"}]
+
+
+def test_parse_csv_handles_quotes():
+    assert export.parse_csv('col\n"a,b"') == [{"col": "a,b"}]
+    assert export.parse_csv('col\n"say ""hi"""') == [{"col": 'say "hi"'}]
+
+
+def test_parse_csv_round_trips_comma_quote_and_newline():
+    rec = {"value": 'a,"b\nc'}
+    text = export.to_csv([rec])
+    parsed = export.parse_csv(text)
+    expected = {k: tabular.cell(v) for k, v in rec.items()}
+    assert parsed == [expected]
+
+
+def test_parse_csv_unterminated_quote_raises():
+    with pytest.raises(ValueError):
+        export.parse_csv('col\n"unterminated')
+
+
+def test_parse_csv_single_column_trailing_newline_keeps_empty_row():
+    assert export.parse_csv("a\n") == [{"a": ""}]
+
+
+def test_parse_csv_single_column_no_trailing_newline_is_header_only():
+    assert export.parse_csv("a") == []
+
+
+def test_formats_dict_exact_keys():
+    assert set(export.FORMATS.keys()) == {"csv", "json", "md", "ndjson", "tsv"}
+    assert export.FORMATS["csv"] is export.to_csv
+    assert export.FORMATS["json"] is export.to_json
+    assert export.FORMATS["md"] is export.to_markdown
+    assert export.FORMATS["ndjson"] is export.to_ndjson
+    assert export.FORMATS["tsv"] is export.to_tsv
+
+
+def test_extra_formats_dict_exact_keys():
+    assert set(export.EXTRA_FORMATS.keys()) == {"html"}
+    assert export.EXTRA_FORMATS["html"] is export.to_html
+
+
+def test_render_delegates_to_formats():
+    for name, fn in export.FORMATS.items():
+        assert export.render(TWO_RECORDS, name) == fn(TWO_RECORDS)
+
+
+def test_render_unknown_format_raises():
+    with pytest.raises(ValueError, match="xml"):
+        export.render(TWO_RECORDS, "xml")
+
+
+def test_render_does_not_serve_extra_formats():
+    with pytest.raises(ValueError, match="html"):
+        export.render(TWO_RECORDS, "html")
+
+
+def test_render_any_serves_formats_and_extra_formats():
+    assert export.render_any(TWO_RECORDS, "csv") == export.to_csv(TWO_RECORDS)
+    assert export.render_any(TWO_RECORDS, "html") == export.to_html(TWO_RECORDS)
+
+
+def test_render_any_unknown_format_raises():
+    with pytest.raises(ValueError, match="xml"):
+        export.render_any(TWO_RECORDS, "xml")
+
+
+def test_summary_line():
+    assert export.summary_line(TWO_RECORDS) == "2 records, 3 columns"
+    assert export.summary_line([]) == "0 records, 0 columns"
+
+
+SINGLE_RECORD = [{"a": 1, "b": 2}]
+
+
+def test_single_record_to_csv():
+    assert export.to_csv(SINGLE_RECORD) == "a,b\n1,2"
+
+
+def test_single_record_to_json():
+    assert export.to_json(SINGLE_RECORD) == json.dumps(
+        SINGLE_RECORD, sort_keys=True
+    )
+
+
+def test_single_record_to_markdown():
+    assert export.to_markdown(SINGLE_RECORD) == (
+        "| a | b |\n| - | - |\n| 1 | 2 |"
+    )
+
+
+def test_single_record_to_ndjson():
+    assert export.to_ndjson(SINGLE_RECORD) == json.dumps(
+        SINGLE_RECORD[0], sort_keys=True
+    )
+
+
+def test_single_record_to_tsv():
+    assert export.to_tsv(SINGLE_RECORD) == "a\tb\n1\t2"
+
+
+def test_single_record_to_html():
+    assert export.to_html(SINGLE_RECORD) == (
+        "<table>\n"
+        "<tr><th>a</th><th>b</th></tr>\n"
+        "<tr><td>1</td><td>2</td></tr>\n"
+        "</table>"
+    )
diff --git a/tests/test_quota.py b/tests/test_quota.py
new file mode 100644
index 0000000..360079b
--- /dev/null
+++ b/tests/test_quota.py
@@ -0,0 +1,214 @@
+"""Tests for app/quota.py — the windowed counter app/ratelimit.py delegates to."""
+import pytest
+
+from app import quota
+from app.quota import QuotaExceededError
+
+
+@pytest.fixture(autouse=True)
+def _reset():
+    quota.reset()
+
+
+def test_quota_exceeded_error_is_exception_subclass():
+    assert issubclass(QuotaExceededError, Exception)
+
+
+def test_now_and_advance_are_a_monotonic_logical_clock():
+    assert quota.now() == 0.0
+    assert quota.advance(30) == 30.0
+    assert quota.now() == 30.0
+    with pytest.raises(ValueError):
+        quota.advance(-1)
+    assert quota.now() == 30.0
+
+
+def test_take_counts_hits_then_raises_with_key_and_limit_in_message():
+    assert quota.take("k", limit=2, window_seconds=60) == 1
+    assert quota.take("k", limit=2, window_seconds=60) == 2
+    with pytest.raises(QuotaExceededError) as exc_info:
+        quota.take("k", limit=2, window_seconds=60)
+    msg = str(exc_info.value)
+    assert "k" in msg
+    assert "2" in msg
+
+
+def test_window_pruning_ages_out_old_hits():
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(61)
+    assert quota.take("k", 2, 60) == 1
+
+    quota.reset()
+    quota.take("k", 2, 60)  # t=0
+    quota.advance(30)
+    quota.take("k", 2, 60)  # t=30, count=2
+    quota.advance(31)  # now=61: t=0 hit aged out (>60 old), t=30 hit still in window (31 old)
+    assert quota.take("k", 2, 60) == 2
+    quota.advance(30)  # now=91: t=30 hit now aged out (61 old), t=61 hit still in window (30 old)
+    assert quota.take("k", 2, 60) == 2
+
+
+def test_infinite_window_never_prunes():
+    quota.take("k", limit=1, window_seconds=float("inf"))
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=1, window_seconds=float("inf"))
+    quota.advance(10**6)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=1, window_seconds=float("inf"))
+
+
+def test_burst_allowance():
+    quota.take("k", limit=2, window_seconds=60, burst=1)
+    quota.take("k", limit=2, window_seconds=60, burst=1)
+    quota.take("k", limit=2, window_seconds=60, burst=1)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60, burst=1)
+
+
+def test_burst_defaults_to_zero():
+    quota.take("k", limit=1, window_seconds=60)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=1, window_seconds=60)
+
+
+def test_per_key_independence():
+    quota.take("a", limit=2, window_seconds=60)
+    quota.take("b", limit=2, window_seconds=60)
+    quota.take("a", limit=2, window_seconds=60)
+    with pytest.raises(QuotaExceededError):
+        quota.take("a", limit=2, window_seconds=60)
+    # "b" is untouched — still has one slot left
+    assert quota.take("b", limit=2, window_seconds=60) == 2
+    with pytest.raises(QuotaExceededError):
+        quota.take("b", limit=2, window_seconds=60)
+
+
+def test_reset_clears_clock_and_all_keys():
+    quota.take("k", limit=1, window_seconds=60)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=1, window_seconds=60)
+    quota.advance(30)
+    quota.reset()
+    assert quota.now() == 0.0
+    assert quota.take("k", limit=1, window_seconds=60) == 1
+
+
+def test_remaining_is_read_only_and_reports_correctly():
+    assert quota.remaining("k", limit=2, window_seconds=60) == 2
+    quota.take("k", limit=2, window_seconds=60)
+    assert quota.remaining("k", limit=2, window_seconds=60) == 1
+    assert quota.remaining("k", limit=2, window_seconds=60) == 1
+    quota.take("k", limit=2, window_seconds=60)
+    assert quota.remaining("k", limit=2, window_seconds=60) == 0
+    # floors at 0 -- no negative overshoot possible via take, but the read is 0
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60)
+    assert quota.remaining("k", limit=2, window_seconds=60) == 0
+    # a subsequent take still behaves as before (still exhausted)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60)
+    # after advancing past the window, recovers to full allowance
+    quota.advance(61)
+    assert quota.remaining("k", limit=2, window_seconds=60) == 2
+
+
+def test_remaining_includes_burst_in_full_allowance():
+    assert quota.remaining("k", limit=2, window_seconds=60, burst=1) == 3
+    quota.take("k", limit=2, window_seconds=60, burst=1)
+    assert quota.remaining("k", limit=2, window_seconds=60, burst=1) == 2
+
+
+def test_snapshot_returns_deep_copy_dict_of_in_window_hits():
+    quota.take("k1", limit=5, window_seconds=60)  # t=0
+    quota.advance(10)
+    quota.take("k1", limit=5, window_seconds=60)  # t=10
+    quota.take("k2", limit=5, window_seconds=60)  # t=10
+    quota.advance(60)  # now=70; k1's t=0 hit ages out (70-0=70 > 60), t=10 hit stays (60 not > 60)
+    snap = quota.snapshot(60)
+    assert snap == {"k1": [10.0], "k2": [10.0]}
+
+    snap["k1"].append(999)
+    later_snap = quota.snapshot(60)
+    assert later_snap == {"k1": [10.0], "k2": [10.0]}
+    assert quota.remaining("k1", limit=5, window_seconds=60) == 4
+
+
+def test_snapshot_omits_keys_with_no_in_window_hits():
+    quota.take("k", limit=5, window_seconds=60)  # t=0
+    quota.advance(61)
+    assert quota.snapshot(60) == {}
+
+
+def test_time_to_next_slot_zero_when_remaining_positive():
+    assert quota.time_to_next_slot("k", limit=2, window_seconds=60) == 0.0
+    quota.take("k", limit=2, window_seconds=60)
+    assert quota.time_to_next_slot("k", limit=2, window_seconds=60) == 0.0
+
+
+def test_time_to_next_slot_when_exhausted():
+    quota.take("k", limit=2, window_seconds=60)  # t=0
+    quota.take("k", limit=2, window_seconds=60)  # t=0
+    quota.advance(10)
+    assert quota.time_to_next_slot("k", limit=2, window_seconds=60) == 50.0
+
+
+def test_time_to_next_slot_infinite_window():
+    quota.take("k", limit=1, window_seconds=float("inf"))
+    assert quota.time_to_next_slot("k", limit=1, window_seconds=float("inf")) == float("inf")
+
+
+def test_time_to_next_slot_zero_allowance_never_raises():
+    assert quota.time_to_next_slot("k", 0, 60) == float("inf")
+
+
+def test_time_to_next_slot_boundary_at_reset_instant():
+    quota.take("k", limit=2, window_seconds=60)  # t=0
+    quota.take("k", limit=2, window_seconds=60)  # t=0
+    quota.advance(60)  # now=60; hit at t=0 is exactly now - window -> pruned (strictly older)
+    assert quota.time_to_next_slot("k", limit=2, window_seconds=60) == 0.0
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60)
+
+
+def test_usage_exact_dict_in_three_states():
+    # fresh
+    assert quota.usage("k", limit=2, window_seconds=60) == {
+        "used": 0,
+        "allowed": 2,
+        "remaining": 2,
+        "reset_in": 0.0,
+    }
+    # partially used
+    quota.take("k", limit=2, window_seconds=60)  # t=0
+    assert quota.usage("k", limit=2, window_seconds=60) == {
+        "used": 1,
+        "allowed": 2,
+        "remaining": 1,
+        "reset_in": 0.0,
+    }
+    # exhausted mid-window
+    quota.take("k", limit=2, window_seconds=60)  # t=0
+    quota.advance(10)
+    assert quota.usage("k", limit=2, window_seconds=60) == {
+        "used": 2,
+        "allowed": 2,
+        "remaining": 0,
+        "reset_in": 50.0,
+    }
+    # read-only: a subsequent take still succeeds where it should (it should not here)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60)
+
+
+def test_purge_drops_aged_out_hits_and_returns_count():
+    quota.take("k1", limit=5, window_seconds=60)  # t=0
+    quota.take("k1", limit=5, window_seconds=60)  # t=0
+    quota.advance(10)
+    quota.take("k2", limit=5, window_seconds=60)  # t=10
+    quota.advance(60)  # now=70: k1's two t=0 hits aged out, k2's t=10 hit stays (60 not > 60)
+    dropped = quota.purge(60)
+    assert dropped == 2
+    assert "k1" not in quota.snapshot(60)
+    assert quota.snapshot(60) == {"k2": [10.0]}
+    assert quota.purge(60) == 0
