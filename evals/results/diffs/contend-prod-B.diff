diff --git a/app/audit.py b/app/audit.py
new file mode 100644
index 0000000..328b71d
--- /dev/null
+++ b/app/audit.py
@@ -0,0 +1,76 @@
+"""Module-global audit log of every dispatched call.
+
+`dispatch_hook` is registered into `registry.DISPATCH_HOOKS` and fires on
+EVERY call the app dispatches (unlike rate limiting, it does not
+special-case the method). It always logs — `DEFAULT_CONFIG` carries an
+`audit_log_enabled` key reserved for a future on/off switch, but no code
+in this plan reads it.
+
+The log is a module-global list capped at `max_entries` (read from
+`config["audit_log_max_entries"]` by `dispatch_hook`); once full, the
+oldest entry is dropped for each new one appended. `dropped()` tracks how
+many entries have been evicted since the last `clear()`.
+"""
+
+_log = []
+_dropped = 0
+
+
+def clear():
+    """Reset the log and the dropped counter."""
+    global _log, _dropped
+    _log = []
+    _dropped = 0
+
+
+def entries():
+    """Return a copy of the log, oldest first — a deep-enough copy that
+    mutating a returned entry does not affect the live log."""
+    return [dict(e) for e in _log]
+
+
+def dropped():
+    """Return the number of entries evicted by the cap since the last
+    clear()."""
+    return _dropped
+
+
+def record(method, path, actor, max_entries):
+    """Append one entry, then enforce the cap (drop-oldest) immediately."""
+    global _dropped
+    _log.append({"method": method, "path": path, "actor": actor})
+    while len(_log) > max_entries:
+        _log.pop(0)
+        _dropped += 1
+
+
+def record_many(triples, max_entries):
+    """Append each (method, path, actor) triple in order, enforcing the
+    cap after every append. Returns the number appended (always
+    len(triples))."""
+    for method, path, actor in triples:
+        record(method, path, actor, max_entries)
+    return len(triples)
+
+
+def export_state():
+    """Return {"entries": entries(), "dropped": dropped()} — a copy safe
+    to mutate without affecting the live log."""
+    return {"entries": entries(), "dropped": dropped()}
+
+
+def import_state(state):
+    """Replace the log and the dropped counter from an export_state()
+    -shaped dict. Copies its input; later mutation of `state` does not
+    leak into the live log."""
+    global _log, _dropped
+    _log = [dict(e) for e in state["entries"]]
+    _dropped = state["dropped"]
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS callable: log every call. Actor defaults to
+    "anonymous" when kwargs has no "actor" key; only method/path/actor are
+    retained, never the other call kwargs."""
+    actor = kwargs.get("actor", "anonymous")
+    record(method, path, actor, config["audit_log_max_entries"])
diff --git a/app/audit_query.py b/app/audit_query.py
new file mode 100644
index 0000000..2ae8bb1
--- /dev/null
+++ b/app/audit_query.py
@@ -0,0 +1,256 @@
+"""Pure read-side query module over audit entry lists.
+
+Every function here takes `entries` as a plain list of `{"method",
+"path", "actor"}` dicts and never mutates it (or the dicts inside it) —
+this module imports nothing from `app.audit`; callers compose the two
+(see the audit log's own dispatch_hook + this module's filter_entries,
+for instance).
+"""
+
+FIELDS = ("method", "path", "actor")
+
+
+def _check_field(field):
+    if field not in FIELDS:
+        raise ValueError("unknown field: %s" % field)
+
+
+def filter_entries(entries, method=None, actor=None, path=None):
+    """Return a new list of the entries matching every given criterion
+    (criteria AND together); with no criteria, every entry is returned."""
+    result = entries
+    if method is not None:
+        result = [e for e in result if e["method"] == method]
+    if actor is not None:
+        result = [e for e in result if e["actor"] == actor]
+    if path is not None:
+        result = [e for e in result if e["path"] == path]
+    return list(result)
+
+
+def counts_by(entries, field):
+    """Return {value: count} over `field` ("method"/"path"/"actor")."""
+    _check_field(field)
+    counts = {}
+    for e in entries:
+        value = e[field]
+        counts[value] = counts.get(value, 0) + 1
+    return counts
+
+
+def counts_matrix(entries):
+    """Return the nested dict method -> actor -> count; only combinations
+    that occur appear (no zero-filled cells)."""
+    matrix = {}
+    for e in entries:
+        by_actor = matrix.setdefault(e["method"], {})
+        by_actor[e["actor"]] = by_actor.get(e["actor"], 0) + 1
+    return matrix
+
+
+def rollup(entries, fields):
+    """Generalized nested counts over `fields`, an ordered non-empty list
+    of distinct names drawn from FIELDS."""
+    if not fields:
+        raise ValueError("fields must be non-empty")
+    if len(fields) != len(set(fields)):
+        raise ValueError("fields must not contain duplicates")
+    for field in fields:
+        _check_field(field)
+
+    result = {}
+    for e in entries:
+        node = result
+        for field in fields[:-1]:
+            node = node.setdefault(e[field], {})
+        last_field = fields[-1]
+        node[e[last_field]] = node.get(e[last_field], 0) + 1
+    return result
+
+
+def last_n(entries, n):
+    """Return the final n entries in order (a copy); n=0 -> []; n larger
+    than the list returns the whole list (a copy); negative n raises
+    ValueError."""
+    if n < 0:
+        raise ValueError("n must not be negative")
+    if n == 0:
+        return []
+    return list(entries[-n:])
+
+
+def redact(entries, fields):
+    """Return new entry dicts with each field in `fields` replaced by
+    "***"; other keys untouched. `fields` outside FIELDS raises
+    ValueError."""
+    for field in fields:
+        _check_field(field)
+    result = []
+    for e in entries:
+        copy = dict(e)
+        for field in fields:
+            copy[field] = "***"
+        result.append(copy)
+    return result
+
+
+def summary(entries):
+    """Return {"total", "by_method", "by_actor", "first", "last"} over
+    entries; "first"/"last" are copies of the first/last entries (or None
+    for an empty list)."""
+    if not entries:
+        return {
+            "total": 0,
+            "by_method": {},
+            "by_actor": {},
+            "first": None,
+            "last": None,
+        }
+    return {
+        "total": len(entries),
+        "by_method": counts_by(entries, "method"),
+        "by_actor": counts_by(entries, "actor"),
+        "first": dict(entries[0]),
+        "last": dict(entries[-1]),
+    }
+
+
+def recent(entries, config):
+    """Return last_n(entries, config["audit_query_default_limit"])."""
+    return last_n(entries, config["audit_query_default_limit"])
+
+
+def paginate(entries, page, per_page):
+    """Return {"page", "pages", "total", "items"} — 1-based pages."""
+    if page < 1:
+        raise ValueError("page must be >= 1")
+    if per_page < 1:
+        raise ValueError("per_page must be >= 1")
+
+    total = len(entries)
+    pages = (total + per_page - 1) // per_page if total else 0
+    start = (page - 1) * per_page
+    items = list(entries[start:start + per_page])
+    return {"page": page, "pages": pages, "total": total, "items": items}
+
+
+def _report_lines(entries):
+    """Shared line-building for to_report/to_csv_report/to_markdown_report,
+    all sourced from counts_by (never a re-count)."""
+    by_method = counts_by(entries, "method")
+    by_actor = counts_by(entries, "actor")
+    return by_method, by_actor
+
+
+def to_report(entries):
+    """Render the plain-text audit report."""
+    by_method, by_actor = _report_lines(entries)
+    lines = ["audit report", "total: %d" % len(entries)]
+    if by_method:
+        lines.append("")
+        lines.append("by method:")
+        for method in sorted(by_method):
+            lines.append("  %s: %d" % (method, by_method[method]))
+    if by_actor:
+        lines.append("")
+        lines.append("by actor:")
+        for actor in sorted(by_actor):
+            lines.append("  %s: %d" % (actor, by_actor[actor]))
+    return "\n".join(lines)
+
+
+def to_csv_report(entries):
+    """Render the CSV audit report."""
+    by_method, by_actor = _report_lines(entries)
+    lines = ["field,value,count"]
+    for method in sorted(by_method):
+        lines.append("method,%s,%d" % (method, by_method[method]))
+    for actor in sorted(by_actor):
+        lines.append("actor,%s,%d" % (actor, by_actor[actor]))
+    return "\n".join(lines)
+
+
+def to_markdown_report(entries):
+    """Render the markdown-table audit report."""
+    by_method, by_actor = _report_lines(entries)
+    lines = ["| field | value | count |", "| --- | --- | --- |"]
+    for method in sorted(by_method):
+        lines.append("| method | %s | %d |" % (method, by_method[method]))
+    for actor in sorted(by_actor):
+        lines.append("| actor | %s | %d |" % (actor, by_actor[actor]))
+    return "\n".join(lines)
+
+
+def top_actors(entries, n):
+    """Return [(actor, count), ...] sorted by count descending, ties
+    broken by actor ascending, truncated to n."""
+    if n < 0:
+        raise ValueError("n must not be negative")
+    counts = counts_by(entries, "actor")
+    ranked = sorted(counts.items(), key=lambda pair: (-pair[1], pair[0]))
+    return ranked[:n]
+
+
+def merge_entries(*entry_lists):
+    """Return one new list concatenating the inputs in argument order;
+    entries are copies."""
+    result = []
+    for entry_list in entry_lists:
+        for e in entry_list:
+            result.append(dict(e))
+    return result
+
+
+def diff_summaries(a, b):
+    """Return {"total", "by_method", "by_actor"} of the deltas between two
+    summary(...) dicts; only values whose counts changed are included."""
+
+    def _diff(a_counts, b_counts):
+        changed = {}
+        for value in set(a_counts) | set(b_counts):
+            delta = b_counts.get(value, 0) - a_counts.get(value, 0)
+            if delta != 0:
+                changed[value] = delta
+        return changed
+
+    return {
+        "total": b["total"] - a["total"],
+        "by_method": _diff(a["by_method"], b["by_method"]),
+        "by_actor": _diff(a["by_actor"], b["by_actor"]),
+    }
+
+
+def format_entry(entry):
+    """Return "<METHOD> <path> (<actor>)"; missing key raises ValueError
+    naming it."""
+    for field in FIELDS:
+        if field not in entry:
+            raise ValueError("missing field: %s" % field)
+    return "%s %s (%s)" % (entry["method"], entry["path"], entry["actor"])
+
+
+def to_lines(entries):
+    """Return [format_entry(e) for e in entries]."""
+    return [format_entry(e) for e in entries]
+
+
+def group_by(entries, field):
+    """Return {value: [matching entry copies in original order]}."""
+    _check_field(field)
+    result = {}
+    for e in entries:
+        result.setdefault(e[field], []).append(dict(e))
+    return result
+
+
+def search(entries, needle):
+    """Return entry copies where `needle` is a substring of any of the
+    three field values, in original order. Empty needle raises
+    ValueError."""
+    if needle == "":
+        raise ValueError("needle must not be empty")
+    result = []
+    for e in entries:
+        if any(needle in e[field] for field in FIELDS):
+            result.append(dict(e))
+    return result
diff --git a/app/export.py b/app/export.py
new file mode 100644
index 0000000..8920da9
--- /dev/null
+++ b/app/export.py
@@ -0,0 +1,205 @@
+"""Machine-readable export formats built on top of `app.tabular`.
+
+Every serializer builds its column model and cell rendering through
+`tabular` so the key-union, escaping, and str() logic exist in exactly
+one place.
+"""
+import json
+
+from app import tabular
+
+
+def to_csv(records):
+    """CSV rendering: header row of the sorted column union, then one
+    row per record, missing fields as empty cells."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = [",".join(tabular.escape_csv(c) for c in cols)]
+    for r in records:
+        lines.append(",".join(tabular.escape_csv(r.get(c)) for c in cols))
+    return "\n".join(lines)
+
+
+def to_json(records):
+    """JSON array of the records, keys sorted."""
+    return json.dumps(records, sort_keys=True)
+
+
+def to_markdown(records, align="left"):
+    """Pipe-table rendering: header row, dash separator, one row per
+    record. `align` is "left" or "right" (delegated to tabular.pad via
+    tabular.fit/render_row for the ValueError)."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    col_widths = tabular.widths(records, cols)
+    widths_list = [col_widths[c] for c in cols]
+
+    header_cells = [tabular.pad(c, col_widths[c], align) for c in cols]
+    header_row = tabular.render_row(header_cells, widths_list, align)
+
+    if align == "right":
+        sep_cells = ["-" * (col_widths[c] - 1) + ":" for c in cols]
+    else:
+        sep_cells = ["-" * col_widths[c] for c in cols]
+    sep_row = "| " + " | ".join(sep_cells) + " |"
+
+    rows = [header_row, sep_row]
+    for r in records:
+        cells = [
+            tabular.pad(tabular.cell(r.get(c)), col_widths[c], align)
+            for c in cols
+        ]
+        rows.append(tabular.render_row(cells, widths_list, align))
+    return "\n".join(rows)
+
+
+def to_ndjson(records):
+    """One JSON object per line, sort_keys=True, no trailing newline."""
+    if not records:
+        return ""
+    return "\n".join(json.dumps(r, sort_keys=True) for r in records)
+
+
+def to_tsv(records):
+    """Tab-separated rendering: sorted-column header then one row per
+    record, every cell and header passed through tabular.sanitize_flat."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = ["\t".join(tabular.sanitize_flat(c) for c in cols)]
+    for r in records:
+        lines.append(
+            "\t".join(tabular.sanitize_flat(r.get(c)) for c in cols)
+        )
+    return "\n".join(lines)
+
+
+def to_html(records):
+    """<table> rendering: header row, one row per record, every cell and
+    header passed through tabular.escape_html. Not in FORMATS/registry."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = ["<table>"]
+    header = "".join(
+        "<th>%s</th>" % tabular.escape_html(c) for c in cols
+    )
+    lines.append("<tr>%s</tr>" % header)
+    for r in records:
+        cells = "".join(
+            "<td>%s</td>" % tabular.escape_html(r.get(c)) for c in cols
+        )
+        lines.append("<tr>%s</tr>" % cells)
+    lines.append("</table>")
+    return "\n".join(lines)
+
+
+def parse_csv(text):
+    """Inverse of to_csv: parses a CSV string into a list of dicts of
+    header -> cell string (values are never re-typed). Handles quoted
+    cells (with doubled inner quotes and embedded newlines). Raises
+    ValueError on an unterminated quote."""
+    if text == "":
+        return []
+
+    rows = _parse_csv_rows(text)
+    if not rows:
+        return []
+    header = rows[0]
+    return [dict(zip(header, row)) for row in rows[1:]]
+
+
+def _parse_csv_rows(text):
+    """Split `text` into rows of raw field strings, honoring quoted cells
+    (doubled quotes, embedded commas/newlines). Every unquoted newline
+    ends a row and starts a new one — including a trailing newline,
+    which yields a final empty row (the caller special-cases "" so this
+    is never invoked on an empty string)."""
+    rows = []
+    row = []
+    field = []
+    i = 0
+    n = len(text)
+    in_quotes = False
+
+    while i < n:
+        ch = text[i]
+        if in_quotes:
+            if ch == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                    continue
+                in_quotes = False
+                i += 1
+                continue
+            field.append(ch)
+            i += 1
+            continue
+
+        if ch == '"' and not field:
+            in_quotes = True
+            i += 1
+            continue
+        if ch == ",":
+            row.append("".join(field))
+            field = []
+            i += 1
+            continue
+        if ch == "\n":
+            row.append("".join(field))
+            rows.append(row)
+            row = []
+            field = []
+            i += 1
+            continue
+        field.append(ch)
+        i += 1
+
+    if in_quotes:
+        raise ValueError("unterminated quote in CSV")
+
+    row.append("".join(field))
+    rows.append(row)
+
+    return rows
+
+
+FORMATS = {
+    "csv": to_csv,
+    "json": to_json,
+    "md": to_markdown,
+    "ndjson": to_ndjson,
+    "tsv": to_tsv,
+}
+
+EXTRA_FORMATS = {
+    "html": to_html,
+}
+
+
+def render(records, fmt):
+    """Delegate to the matching FORMATS function. Raises ValueError
+    naming an unknown fmt."""
+    if fmt not in FORMATS:
+        raise ValueError("unknown export format: %s" % fmt)
+    return FORMATS[fmt](records)
+
+
+def render_any(records, fmt):
+    """Serve FORMATS first, then EXTRA_FORMATS. Raises ValueError naming
+    an unknown fmt."""
+    if fmt in FORMATS:
+        return FORMATS[fmt](records)
+    if fmt in EXTRA_FORMATS:
+        return EXTRA_FORMATS[fmt](records)
+    raise ValueError("unknown export format: %s" % fmt)
+
+
+def summary_line(records):
+    """"<N> records, <M> columns" summary."""
+    return "%d records, %d columns" % (
+        len(records), len(tabular.columns(records))
+    )
diff --git a/app/quota.py b/app/quota.py
new file mode 100644
index 0000000..c9dc2f2
--- /dev/null
+++ b/app/quota.py
@@ -0,0 +1,130 @@
+"""Windowed hit counter over a module-global logical clock.
+
+No wall time anywhere: the clock is a plain float (seconds) that only
+moves when a caller calls `advance()`. This keeps tests fully
+deterministic. `app/ratelimit.py` delegates to this module for all actual
+counting; it keeps no counter state of its own.
+"""
+
+
+class QuotaExceededError(Exception):
+    pass
+
+
+_clock = 0.0
+_hits = {}
+
+
+def reset():
+    """Clear the clock back to 0.0 and every key's recorded hits."""
+    global _clock, _hits
+    _clock = 0.0
+    _hits = {}
+
+
+def now():
+    """Return the current logical clock value."""
+    return _clock
+
+
+def advance(delta):
+    """Advance the logical clock by `delta` seconds and return the new
+    value. Raises ValueError (leaving the clock unchanged) if `delta` is
+    negative -- the clock is monotonic."""
+    global _clock
+    if delta < 0:
+        raise ValueError("clock is monotonic: cannot advance by a negative amount")
+    _clock += delta
+    return _clock
+
+
+def _prune(key, window_seconds):
+    """Drop hits for `key` strictly older than now - window_seconds, in
+    place. No-op for an infinite window."""
+    if window_seconds == float("inf"):
+        return
+    cutoff = _clock - window_seconds
+    hits = _hits.get(key)
+    if hits is None:
+        return
+    _hits[key] = [t for t in hits if t >= cutoff]
+
+
+def _in_window_hits(key, window_seconds):
+    _prune(key, window_seconds)
+    return _hits.get(key, [])
+
+
+def take(key, limit, window_seconds, burst=0):
+    """Record a hit for `key` if the in-window count (after recording) does
+    not exceed limit + burst. Returns the in-window hit count after
+    recording. Raises QuotaExceededError (without recording) once the
+    allowance is exhausted."""
+    hits = _in_window_hits(key, window_seconds)
+    if len(hits) >= limit + burst:
+        raise QuotaExceededError(
+            "quota exceeded for %r: limit=%s" % (key, limit)
+        )
+    hits.append(_clock)
+    _hits[key] = hits
+    return len(hits)
+
+
+def remaining(key, limit, window_seconds, burst=0):
+    """Read-only: how many more `take` calls would currently succeed."""
+    hits = _in_window_hits(key, window_seconds)
+    return max(0, limit + burst - len(hits))
+
+
+def snapshot(window_seconds):
+    """Return a dict mapping each key with at least one in-window hit to
+    the sorted list of its in-window hit timestamps. A deep copy: mutating
+    a returned list never affects later readings."""
+    result = {}
+    for key in list(_hits.keys()):
+        hits = _in_window_hits(key, window_seconds)
+        if hits:
+            result[key] = sorted(hits)
+    return result
+
+
+def time_to_next_slot(key, limit, window_seconds, burst=0):
+    """Read-only: seconds until the oldest in-window hit ages out and frees
+    a slot. 0.0 if a slot is available now. float("inf") if the window is
+    infinite (nothing ever ages out) or the allowance is zero (no hit can
+    ever free a slot)."""
+    if remaining(key, limit, window_seconds, burst) > 0:
+        return 0.0
+    if window_seconds == float("inf"):
+        return float("inf")
+    if limit + burst == 0:
+        return float("inf")
+    hits = _in_window_hits(key, window_seconds)
+    if not hits:
+        return float("inf")
+    return min(hits) + window_seconds - _clock
+
+
+def usage(key, limit, window_seconds, burst=0):
+    """Read-only snapshot of a key's current usage against a policy."""
+    hits = _in_window_hits(key, window_seconds)
+    return {
+        "used": len(hits),
+        "allowed": limit + burst,
+        "remaining": remaining(key, limit, window_seconds, burst),
+        "reset_in": time_to_next_slot(key, limit, window_seconds, burst),
+    }
+
+
+def purge(window_seconds):
+    """Drop every key's aged-out hits, removing keys left with none.
+    Returns the total number of hits dropped."""
+    dropped = 0
+    for key in list(_hits.keys()):
+        before = len(_hits.get(key, []))
+        _prune(key, window_seconds)
+        after = len(_hits.get(key, []))
+        dropped += before - after
+        if not _hits.get(key):
+            _hits.pop(key, None)
+    return dropped
diff --git a/app/ratelimit.py b/app/ratelimit.py
new file mode 100644
index 0000000..e7ba461
--- /dev/null
+++ b/app/ratelimit.py
@@ -0,0 +1,102 @@
+"""Per-actor rate limiting on top of app/quota.py.
+
+`check_and_increment` is a thin per-key call counter (no window: it uses an
+infinite window, since it exists for callers that just want a hard cap on
+total calls). `dispatch_hook` is the DISPATCH_HOOKS-shaped hook the
+registry wires in: it rate-limits POST /records per actor over a rolling
+window, and is a no-op for every other method (rate limiting applies to
+writes, not reads).
+
+All counting lives in `app/quota.py`'s module-global hits store --
+`ratelimit` keeps no counter state of its own; `reset()` here just
+delegates to `quota.reset()`.
+"""
+from app import quota
+from app.quota import QuotaExceededError
+
+
+class RateLimitExceededError(QuotaExceededError):
+    pass
+
+
+def reset():
+    """Reset all rate-limit counters (and the underlying logical clock)."""
+    quota.reset()
+
+
+def check_and_increment(key, limit, window_seconds=float("inf")):
+    """Record a call for `key` against a hard cap of `limit` calls (no
+    window by default). Returns the running count. Raises
+    RateLimitExceededError once exhausted."""
+    try:
+        return quota.take(key, limit, window_seconds, burst=0)
+    except QuotaExceededError as exc:
+        raise RateLimitExceededError(
+            "rate limit exceeded for %r: limit=%s" % (key, limit)
+        ) from exc
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS entry point: rate-limits POST calls per actor over a
+    rolling window. A no-op for any other method. Only
+    `rate_limit_max_per_window` is a required config key; window and burst
+    always default via `.get`."""
+    if method != "POST":
+        return
+    actor = kwargs.get("actor", "anonymous")
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    try:
+        quota.take(actor, limit, window_seconds, burst=burst)
+    except QuotaExceededError as exc:
+        raise RateLimitExceededError(
+            "rate limit exceeded for %r: limit=%s" % (actor, limit)
+        ) from exc
+
+
+def _policy_params(config):
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    return limit, window_seconds, burst
+
+
+def retry_after(key, config):
+    """Seconds until `key`'s next slot frees, per the config's policy."""
+    limit, window_seconds, burst = _policy_params(config)
+    return quota.time_to_next_slot(key, limit, window_seconds, burst)
+
+
+def limit_headers(key, config):
+    """X-RateLimit-* headers for `key` under the config's policy. Records
+    no hit. `Limit` is the configured limit alone; burst is reflected only
+    in `Remaining`'s full allowance."""
+    limit, window_seconds, burst = _policy_params(config)
+    return {
+        "X-RateLimit-Limit": str(limit),
+        "X-RateLimit-Remaining": str(quota.remaining(key, limit, window_seconds, burst)),
+        "X-RateLimit-Reset": str(quota.time_to_next_slot(key, limit, window_seconds, burst)),
+    }
+
+
+def status_line(key, config):
+    """A one-line human-readable usage summary for `key`. Read-only."""
+    limit, window_seconds, burst = _policy_params(config)
+    usage = quota.usage(key, limit, window_seconds, burst)
+    return "%s: %s/%s, reset in %ss" % (
+        key,
+        usage["used"],
+        usage["allowed"],
+        usage["reset_in"],
+    )
+
+
+def check_many(keys, config):
+    """Read-only: for each key in `keys`, would a POST for it succeed right
+    now? Records no hits."""
+    limit, window_seconds, burst = _policy_params(config)
+    return {
+        key: quota.remaining(key, limit, window_seconds, burst) > 0
+        for key in keys
+    }
