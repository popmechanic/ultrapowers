+from app.schema import (
+    ERROR_CATALOG,
+    SchemaError,
+    check_required,
+    compile_spec,
+    describe_spec,
+    diff_specs,
+    format_error,
+    is_non_empty_str,
+    is_valid_amount,
+    merge_specs,
+    spec_from_config,
+    spec_summary_line,
+    spec_to_config,
+    validate_collect,
+)
+
+
+def test_error_catalog_has_exactly_the_expected_keys():
+    assert set(ERROR_CATALOG.keys()) == {
+        "missing",
+        "numeric",
+        "non_negative",
+        "max",
+        "non_empty",
+        "type_str",
+    }
+    for template in ERROR_CATALOG.values():
+        assert isinstance(template, str)
+
+
+def test_format_error_missing():
+    assert format_error("missing", field="name") == "missing field: name"
+
+
+def test_format_error_numeric():
+    assert (
+        format_error("numeric", field="amount", got="str")
+        == "field amount must be numeric (got str)"
+    )
+
+
+def test_format_error_non_negative():
+    assert (
+        format_error("non_negative", field="amount")
+        == "field amount must be non-negative"
+    )
+
+
+def test_format_error_max():
+    assert (
+        format_error("max", field="amount", limit=100)
+        == "field amount exceeds max_amount 100"
+    )
+
+
+def test_format_error_non_empty():
+    assert (
+        format_error("non_empty", field="name")
+        == "field name must be a non-empty string"
+    )
+
+
+def test_format_error_type_str():
+    assert format_error("type_str", field="name") == "field name must be a string"
+
+
+def test_format_error_unknown_code_raises_key_error():
+    with pytest.raises(KeyError):
+        format_error("nope")
+
+
+def test_check_required_partial_and_full_and_none_missing():
+    assert check_required({"amount": 1}, ["name", "amount"]) == ["name"]
+    assert check_required({}, ["name", "amount"]) == ["name", "amount"]
