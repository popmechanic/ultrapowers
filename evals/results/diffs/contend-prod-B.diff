@@ -0,0 +1,89 @@
+"""Per-actor rate limiting, built on top of `app/quota.py`'s windowed
+counter. Keeps no counter state of its own -- all counting lives in
+`quota.take`.
+"""
+from app import quota
+
+
+class RateLimitExceededError(quota.QuotaExceededError):
+    pass
+
+
+def reset():
+    """Reset all rate-limit counters (delegates to quota.reset(), which
+    also resets the logical clock)."""
+    quota.reset()
+
+
+def check_and_increment(key, limit, window_seconds=float("inf")):
+    """Record a hit for `key` against `limit` over `window_seconds`.
+    Returns the new in-window count, or raises RateLimitExceededError
+    (the subclass of quota.QuotaExceededError) once the limit is
+    exhausted."""
+    try:
+        return quota.take(key, limit, window_seconds, burst=0)
+    except quota.QuotaExceededError as exc:
+        raise RateLimitExceededError(str(exc)) from exc
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS-shaped hook: rate limits POST /records (writes) per
+    actor. GET (and any other method) is a no-op -- never raises, never
+    increments."""
+    if method != "POST":
+        return
+    actor = kwargs.get("actor", "anonymous")
+    key = actor
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    try:
+        quota.take(key, limit, window_seconds, burst=burst)
+    except quota.QuotaExceededError as exc:
+        raise RateLimitExceededError(str(exc)) from exc
+
+
+def retry_after(key, config):
+    """Seconds until `key`'s next slot frees, per `config`. Read-only."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config["rate_limit_window_seconds"]
+    burst = config.get("rate_limit_burst", 0)
+    return quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
+
+
+def limit_headers(key, config):
+    """Return rate-limit response headers for `key`, all values as
+    strings. Read-only (records no hit)."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    remaining = quota.remaining(key, limit, window_seconds, burst=burst)
+    reset_in = quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
+    return {
+        "X-RateLimit-Limit": str(limit),
+        "X-RateLimit-Remaining": str(remaining),
+        "X-RateLimit-Reset": str(reset_in),
+    }
+
+
+def status_line(key, config):
+    """A human-readable one-line status string for `key`. Read-only."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    info = quota.usage(key, limit, window_seconds, burst=burst)
+    return "%s: %s/%s, reset in %ss" % (
+        key, info["used"], info["allowed"], info["reset_in"],
+    )
+
+
+def check_many(keys, config):
+    """Return {key: would-a-POST-succeed-right-now} for every key in
+    `keys`. Read-only (records no hit)."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    return {
+        key: quota.remaining(key, limit, window_seconds, burst=burst) > 0
+        for key in keys
+    }
