+def test_error_code_maps_every_catalog_message_back_to_its_code():
+    assert validation.error_code("missing field: name") == "missing"
+    assert validation.error_code(
+        "field amount must be numeric (got str)") == "numeric"
+    assert validation.error_code(
+        "field amount must be non-negative") == "non_negative"
+    assert validation.error_code(
+        "field amount exceeds max_amount 100") == "max"
+    assert validation.error_code(
+        "field name must be a non-empty string") == "non_empty"
+    assert validation.error_code("field name must be a string") == "type_str"
+    with pytest.raises(ValueError):
+        validation.error_code("something else entirely")
+
+
+def test_error_code_reads_the_catalog_at_call_time(monkeypatch):
+    monkeypatch.setitem(schema.ERROR_CATALOG, "missing", "no such field: {field}")
+    assert validation.error_code("no such field: name") == "missing"
+    with pytest.raises(ValueError):
+        validation.error_code("missing field: name")
