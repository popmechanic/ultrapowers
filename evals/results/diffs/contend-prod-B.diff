+
+def test_compile_spec_empty_spec_accepts_any_dict_unchanged():
+    validator = compile_spec({})
+    fields = {"anything": 1, "goes": "here"}
+    assert validator(fields) == fields
+
+
+def test_compiled_validator_checks_required_fields_first_in_spec_order():
+    spec = {"name": {"required": True}, "amount": {"required": True}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError) as exc_info:
+        validator({})
+    assert str(exc_info.value) == format_error("missing", field="name")
+
+
+def test_compiled_validator_reports_second_required_field_missing():
+    spec = {"name": {"required": True}, "amount": {"required": True}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError) as exc_info:
+        validator({"name": "a"})
+    assert str(exc_info.value) == format_error("missing", field="amount")
+
+
+def test_compiled_validator_type_number_rejects_non_amount():
+    spec = {"amount": {"type": "number"}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError) as exc_info:
+        validator({"amount": "3"})
+    assert str(exc_info.value) == format_error(
+        "numeric", field="amount", got="str"
+    )
+
+
+def test_compiled_validator_type_number_rejects_bool_and_nan():
+    spec = {"amount": {"type": "number"}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError):
+        validator({"amount": True})
+    with pytest.raises(SchemaError):
+        validator({"amount": float("nan")})
+
+
+def test_compiled_validator_type_str_rejects_non_str():
+    spec = {"name": {"type": "str"}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError) as exc_info:
+        validator({"name": 42})
+    assert str(exc_info.value) == format_error("type_str", field="name")
+
+
+def test_compiled_validator_type_wins_over_non_empty_for_wrong_type():
+    spec = {"name": {"type": "str", "non_empty": True}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError) as exc_info:
+        validator({"name": 42})
+    assert str(exc_info.value) == format_error("type_str", field="name")
+
+
+def test_compiled_validator_non_empty_rejects_blank_string():
+    spec = {"name": {"non_empty": True}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError) as exc_info:
+        validator({"name": "   "})
+    assert str(exc_info.value) == format_error("non_empty", field="name")
+
+
+def test_compiled_validator_max_boundary_equal_passes_and_over_fails():
+    spec = {"amount": {"max": 100}}
+    validator = compile_spec(spec)
+    assert validator({"amount": 100}) == {"amount": 100}
+    with pytest.raises(SchemaError) as exc_info:
+        validator({"amount": 101})
+    assert str(exc_info.value) == format_error("max", field="amount", limit=100)
+
+
+def test_compiled_validator_max_on_non_comparable_value_raises_numeric():
+    spec = {"amount": {"max": 100}}
+    validator = compile_spec(spec)
+    with pytest.raises(SchemaError) as exc_info:
+        validator({"amount": "abc"})
+    assert str(exc_info.value) == format_error(
+        "numeric", field="amount", got="str"
+    )
+
+
+def test_validate_collect_max_on_non_comparable_value_yields_numeric():
+    spec = {"amount": {"max": 100}}
+    assert validate_collect(spec, {"amount": "abc"}) == [
+        format_error("numeric", field="amount", got="str")
+    ]
+
+
+def test_compiled_validator_strips_non_empty_fields_returns_new_dict():
+    spec = {"name": {"non_empty": True}, "other": {}}
+    validator = compile_spec(spec)
+    fields = {"name": "  ada  ", "other": "unchanged"}
+    result = validator(fields)
+    assert result == {"name": "ada", "other": "unchanged"}
+    assert fields == {"name": "  ada  ", "other": "unchanged"}
+    assert result is not fields
+
+
+def test_compiled_validator_is_reusable_and_deterministic():
+    spec = {"name": {"non_empty": True}}
+    validator = compile_spec(spec)
+    a = validator({"name": " x "})
+    b = validator({"name": " x "})
+    assert a == b
+
+
+def test_compiled_validator_passes_through_fields_not_in_spec():
+    spec = {"name": {"required": True}}
+    validator = compile_spec(spec)
+    result = validator({"name": "a", "extra": 123})
+    assert result == {"name": "a", "extra": 123}
+
+
+def test_merge_specs_union_and_merge():
+    a = {"name": {"required": True}}
+    b = {"name": {"non_empty": True}, "amount": {"type": "number"}}
+    merged = merge_specs(a, b)
+    assert merged == {
+        "name": {"required": True, "non_empty": True},
+        "amount": {"type": "number"},
+    }
+    assert a == {"name": {"required": True}}
+    assert b == {"name": {"non_empty": True}, "amount": {"type": "number"}}
+
+
+def test_merge_specs_conflicting_value_raises_value_error():
+    a = {"amount": {"max": 100}}
+    b = {"amount": {"max": 200}}
+    with pytest.raises(ValueError, match="amount"):
+        merge_specs(a, b)
+
+
+def test_merge_specs_equal_values_merge_silently():
+    a = {"amount": {"max": 100}}
+    b = {"amount": {"max": 100}}
+    assert merge_specs(a, b) == {"amount": {"max": 100}}
+
+
+def test_describe_spec_two_field_spec_literal():
+    spec = {
+        "amount": {"max": 100, "type": "number"},
+        "name": {"required": True},
+    }
+    assert describe_spec(spec) == (
+        "amount: max=100, type=number\n"
+        "name: required=True"
+    )
+
+
+def test_describe_spec_empty():
+    assert describe_spec({}) == "(empty spec)"
+
+
+def test_diff_specs_all_three_buckets():
+    a = {
+        "removed_field": {"required": True},
+        "changed_field": {"max": 100},
+        "same_field": {"required": True},
+    }
+    b = {
+        "added_field": {"required": True},
+        "changed_field": {"max": 200},
+        "same_field": {"required": True},
+    }
+    assert diff_specs(a, b) == {
+        "added": ["added_field"],
+        "removed": ["removed_field"],
+        "changed": ["changed_field"],
+    }
+    assert a == {
+        "removed_field": {"required": True},
+        "changed_field": {"max": 100},
+        "same_field": {"required": True},
+    }
+    assert b == {
+        "added_field": {"required": True},
+        "changed_field": {"max": 200},
+        "same_field": {"required": True},
+    }
+
+
+def test_diff_specs_identical_specs_yield_empty_lists():
+    spec = {"name": {"required": True}}
+    assert diff_specs(spec, spec) == {"added": [], "removed": [], "changed": []}
+
+
+def test_spec_from_config_and_compile_end_to_end():
+    config = {
+        "app_name": "eventboard",
+        "v_name": {"required": True, "non_empty": True},
+        "v_amount": {"type": "number"},
+    }
+    spec = spec_from_config(config, "v_")
+    assert spec == {
+        "name": {"required": True, "non_empty": True},
+        "amount": {"type": "number"},
+    }
+    validator = compile_spec(spec)
+    assert validator({"name": "ok", "amount": 5}) == {"name": "ok", "amount": 5}
+    with pytest.raises(SchemaError):
+        validator({"amount": "not a number"})
+
+
+def test_spec_to_config_exact_dict_and_no_shared_mutation():
+    spec = {"name": {"required": True}, "amount": {"type": "number"}}
+    config = spec_to_config(spec, "s_")
+    assert config == {
+        "s_name": {"required": True},
+        "s_amount": {"type": "number"},
+    }
+    config["s_name"]["required"] = False
+    assert spec["name"]["required"] is True
+
+
+def test_spec_config_round_trip_both_directions():
+    spec = {"name": {"required": True}, "amount": {"type": "number", "max": 50}}
+    config = spec_to_config(spec, "s_")
+    assert spec_from_config(config, "s_") == spec
+
+    original_config = {"s_name": {"required": True}, "s_amount": {"max": 50}}
+    round_tripped = spec_to_config(spec_from_config(original_config, "s_"), "s_")
+    assert round_tripped == original_config
+
+
+def test_spec_summary_line():
+    spec = {"name": {"required": True}, "amount": {"type": "number", "max": 50}}
+    assert spec_summary_line(spec) == "2 fields, 3 rules"
+
+
+def test_spec_summary_line_empty():
+    assert spec_summary_line({}) == "0 fields, 0 rules"
+
+
+def test_validate_collect_combined_fixture_exact_list():
+    spec = {
+        "name": {"required": True, "non_empty": True},
+        "amount": {"required": True, "type": "number"},
+        "label": {"type": "str"},
+    }
+    # "name" is missing (required-miss); "amount" and "label" are present
+    # but each violate one rule.
+    fields = {"amount": "notanumber", "label": 42}
+    assert validate_collect(spec, fields) == [
+        format_error("missing", field="name"),
+        format_error("numeric", field="amount", got="str"),
+        format_error("type_str", field="label"),
+    ]
+
+
+def test_validate_collect_returns_one_message_per_field_first_rule_only():
+    spec = {"n": {"type": "str", "non_empty": True}}
+    assert validate_collect(spec, {"n": 42}) == ["field n must be a string"]
+
+
+def test_validate_collect_clean_returns_empty_list():
+    spec = {"name": {"required": True}}
+    assert validate_collect(spec, {"name": "ok"}) == []
