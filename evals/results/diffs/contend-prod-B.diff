@@ -0,0 +1,225 @@
+"""Failing-first tests for app/rules.py, a pure rule-combinator layer on
+top of app/schema.py's predicates."""
+import pytest
+
+from app import schema
+from app.rules import (
+    BUILTINS,
+    RuleError,
+    all_of,
+    any_of,
+    apply_rules,
+    check,
+    describe_rules,
+    explain,
+    explain_failures,
+    first_failure,
+    negate,
+    parse_rule,
+    parse_rules,
+    rule,
+    when,
+)
+
+
+def test_rule_error_is_exception_subclass_distinct_from_schema_error():
+    assert issubclass(RuleError, Exception)
+    assert not issubclass(RuleError, schema.SchemaError)
+    assert not issubclass(schema.SchemaError, RuleError)
+
+
+def test_rule_builds_dict_and_rejects_bad_name():
+    r = rule("positive", lambda v: v > 0)
+    assert r == {"name": "positive", "test": r["test"]}
+    assert r["name"] == "positive"
+    with pytest.raises(ValueError):
+        rule("", lambda v: True)
+    with pytest.raises(ValueError):
+        rule(None, lambda v: True)
+
+
+def test_check_runs_predicate_and_coerces_to_bool():
+    r = rule("truthy", lambda v: v)
+    assert check(1, r) is True
+    assert check(0, r) is False
+
+
+def test_all_of_passes_iff_every_child_passes_and_names_composite():
+    positive = rule("positive", lambda v: v > 0)
+    even = rule("even", lambda v: v % 2 == 0)
+    both = all_of(positive, even)
+    assert both["name"] == "all(positive,even)"
+    assert check(4, both) is True
+    assert check(3, both) is False
+    assert check(-4, both) is False
+
+
+def test_all_of_no_children_passes_everything():
+    empty_all = all_of()
+    assert empty_all["name"] == "all()"
+    assert check(object(), empty_all) is True
+    assert check(None, empty_all) is True
+
+
+def test_any_of_passes_if_at_least_one_child_passes_and_names_composite():
+    positive = rule("positive", lambda v: v > 0)
+    even = rule("even", lambda v: v % 2 == 0)
+    either = any_of(positive, even)
+    assert either["name"] == "any(positive,even)"
+    assert check(-4, either) is True
+    assert check(3, either) is True
+    assert check(-3, either) is False
+
+
+def test_any_of_no_children_raises_value_error():
+    with pytest.raises(ValueError):
+        any_of()
+
+
+def test_negate_inverts_and_names():
+    positive = rule("positive", lambda v: v > 0)
+    not_positive = negate(positive)
+    assert not_positive["name"] == "not(positive)"
+    assert check(5, not_positive) is False
+    assert check(-5, not_positive) is True
+
+
+def test_when_material_implication_truth_table():
+    cond = rule("cond", lambda v: v["cond"])
+    then = rule("then", lambda v: v["then"])
+    implication = when(cond, then)
+    assert implication["name"] == "when(cond,then)"
+    assert check({"cond": True, "then": True}, implication) is True
+    assert check({"cond": True, "then": False}, implication) is False
+    assert check({"cond": False, "then": True}, implication) is True
+    assert check({"cond": False, "then": False}, implication) is True
+
+
+def test_explain_pass_and_fail():
+    positive = rule("positive", lambda v: v > 0)
+    assert explain(5, positive) == "positive: pass"
+    assert explain(-5, positive) == "positive: fail"
+
+
+def test_apply_rules_insertion_order_and_no_mutation():
+    positive = rule("positive", lambda v: v > 0)
+    non_empty_rule = rule("non_empty", lambda v: bool(v))
+    fields = {"amount": -1, "name": ""}
+    rules_by_field = {"amount": positive, "name": non_empty_rule}
+    errors = apply_rules(fields, rules_by_field)
+    assert errors == [
+        "field amount failed positive",
+        "field name failed non_empty",
+    ]
+    assert fields == {"amount": -1, "name": ""}
+
+
+def test_apply_rules_skips_absent_fields_and_empty_when_all_pass():
+    positive = rule("positive", lambda v: v > 0)
+    assert apply_rules({}, {"amount": positive}) == []
+    assert apply_rules({"amount": 5}, {"amount": positive}) == []
+
+
+def test_first_failure_returns_first_in_insertion_order_or_none():
+    positive = rule("positive", lambda v: v > 0)
+    even = rule("even", lambda v: v % 2 == 0)
+    fields = {"a": -1, "b": 3}
+    rules_by_field = {"a": positive, "b": even}
+    assert first_failure(fields, rules_by_field) == ("a", "positive")
+    assert first_failure({"a": 1, "b": 2}, rules_by_field) is None
+
+
+def test_explain_failures_only_failing_fields_in_order():
+    positive = rule("positive", lambda v: v > 0)
+    even = rule("even", lambda v: v % 2 == 0)
+    non_empty_rule = rule("non_empty", lambda v: bool(v))
+    fields = {"a": 5, "b": 3, "c": ""}
+    rules_by_field = {"a": positive, "b": even, "c": non_empty_rule}
+    assert explain_failures(fields, rules_by_field) == [
+        "even: fail",
+        "non_empty: fail",
+    ]
+
+
+def test_explain_failures_empty_when_everything_passes():
+    positive = rule("positive", lambda v: v > 0)
+    assert explain_failures({"a": 1}, {"a": positive}) == []
+
+
+def test_builtins_has_exactly_the_expected_keys_and_behavior():
+    assert set(BUILTINS.keys()) == {"number", "str", "non_empty"}
+    assert check(5, BUILTINS["number"]) is True
+    assert check("5", BUILTINS["number"]) is False
+    assert check(True, BUILTINS["number"]) is False
+    assert check("a", BUILTINS["str"]) is True
+    assert check(5, BUILTINS["str"]) is False
+    assert check("a", BUILTINS["non_empty"]) is True
+    assert check("   ", BUILTINS["non_empty"]) is False
+
+
+def test_parse_rule_single_builtin():
+    r = parse_rule("number")
+    assert r is BUILTINS["number"]
+
+
+def test_parse_rule_composite_in_text_order():
+    r = parse_rule("str&non_empty")
+    assert r["name"] == "all(str,non_empty)"
+    assert check("a", r) is True
+    assert check("", r) is False
+    assert check(5, r) is False
+
+
+def test_parse_rule_unknown_token_raises_naming_token():
+    with pytest.raises(ValueError, match="bogus"):
+        parse_rule("bogus")
+
+
+def test_parse_rule_empty_text_raises_value_error():
+    with pytest.raises(ValueError):
+        parse_rule("")
+
+
+def test_parse_rules_maps_field_to_parsed_rule_in_order():
+    rules_by_field = parse_rules({"name": "str&non_empty", "amount": "number"})
+    assert list(rules_by_field.keys()) == ["name", "amount"]
+    assert rules_by_field["name"]["name"] == "all(str,non_empty)"
+    assert rules_by_field["amount"] is BUILTINS["number"]
+
+
+def test_parse_rules_unknown_token_names_field_and_token():
+    with pytest.raises(ValueError) as exc_info:
+        parse_rules({"amount": "bogus"})
+    message = str(exc_info.value)
+    assert "amount" in message
+    assert "bogus" in message
+
+
+def test_parse_rules_empty_returns_empty_dict():
+    assert parse_rules({}) == {}
+
+
+def test_parse_rules_compose_end_to_end_exact_failure_list():
+    rules_by_field = parse_rules({"name": "str&non_empty", "amount": "number"})
+    fields = {"name": "   ", "amount": 5}
+    assert apply_rules(fields, rules_by_field) == [
+        "field name failed all(str,non_empty)"
+    ]
+
+
+def test_describe_rules_two_field_literal():
+    rules_by_field = parse_rules({"amount": "number", "name": "str&non_empty"})
+    assert describe_rules(rules_by_field) == (
+        "amount: number\n"
+        "name: all(str,non_empty)"
+    )
+
+
+def test_describe_rules_empty():
+    assert describe_rules({}) == "(no rules)"
+
+
+def test_delegation_to_schema_is_real_not_a_private_copy(monkeypatch):
+    monkeypatch.setattr(schema, "is_valid_amount", lambda v: False)
+    fresh_number_rule = parse_rule("number")
+    assert check(5, fresh_number_rule) is False
