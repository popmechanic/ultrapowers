@@ -0,0 +1,261 @@
+"""Tests for the per-actor rate-limit guard (`app.ratelimit`).
+
+`ratelimit` keeps no counters of its own: every count lives in `app.quota`,
+which is module-global state, so every test starts with `ratelimit.reset()`.
+"""
+import pytest
+
+from app import quota, ratelimit
+
+
+def test_rate_limit_exceeded_error_is_an_exception_subclass():
+    assert issubclass(ratelimit.RateLimitExceededError, Exception)
+
+
+def test_check_and_increment_counts_then_raises_at_the_limit():
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("k", 3) == 1
+    assert ratelimit.check_and_increment("k", 3) == 2
+    assert ratelimit.check_and_increment("k", 3) == 3
+    with pytest.raises(ratelimit.RateLimitExceededError) as excinfo:
+        ratelimit.check_and_increment("k", 3)
+    message = str(excinfo.value)
+    assert "k" in message
+    assert "3" in message
+
+
+def test_check_and_increment_counts_per_key():
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("a", 2) == 1
+    assert ratelimit.check_and_increment("b", 2) == 1
+    assert ratelimit.check_and_increment("a", 2) == 2
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("a", 2)
+    assert ratelimit.check_and_increment("b", 2) == 2
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("b", 2)
+
+
+def test_reset_clears_every_key_not_just_one():
+    ratelimit.reset()
+    ratelimit.check_and_increment("a", 1)
+    ratelimit.check_and_increment("b", 1)
+
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("a", 1) == 1
+    assert ratelimit.check_and_increment("b", 1) == 1
+
+
+def test_reset_also_resets_the_quota_clock():
+    ratelimit.reset()
+    ratelimit.check_and_increment("k", 1, 60)
+    quota.advance(120)
+    assert quota.now() == 120.0
+
+    ratelimit.reset()
+    assert quota.now() == 0.0
+    assert ratelimit.check_and_increment("k", 1, 60) == 1
+
+
+def test_rate_limit_error_subclasses_the_quota_error():
+    ratelimit.reset()
+    assert issubclass(ratelimit.RateLimitExceededError, quota.QuotaExceededError)
+
+    ratelimit.check_and_increment("k", 1)
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("k", 1)
+
+    ratelimit.reset()
+    ratelimit.check_and_increment("k", 1)
+    with pytest.raises(quota.QuotaExceededError):
+        ratelimit.check_and_increment("k", 1)
+
+
+def test_check_and_increment_delegates_to_quota_take(monkeypatch):
+    ratelimit.reset()
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", recorder)
+    assert ratelimit.check_and_increment("k", 3) == 1
+    assert calls == [(("k", 3, float("inf")), {"burst": 0})]
+
+
+def test_dispatch_hook_never_counts_reads():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 3, "rate_limit_window_seconds": 60}
+    for _ in range(config["rate_limit_max_per_window"] + 5):
+        assert ratelimit.dispatch_hook(None, config, "GET", "/records", {}) is None
+    assert ratelimit.check_and_increment("anonymous", 3, 60) == 1
+
+
+def test_dispatch_hook_keys_off_the_actor_kwarg():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+
+    # A named actor counts against its own key, untouched by "anonymous".
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+
+
+def test_dispatch_hook_reads_the_limit_from_config():
+    ratelimit.reset()
+    strict = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, strict, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, strict, "POST", "/records", {"actor": "a"})
+
+    ratelimit.reset()
+    lenient = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, lenient, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, lenient, "POST", "/records", {"actor": "a"})
+
+
+def test_dispatch_hook_window_frees_the_actor_after_it_elapses():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+    quota.advance(61)
+    assert ratelimit.dispatch_hook(None, config, "POST", "/records",
+                                   {"actor": "a"}) is None
+
+
+def test_dispatch_hook_works_with_a_limit_only_config():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 1}
+    assert ratelimit.dispatch_hook(None, config, "POST", "/records", {}) is None
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+
+    # The default window is 60 seconds and the default burst is 0.
+    quota.advance(61)
+    assert ratelimit.dispatch_hook(None, config, "POST", "/records", {}) is None
+
+
+def test_dispatch_hook_reads_the_burst_from_config():
+    ratelimit.reset()
+    config = {
+        "rate_limit_max_per_window": 1,
+        "rate_limit_burst": 1,
+        "rate_limit_window_seconds": 60,
+    }
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+    ratelimit.reset()
+    no_burst = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, no_burst, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, no_burst, "POST", "/records", {"actor": "a"})
+
+
+def test_retry_after_delegates_to_time_to_next_slot(monkeypatch):
+    ratelimit.reset()
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 12.5
+
+    monkeypatch.setattr(quota, "time_to_next_slot", recorder)
+    config = {
+        "rate_limit_max_per_window": 2,
+        "rate_limit_window_seconds": 60,
+        "rate_limit_burst": 1,
+    }
+    assert ratelimit.retry_after("k", config) == 12.5
+    assert calls == [(("k", 2, 60), {"burst": 1})]
+
+
+def test_retry_after_reports_the_seconds_until_the_window_frees():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(10)
+    assert ratelimit.retry_after("a", config) == 50.0
+
+
+def test_limit_headers_returns_exact_string_valued_headers():
+    ratelimit.reset()
+    config = {
+        "rate_limit_max_per_window": 2,
+        "rate_limit_window_seconds": 60,
+        "rate_limit_burst": 1,
+    }
+    assert ratelimit.limit_headers("a", config) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "3",
+        "X-RateLimit-Reset": "0.0",
+    }
+    # read-only: the reading above recorded nothing
+    assert ratelimit.dispatch_hook(None, config, "POST", "/records",
+                                   {"actor": "a"}) is None
+
+    ratelimit.reset()
+    exhausted = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, exhausted, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, exhausted, "POST", "/records", {"actor": "a"})
+    quota.advance(10)
+    assert ratelimit.limit_headers("a", exhausted) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "0",
+        "X-RateLimit-Reset": "50.0",
+    }
+
+    # A limit-only config reads the same defaults as the hook.
+    ratelimit.reset()
+    assert ratelimit.limit_headers("a", {"rate_limit_max_per_window": 2}) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "2",
+        "X-RateLimit-Reset": "0.0",
+    }
+
+
+def test_status_line_renders_the_exact_usage_string():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert ratelimit.status_line("mallory", config) == \
+        "mallory: 0/2, reset in 0.0s"
+
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
+    quota.advance(10)
+    assert ratelimit.status_line("mallory", config) == \
+        "mallory: 2/2, reset in 50.0s"
+
+
+def test_check_many_reports_which_keys_would_pass_without_recording():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "b"})
+
+    assert ratelimit.check_many(["a", "b", "c"], config) == {
+        "a": False,
+        "b": True,
+        "c": True,
+    }
+    # read-only: no key's counter moved
+    assert ratelimit.check_many(["a", "b", "c"], config) == {
+        "a": False,
+        "b": True,
+        "c": True,
+    }
+    assert ratelimit.check_and_increment("b", 2, 60) == 2
+    assert ratelimit.check_and_increment("c", 2, 60) == 1
