@@ -0,0 +1,154 @@
+"""Pure rule-combinator layer on top of app.schema's predicates.
+
+A "rule" is a plain dict: {"name": <str>, "test": <callable>}. Rules
+combine (all_of/any_of/negate/when) without ever reimplementing the
+predicates schema.py already owns -- every builtin here calls through to
+app.schema at call time, so patching schema's predicates changes what
+these rules do.
+"""
+from app import schema
+
+
+class RuleError(Exception):
+    """Distinct from schema.SchemaError -- this module's own error type."""
+
+
+def rule(name, predicate):
+    """Build a rule dict. ``name`` must be a non-empty string."""
+    if not isinstance(name, str) or name == "":
+        raise ValueError("rule name must be a non-empty string")
+    return {"name": name, "test": predicate}
+
+
+def check(value, r):
+    """Run a rule's predicate against ``value``."""
+    return bool(r["test"](value))
+
+
+def all_of(*rules):
+    """Composite rule passing iff every child rule passes."""
+    name = "all(" + ",".join(r["name"] for r in rules) + ")"
+
+    def test(value):
+        return all(check(value, r) for r in rules)
+
+    return rule(name, test)
+
+
+def any_of(*rules):
+    """Composite rule passing iff at least one child rule passes. A
+    vacuous any_of() (no children) is a bug, not a policy: ValueError."""
+    if not rules:
+        raise ValueError("any_of requires at least one rule")
+    name = "any(" + ",".join(r["name"] for r in rules) + ")"
+
+    def test(value):
+        return any(check(value, r) for r in rules)
+
+    return rule(name, test)
+
+
+def negate(r):
+    """Invert a rule."""
+    name = "not(%s)" % r["name"]
+
+    def test(value):
+        return not check(value, r)
+
+    return rule(name, test)
+
+
+def when(cond, then):
+    """Material implication: passes when ``cond`` fails, or ``then``
+    passes."""
+    name = "when(%s,%s)" % (cond["name"], then["name"])
+
+    def test(value):
+        return (not check(value, cond)) or check(value, then)
+
+    return rule(name, test)
+
+
+def explain(value, r):
+    """Return "<name>: pass" or "<name>: fail" for ``value`` against ``r``."""
+    return "%s: %s" % (r["name"], "pass" if check(value, r) else "fail")
+
+
+def apply_rules(fields, rules_by_field):
+    """Return the list of "field <f> failed <rule name>" strings, in
+    rules_by_field insertion order, skipping fields absent from
+    ``fields``. ``fields`` is never mutated."""
+    errors = []
+    for field, r in rules_by_field.items():
+        if field not in fields:
+            continue
+        if not check(fields[field], r):
+            errors.append("field %s failed %s" % (field, r["name"]))
+    return errors
+
+
+def first_failure(fields, rules_by_field):
+    """Return the (field, rule name) tuple of the first failure in
+    insertion order, or None."""
+    for field, r in rules_by_field.items():
+        if field not in fields:
+            continue
+        if not check(fields[field], r):
+            return (field, r["name"])
+    return None
+
+
+def explain_failures(fields, rules_by_field):
+    """Return explain() strings for failing fields only, in
+    rules_by_field insertion order."""
+    result = []
+    for field, r in rules_by_field.items():
+        if field not in fields:
+            continue
+        if not check(fields[field], r):
+            result.append(explain(fields[field], r))
+    return result
+
+
+BUILTINS = {
+    "number": rule("number", lambda value: schema.is_valid_amount(value)),
+    "str": rule("str", lambda value: isinstance(value, str)),
+    "non_empty": rule("non_empty", lambda value: schema.is_non_empty_str(value)),
+}
+
+
+def parse_rule(text):
+    """Parse a "&"-joined builtin list into a single rule, composing with
+    all_of when more than one token is present, in text order."""
+    if not text:
+        raise ValueError("empty rule text")
+    tokens = text.split("&")
+    resolved = []
+    for token in tokens:
+        if token not in BUILTINS:
+            raise ValueError("unknown rule: %s" % token)
+        resolved.append(BUILTINS[token])
+    if len(resolved) == 1:
+        return resolved[0]
+    return all_of(*resolved)
+
+
+def parse_rules(text_by_field):
+    """Map a dict of field name -> "&"-joined rule text through
+    parse_rule, preserving insertion order."""
+    result = {}
+    for field, text in text_by_field.items():
+        try:
+            result[field] = parse_rule(text)
+        except ValueError as exc:
+            raise ValueError("field %s: %s" % (field, exc))
+    return result
+
+
+def describe_rules(rules_by_field):
+    """Render an exact multi-line description: one line per field in
+    insertion order, "<field>: <rule name>"."""
+    if not rules_by_field:
+        return "(no rules)"
+    lines = ["%s: %s" % (field, r["name"]) for field, r in rules_by_field.items()]
+    return "\n".join(lines)
diff --git a/app/schema.py b/app/schema.py
new file mode 100644
index 0000000..a4aa3f7
--- /dev/null
+++ b/app/schema.py
@@ -0,0 +1,204 @@
+"""Declarative field-validation toolkit.
+
+This module owns the shared error vocabulary (``ERROR_CATALOG`` /
+``format_error``), the low-level predicates (``is_valid_amount``,
+``is_non_empty_str``, ``check_required``), and a small declarative spec
+compiler (``compile_spec`` and friends) that other modules build on.
+Nothing in here knows about records, stores, or hooks; it is pure.
+"""
+import math
+
+
+ERROR_CATALOG = {
+    "missing": "missing field: {field}",
+    "numeric": "field {field} must be numeric (got {got})",
+    "non_negative": "field {field} must be non-negative",
+    "max": "field {field} exceeds max_amount {limit}",
+    "non_empty": "field {field} must be a non-empty string",
+    "type_str": "field {field} must be a string",
+}
+
+
+class SchemaError(Exception):
+    """Raised by a compiled spec validator when a field fails its rules."""
+
+
+def format_error(code, **kwargs):
+    """Render the ``ERROR_CATALOG`` template for ``code``. Raises
+    ``KeyError`` for an unknown code -- there is no silent fallback."""
+    return ERROR_CATALOG[code].format(**kwargs)
+
+
+def check_required(fields, required_fields):
+    """Return the subset of ``required_fields`` absent from ``fields``, in
+    ``required_fields`` order."""
+    return [f for f in required_fields if f not in fields]
+
+
+def is_valid_amount(value):
+    """True for a finite, non-bool int/float. Bools are excluded even
+    though ``isinstance(True, int)`` is True in Python. Ints of any size
+    are always finite, so only floats are routed through
+    ``math.isfinite`` (an int too large to convert to float would raise
+    ``OverflowError`` if it were)."""
+    if isinstance(value, bool):
+        return False
+    if isinstance(value, int):
+        return True
+    if isinstance(value, float):
+        return math.isfinite(value)
+    return False
+
+
+def is_non_empty_str(value):
+    """True for a string with at least one non-whitespace character."""
+    return isinstance(value, str) and value.strip() != ""
+
+
+_ALLOWED_RULE_KEYS = {"required", "type", "non_empty", "max"}
+_ALLOWED_TYPES = {"str", "number"}
+
+
+def _first_rule_failure(field, value, rules):
+    """Check ``rules`` for ``field``/``value`` in the fixed order
+    type -> non_empty -> max, returning the first failure message, or
+    None if every applicable rule passes."""
+    if "type" in rules:
+        kind = rules["type"]
+        if kind == "number":
+            if not is_valid_amount(value):
+                return format_error("numeric", field=field, got=type(value).__name__)
+        elif kind == "str":
+            if not isinstance(value, str):
+                return format_error("type_str", field=field)
+    if rules.get("non_empty"):
+        if not is_non_empty_str(value):
+            return format_error("non_empty", field=field)
+    if "max" in rules:
+        limit = rules["max"]
+        if not is_valid_amount(value):
+            return format_error("numeric", field=field, got=type(value).__name__)
+        if value > limit:
+            return format_error("max", field=field, limit=limit)
+    return None
+
+
+def compile_spec(spec):
+    """Compile a declarative field spec into a reusable validator
+    callable. Raises ValueError at compile time for an unknown rule key
+    or an unknown ``type`` value."""
+    for field, rules in spec.items():
+        for key in rules:
+            if key not in _ALLOWED_RULE_KEYS:
+                raise ValueError("unknown rule key: %s" % key)
+        if "type" in rules and rules["type"] not in _ALLOWED_TYPES:
+            raise ValueError("unknown type: %s" % rules["type"])
+
+    def validator(fields):
+        for field, rules in spec.items():
+            if rules.get("required") and field not in fields:
+                raise SchemaError(format_error("missing", field=field))
+        for field, rules in spec.items():
+            if field not in fields:
+                continue
+            err = _first_rule_failure(field, fields[field], rules)
+            if err:
+                raise SchemaError(err)
+        result = {}
+        for field, value in fields.items():
+            rules = spec.get(field, {})
+            if rules.get("non_empty") and isinstance(value, str):
+                result[field] = value.strip()
+            else:
+                result[field] = value
+        return result
+
+    return validator
+
+
+def merge_specs(a, b):
+    """Return a new spec that is the union of ``a`` and ``b``. Neither
+    input is mutated. A rule key shared by a field in both specs must
+    agree on its value, or ValueError is raised naming the field and key."""
+    result = {}
+    for field, rules in a.items():
+        result[field] = dict(rules)
+    for field, rules in b.items():
+        if field not in result:
+            result[field] = dict(rules)
+            continue
+        merged = result[field]
+        for key, value in rules.items():
+            if key in merged and merged[key] != value:
+                raise ValueError(
+                    "conflicting rule for field %s: %s" % (field, key)
+                )
+            merged[key] = value
+    return result
+
+
+def describe_spec(spec):
+    """Render an exact multi-line description of ``spec``: one line per
+    field in sorted field order, rule keys sorted and comma-joined."""
+    if not spec:
+        return "(empty spec)"
+    lines = []
+    for field in sorted(spec):
+        rules = spec[field]
+        parts = ["%s=%s" % (key, rules[key]) for key in sorted(rules)]
+        lines.append("%s: %s" % (field, ", ".join(parts)))
+    return "\n".join(lines)
+
+
+def diff_specs(a, b):
+    """Return {"added": [...], "removed": [...], "changed": [...]} for the
+    fields only in b, only in a, and in both with unequal rules dicts,
+    each sorted. Neither input is mutated."""
+    a_keys = set(a)
+    b_keys = set(b)
+    added = sorted(b_keys - a_keys)
+    removed = sorted(a_keys - b_keys)
+    changed = sorted(f for f in (a_keys & b_keys) if a[f] != b[f])
+    return {"added": added, "removed": removed, "changed": changed}
+
+
+def spec_from_config(config, prefix):
+    """Collect every config key starting with ``prefix`` into a spec,
+    stripping the prefix to get the field name. Keys without the prefix
+    are ignored."""
+    spec = {}
+    for key, value in config.items():
+        if key.startswith(prefix):
+            field = key[len(prefix):]
+            spec[field] = value
+    return spec
+
+
+def spec_to_config(spec, prefix):
+    """Inverse of spec_from_config: {prefix + field: rules copy}."""
+    return {prefix + field: dict(rules) for field, rules in spec.items()}
+
+
+def spec_summary_line(spec):
+    """Return "<N> fields, <M> rules"."""
+    n = len(spec)
+    m = sum(len(rules) for rules in spec.values())
+    return "%d fields, %d rules" % (n, m)
+
+
+def validate_collect(spec, fields):
+    """Like a compiled validator, but collects every error message
+    instead of raising on the first. Required-miss messages come first,
+    in spec order; then at most one message per present field (the first
+    failing rule in type -> non_empty -> max order), in spec order."""
+    errors = []
+    for field, rules in spec.items():
+        if rules.get("required") and field not in fields:
+            errors.append(format_error("missing", field=field))
+    for field, rules in spec.items():
+        if field not in fields:
+            continue
+        err = _first_rule_failure(field, fields[field], rules)
+        if err:
+            errors.append(err)
+    return errors
diff --git a/app/tabular.py b/app/tabular.py
new file mode 100644
index 0000000..44e7b45
--- /dev/null
+++ b/app/tabular.py
@@ -0,0 +1,135 @@
+"""Column-model toolkit shared by every export format.
+
+`app.export` builds each serializer on top of these primitives so the
+column union, cell rendering, and escaping logic exist in exactly one
+place: here.
+"""
+
+
+def columns(records):
+    """Sorted union of every key across all records."""
+    keys = set()
+    for r in records:
+        keys.update(r.keys())
+    return sorted(keys)
+
+
+def cell(value):
+    """Plain str() rendering of a value, except None -> ""."""
+    if value is None:
+        return ""
+    return str(value)
+
+
+def escape_csv(value):
+    """CSV-escape a single cell: quote the whole cell and double any
+    inner quotes if the cell contains a comma, quote, or newline."""
+    text = cell(value)
+    if any(ch in text for ch in (",", '"', "\n")):
+        return '"' + text.replace('"', '""') + '"'
+    return text
+
+
+def widths(records, cols):
+    """Column name -> max(len(header), max cell width) across records."""
+    result = {}
+    for col in cols:
+        widest = len(col)
+        for r in records:
+            widest = max(widest, len(cell(r.get(col))))
+        result[col] = widest
+    return result
+
+
+def pad(value, width, align):
+    """Pad `value` to `width` per `align` ("left" or "right"). A value
+    already at or beyond width is returned unchanged. Any other align
+    raises ValueError, validated before any short-circuit."""
+    if align not in ("left", "right"):
+        raise ValueError("invalid align: %s" % align)
+    if len(value) >= width:
+        return value
+    padding = " " * (width - len(value))
+    if align == "left":
+        return value + padding
+    return padding + value
+
+
+def sanitize_flat(value):
+    """cell(value) rendering with every tab/newline replaced by a space."""
+    text = cell(value)
+    return text.replace("\t", " ").replace("\n", " ")
+
+
+def escape_html(value):
+    """cell(value) rendering with &, <, >, " escaped (& first)."""
+    text = cell(value)
+    text = text.replace("&", "&amp;")
+    text = text.replace("<", "&lt;")
+    text = text.replace(">", "&gt;")
+    text = text.replace('"', "&quot;")
+    return text
+
+
+def truncate(value, width, marker="..."):
+    """Truncate `value` to `width` chars, appending `marker` if it was
+    truncated. Raises ValueError if width < len(marker)."""
+    if width < len(marker):
+        raise ValueError("width shorter than marker: %s" % width)
+    if len(value) <= width:
+        return value
+    return value[:width - len(marker)] + marker
+
+
+def wrap(value, width):
+    """Greedily word-wrap `value` on spaces into lines <= width. A single
+    word longer than width is hard-split at width. wrap("", width)
+    returns [""]. Raises ValueError if width < 1."""
+    if width < 1:
+        raise ValueError("width must be >= 1: %s" % width)
+    if value == "":
+        return [""]
+
+    def split_long_word(word):
+        return [word[i:i + width] for i in range(0, len(word), width)]
+
+    words = value.split(" ")
+    lines = []
+    current = ""
+    for word in words:
+        if len(word) > width:
+            if current:
+                lines.append(current)
+                current = ""
+            lines.extend(split_long_word(word))
+            continue
+        if not current:
+            candidate = word
+        else:
+            candidate = current + " " + word
+        if len(candidate) <= width:
+            current = candidate
+        else:
+            lines.append(current)
+            current = word
+    if current or not lines:
+        lines.append(current)
+    return lines
+
+
+def fit(value, width, align):
+    """Compose truncate then pad: an over-long value is truncated to
+    width (marker included), a short one padded per align."""
+    return pad(truncate(value, width), width, align)
+
+
+def render_row(cells, widths_list, align):
+    """Render one pipe-table row: "| " + " | ".join(padded cells) + " |".
+    Raises ValueError if len(cells) != len(widths_list)."""
+    if len(cells) != len(widths_list):
+        raise ValueError(
+            "cells/widths length mismatch: %d != %d"
+            % (len(cells), len(widths_list))
+        )
+    padded = [pad(c, w, align) for c, w in zip(cells, widths_list)]
+    return "| " + " | ".join(padded) + " |"
diff --git a/app/throttle.py b/app/throttle.py
new file mode 100644
index 0000000..5f2fb13
--- /dev/null
+++ b/app/throttle.py
@@ -0,0 +1,81 @@
+"""A pure policy layer over app/quota.py.
+
+This is a library for future routes: it is not wired into the registry.
+It imports app.quota only -- never app.ratelimit -- and keeps no module
+state of its own beyond the POLICIES constant.
+"""
+from app import quota
+from app.quota import QuotaExceededError
+
+
+class PolicyError(Exception):
+    pass
+
+
+POLICIES = {
+    "POST /records": {"limit": 5, "window": 60, "burst": 0},
+    "GET /export": {"limit": 10, "window": 60, "burst": 2},
+}
+
+
+def match_policy(method, path, policies):
+    """Return the policy dict whose key is "<method> <path-prefix>" where
+    path-prefix is a prefix of `path`, choosing the longest matching
+    prefix. None if nothing matches."""
+    best_key = None
+    best_policy = None
+    for key, policy in policies.items():
+        policy_method, _, prefix = key.partition(" ")
+        if policy_method != method:
+            continue
+        if not path.startswith(prefix):
+            continue
+        if best_key is None or len(prefix) > len(best_key):
+            best_key = prefix
+            best_policy = policy
+    return best_policy
+
+
+def key_for(method, path, actor):
+    return "%s %s:%s" % (method, path, actor)
+
+
+def enforce(method, path, actor, policies):
+    """No matching policy: return None, record nothing. A match: delegate
+    to quota.take under the policy's params, returning the in-window
+    count. Raises PolicyError (chained from QuotaExceededError) once the
+    policy's allowance is exhausted."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    key = key_for(method, path, actor)
+    try:
+        return quota.take(key, policy["limit"], policy["window"], burst=policy["burst"])
+    except QuotaExceededError as exc:
+        raise PolicyError(
+            "policy exhausted for %r: limit=%s" % (key, policy["limit"])
+        ) from exc
+
+
+def remaining_for(method, path, actor, policies):
+    """None when no policy matches, else quota.remaining under the
+    policy's params. Read-only."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    key = key_for(method, path, actor)
+    return quota.remaining(key, policy["limit"], policy["window"], burst=policy["burst"])
+
+
+def describe_policies(policies):
+    """Render an exact multi-line string: one line per key, sorted."""
+    if not policies:
+        return "(no policies)"
+    lines = []
+    for key in sorted(policies):
+        policy = policies[key]
+        lines.append(
+            "%s: limit=%s, window=%s, burst=%s"
+            % (key, policy["limit"], policy["window"], policy["burst"])
+        )
+    return "\n".join(lines)
diff --git a/app/validation.py b/app/validation.py
new file mode 100644
index 0000000..7700670
--- /dev/null
+++ b/app/validation.py
@@ -0,0 +1,95 @@
+"""Input-validation layer wired into record creation as a PRE_CREATE_HOOK.
+
+Every error message here comes from schema.format_error -- this module
+holds no error-message string literals of its own, so the catalog in
+app.schema is the single source of truth for wording.
+"""
+import re
+
+from app import schema
+
+
+class ValidationError(Exception):
+    """Raised by validate_fields (and validate_many, per-entry) when a
+    field fails validation."""
+
+
+def validate_fields(fields, required_fields, max_amount):
+    """Validate ``fields`` against ``required_fields`` (presence) and, for
+    whichever of "amount"/"name" are present, their value rules. Returns
+    a new dict (the input is never mutated): "name" is stripped, every
+    other key/value is preserved unchanged."""
+    missing = schema.check_required(fields, required_fields)
+    if missing:
+        raise ValidationError(schema.format_error("missing", field=missing[0]))
+
+    if "amount" in fields:
+        amount = fields["amount"]
+        if not schema.is_valid_amount(amount):
+            raise ValidationError(
+                schema.format_error("numeric", field="amount", got=type(amount).__name__)
+            )
+        if amount < 0:
+            raise ValidationError(schema.format_error("non_negative", field="amount"))
+        if amount > max_amount:
+            raise ValidationError(
+                schema.format_error("max", field="amount", limit=max_amount)
+            )
+
+    if "name" in fields:
+        name = fields["name"]
+        if not schema.is_non_empty_str(name):
+            raise ValidationError(schema.format_error("non_empty", field="name"))
+
+    result = dict(fields)
+    if "name" in result:
+        result["name"] = result["name"].strip()
+    return result
+
+
+def pre_create_hook(store, config, fields):
+    """PRE_CREATE_HOOKS entry point: delegates to validate_fields using
+    the config's validation settings. ``store`` is unused."""
+    return validate_fields(
+        fields,
+        config["validation_required_fields"],
+        config["validation_max_amount"],
+    )
+
+
+def validate_many(entries, required_fields, max_amount):
+    """Validate a list of ``fields`` dicts. Returns (validated, errors):
+    validated is the list of successfully-validated new dicts in input
+    order; errors is a list of (index, str(err)) tuples for the
+    failures, also in input order. Neither the input list nor its dicts
+    are mutated."""
+    validated = []
+    errors = []
+    for index, entry in enumerate(entries):
+        try:
+            validated.append(validate_fields(entry, required_fields, max_amount))
+        except ValidationError as exc:
+            errors.append((index, str(exc)))
+    return validated, errors
+
+
+def error_code(message):
+    """Map an error-message string back to its ERROR_CATALOG code by
+    matching against the catalog's templates, built fresh from
+    schema.ERROR_CATALOG at call time (not a second hand-written table)."""
+    for code, template in schema.ERROR_CATALOG.items():
+        pattern = re.escape(template)
+        pattern = re.sub(r"\\\{\w+\\\}", ".*", pattern)
+        if re.fullmatch(pattern, message):
+            return code
+    raise ValueError("unrecognized error message: %s" % message)
+
+
+def explain_config(config):
+    """Render an exact human-readable summary of the validation config."""
+    required = config["validation_required_fields"]
+    max_amount = config["validation_max_amount"]
+    return "validation config:\n  required: %s\n  max_amount: %s" % (
+        ", ".join(required),
+        max_amount,
+    )
diff --git a/tests/test_audit.py b/tests/test_audit.py
new file mode 100644
index 0000000..fc6f9de
--- /dev/null
+++ b/tests/test_audit.py
@@ -0,0 +1,168 @@
+"""Tests for app/audit.py — a module-global append-only audit log with a
+cap on retained entries."""
+import pytest
+
+from app import audit
+
+
+def test_entries_on_fresh_log_is_empty():
+    audit.clear()
+    assert audit.entries() == []
+
+
+def test_record_appends_exactly_one_entry():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
+
+
+def test_entries_returns_in_call_order():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    audit.record("POST", "/records", "bob", 500)
+    audit.record("DELETE", "/records", "carol", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "DELETE", "path": "/records", "actor": "carol"},
+    ]
+
+
+def test_entries_returns_a_copy():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    result = audit.entries()
+    result.append({"method": "X", "path": "Y", "actor": "Z"})
+    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
+
+
+def test_cap_keeps_last_n_entries():
+    audit.clear()
+    audit.record("GET", "/a", "alice", 3)
+    audit.record("GET", "/b", "bob", 3)
+    audit.record("GET", "/c", "carol", 3)
+    audit.record("GET", "/d", "dave", 3)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/b", "actor": "bob"},
+        {"method": "GET", "path": "/c", "actor": "carol"},
+        {"method": "GET", "path": "/d", "actor": "dave"},
+    ]
+
+
+def test_cap_enforced_on_every_call_not_just_at_end():
+    audit.clear()
+    for i in range(5):
+        audit.record("GET", "/p%d" % i, "actor%d" % i, 2)
+        assert len(audit.entries()) <= 2
+
+
+def test_dispatch_hook_defaults_actor_to_anonymous():
+    audit.clear()
+    audit.dispatch_hook(None, {"audit_log_max_entries": 500}, "GET", "/records", {})
+    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "anonymous"}]
+
+
+def test_dispatch_hook_uses_actor_kwarg_and_excludes_other_fields():
+    audit.clear()
+    audit.dispatch_hook(
+        None,
+        {"audit_log_max_entries": 500},
+        "POST",
+        "/records",
+        {"actor": "bob", "name": "x"},
+    )
+    assert audit.entries() == [{"method": "POST", "path": "/records", "actor": "bob"}]
+
+
+def test_dispatch_hook_reads_cap_from_config():
+    audit.clear()
+    config = {"audit_log_max_entries": 1}
+    audit.dispatch_hook(None, config, "GET", "/records", {})
+    audit.dispatch_hook(None, config, "GET", "/records", {})
+    assert len(audit.entries()) == 1
+
+
+def test_dispatch_hook_fires_for_every_method():
+    audit.clear()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(None, config, "DELETE", "/records/{id}", {})
+    audit.dispatch_hook(None, config, "PUT", "/records/{id}", {})
+    methods = [e["method"] for e in audit.entries()]
+    assert methods == ["DELETE", "PUT"]
+
+
+def test_record_many_appends_all_in_order_and_enforces_cap_throughout():
+    audit.clear()
+    triples = [
+        ("GET", "/a", "alice"),
+        ("GET", "/b", "bob"),
+        ("GET", "/c", "carol"),
+        ("GET", "/d", "dave"),
+    ]
+
+    seen_lengths = []
+    original_record = audit.record
+
+    def recording_record(*args, **kwargs):
+        original_record(*args, **kwargs)
+        seen_lengths.append(len(audit.entries()))
+
+    audit.record = recording_record
+    try:
+        count = audit.record_many(triples, max_entries=2)
+    finally:
+        audit.record = original_record
+
+    assert count == 4
+    assert all(n <= 2 for n in seen_lengths)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/c", "actor": "carol"},
+        {"method": "GET", "path": "/d", "actor": "dave"},
+    ]
+
+
+def test_dropped_counts_evicted_entries_since_last_clear():
+    audit.clear()
+    assert audit.dropped() == 0
+    for i in range(5):
+        audit.record("GET", "/p%d" % i, "actor%d" % i, 3)
+    assert audit.dropped() == 2
+    audit.clear()
+    assert audit.dropped() == 0
+
+
+def test_export_state_is_a_deep_enough_copy():
+    audit.clear()
+    audit.record("GET", "/a", "alice", 500)
+    state = audit.export_state()
+    assert state == {
+        "entries": [{"method": "GET", "path": "/a", "actor": "alice"}],
+        "dropped": 0,
+    }
+    state["entries"][0]["actor"] = "mallory"
+    state["entries"].append({"method": "X", "path": "Y", "actor": "Z"})
+    assert audit.entries() == [{"method": "GET", "path": "/a", "actor": "alice"}]
+
+
+def test_import_state_round_trip_and_no_leak_from_source_dict():
+    audit.clear()
+    audit.record("GET", "/a", "alice", 500)
+    audit.record("GET", "/b", "bob", 500)
+    for i in range(5):
+        audit.record("GET", "/p%d" % i, "actor%d" % i, 3)
+    state = audit.export_state()
+    expected_entries = audit.entries()
+    expected_dropped = audit.dropped()
+
+    audit.clear()
+    assert audit.entries() == []
+    assert audit.dropped() == 0
+
+    audit.import_state(state)
+    assert audit.entries() == expected_entries
+    assert audit.dropped() == expected_dropped
+
+    state["entries"].append({"method": "X", "path": "Y", "actor": "Z"})
+    state["dropped"] = 999
+    assert audit.entries() == expected_entries
+    assert audit.dropped() == expected_dropped
diff --git a/tests/test_audit_query.py b/tests/test_audit_query.py
new file mode 100644
index 0000000..afaf757
--- /dev/null
+++ b/tests/test_audit_query.py
@@ -0,0 +1,450 @@
+"""Tests for app/audit_query.py — a pure read-side module over audit entry
+lists. Every function takes `entries` as a plain list argument and never
+mutates its input; each test snapshots the input before calling and
+asserts it is unchanged afterward."""
+import copy
+
+import pytest
+
+from app import audit_query as aq
+
+
+def assert_unmutated(entries, snapshot):
+    assert entries == snapshot
+
+
+ENTRIES_4 = [
+    {"method": "GET", "path": "/records", "actor": "alice"},
+    {"method": "POST", "path": "/records", "actor": "bob"},
+    {"method": "GET", "path": "/report", "actor": "alice"},
+    {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+]
+
+
+def make_entries_4():
+    return copy.deepcopy(ENTRIES_4)
+
+
+def test_filter_entries():
+    entries = [
+        {"method": "GET", "path": "/records", "actor": "a"},
+        {"method": "POST", "path": "/records", "actor": "b"},
+        {"method": "GET", "path": "/other", "actor": "a"},
+        {"method": "POST", "path": "/other", "actor": "a"},
+    ]
+    snapshot = copy.deepcopy(entries)
+
+    assert aq.filter_entries(entries, actor="a") == [entries[0], entries[2], entries[3]]
+    assert_unmutated(entries, snapshot)
+
+    assert aq.filter_entries(entries, method="POST") == [entries[1], entries[3]]
+    assert_unmutated(entries, snapshot)
+
+    assert aq.filter_entries(entries, path="/records") == [entries[0], entries[1]]
+    assert_unmutated(entries, snapshot)
+
+    assert aq.filter_entries(entries, actor="a", method="POST") == [entries[3]]
+    assert_unmutated(entries, snapshot)
+
+    assert aq.filter_entries(entries) == entries
+    assert_unmutated(entries, snapshot)
+
+    first_call = aq.filter_entries(entries, actor="a")
+    first_call.append({"method": "X", "path": "Y", "actor": "Z"})
+    second_call = aq.filter_entries(entries, actor="a")
+    assert second_call == [entries[0], entries[2], entries[3]]
+    assert_unmutated(entries, snapshot)
+
+
+def test_counts_by():
+    entries = make_entries_4()
+    snapshot = copy.deepcopy(entries)
+
+    assert aq.counts_by(entries, "method") == {"GET": 2, "POST": 1, "DELETE": 1}
+    assert_unmutated(entries, snapshot)
+
+    assert aq.counts_by(entries, "actor") == {"alice": 2, "bob": 1, "carol": 1}
+    assert_unmutated(entries, snapshot)
+
+    assert aq.counts_by(entries, "path") == {
+        "/records": 2,
+        "/report": 1,
+        "/records/1": 1,
+    }
+    assert_unmutated(entries, snapshot)
+
+    with pytest.raises(ValueError):
+        aq.counts_by(entries, "bogus")
+
+    assert aq.counts_by([], "method") == {}
+
+
+def test_last_n():
+    entries = [
+        {"method": "GET", "path": "/a", "actor": "alice"},
+        {"method": "GET", "path": "/b", "actor": "bob"},
+        {"method": "GET", "path": "/c", "actor": "carol"},
+    ]
+    snapshot = copy.deepcopy(entries)
+
+    assert aq.last_n(entries, 2) == [entries[1], entries[2]]
+    assert_unmutated(entries, snapshot)
+
+    assert aq.last_n(entries, 0) == []
+    assert_unmutated(entries, snapshot)
+
+    result = aq.last_n(entries, 100)
+    assert result == entries
+    result.append({"method": "X", "path": "Y", "actor": "Z"})
+    assert_unmutated(entries, snapshot)
+
+    with pytest.raises(ValueError):
+        aq.last_n(entries, -1)
+
+
+def test_redact():
+    entries = make_entries_4()
+    snapshot = copy.deepcopy(entries)
+
+    redacted = aq.redact(entries, ["actor"])
+    assert redacted == [
+        {"method": "GET", "path": "/records", "actor": "***"},
+        {"method": "POST", "path": "/records", "actor": "***"},
+        {"method": "GET", "path": "/report", "actor": "***"},
+        {"method": "DELETE", "path": "/records/1", "actor": "***"},
+    ]
+    assert_unmutated(entries, snapshot)
+
+    identity = aq.redact(entries, [])
+    assert identity == entries
+    assert identity is not entries
+    assert all(a is not b for a, b in zip(identity, entries))
+
+    with pytest.raises(ValueError):
+        aq.redact(entries, ["bogus"])
+
+
+def test_summary():
+    assert aq.summary([]) == {
+        "total": 0,
+        "by_method": {},
+        "by_actor": {},
+        "first": None,
+        "last": None,
+    }
+
+    entries = make_entries_4()
+    snapshot = copy.deepcopy(entries)
+
+    result = aq.summary(entries)
+    assert result == {
+        "total": 4,
+        "by_method": {"GET": 2, "POST": 1, "DELETE": 1},
+        "by_actor": {"alice": 2, "bob": 1, "carol": 1},
+        "first": entries[0],
+        "last": entries[-1],
+    }
+    assert result["first"] is not entries[0]
+    assert result["last"] is not entries[-1]
+    assert_unmutated(entries, snapshot)
+
+
+def test_recent():
+    entries = [
+        {"method": "GET", "path": "/a", "actor": "alice"},
+        {"method": "GET", "path": "/b", "actor": "bob"},
+        {"method": "GET", "path": "/c", "actor": "carol"},
+    ]
+    snapshot = copy.deepcopy(entries)
+    config = {"audit_query_default_limit": 2}
+
+    assert aq.recent(entries, config) == aq.last_n(entries, 2)
+    assert aq.recent(entries, config) == [entries[1], entries[2]]
+    assert_unmutated(entries, snapshot)
+
+
+def test_paginate():
+    entries = [
+        {"method": "GET", "path": "/%d" % i, "actor": "actor%d" % i} for i in range(5)
+    ]
+    snapshot = copy.deepcopy(entries)
+
+    assert aq.paginate(entries, 1, 2) == {
+        "page": 1,
+        "pages": 3,
+        "total": 5,
+        "items": [entries[0], entries[1]],
+    }
+    assert aq.paginate(entries, 2, 2) == {
+        "page": 2,
+        "pages": 3,
+        "total": 5,
+        "items": [entries[2], entries[3]],
+    }
+    assert aq.paginate(entries, 3, 2) == {
+        "page": 3,
+        "pages": 3,
+        "total": 5,
+        "items": [entries[4]],
+    }
+    assert aq.paginate(entries, 4, 2) == {
+        "page": 4,
+        "pages": 3,
+        "total": 5,
+        "items": [],
+    }
+    assert aq.paginate([], 1, 2) == {"page": 1, "pages": 0, "total": 0, "items": []}
+
+    with pytest.raises(ValueError):
+        aq.paginate(entries, 0, 2)
+    with pytest.raises(ValueError):
+        aq.paginate(entries, 1, 0)
+
+    result = aq.paginate(entries, 1, 2)
+    result["items"].append({"method": "X", "path": "Y", "actor": "Z"})
+    assert_unmutated(entries, snapshot)
+
+
+def test_to_report():
+    entries = make_entries_4()
+    snapshot = copy.deepcopy(entries)
+
+    expected = (
+        "audit report\n"
+        "total: 4\n"
+        "\n"
+        "by method:\n"
+        "  DELETE: 1\n"
+        "  GET: 2\n"
+        "  POST: 1\n"
+        "\n"
+        "by actor:\n"
+        "  alice: 2\n"
+        "  bob: 1\n"
+        "  carol: 1"
+    )
+    assert aq.to_report(entries) == expected
+    assert_unmutated(entries, snapshot)
+
+    assert aq.to_report([]) == "audit report\ntotal: 0"
+
+
+def test_to_csv_report():
+    entries = make_entries_4()
+    snapshot = copy.deepcopy(entries)
+
+    expected = (
+        "field,value,count\n"
+        "method,DELETE,1\n"
+        "method,GET,2\n"
+        "method,POST,1\n"
+        "actor,alice,2\n"
+        "actor,bob,1\n"
+        "actor,carol,1"
+    )
+    assert aq.to_csv_report(entries) == expected
+    assert_unmutated(entries, snapshot)
+
+    assert aq.to_csv_report([]) == "field,value,count"
+
+
+def test_to_markdown_report():
+    entries = make_entries_4()
+    snapshot = copy.deepcopy(entries)
+
+    expected = (
+        "| field | value | count |\n"
+        "| --- | --- | --- |\n"
+        "| method | DELETE | 1 |\n"
+        "| method | GET | 2 |\n"
+        "| method | POST | 1 |\n"
+        "| actor | alice | 2 |\n"
+        "| actor | bob | 1 |\n"
+        "| actor | carol | 1 |"
+    )
+    assert aq.to_markdown_report(entries) == expected
+    assert_unmutated(entries, snapshot)
+
+    assert aq.to_markdown_report([]) == (
+        "| field | value | count |\n| --- | --- | --- |"
+    )
+
+
+def test_top_actors():
+    entries = [
+        {"method": "GET", "path": "/x", "actor": "bob"},
+        {"method": "GET", "path": "/x", "actor": "bob"},
+        {"method": "GET", "path": "/x", "actor": "alice"},
+        {"method": "GET", "path": "/x", "actor": "alice"},
+        {"method": "GET", "path": "/x", "actor": "carol"},
+    ]
+    snapshot = copy.deepcopy(entries)
+
+    assert aq.top_actors(entries, 3) == [("alice", 2), ("bob", 2), ("carol", 1)]
+    assert_unmutated(entries, snapshot)
+
+    assert aq.top_actors(entries, 0) == []
+
+    with pytest.raises(ValueError):
+        aq.top_actors(entries, -1)
+
+
+def test_merge_entries():
+    a = [{"method": "GET", "path": "/a", "actor": "alice"}]
+    b = [{"method": "POST", "path": "/b", "actor": "bob"}]
+    snapshot_a = copy.deepcopy(a)
+    snapshot_b = copy.deepcopy(b)
+
+    merged = aq.merge_entries(a, b)
+    assert merged == a + b
+    merged[0]["actor"] = "mallory"
+    assert_unmutated(a, snapshot_a)
+    assert_unmutated(b, snapshot_b)
+
+    assert aq.merge_entries() == []
+
+
+def test_diff_summaries():
+    entries_a = [
+        {"method": "GET", "path": "/x", "actor": "alice"},
+        {"method": "POST", "path": "/x", "actor": "bob"},
+    ]
+    entries_b = [
+        {"method": "GET", "path": "/x", "actor": "alice"},
+        {"method": "GET", "path": "/x", "actor": "carol"},
+    ]
+    summary_a = aq.summary(entries_a)
+    summary_b = aq.summary(entries_b)
+
+    assert aq.diff_summaries(summary_a, summary_b) == {
+        "total": 0,
+        "by_method": {"GET": 1, "POST": -1},
+        "by_actor": {"bob": -1, "carol": 1},
+    }
+
+
+def test_counts_matrix():
+    entries = [
+        {"method": "GET", "path": "/x", "actor": "alice"},
+        {"method": "GET", "path": "/x", "actor": "bob"},
+        {"method": "POST", "path": "/x", "actor": "alice"},
+        {"method": "DELETE", "path": "/x", "actor": "carol"},
+    ]
+    snapshot = copy.deepcopy(entries)
+
+    assert aq.counts_matrix(entries) == {
+        "GET": {"alice": 1, "bob": 1},
+        "POST": {"alice": 1},
+        "DELETE": {"carol": 1},
+    }
+    assert_unmutated(entries, snapshot)
+
+    assert aq.counts_matrix([]) == {}
+
+
+def test_rollup():
+    entries = [
+        {"method": "GET", "path": "/x", "actor": "alice"},
+        {"method": "GET", "path": "/x", "actor": "bob"},
+        {"method": "POST", "path": "/x", "actor": "alice"},
+        {"method": "DELETE", "path": "/x", "actor": "carol"},
+    ]
+    snapshot = copy.deepcopy(entries)
+
+    assert aq.rollup(entries, ["method"]) == aq.counts_by(entries, "method")
+    assert aq.rollup(entries, ["method", "actor"]) == aq.counts_matrix(entries)
+    assert_unmutated(entries, snapshot)
+
+    entries_three = [
+        {"method": "GET", "path": "/a", "actor": "alice"},
+        {"method": "GET", "path": "/b", "actor": "alice"},
+        {"method": "POST", "path": "/a", "actor": "bob"},
+    ]
+    snapshot_three = copy.deepcopy(entries_three)
+
+    assert aq.rollup(entries_three, ["actor", "method", "path"]) == {
+        "alice": {"GET": {"/a": 1, "/b": 1}},
+        "bob": {"POST": {"/a": 1}},
+    }
+    assert_unmutated(entries_three, snapshot_three)
+
+    assert aq.rollup([], ["method"]) == {}
+
+    with pytest.raises(ValueError):
+        aq.rollup(entries, [])
+    with pytest.raises(ValueError):
+        aq.rollup(entries, ["bogus"])
+    with pytest.raises(ValueError):
+        aq.rollup(entries, ["method", "method"])
+
+
+def test_format_entry_and_to_lines():
+    entry = {"method": "GET", "path": "/records", "actor": "alice"}
+    assert aq.format_entry(entry) == "GET /records (alice)"
+
+    with pytest.raises(ValueError):
+        aq.format_entry({"method": "GET", "path": "/records"})
+
+    entries = [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+    snapshot = copy.deepcopy(entries)
+
+    assert aq.to_lines(entries) == [
+        "GET /records (alice)",
+        "POST /records (bob)",
+        "DELETE /records/1 (carol)",
+    ]
+    assert_unmutated(entries, snapshot)
+    assert aq.to_lines([]) == []
+
+
+def test_group_by():
+    entries = make_entries_4()
+    snapshot = copy.deepcopy(entries)
+
+    grouped = aq.group_by(entries, "actor")
+    assert grouped == {
+        "alice": [entries[0], entries[2]],
+        "bob": [entries[1]],
+        "carol": [entries[3]],
+    }
+    grouped["alice"][0]["actor"] = "mallory"
+    assert_unmutated(entries, snapshot)
+
+    assert aq.group_by([], "method") == {}
+
+    with pytest.raises(ValueError):
+        aq.group_by(entries, "bogus")
+
+
+def test_search():
+    entries = [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/xyz", "actor": "recovery"},
+        {"method": "GET", "path": "/report", "actor": "bob"},
+    ]
+    snapshot = copy.deepcopy(entries)
+
+    assert aq.search(entries, "rec") == [entries[0], entries[1]]
+    assert_unmutated(entries, snapshot)
+
+    assert aq.search(entries, "nonexistent") == []
+
+    with pytest.raises(ValueError):
+        aq.search(entries, "")
+
+
+def test_integration_dispatch_hook_then_filter_entries():
+    from app import audit
+
+    audit.clear()
+    audit.dispatch_hook(None, {"audit_log_max_entries": 500}, "GET", "/records",
+                         {"actor": "alice"})
+    audit.dispatch_hook(None, {"audit_log_max_entries": 500}, "POST", "/records",
+                         {"actor": "bob"})
+
+    result = aq.filter_entries(audit.entries(), actor="bob")
+    assert result == [{"method": "POST", "path": "/records", "actor": "bob"}]
