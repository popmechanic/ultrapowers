+"""Tests for the column-model toolkit in app/tabular.py."""
+import pytest
+
+from app import tabular
+
+
+def test_columns_empty():
+    assert tabular.columns([]) == []
+
+
+def test_columns_sorted_union_of_differing_key_sets():
+    records = [{"b": 1, "a": 2}, {"c": 3, "a": 4}]
+    assert tabular.columns(records) == ["a", "b", "c"]
+
+
+def test_cell_none_is_empty_string():
+    assert tabular.cell(None) == ""
+
+
+def test_cell_int_has_no_dot_zero_suffix():
+    assert tabular.cell(3) == "3"
+
+
+def test_cell_float():
+    assert tabular.cell(3.5) == "3.5"
+
+
+def test_cell_string_passthrough():
+    assert tabular.cell("x") == "x"
+
+
+def test_escape_csv_plain_unquoted():
+    assert tabular.escape_csv("plain") == "plain"
+
+
+def test_escape_csv_comma_quoted():
+    assert tabular.escape_csv("a,b") == '"a,b"'
+
+
+def test_escape_csv_inner_quotes_doubled():
+    assert tabular.escape_csv('say "hi"') == '"say ""hi"""'
+
+
+def test_escape_csv_newline_quoted():
+    assert tabular.escape_csv("line1\nline2") == '"line1\nline2"'
+
+
+def test_escape_csv_empty_stays_unquoted():
+    assert tabular.escape_csv("") == ""
+
+
+def test_widths_header_strictly_wider_and_cell_widest():
+    # "name": header (4 chars) is strictly wider than every cell ("ab", "c").
+    # "id": widest value is a cell ("1000" is wider than header "id").
+    records = [
+        {"name": "ab", "id": "1"},
+        {"name": "c", "id": "1000"},
+    ]
+    cols = ["name", "id"]
+    assert tabular.widths(records, cols) == {"name": 4, "id": 4}
+
+
+def test_pad_left():
+    assert tabular.pad("ab", 4, "left") == "ab  "
+
+
+def test_pad_right():
+    assert tabular.pad("ab", 4, "right") == "  ab"
+
+
+def test_pad_value_already_beyond_width_unchanged():
+    assert tabular.pad("abcde", 4, "left") == "abcde"
+
+
+def test_pad_invalid_align_raises_even_when_width_already_met():
+    with pytest.raises(ValueError, match="center"):
+        tabular.pad("abcde", 4, "center")
+
+
+def test_sanitize_flat_replaces_tabs_and_newlines():
+    assert tabular.sanitize_flat("a\tb\nc") == "a b c"
+
+
+def test_sanitize_flat_clean_value_passthrough():
+    assert tabular.sanitize_flat("clean value") == "clean value"
+
+
+def test_escape_html_ampersand_first():
+    assert tabular.escape_html('<a & "b">') == "&lt;a &amp; &quot;b&quot;&gt;"
+
+
+def test_escape_html_clean_value_passthrough():
+    assert tabular.escape_html("clean") == "clean"
+
+
+def test_truncate_short_value_unchanged():
+    assert tabular.truncate("ab", 5) == "ab"
+
+
+def test_truncate_long_value_with_marker():
+    assert tabular.truncate("abcdefgh", 5, marker="...") == "ab..."
+
+
+def test_truncate_width_less_than_marker_raises():
+    with pytest.raises(ValueError):
+        tabular.truncate("abcdefgh", 2, marker="...")
+
+
+def test_wrap_three_word_value_two_widths():
+    assert tabular.wrap("one two three", 7) == ["one two", "three"]
+    assert tabular.wrap("one two three", 20) == ["one two three"]
+
+
+def test_wrap_hard_splits_long_word():
+    assert tabular.wrap("abcdefgh", 3) == ["abc", "def", "gh"]
+
+
+def test_wrap_empty_value():
+    assert tabular.wrap("", 5) == [""]
+
+
+def test_wrap_width_less_than_one_raises():
+    with pytest.raises(ValueError):
+        tabular.wrap("abc", 0)
+
+
+def test_fit_truncates_over_long_value():
+    assert tabular.fit("abcdefgh", 5, "left") == "ab..."
+
+
+def test_fit_pads_short_value():
+    assert tabular.fit("ab", 4, "right") == "  ab"
+
+
+def test_fit_invalid_align_raises():
+    with pytest.raises(ValueError):
+        tabular.fit("ab", 4, "center")
+
+
+def test_render_row_two_cells():
+    assert tabular.render_row(["ab", "c"], [4, 3], "left") == "| ab   | c   |"
+
+
+def test_render_row_mismatched_lengths_raises():
+    with pytest.raises(ValueError):
+        tabular.render_row(["ab", "c"], [4], "left")
diff --git a/tests/test_throttle.py b/tests/test_throttle.py
new file mode 100644
index 0000000..aa175fd
--- /dev/null
+++ b/tests/test_throttle.py
@@ -0,0 +1,116 @@
+"""Tests for app/throttle.py -- a pure policy layer over app/quota.py."""
+import pytest
+
+from app import quota, throttle
+from app.throttle import PolicyError, POLICIES
+from app.quota import QuotaExceededError
+
+
+@pytest.fixture(autouse=True)
+def _reset():
+    quota.reset()
+
+
+def test_policy_error_is_exception_subclass():
+    assert issubclass(PolicyError, Exception)
+
+
+def test_policies_constant_is_pinned_exactly():
+    assert POLICIES == {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+
+
+def test_match_policy_chooses_longest_matching_prefix():
+    policy = throttle.match_policy("GET", "/export/full", POLICIES)
+    assert policy == POLICIES["GET /export"]
+
+    extended = dict(POLICIES)
+    extended["GET /export/full"] = {"limit": 3, "window": 10, "burst": 0}
+    policy = throttle.match_policy("GET", "/export/full", extended)
+    assert policy == extended["GET /export/full"]
+
+    assert throttle.match_policy("POST", "/export", POLICIES) is None
+
+
+def test_key_for_exact_format():
+    assert throttle.key_for("POST", "/records", "mallory") == "POST /records:mallory"
+
+
+def test_enforce_no_matching_policy_returns_none_and_records_nothing():
+    result = throttle.enforce("PATCH", "/nope", "a", POLICIES)
+    assert result is None
+    # nothing recorded: a take against the same key still succeeds fully.
+    key = throttle.key_for("PATCH", "/nope", "a")
+    assert quota.take(key, limit=1, window_seconds=60) == 1
+
+
+def test_enforce_delegates_to_quota_take(monkeypatch):
+    calls = []
+
+    def recorder(key, limit, window_seconds, burst=0):
+        calls.append((key, limit, window_seconds, burst))
+        return 1
+
+    monkeypatch.setattr(quota, "take", recorder)
+    policies = {"POST /records": {"limit": 5, "window": 60, "burst": 0}}
+    result = throttle.enforce("POST", "/records", "mallory", policies)
+    expected_key = throttle.key_for("POST", "/records", "mallory")
+    assert calls == [(expected_key, 5, 60, 0)]
+    assert result == 1
+
+
+def test_enforce_exhausted_policy_raises_policy_error():
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    throttle.enforce("POST", "/records", "mallory", policies)
+    with pytest.raises(PolicyError) as exc_info:
+        throttle.enforce("POST", "/records", "mallory", policies)
+    msg = str(exc_info.value)
+    key = throttle.key_for("POST", "/records", "mallory")
+    assert key in msg
+    assert "1" in msg
+
+
+def test_enforce_policy_error_chained_from_quota_exceeded_error():
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    throttle.enforce("POST", "/records", "mallory", policies)
+    with pytest.raises(PolicyError) as exc_info:
+        throttle.enforce("POST", "/records", "mallory", policies)
+    assert isinstance(exc_info.value.__cause__, QuotaExceededError)
+
+
+def test_remaining_for_none_when_no_match_else_read_only_remaining():
+    assert throttle.remaining_for("PATCH", "/nope", "a", POLICIES) is None
+
+    policies = {"POST /records": {"limit": 2, "window": 60, "burst": 0}}
+    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 2
+    throttle.enforce("POST", "/records", "mallory", policies)
+    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 1
+    # read-only: a subsequent take still succeeds where it should
+    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 1
+    throttle.enforce("POST", "/records", "mallory", policies)
+    with pytest.raises(PolicyError):
+        throttle.enforce("POST", "/records", "mallory", policies)
+
+
+def test_describe_policies_exact_multiline_string():
+    policies = {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+    expected = (
+        "GET /export: limit=10, window=60, burst=2\n"
+        "POST /records: limit=5, window=60, burst=0"
+    )
+    assert throttle.describe_policies(policies) == expected
+    assert throttle.describe_policies({}) == "(no policies)"
+
+
+def test_end_to_end_enforce_then_advance_frees_slot():
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    throttle.enforce("POST", "/records", "mallory", policies)
+    with pytest.raises(PolicyError):
+        throttle.enforce("POST", "/records", "mallory", policies)
+    quota.advance(61)
+    throttle.enforce("POST", "/records", "mallory", policies)  # passes
