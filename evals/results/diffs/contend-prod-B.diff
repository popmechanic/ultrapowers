@@ -0,0 +1,149 @@
+"""Tests for app/rules.py — the pure rule-combinator layer over app/schema."""
+import pytest
+
+from app import rules, schema
+
+
+POSITIVE = rules.rule("positive", lambda v: isinstance(v, int) and v > 0)
+EVEN = rules.rule("even", lambda v: isinstance(v, int) and v % 2 == 0)
+
+
+def test_rule_error_is_a_distinct_exception_subclass():
+    assert issubclass(rules.RuleError, Exception)
+    assert not issubclass(rules.RuleError, schema.SchemaError)
+
+
+def test_rule_builds_a_named_predicate_and_rejects_a_bad_name():
+    predicate = lambda v: True  # noqa: E731
+    assert rules.rule("truthy", predicate) == {
+        "name": "truthy", "test": predicate}
+    with pytest.raises(ValueError):
+        rules.rule("", predicate)
+    with pytest.raises(ValueError):
+        rules.rule(42, predicate)
+
+
+def test_check_coerces_the_predicate_result_to_bool():
+    truthy = rules.rule("truthy", lambda v: v)
+    assert rules.check("non-empty", truthy) is True
+    assert rules.check("", truthy) is False
+
+
+def test_all_of_passes_only_when_every_child_passes():
+    both = rules.all_of(POSITIVE, EVEN)
+    assert both["name"] == "all(positive,even)"
+    assert rules.check(2, both) is True
+    assert rules.check(3, both) is False
+    assert rules.check(-2, both) is False
+    empty = rules.all_of()
+    assert empty["name"] == "all()"
+    assert rules.check(object(), empty) is True
+
+
+def test_any_of_passes_when_at_least_one_child_passes_and_rejects_no_children():
+    either = rules.any_of(POSITIVE, EVEN)
+    assert either["name"] == "any(positive,even)"
+    assert rules.check(3, either) is True
+    assert rules.check(-2, either) is True
+    assert rules.check(-3, either) is False
+    with pytest.raises(ValueError):
+        rules.any_of()
+
+
+def test_negate_inverts_and_names_the_child():
+    not_positive = rules.negate(POSITIVE)
+    assert not_positive["name"] == "not(positive)"
+    assert rules.check(1, not_positive) is False
+    assert rules.check(-1, not_positive) is True
+
+
+def test_when_is_material_implication_over_all_four_truth_table_cells():
+    implication = rules.when(POSITIVE, EVEN)
+    assert implication["name"] == "when(positive,even)"
+    assert rules.check(2, implication) is True    # cond pass, then pass
+    assert rules.check(3, implication) is False   # cond pass, then fail
+    assert rules.check(-2, implication) is True   # cond fail, then pass
+    assert rules.check(-3, implication) is True   # cond fail, then fail
+
+
+def test_explain_renders_pass_and_fail():
+    assert rules.explain(1, POSITIVE) == "positive: pass"
+    assert rules.explain(-1, POSITIVE) == "positive: fail"
+
+
+def test_apply_rules_lists_failures_in_insertion_order_without_mutating():
+    fields = {"a": 1, "b": -1, "c": -2}
+    by_field = {"c": POSITIVE, "b": POSITIVE, "a": POSITIVE, "absent": POSITIVE}
+    assert rules.apply_rules(fields, by_field) == [
+        "field c failed positive", "field b failed positive"]
+    assert fields == {"a": 1, "b": -1, "c": -2}
+    assert rules.apply_rules({"a": 1}, {"a": POSITIVE}) == []
+
+
+def test_first_failure_returns_the_first_failing_pair_or_none():
+    by_field = {"a": POSITIVE, "b": POSITIVE, "c": POSITIVE}
+    assert rules.first_failure({"a": 1, "b": -1, "c": -2}, by_field) == (
+        "b", "positive")
+    assert rules.first_failure({"a": 1, "b": 2, "c": 3}, by_field) is None
+
+
+def test_explain_failures_lists_only_failing_fields_in_insertion_order():
+    by_field = {"a": POSITIVE, "b": EVEN, "c": POSITIVE, "absent": POSITIVE}
+    assert rules.explain_failures({"a": 1, "b": 3, "c": -5}, by_field) == [
+        "even: fail", "positive: fail"]
+    assert rules.explain_failures({"a": 1, "b": 2, "c": 3}, by_field) == []
+
+
+def test_builtins_wrap_the_schema_predicates():
+    assert set(rules.BUILTINS) == {"number", "str", "non_empty"}
+    assert rules.BUILTINS["number"]["name"] == "number"
+    assert rules.BUILTINS["str"]["name"] == "str"
+    assert rules.BUILTINS["non_empty"]["name"] == "non_empty"
+    assert rules.check(3.5, rules.BUILTINS["number"]) is True
+    assert rules.check(True, rules.BUILTINS["number"]) is False
+    assert rules.check("3", rules.BUILTINS["str"]) is True
+    assert rules.check(3, rules.BUILTINS["str"]) is False
+    assert rules.check(" a ", rules.BUILTINS["non_empty"]) is True
+    assert rules.check("  ", rules.BUILTINS["non_empty"]) is False
+
+
+def test_parse_rule_reads_a_single_builtin_and_an_ampersand_list():
+    assert rules.parse_rule("number") == rules.BUILTINS["number"]
+    composite = rules.parse_rule("number&non_empty")
+    assert composite["name"] == "all(number,non_empty)"
+    with pytest.raises(ValueError) as exc:
+        rules.parse_rule("number&bogus")
+    assert "bogus" in str(exc.value)
+    with pytest.raises(ValueError):
+        rules.parse_rule("")
+
+
+def test_parse_rules_maps_a_dict_and_names_field_and_token_on_error():
+    parsed = rules.parse_rules({"amount": "number", "name": "str&non_empty"})
+    assert list(parsed) == ["amount", "name"]
+    assert parsed["amount"]["name"] == "number"
+    assert parsed["name"]["name"] == "all(str,non_empty)"
+    with pytest.raises(ValueError) as exc:
+        rules.parse_rules({"amount": "bogus"})
+    assert "amount" in str(exc.value)
+    assert "bogus" in str(exc.value)
+    assert rules.parse_rules({}) == {}
+    assert rules.apply_rules(
+        {"amount": "3", "name": "ada"},
+        rules.parse_rules({"amount": "number", "name": "str&non_empty"}),
+    ) == ["field amount failed number"]
+
+
+def test_describe_rules_renders_one_line_per_field_in_insertion_order():
+    by_field = {"amount": rules.BUILTINS["number"],
+                "name": rules.all_of(rules.BUILTINS["str"],
+                                     rules.BUILTINS["non_empty"])}
+    assert rules.describe_rules(by_field) == (
+        "amount: number\nname: all(str,non_empty)")
+    assert rules.describe_rules({}) == "(no rules)"
+
+
+def test_builtins_delegate_to_app_schema_at_call_time(monkeypatch):
+    assert rules.check(5, rules.parse_rule("number")) is True
+    monkeypatch.setattr(schema, "is_valid_amount", lambda value: False)
+    assert rules.check(5, rules.parse_rule("number")) is False
