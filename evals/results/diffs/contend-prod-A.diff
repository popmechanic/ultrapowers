+"""Tests for app/ratelimit.py: per-key rate limiting on top of app/quota.py.
+
+ratelimit keeps no counter state of its own -- everything lives in
+quota's module globals -- so ratelimit.reset() delegates to quota.reset().
+Call reset() at the start of every test so tests never leak into each
+other.
+"""
+import pytest
+
+from app import ratelimit, quota
+from app.ratelimit import RateLimitExceededError
+from app.quota import QuotaExceededError
+
+
+def setup_function(_fn):
+    ratelimit.reset()
+
+
+def test_rate_limit_exceeded_error_is_an_exception_subclass():
+    assert issubclass(RateLimitExceededError, Exception)
+
+
+def test_rate_limit_exceeded_error_subclasses_quota_exceeded_error():
+    assert issubclass(RateLimitExceededError, QuotaExceededError)
+
+
+def test_check_and_increment_counts_up_then_raises_on_the_fourth_call():
+    assert ratelimit.check_and_increment("k", 3) == 1
+    assert ratelimit.check_and_increment("k", 3) == 2
+    assert ratelimit.check_and_increment("k", 3) == 3
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("k", 3)
+
+
+def test_check_and_increment_exceeded_message_contains_key_and_limit():
+    ratelimit.check_and_increment("k", 2)
+    ratelimit.check_and_increment("k", 2)
+    with pytest.raises(RateLimitExceededError) as exc_info:
+        ratelimit.check_and_increment("k", 2)
+    message = str(exc_info.value)
+    assert "k" in message
+    assert "2" in message
+
+
+def test_check_and_increment_raises_the_subclass_catchable_both_ways():
+    ratelimit.check_and_increment("k", 1)
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("k", 1)
+
+    ratelimit.reset()
+    ratelimit.check_and_increment("k2", 1)
+    with pytest.raises(QuotaExceededError):
+        ratelimit.check_and_increment("k2", 1)
+
+
+def test_check_and_increment_counter_is_per_key():
+    ratelimit.check_and_increment("a", 2)
+    ratelimit.check_and_increment("b", 2)
+    ratelimit.check_and_increment("a", 2)
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("a", 2)
+    # "b" is untouched by "a" exhausting its quota
+    assert ratelimit.check_and_increment("b", 2) == 2
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("b", 2)
+
+
+def test_reset_clears_all_keys_counters_not_just_one():
+    ratelimit.check_and_increment("a", 1)
+    ratelimit.check_and_increment("b", 1)
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("a", 1) == 1
+    assert ratelimit.check_and_increment("b", 1) == 1
+
+
+def test_reset_also_resets_the_quota_clock():
+    ratelimit.check_and_increment("k", 1)
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.check_and_increment("k", 1)
+    quota.advance(50)
+    ratelimit.reset()
+    assert quota.now() == 0.0
+    assert ratelimit.check_and_increment("k", 1) == 1
+
+
+def test_dispatch_hook_get_never_raises_and_never_increments():
+    config = {"rate_limit_max_per_window": 3, "rate_limit_window_seconds": 60}
+    for _ in range(config["rate_limit_max_per_window"] + 5):
+        ratelimit.dispatch_hook(None, config, "GET", "/records", {})
+    # GET calls never touched the counter -- the key dispatch_hook would
+    # use internally for a POST with no "actor" kwarg is "anonymous", and
+    # it must still start fresh at 1.
+    assert ratelimit.check_and_increment(
+        "anonymous", config["rate_limit_max_per_window"]
+    ) == 1
+
+
+def test_dispatch_hook_post_key_defaults_to_anonymous_and_is_shared():
+    config = {"rate_limit_max_per_window": 5, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    # both prior calls shared the "anonymous" counter -> next hit is 3rd
+    assert ratelimit.check_and_increment("anonymous", 5) == 3
+
+
+def test_dispatch_hook_post_key_actor_is_separate_from_anonymous():
+    config = {"rate_limit_max_per_window": 5, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+    assert ratelimit.check_and_increment("anonymous", 5) == 2
+    assert ratelimit.check_and_increment("x", 5) == 2
+
+
+def test_dispatch_hook_reads_limit_from_config():
+    config_limit_1 = {
+        "rate_limit_max_per_window": 1,
+        "rate_limit_window_seconds": 60,
+    }
+    ratelimit.dispatch_hook(None, config_limit_1, "POST", "/records", {"actor": "p"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(
+            None, config_limit_1, "POST", "/records", {"actor": "p"}
+        )
+
+    quota.reset()
+    config_limit_2 = {
+        "rate_limit_max_per_window": 2,
+        "rate_limit_window_seconds": 60,
+    }
+    ratelimit.dispatch_hook(None, config_limit_2, "POST", "/records", {"actor": "q"})
+    ratelimit.dispatch_hook(None, config_limit_2, "POST", "/records", {"actor": "q"})
+
+
+def test_check_and_increment_delegates_to_quota_take(monkeypatch):
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", recorder)
+    ratelimit.check_and_increment("k", 3)
+    assert calls == [(("k", 3, float("inf")), {"burst": 0})]
+
+
+def test_dispatch_hook_windowed_end_to_end():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(61)
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+
+def test_dispatch_hook_burst_end_to_end():
+    config = {
+        "rate_limit_max_per_window": 1,
+        "rate_limit_burst": 1,
+        "rate_limit_window_seconds": 60,
+    }
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+
+def test_dispatch_hook_burst_defaults_to_zero_when_config_key_absent():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
