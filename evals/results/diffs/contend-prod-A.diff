@@ -0,0 +1,54 @@
+"""Tests for the column-model toolkit in app/tabular.py."""
+from app.tabular import columns, cell, escape_csv, widths
+
+
+def test_columns_empty():
+    assert columns([]) == []
+
+
+def test_columns_sorted_union_of_differing_keys():
+    records = [{"b": 1, "a": 2}, {"c": 3}]
+    assert columns(records) == ["a", "b", "c"]
+
+
+def test_cell_none_is_empty_string():
+    assert cell(None) == ""
+
+
+def test_cell_int_has_no_dot_zero_suffix():
+    assert cell(3) == "3"
+
+
+def test_cell_float():
+    assert cell(3.5) == "3.5"
+
+
+def test_cell_string():
+    assert cell("x") == "x"
+
+
+def test_escape_csv_plain_is_unquoted():
+    assert escape_csv("plain") == "plain"
+
+
+def test_escape_csv_comma_is_quoted():
+    assert escape_csv("a,b") == '"a,b"'
+
+
+def test_escape_csv_inner_quotes_doubled_and_wrapped():
+    assert escape_csv('say "hi"') == '"say ""hi"""'
+
+
+def test_escape_csv_newline_is_quoted():
+    assert escape_csv("line1\nline2") == '"line1\nline2"'
+
+
+def test_escape_csv_empty_stays_unquoted():
+    assert escape_csv("") == ""
+
+
+def test_widths_max_of_header_and_cell():
+    # column "a": header len 1, widest cell "xx" len 2 -> 2
+    # column "bbbb": header len 4, widest cell "y" len 1 -> 4
+    records = [{"a": "xx", "bbbb": "y"}]
+    assert widths(records, ["a", "bbbb"]) == {"a": 2, "bbbb": 4}
