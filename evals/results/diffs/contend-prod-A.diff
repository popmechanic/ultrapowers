diff --git a/app/schema.py b/app/schema.py
new file mode 100644
index 0000000..d51a37a
--- /dev/null
+++ b/app/schema.py
@@ -0,0 +1,47 @@
+"""Declarative error catalog + primitive validators.
+
+This module owns every validation error *message* (via ERROR_CATALOG /
+format_error) and the low-level value predicates (is_valid_amount,
+is_non_empty_str, check_required). It has no knowledge of "records" or
+config — app/validation.py builds the record-shaped validation rules on
+top of these primitives.
+"""
+import math
+
+
+ERROR_CATALOG = {
+    "missing": "missing field: {field}",
+    "numeric": "field {field} must be numeric (got {got})",
+    "non_negative": "field {field} must be non-negative",
+    "max": "field {field} exceeds max_amount {limit}",
+    "non_empty": "field {field} must be a non-empty string",
+}
+
+
+def format_error(code, **kwargs):
+    """Render the error message for `code` from ERROR_CATALOG. Raises
+    KeyError for an unknown code — never a silent fallback message."""
+    template = ERROR_CATALOG[code]
+    return template.format(**kwargs)
+
+
+def check_required(fields, required_fields):
+    """Return the subset of `required_fields` absent from `fields`, in
+    required_fields order (not dict order)."""
+    return [name for name in required_fields if name not in fields]
+
+
+def is_valid_amount(value):
+    """True for a non-bool int/float that is finite (no NaN/inf)."""
+    if isinstance(value, bool):
+        return False
+    if not isinstance(value, (int, float)):
+        return False
+    return math.isfinite(value)
+
+
+def is_non_empty_str(value):
+    """True for a str with non-whitespace content."""
+    if not isinstance(value, str):
+        return False
+    return value.strip() != ""
diff --git a/app/tabular.py b/app/tabular.py
new file mode 100644
index 0000000..9215b6b
--- /dev/null
+++ b/app/tabular.py
@@ -0,0 +1,42 @@
+"""Column-model toolkit shared by every export/report formatter.
+
+`app/export.py` builds its CSV and Markdown renderers on top of these
+primitives so the column-union and cell-stringification logic lives in
+exactly one place.
+"""
+
+
+def columns(records):
+    """Return the sorted union of every key across all records."""
+    keys = set()
+    for r in records:
+        keys.update(r.keys())
+    return sorted(keys)
+
+
+def cell(value):
+    """Render a single value as display text: "" for None, else str()."""
+    if value is None:
+        return ""
+    return str(value)
+
+
+def escape_csv(text):
+    """Escape a cell for CSV: quote (and double inner quotes) only when the
+    text contains a comma, a quote, or a newline. Plain text is returned
+    unquoted, including the empty string."""
+    if any(ch in text for ch in (",", "\"", "\n")):
+        return "\"" + text.replace("\"", "\"\"") + "\""
+    return text
+
+
+def widths(records, cols):
+    """Return {column: max(len(header), max cell width)} for the given
+    columns across all records."""
+    result = {}
+    for col in cols:
+        best = len(col)
+        for r in records:
+            best = max(best, len(cell(r.get(col))))
+        result[col] = best
+    return result
diff --git a/app/validation.py b/app/validation.py
new file mode 100644
index 0000000..dabf78d
--- /dev/null
+++ b/app/validation.py
@@ -0,0 +1,72 @@
+"""Record-shaped validation built on top of app/schema.py's primitives.
+
+validate_fields is the pure validation rule; pre_create_hook adapts it to
+the PRE_CREATE_HOOKS contract in app/registry.py (fn(store, config,
+fields) -> fields).
+
+No error-message string literals live in this module — every message is
+built by schema.format_error, so the wording stays centralized in
+schema.ERROR_CATALOG.
+"""
+from app import schema
+
+
+class ValidationError(Exception):
+    """Raised when a record's fields fail validation."""
+
+
+def validate_fields(fields, required_fields, max_amount):
+    """Validate `fields` against `required_fields` and `max_amount`.
+
+    - Every name in `required_fields` must be present in `fields` (checked
+      first, in required_fields order).
+    - `amount`, if present, must be a valid (non-bool, finite) number,
+      non-negative, and at most `max_amount`.
+    - `name`, if present, must be a non-empty string; it is returned
+      stripped of leading/trailing whitespace.
+
+    Returns a new dict (a shallow copy of `fields`) with `name` stripped;
+    the input dict is never mutated. Raises ValidationError on the first
+    failure encountered.
+    """
+    missing = schema.check_required(fields, required_fields)
+    if missing:
+        raise ValidationError(schema.format_error("missing", field=missing[0]))
+
+    result = dict(fields)
+
+    if "amount" in result:
+        amount = result["amount"]
+        if not schema.is_valid_amount(amount):
+            raise ValidationError(
+                schema.format_error(
+                    "numeric", field="amount", got=type(amount).__name__
+                )
+            )
+        if amount < 0:
+            raise ValidationError(
+                schema.format_error("non_negative", field="amount")
+            )
+        if amount > max_amount:
+            raise ValidationError(
+                schema.format_error("max", field="amount", limit=max_amount)
+            )
+
+    if "name" in result:
+        name = result["name"]
+        if not schema.is_non_empty_str(name):
+            raise ValidationError(
+                schema.format_error("non_empty", field="name")
+            )
+        result["name"] = name.strip()
+
+    return result
+
+
+def pre_create_hook(store, config, fields):
+    """PRE_CREATE_HOOKS entry point: validate `fields` per `config`."""
+    return validate_fields(
+        fields,
+        config["validation_required_fields"],
+        config["validation_max_amount"],
+    )
