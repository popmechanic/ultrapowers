@@ -0,0 +1,104 @@
+"""Tests for app/throttle.py — the policy layer over app/quota.py."""
+import pytest
+
+from app import quota, throttle
+
+
+ONE_PER_WINDOW = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+
+
+@pytest.fixture(autouse=True)
+def _clean_quota_state():
+    """Leave no module-global quota state behind for later test files."""
+    yield
+    quota.reset()
+
+
+def test_policy_error_is_an_exception_subclass():
+    quota.reset()
+    assert issubclass(throttle.PolicyError, Exception)
+
+
+def test_policies_constant_is_pinned():
+    quota.reset()
+    assert throttle.POLICIES == {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+
+
+def test_match_policy_picks_the_longest_matching_prefix():
+    quota.reset()
+    assert throttle.match_policy("GET", "/export/full", throttle.POLICIES) == \
+        throttle.POLICIES["GET /export"]
+
+    longer = dict(throttle.POLICIES)
+    longer["GET /export/full"] = {"limit": 1, "window": 5, "burst": 0}
+    assert throttle.match_policy("GET", "/export/full", longer) == \
+        longer["GET /export/full"]
+
+    assert throttle.match_policy("POST", "/export", throttle.POLICIES) is None
+
+
+def test_key_for_renders_method_path_and_actor():
+    quota.reset()
+    assert throttle.key_for("POST", "/records", "mallory") == \
+        "POST /records:mallory"
+
+
+def test_enforce_delegates_to_quota_take_and_ignores_unmatched_routes(monkeypatch):
+    quota.reset()
+    assert throttle.enforce("DELETE", "/records", "a", throttle.POLICIES) is None
+    assert quota.take("DELETE /records:a", 1, 60) == 1
+
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", recorder)
+    assert throttle.enforce("GET", "/export/full", "mallory",
+                            throttle.POLICIES) == 1
+    assert calls == [(("GET /export/full:mallory", 10, 60), {"burst": 2})]
+
+
+def test_enforce_raises_policy_error_when_the_policy_is_exhausted():
+    quota.reset()
+    assert throttle.enforce("POST", "/records", "mallory", ONE_PER_WINDOW) == 1
+    with pytest.raises(throttle.PolicyError) as err:
+        throttle.enforce("POST", "/records", "mallory", ONE_PER_WINDOW)
+    assert "POST /records:mallory" in str(err.value)
+    assert "1" in str(err.value)
+    assert isinstance(err.value.__cause__, quota.QuotaExceededError)
+
+
+def test_remaining_for_is_read_only_and_none_without_a_policy():
+    quota.reset()
+    assert throttle.remaining_for("DELETE", "/records", "a",
+                                  throttle.POLICIES) is None
+    assert throttle.remaining_for("POST", "/records", "mallory",
+                                  ONE_PER_WINDOW) == 1
+    assert throttle.remaining_for("POST", "/records", "mallory",
+                                  ONE_PER_WINDOW) == 1
+    assert throttle.enforce("POST", "/records", "mallory", ONE_PER_WINDOW) == 1
+    assert throttle.remaining_for("POST", "/records", "mallory",
+                                  ONE_PER_WINDOW) == 0
+
+
+def test_describe_policies_renders_sorted_lines():
+    quota.reset()
+    assert throttle.describe_policies(throttle.POLICIES) == (
+        "GET /export: limit=10, window=60, burst=2\n"
+        "POST /records: limit=5, window=60, burst=0"
+    )
+    assert throttle.describe_policies({}) == "(no policies)"
+
+
+def test_enforce_end_to_end_recovers_after_the_window():
+    quota.reset()
+    assert throttle.enforce("POST", "/records", "mallory", ONE_PER_WINDOW) == 1
+    with pytest.raises(throttle.PolicyError):
+        throttle.enforce("POST", "/records", "mallory", ONE_PER_WINDOW)
+    quota.advance(61)
+    assert throttle.enforce("POST", "/records", "mallory", ONE_PER_WINDOW) == 1
diff --git a/tests/test_validation.py b/tests/test_validation.py
