+++ b/tests/test_export.py
@@ -0,0 +1,110 @@
+"""Tests for the export formatters in app/export.py."""
+import json
+
+import pytest
+
+from app import export
+
+
+def test_to_csv_empty_list_no_header_row():
+    assert export.to_csv([]) == ""
+
+
+def test_to_csv_sorted_header_missing_fields_as_empty_cells():
+    records = [{"name": "a", "amount": 3}, {"name": "b"}]
+    assert export.to_csv(records) == "amount,name\n3,a\n,b"
+
+
+def test_to_csv_int_amount_has_no_dot_zero_suffix():
+    assert export.to_csv([{"amount": 5}]) == "amount\n5"
+
+
+def test_to_csv_single_record_n1():
+    assert export.to_csv([{"amount": 3.5}]) == "amount\n3.5"
+
+
+def test_to_json_empty_list():
+    assert export.to_json([]) == "[]"
+
+
+def test_to_json_round_trips_and_keys_sorted():
+    records = [{"b": 1, "a": 2}]
+    raw = export.to_json(records)
+    assert raw == '[{"a": 2, "b": 1}]'
+    assert json.loads(raw) == records
+
+
+def test_to_json_single_record_n1():
+    assert export.to_json([{"x": 1}]) == '[{"x": 1}]'
+
+
+def test_to_csv_comma_value_renders_as_one_quoted_cell():
+    assert export.to_csv([{"name": "a,b"}]) == 'name\n"a,b"'
+
+
+def test_to_csv_quote_value_doubles_inner_quotes():
+    assert export.to_csv([{"name": 'say "hi"'}]) == 'name\n"say ""hi"""'
+
+
+def test_to_csv_plain_record_byte_identical_to_unescaped_join():
+    records = [{"name": "plain", "amount": 3}]
+    assert export.to_csv(records) == "amount,name\n3,plain"
+
+
+def test_to_markdown_empty_list():
+    assert export.to_markdown([]) == ""
+
+
+def test_to_markdown_two_records_unequal_keys_exact_string():
+    records = [{"name": "alice", "amount": 10}, {"name": "bob"}]
+    expected = (
+        "| amount | name  |\n"
+        "| ------ | ----- |\n"
+        "| 10     | alice |\n"
+        "|        | bob   |"
+    )
+    assert export.to_markdown(records) == expected
+
+
+def test_to_markdown_single_record_n1():
+    assert export.to_markdown([{"x": 1}]) == "| x |\n| - |\n| 1 |"
+
+
+def test_to_ndjson_empty_list():
+    assert export.to_ndjson([]) == ""
+
+
+def test_to_ndjson_two_records_exact_string_and_round_trip():
+    records = [{"b": 1, "a": 2}, {"c": 3}]
+    raw = export.to_ndjson(records)
+    assert raw == '{"a": 2, "b": 1}\n{"c": 3}'
+    lines = raw.split("\n")
+    assert len(lines) == 2
+    assert json.loads(lines[0]) == {"a": 2, "b": 1}
+    assert json.loads(lines[1]) == {"c": 3}
+
+
+def test_to_ndjson_single_record_n1():
+    assert export.to_ndjson([{"x": 1}]) == '{"x": 1}'
+
+
+def test_formats_has_exactly_four_keys_mapped_correctly():
+    assert export.FORMATS == {
+        "csv": export.to_csv,
+        "json": export.to_json,
+        "md": export.to_markdown,
+        "ndjson": export.to_ndjson,
+    }
+
+
+def test_render_delegates_to_matching_function_for_all_formats():
+    records = [{"name": "alice", "amount": 10}, {"name": "bob"}]
+    assert export.render(records, "csv") == export.to_csv(records)
+    assert export.render(records, "json") == export.to_json(records)
+    assert export.render(records, "md") == export.to_markdown(records)
+    assert export.render(records, "ndjson") == export.to_ndjson(records)
+
+
+def test_render_unknown_format_raises_value_error_naming_it():
+    with pytest.raises(ValueError, match="xml"):
+        export.render([{"x": 1}], "xml")
diff --git a/tests/test_quota.py b/tests/test_quota.py
new file mode 100644
index 0000000..b126084
--- /dev/null
+++ b/tests/test_quota.py
@@ -0,0 +1,122 @@
+"""Tests for app/quota.py: the windowed hit counter with a logical clock.
+
+No wall time anywhere -- the clock only advances when a test calls
+advance() -- so these tests are fully deterministic. reset() is called at
+the start of every test to clear both the clock and all keys' hits.
+"""
+import pytest
+
+from app import quota
+from app.quota import QuotaExceededError
+
+
+def setup_function(_fn):
+    quota.reset()
+
+
+def test_quota_exceeded_error_is_an_exception_subclass():
+    assert issubclass(QuotaExceededError, Exception)
+
+
+def test_now_is_zero_after_reset():
+    assert quota.now() == 0.0
+
+
+def test_advance_returns_new_clock_and_now_agrees():
+    result = quota.advance(30)
+    assert result == 30.0
+    assert quota.now() == 30.0
+
+
+def test_advance_negative_raises_value_error_and_leaves_clock_unchanged():
+    quota.advance(10)
+    with pytest.raises(ValueError):
+        quota.advance(-1)
+    assert quota.now() == 10.0
+
+
+def test_take_returns_hit_count_then_raises_on_exceeding_limit():
+    assert quota.take("k", limit=2, window_seconds=60) == 1
+    assert quota.take("k", limit=2, window_seconds=60) == 2
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60)
+
+
+def test_take_exceeded_message_contains_key_and_limit():
+    quota.take("k", limit=2, window_seconds=60)
+    quota.take("k", limit=2, window_seconds=60)
+    with pytest.raises(QuotaExceededError) as exc_info:
+        quota.take("k", limit=2, window_seconds=60)
+    message = str(exc_info.value)
+    assert "k" in message
+    assert "2" in message
+
+
+def test_window_pruning_ages_out_old_hits_after_advance():
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(61)
+    assert quota.take("k", 2, 60) == 1
+
+
+def test_window_pruning_hit_still_counts_within_window():
+    quota.take("k", 2, 60)  # recorded at t=0
+    quota.advance(30)
+    quota.take("k", 2, 60)  # recorded at t=30
+    quota.advance(31)  # now = 61; first hit (t=0) ages out (61-60=1 > 0)
+    # only the t=30 hit remains in-window (61-30=31 <= 60)
+    assert quota.take("k", 2, 60) == 2
+
+
+def test_window_pruning_hit_ages_out_strictly_older_than_window():
+    quota.reset()
+    quota.take("k", 2, 60)  # recorded at t=0
+    quota.advance(30)
+    quota.take("k", 2, 60)  # recorded at t=30
+    quota.advance(61)  # now = 91; t=30 hit is 61 old > 60 window -> pruned
+    assert quota.take("k", 2, 60) == 1
+
+
+def test_infinite_window_never_prunes():
+    quota.take("k", limit=1, window_seconds=float("inf"))
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=1, window_seconds=float("inf"))
+    quota.advance(10**6)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=1, window_seconds=float("inf"))
+
+
+def test_burst_allows_extra_hits_before_raising():
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 1
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 2
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 3
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60, burst=1)
+
+
+def test_burst_defaults_to_zero():
+    quota.take("k", limit=1, window_seconds=60)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=1, window_seconds=60)
+
+
+def test_per_key_independence():
+    quota.take("a", limit=2, window_seconds=60)
+    quota.take("b", limit=2, window_seconds=60)
+    quota.take("a", limit=2, window_seconds=60)
+    with pytest.raises(QuotaExceededError):
+        quota.take("a", limit=2, window_seconds=60)
+    # "b" still has quota left, same clock and window
+    assert quota.take("b", limit=2, window_seconds=60) == 2
+    with pytest.raises(QuotaExceededError):
+        quota.take("b", limit=2, window_seconds=60)
+
+
+def test_reset_clears_clock_and_all_keys_hits():
+    quota.take("k", limit=1, window_seconds=60)
+    with pytest.raises(QuotaExceededError):
+        quota.take("k", limit=1, window_seconds=60)
+    quota.advance(50)
+    quota.reset()
+    assert quota.now() == 0.0
+    assert quota.take("k", limit=1, window_seconds=60) == 1
