@@ -0,0 +1,96 @@
+"""Tests for app/export.py: CSV/JSON export formatter."""
+import json
+
+import pytest
+
+from app import export
+
+
+def test_to_csv_empty_list_returns_empty_string():
+    assert export.to_csv([]) == ""
+
+
+def test_to_csv_header_sorted_and_rows_in_order_missing_field_empty_cell():
+    records = [
+        {"name": "b", "amount": 2},
+        {"name": "a", "category": "x"},
+    ]
+    result = export.to_csv(records)
+    lines = result.split("\r\n") if "\r\n" in result else result.split("\n")
+    # strip trailing blank line if present
+    lines = [l for l in lines if l != ""] if lines and lines[-1] == "" else lines
+    header = lines[0].split(",")
+    assert header == sorted(["name", "amount", "category"])
+    # row for first record: amount present, category missing -> empty cell
+    idx_name = header.index("name")
+    idx_amount = header.index("amount")
+    idx_category = header.index("category")
+    row1 = lines[1].split(",")
+    row2 = lines[2].split(",")
+    assert row1[idx_name] == "b"
+    assert row1[idx_amount] == "2"
+    assert row1[idx_category] == ""
+    assert row2[idx_name] == "a"
+    assert row2[idx_amount] == ""
+    assert row2[idx_category] == "x"
+
+
+def test_to_csv_renders_int_without_decimal_suffix():
+    records = [{"amount": 5}]
+    result = export.to_csv(records)
+    lines = [l for l in result.splitlines() if l != ""]
+    header = lines[0].split(",")
+    idx_amount = header.index("amount")
+    row1 = lines[1].split(",")
+    assert row1[idx_amount] == "5"
+    assert "5.0" not in result
+
+
+def test_to_json_empty_list_returns_empty_array_string():
+    assert export.to_json([]) == "[]"
+
+
+def test_to_json_round_trips_and_keys_sorted():
+    records = [
+        {"b": 1, "a": 2},
+        {"z": 3, "y": 4},
+    ]
+    result = export.to_json(records)
+    assert json.loads(result) == records
+    # keys sorted: raw string check
+    assert result.index('"a"') < result.index('"b"')
+    assert result.index('"y"') < result.index('"z"')
+
+
+def test_formats_dict_has_exactly_csv_and_json():
+    assert set(export.FORMATS.keys()) == {"csv", "json"}
+    assert export.FORMATS["csv"] is export.to_csv
+    assert export.FORMATS["json"] is export.to_json
+
+
+def test_render_delegates_to_csv_and_json():
+    records = [{"name": "a", "amount": 1}]
+    assert export.render(records, "csv") == export.to_csv(records)
+    assert export.render(records, "json") == export.to_json(records)
+
+
+def test_render_unknown_format_raises_value_error_naming_format():
+    with pytest.raises(ValueError) as exc_info:
+        export.render([], "xml")
+    assert "xml" in str(exc_info.value)
+
+
+def test_to_csv_single_record_list():
+    records = [{"name": "solo", "amount": 7}]
+    result = export.to_csv(records)
+    lines = [l for l in result.splitlines() if l != ""]
+    assert lines[0].split(",") == ["amount", "name"]
+    assert lines[1].split(",") == ["7", "solo"]
+    assert len(lines) == 2
+
+
+def test_to_json_single_record_list():
+    records = [{"name": "solo", "amount": 7}]
+    result = export.to_json(records)
+    assert json.loads(result) == records
+    assert result.index('"amount"') < result.index('"name"')
