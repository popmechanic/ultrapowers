+"""Tests for app/quota.py — the windowed counter over a logical clock."""
+import pytest
+
+from app import quota
+
+
+INF = float("inf")
+
+
+@pytest.fixture(autouse=True)
+def _clean_quota_state():
+    """Leave no module-global quota state behind for later test files."""
+    yield
+    quota.reset()
+
+
+def test_quota_exceeded_error_is_an_exception_subclass():
+    quota.reset()
+    assert issubclass(quota.QuotaExceededError, Exception)
+
+
+def test_logical_clock_starts_at_zero_advances_and_rejects_going_backwards():
+    quota.reset()
+    assert quota.now() == 0.0
+    assert quota.advance(30) == 30.0
+    assert quota.now() == 30.0
+    with pytest.raises(ValueError):
+        quota.advance(-1)
+    assert quota.now() == 30.0
+
+
+def test_take_counts_hits_then_raises_naming_the_key_and_the_limit():
+    quota.reset()
+    assert quota.take("k", limit=2, window_seconds=60) == 1
+    assert quota.take("k", limit=2, window_seconds=60) == 2
+    with pytest.raises(quota.QuotaExceededError) as err:
+        quota.take("k", limit=2, window_seconds=60)
+    assert "k" in str(err.value)
+    assert "2" in str(err.value)
+
+
+def test_hits_older_than_the_window_are_pruned():
+    quota.reset()
+    assert quota.take("k", 2, 60) == 1
+    assert quota.take("k", 2, 60) == 2
+    quota.advance(61)
+    assert quota.take("k", 2, 60) == 1
+
+    # A hit recorded at t=30 still counts at t=61 but not at t=91: pruning
+    # drops hits strictly older than now - window_seconds.
+    quota.reset()
+    quota.advance(30)
+    assert quota.take("mid", 1, 60) == 1
+    quota.advance(31)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("mid", 1, 60)
+    quota.advance(30)
+    assert quota.take("mid", 1, 60) == 1
+
+
+def test_infinite_window_never_prunes():
+    quota.reset()
+    assert quota.take("k", 1, INF) == 1
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 1, INF)
+    quota.advance(10 ** 6)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 1, INF)
+
+
+def test_burst_adds_headroom_and_defaults_to_zero():
+    quota.reset()
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 1
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 2
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 3
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60, burst=1)
+
+    quota.reset()
+    assert quota.take("d", limit=2, window_seconds=60) == 1
+    assert quota.take("d", limit=2, window_seconds=60) == 2
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("d", limit=2, window_seconds=60)
+
+
+def test_keys_are_independent():
+    quota.reset()
+    assert quota.take("a", 2, 60) == 1
+    assert quota.take("b", 2, 60) == 1
+    assert quota.take("a", 2, 60) == 2
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("a", 2, 60)
+    assert quota.take("b", 2, 60) == 2
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("b", 2, 60)
+
+
+def test_reset_clears_the_clock_and_every_key():
+    quota.reset()
+    quota.take("a", 1, 60)
+    quota.take("b", 1, 60)
+    quota.advance(5)
+    quota.reset()
+    assert quota.now() == 0.0
+    assert quota.take("a", 1, 60) == 1
+    assert quota.take("b", 1, 60) == 1
+
+
+def test_remaining_is_read_only_floors_at_zero_and_recovers():
+    quota.reset()
+    assert quota.remaining("k", 2, 60) == 2
+    assert quota.remaining("k", 2, 60) == 2
+    assert quota.take("k", 2, 60) == 1
+    assert quota.remaining("k", 2, 60) == 1
+    assert quota.remaining("k", 2, 60, burst=1) == 2
+    assert quota.take("k", 2, 60) == 2
+    assert quota.remaining("k", 2, 60) == 0
+    assert quota.remaining("k", 2, 60) == 0
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 2, 60)
+    quota.advance(61)
+    assert quota.remaining("k", 2, 60) == 2
+    assert quota.take("k", 2, 60) == 1
+
+
+def test_snapshot_lists_in_window_hits_per_key_and_is_a_deep_copy():
+    quota.reset()
+    quota.take("a", 5, 60)
+    quota.advance(30)
+    quota.take("a", 5, 60)
+    quota.take("b", 5, 60)
+    quota.advance(31)
+    quota.take("b", 5, 60)
+    assert quota.snapshot(60) == {"a": [30.0], "b": [30.0, 61.0]}
+
+    snap = quota.snapshot(60)
+    snap["a"].append(999.0)
+    assert quota.snapshot(60) == {"a": [30.0], "b": [30.0, 61.0]}
+    assert quota.remaining("a", 5, 60) == 4
+
+
+def test_time_to_next_slot_reports_seconds_until_a_slot_frees():
+    quota.reset()
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    assert quota.time_to_next_slot("k", 2, 60) == 60.0
+    quota.advance(10)
+    assert quota.time_to_next_slot("k", 2, 60) == 50.0
+
+    # Exhausted under an infinite window: never frees.
+    quota.reset()
+    quota.take("inf", 1, INF)
+    assert quota.time_to_next_slot("inf", 1, INF) == INF
+
+    # A zero allowance can never record a hit, so no slot ever frees —
+    # and it must not crash on an empty hit list.
+    quota.reset()
+    assert quota.time_to_next_slot("k", 0, 60) == INF
+
+    # Boundary: at exactly now - window the hit is still in-window, so the
+    # reading is 0.0 while the take still raises.
+    quota.reset()
+    quota.take("edge", 2, 60)
+    quota.take("edge", 2, 60)
+    quota.advance(60)
+    assert quota.time_to_next_slot("edge", 2, 60) == 0.0
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("edge", 2, 60)
+
+
+def test_usage_reports_the_full_state_and_records_nothing():
+    quota.reset()
+    assert quota.usage("k", 2, 60) == {
+        "used": 0, "allowed": 2, "remaining": 2, "reset_in": 0.0}
+    quota.take("k", 2, 60)
+    assert quota.usage("k", 2, 60) == {
+        "used": 1, "allowed": 2, "remaining": 1, "reset_in": 0.0}
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    assert quota.usage("k", 2, 60) == {
+        "used": 2, "allowed": 2, "remaining": 0, "reset_in": 50.0}
+    assert quota.usage("k", 2, 60, burst=1) == {
+        "used": 2, "allowed": 3, "remaining": 1, "reset_in": 0.0}
+    assert quota.take("k", 2, 60, burst=1) == 3
+
+
+def test_purge_drops_aged_out_hits_and_empty_keys_and_counts_them():
+    quota.reset()
+    quota.take("old", 5, 60)
+    quota.take("old", 5, 60)
+    quota.advance(30)
+    quota.take("new", 5, 60)
+    quota.advance(31)
+    assert quota.purge(60) == 2
+    assert quota.snapshot(60) == {"new": [30.0]}
+    assert quota.purge(60) == 0
