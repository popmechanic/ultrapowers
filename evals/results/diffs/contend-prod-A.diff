index 0000000..f35d590
--- /dev/null
+++ b/app/export.py
@@ -0,0 +1,48 @@
+"""CSV/JSON export formatter.
+
+Feature Task 2: registers `to_csv`/`to_json` into `EXPORT_FORMATS` (see
+app/registry.py) so the pre-wired `GET /export` route can serve either
+format. This module owns the rendering logic only; it does not touch the
+router or add any route.
+"""
+import json
+
+
+def to_csv(records):
+    """Render `records` (a list of dicts) as CSV text.
+
+    The header row is every field name that appears across ALL records,
+    sorted alphabetically. One row follows per record, in input order,
+    with a missing field on a given record rendered as an empty cell.
+    Non-string values are rendered via plain str(). An empty `records`
+    list renders as "" (no header row -- nothing to name)."""
+    if not records:
+        return ""
+    fields = set()
+    for record in records:
+        fields.update(record.keys())
+    header = sorted(fields)
+    lines = [",".join(header)]
+    for record in records:
+        row = [str(record[field]) if field in record else "" for field in header]
+        lines.append(",".join(row))
+    return "\n".join(lines)
+
+
+def to_json(records):
+    """Render `records` as a JSON array string, keys sorted."""
+    return json.dumps(records, sort_keys=True)
+
+
+FORMATS = {
+    "csv": to_csv,
+    "json": to_json,
+}
+
+
+def render(records, fmt):
+    """Render `records` using the named format. Raises ValueError naming
+    the unknown format if `fmt` is not in FORMATS."""
+    if fmt not in FORMATS:
+        raise ValueError("unknown export format: %s" % fmt)
+    return FORMATS[fmt](records)
diff --git a/app/ratelimit.py b/app/ratelimit.py
new file mode 100644
index 0000000..9bffb0e
--- /dev/null
+++ b/app/ratelimit.py
@@ -0,0 +1,48 @@
+"""Per-actor rate-limit/quota guard.
+
+This module counts calls per key (not wall-clock time) and raises once a
+key's count exceeds a configured limit within the current "window" — where
+a window is simply "since the last reset()", since no time-based rollover
+is wired up in this plan. `dispatch_hook` only guards writes (POST); reads
+(GET, and any other method) pass through untouched.
+"""
+
+_counts = {}
+
+
+class RateLimitExceededError(Exception):
+    """Raised when a key's call count exceeds its configured limit."""
+
+
+def reset():
+    """Clear ALL keys' counters."""
+    _counts.clear()
+
+
+def check_and_increment(key, limit):
+    """Increment the counter for `key` and return the new count.
+
+    Raises RateLimitExceededError if incrementing would push the count
+    past `limit`.
+    """
+    count = _counts.get(key, 0) + 1
+    if count > limit:
+        raise RateLimitExceededError(
+            "rate limit exceeded for key %r: limit is %s" % (key, limit)
+        )
+    _counts[key] = count
+    return count
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS-shaped hook: rate-limits POST calls per actor.
+
+    No-op for any method other than "POST". The key is
+    kwargs.get("actor", "anonymous"); the limit is
+    config["rate_limit_max_per_window"].
+    """
+    if method != "POST":
+        return
+    key = kwargs.get("actor", "anonymous")
+    limit = config["rate_limit_max_per_window"]
+    check_and_increment(key, limit)
