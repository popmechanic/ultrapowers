@@ -0,0 +1,212 @@
+"""Tests for app/validation.py — validate_fields + pre_create_hook."""
+import pytest
+
+from app import schema, validation
+
+
+REQUIRED = ["name", "amount"]
+MAX_AMOUNT = 100
+
+
+def test_validation_error_is_an_exception_subclass():
+    assert issubclass(validation.ValidationError, Exception)
+
+
+def test_missing_name_raises_with_field_named():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"amount": 1}, REQUIRED, MAX_AMOUNT)
+    assert str(exc.value) == "missing field: name"
+
+
+def test_missing_amount_raises_with_field_named():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"name": "x"}, REQUIRED, MAX_AMOUNT)
+    assert str(exc.value) == "missing field: amount"
+
+
+def test_both_missing_names_name_first():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({}, REQUIRED, MAX_AMOUNT)
+    assert str(exc.value) == "missing field: name"
+
+
+def test_amount_as_string_raises_numeric():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"name": "x", "amount": "3"}, REQUIRED, MAX_AMOUNT)
+    assert "numeric" in str(exc.value)
+
+
+def test_amount_as_bool_raises_numeric():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"name": "x", "amount": True}, REQUIRED, MAX_AMOUNT)
+    assert "numeric" in str(exc.value)
+    with pytest.raises(validation.ValidationError) as exc2:
+        validation.validate_fields({"name": "x", "amount": False}, REQUIRED, MAX_AMOUNT)
+    assert "numeric" in str(exc2.value)
+
+
+def test_negative_amount_raises_non_negative():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"name": "x", "amount": -1}, REQUIRED, MAX_AMOUNT)
+    assert "non-negative" in str(exc.value)
+
+
+def test_zero_amount_is_accepted():
+    result = validation.validate_fields({"name": "x", "amount": 0}, REQUIRED, MAX_AMOUNT)
+    assert result["amount"] == 0
+
+
+def test_amount_over_max_raises_and_amount_equal_max_is_accepted():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields(
+            {"name": "x", "amount": MAX_AMOUNT + 1}, REQUIRED, MAX_AMOUNT
+        )
+    assert "max_amount" in str(exc.value)
+    result = validation.validate_fields(
+        {"name": "x", "amount": MAX_AMOUNT}, REQUIRED, MAX_AMOUNT
+    )
+    assert result["amount"] == MAX_AMOUNT
+
+
+def test_bad_name_raises_non_empty_string():
+    for bad_name in ("", "   ", 42):
+        with pytest.raises(validation.ValidationError) as exc:
+            validation.validate_fields(
+                {"name": bad_name, "amount": 1}, REQUIRED, MAX_AMOUNT
+            )
+        assert "non-empty string" in str(exc.value)
+
+
+def test_success_returns_new_dict_with_stripped_name_and_input_unmodified():
+    fields = {"name": "  bob  ", "amount": 5, "extra": "keep"}
+    result = validation.validate_fields(fields, REQUIRED, MAX_AMOUNT)
+    assert result is not fields
+    assert result["name"] == "bob"
+    assert result["amount"] == 5
+    assert result["extra"] == "keep"
+    assert fields["name"] == "  bob  "
+
+
+def test_extra_keys_pass_validation_untouched():
+    fields = {"name": "x", "amount": 1, "note": "hello", "tags": ["a"]}
+    result = validation.validate_fields(fields, REQUIRED, MAX_AMOUNT)
+    assert result["note"] == "hello"
+    assert result["tags"] == ["a"]
+
+
+def test_pre_create_hook_delegates_to_validate_fields_consistently():
+    config = {"validation_required_fields": REQUIRED, "validation_max_amount": MAX_AMOUNT}
+    good = {"name": "x", "amount": 1}
+    assert validation.pre_create_hook(None, config, good) == validation.validate_fields(
+        good, REQUIRED, MAX_AMOUNT
+    )
+    bad = {"amount": 1}
+    with pytest.raises(validation.ValidationError):
+        validation.pre_create_hook(None, config, bad)
+    with pytest.raises(validation.ValidationError):
+        validation.validate_fields(bad, REQUIRED, MAX_AMOUNT)
+
+
+def test_exact_messages_delegate_to_schema_format_error():
+    assert (
+        str(_raises(lambda: validation.validate_fields({"amount": 1}, REQUIRED, MAX_AMOUNT)))
+        == "missing field: name"
+    )
+    assert (
+        str(
+            _raises(
+                lambda: validation.validate_fields(
+                    {"name": "x", "amount": True}, REQUIRED, MAX_AMOUNT
+                )
+            )
+        )
+        == "field amount must be numeric (got bool)"
+    )
+    assert (
+        str(
+            _raises(
+                lambda: validation.validate_fields(
+                    {"name": "x", "amount": -1}, REQUIRED, MAX_AMOUNT
+                )
+            )
+        )
+        == "field amount must be non-negative"
+    )
+    assert (
+        str(
+            _raises(
+                lambda: validation.validate_fields(
+                    {"name": "x", "amount": MAX_AMOUNT + 1}, REQUIRED, MAX_AMOUNT
+                )
+            )
+        )
+        == "field amount exceeds max_amount %s" % MAX_AMOUNT
+    )
+    assert (
+        str(
+            _raises(
+                lambda: validation.validate_fields(
+                    {"name": "", "amount": 1}, REQUIRED, MAX_AMOUNT
+                )
+            )
+        )
+        == "field name must be a non-empty string"
+    )
+
+
+def _raises(fn):
+    try:
+        fn()
+    except validation.ValidationError as e:
+        return e
+    raise AssertionError("expected ValidationError")
+
+
+def test_float_amounts_are_legal_including_boundary():
+    result = validation.validate_fields({"name": "x", "amount": 3.5}, REQUIRED, MAX_AMOUNT)
+    assert result["amount"] == 3.5
+    result2 = validation.validate_fields(
+        {"name": "x", "amount": float(MAX_AMOUNT)}, REQUIRED, MAX_AMOUNT
+    )
+    assert result2["amount"] == float(MAX_AMOUNT)
+
+
+@pytest.mark.parametrize("bad", [None, float("nan"), float("inf"), float("-inf")])
+def test_non_finite_or_none_amount_raises_numeric(bad):
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"name": "x", "amount": bad}, REQUIRED, MAX_AMOUNT)
+    assert "numeric" in str(exc.value)
+
+
+def test_name_internal_whitespace_preserved_and_non_ascii_accepted():
+    result = validation.validate_fields(
+        {"name": "  ada lovelace  ", "amount": 1}, REQUIRED, MAX_AMOUNT
+    )
+    assert result["name"] == "ada lovelace"
+    result2 = validation.validate_fields({"name": "Δ", "amount": 1}, REQUIRED, MAX_AMOUNT)
+    assert result2["name"] == "Δ"
+
+
+def test_empty_required_fields_with_empty_fields_passes():
+    assert validation.validate_fields({}, [], MAX_AMOUNT) == {}
+
+
+def test_max_amount_zero_boundary():
+    result = validation.validate_fields({"name": "x", "amount": 0}, REQUIRED, 0)
+    assert result["amount"] == 0
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"name": "x", "amount": 1}, REQUIRED, 0)
+    assert "max_amount" in str(exc.value)
+
+
+def test_returned_dict_is_shallow_copy():
+    fields = {"name": "x", "amount": 1, "tags": [1, 2]}
+    result = validation.validate_fields(fields, REQUIRED, MAX_AMOUNT)
+    assert result["tags"] is fields["tags"]
+
+
+def test_delegation_to_schema_is_real_not_reimplemented(monkeypatch):
+    monkeypatch.setattr(schema, "is_valid_amount", lambda v: False)
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"name": "x", "amount": 5}, REQUIRED, MAX_AMOUNT)
+    assert "numeric" in str(exc.value)
