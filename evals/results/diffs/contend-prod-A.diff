index 0000000..b4074b2
--- /dev/null
+++ b/app/quota.py
@@ -0,0 +1,62 @@
+"""Windowed hit counter driven by a module-global logical clock.
+
+No wall time anywhere: the clock only moves when a caller calls
+`advance()`. This keeps callers (and their tests) fully deterministic.
+State is two module globals -- the clock and a per-key hit-timestamp
+store -- both cleared together by `reset()`.
+"""
+
+
+class QuotaExceededError(Exception):
+    """Raised by `take()` when a key has no room left in its window."""
+
+
+_clock = 0.0
+_hits = {}
+
+
+def reset():
+    """Clear the logical clock back to 0.0 and forget every key's hits."""
+    global _clock, _hits
+    _clock = 0.0
+    _hits = {}
+
+
+def now():
+    """Return the current logical clock value."""
+    return _clock
+
+
+def advance(seconds):
+    """Move the logical clock forward by `seconds` and return the new
+    value. The clock is monotonic: a negative `seconds` raises
+    ValueError and leaves the clock unchanged."""
+    global _clock
+    if seconds < 0:
+        raise ValueError(
+            "clock is monotonic; cannot advance by a negative amount: %r"
+            % (seconds,)
+        )
+    _clock += seconds
+    return _clock
+
+
+def take(key, limit, window_seconds, burst=0):
+    """Record a hit for `key` at the current logical clock time, after
+    pruning hits strictly older than `now() - window_seconds` (unless
+    `window_seconds` is infinite, in which case nothing is ever pruned).
+
+    Returns the in-window hit count (including the one just recorded) if
+    it fits within `limit + burst`; otherwise raises QuotaExceededError
+    without recording the hit."""
+    hits = _hits.setdefault(key, [])
+    if window_seconds != float("inf"):
+        cutoff = _clock - window_seconds
+        hits[:] = [h for h in hits if h > cutoff]
+    effective_limit = limit + burst
+    if len(hits) >= effective_limit:
+        raise QuotaExceededError(
+            "quota exceeded for key %r: limit %s" % (key, limit)
+        )
+    hits.append(_clock)
+    return len(hits)
diff --git a/app/ratelimit.py b/app/ratelimit.py
new file mode 100644
index 0000000..298196d
--- /dev/null
+++ b/app/ratelimit.py
@@ -0,0 +1,43 @@
+"""Per-actor rate limiting on top of app/quota.py's windowed counter.
+
+ratelimit keeps no counter state of its own: every hit is recorded in
+quota's module globals via `quota.take`, and `reset()` here simply
+delegates to `quota.reset()`. This module's only job is to translate
+rate-limit vocabulary (a key + a limit) into quota vocabulary (a key +
+a limit + a window + a burst allowance), and to wire itself in as a
+DISPATCH_HOOK that guards writes (POST) without touching reads.
+"""
+from app import quota
+
+
+class RateLimitExceededError(quota.QuotaExceededError):
+    """Raised when a key has exceeded its rate limit."""
+
+
+def reset():
+    """Clear all keys' counters (and the underlying quota clock)."""
+    quota.reset()
+
+
+def check_and_increment(key, limit, window_seconds=float("inf"), burst=0):
+    """Record a hit for `key` against `limit` (plus `burst` extra room)
+    within `window_seconds`. Returns the in-window hit count, or raises
+    RateLimitExceededError if the key is out of room."""
+    try:
+        return quota.take(key, limit, window_seconds, burst=burst)
+    except quota.QuotaExceededError as exc:
+        raise RateLimitExceededError(str(exc)) from exc
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS callable: rate-limits writes, not reads. A no-op
+    for any method other than "POST". The counted key is the caller's
+    "actor" (default "anonymous"); the limit, window, and burst come
+    from `config`."""
+    if method != "POST":
+        return
+    actor = kwargs.get("actor", "anonymous")
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config["rate_limit_window_seconds"]
+    burst = config.get("rate_limit_burst", 0)
+    check_and_increment(actor, limit, window_seconds, burst=burst)
