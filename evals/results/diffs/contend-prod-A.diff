index 0000000..805bb66
--- /dev/null
+++ b/app/audit.py
@@ -0,0 +1,98 @@
+"""Audit log of every dispatched call.
+
+`dispatch_hook` is the registry seam: it runs before every dispatch and
+records who called what. Unlike the rate-limit guard it never special-cases
+the method and never rejects a call — every dispatch is logged, always.
+(`audit_log_enabled` in DEFAULT_CONFIG is recorded for a future on/off
+switch and is deliberately not read here.)
+
+The log is module-global write-side state: a bounded list of entries, each
+exactly `{"method": ..., "path": ..., "actor": ...}`, never the record
+fields a create was called with. The cap is enforced after every single
+append — the log is never allowed to grow past it, not even transiently —
+and each eviction bumps the `dropped()` counter.
+
+Reading is somebody else's job: `app/audit_query.py` is a pure module over
+plain entry lists and imports nothing from here.
+"""
+
+ANONYMOUS_ACTOR = "anonymous"
+
+_log = []
+_dropped = 0
+
+
+def clear():
+    """Empty the log and reset the dropped counter."""
+    global _dropped
+    del _log[:]
+    _dropped = 0
+
+
+def entries():
+    """Every logged entry in call order, as a copy: neither the returned
+    list nor the dicts in it are the live log's."""
+    return [dict(entry) for entry in _log]
+
+
+def dropped():
+    """How many entries the cap has evicted since the last `clear()`."""
+    return _dropped
+
+
+def _enforce_cap(max_entries):
+    """Drop oldest-first until the log fits `max_entries`, counting each
+    eviction. Called after every append, never batched."""
+    global _dropped
+    while len(_log) > max_entries:
+        del _log[0]
+        _dropped += 1
+
+
+def record(method, path, actor, max_entries):
+    """Append one entry for `actor`'s `method` `path` call, then enforce
+    `max_entries` (oldest entries are evicted first). Returns None."""
+    _log.append({"method": method, "path": path, "actor": actor})
+    _enforce_cap(max_entries)
+    return None
+
+
+def record_many(triples, max_entries):
+    """Append each `(method, path, actor)` triple in order and return how
+    many were appended — always `len(triples)`, since an append that
+    immediately ages out under the cap still happened. The cap is enforced
+    after every append because each one goes through `record`."""
+    count = 0
+    for method, path, actor in triples:
+        record(method, path, actor, max_entries)
+        count += 1
+    return count
+
+
+def export_state():
+    """The whole log as a plain, detached dict: `{"entries": [...],
+    "dropped": n}`. Mutating it cannot reach the live log."""
+    return {"entries": entries(), "dropped": _dropped}
+
+
+def import_state(state):
+    """Replace the log and the dropped counter from an `export_state()`-
+    shaped dict, copying it in so later mutations of `state` do not leak
+    into the live log. Returns None."""
+    global _dropped
+    del _log[:]
+    _log.extend(dict(entry) for entry in state["entries"])
+    _dropped = state["dropped"]
+    return None
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """Registry dispatch hook: log every call, whatever its method.
+
+    The actor comes from `kwargs["actor"]`, defaulting to "anonymous" — all
+    unattributed callers share that name. Only the three audit fields are
+    kept; the rest of `kwargs` (a create's record fields, say) is never
+    copied into the log. The cap is `config["audit_log_max_entries"]`."""
+    record(method, path, kwargs.get("actor", ANONYMOUS_ACTOR),
+           config["audit_log_max_entries"])
+    return None
diff --git a/app/audit_query.py b/app/audit_query.py
new file mode 100644
index 0000000..7c608b0
--- /dev/null
+++ b/app/audit_query.py
@@ -0,0 +1,269 @@
+"""Pure read side over lists of audit entries.
+
+Every function here takes the entries as a plain list argument, never
+mutates that list or the dicts inside it, and returns fresh objects the
+caller may freely mutate. Nothing is imported from `app.audit`: this module
+holds no state and knows nothing about where the entries came from, so the
+same helpers serve a live log, an `export_state()` snapshot, or a fixture.
+
+An entry is `{"method": ..., "path": ..., "actor": ...}`; those three names
+in `FIELDS` are the only ones any field argument may name — anything else
+is a ValueError naming the offending field.
+
+The renderers (`to_report`, `to_csv_report`, `to_markdown_report`) all sort
+each section's values alphabetically and derive their numbers from
+`counts_by`, so no renderer ever re-counts entries itself.
+"""
+
+FIELDS = ("method", "path", "actor")
+
+REDACTED = "***"
+
+
+def _check_field(field):
+    """Raise ValueError naming `field` unless it is one of FIELDS."""
+    if field not in FIELDS:
+        raise ValueError("unknown audit field: %s" % field)
+    return field
+
+
+def _copies(entries):
+    """A new list of new dicts — the shape every function here returns."""
+    return [dict(entry) for entry in entries]
+
+
+def filter_entries(entries, actor=None, method=None, path=None):
+    """The entries matching every criterion given, in original order.
+
+    Criteria left as None are not applied, so no criteria at all matches
+    everything. The result is a fresh list of fresh entry dicts."""
+    criteria = [(name, value) for name, value in
+                (("actor", actor), ("method", method), ("path", path))
+                if value is not None]
+    return _copies(
+        entry for entry in entries
+        if all(entry.get(name) == value for name, value in criteria)
+    )
+
+
+def counts_by(entries, field):
+    """How many entries carry each distinct value of `field`."""
+    _check_field(field)
+    counts = {}
+    for entry in entries:
+        value = entry[field]
+        counts[value] = counts.get(value, 0) + 1
+    return counts
+
+
+def counts_matrix(entries):
+    """Counts nested method -> actor. Only pairs that occur appear; there
+    are no zero-filled cells."""
+    matrix = {}
+    for entry in entries:
+        by_actor = matrix.setdefault(entry["method"], {})
+        actor = entry["actor"]
+        by_actor[actor] = by_actor.get(actor, 0) + 1
+    return matrix
+
+
+def rollup(entries, fields):
+    """Counts nested by each name in `fields`, outermost first.
+
+    `fields` must be a non-empty list of distinct FIELDS names, so
+    `rollup(entries, ["method"])` is `counts_by(entries, "method")` and
+    `rollup(entries, ["method", "actor"])` is `counts_matrix(entries)`."""
+    if not fields:
+        raise ValueError("rollup needs at least one field")
+    seen = []
+    for field in fields:
+        _check_field(field)
+        if field in seen:
+            raise ValueError("duplicate audit field: %s" % field)
+        seen.append(field)
+
+    counts = {}
+    for entry in entries:
+        level = counts
+        for field in fields[:-1]:
+            level = level.setdefault(entry[field], {})
+        last = entry[fields[-1]]
+        level[last] = level.get(last, 0) + 1
+    return counts
+
+
+def last_n(entries, n):
+    """The final `n` entries in order, as copies. `n` past the end returns
+    them all; `n` of 0 returns []. A negative `n` is a ValueError."""
+    if n < 0:
+        raise ValueError("n must not be negative: %s" % n)
+    if n == 0:
+        return []
+    return _copies(entries[-n:])
+
+
+def redact(entries, fields):
+    """Copies of the entries with each named field replaced by "***".
+
+    The originals keep their real values; `fields` may be empty, which just
+    copies. Every name must be one of FIELDS."""
+    for field in fields:
+        _check_field(field)
+    redacted = _copies(entries)
+    for entry in redacted:
+        for field in fields:
+            entry[field] = REDACTED
+    return redacted
+
+
+def summary(entries):
+    """Totals, the method/actor breakdowns, and copies of the first and
+    last entries (both None when there are no entries)."""
+    return {
+        "total": len(entries),
+        "by_method": counts_by(entries, "method"),
+        "by_actor": counts_by(entries, "actor"),
+        "first": dict(entries[0]) if entries else None,
+        "last": dict(entries[-1]) if entries else None,
+    }
+
+
+def recent(entries, config):
+    """The last `config["audit_query_default_limit"]` entries."""
+    return last_n(entries, config["audit_query_default_limit"])
+
+
+def paginate(entries, page, per_page):
+    """One 1-based page of entries plus its metadata.
+
+    Returns `{"page", "pages", "total", "items"}`; a page past the end is
+    not an error, it just has no items. `page` and `per_page` must both be
+    at least 1."""
+    if page < 1:
+        raise ValueError("page must be at least 1: %s" % page)
+    if per_page < 1:
+        raise ValueError("per_page must be at least 1: %s" % per_page)
+    total = len(entries)
+    start = (page - 1) * per_page
+    return {
+        "page": page,
+        "pages": -(-total // per_page),
+        "total": total,
+        "items": _copies(entries[start:start + per_page]),
+    }
+
+
+def _count_lines(entries, field, template):
+    """One `template % (value, count)` line per distinct value of `field`,
+    sorted alphabetically by value."""
+    counts = counts_by(entries, field)
+    return [template % (value, counts[value]) for value in sorted(counts)]
+
+
+def to_report(entries):
+    """The plain-text report: a header, the total, then a "by method" and a
+    "by actor" section. A section with no counts is omitted entirely, so an
+    empty log renders as just the header and "total: 0"."""
+    lines = ["audit report", "total: %d" % len(entries)]
+    for field in ("method", "actor"):
+        section = _count_lines(entries, field, "  %s: %d")
+        if section:
+            lines.append("")
+            lines.append("by %s:" % field)
+            lines.extend(section)
+    return "\n".join(lines)
+
+
+def to_csv_report(entries):
+    """The counts as CSV: a `field,value,count` header, then the method
+    rows and the actor rows, each block sorted by value."""
+    lines = ["field,value,count"]
+    for field in ("method", "actor"):
+        lines.extend(_count_lines(entries, field, field + ",%s,%d"))
+    return "\n".join(lines)
+
+
+def to_markdown_report(entries):
+    """The same rows as `to_csv_report` as an unpadded Markdown table."""
+    lines = ["| field | value | count |", "| --- | --- | --- |"]
+    for field in ("method", "actor"):
+        lines.extend(
+            _count_lines(entries, field, "| " + field + " | %s | %d |"))
+    return "\n".join(lines)
+
+
+def top_actors(entries, n):
+    """The `n` busiest actors as `(actor, count)` pairs: most calls first,
+    ties broken by actor name ascending. A negative `n` is a ValueError."""
+    if n < 0:
+        raise ValueError("n must not be negative: %s" % n)
+    counts = counts_by(entries, "actor")
+    ranked = sorted(counts.items(), key=lambda pair: (-pair[1], pair[0]))
+    return ranked[:n]
+
+
+def merge_entries(*entry_lists):
+    """One new list concatenating every given list in argument order. The
+    entries are copies, so the sources stay untouched."""
+    merged = []
+    for entries in entry_lists:
+        merged.extend(_copies(entries))
+    return merged
+
+
+def _diff_counts(before, after):
+    """Value -> `after - before` for every value whose count changed; a
+    value missing from either side counts as 0. Unchanged values are
+    omitted entirely."""
+    diff = {}
+    for value in set(before) | set(after):
+        delta = after.get(value, 0) - before.get(value, 0)
+        if delta:
+            diff[value] = delta
+    return diff
+
+
+def diff_summaries(a, b):
+    """What changed from summary `a` to summary `b`: the total delta and,
+    per breakdown, only the values whose counts moved."""
+    return {
+        "total": b["total"] - a["total"],
+        "by_method": _diff_counts(a["by_method"], b["by_method"]),
+        "by_actor": _diff_counts(a["by_actor"], b["by_actor"]),
+    }
+
+
+def group_by(entries, field):
+    """Each distinct value of `field` mapped to copies of its entries, in
+    original order."""
+    _check_field(field)
+    groups = {}
+    for entry in entries:
+        groups.setdefault(entry[field], []).append(dict(entry))
+    return groups
+
+
+def search(entries, needle):
+    """Copies of the entries where `needle` is a substring of any of the
+    three field values, in original order. An empty needle is a ValueError
+    — it would match everything."""
+    if not needle:
+        raise ValueError("needle must not be empty")
+    return _copies(
+        entry for entry in entries
+        if any(needle in entry.get(field, "") for field in FIELDS)
+    )
+
+
+def format_entry(entry):
+    """One entry as `"<method> <path> (<actor>)"`, the method verb rendered
+    exactly as it was logged. A missing field is a ValueError naming it."""
+    for field in FIELDS:
+        if field not in entry:
+            raise ValueError("entry is missing field: %s" % field)
+    return "%s %s (%s)" % (entry["method"], entry["path"], entry["actor"])
+
+
+def to_lines(entries):
+    """`format_entry` for every entry, in order."""
+    return [format_entry(entry) for entry in entries]
diff --git a/app/export.py b/app/export.py
new file mode 100644
index 0000000..a092dfe
--- /dev/null
+++ b/app/export.py
@@ -0,0 +1,205 @@
+"""Machine-readable export formats for a list of records.
+
+Every format shares one column model: the sorted union of the keys across
+all records (`tabular.columns`), a missing field rendering as an empty
+cell. That model, the per-format escaping, and the padding all live in
+`app/tabular.py` — this module composes them and never re-derives a key
+union or re-implements an escape.
+
+`FORMATS` is the route-reachable table `app/registry.py` copies into
+`EXPORT_FORMATS`. `EXTRA_FORMATS` holds formats deliberately kept off that
+table (HTML), reachable only through `render_any` or a direct call.
+"""
+import json
+
+from app import tabular
+
+
+def _rows(records, cols, render_cell):
+    """Every record as a list of rendered cells, one per column, in input
+    order. `render_cell` is the per-format value renderer."""
+    return [[render_cell(record.get(col)) for col in cols]
+            for record in records]
+
+
+def to_csv(records):
+    """Render `records` as CSV: a sorted header row then one row per
+    record. An empty list has no columns, so it renders as ""."""
+    cols = tabular.columns(records)
+    if not cols:
+        return ""
+    lines = [",".join(tabular.escape_csv(col) for col in cols)]
+    for row in _rows(records, cols, tabular.escape_csv):
+        lines.append(",".join(row))
+    return "\n".join(lines)
+
+
+def to_json(records):
+    """Render `records` as a JSON array with each object's keys sorted."""
+    return json.dumps(list(records), sort_keys=True)
+
+
+def to_ndjson(records):
+    """Render `records` as newline-delimited JSON: one key-sorted object
+    per line, with no trailing newline."""
+    return "\n".join(json.dumps(record, sort_keys=True) for record in records)
+
+
+def _separator_cell(width, align):
+    """One markdown separator cell: dashes, ending in a colon when the
+    column is right-aligned. Always exactly `width` wide."""
+    if align == "right":
+        return "-" * (width - 1) + ":"
+    return "-" * width
+
+
+def to_markdown(records, align="left"):
+    """Render `records` as a padded pipe table.
+
+    Column widths come from `tabular.widths`, so every cell in a column is
+    padded to the same width. `align` is passed through to `tabular.pad`,
+    which is the only validator of it."""
+    cols = tabular.columns(records)
+    if not cols:
+        return ""
+    col_widths = tabular.widths(records, cols)
+    widths_list = [col_widths[col] for col in cols]
+    lines = [tabular.render_row(cols, widths_list, align)]
+    lines.append(tabular.render_row(
+        [_separator_cell(width, align) for width in widths_list],
+        widths_list, align))
+    for row in _rows(records, cols, tabular.cell):
+        lines.append(tabular.render_row(row, widths_list, align))
+    return "\n".join(lines)
+
+
+def to_tsv(records):
+    """Render `records` as tab-separated values. Column names and cells
+    alike go through `tabular.sanitize_flat`, so a tab or newline inside
+    either cannot break the grid."""
+    cols = tabular.columns(records)
+    if not cols:
+        return ""
+    lines = ["\t".join(tabular.sanitize_flat(col) for col in cols)]
+    for row in _rows(records, cols, tabular.sanitize_flat):
+        lines.append("\t".join(row))
+    return "\n".join(lines)
+
+
+def to_html(records):
+    """Render `records` as an HTML table, one element per line, with every
+    column name and cell escaped by `tabular.escape_html`."""
+    cols = tabular.columns(records)
+    if not cols:
+        return ""
+    lines = ["<table>"]
+    lines.append("<tr>" + "".join(
+        "<th>%s</th>" % tabular.escape_html(col) for col in cols) + "</tr>")
+    for row in _rows(records, cols, tabular.escape_html):
+        lines.append("<tr>" + "".join(
+            "<td>%s</td>" % value for value in row) + "</tr>")
+    lines.append("</table>")
+    return "\n".join(lines)
+
+
+def _parse_csv_rows(text):
+    """Split CSV text into rows of raw cells, honouring quoted cells.
+
+    Rows are newline-separated, so text ending in a newline yields a final
+    empty row — that is what makes `parse_csv("a\\n")` a header plus one
+    empty-cell row while `parse_csv("a")` is a header alone."""
+    rows = []
+    row = []
+    field = []
+    quoted = False
+    index = 0
+    while index < len(text):
+        char = text[index]
+        if quoted:
+            if char == '"':
+                if text[index + 1:index + 2] == '"':
+                    field.append('"')
+                    index += 2
+                    continue
+                quoted = False
+                index += 1
+                continue
+            field.append(char)
+            index += 1
+            continue
+        if char == '"' and not field:
+            quoted = True
+        elif char == ",":
+            row.append("".join(field))
+            field = []
+        elif char == "\n":
+            row.append("".join(field))
+            field = []
+            rows.append(row)
+            row = []
+        else:
+            field.append(char)
+        index += 1
+    if quoted:
+        raise ValueError("unterminated quoted cell in CSV input")
+    row.append("".join(field))
+    rows.append(row)
+    return rows
+
+
+def parse_csv(text):
+    """Parse CSV text back into a list of dicts — the inverse of `to_csv`.
+
+    The first row names the columns; every later row becomes one dict of
+    column name to cell. Cells stay strings: parsing never re-types a value,
+    so an exported `3` comes back as `"3"`. A row with fewer cells than the
+    header is filled out with empty cells."""
+    if not text:
+        return []
+    rows = _parse_csv_rows(text)
+    header = rows[0]
+    records = []
+    for row in rows[1:]:
+        values = row[:len(header)]
+        values += [""] * (len(header) - len(values))
+        records.append(dict(zip(header, values)))
+    return records
+
+
+def summary_line(records):
+    """A one-line description of what an export covers."""
+    return "%s records, %s columns" % (
+        len(records), len(tabular.columns(records)))
+
+
+FORMATS = {
+    "csv": to_csv,
+    "json": to_json,
+    "md": to_markdown,
+    "ndjson": to_ndjson,
+    "tsv": to_tsv,
+}
+
+# Formats deliberately kept out of FORMATS (and so out of the registry's
+# EXPORT_FORMATS): nothing route-reachable serves them.
+EXTRA_FORMATS = {
+    "html": to_html,
+}
+
+
+def render(records, fmt):
+    """Render `records` in one of the `FORMATS`. Anything else — including
+    an `EXTRA_FORMATS` name — is an unknown format."""
+    if fmt not in FORMATS:
+        raise ValueError("unknown export format: %s" % (fmt,))
+    return FORMATS[fmt](records)
+
+
+def render_any(records, fmt):
+    """Like `render`, but falls back to `EXTRA_FORMATS` for formats that
+    are not route-reachable."""
+    if fmt in FORMATS:
+        return FORMATS[fmt](records)
+    if fmt in EXTRA_FORMATS:
+        return EXTRA_FORMATS[fmt](records)
+    raise ValueError("unknown export format: %s" % (fmt,))
diff --git a/app/quota.py b/app/quota.py
