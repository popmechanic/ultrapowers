+"""Tests for app/ratelimit.py — the per-actor rate-limit guard."""
+import pytest
+
+from app import quota, ratelimit
+
+
+INF = float("inf")
+
+
+@pytest.fixture(autouse=True)
+def _clean_quota_state():
+    """Leave no module-global counter state behind for later test files."""
+    yield
+    ratelimit.reset()
+
+
+def test_rate_limit_exceeded_error_is_an_exception_subclass():
+    ratelimit.reset()
+    assert issubclass(ratelimit.RateLimitExceededError, Exception)
+
+
+def test_check_and_increment_counts_then_raises_naming_key_and_limit():
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("k", 3) == 1
+    assert ratelimit.check_and_increment("k", 3) == 2
+    assert ratelimit.check_and_increment("k", 3) == 3
+    with pytest.raises(ratelimit.RateLimitExceededError) as err:
+        ratelimit.check_and_increment("k", 3)
+    assert "k" in str(err.value)
+    assert "3" in str(err.value)
+
+
+def test_counters_are_per_key():
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("a", 2) == 1
+    assert ratelimit.check_and_increment("b", 2) == 1
+    assert ratelimit.check_and_increment("a", 2) == 2
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("a", 2)
+    assert ratelimit.check_and_increment("b", 2) == 2
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("b", 2)
+
+
+def test_reset_clears_all_keys():
+    ratelimit.reset()
+    ratelimit.check_and_increment("a", 1)
+    ratelimit.check_and_increment("b", 1)
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("a", 1) == 1
+    assert ratelimit.check_and_increment("b", 1) == 1
+
+
+def test_reset_also_resets_the_quota_clock():
+    ratelimit.reset()
+    ratelimit.check_and_increment("a", 1)
+    quota.advance(5)
+    ratelimit.reset()
+    assert quota.now() == 0.0
+    assert ratelimit.check_and_increment("a", 1) == 1
+
+
+def test_rate_limit_error_is_a_quota_error_subclass():
+    ratelimit.reset()
+    assert issubclass(ratelimit.RateLimitExceededError, quota.QuotaExceededError)
+    ratelimit.check_and_increment("k", 1)
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("k", 1)
+    with pytest.raises(quota.QuotaExceededError):
+        ratelimit.check_and_increment("k", 1)
+
+
+def test_check_and_increment_delegates_to_quota_take(monkeypatch):
+    ratelimit.reset()
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", recorder)
+    assert ratelimit.check_and_increment("k", 3) == 1
+    assert calls == [(("k", 3, INF), {"burst": 0})]
+
+
+def test_dispatch_hook_ignores_reads():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    for _ in range(config["rate_limit_max_per_window"] + 5):
+        assert ratelimit.dispatch_hook(None, config, "GET", "/records", {}) is None
+    assert ratelimit.check_and_increment("anonymous", 2) == 1
+
+
+def test_dispatch_hook_keys_off_the_actor_kwarg():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    # A named actor gets its own counter.
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+
+
+def test_dispatch_hook_reads_its_limit_from_config():
+    ratelimit.reset()
+    one = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    two = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, one, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, one, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, two, "POST", "/records", {"actor": "b"})
+    ratelimit.dispatch_hook(None, two, "POST", "/records", {"actor": "b"})
+
+
+def test_dispatch_hook_quota_recovers_after_the_window_passes():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(61)
+    assert ratelimit.dispatch_hook(
+        None, config, "POST", "/records", {"actor": "a"}) is None
+
+
+def test_dispatch_hook_works_with_a_limit_only_config():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 1}
+    assert ratelimit.dispatch_hook(None, config, "POST", "/records", {}) is None
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    # The default window is 60 seconds, so the hit ages out after it.
+    quota.advance(61)
+    assert ratelimit.dispatch_hook(None, config, "POST", "/records", {}) is None
+
+
+def test_dispatch_hook_reads_burst_from_config():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 1, "rate_limit_burst": 1,
+              "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    # No "rate_limit_burst" key behaves as burst 0.
+    no_burst = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, no_burst, "POST", "/records", {"actor": "b"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, no_burst, "POST", "/records", {"actor": "b"})
+
+
+def test_retry_after_delegates_to_time_to_next_slot(monkeypatch):
+    ratelimit.reset()
+    calls = []
+
+    def recorder(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 7.0
+
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60,
+              "rate_limit_burst": 1}
+    monkeypatch.setattr(quota, "time_to_next_slot", recorder)
+    assert ratelimit.retry_after("k", config) == 7.0
+    assert calls == [(("k", 2, 60), {"burst": 1})]
+
+
+def test_retry_after_reports_seconds_until_the_next_slot():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(10)
+    assert ratelimit.retry_after("a", config) == 50.0
+
+
+def test_limit_headers_render_string_values_and_record_nothing():
+    ratelimit.reset()
+    burst_config = {"rate_limit_max_per_window": 2, "rate_limit_burst": 1}
+    assert ratelimit.limit_headers("fresh", burst_config) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "3",
+        "X-RateLimit-Reset": "0.0",
+    }
+
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(10)
+    assert ratelimit.limit_headers("a", config) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "0",
+        "X-RateLimit-Reset": "50.0",
+    }
+    # Read-only: the untouched key still has its full allowance.
+    assert quota.take("fresh", 2, 60, burst=1) == 1
+
+
+def test_status_line_renders_the_usage_summary():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert ratelimit.status_line("mallory", config) == \
+        "mallory: 0/2, reset in 0.0s"
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "mallory"})
+    quota.advance(10)
+    assert ratelimit.status_line("mallory", config) == \
+        "mallory: 2/2, reset in 50.0s"
+    # Read-only: still exhausted, nothing recorded by the render.
+    assert quota.remaining("mallory", 2, 60) == 0
+
+
+def test_check_many_reports_who_would_pass_without_recording():
+    ratelimit.reset()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "b"})
+    for _ in range(2):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "c"})
+    assert ratelimit.check_many(["a", "b", "c"], config) == {
+        "a": True, "b": True, "c": False}
+    assert ratelimit.check_many(["a", "b", "c"], config) == {
+        "a": True, "b": True, "c": False}
+    # Nothing was recorded: each key behaves exactly as it did before.
+    assert quota.take("a", 2, 60) == 1
+    assert quota.take("b", 2, 60) == 2
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("c", 2, 60)
