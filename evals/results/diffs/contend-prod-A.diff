+"""Tests for app/validation.py — the input-validation layer."""
+import pytest
+
+from app import schema, validation
+
+
+REQUIRED = ["name", "amount"]
+
+
+def test_validation_error_is_an_exception_subclass():
+    assert issubclass(validation.ValidationError, Exception)
+
+
+def test_missing_required_fields_are_reported_in_required_fields_order():
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"amount": 1}, REQUIRED, 100)
+    assert "name" in str(err.value)
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a"}, REQUIRED, 100)
+    assert "amount" in str(err.value)
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({}, REQUIRED, 100)
+    assert str(err.value) == "missing field: name"
+
+
+def test_string_amount_is_not_numeric():
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a", "amount": "3"}, REQUIRED, 100)
+    assert "numeric" in str(err.value)
+
+
+def test_bool_amount_is_not_numeric():
+    for value in (True, False):
+        with pytest.raises(validation.ValidationError) as err:
+            validation.validate_fields({"name": "a", "amount": value},
+                                       REQUIRED, 100)
+        assert "numeric" in str(err.value)
+
+
+def test_negative_amount_is_rejected_and_zero_is_accepted():
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a", "amount": -1}, REQUIRED, 100)
+    assert "non-negative" in str(err.value)
+    assert validation.validate_fields({"name": "a", "amount": 0},
+                                      REQUIRED, 100) == {"name": "a",
+                                                         "amount": 0}
+
+
+def test_max_amount_boundary():
+    assert validation.validate_fields({"name": "a", "amount": 100},
+                                      REQUIRED, 100)["amount"] == 100
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a", "amount": 101}, REQUIRED, 100)
+    assert "max_amount" in str(err.value)
+
+
+def test_name_must_be_a_non_empty_string():
+    for bad in ("", "   ", 42):
+        with pytest.raises(validation.ValidationError) as err:
+            validation.validate_fields({"name": bad, "amount": 1},
+                                       REQUIRED, 100)
+        assert "non-empty string" in str(err.value)
+
+
+def test_success_returns_a_new_dict_with_name_stripped():
+    fields = {"name": "  ada  ", "amount": 5, "category": "c"}
+    result = validation.validate_fields(fields, REQUIRED, 100)
+    assert result == {"name": "ada", "amount": 5, "category": "c"}
+    assert result is not fields
+    assert fields == {"name": "  ada  ", "amount": 5, "category": "c"}
+
+
+def test_extra_keys_beyond_required_fields_pass_through():
+    fields = {"name": "a", "amount": 1, "extra": "kept", "n": 0}
+    assert validation.validate_fields(fields, REQUIRED, 100) == fields
+
+
+def test_pre_create_hook_reads_the_config_keys():
+    config = {"validation_required_fields": REQUIRED,
+              "validation_max_amount": 10}
+    fields = {"name": " a ", "amount": 10}
+    assert validation.pre_create_hook(None, config, fields) == (
+        validation.validate_fields(fields, REQUIRED, 10))
+    with pytest.raises(validation.ValidationError) as hook_err:
+        validation.pre_create_hook(None, config, {"name": "a", "amount": 11})
+    with pytest.raises(validation.ValidationError) as direct_err:
+        validation.validate_fields({"name": "a", "amount": 11}, REQUIRED, 10)
+    assert str(hook_err.value) == str(direct_err.value)
+
+
+def test_messages_come_from_the_shared_catalog():
+    def message(fields, max_amount=100):
+        with pytest.raises(validation.ValidationError) as err:
+            validation.validate_fields(fields, REQUIRED, max_amount)
+        return str(err.value)
+
+    assert message({"amount": 1}) == "missing field: name"
+    assert message({"name": "a", "amount": True}) == (
+        "field amount must be numeric (got bool)")
+    assert message({"name": "a", "amount": -1}) == (
+        "field amount must be non-negative")
+    assert message({"name": "a", "amount": 101}) == (
+        "field amount exceeds max_amount 100")
+    assert message({"name": "", "amount": 1}) == (
+        "field name must be a non-empty string")
+
+
+def test_float_amounts_are_legal_including_the_max_boundary():
+    assert validation.validate_fields({"name": "a", "amount": 3.5},
+                                      REQUIRED, 100)["amount"] == 3.5
+    assert validation.validate_fields({"name": "a", "amount": 100.0},
+                                      REQUIRED, 100.0)["amount"] == 100.0
+
+
+def test_none_and_non_finite_amounts_are_not_numeric():
+    for bad in (None, float("nan"), float("inf"), float("-inf")):
+        with pytest.raises(validation.ValidationError) as err:
+            validation.validate_fields({"name": "a", "amount": bad},
+                                       REQUIRED, 100)
+        assert "numeric" in str(err.value)
+
+
+def test_internal_whitespace_and_non_ascii_names_are_preserved():
+    assert validation.validate_fields({"name": "  ada lovelace  ",
+                                       "amount": 1}, REQUIRED, 100)["name"] == (
+        "ada lovelace")
+    assert validation.validate_fields({"name": "Δ", "amount": 1},
+                                      REQUIRED, 100)["name"] == "Δ"
+
+
+def test_no_required_fields_and_no_fields_passes():
+    assert validation.validate_fields({}, [], 100) == {}
+
+
+def test_max_amount_of_zero():
+    assert validation.validate_fields({"name": "a", "amount": 0},
+                                      REQUIRED, 0)["amount"] == 0
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a", "amount": 1}, REQUIRED, 0)
+    assert "max_amount" in str(err.value)
+
+
+def test_the_returned_dict_is_a_shallow_copy():
+    fields = {"name": "a", "amount": 1, "tags": [1, 2]}
+    result = validation.validate_fields(fields, REQUIRED, 100)
+    assert result["tags"] is fields["tags"]
+
+
+def test_validate_fields_delegates_to_schema_is_valid_amount(monkeypatch):
+    monkeypatch.setattr(schema, "is_valid_amount", lambda value: False)
+    with pytest.raises(validation.ValidationError) as err:
+        validation.validate_fields({"name": "a", "amount": 5}, REQUIRED, 100)
+    assert "numeric" in str(err.value)
+
+
+def test_validate_many_splits_successes_from_indexed_errors():
+    entries = [
+        {"name": " a ", "amount": 1},
+        {"name": "", "amount": 1},
+        {"name": "b", "amount": 2},
+        {"amount": 3},
+    ]
+    assert validation.validate_many(entries, REQUIRED, 100) == (
+        [{"name": "a", "amount": 1}, {"name": "b", "amount": 2}],
+        [(1, "field name must be a non-empty string"),
+         (3, "missing field: name")],
+    )
+    assert entries == [
+        {"name": " a ", "amount": 1},
+        {"name": "", "amount": 1},
+        {"name": "b", "amount": 2},
+        {"amount": 3},
+    ]
+
+
+def test_error_code_maps_each_catalog_message_back_to_its_code():
+    assert validation.error_code("missing field: name") == "missing"
+    assert validation.error_code(
+        "field amount must be numeric (got str)") == "numeric"
+    assert validation.error_code(
+        "field amount must be non-negative") == "non_negative"
+    assert validation.error_code(
+        "field amount exceeds max_amount 100") == "max"
+    assert validation.error_code(
+        "field name must be a non-empty string") == "non_empty"
+    assert validation.error_code("field name must be a string") == "type_str"
+
+
+def test_error_code_rejects_an_unmatchable_message():
+    with pytest.raises(ValueError):
+        validation.error_code("something else entirely")
+
+
+def test_error_code_follows_a_monkeypatched_catalog(monkeypatch):
+    monkeypatch.setitem(schema.ERROR_CATALOG, "missing", "no such field: {f}")
+    assert validation.error_code("no such field: name") == "missing"
+    with pytest.raises(ValueError):
+        validation.error_code("missing field: name")
+
+
+def test_explain_config_renders_the_configured_policy():
+    assert validation.explain_config({
+        "validation_required_fields": ["name", "amount"],
+        "validation_max_amount": 100000,
+    }) == (
+        "validation config:\n"
+        "  required: name, amount\n"
+        "  max_amount: 100000"
+    )
+    assert validation.explain_config({
+        "validation_required_fields": ["amount"],
+        "validation_max_amount": 5,
+    }) == (
+        "validation config:\n"
+        "  required: amount\n"
+        "  max_amount: 5"
+    )
