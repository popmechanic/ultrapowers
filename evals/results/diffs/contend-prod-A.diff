new file mode 100644
index 0000000..f082de5
--- /dev/null
+++ b/app/audit.py
@@ -0,0 +1,47 @@
+"""Audit log of every dispatched call.
+
+This module keeps an in-memory, append-only-with-a-cap log of every call
+that passes through `App.call`. `dispatch_hook` fires for EVERY method
+(unlike rate limiting, which only guards POST) and records only the
+method/path/actor triple — never the call's other kwargs (e.g. record
+fields), which must not leak into the audit trail.
+
+`audit_log_enabled` in DEFAULT_CONFIG is recorded for a future on/off
+switch and is not read by any code in this plan: `dispatch_hook` always
+logs.
+"""
+
+_log = []
+
+
+def clear():
+    """Clear the entire log."""
+    _log.clear()
+
+
+def entries():
+    """Return a copy of the log, oldest first."""
+    return list(_log)
+
+
+def record(method, path, actor, max_entries):
+    """Append one entry and enforce the cap immediately.
+
+    Drops the oldest entry/entries first if appending would exceed
+    `max_entries`.
+    """
+    _log.append({"method": method, "path": path, "actor": actor})
+    while len(_log) > max_entries:
+        _log.pop(0)
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS-shaped hook: logs every dispatched call.
+
+    Fires for every method (no method special-casing). The actor is
+    kwargs.get("actor", "anonymous"); the cap is
+    config["audit_log_max_entries"].
+    """
+    actor = kwargs.get("actor", "anonymous")
+    max_entries = config["audit_log_max_entries"]
+    record(method, path, actor, max_entries)
diff --git a/app/export.py b/app/export.py
