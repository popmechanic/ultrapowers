diff --git a/app/validation.py b/app/validation.py
new file mode 100644
index 0000000..d416dc4
--- /dev/null
+++ b/app/validation.py
@@ -0,0 +1,49 @@
+"""Input-validation layer for record creation.
+
+`validate_fields` checks a fields dict against a list of required field
+names and a max amount, then returns a new dict (never mutating the input)
+with `name` stripped of surrounding whitespace. `pre_create_hook` adapts
+`validate_fields` to the registry's PRE_CREATE_HOOKS signature, reading its
+required-fields list and max amount from `config`.
+"""
+
+
+class ValidationError(Exception):
+    """Raised when a fields dict fails validation."""
+
+
+def validate_fields(fields, required_fields, max_amount):
+    for field in required_fields:
+        if field not in fields:
+            raise ValidationError("missing field: %s" % field)
+
+    if "amount" in fields:
+        amount = fields["amount"]
+        # bool is an int subclass in Python, but True/False are not valid
+        # amounts, so this must be checked before the int check.
+        if isinstance(amount, bool) or not isinstance(amount, (int, float)):
+            raise ValidationError("amount must be numeric")
+        if amount < 0:
+            raise ValidationError("amount must be non-negative")
+        if amount > max_amount:
+            raise ValidationError(
+                "amount exceeds max_amount (%s)" % max_amount
+            )
+
+    if "name" in fields:
+        name = fields["name"]
+        if not isinstance(name, str) or not name.strip():
+            raise ValidationError("name must be a non-empty string")
+
+    result = dict(fields)
+    if "name" in result:
+        result["name"] = result["name"].strip()
+    return result
+
+
+def pre_create_hook(store, config, fields):
+    return validate_fields(
+        fields,
+        config["validation_required_fields"],
+        config["validation_max_amount"],
+    )
diff --git a/tests/test_audit.py b/tests/test_audit.py
new file mode 100644
index 0000000..2528f1b
--- /dev/null
+++ b/tests/test_audit.py
@@ -0,0 +1,94 @@
+from app import audit
+
+
+def setup_function(_fn):
+    audit.clear()
+
+
+def test_entries_on_fresh_log_returns_empty_list():
+    assert audit.entries() == []
+
+
+def test_record_appends_exactly_one_entry():
+    audit.record("GET", "/records", "alice", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"}
+    ]
+
+
+def test_entries_returns_in_call_order():
+    audit.record("GET", "/records", "alice", 500)
+    audit.record("POST", "/records", "bob", 500)
+    audit.record("DELETE", "/records/1", "carol", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+
+
+def test_entries_returns_a_copy():
+    audit.record("GET", "/records", "alice", 500)
+    result = audit.entries()
+    result.append({"method": "X", "path": "Y", "actor": "Z"})
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"}
+    ]
+
+
+def test_cap_drops_oldest_first():
+    audit.record("GET", "/records", "a", 3)
+    audit.record("GET", "/records", "b", 3)
+    audit.record("GET", "/records", "c", 3)
+    audit.record("GET", "/records", "d", 3)
+    result = audit.entries()
+    assert len(result) == 3
+    assert result == [
+        {"method": "GET", "path": "/records", "actor": "b"},
+        {"method": "GET", "path": "/records", "actor": "c"},
+        {"method": "GET", "path": "/records", "actor": "d"},
+    ]
+
+
+def test_cap_enforced_on_every_call():
+    for i in range(5):
+        audit.record("GET", "/records", "actor%s" % i, 2)
+        assert len(audit.entries()) <= 2
+
+
+def test_dispatch_hook_defaults_actor_to_anonymous():
+    audit.dispatch_hook(None, {"audit_log_max_entries": 500}, "GET",
+                         "/records", {})
+    entries = audit.entries()
+    assert len(entries) == 1
+    assert entries[0]["actor"] == "anonymous"
+    assert entries[0]["method"] == "GET"
+    assert entries[0]["path"] == "/records"
+
+
+def test_dispatch_hook_uses_actor_kwarg_and_excludes_record_fields():
+    audit.dispatch_hook(
+        None, {"audit_log_max_entries": 500}, "POST", "/records",
+        {"actor": "bob", "name": "x"},
+    )
+    entries = audit.entries()
+    assert len(entries) == 1
+    assert entries[0]["actor"] == "bob"
+    assert set(entries[0].keys()) == {"method", "path", "actor"}
+
+
+def test_dispatch_hook_reads_cap_from_config():
+    config = {"audit_log_max_entries": 1}
+    audit.dispatch_hook(None, config, "GET", "/records", {})
+    audit.dispatch_hook(None, config, "GET", "/records", {})
+    assert len(audit.entries()) == 1
+
+
+def test_dispatch_hook_fires_for_every_method():
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(None, config, "DELETE", "/records/1", {"actor": "x"})
+    audit.dispatch_hook(None, config, "PUT", "/records/1", {"actor": "y"})
+    entries = audit.entries()
+    assert len(entries) == 2
+    assert entries[0]["method"] == "DELETE"
+    assert entries[1]["method"] == "PUT"
