@@ -0,0 +1,167 @@
+"""Tests for app/rules.py — the pure rule-combinator layer."""
+import pytest
+
+from app import rules, schema
+
+
+def _always(result, name):
+    return rules.rule(name, lambda value: result)
+
+
+def test_rule_error_is_a_distinct_exception_subclass():
+    assert issubclass(rules.RuleError, Exception)
+    assert not issubclass(rules.RuleError, schema.SchemaError)
+    assert not issubclass(schema.SchemaError, rules.RuleError)
+
+
+def test_rule_builds_a_name_test_mapping_and_validates_its_name():
+    predicate = lambda value: True
+    assert rules.rule("r", predicate) == {"name": "r", "test": predicate}
+    with pytest.raises(ValueError):
+        rules.rule("", predicate)
+    with pytest.raises(ValueError):
+        rules.rule(42, predicate)
+
+
+def test_check_coerces_the_predicate_result_to_bool():
+    truthy = rules.rule("truthy", lambda value: value)
+    assert rules.check("x", truthy) is True
+    assert rules.check("", truthy) is False
+
+
+def test_all_of_passes_only_when_every_child_passes():
+    yes, no = _always(True, "yes"), _always(False, "no")
+    both = rules.all_of(yes, no)
+    assert both["name"] == "all(yes,no)"
+    assert rules.check(1, both) is False
+    assert rules.check(1, rules.all_of(yes, yes)) is True
+    empty = rules.all_of()
+    assert empty["name"] == "all()"
+    assert rules.check(object(), empty) is True
+
+
+def test_any_of_passes_when_one_child_passes_and_rejects_no_children():
+    yes, no = _always(True, "yes"), _always(False, "no")
+    either = rules.any_of(no, yes)
+    assert either["name"] == "any(no,yes)"
+    assert rules.check(1, either) is True
+    assert rules.check(1, rules.any_of(no, no)) is False
+    with pytest.raises(ValueError):
+        rules.any_of()
+
+
+def test_negate_inverts_and_renames():
+    no = _always(False, "no")
+    inverted = rules.negate(no)
+    assert inverted["name"] == "not(no)"
+    assert rules.check(1, inverted) is True
+    assert rules.check(1, rules.negate(inverted)) is False
+
+
+def test_when_is_material_implication_over_all_four_cells():
+    yes, no = _always(True, "yes"), _always(False, "no")
+    assert rules.when(yes, yes)["name"] == "when(yes,yes)"
+    assert rules.check(1, rules.when(yes, yes)) is True
+    assert rules.check(1, rules.when(yes, no)) is False
+    assert rules.check(1, rules.when(no, yes)) is True
+    assert rules.check(1, rules.when(no, no)) is True
+
+
+def test_explain_renders_pass_or_fail():
+    assert rules.explain(1, _always(True, "yes")) == "yes: pass"
+    assert rules.explain(1, _always(False, "no")) == "no: fail"
+
+
+def test_apply_rules_lists_failures_in_insertion_order():
+    fields = {"a": 1, "b": 2, "c": 3}
+    by_field = {
+        "b": _always(False, "no"),
+        "a": _always(True, "yes"),
+        "c": _always(False, "nope"),
+        "absent": _always(False, "never"),
+    }
+    assert rules.apply_rules(fields, by_field) == [
+        "field b failed no",
+        "field c failed nope",
+    ]
+    assert fields == {"a": 1, "b": 2, "c": 3}
+    assert rules.apply_rules(fields, {"a": _always(True, "yes")}) == []
+
+
+def test_first_failure_returns_the_first_failing_pair_or_none():
+    fields = {"a": 1, "b": 2}
+    by_field = {"a": _always(True, "yes"), "b": _always(False, "no")}
+    assert rules.first_failure(fields, by_field) == ("b", "no")
+    assert rules.first_failure(fields, {"a": _always(True, "yes")}) is None
+    assert rules.first_failure({}, by_field) is None
+
+
+def test_explain_failures_explains_only_the_failing_fields():
+    fields = {"a": 1, "b": 2, "c": 3}
+    by_field = {
+        "a": _always(True, "yes"),
+        "b": _always(False, "no"),
+        "absent": _always(False, "never"),
+        "c": _always(False, "nope"),
+    }
+    assert rules.explain_failures(fields, by_field) == ["no: fail",
+                                                        "nope: fail"]
+    assert rules.explain_failures(fields, {"a": _always(True, "yes")}) == []
+
+
+def test_builtins_wrap_the_schema_predicates():
+    assert set(rules.BUILTINS) == {"number", "str", "non_empty"}
+    assert rules.BUILTINS["number"]["name"] == "number"
+    assert rules.BUILTINS["str"]["name"] == "str"
+    assert rules.BUILTINS["non_empty"]["name"] == "non_empty"
+    assert rules.check(3.5, rules.BUILTINS["number"]) is True
+    assert rules.check(True, rules.BUILTINS["number"]) is False
+    assert rules.check("a", rules.BUILTINS["str"]) is True
+    assert rules.check(1, rules.BUILTINS["str"]) is False
+    assert rules.check(" a ", rules.BUILTINS["non_empty"]) is True
+    assert rules.check("  ", rules.BUILTINS["non_empty"]) is False
+
+
+def test_parse_rule_reads_ampersand_joined_builtins():
+    number = rules.parse_rule("number")
+    assert number["name"] == "number"
+    assert rules.check(1, number) is True
+    composite = rules.parse_rule("number&non_empty")
+    assert composite["name"] == "all(number,non_empty)"
+    assert rules.check(1, composite) is False
+    with pytest.raises(ValueError) as err:
+        rules.parse_rule("number&bogus")
+    assert "bogus" in str(err.value)
+    with pytest.raises(ValueError):
+        rules.parse_rule("")
+
+
+def test_parse_rules_maps_a_field_to_rule_text_mapping():
+    parsed = rules.parse_rules({"amount": "number", "name": "str&non_empty"})
+    assert list(parsed) == ["amount", "name"]
+    assert parsed["amount"]["name"] == "number"
+    assert parsed["name"]["name"] == "all(str,non_empty)"
+    assert rules.parse_rules({}) == {}
+    with pytest.raises(ValueError) as err:
+        rules.parse_rules({"amount": "bogus"})
+    assert "amount" in str(err.value)
+    assert "bogus" in str(err.value)
+    fields = {"amount": "3", "name": "ada"}
+    assert rules.apply_rules(fields, rules.parse_rules(
+        {"amount": "number", "name": "str&non_empty"})) == [
+            "field amount failed number"]
+
+
+def test_describe_rules_renders_one_line_per_field_in_insertion_order():
+    by_field = {"amount": rules.parse_rule("number"),
+                "name": rules.parse_rule("str&non_empty")}
+    assert rules.describe_rules(by_field) == (
+        "amount: number\n"
+        "name: all(str,non_empty)"
+    )
+    assert rules.describe_rules({}) == "(no rules)"
+
+
+def test_builtin_number_delegates_to_schema_is_valid_amount(monkeypatch):
+    monkeypatch.setattr(schema, "is_valid_amount", lambda value: False)
+    assert rules.check(5, rules.parse_rule("number")) is False
diff --git a/tests/test_schema.py b/tests/test_schema.py
new file mode 100644
