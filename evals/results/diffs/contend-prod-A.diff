+++ b/app/ratelimit.py
@@ -0,0 +1,99 @@
+"""Per-actor rate-limit guard for writes.
+
+`dispatch_hook` is the registry seam: it runs before every dispatch and
+rejects a POST once the calling actor has spent its configured allowance.
+Reads are never counted. All counting lives in `app.quota` — this module
+keeps no counter state of its own, so `reset()` is just `quota.reset()`.
+
+Config: only `rate_limit_max_per_window` is required. The window and the
+burst are always read with `.get(...)` defaults so an external caller can
+pass a limit-only config.
+"""
+from app import quota
+
+
+DEFAULT_WINDOW_SECONDS = 60
+DEFAULT_BURST = 0
+
+
+class RateLimitExceededError(quota.QuotaExceededError):
+    """Raised when a key exceeds its configured rate limit."""
+
+
+def reset():
+    """Clear every key's counter and reset the quota clock."""
+    quota.reset()
+
+
+def _limits(config):
+    """The (limit, window_seconds, burst) triple this config asks for."""
+    return (
+        config["rate_limit_max_per_window"],
+        config.get("rate_limit_window_seconds", DEFAULT_WINDOW_SECONDS),
+        config.get("rate_limit_burst", DEFAULT_BURST),
+    )
+
+
+def check_and_increment(key, limit, window_seconds=float("inf"), burst=0):
+    """Record a hit for `key` and return its in-window count.
+
+    Raises RateLimitExceededError once the allowance is spent. The default
+    window is infinite: plain call-counting unless a caller passes one."""
+    try:
+        return quota.take(key, limit, window_seconds, burst=burst)
+    except quota.QuotaExceededError as err:
+        raise RateLimitExceededError(str(err)) from err
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """Registry dispatch hook: count writes per actor, ignore reads.
+
+    The actor comes from `kwargs["actor"]`, defaulting to "anonymous" — all
+    unattributed callers share one counter. Any method other than POST is a
+    no-op."""
+    if method != "POST":
+        return None
+    limit, window_seconds, burst = _limits(config)
+    check_and_increment(kwargs.get("actor", "anonymous"), limit,
+                        window_seconds, burst=burst)
+    return None
+
+
+def retry_after(key, config):
+    """Seconds until `key` may retry under `config`. Records nothing."""
+    limit, window_seconds, burst = _limits(config)
+    return quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
+
+
+def limit_headers(key, config):
+    """The X-RateLimit-* response headers for `key`, all values strings.
+
+    `X-RateLimit-Limit` is the configured limit alone; any burst shows up
+    only in the remaining allowance. Records nothing."""
+    limit, window_seconds, burst = _limits(config)
+    return {
+        "X-RateLimit-Limit": str(limit),
+        "X-RateLimit-Remaining": str(
+            quota.remaining(key, limit, window_seconds, burst=burst)),
+        "X-RateLimit-Reset": str(
+            quota.time_to_next_slot(key, limit, window_seconds, burst=burst)),
+    }
+
+
+def status_line(key, config):
+    """A one-line human-readable usage summary for `key`. Records nothing."""
+    limit, window_seconds, burst = _limits(config)
+    state = quota.usage(key, limit, window_seconds, burst=burst)
+    return "%s: %s/%s, reset in %ss" % (
+        key, state["used"], state["allowed"], state["reset_in"])
+
+
+def check_many(keys, config):
+    """Map each key to whether a POST for it would succeed right now.
+
+    Records nothing — a pure look-ahead over `quota.remaining`."""
+    limit, window_seconds, burst = _limits(config)
+    return {
+        key: quota.remaining(key, limit, window_seconds, burst=burst) > 0
+        for key in keys
+    }
