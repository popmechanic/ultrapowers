new file mode 100644
index 0000000..ccd868d
--- /dev/null
+++ b/tests/test_ratelimit.py
@@ -0,0 +1,87 @@
+"""Tests for the per-actor rate-limit/quota guard (app/ratelimit.py)."""
+import pytest
+
+from app import ratelimit
+from app.ratelimit import RateLimitExceededError, check_and_increment, dispatch_hook, reset
+
+
+def setup_function(_fn):
+    reset()
+
+
+def test_rate_limit_exceeded_error_is_an_exception_subclass():
+    assert issubclass(RateLimitExceededError, Exception)
+
+
+def test_check_and_increment_counts_up_then_raises_on_fourth_call():
+    assert check_and_increment("k", 3) == 1
+    assert check_and_increment("k", 3) == 2
+    assert check_and_increment("k", 3) == 3
+    with pytest.raises(RateLimitExceededError) as exc_info:
+        check_and_increment("k", 3)
+    message = str(exc_info.value)
+    assert "k" in message
+    assert "3" in message
+
+
+def test_counter_is_per_key_interleaved():
+    assert check_and_increment("a", 2) == 1
+    assert check_and_increment("b", 2) == 1
+    assert check_and_increment("a", 2) == 2
+    assert check_and_increment("b", 2) == 2
+    # both "a" and "b" are now at their limit of 2; neither raised early
+    with pytest.raises(RateLimitExceededError):
+        check_and_increment("a", 2)
+    with pytest.raises(RateLimitExceededError):
+        check_and_increment("b", 2)
+
+
+def test_reset_clears_all_keys_counters():
+    check_and_increment("a", 5)
+    check_and_increment("b", 5)
+    reset()
+    assert check_and_increment("a", 5) == 1
+    assert check_and_increment("b", 5) == 1
+
+
+def test_dispatch_hook_never_raises_and_never_increments_for_get():
+    store = object()
+    config = {"rate_limit_max_per_window": 5}
+    for _ in range(5 + 5):
+        dispatch_hook(store, config, "GET", "/records", {})
+    # GET calls never touched the counter for the anonymous actor key
+    assert check_and_increment("anonymous", 5) == 1
+
+
+def test_dispatch_hook_post_keys_on_actor_default_anonymous_shared():
+    store = object()
+    config = {"rate_limit_max_per_window": 5}
+    dispatch_hook(store, config, "POST", "/records", {})
+    dispatch_hook(store, config, "POST", "/records", {})
+    # both calls (no "actor" kwarg) share the "anonymous" counter, so the
+    # next check_and_increment for "anonymous" starts at 3
+    assert check_and_increment("anonymous", 5) == 3
+
+
+def test_dispatch_hook_post_keys_on_actor_separate_from_anonymous():
+    store = object()
+    config = {"rate_limit_max_per_window": 5}
+    dispatch_hook(store, config, "POST", "/records", {"actor": "x"})
+    # "x" is a separate counter from "anonymous"
+    assert check_and_increment("anonymous", 5) == 1
+    assert check_and_increment("x", 5) == 2
+
+
+def test_dispatch_hook_reads_limit_from_config_limit_one_raises_second_call():
+    store = object()
+    config = {"rate_limit_max_per_window": 1}
+    dispatch_hook(store, config, "POST", "/records", {"actor": "y"})
+    with pytest.raises(RateLimitExceededError):
+        dispatch_hook(store, config, "POST", "/records", {"actor": "y"})
+
+
+def test_dispatch_hook_reads_limit_from_config_limit_two_does_not_raise_second_call():
+    store = object()
+    config = {"rate_limit_max_per_window": 2}
+    dispatch_hook(store, config, "POST", "/records", {"actor": "z"})
+    dispatch_hook(store, config, "POST", "/records", {"actor": "z"})
