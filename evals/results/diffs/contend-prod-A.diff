@@ -0,0 +1,263 @@
+"""Tests for the export/report formatter `app/export.py` and its wiring.
+
+Every expected table/table-ish value below is a literal string. Building an
+expectation out of the same `tabular` helpers the implementation uses would
+be a tautology that stays green under a broken `columns`/`widths`/`pad`.
+"""
+import json
+
+import pytest
+
+from app import export, tabular
+from app.registry import DEFAULT_CONFIG, EXPORT_FORMATS, bootstrap
+
+
+# Two records with deliberately unequal key sets: "note" is missing from the
+# first, so every format has to render a missing field as an empty cell.
+RECORDS = [
+    {"name": "coffee", "amount": 3},
+    {"name": "tea", "amount": 2, "note": "hot"},
+]
+
+ONE_RECORD = [{"name": "coffee", "amount": 3}]
+
+
+def test_to_csv_of_no_records_is_empty_without_a_header_row():
+    assert export.to_csv([]) == ""
+
+
+def test_to_csv_emits_sorted_union_header_then_rows_in_input_order():
+    assert export.to_csv(RECORDS) == (
+        "amount,name,note\n"
+        "3,coffee,\n"
+        "2,tea,hot"
+    )
+
+
+def test_to_csv_renders_numbers_via_plain_str():
+    assert export.to_csv([{"amount": 3}]) == "amount\n3"
+    assert export.to_csv([{"amount": 3.5}]) == "amount\n3.5"
+
+
+def test_to_json_of_no_records_is_an_empty_array():
+    assert export.to_json([]) == "[]"
+
+
+def test_to_json_round_trips_and_sorts_keys():
+    rendered = export.to_json(RECORDS)
+    assert json.loads(rendered) == RECORDS
+    assert rendered == (
+        '[{"amount": 3, "name": "coffee"}, '
+        '{"amount": 2, "name": "tea", "note": "hot"}]'
+    )
+
+
+def test_to_csv_escapes_cells_and_leaves_plain_ones_byte_identical():
+    assert export.to_csv([{"name": "a,b"}]) == 'name\n"a,b"'
+    assert export.to_csv([{"name": 'say "hi"'}]) == 'name\n"say ""hi"""'
+    plain = export.to_csv([{"amount": 3, "name": "coffee"}])
+    assert plain == "amount,name\n" + ",".join(["3", "coffee"])
+
+
+def test_to_markdown_of_no_records_is_empty():
+    assert export.to_markdown([]) == ""
+
+
+def test_to_markdown_renders_a_padded_pipe_table():
+    assert export.to_markdown(RECORDS) == (
+        "| amount | name   | note |\n"
+        "| ------ | ------ | ---- |\n"
+        "| 3      | coffee |      |\n"
+        "| 2      | tea    | hot  |"
+    )
+
+
+def test_to_markdown_left_and_right_alignment():
+    records = [{"amount": 3}, {"amount": 12}]
+    assert export.to_markdown(records) == export.to_markdown(
+        records, align="left")
+    assert export.to_markdown(records, align="left") == (
+        "| amount |\n"
+        "| ------ |\n"
+        "| 3      |\n"
+        "| 12     |"
+    )
+    assert export.to_markdown(records, align="right") == (
+        "| amount |\n"
+        "| -----: |\n"
+        "|      3 |\n"
+        "|     12 |"
+    )
+
+
+def test_to_markdown_rejects_a_bad_align_even_when_nothing_needs_padding():
+    # Every cell here already meets its column width, so a delegation that
+    # only runs when padding is needed would silently accept "center".
+    flush = [{"ab": "xy"}]
+    assert export.to_markdown(flush) == (
+        "| ab |\n"
+        "| -- |\n"
+        "| xy |"
+    )
+    with pytest.raises(ValueError):
+        export.to_markdown(flush, align="center")
+    with pytest.raises(ValueError):
+        export.to_markdown(RECORDS, align="center")
+
+
+def test_to_ndjson_renders_one_sorted_json_object_per_line():
+    assert export.to_ndjson([]) == ""
+    rendered = export.to_ndjson(RECORDS)
+    assert rendered == (
+        '{"amount": 3, "name": "coffee"}\n'
+        '{"amount": 2, "name": "tea", "note": "hot"}'
+    )
+    assert [json.loads(line) for line in rendered.split("\n")] == RECORDS
+
+
+def test_to_tsv_sanitizes_every_cell_and_every_header_name():
+    assert export.to_tsv([]) == ""
+    assert export.to_tsv(RECORDS) == (
+        "amount\tname\tnote\n"
+        "3\tcoffee\t\n"
+        "2\ttea\thot"
+    )
+    assert export.to_tsv([{"name": "a\tb\nc"}]) == "name\na b c"
+    assert export.to_tsv([{"na\tme\nx": "v"}]) == "na me x\nv"
+
+
+def test_to_html_renders_an_escaped_table():
+    assert export.to_html([]) == ""
+    records = [
+        {"name": "a & b", "amount": 3},
+        {"name": "<x>", "amount": 2, "note": "hot"},
+    ]
+    assert export.to_html(records) == (
+        "<table>\n"
+        "<tr><th>amount</th><th>name</th><th>note</th></tr>\n"
+        "<tr><td>3</td><td>a &amp; b</td><td></td></tr>\n"
+        "<tr><td>2</td><td>&lt;x&gt;</td><td>hot</td></tr>\n"
+        "</table>"
+    )
+
+
+def test_parse_csv_of_empty_text_and_of_a_header_only():
+    assert export.parse_csv("") == []
+    assert export.parse_csv("a") == []
+    assert export.parse_csv("a\n") == [{"a": ""}]
+
+
+def test_parse_csv_never_retypes_values():
+    assert export.parse_csv(
+        export.to_csv([{"amount": 3}])) == [{"amount": "3"}]
+
+
+def test_parse_csv_reads_quoted_cells():
+    assert export.parse_csv('a,b\n"x,y",z') == [{"a": "x,y", "b": "z"}]
+    assert export.parse_csv('a\n"say ""hi"""') == [{"a": 'say "hi"'}]
+    assert export.parse_csv('a,b\n"line1\nline2",z') == [
+        {"a": "line1\nline2", "b": "z"}]
+    with pytest.raises(ValueError):
+        export.parse_csv('a\n"unterminated')
+
+
+def test_parse_csv_inverts_to_csv():
+    record = {"name": 'a,b "q"\nsecond line', "amount": 3}
+    assert export.parse_csv(export.to_csv([record])) == [
+        {"name": 'a,b "q"\nsecond line', "amount": "3"}]
+    assert export.parse_csv(export.to_csv(RECORDS)) == [
+        {"amount": "3", "name": "coffee", "note": ""},
+        {"amount": "2", "name": "tea", "note": "hot"},
+    ]
+
+
+def test_formats_and_extra_formats_hold_exactly_the_expected_keys():
+    assert export.FORMATS == {
+        "csv": export.to_csv,
+        "json": export.to_json,
+        "md": export.to_markdown,
+        "ndjson": export.to_ndjson,
+        "tsv": export.to_tsv,
+    }
+    assert export.EXTRA_FORMATS == {"html": export.to_html}
+
+
+def test_render_serves_every_format_in_FORMATS():
+    assert export.render(RECORDS, "csv") == export.to_csv(RECORDS)
+    assert export.render(RECORDS, "json") == export.to_json(RECORDS)
+    assert export.render(RECORDS, "md") == export.to_markdown(RECORDS)
+    assert export.render(RECORDS, "ndjson") == export.to_ndjson(RECORDS)
+    assert export.render(RECORDS, "tsv") == export.to_tsv(RECORDS)
+
+
+def test_render_rejects_unknown_formats_and_extra_formats():
+    with pytest.raises(ValueError) as excinfo:
+        export.render(RECORDS, "xml")
+    assert "xml" in str(excinfo.value)
+    with pytest.raises(ValueError):
+        export.render(RECORDS, "html")
+
+
+def test_render_any_serves_formats_then_extra_formats():
+    assert export.render_any(RECORDS, "csv") == export.to_csv(RECORDS)
+    assert export.render_any(RECORDS, "html") == export.to_html(RECORDS)
+    with pytest.raises(ValueError) as excinfo:
+        export.render_any(RECORDS, "xml")
+    assert "xml" in str(excinfo.value)
+
+
+def test_summary_line_counts_records_and_columns():
+    assert export.summary_line([]) == "0 records, 0 columns"
+    assert export.summary_line(RECORDS) == "2 records, 3 columns"
+
+
+def test_single_record_renders_in_every_format():
+    assert export.to_csv(ONE_RECORD) == "amount,name\n3,coffee"
+    assert export.to_json(ONE_RECORD) == '[{"amount": 3, "name": "coffee"}]'
+    assert export.to_markdown(ONE_RECORD) == (
+        "| amount | name   |\n"
+        "| ------ | ------ |\n"
+        "| 3      | coffee |"
+    )
+    assert export.to_ndjson(ONE_RECORD) == '{"amount": 3, "name": "coffee"}'
+    assert export.to_tsv(ONE_RECORD) == "amount\tname\n3\tcoffee"
+    assert export.to_html(ONE_RECORD) == (
+        "<table>\n"
+        "<tr><th>amount</th><th>name</th></tr>\n"
+        "<tr><td>3</td><td>coffee</td></tr>\n"
+        "</table>"
+    )
+
+
+def test_export_builds_its_column_model_through_tabular():
+    assert export.to_csv(RECORDS).split("\n")[0] == ",".join(
+        tabular.columns(RECORDS))
+
+
+def test_registry_config_gains_the_two_export_keys():
+    assert DEFAULT_CONFIG["export_default_format"] == "csv"
+    assert DEFAULT_CONFIG["export_formats_enabled"] == ["csv", "json"]
+
+
+def test_registry_registers_every_format_in_export_formats():
+    for name, fn in export.FORMATS.items():
+        assert EXPORT_FORMATS[name] is fn
+    assert "html" not in EXPORT_FORMATS
+
+
+def test_export_route_serves_csv_by_default():
+    app = bootstrap()
+    app.call("POST", "/records", name="coffee", amount=3)
+    app.call("POST", "/records", name="tea", amount=2)
+    records = app.call("GET", "/records")
+    assert app.call("GET", "/export") == export.to_csv(records)
+    assert app.call("GET", "/export", fmt="json") == export.to_json(records)
+
+
+def test_export_route_rejects_registered_but_not_enabled_formats():
+    app = bootstrap()
+    app.call("POST", "/records", name="coffee", amount=3)
+    # "md"/"ndjson"/"tsv" are registered but not enabled; "html" is neither.
+    for fmt in ("md", "ndjson", "tsv", "html", "xml"):
+        with pytest.raises(ValueError):
+            app.call("GET", "/export", fmt=fmt)
