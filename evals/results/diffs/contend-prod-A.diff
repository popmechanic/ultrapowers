+"""Failing-first tests for app/validation.py's input-validation layer."""
+import pytest
+
+from app.validation import ValidationError, validate_fields, pre_create_hook
+
+
+REQUIRED = ["name", "amount"]
+MAX_AMOUNT = 100000
+
+
+def test_validation_error_is_an_exception_subclass():
+    assert issubclass(ValidationError, Exception)
+
+
+def test_missing_name_field_raises_with_field_named():
+    with pytest.raises(ValidationError, match=r"missing field: name"):
+        validate_fields({"amount": 3}, REQUIRED, MAX_AMOUNT)
+
+
+def test_missing_amount_field_raises_with_field_named():
+    with pytest.raises(ValidationError, match=r"missing field: amount"):
+        validate_fields({"name": "coffee"}, REQUIRED, MAX_AMOUNT)
+
+
+def test_both_missing_names_name_first_per_required_fields_order():
+    with pytest.raises(ValidationError, match=r"missing field: name"):
+        validate_fields({}, REQUIRED, MAX_AMOUNT)
+
+
+def test_amount_as_string_raises_numeric_error():
+    with pytest.raises(ValidationError, match=r"numeric"):
+        validate_fields({"name": "coffee", "amount": "3"}, REQUIRED, MAX_AMOUNT)
+
+
+def test_amount_as_bool_raises_numeric_error():
+    # bool is technically an int subclass in Python, but True/False are not
+    # valid amounts.
+    with pytest.raises(ValidationError, match=r"numeric"):
+        validate_fields({"name": "coffee", "amount": True}, REQUIRED, MAX_AMOUNT)
+    with pytest.raises(ValidationError, match=r"numeric"):
+        validate_fields({"name": "coffee", "amount": False}, REQUIRED, MAX_AMOUNT)
+
+
+def test_negative_amount_raises_non_negative_error():
+    with pytest.raises(ValidationError, match=r"non-negative"):
+        validate_fields({"name": "coffee", "amount": -1}, REQUIRED, MAX_AMOUNT)
+
+
+def test_zero_amount_is_accepted_boundary():
+    result = validate_fields({"name": "coffee", "amount": 0}, REQUIRED, MAX_AMOUNT)
+    assert result["amount"] == 0
+
+
+def test_amount_over_max_raises_and_exact_max_is_accepted():
+    with pytest.raises(ValidationError, match=r"max_amount"):
+        validate_fields(
+            {"name": "coffee", "amount": MAX_AMOUNT + 1}, REQUIRED, MAX_AMOUNT
+        )
+    result = validate_fields(
+        {"name": "coffee", "amount": MAX_AMOUNT}, REQUIRED, MAX_AMOUNT
+    )
+    assert result["amount"] == MAX_AMOUNT
+
+
+def test_name_empty_whitespace_or_non_string_raises_non_empty_string_error():
+    with pytest.raises(ValidationError, match=r"non-empty string"):
+        validate_fields({"name": "", "amount": 1}, REQUIRED, MAX_AMOUNT)
+    with pytest.raises(ValidationError, match=r"non-empty string"):
+        validate_fields({"name": "   ", "amount": 1}, REQUIRED, MAX_AMOUNT)
+    with pytest.raises(ValidationError, match=r"non-empty string"):
+        validate_fields({"name": 42, "amount": 1}, REQUIRED, MAX_AMOUNT)
+
+
+def test_success_returns_new_dict_with_name_stripped_and_other_keys_preserved():
+    fields = {"name": "  coffee  ", "amount": 3, "category": "drinks"}
+    result = validate_fields(fields, REQUIRED, MAX_AMOUNT)
+    assert result is not fields
+    assert result["name"] == "coffee"
+    assert result["amount"] == 3
+    assert result["category"] == "drinks"
+    # original untouched
+    assert fields["name"] == "  coffee  "
+
+
+def test_extra_keys_beyond_required_fields_pass_untouched():
+    fields = {"name": "coffee", "amount": 3, "extra": "value", "another": 42}
+    result = validate_fields(fields, REQUIRED, MAX_AMOUNT)
+    assert result["extra"] == "value"
+    assert result["another"] == 42
+
+
+def test_pre_create_hook_matches_direct_validate_fields_calls():
+    config = {
+        "validation_required_fields": REQUIRED,
+        "validation_max_amount": MAX_AMOUNT,
+    }
+
+    # success case
+    fields = {"name": "coffee", "amount": 3}
+    assert pre_create_hook(None, config, fields) == validate_fields(
+        fields, REQUIRED, MAX_AMOUNT
+    )
+
+    # failure case
+    bad_fields = {"name": "coffee", "amount": -1}
+    with pytest.raises(ValidationError):
+        pre_create_hook(None, config, bad_fields)
+    with pytest.raises(ValidationError):
+        validate_fields(bad_fields, REQUIRED, MAX_AMOUNT)
