diff --git a/app/export.py b/app/export.py
new file mode 100644
index 0000000..c54244f
--- /dev/null
+++ b/app/export.py
@@ -0,0 +1,69 @@
+"""Export/report formatters: CSV, JSON, Markdown, NDJSON.
+
+Built on top of `app.tabular`'s column-model toolkit (`columns`, `cell`,
+`escape_csv`, `widths`) so the key-union and cell-stringification logic
+lives in exactly one place.
+"""
+import json
+
+from app import tabular
+
+
+def to_csv(records):
+    """Header row of every field name (sorted), then one row per record in
+    input order. Missing fields render as an empty cell. Cells are escaped
+    via tabular.escape_csv."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = [",".join(tabular.escape_csv(c) for c in cols)]
+    for r in records:
+        lines.append(",".join(
+            tabular.escape_csv(tabular.cell(r.get(c))) for c in cols))
+    return "\n".join(lines)
+
+
+def to_json(records):
+    """Round-trips through json.loads; keys sorted alphabetically."""
+    return json.dumps(records, sort_keys=True)
+
+
+def to_markdown(records):
+    """Pipe table: header row of sorted column names, a separator row of
+    dashes, then one row per record. Cells are padded with trailing spaces
+    to their tabular.widths column width; missing fields render as empty
+    (padded) cells."""
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    w = tabular.widths(records, cols)
+    header = "| " + " | ".join(c.ljust(w[c]) for c in cols) + " |"
+    sep = "| " + " | ".join("-" * w[c] for c in cols) + " |"
+    lines = [header, sep]
+    for r in records:
+        lines.append("| " + " | ".join(
+            tabular.cell(r.get(c)).ljust(w[c]) for c in cols) + " |")
+    return "\n".join(lines)
+
+
+def to_ndjson(records):
+    """One JSON object per line (sort_keys=True), no trailing newline."""
+    if not records:
+        return ""
+    return "\n".join(json.dumps(r, sort_keys=True) for r in records)
+
+
+FORMATS = {
+    "csv": to_csv,
+    "json": to_json,
+    "md": to_markdown,
+    "ndjson": to_ndjson,
+}
+
+
+def render(records, fmt):
+    """Delegate to the matching formatter. Raises ValueError for an
+    unknown format, naming it in the message."""
+    if fmt not in FORMATS:
+        raise ValueError("unknown export format: %s" % fmt)
+    return FORMATS[fmt](records)
