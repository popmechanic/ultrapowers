+++ b/tests/test_tabular.py
@@ -0,0 +1,93 @@
+"""Tests for the column-model toolkit `app/tabular.py`.
+
+`app/export.py` builds every one of its formats on these helpers, so each
+contract below is pinned with exact expected values rather than loose
+containment.
+"""
+import pytest
+
+from app import tabular
+
+
+def test_columns_returns_sorted_union_of_all_record_keys():
+    assert tabular.columns([]) == []
+    records = [{"name": "coffee", "amount": 3},
+               {"note": "hot", "amount": 2}]
+    assert tabular.columns(records) == ["amount", "name", "note"]
+
+
+def test_cell_renders_none_as_empty_and_everything_else_via_str():
+    assert tabular.cell(None) == ""
+    assert tabular.cell(3) == "3"
+    assert tabular.cell(3.5) == "3.5"
+    assert tabular.cell("x") == "x"
+
+
+def test_escape_csv_quotes_only_cells_that_need_it():
+    assert tabular.escape_csv("plain") == "plain"
+    assert tabular.escape_csv("a,b") == '"a,b"'
+    assert tabular.escape_csv('say "hi"') == '"say ""hi"""'
+    assert tabular.escape_csv("line1\nline2") == '"line1\nline2"'
+    assert tabular.escape_csv("") == ""
+
+
+def test_widths_takes_the_max_of_the_header_and_every_cell():
+    records = [{"category": "a", "name": "espresso"},
+               {"category": "bb", "name": "tea"}]
+    cols = ["category", "name"]
+    # "category" is strictly wider than every cell in its column (1, 2);
+    # "name"'s width comes from the cell "espresso" instead.
+    assert tabular.widths(records, cols) == {"category": 8, "name": 8}
+
+
+def test_pad_aligns_never_truncates_and_validates_align_first():
+    assert tabular.pad("ab", 4, "left") == "ab  "
+    assert tabular.pad("ab", 4, "right") == "  ab"
+    assert tabular.pad("abcde", 4, "left") == "abcde"
+    assert tabular.pad("abcd", 4, "right") == "abcd"
+    with pytest.raises(ValueError) as excinfo:
+        tabular.pad("abcde", 4, "center")
+    assert "center" in str(excinfo.value)
+
+
+def test_sanitize_flat_replaces_tabs_and_newlines_with_single_spaces():
+    assert tabular.sanitize_flat("a\tb\nc") == "a b c"
+    assert tabular.sanitize_flat("clean value") == "clean value"
+    assert tabular.sanitize_flat(3) == "3"
+
+
+def test_escape_html_escapes_the_ampersand_first():
+    assert tabular.escape_html('<a & "b">') == "&lt;a &amp; &quot;b&quot;&gt;"
+    assert tabular.escape_html("clean value") == "clean value"
+
+
+def test_truncate_shortens_only_over_long_values():
+    assert tabular.truncate("abcdef", 6) == "abcdef"
+    assert tabular.truncate("abcdefgh", 6) == "abc..."
+    assert tabular.truncate("abcdefgh", 6, marker="~") == "abcde~"
+    with pytest.raises(ValueError):
+        tabular.truncate("x", 2)
+
+
+def test_wrap_greedily_breaks_on_spaces_and_hard_splits_long_words():
+    assert tabular.wrap("alpha beta gamma", 10) == ["alpha beta", "gamma"]
+    assert tabular.wrap("alpha beta gamma", 5) == ["alpha", "beta", "gamma"]
+    assert tabular.wrap("abcdefgh", 3) == ["abc", "def", "gh"]
+    assert tabular.wrap("", 4) == [""]
+    with pytest.raises(ValueError):
+        tabular.wrap("x", 0)
+
+
+def test_fit_composes_truncate_then_pad():
+    assert tabular.fit("abcdefgh", 6, "left") == "abc..."
+    assert tabular.fit("ab", 5, "right") == "   ab"
+    assert tabular.fit("ab", 5, "left") == "ab   "
+    with pytest.raises(ValueError):
+        tabular.fit("ab", 5, "center")
+
+
+def test_render_row_renders_one_padded_pipe_table_row():
+    assert tabular.render_row(["a", "bb"], [3, 4], "left") == "| a   | bb   |"
+    assert tabular.render_row(["a", "bb"], [3, 4], "right") == "|   a |   bb |"
+    with pytest.raises(ValueError):
+        tabular.render_row(["a"], [3, 4], "left")
