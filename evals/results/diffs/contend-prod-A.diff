index 0000000..fe190fe
--- /dev/null
+++ b/app/rules.py
@@ -0,0 +1,128 @@
+"""Pure rule combinators over app.schema's predicates.
+
+A *rule* is a plain dict ``{"name": str, "test": callable}``. Combinators
+build bigger rules out of smaller ones and name the result deterministically,
+so a failure message always spells out the rule that produced it. Every
+predicate that already exists in app.schema is called through the module
+(never copied here) so monkeypatching schema reaches these rules too.
+"""
+from app import schema
+
+
+class RuleError(Exception):
+    """Raised for rule-application problems (distinct from SchemaError)."""
+
+
+def rule(name, predicate):
+    """Build a rule from a non-empty name and a single-argument predicate."""
+    if not isinstance(name, str) or not name:
+        raise ValueError("rule name must be a non-empty string: %r" % (name,))
+    return {"name": name, "test": predicate}
+
+
+def check(value, r):
+    """Run a rule's predicate against `value` as a bool."""
+    return bool(r["test"](value))
+
+
+def _joined(kind, children):
+    return "%s(%s)" % (kind, ",".join(child["name"] for child in children))
+
+
+def all_of(*children):
+    """Passes iff every child passes. No children passes everything."""
+    return rule(_joined("all", children),
+                lambda value: all(check(value, c) for c in children))
+
+
+def any_of(*children):
+    """Passes iff at least one child passes. No children is a bug, not a
+    vacuous pass, so it raises."""
+    if not children:
+        raise ValueError("any_of requires at least one rule")
+    return rule(_joined("any", children),
+                lambda value: any(check(value, c) for c in children))
+
+
+def negate(r):
+    """The inverse of `r`."""
+    return rule("not(%s)" % r["name"], lambda value: not check(value, r))
+
+
+def when(cond, then):
+    """Material implication: passes when `cond` fails or `then` passes."""
+    return rule("when(%s,%s)" % (cond["name"], then["name"]),
+                lambda value: (not check(value, cond)) or check(value, then))
+
+
+def explain(value, r):
+    """``"<rule name>: pass"`` or ``"<rule name>: fail"``."""
+    return "%s: %s" % (r["name"], "pass" if check(value, r) else "fail")
+
+
+def apply_rules(fields, rules_by_field):
+    """``"field <f> failed <rule name>"`` for every failing field, in
+    rules_by_field insertion order. Fields absent from `fields` are skipped;
+    `fields` is never mutated."""
+    return ["field %s failed %s" % (field, r["name"])
+            for field, r in rules_by_field.items()
+            if field in fields and not check(fields[field], r)]
+
+
+def first_failure(fields, rules_by_field):
+    """The (field, rule name) of the first failure in insertion order, or
+    None when everything present passes."""
+    for field, r in rules_by_field.items():
+        if field in fields and not check(fields[field], r):
+            return (field, r["name"])
+    return None
+
+
+def explain_failures(fields, rules_by_field):
+    """explain() for the failing fields only, in insertion order."""
+    return [explain(fields[field], r)
+            for field, r in rules_by_field.items()
+            if field in fields and not check(fields[field], r)]
+
+
+def describe_rules(rules_by_field):
+    """One ``"<field>: <rule name>"`` line per field, in insertion order."""
+    if not rules_by_field:
+        return "(no rules)"
+    return "\n".join("%s: %s" % (field, r["name"])
+                     for field, r in rules_by_field.items())
+
+
+BUILTINS = {
+    "number": rule("number", lambda value: schema.is_valid_amount(value)),
+    "str": rule("str", lambda value: isinstance(value, str)),
+    "non_empty": rule("non_empty",
+                      lambda value: schema.is_non_empty_str(value)),
+}
+
+
+def parse_rule(text):
+    """Parse a ``&``-joined list of builtin names into a single rule (an
+    all_of composite when more than one). Unknown tokens raise ValueError
+    naming the token."""
+    if not isinstance(text, str) or not text.strip():
+        raise ValueError("empty rule text: %r" % (text,))
+    tokens = [token.strip() for token in text.split("&")]
+    for token in tokens:
+        if token not in BUILTINS:
+            raise ValueError("unknown rule token: %r" % (token,))
+    if len(tokens) == 1:
+        return BUILTINS[tokens[0]]
+    return all_of(*[BUILTINS[token] for token in tokens])
+
+
+def parse_rules(text_by_field):
+    """{field: parse_rule(text)} in insertion order. A bad token raises
+    ValueError naming both the field and the token."""
+    parsed = {}
+    for field, text in text_by_field.items():
+        try:
+            parsed[field] = parse_rule(text)
+        except ValueError as err:
+            raise ValueError("field %s: %s" % (field, err))
+    return parsed
diff --git a/app/schema.py b/app/schema.py
new file mode 100644
index 0000000..dde28bd
--- /dev/null
+++ b/app/schema.py
@@ -0,0 +1,210 @@
+"""Declarative validation toolkit: the shared error catalog, the field
+predicates every validator is built from, and a small spec algebra.
+
+A *spec* is a dict mapping a field name to a rules dict. The only legal
+rule keys are:
+
+    "required"    bool   the field must be present
+    "type"        str    "str" or "number"
+    "non_empty"   bool   value must be a string with non-whitespace content
+    "max"         number value must be <= the limit
+
+Rules on a present field are always evaluated in the fixed order
+``type`` -> ``non_empty`` -> ``max`` so a field yields at most one error and
+always the most fundamental one.
+"""
+import math
+
+
+ERROR_CATALOG = {
+    "missing": "missing field: {field}",
+    "numeric": "field {field} must be numeric (got {got})",
+    "non_negative": "field {field} must be non-negative",
+    "max": "field {field} exceeds max_amount {limit}",
+    "non_empty": "field {field} must be a non-empty string",
+    "type_str": "field {field} must be a string",
+}
+
+LEGAL_RULE_KEYS = ("required", "type", "non_empty", "max")
+LEGAL_TYPES = ("str", "number")
+RULE_ORDER = ("type", "non_empty", "max")
+
+
+class SchemaError(Exception):
+    """Raised by a compiled validator when a field violates its spec."""
+
+
+def format_error(code, **params):
+    """Render the catalog message for `code`. Unknown codes raise KeyError
+    rather than degrading to a generic message."""
+    return ERROR_CATALOG[code].format(**params)
+
+
+def check_required(fields, required_fields):
+    """Names from `required_fields` absent from `fields`, in
+    required_fields order (never the dict's insertion order)."""
+    return [name for name in required_fields if name not in fields]
+
+
+def is_valid_amount(value):
+    """True for finite ints and floats. Bools are not amounts even though
+    they are ints; NaN and the infinities are not amounts either. Ints skip
+    math.isfinite entirely — they are always finite, and one too large to
+    convert to float would raise OverflowError."""
+    if isinstance(value, bool):
+        return False
+    if isinstance(value, int):
+        return True
+    if isinstance(value, float):
+        return math.isfinite(value)
+    return False
+
+
+def is_non_empty_str(value):
+    """True for strings with at least one non-whitespace character."""
+    return isinstance(value, str) and value.strip() != ""
+
+
+def _check_rules(field, value, rules):
+    """The error message for the first rule `value` violates, or None."""
+    for key in RULE_ORDER:
+        if key not in rules:
+            continue
+        if key == "type":
+            if rules[key] == "number" and not is_valid_amount(value):
+                return format_error("numeric", field=field,
+                                    got=type(value).__name__)
+            if rules[key] == "str" and not isinstance(value, str):
+                return format_error("type_str", field=field)
+        elif key == "non_empty":
+            if rules[key] and not is_non_empty_str(value):
+                return format_error("non_empty", field=field)
+        elif key == "max":
+            # A value that is not a number cannot be compared to the limit;
+            # report it as non-numeric instead of raising TypeError.
+            if not is_valid_amount(value):
+                return format_error("numeric", field=field,
+                                    got=type(value).__name__)
+            if value > rules[key]:
+                return format_error("max", field=field, limit=rules[key])
+    return None
+
+
+def _validate_spec(spec):
+    for field, rules in spec.items():
+        for key in rules:
+            if key not in LEGAL_RULE_KEYS:
+                raise ValueError(
+                    "unknown rule key %r on field %r" % (key, field))
+        if "type" in rules and rules["type"] not in LEGAL_TYPES:
+            raise ValueError(
+                "unknown type %r on field %r" % (rules["type"], field))
+
+
+def _normalize(spec, fields):
+    out = dict(fields)
+    for field, rules in spec.items():
+        if rules.get("non_empty") and isinstance(out.get(field), str):
+            out[field] = out[field].strip()
+    return out
+
+
+def compile_spec(spec):
+    """Compile `spec` into a reusable ``validator(fields)`` callable.
+
+    The validator raises SchemaError on the first missing required field
+    (spec order), then on the first rule violation (spec order, and within
+    a field the fixed rule order). On success it returns a new dict with
+    every ``non_empty`` field stripped; `fields` is never mutated. Fields
+    absent from the spec pass through untouched."""
+    _validate_spec(spec)
+    required = [f for f, rules in spec.items() if rules.get("required")]
+
+    def validator(fields):
+        missing = check_required(fields, required)
+        if missing:
+            raise SchemaError(format_error("missing", field=missing[0]))
+        for field, rules in spec.items():
+            if field not in fields:
+                continue
+            message = _check_rules(field, fields[field], rules)
+            if message is not None:
+                raise SchemaError(message)
+        return _normalize(spec, fields)
+
+    return validator
+
+
+def validate_collect(spec, fields):
+    """Every error `fields` produces against `spec`: the missing-required
+    messages in spec order, then at most one message per present field
+    (its first failing rule), also in spec order. [] when clean."""
+    _validate_spec(spec)
+    required = [f for f, rules in spec.items() if rules.get("required")]
+    errors = [format_error("missing", field=f)
+              for f in check_required(fields, required)]
+    for field, rules in spec.items():
+        if field not in fields:
+            continue
+        message = _check_rules(field, fields[field], rules)
+        if message is not None:
+            errors.append(message)
+    return errors
+
+
+def merge_specs(a, b):
+    """A new spec unioning `a` and `b`. A rule key set on both sides of the
+    same field must agree; unequal values raise ValueError. Neither input
+    is mutated."""
+    merged = {field: dict(rules) for field, rules in a.items()}
+    for field, rules in b.items():
+        target = merged.setdefault(field, {})
+        for key, value in rules.items():
+            if key in target and target[key] != value:
+                raise ValueError(
+                    "conflicting rule %r on field %r: %r != %r"
+                    % (key, field, target[key], value))
+            target[key] = value
+    return merged
+
+
+def describe_spec(spec):
+    """One line per field in sorted order, each ``"<field>: k=v, k=v"`` with
+    the rule keys sorted."""
+    if not spec:
+        return "(empty spec)"
+    lines = []
+    for field in sorted(spec):
+        rules = spec[field]
+        rendered = ", ".join("%s=%s" % (key, rules[key])
+                             for key in sorted(rules))
+        lines.append("%s: %s" % (field, rendered))
+    return "\n".join(lines)
+
+
+def diff_specs(a, b):
+    """{"added": [...], "removed": [...], "changed": [...]} — fields only in
+    `b`, only in `a`, and in both with unequal rules. Each list sorted."""
+    return {
+        "added": sorted(set(b) - set(a)),
+        "removed": sorted(set(a) - set(b)),
+        "changed": sorted(f for f in set(a) & set(b) if a[f] != b[f]),
+    }
+
+
+def spec_from_config(config, prefix):
+    """Every `prefix`-prefixed config key as a spec field (prefix stripped);
+    unprefixed keys are ignored."""
+    return {key[len(prefix):]: dict(value)
+            for key, value in config.items() if key.startswith(prefix)}
+
+
+def spec_to_config(spec, prefix):
+    """The inverse of spec_from_config: {prefix + field: rules copy}."""
+    return {prefix + field: dict(rules) for field, rules in spec.items()}
+
+
+def spec_summary_line(spec):
+    """``"<N> fields, <M> rules"`` — fields and total rules across them."""
+    return "%d fields, %d rules" % (
+        len(spec), sum(len(rules) for rules in spec.values()))
diff --git a/app/tabular.py b/app/tabular.py
new file mode 100644
index 0000000..bbe446b
--- /dev/null
+++ b/app/tabular.py
@@ -0,0 +1,155 @@
+"""Column-model toolkit shared by every export format.
+
+`app/export.py` builds all of its formats on these helpers, so the key
+union, the `str()` rendering of a cell, and the per-format escaping live
+here exactly once. Every helper that takes a `value` renders it through
+`cell` first, which means `None` is uniformly an empty cell.
+
+Alignment is spelled with the strings "left" and "right"; `pad` is the one
+place that vocabulary is validated, and everything that aligns (`fit`,
+`render_row`, and `export.to_markdown`) delegates to it rather than
+repeating the check.
+"""
+
+ALIGNMENTS = ("left", "right")
+
+
+def columns(records):
+    """The sorted union of every key across `records`.
+
+    Records need not share a key set; a key present on any record earns a
+    column, and `columns([])` is `[]` (an empty export has no columns)."""
+    names = set()
+    for record in records:
+        names.update(record)
+    return sorted(names)
+
+
+def cell(value):
+    """Render one value as text: `None` is the empty cell, everything else
+    is plain `str()` (so an int renders without a trailing `.0`)."""
+    if value is None:
+        return ""
+    return str(value)
+
+
+def escape_csv(value):
+    """Render `value` as a CSV cell, quoting only when it has to.
+
+    A cell containing a comma, a double-quote, or a newline is wrapped in
+    double-quotes with its inner quotes doubled; anything else — including
+    the empty cell — is returned as rendered."""
+    text = cell(value)
+    if any(ch in text for ch in (",", '"', "\n")):
+        return '"' + text.replace('"', '""') + '"'
+    return text
+
+
+def widths(records, cols):
+    """Map each column in `cols` to its display width: the longer of the
+    column name and the widest rendered cell in that column."""
+    result = {}
+    for col in cols:
+        widest = len(col)
+        for record in records:
+            widest = max(widest, len(cell(record.get(col))))
+        result[col] = widest
+    return result
+
+
+def pad(value, width, align):
+    """Pad a rendered value out to `width` per `align`.
+
+    A value already at or beyond `width` is returned unchanged — padding
+    never truncates; use `truncate` or `fit` for that. `align` is validated
+    before the width is even looked at, so an unknown alignment is reported
+    rather than silently accepted on a value that needed no padding."""
+    if align not in ALIGNMENTS:
+        raise ValueError("unknown align: %s" % (align,))
+    text = cell(value)
+    if len(text) >= width:
+        return text
+    filler = " " * (width - len(text))
+    if align == "left":
+        return text + filler
+    return filler + text
+
+
+def sanitize_flat(value):
+    """Render `value` for a single-line, character-delimited format: every
+    tab and newline becomes one space so the grid can't be broken from
+    inside a cell. A value with neither passes through unchanged."""
+    text = cell(value)
+    return text.replace("\t", " ").replace("\n", " ")
+
+
+def escape_html(value):
+    """Render `value` as HTML text content. The ampersand is escaped first
+    so the escapes this introduces are not themselves re-escaped."""
+    text = cell(value)
+    text = text.replace("&", "&amp;")
+    text = text.replace("<", "&lt;").replace(">", "&gt;")
+    return text.replace('"', "&quot;")
+
+
+def truncate(value, width, marker="..."):
+    """Shorten a rendered value to at most `width` characters.
+
+    A value that already fits is returned unchanged; a longer one keeps its
+    first `width - len(marker)` characters and ends with `marker`, so the
+    result is exactly `width` wide. A `width` too narrow to hold the marker
+    is a caller error."""
+    if width < len(marker):
+        raise ValueError(
+            "width %s is narrower than marker %r" % (width, marker))
+    text = cell(value)
+    if len(text) <= width:
+        return text
+    return text[:width - len(marker)] + marker
+
+
+def wrap(value, width):
+    """Greedily wrap a rendered value into lines of at most `width`.
+
+    Breaks on spaces; a single word longer than `width` is hard-split at
+    `width` rather than overflowing. An empty value wraps to `[""]` — one
+    empty line, not zero lines."""
+    if width < 1:
+        raise ValueError("width must be at least 1, got %s" % (width,))
+    text = cell(value)
+    lines = []
+    current = ""
+    for word in text.split():
+        while len(word) > width:
+            if current:
+                lines.append(current)
+                current = ""
+            lines.append(word[:width])
+            word = word[width:]
+        if not current:
+            current = word
+        elif len(current) + 1 + len(word) <= width:
+            current += " " + word
+        else:
+            lines.append(current)
+            current = word
+    if current or not lines:
+        lines.append(current)
+    return lines
+
+
+def fit(value, width, align):
+    """Render a value into exactly one `width`-wide column cell: truncated
+    when it is too long, padded per `align` when it is too short."""
+    return pad(truncate(value, width), width, align)
+
+
+def render_row(cells, widths_list, align="left"):
+    """Render one pipe-table row: each cell padded to its width, joined by
+    ` | ` and fenced with `| ` / ` |`."""
+    if len(cells) != len(widths_list):
+        raise ValueError("expected %s cells, got %s" % (
+            len(widths_list), len(cells)))
+    padded = [pad(value, width, align)
+              for value, width in zip(cells, widths_list)]
+    return "| " + " | ".join(padded) + " |"
diff --git a/app/throttle.py b/app/throttle.py
new file mode 100644
index 0000000..0be7de1
--- /dev/null
+++ b/app/throttle.py
@@ -0,0 +1,89 @@
+"""Per-route throttling policies over `app.quota`.
+
+A library layer for future routes: it is deliberately NOT wired into the
+registry. Policy keys are "<METHOD> <path-prefix>" strings mapping to a
+{"limit", "window", "burst"} dict; `match_policy` resolves a request to the
+policy with the longest matching prefix.
+
+This module imports `app.quota` only — never `app.ratelimit` — and holds no
+state of its own beyond the `POLICIES` constant; all counting lives in the
+quota store.
+"""
+from app import quota
+
+
+class PolicyError(Exception):
+    """Raised when a request exceeds its matched throttling policy."""
+
+
+POLICIES = {
+    "POST /records": {"limit": 5, "window": 60, "burst": 0},
+    "GET /export": {"limit": 10, "window": 60, "burst": 2},
+}
+
+
+def _policies(policies):
+    return POLICIES if policies is None else policies
+
+
+def match_policy(method, path, policies=None):
+    """Return the policy for `method` + `path`, or None if none matches.
+
+    A policy key matches when its method is exactly `method` and its path
+    prefix is a prefix of `path`; the longest matching prefix wins."""
+    best_prefix = None
+    best_policy = None
+    for key, policy in _policies(policies).items():
+        key_method, _, prefix = key.partition(" ")
+        if key_method != method or not path.startswith(prefix):
+            continue
+        if best_prefix is None or len(prefix) > len(best_prefix):
+            best_prefix = prefix
+            best_policy = policy
+    return best_policy
+
+
+def key_for(method, path, actor):
+    """The quota key a (method, path, actor) triple counts against."""
+    return "%s %s:%s" % (method, path, actor)
+
+
+def enforce(method, path, actor, policies=None):
+    """Record a hit against the matched policy and return the count.
+
+    Returns None (recording nothing) when no policy matches; raises
+    PolicyError when the matched policy is exhausted."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    key = key_for(method, path, actor)
+    try:
+        return quota.take(key, policy["limit"], policy["window"],
+                          burst=policy.get("burst", 0))
+    except quota.QuotaExceededError as err:
+        raise PolicyError("policy limit exceeded for %s: limit %s" % (
+            key, policy["limit"])) from err
+
+
+def remaining_for(method, path, actor, policies=None):
+    """How many calls the matched policy still allows, or None if no policy
+    matches. Records nothing."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    return quota.remaining(key_for(method, path, actor), policy["limit"],
+                           policy["window"], burst=policy.get("burst", 0))
+
+
+def describe_policies(policies=None):
+    """Render the policy table as one sorted line per key, or the literal
+    "(no policies)" when the table is empty."""
+    table = _policies(policies)
+    if not table:
+        return "(no policies)"
+    return "\n".join(
+        "%s: limit=%s, window=%s, burst=%s" % (
+            key, table[key]["limit"], table[key]["window"],
+            table[key].get("burst", 0))
+        for key in sorted(table)
+    )
diff --git a/app/validation.py b/app/validation.py
new file mode 100644
index 0000000..03b6016
--- /dev/null
+++ b/app/validation.py
@@ -0,0 +1,102 @@
+"""Input validation for record creation.
+
+`validate_fields` is the single entry point: it checks the configured
+required fields first (in order), then the value rules for the `amount` and
+`name` fields when those keys are present, and returns a normalized copy.
+Every message it raises is built by `schema.format_error`, so the catalog
+stays the one place a wording lives.
+"""
+import re
+
+from app import schema
+
+
+class ValidationError(Exception):
+    """Raised when a fields dict violates the configured validation policy."""
+
+
+def validate_fields(fields, required_fields, max_amount):
+    """Validate `fields` and return a normalized shallow copy.
+
+    Required fields are checked first, in `required_fields` order. `amount`
+    and `name` are only checked when present, since a differently-configured
+    caller may not require them. On success the copy has `name` stripped;
+    every other key and value is passed through unchanged (mutable values
+    are the same objects, not deep copies)."""
+    missing = schema.check_required(fields, required_fields)
+    if missing:
+        raise ValidationError(schema.format_error("missing", field=missing[0]))
+    if "amount" in fields:
+        amount = fields["amount"]
+        if not schema.is_valid_amount(amount):
+            raise ValidationError(schema.format_error(
+                "numeric", field="amount", got=type(amount).__name__))
+        if amount < 0:
+            raise ValidationError(
+                schema.format_error("non_negative", field="amount"))
+        if amount > max_amount:
+            raise ValidationError(
+                schema.format_error("max", field="amount", limit=max_amount))
+    if "name" in fields:
+        if not schema.is_non_empty_str(fields["name"]):
+            raise ValidationError(
+                schema.format_error("non_empty", field="name"))
+    validated = dict(fields)
+    if "name" in validated:
+        validated["name"] = validated["name"].strip()
+    return validated
+
+
+def validate_many(entries, required_fields, max_amount):
+    """Validate a list of fields dicts. Returns (validated, errors): the
+    successfully validated new dicts in input order, and (index, message)
+    pairs for the failures, also in input order."""
+    validated = []
+    errors = []
+    for index, fields in enumerate(entries):
+        try:
+            validated.append(
+                validate_fields(fields, required_fields, max_amount))
+        except ValidationError as err:
+            errors.append((index, str(err)))
+    return (validated, errors)
+
+
+def _template_pattern(template):
+    """A regex matching a catalog template with its {placeholders} filled."""
+    literals = re.split(r"\{[^{}]*\}", template)
+    return re.compile(
+        "\\A" + "(.+?)".join(re.escape(part) for part in literals) + "\\Z")
+
+
+def _literal_length(template):
+    return sum(len(part) for part in re.split(r"\{[^{}]*\}", template))
+
+
+def error_code(message):
+    """Map a rendered error message back to its ERROR_CATALOG code.
+
+    The matcher is derived from the catalog at call time, so it follows any
+    change to the templates. Templates whose rendered forms can overlap (a
+    field name may contain spaces) are disambiguated by preferring the most
+    specific match — the one with the most literal text."""
+    matches = [code for code, template in schema.ERROR_CATALOG.items()
+               if _template_pattern(template).match(message)]
+    if not matches:
+        raise ValueError("unrecognized error message: %r" % (message,))
+    return max(matches, key=lambda code: _literal_length(
+        schema.ERROR_CATALOG[code]))
+
+
+def explain_config(config):
+    """Render the validation policy held in `config` as three lines."""
+    return "validation config:\n  required: %s\n  max_amount: %s" % (
+        ", ".join(config["validation_required_fields"]),
+        config["validation_max_amount"])
+
+
+def pre_create_hook(store, config, fields):
+    """PRE_CREATE_HOOKS entry point: validate a create's fields against the
+    configured policy. `store` is unused."""
+    return validate_fields(fields, config["validation_required_fields"],
+                           config["validation_max_amount"])
diff --git a/tests/test_audit.py b/tests/test_audit.py
new file mode 100644
index 0000000..2419f13
--- /dev/null
+++ b/tests/test_audit.py
@@ -0,0 +1,215 @@
+"""Tests for app/audit.py — the module-global audit log of dispatched calls.
+
+The log is module state, so every test calls `audit.clear()` first and the
+autouse fixture clears again afterwards: no test may leak entries into a
+later test or a later test file.
+"""
+import pytest
+
+from app import audit
+from app.registry import DEFAULT_CONFIG, DISPATCH_HOOKS
+
+
+@pytest.fixture(autouse=True)
+def _clean_audit_state():
+    """Leave no module-global log state behind for later test files."""
+    yield
+    audit.clear()
+
+
+def test_registry_defaults_carry_the_audit_config_block():
+    assert DEFAULT_CONFIG["audit_log_enabled"] is True
+    assert DEFAULT_CONFIG["audit_log_max_entries"] == 500
+    assert DEFAULT_CONFIG["audit_query_default_limit"] == 100
+
+
+def test_registry_registers_the_audit_dispatch_hook():
+    assert audit.dispatch_hook in DISPATCH_HOOKS
+
+
+def test_entries_on_a_fresh_log_is_empty():
+    audit.clear()
+    assert audit.entries() == []
+
+
+def test_record_appends_exactly_one_entry_with_the_three_fields():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+    ]
+
+
+def test_entries_are_returned_in_call_order():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    audit.record("POST", "/records", "bob", 500)
+    audit.record("DELETE", "/records/{id}", "carol", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/{id}", "actor": "carol"},
+    ]
+
+
+def test_entries_returns_a_copy_the_caller_cannot_use_to_mutate_the_log():
+    audit.clear()
+    audit.record("GET", "/records", "alice", 500)
+    returned = audit.entries()
+    returned.append({"method": "POST", "path": "/records", "actor": "mallory"})
+    returned[0]["actor"] = "mallory"
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+    ]
+
+
+def test_cap_keeps_the_last_entries_and_drops_the_oldest_first():
+    audit.clear()
+    audit.record("GET", "/a", "alice", 3)
+    audit.record("GET", "/b", "bob", 3)
+    audit.record("GET", "/c", "carol", 3)
+    audit.record("GET", "/d", "dan", 3)
+    assert len(audit.entries()) == 3
+    assert audit.entries() == [
+        {"method": "GET", "path": "/b", "actor": "bob"},
+        {"method": "GET", "path": "/c", "actor": "carol"},
+        {"method": "GET", "path": "/d", "actor": "dan"},
+    ]
+
+
+def test_cap_is_enforced_on_every_call_not_only_at_the_end():
+    audit.clear()
+    paths = ["/a", "/b", "/c", "/d", "/e"]
+    for path in paths:
+        audit.record("GET", path, "alice", 2)
+        assert len(audit.entries()) <= 2
+    assert audit.entries() == [
+        {"method": "GET", "path": "/d", "actor": "alice"},
+        {"method": "GET", "path": "/e", "actor": "alice"},
+    ]
+
+
+def test_dispatch_hook_defaults_the_actor_to_anonymous():
+    audit.clear()
+    audit.dispatch_hook(None, {"audit_log_max_entries": 500},
+                        "GET", "/records", {})
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "anonymous"},
+    ]
+
+
+def test_dispatch_hook_reads_the_actor_kwarg_and_leaks_no_record_fields():
+    audit.clear()
+    audit.dispatch_hook(None, {"audit_log_max_entries": 500},
+                        "POST", "/records", {"actor": "bob", "name": "x"})
+    assert audit.entries() == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+    ]
+    assert sorted(audit.entries()[0]) == ["actor", "method", "path"]
+
+
+def test_dispatch_hook_reads_its_cap_from_the_config():
+    audit.clear()
+    config = {"audit_log_max_entries": 1}
+    audit.dispatch_hook(None, config, "GET", "/records", {"actor": "alice"})
+    audit.dispatch_hook(None, config, "GET", "/report", {"actor": "bob"})
+    assert audit.entries() == [
+        {"method": "GET", "path": "/report", "actor": "bob"},
+    ]
+
+
+def test_dispatch_hook_fires_for_every_method():
+    audit.clear()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(None, config, "DELETE", "/records/{id}",
+                        {"actor": "alice"})
+    audit.dispatch_hook(None, config, "PUT", "/records/{id}",
+                        {"actor": "bob"})
+    assert audit.entries() == [
+        {"method": "DELETE", "path": "/records/{id}", "actor": "alice"},
+        {"method": "PUT", "path": "/records/{id}", "actor": "bob"},
+    ]
+
+
+def test_record_many_appends_in_order_capping_after_every_append(monkeypatch):
+    audit.clear()
+    real_record = audit.record
+    lengths = []
+
+    def _spy(method, path, actor, max_entries):
+        result = real_record(method, path, actor, max_entries)
+        lengths.append(len(audit.entries()))
+        return result
+
+    monkeypatch.setattr(audit, "record", _spy)
+    triples = [
+        ("GET", "/a", "alice"),
+        ("POST", "/b", "bob"),
+        ("GET", "/c", "carol"),
+        ("PUT", "/d", "dan"),
+    ]
+    assert audit.record_many(triples, 2) == 4
+    assert lengths == [1, 2, 2, 2]
+    assert audit.entries() == [
+        {"method": "GET", "path": "/c", "actor": "carol"},
+        {"method": "PUT", "path": "/d", "actor": "dan"},
+    ]
+
+
+def test_dropped_counts_evictions_since_the_last_clear():
+    audit.clear()
+    assert audit.dropped() == 0
+    for path in ["/a", "/b", "/c", "/d", "/e"]:
+        audit.record("GET", path, "alice", 3)
+    assert audit.dropped() == 2
+    audit.clear()
+    assert audit.dropped() == 0
+
+
+def test_export_state_returns_the_shape_and_copies_the_entries():
+    audit.clear()
+    audit.record("GET", "/a", "alice", 2)
+    audit.record("POST", "/b", "bob", 2)
+    audit.record("GET", "/c", "carol", 2)
+    state = audit.export_state()
+    assert state == {
+        "entries": [
+            {"method": "POST", "path": "/b", "actor": "bob"},
+            {"method": "GET", "path": "/c", "actor": "carol"},
+        ],
+        "dropped": 1,
+    }
+    state["entries"].append({"method": "PUT", "path": "/x", "actor": "m"})
+    state["entries"][0]["actor"] = "mallory"
+    assert audit.entries() == [
+        {"method": "POST", "path": "/b", "actor": "bob"},
+        {"method": "GET", "path": "/c", "actor": "carol"},
+    ]
+
+
+def test_import_state_round_trips_and_copies_what_it_is_given():
+    audit.clear()
+    audit.record("GET", "/a", "alice", 2)
+    audit.record("POST", "/b", "bob", 2)
+    audit.record("GET", "/c", "carol", 2)
+    state = audit.export_state()
+
+    audit.clear()
+    assert audit.entries() == []
+    assert audit.dropped() == 0
+
+    audit.import_state(state)
+    assert audit.entries() == [
+        {"method": "POST", "path": "/b", "actor": "bob"},
+        {"method": "GET", "path": "/c", "actor": "carol"},
+    ]
+    assert audit.dropped() == 1
+
+    state["entries"].append({"method": "PUT", "path": "/x", "actor": "m"})
+    state["entries"][0]["actor"] = "mallory"
+    state["dropped"] = 99
+    assert audit.entries() == [
+        {"method": "POST", "path": "/b", "actor": "bob"},
+        {"method": "GET", "path": "/c", "actor": "carol"},
+    ]
+    assert audit.dropped() == 1
diff --git a/tests/test_audit_query.py b/tests/test_audit_query.py
new file mode 100644
index 0000000..5dd2323
--- /dev/null
+++ b/tests/test_audit_query.py
@@ -0,0 +1,439 @@
+"""Tests for app/audit_query.py — the pure read side over audit entries.
+
+Every function under test takes a plain list of entry dicts and never
+mutates it, so each test snapshots its fixture with `copy.deepcopy` and
+asserts the input is unchanged afterwards. Only the final integration test
+touches `app.audit`; the query module itself never imports it.
+"""
+import copy
+
+import pytest
+
+from app import audit, audit_query
+
+
+def _entries():
+    """The shared 4-entry fixture: one method used by two actors ("POST":
+    bob and alice) and one actor using two methods (alice: GET, POST)."""
+    return [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "GET", "path": "/report", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+
+
+@pytest.fixture(autouse=True)
+def _clean_audit_state():
+    """The integration test writes the module-global log; leave it clean."""
+    yield
+    audit.clear()
+
+
+def test_filter_entries_matches_each_criterion_ands_them_and_copies():
+    entries = _entries()
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.filter_entries(entries, actor="alice") == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "GET", "path": "/report", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    assert audit_query.filter_entries(entries, method="POST") == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    assert audit_query.filter_entries(entries, path="/records") == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    assert audit_query.filter_entries(entries, actor="alice",
+                                      method="POST") == [
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    assert audit_query.filter_entries(entries) == entries
+
+    first = audit_query.filter_entries(entries, method="GET")
+    first.append({"method": "PUT", "path": "/x", "actor": "mallory"})
+    assert len(audit_query.filter_entries(entries, method="GET")) == 2
+    assert entries == snapshot
+
+
+def test_counts_by_returns_value_to_count_and_rejects_other_fields():
+    entries = _entries()
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.counts_by(entries, "method") == {"GET": 2, "POST": 2}
+    assert audit_query.counts_by(entries, "actor") == {"alice": 3, "bob": 1}
+    assert audit_query.counts_by(entries, "path") == {"/records": 3,
+                                                      "/report": 1}
+    assert audit_query.counts_by([], "method") == {}
+
+    with pytest.raises(ValueError) as err:
+        audit_query.counts_by(entries, "status")
+    assert "status" in str(err.value)
+    assert entries == snapshot
+
+
+def test_last_n_returns_the_final_entries_and_rejects_a_negative_n():
+    entries = _entries()
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.last_n(entries, 2) == [
+        {"method": "GET", "path": "/report", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    assert audit_query.last_n(entries, 0) == []
+    assert audit_query.last_n(entries, 99) == entries
+
+    whole = audit_query.last_n(entries, 99)
+    whole.append({"method": "PUT", "path": "/x", "actor": "mallory"})
+    assert len(audit_query.last_n(entries, 99)) == 4
+
+    with pytest.raises(ValueError):
+        audit_query.last_n(entries, -1)
+    assert entries == snapshot
+
+
+def test_redact_replaces_only_the_named_fields_in_new_dicts():
+    entries = _entries()
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.redact(entries, ["actor"]) == [
+        {"method": "GET", "path": "/records", "actor": "***"},
+        {"method": "POST", "path": "/records", "actor": "***"},
+        {"method": "GET", "path": "/report", "actor": "***"},
+        {"method": "POST", "path": "/records", "actor": "***"},
+    ]
+
+    untouched = audit_query.redact(entries, [])
+    assert untouched == entries
+    for original, produced in zip(entries, untouched):
+        assert produced is not original
+
+    with pytest.raises(ValueError) as err:
+        audit_query.redact(entries, ["status"])
+    assert "status" in str(err.value)
+    assert entries == snapshot
+
+
+def test_summary_reports_totals_counts_and_copies_of_first_and_last():
+    entries = _entries()
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.summary([]) == {
+        "total": 0,
+        "by_method": {},
+        "by_actor": {},
+        "first": None,
+        "last": None,
+    }
+    result = audit_query.summary(entries)
+    assert result == {
+        "total": 4,
+        "by_method": {"GET": 2, "POST": 2},
+        "by_actor": {"alice": 3, "bob": 1},
+        "first": {"method": "GET", "path": "/records", "actor": "alice"},
+        "last": {"method": "POST", "path": "/records", "actor": "alice"},
+    }
+    assert result["first"] is not entries[0]
+    assert result["last"] is not entries[-1]
+    assert entries == snapshot
+
+
+def test_recent_returns_the_last_n_from_the_configured_default_limit():
+    entries = _entries()[:3]
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.recent(entries, {"audit_query_default_limit": 2}) == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "GET", "path": "/report", "actor": "alice"},
+    ]
+    assert entries == snapshot
+
+
+def test_paginate_returns_one_based_pages_with_copied_items():
+    entries = _entries() + [
+        {"method": "DELETE", "path": "/records/{id}", "actor": "carol"},
+    ]
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.paginate(entries, 1, 2) == {
+        "page": 1,
+        "pages": 3,
+        "total": 5,
+        "items": [
+            {"method": "GET", "path": "/records", "actor": "alice"},
+            {"method": "POST", "path": "/records", "actor": "bob"},
+        ],
+    }
+    assert audit_query.paginate(entries, 2, 2) == {
+        "page": 2,
+        "pages": 3,
+        "total": 5,
+        "items": [
+            {"method": "GET", "path": "/report", "actor": "alice"},
+            {"method": "POST", "path": "/records", "actor": "alice"},
+        ],
+    }
+    assert audit_query.paginate(entries, 3, 2) == {
+        "page": 3,
+        "pages": 3,
+        "total": 5,
+        "items": [
+            {"method": "DELETE", "path": "/records/{id}", "actor": "carol"},
+        ],
+    }
+    assert audit_query.paginate(entries, 4, 2) == {
+        "page": 4,
+        "pages": 3,
+        "total": 5,
+        "items": [],
+    }
+    assert audit_query.paginate([], 1, 2) == {
+        "page": 1,
+        "pages": 0,
+        "total": 0,
+        "items": [],
+    }
+
+    page = audit_query.paginate(entries, 1, 2)
+    page["items"][0]["actor"] = "mallory"
+    page["items"].append({"method": "PUT", "path": "/x", "actor": "mallory"})
+
+    with pytest.raises(ValueError):
+        audit_query.paginate(entries, 0, 2)
+    with pytest.raises(ValueError):
+        audit_query.paginate(entries, 1, 0)
+    assert entries == snapshot
+
+
+def test_to_report_renders_the_exact_plain_text_report():
+    entries = _entries()
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.to_report(entries) == (
+        "audit report\n"
+        "total: 4\n"
+        "\n"
+        "by method:\n"
+        "  GET: 2\n"
+        "  POST: 2\n"
+        "\n"
+        "by actor:\n"
+        "  alice: 3\n"
+        "  bob: 1"
+    )
+    assert audit_query.to_report([]) == "audit report\ntotal: 0"
+    assert entries == snapshot
+
+
+def test_to_csv_report_renders_the_exact_csv_rows():
+    entries = _entries()
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.to_csv_report(entries) == (
+        "field,value,count\n"
+        "method,GET,2\n"
+        "method,POST,2\n"
+        "actor,alice,3\n"
+        "actor,bob,1"
+    )
+    assert audit_query.to_csv_report([]) == "field,value,count"
+    assert entries == snapshot
+
+
+def test_top_actors_sorts_by_count_desc_then_actor_asc_and_truncates():
+    entries = [
+        {"method": "GET", "path": "/records", "actor": "dave"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+        {"method": "GET", "path": "/report", "actor": "dave"},
+        {"method": "GET", "path": "/records", "actor": "bob"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.top_actors(entries, 3) == [
+        ("alice", 2), ("dave", 2), ("bob", 1),
+    ]
+    assert audit_query.top_actors(entries, 2) == [("alice", 2), ("dave", 2)]
+    assert audit_query.top_actors(entries, 0) == []
+
+    with pytest.raises(ValueError):
+        audit_query.top_actors(entries, -1)
+    assert entries == snapshot
+
+
+def test_merge_entries_concatenates_copies_in_argument_order():
+    left = _entries()[:2]
+    right = _entries()[2:]
+    snapshot = copy.deepcopy(left) + copy.deepcopy(right)
+
+    merged = audit_query.merge_entries(left, right)
+    assert merged == snapshot
+    merged[0]["actor"] = "mallory"
+    merged.append({"method": "PUT", "path": "/x", "actor": "mallory"})
+    assert left + right == snapshot
+    assert audit_query.merge_entries() == []
+
+
+def test_diff_summaries_reports_only_the_changed_counts():
+    before = audit_query.summary([
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/{id}", "actor": "dan"},
+    ])
+    after = audit_query.summary([
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "GET", "path": "/records", "actor": "carol"},
+        {"method": "GET", "path": "/report", "actor": "carol"},
+        {"method": "DELETE", "path": "/records/{id}", "actor": "dan"},
+    ])
+
+    assert audit_query.diff_summaries(before, after) == {
+        "total": 1,
+        "by_method": {"GET": 2, "POST": -1},
+        "by_actor": {"bob": -1, "carol": 2},
+    }
+
+
+def test_counts_matrix_nests_method_then_actor_over_occurring_pairs_only():
+    entries = _entries()
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.counts_matrix(entries) == {
+        "GET": {"alice": 2},
+        "POST": {"bob": 1, "alice": 1},
+    }
+    assert audit_query.counts_matrix([]) == {}
+    assert entries == snapshot
+
+
+def test_rollup_generalizes_counts_by_and_counts_matrix():
+    entries = _entries()
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.rollup(entries, ["method"]) == audit_query.counts_by(
+        entries, "method")
+    assert audit_query.rollup(entries, ["method", "actor"]) == (
+        audit_query.counts_matrix(entries))
+    assert audit_query.rollup(entries, ["actor", "method", "path"]) == {
+        "alice": {
+            "GET": {"/records": 1, "/report": 1},
+            "POST": {"/records": 1},
+        },
+        "bob": {"POST": {"/records": 1}},
+    }
+    assert audit_query.rollup([], ["method"]) == {}
+
+    with pytest.raises(ValueError):
+        audit_query.rollup(entries, [])
+    with pytest.raises(ValueError) as err:
+        audit_query.rollup(entries, ["status"])
+    assert "status" in str(err.value)
+    with pytest.raises(ValueError):
+        audit_query.rollup(entries, ["method", "method"])
+    assert entries == snapshot
+
+
+def test_format_entry_and_to_lines_render_one_line_per_entry():
+    entries = _entries()[:3]
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.format_entry(entries[0]) == "GET /records (alice)"
+    assert audit_query.to_lines(entries) == [
+        "GET /records (alice)",
+        "POST /records (bob)",
+        "GET /report (alice)",
+    ]
+    assert audit_query.to_lines([]) == []
+
+    with pytest.raises(ValueError) as err:
+        audit_query.format_entry({"method": "GET", "path": "/records"})
+    assert "actor" in str(err.value)
+    with pytest.raises(ValueError) as err:
+        audit_query.format_entry({"path": "/records", "actor": "alice"})
+    assert "method" in str(err.value)
+    with pytest.raises(ValueError) as err:
+        audit_query.format_entry({"method": "GET", "actor": "alice"})
+    assert "path" in str(err.value)
+    assert entries == snapshot
+
+
+def test_group_by_maps_each_value_to_copies_of_its_entries():
+    entries = _entries()
+    snapshot = copy.deepcopy(entries)
+
+    grouped = audit_query.group_by(entries, "method")
+    assert grouped == {
+        "GET": [
+            {"method": "GET", "path": "/records", "actor": "alice"},
+            {"method": "GET", "path": "/report", "actor": "alice"},
+        ],
+        "POST": [
+            {"method": "POST", "path": "/records", "actor": "bob"},
+            {"method": "POST", "path": "/records", "actor": "alice"},
+        ],
+    }
+    grouped["GET"][0]["actor"] = "mallory"
+    assert audit_query.group_by([], "method") == {}
+
+    with pytest.raises(ValueError) as err:
+        audit_query.group_by(entries, "status")
+    assert "status" in str(err.value)
+    assert entries == snapshot
+
+
+def test_search_matches_a_substring_of_any_field_in_original_order():
+    entries = _entries() + [
+        {"method": "DELETE", "path": "/records/{id}", "actor": "reporter"},
+    ]
+    snapshot = copy.deepcopy(entries)
+
+    # "repo" matches entry 2 by path and entry 4 by actor.
+    found = audit_query.search(entries, "repo")
+    assert found == [
+        {"method": "GET", "path": "/report", "actor": "alice"},
+        {"method": "DELETE", "path": "/records/{id}", "actor": "reporter"},
+    ]
+    found[0]["actor"] = "mallory"
+    assert audit_query.search(entries, "POST") == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "POST", "path": "/records", "actor": "alice"},
+    ]
+    assert audit_query.search(entries, "nope") == []
+
+    with pytest.raises(ValueError):
+        audit_query.search(entries, "")
+    assert entries == snapshot
+
+
+def test_to_markdown_report_renders_the_exact_pipe_table():
+    entries = _entries()
+    snapshot = copy.deepcopy(entries)
+
+    assert audit_query.to_markdown_report(entries) == (
+        "| field | value | count |\n"
+        "| --- | --- | --- |\n"
+        "| method | GET | 2 |\n"
+        "| method | POST | 2 |\n"
+        "| actor | alice | 3 |\n"
+        "| actor | bob | 1 |"
+    )
+    assert audit_query.to_markdown_report([]) == (
+        "| field | value | count |\n"
+        "| --- | --- | --- |"
+    )
+    assert entries == snapshot
+
+
+def test_filter_entries_reads_back_a_live_audit_log():
+    audit.clear()
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(None, config, "GET", "/records", {"actor": "alice"})
+    audit.dispatch_hook(None, config, "POST", "/records", {"actor": "bob"})
+
+    assert audit_query.filter_entries(audit.entries(), actor="bob") == [
+        {"method": "POST", "path": "/records", "actor": "bob"},
+    ]
