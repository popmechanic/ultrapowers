index 0000000..601b296
--- /dev/null
+++ b/app/quota.py
@@ -0,0 +1,137 @@
+"""Windowed quota counter over a deterministic logical clock.
+
+This module owns all counting state for the rate-limit feature: a module
+global clock (`_clock`, seconds as a float) and a module global hits store
+(`_hits`, key -> list of hit timestamps). No wall-clock time is read
+anywhere, so behavior is fully deterministic: the clock only moves when a
+caller calls `advance()`, which makes tests reproducible and makes shipped
+behavior pure call-counting.
+
+A hit is "in window" when it is not strictly older than `now() -
+window_seconds`; a hit sitting exactly on that boundary still counts. A
+`window_seconds` of `float("inf")` therefore never prunes anything.
+
+`remaining`, `snapshot`, `time_to_next_slot` and `usage` are read-only:
+they never record a hit and never mutate the store.
+"""
+
+
+class QuotaExceededError(Exception):
+    """Raised when a key has no allowance left in the current window."""
+
+
+_clock = 0.0
+_hits = {}
+
+
+def reset():
+    """Reset the logical clock to 0.0 and drop every key's hits."""
+    global _clock
+    _clock = 0.0
+    _hits.clear()
+
+
+def now():
+    """Return the current logical clock value, in seconds."""
+    return _clock
+
+
+def advance(seconds):
+    """Move the logical clock forward by `seconds` and return the new value.
+
+    The clock is monotonic: a negative `seconds` raises ValueError and
+    leaves the clock unchanged."""
+    global _clock
+    if seconds < 0:
+        raise ValueError("clock is monotonic: cannot advance by %r" % (seconds,))
+    _clock = float(_clock + seconds)
+    return _clock
+
+
+def _cutoff(window_seconds):
+    """The oldest timestamp still in window (hits strictly older drop)."""
+    if window_seconds == float("inf"):
+        return float("-inf")
+    return _clock - window_seconds
+
+
+def _in_window(key, window_seconds):
+    """The key's in-window hits, oldest first. Does not mutate the store."""
+    cutoff = _cutoff(window_seconds)
+    return [hit for hit in _hits.get(key, ()) if hit >= cutoff]
+
+
+def take(key, limit, window_seconds, burst=0):
+    """Record a hit for `key` and return its in-window hit count.
+
+    Raises QuotaExceededError when `key` already holds `limit + burst`
+    in-window hits. Aged-out hits are pruned from the store as a side
+    effect of the call."""
+    hits = _in_window(key, window_seconds)
+    allowed = limit + burst
+    if len(hits) >= allowed:
+        _hits[key] = hits
+        raise QuotaExceededError(
+            "quota exceeded for %s: limit %s" % (key, limit))
+    hits.append(_clock)
+    _hits[key] = hits
+    return len(hits)
+
+
+def remaining(key, limit, window_seconds, burst=0):
+    """How many takes `key` has left, floored at 0. Records nothing."""
+    used = len(_in_window(key, window_seconds))
+    return max(0, limit + burst - used)
+
+
+def snapshot(window_seconds):
+    """Map every key with at least one in-window hit to its sorted in-window
+    hit timestamps. The returned lists are copies: mutating them does not
+    affect the store."""
+    result = {}
+    for key in _hits:
+        hits = _in_window(key, window_seconds)
+        if hits:
+            result[key] = sorted(hits)
+    return result
+
+
+def time_to_next_slot(key, limit, window_seconds, burst=0):
+    """Seconds until `key` regains an allowance. Records nothing.
+
+    Returns 0.0 while allowance is left. When exhausted, returns
+    `oldest_in_window_hit + window_seconds - now()` — the instant the oldest
+    hit ages out. Because that hit is still in window at exactly that
+    instant, a 0.0 reading means the slot is about to free: callers retry
+    strictly after it. Returns float("inf") when no hit can ever free a slot
+    (an infinite window, or a zero allowance that can hold no hits)."""
+    if remaining(key, limit, window_seconds, burst=burst) > 0:
+        return 0.0
+    hits = _in_window(key, window_seconds)
+    if not hits or window_seconds == float("inf"):
+        return float("inf")
+    return min(hits) + window_seconds - _clock
+
+
+def usage(key, limit, window_seconds, burst=0):
+    """Report `key`'s full quota state as a dict. Records nothing."""
+    return {
+        "used": len(_in_window(key, window_seconds)),
+        "allowed": limit + burst,
+        "remaining": remaining(key, limit, window_seconds, burst=burst),
+        "reset_in": time_to_next_slot(key, limit, window_seconds, burst=burst),
+    }
+
+
+def purge(window_seconds):
+    """Drop every key's aged-out hits, remove keys left with none, and
+    return the total number of hits dropped."""
+    dropped = 0
+    for key in list(_hits):
+        kept = _in_window(key, window_seconds)
+        dropped += len(_hits[key]) - len(kept)
+        if kept:
+            _hits[key] = kept
+        else:
+            del _hits[key]
+    return dropped
