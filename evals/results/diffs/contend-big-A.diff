@@ -0,0 +1,330 @@
+"""Tests for the declarative field-spec toolkit in app/schema.py."""
+import math
+
+import pytest
+
+from app import schema
+
+
+def test_error_catalog_has_exactly_the_expected_keys():
+    assert set(schema.ERROR_CATALOG.keys()) == {
+        "missing", "numeric", "non_negative", "max", "non_empty", "type_str",
+    }
+    for template in schema.ERROR_CATALOG.values():
+        assert isinstance(template, str)
+
+
+def test_format_error_missing():
+    assert schema.format_error("missing", field="name") == "missing field: name"
+
+
+def test_format_error_numeric():
+    assert (
+        schema.format_error("numeric", field="amount", got="str")
+        == "field amount must be numeric (got str)"
+    )
+
+
+def test_format_error_non_negative():
+    assert (
+        schema.format_error("non_negative", field="amount")
+        == "field amount must be non-negative"
+    )
+
+
+def test_format_error_max():
+    assert (
+        schema.format_error("max", field="amount", limit=100)
+        == "field amount exceeds max_amount 100"
+    )
+
+
+def test_format_error_non_empty():
+    assert (
+        schema.format_error("non_empty", field="name")
+        == "field name must be a non-empty string"
+    )
+
+
+def test_format_error_type_str():
+    assert schema.format_error("type_str", field="name") == "field name must be a string"
+
+
+def test_format_error_unknown_code_raises_key_error():
+    with pytest.raises(KeyError):
+        schema.format_error("nope")
+
+
+def test_check_required_partial_missing():
+    assert schema.check_required({"amount": 1}, ["name", "amount"]) == ["name"]
+
+
+def test_check_required_both_missing_in_required_fields_order():
+    result = schema.check_required({"other": 1}, ["name", "amount"])
+    assert result == ["name", "amount"]
+
+
+def test_check_required_none_missing():
+    assert schema.check_required({"name": "x", "amount": 1}, ["name", "amount"]) == []
+
+
+def test_is_valid_amount_true_cases():
+    assert schema.is_valid_amount(0) is True
+    assert schema.is_valid_amount(5) is True
+    assert schema.is_valid_amount(3.5) is True
+
+
+def test_is_valid_amount_false_cases():
+    assert schema.is_valid_amount(True) is False
+    assert schema.is_valid_amount(False) is False
+    assert schema.is_valid_amount("3") is False
+    assert schema.is_valid_amount(None) is False
+    assert schema.is_valid_amount(float("nan")) is False
+    assert schema.is_valid_amount(float("inf")) is False
+    assert schema.is_valid_amount(float("-inf")) is False
+
+
+def test_is_valid_amount_overflow_edge_does_not_raise():
+    assert schema.is_valid_amount(10 ** 400) is True
+
+
+def test_is_non_empty_str_true_cases():
+    assert schema.is_non_empty_str("a") is True
+    assert schema.is_non_empty_str(" a ") is True
+
+
+def test_is_non_empty_str_false_cases():
+    assert schema.is_non_empty_str("") is False
+    assert schema.is_non_empty_str("   ") is False
+    assert schema.is_non_empty_str(42) is False
+    assert schema.is_non_empty_str(None) is False
+
+
+def test_schema_error_is_exception_subclass_distinct_from_others():
+    assert issubclass(schema.SchemaError, Exception)
+    assert not issubclass(schema.SchemaError, KeyError)
+    assert not issubclass(schema.SchemaError, ValueError)
+
+
+def test_compile_spec_unknown_rule_key_raises_value_error_naming_key():
+    with pytest.raises(ValueError, match="bogus"):
+        schema.compile_spec({"name": {"bogus": True}})
+
+
+def test_compile_spec_bad_type_value_raises_value_error_naming_value():
+    with pytest.raises(ValueError, match="int"):
+        schema.compile_spec({"name": {"type": "int"}})
+
+
+def test_compile_spec_empty_accepts_any_dict_unchanged():
+    validator = schema.compile_spec({})
+    fields = {"a": 1, "b": 2}
+    assert validator(fields) == fields
+
+
+def test_compiled_validator_checks_required_in_spec_order_first_absent():
+    spec = {"name": {"required": True}, "amount": {"required": True}}
+    validator = schema.compile_spec(spec)
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({})
+    assert str(exc.value) == "missing field: name"
+
+
+def test_compiled_validator_type_number_rejects_non_amount():
+    spec = {"amount": {"type": "number"}}
+    validator = schema.compile_spec(spec)
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"amount": "3"})
+    assert str(exc.value) == "field amount must be numeric (got str)"
+    with pytest.raises(schema.SchemaError):
+        validator({"amount": True})
+    with pytest.raises(schema.SchemaError):
+        validator({"amount": float("nan")})
+    with pytest.raises(schema.SchemaError):
+        validator({"amount": float("inf")})
+
+
+def test_compiled_validator_type_str_checked_before_non_empty():
+    spec = {"name": {"type": "str", "non_empty": True}}
+    validator = schema.compile_spec(spec)
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"name": 42})
+    assert str(exc.value) == "field name must be a string"
+
+
+def test_compiled_validator_non_empty_rule():
+    spec = {"name": {"non_empty": True}}
+    validator = schema.compile_spec(spec)
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"name": "   "})
+    assert str(exc.value) == "field name must be a non-empty string"
+
+
+def test_compiled_validator_max_rule_boundary():
+    spec = {"amount": {"max": 100}}
+    validator = schema.compile_spec(spec)
+    assert validator({"amount": 100})["amount"] == 100
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"amount": 101})
+    assert str(exc.value) == "field amount exceeds max_amount 100"
+
+
+def test_compiled_validator_max_rule_on_incomparable_value_raises_numeric():
+    spec = {"amount": {"max": 100}}
+    validator = schema.compile_spec(spec)
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"amount": "abc"})
+    assert str(exc.value) == "field amount must be numeric (got str)"
+    assert schema.validate_collect(spec, {"amount": "abc"}) == [
+        "field amount must be numeric (got str)"
+    ]
+
+
+def test_compiled_validator_success_strips_non_empty_fields_and_copies_rest():
+    spec = {"name": {"non_empty": True}, "other": {}}
+    validator = schema.compile_spec(spec)
+    fields = {"name": "  ada  ", "other": [1, 2]}
+    result = validator(fields)
+    assert result == {"name": "ada", "other": [1, 2]}
+    assert fields == {"name": "  ada  ", "other": [1, 2]}
+    assert validator(dict(fields)) == validator(dict(fields))
+
+
+def test_compiled_validator_passes_through_unspecced_fields():
+    validator = schema.compile_spec({"name": {"required": True}})
+    result = validator({"name": "x", "extra": 99})
+    assert result == {"name": "x", "extra": 99}
+
+
+def test_merge_specs_union_and_conflict():
+    a = {"name": {"required": True}}
+    b = {"name": {"non_empty": True}, "amount": {"type": "number"}}
+    merged = schema.merge_specs(a, b)
+    assert merged == {
+        "name": {"required": True, "non_empty": True},
+        "amount": {"type": "number"},
+    }
+    assert a == {"name": {"required": True}}
+    assert b == {"name": {"non_empty": True}, "amount": {"type": "number"}}
+
+
+def test_merge_specs_unequal_conflicting_value_raises_value_error():
+    a = {"amount": {"max": 100}}
+    b = {"amount": {"max": 200}}
+    with pytest.raises(ValueError, match="amount"):
+        schema.merge_specs(a, b)
+
+
+def test_merge_specs_equal_values_merge_silently():
+    a = {"amount": {"max": 100}}
+    b = {"amount": {"max": 100}}
+    assert schema.merge_specs(a, b) == {"amount": {"max": 100}}
+
+
+def test_describe_spec_two_field_literal():
+    spec = {"amount": {"max": 100, "type": "number"}, "name": {"required": True}}
+    assert schema.describe_spec(spec) == "amount: max=100, type=number\nname: required=True"
+
+
+def test_describe_spec_empty():
+    assert schema.describe_spec({}) == "(empty spec)"
+
+
+def test_diff_specs_all_three_buckets():
+    a = {
+        "name": {"required": True},
+        "removed_field": {"type": "str"},
+        "same": {"type": "str"},
+    }
+    b = {
+        "name": {"required": True, "non_empty": True},
+        "added_field": {"type": "number"},
+        "same": {"type": "str"},
+    }
+    assert schema.diff_specs(a, b) == {
+        "added": ["added_field"],
+        "removed": ["removed_field"],
+        "changed": ["name"],
+    }
+    assert a == {
+        "name": {"required": True},
+        "removed_field": {"type": "str"},
+        "same": {"type": "str"},
+    }
+    assert b == {
+        "name": {"required": True, "non_empty": True},
+        "added_field": {"type": "number"},
+        "same": {"type": "str"},
+    }
+
+
+def test_diff_specs_identical_specs_all_empty():
+    spec = {"name": {"required": True}}
+    assert schema.diff_specs(spec, dict(spec)) == {"added": [], "removed": [], "changed": []}
+
+
+def test_spec_from_config_end_to_end():
+    config = {
+        "v_name": {"required": True, "type": "str"},
+        "v_amount": {"type": "number"},
+        "other_key": "ignored",
+    }
+    spec = schema.spec_from_config(config, "v_")
+    assert spec == {
+        "name": {"required": True, "type": "str"},
+        "amount": {"type": "number"},
+    }
+    validator = schema.compile_spec(spec)
+    assert validator({"name": "ok"})["name"] == "ok"
+    with pytest.raises(schema.SchemaError):
+        validator({})
+
+
+def test_spec_to_config_exact_dict_and_no_shared_mutation():
+    spec = {"name": {"required": True}}
+    config = schema.spec_to_config(spec, "s_")
+    assert config == {"s_name": {"required": True}}
+    config["s_name"]["required"] = False
+    assert spec == {"name": {"required": True}}
+
+
+def test_spec_round_trips_both_ways():
+    spec = {"name": {"required": True}, "amount": {"type": "number"}}
+    assert schema.spec_from_config(schema.spec_to_config(spec, "s_"), "s_") == spec
+
+    config = {"s_name": {"required": True}, "s_amount": {"type": "number"}, "unrelated": 1}
+    round_tripped = schema.spec_to_config(schema.spec_from_config(config, "s_"), "s_")
+    assert round_tripped == {"s_name": {"required": True}, "s_amount": {"type": "number"}}
+
+
+def test_spec_summary_line_literal():
+    spec = {"name": {"required": True}, "amount": {"type": "number", "max": 100}}
+    assert schema.spec_summary_line(spec) == "2 fields, 3 rules"
+
+
+def test_spec_summary_line_empty():
+    assert schema.spec_summary_line({}) == "0 fields, 0 rules"
+
+
+def test_validate_collect_exact_three_element_list():
+    spec = {
+        "name": {"required": True, "type": "str"},
+        "amount": {"required": True, "type": "number", "max": 100},
+        "extra": {"non_empty": True},
+    }
+    fields = {"amount": 200, "extra": "   "}
+    assert schema.validate_collect(spec, fields) == [
+        "missing field: name",
+        "field amount exceeds max_amount 100",
+        "field extra must be a non-empty string",
+    ]
+
+
+def test_validate_collect_clean_is_empty():
+    spec = {"name": {"required": True}}
+    assert schema.validate_collect(spec, {"name": "x"}) == []
+
+
+def test_validate_collect_one_message_per_field_type_before_non_empty():
+    spec = {"n": {"type": "str", "non_empty": True}}
+    assert schema.validate_collect(spec, {"n": 42}) == ["field n must be a string"]
diff --git a/tests/test_tabular.py b/tests/test_tabular.py
new file mode 100644
index 0000000..e2219fd
--- /dev/null
+++ b/tests/test_tabular.py
@@ -0,0 +1,81 @@
+"""Tests for the column-model toolkit app/tabular.py."""
+import pytest
+
+from app import tabular
+
+
+def test_columns():
+    assert tabular.columns([]) == []
+    records = [{"a": 1, "b": 2}, {"a": 3, "c": 4}]
+    assert tabular.columns(records) == ["a", "b", "c"]
+
+
+def test_cell():
+    assert tabular.cell(None) == ""
+    assert tabular.cell(3) == "3"
+    assert tabular.cell(3.5) == "3.5"
+    assert tabular.cell("x") == "x"
+
+
+def test_escape_csv():
+    assert tabular.escape_csv("plain") == "plain"
+    assert tabular.escape_csv("a,b") == '"a,b"'
+    assert tabular.escape_csv('say "hi"') == '"say ""hi"""'
+    assert tabular.escape_csv("line1\nline2") == '"line1\nline2"'
+    assert tabular.escape_csv("") == ""
+
+
+def test_widths():
+    records = [{"name": "x", "id": "1"}, {"name": "yy", "id": "22222"}]
+    cols = ["name", "id"]
+    # "name" header (4) is strictly wider than every cell ("x", "yy")
+    # "id" header (2) is narrower than its widest cell ("22222", width 5)
+    assert tabular.widths(records, cols) == {"name": 4, "id": 5}
+
+
+def test_pad():
+    assert tabular.pad("ab", 4, "left") == "ab  "
+    assert tabular.pad("ab", 4, "right") == "  ab"
+    assert tabular.pad("abcde", 4, "left") == "abcde"
+    with pytest.raises(ValueError):
+        tabular.pad("abcde", 4, "center")
+
+
+def test_sanitize_flat():
+    assert tabular.sanitize_flat("a\tb\nc") == "a b c"
+    assert tabular.sanitize_flat("clean") == "clean"
+
+
+def test_escape_html():
+    assert tabular.escape_html('<a & "b">') == "&lt;a &amp; &quot;b&quot;&gt;"
+    assert tabular.escape_html("clean") == "clean"
+
+
+def test_truncate():
+    assert tabular.truncate("hello", 10) == "hello"
+    assert tabular.truncate("helloworld", 7) == "hell..."
+    with pytest.raises(ValueError):
+        tabular.truncate("hello", 2, marker="...")
+
+
+def test_wrap():
+    assert tabular.wrap("abc def ghi", 5) == ["abc", "def", "ghi"]
+    assert tabular.wrap("abc def ghi", 8) == ["abc def", "ghi"]
+    assert tabular.wrap("abcdefgh", 3) == ["abc", "def", "gh"]
+    assert tabular.wrap("", 5) == [""]
+    with pytest.raises(ValueError):
+        tabular.wrap("x", 0)
+
+
+def test_fit():
+    assert tabular.fit("helloworld", 7, "left") == "hell..."
+    assert tabular.fit("ab", 4, "left") == "ab  "
+    assert tabular.fit("ab", 4, "right") == "  ab"
+    with pytest.raises(ValueError):
+        tabular.fit("ab", 4, "center")
+
+
+def test_render_row():
+    assert tabular.render_row(["a", "bb"], [1, 2], "left") == "| a | bb |"
+    with pytest.raises(ValueError):
+        tabular.render_row(["a"], [1, 2], "left")
diff --git a/tests/test_throttle.py b/tests/test_throttle.py
new file mode 100644
index 0000000..7077475
--- /dev/null
+++ b/tests/test_throttle.py
@@ -0,0 +1,105 @@
+"""Tests for the path/method-keyed policy layer in app/throttle.py."""
+import pytest
+
+from app import quota
+from app import throttle
+
+
+def setup_function(_fn):
+    quota.reset()
+
+
+def test_policy_error_is_exception_subclass():
+    assert issubclass(throttle.PolicyError, Exception)
+
+
+def test_policies_constant_exact():
+    assert throttle.POLICIES == {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+
+
+def test_match_policy_longest_prefix_and_no_match():
+    policies = dict(throttle.POLICIES)
+    assert throttle.match_policy("GET", "/export/full", policies) == {
+        "limit": 10,
+        "window": 60,
+        "burst": 2,
+    }
+
+    policies_with_longer = dict(policies)
+    policies_with_longer["GET /export/full"] = {"limit": 1, "window": 5, "burst": 0}
+    assert throttle.match_policy("GET", "/export/full", policies_with_longer) == {
+        "limit": 1,
+        "window": 5,
+        "burst": 0,
+    }
+
+    assert throttle.match_policy("POST", "/export", policies) is None
+
+
+def test_key_for_exact_format():
+    assert throttle.key_for("POST", "/records", "mallory") == "POST /records:mallory"
+
+
+def test_enforce_no_match_returns_none_and_records_nothing():
+    policies = {"GET /export": throttle.POLICIES["GET /export"]}
+    assert throttle.enforce("POST", "/records", "a", policies) is None
+    # nothing recorded: a subsequent take under any policy still starts fresh
+    assert quota.take(throttle.key_for("POST", "/records", "a"), 5, 60) == 1
+
+
+def test_enforce_delegates_to_quota_take(monkeypatch):
+    calls = []
+
+    def fake_take(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", fake_take)
+    policies = {"POST /records": {"limit": 5, "window": 60, "burst": 0}}
+    result = throttle.enforce("POST", "/records", "mallory", policies)
+    assert calls == [(("POST /records:mallory", 5, 60), {"burst": 0})]
+    assert result == 1
+
+
+def test_enforce_exhausted_raises_policy_error():
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    throttle.enforce("POST", "/records", "mallory", policies)
+    with pytest.raises(throttle.PolicyError) as exc:
+        throttle.enforce("POST", "/records", "mallory", policies)
+    message = str(exc.value)
+    assert "POST /records:mallory" in message
+    assert "1" in message
+
+
+def test_remaining_for_none_when_no_match_and_read_only():
+    policies = {"GET /export": throttle.POLICIES["GET /export"]}
+    assert throttle.remaining_for("POST", "/records", "a", policies) is None
+
+    policies = {"POST /records": {"limit": 2, "window": 60, "burst": 0}}
+    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 2
+    assert throttle.remaining_for("POST", "/records", "mallory", policies) == 2
+    assert throttle.enforce("POST", "/records", "mallory", policies) == 1
+
+
+def test_describe_policies_exact_literal_and_empty():
+    policies = {
+        "POST /records": {"limit": 5, "window": 60, "burst": 0},
+        "GET /export": {"limit": 10, "window": 60, "burst": 2},
+    }
+    assert throttle.describe_policies(policies) == (
+        "GET /export: limit=10, window=60, burst=2\n"
+        "POST /records: limit=5, window=60, burst=0"
+    )
+    assert throttle.describe_policies({}) == "(no policies)"
+
+
+def test_end_to_end_enforce_then_advance_frees_slot():
+    policies = {"POST /records": {"limit": 1, "window": 60, "burst": 0}}
+    throttle.enforce("POST", "/records", "mallory", policies)
+    with pytest.raises(throttle.PolicyError):
+        throttle.enforce("POST", "/records", "mallory", policies)
+    quota.advance(61)
+    throttle.enforce("POST", "/records", "mallory", policies)
