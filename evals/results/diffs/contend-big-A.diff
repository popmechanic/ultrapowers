+    result = audit_query.filter_entries(audit.entries(), actor="bob")
+    assert result == [{"method": "POST", "path": "/records", "actor": "bob"}]
diff --git a/tests/test_backoff.py b/tests/test_backoff.py
new file mode 100644
index 0000000..05b1958
--- /dev/null
+++ b/tests/test_backoff.py
@@ -0,0 +1,103 @@
+"""Tests for the deterministic retry-schedule calculator in app/backoff.py."""
+import pytest
+
+from app import backoff
+from app import quota
+
+
+def setup_function(_fn):
+    quota.reset()
+
+
+def test_backoff_error_is_exception_subclass_distinct_from_quota_exceeded_error():
+    assert issubclass(backoff.BackoffError, Exception)
+    assert not issubclass(backoff.BackoffError, quota.QuotaExceededError)
+
+
+def test_schedule_exact_values_and_types():
+    result = backoff.schedule(1.0, 2.0, 3)
+    assert result == [1.0, 2.0, 4.0]
+    assert all(type(x) is float for x in result)
+    assert backoff.schedule(1.0, 2.0, 0) == []
+    with pytest.raises(backoff.BackoffError):
+        backoff.schedule(0, 2.0, 3)
+    with pytest.raises(backoff.BackoffError):
+        backoff.schedule(1.0, 0.5, 3)
+    with pytest.raises(backoff.BackoffError):
+        backoff.schedule(1.0, 2.0, -1)
+
+
+def test_capped_element_wise_min_and_unmutated_input():
+    original = [1.0, 2.0, 4.0]
+    result = backoff.capped(original, 3.0)
+    assert result == [1.0, 2.0, 3.0]
+    assert original == [1.0, 2.0, 4.0]
+    with pytest.raises(backoff.BackoffError):
+        backoff.capped([1.0], 0)
+
+
+def test_total_wait():
+    assert backoff.total_wait([1.0, 2.0, 3.0]) == 6.0
+    assert backoff.total_wait([]) == 0.0
+
+
+def test_next_delay_exact_values():
+    assert backoff.next_delay(0, 1.0, 2.0, 60.0) == 1.0
+    assert backoff.next_delay(6, 1.0, 2.0, 60.0) == 60.0
+    with pytest.raises(backoff.BackoffError):
+        backoff.next_delay(-1, 1.0, 2.0, 60.0)
+
+
+def test_delay_until_free_delegates_to_time_to_next_slot(monkeypatch):
+    calls = []
+
+    def fake_time_to_next_slot(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 42.0
+
+    monkeypatch.setattr(quota, "time_to_next_slot", fake_time_to_next_slot)
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    result = backoff.delay_until_free("k", config)
+    assert calls == [(("k", 2, 60), {"burst": 0})]
+    assert result == 42.0
+
+    monkeypatch.undo()
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    assert backoff.delay_until_free("k", config) == 50.0
+
+    minimal_config = {"rate_limit_max_per_window": 2}
+    quota.reset()
+    quota.take("j", 2, 60)
+    quota.take("j", 2, 60)
+    assert backoff.delay_until_free("j", minimal_config) == 60.0
+
+
+def test_retry_plan_exact_dict_fresh_and_exhausted():
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert backoff.retry_plan("k", config, 3) == {
+        "immediate": True,
+        "wait": 0.0,
+        "backoff": [1.0, 2.0, 4.0],
+    }
+    # read-only: no hit recorded
+    assert quota.take("k", 2, 60) == 1
+
+    quota.reset()
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    assert backoff.retry_plan("k", config, 3) == {
+        "immediate": False,
+        "wait": 50.0,
+        "backoff": [1.0, 2.0, 4.0],
+    }
+    # still read-only
+    quota.advance(51)
+    assert quota.take("k", 2, 60) == 1
+
+
+def test_describe_schedule_exact_literal_and_empty():
+    assert backoff.describe_schedule([1.0, 2.0, 4.0]) == "1.0s, 2.0s, 4.0s"
+    assert backoff.describe_schedule([]) == "(no retries)"
