new file mode 100644
index 0000000..7f04612
--- /dev/null
+++ b/tests/test_ratelimit.py
@@ -0,0 +1,208 @@
+"""Tests for the per-actor rate limiter in app/ratelimit.py."""
+import pytest
+
+from app import quota
+from app import ratelimit
+
+
+def setup_function(_fn):
+    ratelimit.reset()
+
+
+def test_rate_limit_exceeded_error_is_exception_subclass():
+    assert issubclass(ratelimit.RateLimitExceededError, Exception)
+
+
+def test_check_and_increment_counts_then_raises():
+    assert ratelimit.check_and_increment("k", 3) == 1
+    assert ratelimit.check_and_increment("k", 3) == 2
+    assert ratelimit.check_and_increment("k", 3) == 3
+    with pytest.raises(ratelimit.RateLimitExceededError) as exc:
+        ratelimit.check_and_increment("k", 3)
+    message = str(exc.value)
+    assert "k" in message
+    assert "3" in message
+
+
+def test_check_and_increment_is_per_key():
+    assert ratelimit.check_and_increment("a", 2) == 1
+    assert ratelimit.check_and_increment("b", 2) == 1
+    assert ratelimit.check_and_increment("a", 2) == 2
+    assert ratelimit.check_and_increment("b", 2) == 2
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("a", 2)
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("b", 2)
+
+
+def test_reset_clears_all_keys():
+    ratelimit.check_and_increment("a", 1)
+    ratelimit.check_and_increment("b", 1)
+    ratelimit.reset()
+    assert ratelimit.check_and_increment("a", 1) == 1
+    assert ratelimit.check_and_increment("b", 1) == 1
+
+
+def test_dispatch_hook_get_never_raises_and_never_increments():
+    config = {"rate_limit_max_per_window": 1}
+    for _ in range(6):
+        ratelimit.dispatch_hook(None, config, "GET", "/records", {})
+    # GET calls never touched the counter for the "anonymous" key.
+    assert ratelimit.check_and_increment("anonymous", 1) == 1
+
+
+def test_dispatch_hook_post_actor_key():
+    config = {"rate_limit_max_per_window": 5, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "x"})
+    # no-actor calls share the "anonymous" counter
+    assert ratelimit.check_and_increment("anonymous", 5) == 3
+    # actor="x" uses a separate counter
+    assert ratelimit.check_and_increment("x", 5) == 2
+
+
+def test_dispatch_hook_reads_limit_from_config():
+    config1 = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config1, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config1, "POST", "/records", {"actor": "a"})
+
+    config2 = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config2, "POST", "/records", {"actor": "b"})
+    ratelimit.dispatch_hook(None, config2, "POST", "/records", {"actor": "b"})
+
+
+def test_reset_also_resets_quota_clock():
+    quota.advance(5)
+    ratelimit.check_and_increment("k", 1)
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("k", 1)
+    ratelimit.reset()
+    assert quota.now() == 0.0
+    assert ratelimit.check_and_increment("k", 1) == 1
+
+
+def test_rate_limit_exceeded_error_subclasses_quota_exceeded_error():
+    assert issubclass(ratelimit.RateLimitExceededError, quota.QuotaExceededError)
+    ratelimit.check_and_increment("k", 1)
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("k", 1)
+    ratelimit.check_and_increment("j", 1)
+    with pytest.raises(quota.QuotaExceededError):
+        ratelimit.check_and_increment("j", 1)
+
+
+def test_check_and_increment_delegates_to_quota_take(monkeypatch):
+    calls = []
+
+    def fake_take(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(quota, "take", fake_take)
+    ratelimit.check_and_increment("k", 3)
+    assert calls == [(("k", 3, float("inf")), {"burst": 0})]
+
+
+def test_windowed_end_to_end_through_hook():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    quota.advance(61)
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+
+def test_minimal_config_compatibility():
+    config = {"rate_limit_max_per_window": 1}
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {})
+
+
+def test_burst_through_the_hook():
+    config = {
+        "rate_limit_max_per_window": 1,
+        "rate_limit_burst": 1,
+        "rate_limit_window_seconds": 60,
+    }
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+
+    no_burst_config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.dispatch_hook(None, no_burst_config, "POST", "/records", {"actor": "b"})
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.dispatch_hook(None, no_burst_config, "POST", "/records", {"actor": "b"})
+
+
+def test_retry_after_delegates_to_time_to_next_slot(monkeypatch):
+    calls = []
+
+    def fake_time_to_next_slot(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 42.0
+
+    monkeypatch.setattr(quota, "time_to_next_slot", fake_time_to_next_slot)
+    config = {"rate_limit_max_per_window": 5, "rate_limit_window_seconds": 60}
+    result = ratelimit.retry_after("k", config)
+    assert calls == [(("k", 5, 60), {"burst": 0})]
+    assert result == 42.0
+
+    monkeypatch.undo()
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    ratelimit.check_and_increment("a", 2, 60)
+    ratelimit.check_and_increment("a", 2, 60)
+    quota.advance(10)
+    assert ratelimit.retry_after("a", config) == 50.0
+
+
+def test_limit_headers_exact_dict_two_states():
+    config = {
+        "rate_limit_max_per_window": 2,
+        "rate_limit_window_seconds": 60,
+        "rate_limit_burst": 1,
+    }
+    assert ratelimit.limit_headers("k", config) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "3",
+        "X-RateLimit-Reset": "0.0",
+    }
+    # read-only: no hit recorded
+    assert ratelimit.check_and_increment("k", 2, 60, burst=1) == 1
+
+    ratelimit.reset()
+    ratelimit.check_and_increment("k", 2, 60, burst=1)
+    ratelimit.check_and_increment("k", 2, 60, burst=1)
+    ratelimit.check_and_increment("k", 2, 60, burst=1)
+    with pytest.raises(ratelimit.RateLimitExceededError):
+        ratelimit.check_and_increment("k", 2, 60, burst=1)
+    assert ratelimit.limit_headers("k", config) == {
+        "X-RateLimit-Limit": "2",
+        "X-RateLimit-Remaining": "0",
+        "X-RateLimit-Reset": "60.0",
+    }
+
+
+def test_status_line_exact_literal_two_states():
+    config = {"rate_limit_max_per_window": 2, "rate_limit_window_seconds": 60}
+    assert ratelimit.status_line("mallory", config) == "mallory: 0/2, reset in 0.0s"
+
+    ratelimit.check_and_increment("mallory", 2, 60)
+    ratelimit.check_and_increment("mallory", 2, 60)
+    quota.advance(10)
+    assert (
+        ratelimit.status_line("mallory", config) == "mallory: 2/2, reset in 50.0s"
+    )
+
+
+def test_check_many_exact_dict_no_hits_recorded():
+    config = {"rate_limit_max_per_window": 1, "rate_limit_window_seconds": 60}
+    ratelimit.check_and_increment("b", 1, 60)  # exhaust "b"
+    result = ratelimit.check_many(["a", "b", "c"], config)
+    assert result == {"a": True, "b": False, "c": True}
+    # no hit recorded for any key
+    assert ratelimit.check_and_increment("a", 1, 60) == 1
+    assert ratelimit.check_and_increment("c", 1, 60) == 1
diff --git a/tests/test_reportdoc.py b/tests/test_reportdoc.py
new file mode 100644
index 0000000..a963bfd
--- /dev/null
+++ b/tests/test_reportdoc.py
@@ -0,0 +1,128 @@
+"""Tests for the multi-section report composer app/reportdoc.py."""
+import pytest
+
+from app import reportdoc, colspec, export
+
+
+def test_report_error_is_exception_subclass():
+    assert issubclass(reportdoc.ReportError, Exception)
+
+
+def test_section():
+    records = [{"a": 1}]
+    sec = reportdoc.section("T", records, fmt="csv")
+    assert sec == {"title": "T", "records": records, "fmt": "csv"}
+    with pytest.raises(reportdoc.ReportError):
+        reportdoc.section("", records, "csv")
+    with pytest.raises(reportdoc.ReportError):
+        reportdoc.section("   ", records, "csv")
+    with pytest.raises(reportdoc.ReportError) as excinfo:
+        reportdoc.section("T", records, "xml")
+    assert "xml" in str(excinfo.value)
+    # "html" is in EXTRA_FORMATS, not FORMATS, but is still accepted.
+    assert reportdoc.section("T", records, "html")["fmt"] == "html"
+
+
+def test_render_section(monkeypatch):
+    calls = []
+    real_render_any = export.render_any
+
+    def recorder(records, fmt):
+        calls.append((records, fmt))
+        return real_render_any(records, fmt)
+
+    monkeypatch.setattr(export, "render_any", recorder)
+    sec = reportdoc.section("Widgets", [{"a": 1}], fmt="csv")
+    result = reportdoc.render_section(sec)
+    assert result == "## Widgets\n\n" + export.to_csv([{"a": 1}])
+    assert calls == [([{"a": 1}], "csv")]
+
+    # Empty-records section: render_any must not be called.
+    calls.clear()
+    empty_sec = reportdoc.section("Empty", [], fmt="csv")
+    assert reportdoc.render_section(empty_sec) == "## Empty\n\n(no records)"
+    assert calls == []
+
+
+def test_render_report_full_document():
+    s1 = reportdoc.section("S1", [{"a": 1}], "csv")
+    s2 = reportdoc.section("S2", [{"b": 2}, {"b": 3}], "csv")
+    expected = "# Report\n\n## S1\n\na\n1\n\n## S2\n\nb\n2\n3"
+    assert reportdoc.render_report("Report", [s1, s2]) == expected
+    assert reportdoc.render_report("R", []) == "# R\n\n(empty report)"
+
+
+def test_duplicate_section_titles_raise_from_render_report_and_toc():
+    a = reportdoc.section("D", [{"a": 1}], "csv")
+    b = reportdoc.section("D", [{"a": 1}], "csv")
+    with pytest.raises(reportdoc.ReportError) as excinfo:
+        reportdoc.render_report("R", [a, b])
+    assert "D" in str(excinfo.value)
+    with pytest.raises(reportdoc.ReportError) as excinfo:
+        reportdoc.toc([a, b])
+    assert "D" in str(excinfo.value)
+
+
+def test_toc_and_record_counts():
+    s1 = reportdoc.section("S1", [{"a": 1}], "csv")
+    s2 = reportdoc.section("S2", [{"b": 2}, {"b": 3}], "csv")
+    assert reportdoc.toc([s1, s2]) == ["S1", "S2"]
+    assert reportdoc.record_counts([s1, s2]) == {"S1": 1, "S2": 2}
+
+
+def test_summary():
+    s1 = reportdoc.section("S1", [{"a": 1}], "csv")
+    s2 = reportdoc.section("S2", [{"b": 2}, {"b": 3}], "csv")
+    assert reportdoc.summary([s1, s2]) == "2 sections, 3 records"
+    assert reportdoc.summary([]) == "0 sections, 0 records"
+
+
+def test_render_index():
+    s1 = reportdoc.section("S1", [{"a": 1}], "csv")
+    s2 = reportdoc.section("S2", [{"b": 2}, {"b": 3}], "csv")
+    expected = "1. S1 (1 records)\n2. S2 (2 records)"
+    assert reportdoc.render_index([s1, s2]) == expected
+    assert reportdoc.render_index([]) == "(empty report)"
+
+
+def test_projected_section_end_to_end(monkeypatch):
+    calls = []
+    real_project = colspec.project
+
+    def recorder(records, pairs):
+        calls.append((records, pairs))
+        return real_project(records, pairs)
+
+    monkeypatch.setattr(colspec, "project", recorder)
+    records = [{"a": 1, "b": 2}]
+    pairs = colspec.parse_colspec("a:A")
+    sec = reportdoc.projected_section("T", records, pairs, "csv")
+    assert calls == [(records, pairs)]
+    assert reportdoc.render_section(sec) == "## T\n\nA\n1"
+
+
+def test_find_section():
+    s1 = reportdoc.section("S1", [{"a": 1}], "csv")
+    s2 = reportdoc.section("S2", [{"b": 2}], "csv")
+    found = reportdoc.find_section([s1, s2], "S2")
+    assert found is s2
+    with pytest.raises(reportdoc.ReportError) as excinfo:
+        reportdoc.find_section([s1, s2], "nope")
+    assert "nope" in str(excinfo.value)
+
+
+def test_merge_reports():
+    s1 = reportdoc.section("S1", [{"a": 1}], "csv")
+    s2 = reportdoc.section("S2", [{"b": 2}], "csv")
+    a_list = [s1]
+    b_list = [s2]
+    merged = reportdoc.merge_reports(a_list, b_list)
+    assert merged == [s1, s2]
+    assert a_list == [s1]
+    assert b_list == [s2]
+
+    dup_a = reportdoc.section("D", [{"a": 1}], "csv")
+    dup_b = reportdoc.section("D", [{"a": 1}], "csv")
+    with pytest.raises(reportdoc.ReportError) as excinfo:
+        reportdoc.merge_reports([dup_a], [dup_b])
+    assert "D" in str(excinfo.value)
