@@ -0,0 +1,95 @@
+"""Tests for the actor-tier policy layer in app/tiers.py."""
+import pytest
+
+from app import quota
+from app import throttle
+from app import tiers
+
+
+def setup_function(_fn):
+    quota.reset()
+
+
+def test_tier_error_is_exception_subclass_distinct_from_policy_error():
+    assert issubclass(tiers.TierError, Exception)
+    assert not issubclass(tiers.TierError, throttle.PolicyError)
+
+
+def test_tiers_constant_exact():
+    assert tiers.TIERS == {
+        "free": {"limit": 2, "window": 60, "burst": 0},
+        "pro": {"limit": 10, "window": 60, "burst": 2},
+        "internal": {"limit": 100, "window": 60, "burst": 10},
+    }
+
+
+def test_tier_of_default_and_unknown_tier_names_both():
+    assert tiers.tier_of("someone", {}) == "free"
+    assert tiers.tier_of("mallory", {"mallory": "pro"}) == "pro"
+    with pytest.raises(tiers.TierError) as exc:
+        tiers.tier_of("mallory", {"mallory": "bogus"})
+    message = str(exc.value)
+    assert "mallory" in message
+    assert "bogus" in message
+
+
+def test_policy_for_deep_copy_does_not_mutate_tiers():
+    policy = tiers.policy_for("someone", {})
+    policy["limit"] = 999
+    assert tiers.TIERS["free"]["limit"] == 2
+
+
+def test_enforce_tier_delegates_to_throttle_enforce(monkeypatch):
+    calls = []
+
+    def fake_enforce(*args, **kwargs):
+        calls.append((args, kwargs))
+        return 1
+
+    monkeypatch.setattr(throttle, "enforce", fake_enforce)
+    tiers.enforce_tier("POST", "/records", "mallory", {})
+    assert calls == [
+        (
+            ("POST", "/records", "mallory", {"POST /records": {"limit": 2, "window": 60, "burst": 0}}),
+            {},
+        )
+    ]
+
+
+def test_enforce_tier_end_to_end_free_exhausts_pro_independent():
+    tiers.enforce_tier("POST", "/records", "a", {})
+    tiers.enforce_tier("POST", "/records", "a", {})
+    with pytest.raises(throttle.PolicyError):
+        tiers.enforce_tier("POST", "/records", "a", {})
+
+    # a "pro" actor's counter is independent of "a"'s free counter
+    assignments = {"b": "pro"}
+    tiers.enforce_tier("POST", "/records", "b", assignments)
+    tiers.enforce_tier("POST", "/records", "b", assignments)
+    tiers.enforce_tier("POST", "/records", "b", assignments)
+    # b: limit 10 + burst 2, still well under, no raise
+
+
+def test_remaining_tier_delegates_and_read_only():
+    assert tiers.remaining_tier("POST", "/records", "a", {}) == 2
+    tiers.enforce_tier("POST", "/records", "a", {})
+    assert tiers.remaining_tier("POST", "/records", "a", {}) == 1
+    # still read-only
+    assert tiers.enforce_tier("POST", "/records", "a", {}) == 2
+
+
+def test_describe_tiers_exact_literal():
+    assert tiers.describe_tiers() == (
+        "free: limit=2, window=60, burst=0\n"
+        "internal: limit=100, window=60, burst=10\n"
+        "pro: limit=10, window=60, burst=2"
+    )
+
+
+def test_upgrade_path_exact_chain_and_unknown():
+    assert tiers.upgrade_path("free") == "pro"
+    assert tiers.upgrade_path("pro") == "internal"
+    assert tiers.upgrade_path("internal") is None
+    with pytest.raises(tiers.TierError) as exc:
+        tiers.upgrade_path("bogus")
+    assert "bogus" in str(exc.value)
