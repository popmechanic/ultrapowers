new file mode 100644
index 0000000..0857f37
--- /dev/null
+++ b/app/schema.py
@@ -0,0 +1,199 @@
+"""Declarative field-spec toolkit: error catalog, predicates, and a
+compiler that turns a plain-dict field spec into a reusable validator.
+
+Everything else in this fixture's validation layer (``app.rules``,
+``app.validation``, ``app.profiles``, ``app.coerce``) is built on top of
+the pieces in this module and never reimplements them.
+"""
+import math
+
+
+ERROR_CATALOG = {
+    "missing": "missing field: {field}",
+    "numeric": "field {field} must be numeric (got {got})",
+    "non_negative": "field {field} must be non-negative",
+    "max": "field {field} exceeds max_amount {limit}",
+    "non_empty": "field {field} must be a non-empty string",
+    "type_str": "field {field} must be a string",
+}
+
+
+class SchemaError(Exception):
+    pass
+
+
+def format_error(code, **kwargs):
+    """Render the ``code`` template from ERROR_CATALOG with kwargs.
+    Raises KeyError for an unknown code — never a silent fallback."""
+    template = ERROR_CATALOG[code]
+    return template.format(**kwargs)
+
+
+def check_required(fields, required_fields):
+    """Return the list of names in required_fields (in that order) that
+    are absent from fields."""
+    return [name for name in required_fields if name not in fields]
+
+
+def is_valid_amount(value):
+    """True for a non-bool int/float that is finite. Overflow-safe: an
+    int is always finite (no float() conversion is attempted for ints),
+    so an arbitrarily large int returns True without raising."""
+    if isinstance(value, bool):
+        return False
+    if isinstance(value, int):
+        return True
+    if isinstance(value, float):
+        return math.isfinite(value)
+    return False
+
+
+def is_non_empty_str(value):
+    """True for a str with non-whitespace content."""
+    if not isinstance(value, str):
+        return False
+    return value.strip() != ""
+
+
+def _check_field_rules(field, value, rules):
+    """Check one field's rules in the fixed type -> non_empty -> max
+    order, returning the first failing error message code+kwargs, or
+    None if all pass."""
+    field_type = rules.get("type")
+    if field_type == "number":
+        if not is_valid_amount(value):
+            return format_error("numeric", field=field, got=type(value).__name__)
+    elif field_type == "str":
+        if not isinstance(value, str):
+            return format_error("type_str", field=field)
+
+    if rules.get("non_empty"):
+        if not is_non_empty_str(value):
+            return format_error("non_empty", field=field)
+
+    if "max" in rules:
+        limit = rules["max"]
+        try:
+            if not (value <= limit):
+                return format_error("max", field=field, limit=limit)
+        except TypeError:
+            return format_error("numeric", field=field, got=type(value).__name__)
+
+    return None
+
+
+def compile_spec(spec):
+    """Compile a declarative field spec into a reusable validator
+    callable: validator(fields) -> new dict (stripped where non_empty is
+    set), raising SchemaError on the first violation."""
+    legal_keys = {"required", "type", "non_empty", "max"}
+    legal_types = {"str", "number"}
+    for field, rules in spec.items():
+        for key in rules:
+            if key not in legal_keys:
+                raise ValueError(key)
+        if "type" in rules and rules["type"] not in legal_types:
+            raise ValueError(rules["type"])
+
+    required_fields = [f for f, r in spec.items() if r.get("required")]
+
+    def validator(fields):
+        missing = check_required(fields, required_fields)
+        if missing:
+            raise SchemaError(format_error("missing", field=missing[0]))
+
+        result = dict(fields)
+        for field, rules in spec.items():
+            if field not in fields:
+                continue
+            value = fields[field]
+            error = _check_field_rules(field, value, rules)
+            if error is not None:
+                raise SchemaError(error)
+            if rules.get("non_empty"):
+                result[field] = value.strip()
+        return result
+
+    return validator
+
+
+def merge_specs(a, b):
+    """Union two specs. A field/rule-key present in both with unequal
+    values raises ValueError naming the field and key."""
+    result = {}
+    for field, rules in a.items():
+        result[field] = dict(rules)
+    for field, rules in b.items():
+        if field not in result:
+            result[field] = dict(rules)
+            continue
+        merged = dict(result[field])
+        for key, value in rules.items():
+            if key in merged and merged[key] != value:
+                raise ValueError("%s.%s" % (field, key))
+            merged[key] = value
+        result[field] = merged
+    return result
+
+
+def describe_spec(spec):
+    """Render one line per field (sorted field order), each
+    '<field>: <key>=<value>, ...' with rule keys sorted."""
+    if not spec:
+        return "(empty spec)"
+    lines = []
+    for field in sorted(spec):
+        rules = spec[field]
+        parts = ["%s=%s" % (key, rules[key]) for key in sorted(rules)]
+        lines.append("%s: %s" % (field, ", ".join(parts)))
+    return "\n".join(lines)
+
+
+def diff_specs(a, b):
+    """Return {"added": [...], "removed": [...], "changed": [...]}
+    comparing spec a to spec b."""
+    added = sorted(f for f in b if f not in a)
+    removed = sorted(f for f in a if f not in b)
+    changed = sorted(f for f in a if f in b and a[f] != b[f])
+    return {"added": added, "removed": removed, "changed": changed}
+
+
+def spec_from_config(config, prefix):
+    """Collect every config key starting with prefix into a spec keyed
+    by the field name with the prefix stripped."""
+    spec = {}
+    for key, value in config.items():
+        if key.startswith(prefix):
+            spec[key[len(prefix):]] = value
+    return spec
+
+
+def spec_to_config(spec, prefix):
+    """Inverse of spec_from_config: {prefix + field: rules copy}."""
+    return {prefix + field: dict(rules) for field, rules in spec.items()}
+
+
+def spec_summary_line(spec):
+    """'<N> fields, <M> rules'."""
+    field_count = len(spec)
+    rule_count = sum(len(rules) for rules in spec.values())
+    return "%d fields, %d rules" % (field_count, rule_count)
+
+
+def validate_collect(spec, fields):
+    """Like the compiled validator but collects every error message
+    instead of raising on the first: required-miss messages first (spec
+    order), then at most one message per present field (fixed rule
+    order), in spec order."""
+    errors = []
+    required_fields = [f for f, r in spec.items() if r.get("required")]
+    for field in check_required(fields, required_fields):
+        errors.append(format_error("missing", field=field))
+
+    for field, rules in spec.items():
+        if field not in fields:
+            continue
+        error = _check_field_rules(field, fields[field], rules)
+        if error is not None:
+            errors.append(error)
+    return errors
