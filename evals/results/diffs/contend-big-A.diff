@@ -0,0 +1,176 @@
+"""Tests for the module-global dispatch audit log in app/audit.py."""
+import pytest
+
+from app import audit
+
+
+def setup_function(_fn):
+    audit.clear()
+
+
+def test_entries_on_fresh_log_is_empty():
+    assert audit.entries() == []
+
+
+def test_record_appends_exactly_one_entry():
+    audit.record("GET", "/records", "alice", 500)
+    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
+
+
+def test_entries_returns_in_call_order():
+    audit.record("GET", "/records", "alice", 500)
+    audit.record("POST", "/records", "bob", 500)
+    audit.record("DELETE", "/records/1", "carol", 500)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/records", "actor": "alice"},
+        {"method": "POST", "path": "/records", "actor": "bob"},
+        {"method": "DELETE", "path": "/records/1", "actor": "carol"},
+    ]
+
+
+def test_entries_returns_a_copy():
+    audit.record("GET", "/records", "alice", 500)
+    got = audit.entries()
+    got.append({"method": "X", "path": "/y", "actor": "z"})
+    assert audit.entries() == [{"method": "GET", "path": "/records", "actor": "alice"}]
+
+
+def test_cap_drops_oldest_first():
+    for i in range(4):
+        audit.record("GET", "/r%d" % i, "actor%d" % i, 3)
+    result = audit.entries()
+    assert len(result) == 3
+    assert result == [
+        {"method": "GET", "path": "/r1", "actor": "actor1"},
+        {"method": "GET", "path": "/r2", "actor": "actor2"},
+        {"method": "GET", "path": "/r3", "actor": "actor3"},
+    ]
+
+
+def test_cap_enforced_on_every_call():
+    for i in range(5):
+        audit.record("GET", "/r%d" % i, "actor%d" % i, 2)
+        assert len(audit.entries()) <= 2
+
+
+def test_dispatch_hook_default_actor_is_anonymous():
+    audit.dispatch_hook(None, {"audit_log_max_entries": 500}, "GET", "/records", {})
+    got = audit.entries()
+    assert len(got) == 1
+    assert got[0]["actor"] == "anonymous"
+    assert got[0]["method"] == "GET"
+    assert got[0]["path"] == "/records"
+
+
+def test_dispatch_hook_uses_actor_kwarg_and_no_other_keys_leak():
+    audit.dispatch_hook(
+        None,
+        {"audit_log_max_entries": 500},
+        "POST",
+        "/records",
+        {"actor": "bob", "name": "x"},
+    )
+    got = audit.entries()
+    assert len(got) == 1
+    assert got[0] == {"method": "POST", "path": "/records", "actor": "bob"}
+    assert set(got[0].keys()) == {"method", "path", "actor"}
+
+
+def test_dispatch_hook_reads_cap_from_config():
+    config = {"audit_log_max_entries": 1}
+    audit.dispatch_hook(None, config, "POST", "/records", {"actor": "a"})
+    audit.dispatch_hook(None, config, "POST", "/records", {"actor": "b"})
+    assert len(audit.entries()) == 1
+
+
+def test_dispatch_hook_fires_for_every_method():
+    config = {"audit_log_max_entries": 500}
+    audit.dispatch_hook(None, config, "DELETE", "/records/1", {"actor": "a"})
+    audit.dispatch_hook(None, config, "PUT", "/records/1", {"actor": "b"})
+    got = audit.entries()
+    assert len(got) == 2
+    assert got[0]["method"] == "DELETE"
+    assert got[1]["method"] == "PUT"
+
+
+def test_record_many_appends_in_order_enforcing_cap_after_every_append():
+    triples = [
+        ("GET", "/r0", "a0"),
+        ("GET", "/r1", "a1"),
+        ("GET", "/r2", "a2"),
+        ("GET", "/r3", "a3"),
+    ]
+    seen_lengths = []
+    original_record = audit.record
+
+    def recording_record(method, path, actor, max_entries):
+        original_record(method, path, actor, max_entries)
+        seen_lengths.append(len(audit.entries()))
+
+    audit.record = recording_record
+    try:
+        count = audit.record_many(triples, 2)
+    finally:
+        audit.record = original_record
+    assert count == 4
+    assert all(n <= 2 for n in seen_lengths)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/r2", "actor": "a2"},
+        {"method": "GET", "path": "/r3", "actor": "a3"},
+    ]
+
+
+def test_dropped_counts_evictions_since_last_clear():
+    assert audit.dropped() == 0
+    for i in range(5):
+        audit.record("GET", "/r%d" % i, "a%d" % i, 3)
+    assert audit.dropped() == 2
+    audit.clear()
+    assert audit.dropped() == 0
+
+
+def test_export_state_returns_a_deep_enough_copy():
+    audit.record("GET", "/r0", "a0", 500)
+    audit.record("POST", "/r1", "a1", 500)
+    state = audit.export_state()
+    assert state == {
+        "entries": [
+            {"method": "GET", "path": "/r0", "actor": "a0"},
+            {"method": "POST", "path": "/r1", "actor": "a1"},
+        ],
+        "dropped": 0,
+    }
+    # mutating the exported entries must not change the live log.
+    state["entries"].append({"method": "X", "path": "/y", "actor": "z"})
+    state["entries"][0]["actor"] = "mutated"
+    assert audit.entries() == [
+        {"method": "GET", "path": "/r0", "actor": "a0"},
+        {"method": "POST", "path": "/r1", "actor": "a1"},
+    ]
+    assert audit.dropped() == 0
+
+
+def test_import_state_round_trips_and_copies_its_input():
+    for i in range(5):
+        audit.record("GET", "/r%d" % i, "a%d" % i, 3)
+    state = audit.export_state()
+    audit.clear()
+    assert audit.entries() == []
+    assert audit.dropped() == 0
+    audit.import_state(state)
+    assert audit.entries() == [
+        {"method": "GET", "path": "/r2", "actor": "a2"},
+        {"method": "GET", "path": "/r3", "actor": "a3"},
+        {"method": "GET", "path": "/r4", "actor": "a4"},
+    ]
+    assert audit.dropped() == 2
+    # mutations of the state dict passed to import_state must not leak in.
+    state["entries"].append({"method": "X", "path": "/y", "actor": "z"})
+    state["entries"][0]["actor"] = "mutated"
+    state["dropped"] = 999
+    assert audit.entries() == [
+        {"method": "GET", "path": "/r2", "actor": "a2"},
+        {"method": "GET", "path": "/r3", "actor": "a3"},
+        {"method": "GET", "path": "/r4", "actor": "a4"},
+    ]
+    assert audit.dropped() == 2
