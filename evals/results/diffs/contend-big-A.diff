@@ -0,0 +1,131 @@
+"""Tests for the pre-validation coercion layer in app/coerce.py."""
+import pytest
+
+from app import coerce
+from app import schema
+
+
+def test_coerce_error_is_exception_subclass_distinct_from_schema_error():
+    assert issubclass(coerce.CoerceError, Exception)
+    assert not issubclass(coerce.CoerceError, schema.SchemaError)
+
+
+def test_coerce_catalog_pinned_exactly():
+    assert coerce.COERCE_CATALOG == {
+        "amount": "cannot coerce {field} to a number (got {value!r})",
+        "flag": "cannot coerce {field} to a flag (got {value!r})",
+    }
+
+
+def test_parse_amount_valid_strings_and_passthrough():
+    result = coerce.parse_amount("3", field="amount")
+    assert result == 3
+    assert type(result) is int
+
+    assert coerce.parse_amount("3.5", field="amount") == 3.5
+    assert coerce.parse_amount("  7 ", field="amount") == 7
+    assert coerce.parse_amount(4, field="amount") == 4
+    assert coerce.parse_amount(3.5, field="amount") == 3.5
+
+
+def test_parse_amount_bool_raises():
+    with pytest.raises(coerce.CoerceError):
+        coerce.parse_amount(True, field="amount")
+    with pytest.raises(coerce.CoerceError):
+        coerce.parse_amount(False, field="amount")
+
+
+def test_parse_amount_bad_strings_raise():
+    for bad in ("abc", "", "nan", "inf"):
+        with pytest.raises(coerce.CoerceError):
+            coerce.parse_amount(bad, field="amount")
+    with pytest.raises(coerce.CoerceError):
+        coerce.parse_amount(None, field="amount")
+
+
+def test_parse_amount_success_satisfies_is_valid_amount():
+    assert schema.is_valid_amount(coerce.parse_amount("3", field="amount"))
+
+
+def test_parse_amount_delegates_to_schema_is_valid_amount(monkeypatch):
+    monkeypatch.setattr(schema, "is_valid_amount", lambda v: False)
+    with pytest.raises(coerce.CoerceError):
+        coerce.parse_amount("3", field="a")
+
+
+def test_parse_amount_exact_message():
+    with pytest.raises(coerce.CoerceError) as exc:
+        coerce.parse_amount("abc", field="amount")
+    assert str(exc.value) == "cannot coerce amount to a number (got 'abc')"
+
+
+def test_parse_flag_true_values_case_insensitive_stripped():
+    for value in ("true", "yes", "1", "on", "  YES "):
+        assert coerce.parse_flag(value, field="active") is True
+
+
+def test_parse_flag_false_values():
+    for value in ("false", "no", "0", "off"):
+        assert coerce.parse_flag(value, field="active") is False
+
+
+def test_parse_flag_real_bool_passes_through():
+    assert coerce.parse_flag(True, field="active") is True
+    assert coerce.parse_flag(False, field="active") is False
+
+
+def test_parse_flag_unknown_raises_exact_message():
+    with pytest.raises(coerce.CoerceError) as exc:
+        coerce.parse_flag("maybe", field="active")
+    assert str(exc.value) == "cannot coerce active to a flag (got 'maybe')"
+
+
+def test_coerce_fields_replaces_str_numbers_leaves_rest_untouched():
+    spec = {
+        "amount": {"type": "number"},
+        "name": {"type": "str"},
+        "unspecced": {},
+    }
+    fields = {"amount": "42", "name": "x", "unspecced": "y", "extra": 1}
+    result = coerce.coerce_fields(fields, spec)
+    assert result == {"amount": 42, "name": "x", "unspecced": "y", "extra": 1}
+    assert fields == {"amount": "42", "name": "x", "unspecced": "y", "extra": 1}
+
+
+def test_coerce_fields_non_str_numbers_untouched():
+    spec = {"amount": {"type": "number"}}
+    result = coerce.coerce_fields({"amount": 5}, spec)
+    assert result == {"amount": 5}
+
+
+def test_coerce_report_exact_pair_for_mixed_fixture():
+    spec = {
+        "amount": {"type": "number"},
+        "second": {"type": "number"},
+        "third": {"type": "number"},
+    }
+    fields = {"amount": "42", "second": "abc", "third": "nan"}
+    coerced, errors = coerce.coerce_report(fields, spec)
+    assert coerced == {"amount": 42, "second": "abc", "third": "nan"}
+    assert errors == [
+        ("second", "cannot coerce second to a number (got 'abc')"),
+        ("third", "cannot coerce third to a number (got 'nan')"),
+    ]
+
+
+def test_coerce_and_validate_end_to_end():
+    spec = {"amount": {"required": True, "type": "number"}}
+    validator = schema.compile_spec(spec)
+
+    coerced = coerce.coerce_fields({"amount": "42"}, spec)
+    assert validator(coerced) == {"amount": 42}
+
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({"amount": "42"})
+    assert str(exc.value) == "field amount must be numeric (got str)"
+
+
+def test_describe_coercions_literal_and_empty():
+    spec = {"amount": {"type": "number"}, "name": {"type": "str"}}
+    assert coerce.describe_coercions(spec) == "amount: number"
+    assert coerce.describe_coercions({"name": {"type": "str"}}) == "(no coercions)"
diff --git a/tests/test_colspec.py b/tests/test_colspec.py
new file mode 100644
index 0000000..0d63b99
--- /dev/null
