diff --git a/app/audit.py b/app/audit.py
new file mode 100644
index 0000000..bd6635f
--- /dev/null
+++ b/app/audit.py
@@ -0,0 +1,78 @@
+"""Module-global audit log of every dispatched call.
+
+Keeps a capped, in-memory record of `(method, path, actor)` triples in
+call order. Wires into app.registry's DISPATCH_HOOKS as `dispatch_hook`,
+which fires for every dispatch regardless of method — unlike rate
+limiting, the audit log does not special-case POST/GET.
+
+`audit_log_enabled` in DEFAULT_CONFIG is recorded for a future on/off
+switch and is not read by any code here: `dispatch_hook` always logs.
+"""
+
+_log = []
+_dropped = 0
+
+
+def clear():
+    """Reset the log and the dropped counter. Tests must call this at
+    the start of every test — the log is module-global state."""
+    global _log, _dropped
+    _log = []
+    _dropped = 0
+
+
+def entries():
+    """Return a copy of the log, in call order. Mutating the returned
+    list (or its dicts) never affects the live log."""
+    return [dict(e) for e in _log]
+
+
+def dropped():
+    """Number of entries evicted by the cap since the last clear()."""
+    return _dropped
+
+
+def record(method, path, actor, max_entries):
+    """Append one `{"method", "path", "actor"}` entry, then enforce the
+    cap (oldest dropped first) immediately — the cap is checked on every
+    call, not just at the end."""
+    global _dropped
+    _log.append({"method": method, "path": path, "actor": actor})
+    while len(_log) > max_entries:
+        _log.pop(0)
+        _dropped += 1
+
+
+def record_many(triples, max_entries):
+    """Append each `(method, path, actor)` triple in order via
+    `record`, so the cap is enforced after every single append. Returns
+    the number of triples appended (always `len(triples)`, even for
+    entries that immediately age back out under the cap)."""
+    for method, path, actor in triples:
+        record(method, path, actor, max_entries)
+    return len(triples)
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS entry: logs every dispatched call. The actor is
+    the caller's `actor` kwarg, defaulting to "anonymous". Only the
+    three log fields are ever recorded — other kwargs (e.g. record
+    fields on a create call) never leak into the audit entry."""
+    actor = kwargs.get("actor", "anonymous")
+    max_entries = config["audit_log_max_entries"]
+    record(method, path, actor, max_entries)
+
+
+def export_state():
+    """Return `{"entries": entries(), "dropped": dropped()}` — a copy
+    deep enough that mutating the result never touches the live log."""
+    return {"entries": entries(), "dropped": dropped()}
+
+
+def import_state(state):
+    """Replace the log and the dropped counter from an
+    `export_state()`-shaped dict. Copies its input: later mutations of
+    `state` never leak into the live log."""
+    global _log, _dropped
+    _log = [dict(e) for e in state["entries"]]
+    _dropped = state["dropped"]
diff --git a/app/audit_query.py b/app/audit_query.py
new file mode 100644
index 0000000..68e396c
--- /dev/null
+++ b/app/audit_query.py
@@ -0,0 +1,257 @@
+"""Pure read-side query toolkit over audit entry lists.
+
+Every function here takes a plain list of `{"method", "path", "actor"}`
+entry dicts as its `entries` argument and returns a fresh result without
+ever mutating that argument or the dicts inside it. This module imports
+nothing from app.audit — it knows nothing about the live log, only about
+lists of entries it is handed.
+"""
+
+_FIELDS = ("method", "path", "actor")
+
+
+def _check_field(field):
+    if field not in _FIELDS:
+        raise ValueError("unknown field: %s" % field)
+
+
+def filter_entries(entries, actor=None, method=None, path=None):
+    """Copies of the entries matching every given (non-None) criterion,
+    in original order. No criteria given returns every entry."""
+    result = []
+    for entry in entries:
+        if actor is not None and entry.get("actor") != actor:
+            continue
+        if method is not None and entry.get("method") != method:
+            continue
+        if path is not None and entry.get("path") != path:
+            continue
+        result.append(dict(entry))
+    return result
+
+
+def counts_by(entries, field):
+    """value -> count over `field` (one of "method"/"path"/"actor")."""
+    _check_field(field)
+    counts = {}
+    for entry in entries:
+        value = entry[field]
+        counts[value] = counts.get(value, 0) + 1
+    return counts
+
+
+def counts_matrix(entries):
+    """Nested dict method -> actor -> count. Only combinations that
+    occur appear; no zero-filled cells."""
+    matrix = {}
+    for entry in entries:
+        method = entry["method"]
+        actor = entry["actor"]
+        by_actor = matrix.setdefault(method, {})
+        by_actor[actor] = by_actor.get(actor, 0) + 1
+    return matrix
+
+
+def rollup(entries, fields):
+    """Counts nested by each field in `fields`, in order. `fields` must
+    be a non-empty list of distinct names drawn from "method"/"path"/
+    "actor"."""
+    if not fields:
+        raise ValueError("fields must not be empty")
+    seen = set()
+    for field in fields:
+        _check_field(field)
+        if field in seen:
+            raise ValueError("duplicate field: %s" % field)
+        seen.add(field)
+    return _rollup(entries, fields)
+
+
+def _rollup(entries, fields):
+    if len(fields) == 1:
+        return counts_by(entries, fields[0])
+    field, rest = fields[0], fields[1:]
+    groups = {}
+    for entry in entries:
+        groups.setdefault(entry[field], []).append(entry)
+    return {value: _rollup(group, rest) for value, group in groups.items()}
+
+
+def last_n(entries, n):
+    """The final `n` entries (a copy), in order. `n` larger than the
+    list returns the whole list (a copy)."""
+    if n < 0:
+        raise ValueError("n must be >= 0")
+    if n == 0:
+        return []
+    return [dict(entry) for entry in entries[-n:]]
+
+
+def redact(entries, fields):
+    """New entry dicts with each field in `fields` replaced by "***";
+    the other keys, and the originals, are untouched."""
+    for field in fields:
+        _check_field(field)
+    result = []
+    for entry in entries:
+        new_entry = dict(entry)
+        for field in fields:
+            new_entry[field] = "***"
+        result.append(new_entry)
+    return result
+
+
+def summary(entries):
+    """Total/by_method/by_actor/first/last over `entries`. `first` and
+    `last` are copies of the first and last entries, or None."""
+    if not entries:
+        return {"total": 0, "by_method": {}, "by_actor": {}, "first": None, "last": None}
+    return {
+        "total": len(entries),
+        "by_method": counts_by(entries, "method"),
+        "by_actor": counts_by(entries, "actor"),
+        "first": dict(entries[0]),
+        "last": dict(entries[-1]),
+    }
+
+
+def recent(entries, config):
+    """The most recent `config["audit_query_default_limit"]` entries."""
+    return last_n(entries, config["audit_query_default_limit"])
+
+
+def paginate(entries, page, per_page):
+    """1-based page of `entries`: `{"page", "pages", "total", "items"}`.
+    `items` is always a copy."""
+    if page < 1 or per_page < 1:
+        raise ValueError("page and per_page must be >= 1")
+    total = len(entries)
+    pages = (total + per_page - 1) // per_page if total > 0 else 0
+    start = (page - 1) * per_page
+    end = start + per_page
+    items = [dict(entry) for entry in entries[start:end]]
+    return {"page": page, "pages": pages, "total": total, "items": items}
+
+
+def to_report(entries):
+    """Plain-text report: header/total, then a "by method:" and a
+    "by actor:" section (each sorted alphabetically), each preceded by
+    a blank line. Sections with no counts are omitted entirely."""
+    methods = counts_by(entries, "method")
+    actors = counts_by(entries, "actor")
+    lines = ["audit report", "total: %d" % len(entries)]
+    if methods:
+        lines.append("")
+        lines.append("by method:")
+        for name in sorted(methods):
+            lines.append("  %s: %d" % (name, methods[name]))
+    if actors:
+        lines.append("")
+        lines.append("by actor:")
+        for name in sorted(actors):
+            lines.append("  %s: %d" % (name, actors[name]))
+    return "\n".join(lines)
+
+
+def to_csv_report(entries):
+    """CSV report: header row, then one "method,<value>,<count>" row
+    per method (alphabetical) and one "actor,<value>,<count>" row per
+    actor (alphabetical)."""
+    methods = counts_by(entries, "method")
+    actors = counts_by(entries, "actor")
+    lines = ["field,value,count"]
+    for name in sorted(methods):
+        lines.append("method,%s,%d" % (name, methods[name]))
+    for name in sorted(actors):
+        lines.append("actor,%s,%d" % (name, actors[name]))
+    return "\n".join(lines)
+
+
+def to_markdown_report(entries):
+    """Pipe-table report with the same row order/content as
+    `to_csv_report`, no cell padding."""
+    methods = counts_by(entries, "method")
+    actors = counts_by(entries, "actor")
+    lines = ["| field | value | count |", "| --- | --- | --- |"]
+    for name in sorted(methods):
+        lines.append("| method | %s | %d |" % (name, methods[name]))
+    for name in sorted(actors):
+        lines.append("| actor | %s | %d |" % (name, actors[name]))
+    return "\n".join(lines)
+
+
+def top_actors(entries, n):
+    """`(actor, count)` tuples sorted by count descending, ties broken
+    by actor ascending, truncated to `n`."""
+    if n < 0:
+        raise ValueError("n must be >= 0")
+    counts = counts_by(entries, "actor")
+    ranked = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
+    return ranked[:n]
+
+
+def merge_entries(*entry_lists):
+    """One new list concatenating the input lists in argument order;
+    entries are copies."""
+    result = []
+    for entry_list in entry_lists:
+        for entry in entry_list:
+            result.append(dict(entry))
+    return result
+
+
+def _diff_counts(a_counts, b_counts):
+    diff = {}
+    for key in set(a_counts) | set(b_counts):
+        a_value = a_counts.get(key, 0)
+        b_value = b_counts.get(key, 0)
+        if a_value != b_value:
+            diff[key] = b_value - a_value
+    return diff
+
+
+def diff_summaries(a, b):
+    """Given two `summary(...)` dicts, the delta from `a` to `b`: total
+    difference, plus only the by_method/by_actor values whose counts
+    changed (a value absent from one side counts as 0)."""
+    return {
+        "total": b["total"] - a["total"],
+        "by_method": _diff_counts(a["by_method"], b["by_method"]),
+        "by_actor": _diff_counts(a["by_actor"], b["by_actor"]),
+    }
+
+
+def format_entry(entry):
+    """Exactly "<METHOD> <path> (<actor>)"; raises ValueError naming
+    the first missing key if any of the three is absent."""
+    for key in _FIELDS:
+        if key not in entry:
+            raise ValueError("missing key: %s" % key)
+    return "%s %s (%s)" % (entry["method"], entry["path"], entry["actor"])
+
+
+def to_lines(entries):
+    """`format_entry` strings for each entry, in order."""
+    return [format_entry(entry) for entry in entries]
+
+
+def group_by(entries, field):
+    """Dict mapping each distinct value of `field` to the list of
+    matching entry copies, in original order."""
+    _check_field(field)
+    result = {}
+    for entry in entries:
+        result.setdefault(entry[field], []).append(dict(entry))
+    return result
+
+
+def search(entries, needle):
+    """Entry copies where `needle` is a substring of any of the three
+    field values, in original order. `needle` must not be empty."""
+    if needle == "":
+        raise ValueError("needle must not be empty")
+    result = []
+    for entry in entries:
+        if any(needle in str(entry[key]) for key in _FIELDS):
+            result.append(dict(entry))
+    return result
diff --git a/app/backoff.py b/app/backoff.py
new file mode 100644
index 0000000..d8cf340
--- /dev/null
+++ b/app/backoff.py
@@ -0,0 +1,73 @@
+"""Deterministic retry-schedule calculator over app.quota.
+
+Imports app.quota only (never app.ratelimit); pure — no module state
+of its own.
+"""
+from app import quota
+
+
+class BackoffError(Exception):
+    pass
+
+
+def schedule(base, factor, retries):
+    """Exponential delay schedule: [base * factor**i for i in
+    range(retries)], as floats."""
+    if base <= 0:
+        raise BackoffError("base must be > 0, got %r" % (base,))
+    if factor < 1.0:
+        raise BackoffError("factor must be >= 1.0, got %r" % (factor,))
+    if retries < 0:
+        raise BackoffError("retries must be >= 0, got %r" % (retries,))
+    return [float(base * factor ** i) for i in range(retries)]
+
+
+def capped(seq, cap):
+    """Element-wise min(seq[i], cap), as a new list; input unmutated."""
+    if cap <= 0:
+        raise BackoffError("cap must be > 0, got %r" % (cap,))
+    return [min(x, cap) for x in seq]
+
+
+def total_wait(seq):
+    return float(sum(seq))
+
+
+def next_delay(attempt, base, factor, cap):
+    """min(base * factor**attempt, cap) for a single attempt."""
+    if attempt < 0:
+        raise BackoffError("attempt must be >= 0, got %r" % (attempt,))
+    return min(base * factor ** attempt, cap)
+
+
+def delay_until_free(key, config):
+    """Delegates to quota.time_to_next_slot using the same config-key
+    conventions as app.ratelimit."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    return quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
+
+
+def retry_plan(key, config, retries):
+    """Read-only combined view: whether a call would succeed right now,
+    how long until it would, and a capped exponential backoff
+    schedule."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    immediate = quota.remaining(key, limit, window_seconds, burst=burst) > 0
+    wait = delay_until_free(key, config)
+    base = config.get("backoff_base", 1.0)
+    factor = config.get("backoff_factor", 2.0)
+    cap = config.get("backoff_cap", 60.0)
+    backoff = capped(schedule(base, factor, retries), cap)
+    return {"immediate": immediate, "wait": wait, "backoff": backoff}
+
+
+def describe_schedule(seq):
+    """Comma-joined delays each suffixed "s", or a fixed placeholder for
+    an empty schedule."""
+    if not seq:
+        return "(no retries)"
+    return ", ".join("%ss" % delay for delay in seq)
diff --git a/app/coerce.py b/app/coerce.py
new file mode 100644
index 0000000..17bc9f4
--- /dev/null
+++ b/app/coerce.py
@@ -0,0 +1,80 @@
+"""Pre-validation coercion layer: turn loosely-typed input (e.g. strings
+from a form) into the types app.schema's rules expect.
+
+Imports app.schema only; every CoerceError message is built from
+COERCE_CATALOG (no other message literals in this module).
+"""
+from app import schema
+
+
+class CoerceError(Exception):
+    pass
+
+
+COERCE_CATALOG = {
+    "amount": "cannot coerce {field} to a number (got {value!r})",
+    "flag": "cannot coerce {field} to a flag (got {value!r})",
+}
+
+
+_TRUE_FLAGS = {"true", "yes", "1", "on"}
+_FALSE_FLAGS = {"false", "no", "0", "off"}
+
+
+def parse_amount(value, field):
+    if isinstance(value, bool):
+        raise CoerceError(COERCE_CATALOG["amount"].format(field=field, value=value))
+    if isinstance(value, str):
+        text = value.strip()
+        try:
+            if "." in text:
+                parsed = float(text)
+            else:
+                parsed = int(text)
+        except ValueError:
+            raise CoerceError(COERCE_CATALOG["amount"].format(field=field, value=value))
+    else:
+        parsed = value
+
+    if not schema.is_valid_amount(parsed):
+        raise CoerceError(COERCE_CATALOG["amount"].format(field=field, value=value))
+    return parsed
+
+
+def parse_flag(value, field):
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        text = value.strip().lower()
+        if text in _TRUE_FLAGS:
+            return True
+        if text in _FALSE_FLAGS:
+            return False
+    raise CoerceError(COERCE_CATALOG["flag"].format(field=field, value=value))
+
+
+def coerce_fields(fields, spec):
+    result = dict(fields)
+    for field, rules in spec.items():
+        if rules.get("type") == "number" and field in fields and isinstance(fields[field], str):
+            result[field] = parse_amount(fields[field], field=field)
+    return result
+
+
+def coerce_report(fields, spec):
+    coerced = dict(fields)
+    errors = []
+    for field, rules in spec.items():
+        if rules.get("type") == "number" and field in fields and isinstance(fields[field], str):
+            try:
+                coerced[field] = parse_amount(fields[field], field=field)
+            except CoerceError as exc:
+                errors.append((field, str(exc)))
+    return coerced, errors
+
+
+def describe_coercions(spec):
+    fields = sorted(f for f, rules in spec.items() if rules.get("type") == "number")
+    if not fields:
+        return "(no coercions)"
+    return "\n".join("%s: number" % field for field in fields)
diff --git a/app/colspec.py b/app/colspec.py
new file mode 100644
index 0000000..8d6cfe7
--- /dev/null
+++ b/app/colspec.py
@@ -0,0 +1,113 @@
+"""Column-projection layer: parse a compact "colspec" string into
+(source, header) pairs and use it to project/select/drop record fields.
+
+Pure; only depends on app.tabular for the column-model / rename helpers it
+delegates to.
+"""
+from app import tabular
+
+
+class ColspecError(Exception):
+    pass
+
+
+def parse_colspec(text):
+    """Parse "a,b:B,c" into [(source, header), ...]. A bare token uses its
+    own name as header. Whitespace around tokens and the ":" is stripped.
+    Raises ColspecError on an empty spec, an empty token, more than one
+    ":" in a token, a duplicate source, or a duplicate header."""
+    if not text.strip():
+        raise ColspecError("empty colspec")
+
+    pairs = []
+    seen_sources = set()
+    seen_headers = set()
+    for raw_token in text.split(","):
+        token = raw_token.strip()
+        if not token:
+            raise ColspecError("empty column token in colspec: %r" % text)
+        parts = token.split(":")
+        if len(parts) == 1:
+            source = parts[0].strip()
+            header = source
+        elif len(parts) == 2:
+            source = parts[0].strip()
+            header = parts[1].strip()
+        else:
+            raise ColspecError("too many ':' in column token: %r" % token)
+
+        if source in seen_sources:
+            raise ColspecError("duplicate source: %s" % source)
+        if header in seen_headers:
+            raise ColspecError("duplicate header: %s" % header)
+        seen_sources.add(source)
+        seen_headers.add(header)
+        pairs.append((source, header))
+    return pairs
+
+
+def project(records, pairs):
+    """New list of dicts, one per record, keyed by header in pair order;
+    a source absent from a record yields None. Inputs are never mutated."""
+    result = []
+    for record in records:
+        result.append({header: record.get(source) for source, header in pairs})
+    return result
+
+
+def available(records, pairs):
+    """(present, missing) pair of sorted source-name lists split against
+    tabular.columns(records)."""
+    cols = set(tabular.columns(records))
+    present = sorted(source for source, _header in pairs if source in cols)
+    missing = sorted(source for source, _header in pairs if source not in cols)
+    return present, missing
+
+
+def auto_colspec(records):
+    """[(c, c) for c in tabular.columns(records)]."""
+    return [(c, c) for c in tabular.columns(records)]
+
+
+def header_row(pairs):
+    """Headers in order."""
+    return [header for _source, header in pairs]
+
+
+def rename_map(pairs):
+    """{source: header} entries only for pairs that actually rename."""
+    return {source: header for source, header in pairs if source != header}
+
+
+def select(records, sources):
+    """Keep only the named source fields (present ones), order-preserving
+    new dicts. Inputs are never mutated."""
+    if not sources:
+        raise ColspecError("select requires at least one source")
+    result = []
+    for record in records:
+        result.append({k: v for k, v in record.items() if k in sources})
+    return result
+
+
+def drop(records, sources):
+    """Remove the named source fields. Inputs are never mutated."""
+    if not sources:
+        raise ColspecError("drop requires at least one source")
+    result = []
+    for record in records:
+        result.append({k: v for k, v in record.items() if k not in sources})
+    return result
+
+
+def sanitize_headers(pairs):
+    """New pairs list with every header passed through tabular.sanitize_flat."""
+    return [(source, tabular.sanitize_flat(header)) for source, header in pairs]
+
+
+def describe_colspec(pairs):
+    """One line per pair, each exactly "<header> <- <source>";
+    "(no columns)" when pairs is empty."""
+    if not pairs:
+        return "(no columns)"
+    return "\n".join("%s <- %s" % (header, source) for source, header in pairs)
diff --git a/app/export.py b/app/export.py
new file mode 100644
index 0000000..0275ed5
--- /dev/null
+++ b/app/export.py
@@ -0,0 +1,184 @@
+"""Export/report formatter: CSV, JSON, Markdown, NDJSON, TSV (+ HTML).
+
+Column model, cell rendering, escaping, and padding all come from
+app.tabular; this module only sequences those primitives into whole-file
+formats and exposes the FORMATS / EXTRA_FORMATS lookup tables the registry
+wires into the pre-existing /export route.
+"""
+import json
+
+from app import tabular
+
+
+def to_csv(records):
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = [",".join(tabular.escape_csv(c) for c in cols)]
+    for record in records:
+        lines.append(
+            ",".join(tabular.escape_csv(tabular.cell(record.get(c))) for c in cols)
+        )
+    return "\n".join(lines)
+
+
+def to_json(records):
+    return json.dumps(records, sort_keys=True)
+
+
+def to_markdown(records, align="left"):
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    widths = tabular.widths(records, cols)
+    widths_list = [widths[c] for c in cols]
+
+    header = tabular.render_row(
+        [tabular.pad(c, widths[c], align) for c in cols], widths_list, align
+    )
+    if align == "right":
+        sep_cells = ["-" * (widths[c] - 1) + ":" for c in cols]
+    else:
+        sep_cells = ["-" * widths[c] for c in cols]
+    separator = "| " + " | ".join(sep_cells) + " |"
+
+    lines = [header, separator]
+    for record in records:
+        cells = [tabular.fit(tabular.cell(record.get(c)), widths[c], align) for c in cols]
+        lines.append(tabular.render_row(cells, widths_list, align))
+    return "\n".join(lines)
+
+
+def to_ndjson(records):
+    if not records:
+        return ""
+    return "\n".join(json.dumps(record, sort_keys=True) for record in records)
+
+
+def to_tsv(records):
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = ["\t".join(tabular.sanitize_flat(c) for c in cols)]
+    for record in records:
+        lines.append(
+            "\t".join(tabular.sanitize_flat(record.get(c)) for c in cols)
+        )
+    return "\n".join(lines)
+
+
+def to_html(records):
+    if not records:
+        return ""
+    cols = tabular.columns(records)
+    lines = ["<table>"]
+    header_cells = "".join(
+        "<th>%s</th>" % tabular.escape_html(c) for c in cols
+    )
+    lines.append("<tr>%s</tr>" % header_cells)
+    for record in records:
+        row_cells = "".join(
+            "<td>%s</td>" % tabular.escape_html(record.get(c)) for c in cols
+        )
+        lines.append("<tr>%s</tr>" % row_cells)
+    lines.append("</table>")
+    return "\n".join(lines)
+
+
+def parse_csv(text):
+    if text == "":
+        return []
+
+    rows = []
+    row = []
+    field_chars = []
+    in_quotes = False
+    i = 0
+    n = len(text)
+
+    def end_field():
+        row.append("".join(field_chars))
+        field_chars.clear()
+
+    def end_row():
+        end_field()
+        rows.append(row[:])
+        row.clear()
+
+    while i < n:
+        ch = text[i]
+        if in_quotes:
+            if ch == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    field_chars.append('"')
+                    i += 2
+                    continue
+                in_quotes = False
+                i += 1
+                continue
+            field_chars.append(ch)
+            i += 1
+            continue
+
+        if ch == '"':
+            in_quotes = True
+            i += 1
+            continue
+        if ch == ",":
+            end_field()
+            i += 1
+            continue
+        if ch == "\r":
+            i += 1
+            continue
+        if ch == "\n":
+            end_row()
+            i += 1
+            continue
+        field_chars.append(ch)
+        i += 1
+
+    if in_quotes:
+        raise ValueError("unterminated quote in CSV")
+
+    # Always commit the trailing segment: a trailing unquoted newline
+    # implies one more (possibly empty) row, just as text.split("\n")
+    # would yield a trailing "" element.
+    end_row()
+
+    header = rows[0]
+    result = []
+    for data_row in rows[1:]:
+        result.append(dict(zip(header, data_row)))
+    return result
+
+
+FORMATS = {
+    "csv": to_csv,
+    "json": to_json,
+    "md": to_markdown,
+    "ndjson": to_ndjson,
+    "tsv": to_tsv,
+}
+
+EXTRA_FORMATS = {
+    "html": to_html,
+}
+
+
+def render(records, fmt):
+    if fmt not in FORMATS:
+        raise ValueError("unknown export format: %s" % fmt)
+    return FORMATS[fmt](records)
+
+
+def render_any(records, fmt):
+    if fmt in FORMATS:
+        return FORMATS[fmt](records)
+    if fmt in EXTRA_FORMATS:
+        return EXTRA_FORMATS[fmt](records)
+    raise ValueError("unknown export format: %s" % fmt)
+
+
+def summary_line(records):
+    return "%d records, %d columns" % (len(records), len(tabular.columns(records)))
