diff --git a/app/reportdoc.py b/app/reportdoc.py
new file mode 100644
index 0000000..24d45f4
--- /dev/null
+++ b/app/reportdoc.py
@@ -0,0 +1,88 @@
+"""Multi-section report composer.
+
+A NEW module: it sits alongside the pre-existing app/report.py totals
+renderer without touching it. Sections are plain dicts rendered through
+app.export; column selection for a section can be built through
+app.colspec.
+"""
+from app import export
+from app import colspec
+
+
+class ReportError(Exception):
+    pass
+
+
+def section(title, records, fmt="md"):
+    if not title or not title.strip():
+        raise ReportError("section title must not be empty")
+    if fmt not in export.FORMATS and fmt not in export.EXTRA_FORMATS:
+        raise ReportError("unknown export format: %s" % fmt)
+    return {"title": title, "records": records, "fmt": fmt}
+
+
+def render_section(sec):
+    title = sec["title"]
+    records = sec["records"]
+    fmt = sec["fmt"]
+    if not records:
+        return "## " + title + "\n\n(no records)"
+    return "## " + title + "\n\n" + export.render_any(records, fmt)
+
+
+def _check_duplicate_titles(sections):
+    seen = set()
+    for sec in sections:
+        title = sec["title"]
+        if title in seen:
+            raise ReportError("duplicate section title: %s" % title)
+        seen.add(title)
+
+
+def render_report(title, sections):
+    if not sections:
+        return "# " + title + "\n\n(empty report)"
+    _check_duplicate_titles(sections)
+    rendered = [render_section(sec) for sec in sections]
+    return "# " + title + "\n\n" + "\n\n".join(rendered)
+
+
+def toc(sections):
+    _check_duplicate_titles(sections)
+    return [sec["title"] for sec in sections]
+
+
+def record_counts(sections):
+    return {sec["title"]: len(sec["records"]) for sec in sections}
+
+
+def summary(sections):
+    total_records = sum(len(sec["records"]) for sec in sections)
+    return "%d sections, %d records" % (len(sections), total_records)
+
+
+def render_index(sections):
+    if not sections:
+        return "(empty report)"
+    lines = [
+        "%d. %s (%d records)" % (i, sec["title"], len(sec["records"]))
+        for i, sec in enumerate(sections, start=1)
+    ]
+    return "\n".join(lines)
+
+
+def projected_section(title, records, pairs, fmt="md"):
+    return section(title, colspec.project(records, pairs), fmt)
+
+
+def find_section(sections, title):
+    for sec in sections:
+        if sec["title"] == title:
+            return sec
+    raise ReportError("no such section: %s" % title)
+
+
+def merge_reports(a, b):
+    merged = list(a) + list(b)
+    _check_duplicate_titles(merged)
+    return merged
diff --git a/app/rules.py b/app/rules.py
new file mode 100644
index 0000000..4ac8c77
--- /dev/null
+++ b/app/rules.py
@@ -0,0 +1,126 @@
+"""Pure rule-combinator layer on top of app.schema's predicates.
+
+A "rule" here is a plain dict {"name": str, "test": callable}. Combinators
+build composite rules out of simpler ones; every builtin predicate is
+delegated to app.schema (never reimplemented).
+"""
+from app import schema
+
+
+class RuleError(Exception):
+    pass
+
+
+def rule(name, predicate):
+    if not isinstance(name, str) or name == "":
+        raise ValueError(name)
+    return {"name": name, "test": predicate}
+
+
+def check(value, r):
+    return bool(r["test"](value))
+
+
+def all_of(*rules):
+    name = "all(" + ",".join(r["name"] for r in rules) + ")"
+
+    def test(value):
+        return all(check(value, r) for r in rules)
+
+    return rule(name, test)
+
+
+def any_of(*rules):
+    if not rules:
+        raise ValueError("any_of requires at least one rule")
+    name = "any(" + ",".join(r["name"] for r in rules) + ")"
+
+    def test(value):
+        return any(check(value, r) for r in rules)
+
+    return rule(name, test)
+
+
+def negate(r):
+    name = "not(%s)" % r["name"]
+    return rule(name, lambda value: not check(value, r))
+
+
+def when(cond, then):
+    name = "when(%s,%s)" % (cond["name"], then["name"])
+    return rule(name, lambda value: (not check(value, cond)) or check(value, then))
+
+
+def explain(value, r):
+    return "%s: %s" % (r["name"], "pass" if check(value, r) else "fail")
+
+
+def apply_rules(fields, rules_by_field):
+    failures = []
+    for field, r in rules_by_field.items():
+        if field not in fields:
+            continue
+        if not check(fields[field], r):
+            failures.append("field %s failed %s" % (field, r["name"]))
+    return failures
+
+
+def first_failure(fields, rules_by_field):
+    for field, r in rules_by_field.items():
+        if field not in fields:
+            continue
+        if not check(fields[field], r):
+            return (field, r["name"])
+    return None
+
+
+def explain_failures(fields, rules_by_field):
+    lines = []
+    for field, r in rules_by_field.items():
+        if field not in fields:
+            continue
+        if not check(fields[field], r):
+            lines.append(explain(fields[field], r))
+    return lines
+
+
+BUILTINS = {
+    # Wrapped in lambdas that look up the app.schema attribute at call
+    # time (rather than binding the function object at import time) so
+    # that monkeypatching app.schema really does change this behavior —
+    # BUILTINS delegates to app.schema, it does not hold a private copy.
+    "number": rule("number", lambda value: schema.is_valid_amount(value)),
+    "str": rule("str", lambda value: isinstance(value, str)),
+    "non_empty": rule("non_empty", lambda value: schema.is_non_empty_str(value)),
+}
+
+
+def parse_rule(text):
+    if not text:
+        raise ValueError(text)
+    tokens = text.split("&")
+    rules = []
+    for token in tokens:
+        if token not in BUILTINS:
+            raise ValueError(token)
+        rules.append(BUILTINS[token])
+    if len(rules) == 1:
+        return rules[0]
+    return all_of(*rules)
+
+
+def parse_rules(text_by_field):
+    result = {}
+    for field, text in text_by_field.items():
+        try:
+            result[field] = parse_rule(text)
+        except ValueError as exc:
+            raise ValueError("%s: %s" % (field, exc))
+    return result
+
+
+def describe_rules(rules_by_field):
+    if not rules_by_field:
+        return "(no rules)"
+    lines = ["%s: %s" % (field, r["name"]) for field, r in rules_by_field.items()]
+    return "\n".join(lines)
