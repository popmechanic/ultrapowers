@@ -0,0 +1,99 @@
+"""Tests for the column-projection layer app/colspec.py."""
+import pytest
+
+from app import colspec, tabular
+
+
+def test_colspec_error_is_exception_subclass():
+    assert issubclass(colspec.ColspecError, Exception)
+
+
+def test_parse_colspec():
+    assert colspec.parse_colspec("a,b:B,c") == [("a", "a"), ("b", "B"), ("c", "c")]
+    assert colspec.parse_colspec("a , b : B") == [("a", "a"), ("b", "B")]
+    with pytest.raises(colspec.ColspecError):
+        colspec.parse_colspec("")
+    with pytest.raises(colspec.ColspecError):
+        colspec.parse_colspec("a,,b")
+    with pytest.raises(colspec.ColspecError):
+        colspec.parse_colspec("a:b:c")
+
+
+def test_parse_colspec_duplicate_source_and_header():
+    with pytest.raises(colspec.ColspecError) as excinfo:
+        colspec.parse_colspec("a,a:A")
+    assert "a" in str(excinfo.value)
+    with pytest.raises(colspec.ColspecError) as excinfo:
+        colspec.parse_colspec("a:X,b:X")
+    assert "X" in str(excinfo.value)
+
+
+def test_project():
+    records = [{"a": 1, "x": 9}, {"b": 2}]
+    pairs = colspec.parse_colspec("a,b:B,c")
+    result = colspec.project(records, pairs)
+    assert result == [
+        {"a": 1, "B": None, "c": None},
+        {"a": None, "B": 2, "c": None},
+    ]
+    assert records == [{"a": 1, "x": 9}, {"b": 2}]
+
+
+def test_available(monkeypatch):
+    records = [{"a": 1, "x": 9}, {"b": 2}]
+    pairs = colspec.parse_colspec("a,b:B,c")
+
+    calls = []
+    real_columns = tabular.columns
+
+    def recorder(recs):
+        calls.append(recs)
+        return real_columns(recs)
+
+    monkeypatch.setattr(tabular, "columns", recorder)
+    result = colspec.available(records, pairs)
+    assert result == (["a", "b"], ["c"])
+    assert calls == [records]
+
+
+def test_auto_colspec():
+    records = [{"a": 1, "x": 9}, {"b": 2}]
+    assert colspec.auto_colspec(records) == [("a", "a"), ("b", "b"), ("x", "x")]
+
+
+def test_header_row_and_rename_map():
+    pairs = colspec.parse_colspec("a,b:B,c")
+    assert colspec.header_row(pairs) == ["a", "B", "c"]
+    assert colspec.rename_map(pairs) == {"b": "B"}
+
+
+def test_select_and_drop():
+    records = [{"a": 1, "x": 9}, {"b": 2}]
+    assert colspec.select(records, ["a"]) == [{"a": 1}, {}]
+    assert colspec.drop(records, ["a"]) == [{"x": 9}, {"b": 2}]
+    assert records == [{"a": 1, "x": 9}, {"b": 2}]
+    with pytest.raises(colspec.ColspecError):
+        colspec.select(records, [])
+    with pytest.raises(colspec.ColspecError):
+        colspec.drop(records, [])
+
+
+def test_sanitize_headers(monkeypatch):
+    calls = []
+    real_sanitize = tabular.sanitize_flat
+
+    def recorder(value):
+        calls.append(value)
+        return real_sanitize(value)
+
+    monkeypatch.setattr(tabular, "sanitize_flat", recorder)
+    pairs = [("a", "X\tY"), ("b", "clean")]
+    result = colspec.sanitize_headers(pairs)
+    assert result == [("a", "X Y"), ("b", "clean")]
+    assert calls == ["X\tY", "clean"]
+
+
+def test_describe_colspec():
+    pairs = colspec.parse_colspec("a,b:B,c")
+    assert colspec.describe_colspec(pairs) == "a <- a\nB <- b\nc <- c"
+    assert colspec.describe_colspec([]) == "(no columns)"
