@@ -0,0 +1,65 @@
+"""Actor-tier policy layer over app.throttle.
+
+Imports app.throttle and app.quota only; no module state of its own
+beyond the TIERS constant.
+"""
+import copy
+
+from app import throttle
+
+
+class TierError(Exception):
+    pass
+
+
+TIERS = {
+    "free": {"limit": 2, "window": 60, "burst": 0},
+    "pro": {"limit": 10, "window": 60, "burst": 2},
+    "internal": {"limit": 100, "window": 60, "burst": 10},
+}
+
+_UPGRADE_PATH = {"free": "pro", "pro": "internal", "internal": None}
+
+
+def tier_of(actor, assignments):
+    """The actor's tier, defaulting to "free" when unassigned. Raises
+    TierError (naming both the actor and the bogus tier) when the
+    assignment names a tier absent from TIERS."""
+    tier = assignments.get(actor, "free")
+    if tier not in TIERS:
+        raise TierError(
+            "actor %r assigned unknown tier %r" % (actor, tier)
+        )
+    return tier
+
+
+def policy_for(actor, assignments):
+    """A deep copy of the actor's tier policy — mutating the result
+    never touches TIERS."""
+    return copy.deepcopy(TIERS[tier_of(actor, assignments)])
+
+
+def enforce_tier(method, path, actor, assignments):
+    """Builds the one-key policies dict for this actor's tier and
+    delegates to throttle.enforce."""
+    policies = {"%s %s" % (method, path): policy_for(actor, assignments)}
+    return throttle.enforce(method, path, actor, policies)
+
+
+def remaining_tier(method, path, actor, assignments):
+    """Read-only: delegates to throttle.remaining_for under the same
+    one-key policies dict."""
+    policies = {"%s %s" % (method, path): policy_for(actor, assignments)}
+    return throttle.remaining_for(method, path, actor, policies)
+
+
+def describe_tiers():
+    return throttle.describe_policies(TIERS)
+
+
+def upgrade_path(tier):
+    """The next tier by allowance, or None for the top tier. Raises
+    TierError (naming the tier) for an unknown tier."""
+    if tier not in _UPGRADE_PATH:
+        raise TierError("unknown tier %r" % (tier,))
+    return _UPGRADE_PATH[tier]
diff --git a/app/validation.py b/app/validation.py
new file mode 100644
index 0000000..af2bb0a
--- /dev/null
+++ b/app/validation.py
@@ -0,0 +1,96 @@
+"""Input-validation layer for record creation.
+
+Wires into app.registry's PRE_CREATE_HOOKS as `pre_create_hook`. Every
+error message is built through app.schema.format_error against
+schema.ERROR_CATALOG — no error-message string literals live here.
+"""
+import re
+
+from app import schema
+
+
+class ValidationError(Exception):
+    pass
+
+
+def _template_pattern(template):
+    """Turn a str.format template into a regex that matches any string
+    produced by formatting it (the '{...}' placeholders become '.+')."""
+    parts = re.split(r"(\{[^}]*\})", template)
+    pattern = "".join(
+        ".+" if part.startswith("{") and part.endswith("}") else re.escape(part)
+        for part in parts
+    )
+    return "^" + pattern + "$"
+
+
+def validate_fields(fields, required_fields, max_amount):
+    """Validate fields against required_fields (checked first, in
+    order) and, when present, the shape of "amount" and "name". Returns
+    a new dict: "name" stripped, everything else preserved unchanged.
+    Raises ValidationError (wrapping schema.format_error messages) on
+    the first violation."""
+    missing = schema.check_required(fields, required_fields)
+    if missing:
+        raise ValidationError(schema.format_error("missing", field=missing[0]))
+
+    if "amount" in fields:
+        amount = fields["amount"]
+        if not schema.is_valid_amount(amount):
+            raise ValidationError(
+                schema.format_error("numeric", field="amount", got=type(amount).__name__)
+            )
+        if amount < 0:
+            raise ValidationError(schema.format_error("non_negative", field="amount"))
+        if amount > max_amount:
+            raise ValidationError(schema.format_error("max", field="amount", limit=max_amount))
+
+    result = dict(fields)
+    if "name" in fields:
+        name = fields["name"]
+        if not schema.is_non_empty_str(name):
+            raise ValidationError(schema.format_error("non_empty", field="name"))
+        result["name"] = name.strip()
+
+    return result
+
+
+def pre_create_hook(store, config, fields):
+    return validate_fields(
+        fields,
+        config["validation_required_fields"],
+        config["validation_max_amount"],
+    )
+
+
+def validate_many(entries, required_fields, max_amount):
+    """Validate a list of fields dicts. Returns (validated, errors):
+    validated is the list of successfully-validated new dicts in input
+    order; errors is [(index, str(err)), ...] for the failures, also in
+    input order."""
+    validated = []
+    errors = []
+    for index, entry in enumerate(entries):
+        try:
+            validated.append(validate_fields(entry, required_fields, max_amount))
+        except ValidationError as exc:
+            errors.append((index, str(exc)))
+    return validated, errors
+
+
+def error_code(message):
+    """Map an error-message string back to its ERROR_CATALOG code by
+    matching against the catalog's templates (built at call time, not a
+    second hand-written table)."""
+    for code, template in schema.ERROR_CATALOG.items():
+        if re.match(_template_pattern(template), message):
+            return code
+    raise ValueError(message)
+
+
+def explain_config(config):
+    required = ", ".join(config["validation_required_fields"])
+    return "validation config:\n  required: %s\n  max_amount: %s" % (
+        required,
+        config["validation_max_amount"],
+    )
