@@ -0,0 +1,213 @@
+"""Tests for the input-validation layer in app/validation.py."""
+import pytest
+
+from app import schema
+from app import validation
+
+
+def test_validation_error_is_exception_subclass():
+    assert issubclass(validation.ValidationError, Exception)
+
+
+def test_validate_fields_missing_name_names_the_field():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"amount": 1}, ["name", "amount"], 100)
+    assert str(exc.value) == "missing field: name"
+
+
+def test_validate_fields_missing_amount_names_the_field():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({"name": "x"}, ["name", "amount"], 100)
+    assert str(exc.value) == "missing field: amount"
+
+
+def test_validate_fields_both_missing_names_first_required_field():
+    with pytest.raises(validation.ValidationError) as exc:
+        validation.validate_fields({}, ["name", "amount"], 100)
+    assert str(exc.value) == "missing field: name"
+
+
+def test_validate_fields_string_amount_raises_numeric():
+    with pytest.raises(validation.ValidationError, match="numeric"):
+        validation.validate_fields({"name": "x", "amount": "3"}, ["name", "amount"], 100)
+
+
+def test_validate_fields_bool_amount_raises_numeric():
+    with pytest.raises(validation.ValidationError, match="numeric"):
+        validation.validate_fields({"name": "x", "amount": True}, ["name", "amount"], 100)
+
+
+def test_validate_fields_negative_amount_raises_non_negative():
+    with pytest.raises(validation.ValidationError, match="non-negative"):
+        validation.validate_fields({"name": "x", "amount": -1}, ["name", "amount"], 100)
+
+
+def test_validate_fields_zero_amount_accepted():
+    result = validation.validate_fields({"name": "x", "amount": 0}, ["name", "amount"], 100)
+    assert result["amount"] == 0
+
+
+def test_validate_fields_over_max_raises_and_boundary_accepted():
+    with pytest.raises(validation.ValidationError, match="max_amount"):
+        validation.validate_fields({"name": "x", "amount": 101}, ["name", "amount"], 100)
+    result = validation.validate_fields({"name": "x", "amount": 100}, ["name", "amount"], 100)
+    assert result["amount"] == 100
+
+
+def test_validate_fields_bad_name_raises_non_empty_string():
+    with pytest.raises(validation.ValidationError, match="non-empty string"):
+        validation.validate_fields({"name": "", "amount": 1}, ["name", "amount"], 100)
+    with pytest.raises(validation.ValidationError, match="non-empty string"):
+        validation.validate_fields({"name": "   ", "amount": 1}, ["name", "amount"], 100)
+    with pytest.raises(validation.ValidationError, match="non-empty string"):
+        validation.validate_fields({"name": 42, "amount": 1}, ["name", "amount"], 100)
+
+
+def test_validate_fields_success_returns_new_dict_with_stripped_name():
+    fields = {"name": "  ada  ", "amount": 1, "extra": "kept"}
+    result = validation.validate_fields(fields, ["name", "amount"], 100)
+    assert result == {"name": "ada", "amount": 1, "extra": "kept"}
+    assert fields == {"name": "  ada  ", "amount": 1, "extra": "kept"}
+    assert result is not fields
+
+
+def test_validate_fields_extra_keys_pass_untouched():
+    fields = {"name": "x", "amount": 1, "note": "hi", "tags": [1, 2]}
+    result = validation.validate_fields(fields, ["name", "amount"], 100)
+    assert result["note"] == "hi"
+    assert result["tags"] == [1, 2]
+
+
+def test_pre_create_hook_matches_direct_validate_fields_calls():
+    config = {"validation_required_fields": ["name", "amount"], "validation_max_amount": 100}
+    fields = {"name": "x", "amount": 1}
+    assert validation.pre_create_hook(None, config, fields) == validation.validate_fields(
+        fields, config["validation_required_fields"], config["validation_max_amount"]
+    )
+    with pytest.raises(validation.ValidationError):
+        validation.pre_create_hook(None, config, {})
+    with pytest.raises(validation.ValidationError):
+        validation.validate_fields({}, config["validation_required_fields"], config["validation_max_amount"])
+
+
+def test_exact_messages_via_catalog():
+    assert str(_raises(lambda: validation.validate_fields(
+        {"amount": 1}, ["name", "amount"], 100))) == "missing field: name"
+    assert str(_raises(lambda: validation.validate_fields(
+        {"name": "x", "amount": True}, ["name", "amount"], 100))) == \
+        "field amount must be numeric (got bool)"
+    assert str(_raises(lambda: validation.validate_fields(
+        {"name": "x", "amount": -1}, ["name", "amount"], 100))) == \
+        "field amount must be non-negative"
+    assert str(_raises(lambda: validation.validate_fields(
+        {"name": "x", "amount": 101}, ["name", "amount"], 100))) == \
+        "field amount exceeds max_amount 100"
+    assert str(_raises(lambda: validation.validate_fields(
+        {"name": "", "amount": 1}, ["name", "amount"], 100))) == \
+        "field name must be a non-empty string"
+
+
+def _raises(fn):
+    with pytest.raises(validation.ValidationError) as exc:
+        fn()
+    return exc.value
+
+
+def test_validate_fields_float_amounts_are_legal():
+    result = validation.validate_fields({"name": "x", "amount": 3.5}, ["name", "amount"], 100)
+    assert result["amount"] == 3.5
+    result = validation.validate_fields({"name": "x", "amount": 100.0}, ["name", "amount"], 100)
+    assert result["amount"] == 100.0
+
+
+def test_validate_fields_none_nan_inf_amounts_raise_numeric():
+    for bad in (None, float("nan"), float("inf"), float("-inf")):
+        with pytest.raises(validation.ValidationError, match="numeric"):
+            validation.validate_fields({"name": "x", "amount": bad}, ["name", "amount"], 100)
+
+
+def test_validate_fields_name_internal_whitespace_and_unicode():
+    result = validation.validate_fields(
+        {"name": "  ada lovelace  ", "amount": 1}, ["name", "amount"], 100
+    )
+    assert result["name"] == "ada lovelace"
+    result = validation.validate_fields({"name": "Δ", "amount": 1}, ["name", "amount"], 100)
+    assert result["name"] == "Δ"
+
+
+def test_validate_fields_empty_required_fields_with_empty_fields():
+    assert validation.validate_fields({}, [], 100) == {}
+
+
+def test_validate_fields_max_amount_zero_boundary():
+    result = validation.validate_fields({"name": "x", "amount": 0}, ["name", "amount"], 0)
+    assert result["amount"] == 0
+    with pytest.raises(validation.ValidationError, match="max_amount"):
+        validation.validate_fields({"name": "x", "amount": 1}, ["name", "amount"], 0)
+
+
+def test_validate_fields_returned_dict_is_shallow_copy():
+    tags = [1, 2]
+    fields = {"name": "x", "amount": 1, "tags": tags}
+    result = validation.validate_fields(fields, ["name", "amount"], 100)
+    assert result["tags"] is tags
+
+
+def test_validate_fields_delegates_to_schema_is_valid_amount(monkeypatch):
+    monkeypatch.setattr(schema, "is_valid_amount", lambda v: False)
+    with pytest.raises(validation.ValidationError, match="numeric"):
+        validation.validate_fields({"name": "x", "amount": 5}, ["name", "amount"], 100)
+
+
+def test_validate_many_returns_validated_and_errors_in_input_order():
+    entries = [
+        {"name": "a", "amount": 1},
+        {"amount": 1},
+        {"name": "c", "amount": 1},
+        {"name": "d", "amount": -1},
+    ]
+    validated, errors = validation.validate_many(entries, ["name", "amount"], 100)
+    assert validated == [
+        {"name": "a", "amount": 1},
+        {"name": "c", "amount": 1},
+    ]
+    assert errors == [
+        (1, "missing field: name"),
+        (3, "field amount must be non-negative"),
+    ]
+    assert entries == [
+        {"name": "a", "amount": 1},
+        {"amount": 1},
+        {"name": "c", "amount": 1},
+        {"name": "d", "amount": -1},
+    ]
+
+
+def test_error_code_maps_every_catalog_code():
+    assert validation.error_code("missing field: name") == "missing"
+    assert validation.error_code("field amount must be numeric (got str)") == "numeric"
+    assert validation.error_code("field amount must be non-negative") == "non_negative"
+    assert validation.error_code("field amount exceeds max_amount 100") == "max"
+    assert validation.error_code("field name must be a non-empty string") == "non_empty"
+    assert validation.error_code("field name must be a string") == "type_str"
+
+
+def test_error_code_unmatchable_message_raises_value_error():
+    with pytest.raises(ValueError):
+        validation.error_code("totally unrelated message")
+
+
+def test_error_code_follows_monkeypatched_catalog(monkeypatch):
+    monkeypatch.setitem(schema.ERROR_CATALOG, "missing", "no {field} here")
+    assert validation.error_code("no name here") == "missing"
+
+
+def test_explain_config_literal_for_two_configs():
+    config_a = {"validation_required_fields": ["name", "amount"], "validation_max_amount": 100}
+    assert validation.explain_config(config_a) == (
+        "validation config:\n  required: name, amount\n  max_amount: 100"
+    )
+    config_b = {"validation_required_fields": ["name"], "validation_max_amount": 5}
+    assert validation.explain_config(config_b) == (
+        "validation config:\n  required: name\n  max_amount: 5"
+    )
