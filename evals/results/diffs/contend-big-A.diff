new file mode 100644
index 0000000..f9bbee6
--- /dev/null
+++ b/app/profiles.py
@@ -0,0 +1,77 @@
+"""Named-profile layer over app.schema specs.
+
+Pure module: imports app.schema only, has no state beyond the PROFILES
+constant, and every spec operation delegates to app.schema rather than
+reimplementing it.
+"""
+import copy
+
+from app import schema
+
+
+class ProfileError(Exception):
+    pass
+
+
+PROFILES = {
+    "record": {
+        "name": {"required": True, "type": "str", "non_empty": True},
+        "amount": {"required": True, "type": "number", "max": 100000},
+    },
+    "draft": {
+        "name": {"type": "str"},
+    },
+    "import": {
+        "name": {"required": True, "type": "str", "non_empty": True},
+        "amount": {"type": "number"},
+    },
+}
+
+
+def get_profile(name):
+    if name not in PROFILES:
+        raise ProfileError(name)
+    return copy.deepcopy(PROFILES[name])
+
+
+def validate_profile(fields, name):
+    validator = schema.compile_spec(get_profile(name))
+    return validator(fields)
+
+
+def merge_profiles(a, b):
+    return schema.merge_specs(get_profile(a), get_profile(b))
+
+
+def describe_profile(name):
+    return schema.describe_spec(get_profile(name))
+
+
+def compare_profiles(a, b):
+    return schema.diff_specs(get_profile(a), get_profile(b))
+
+
+def profile_from_config(config, name):
+    return schema.spec_from_config(config, "profile_" + name + "_")
+
+
+def profile_summary(name):
+    return "%s: %s" % (name, schema.spec_summary_line(get_profile(name)))
+
+
+def validate_all_profiles(fields):
+    return {
+        name: schema.validate_collect(get_profile(name), fields)
+        for name in PROFILES
+    }
+
+
+def strictest(names):
+    if not names:
+        raise ProfileError(names)
+
+    def rule_count(name):
+        spec = get_profile(name)
+        return sum(len(rules) for rules in spec.values())
+
+    return min(sorted(names), key=lambda name: -rule_count(name))
diff --git a/app/quota.py b/app/quota.py
new file mode 100644
index 0000000..b1e3874
--- /dev/null
+++ b/app/quota.py
@@ -0,0 +1,133 @@
+"""Windowed quota counter driven by a deterministic logical clock.
+
+Module-global state only: a logical clock (`_clock`, seconds — advanced
+only via `advance()`; no wall-clock time anywhere, so behavior is fully
+deterministic for tests) and a per-key hit-timestamp store (`_hits`).
+`reset()` clears both. Every other function reads/writes this shared
+state; there is exactly one clock and one hit store for the whole
+process, which `app/ratelimit.py`, `app/throttle.py`, and
+`app/backoff.py` all build on.
+"""
+
+
+class QuotaExceededError(Exception):
+    pass
+
+
+_clock = 0.0
+_hits = {}
+
+
+def reset():
+    """Clear the logical clock back to 0.0 and every key's hits."""
+    global _clock, _hits
+    _clock = 0.0
+    _hits = {}
+
+
+def now():
+    """Return the current logical clock value."""
+    return _clock
+
+
+def advance(seconds):
+    """Move the logical clock forward by `seconds` (>= 0) and return the
+    new value. The clock is monotonic: a negative `seconds` raises
+    ValueError and leaves the clock unchanged."""
+    global _clock
+    if seconds < 0:
+        raise ValueError("advance: seconds must be >= 0, got %r" % (seconds,))
+    _clock += seconds
+    return _clock
+
+
+def _prune(key, window_seconds):
+    """Drop hits for `key` strictly older than now() - window_seconds (a
+    hit sitting exactly at that boundary is kept). A no-op for an
+    infinite window. Returns the surviving (already-stored) hit list."""
+    hits = _hits.get(key)
+    if not hits or window_seconds == float("inf"):
+        return hits or []
+    threshold = now() - window_seconds
+    kept = [h for h in hits if h >= threshold]
+    if kept:
+        _hits[key] = kept
+    else:
+        del _hits[key]
+    return _hits.get(key, [])
+
+
+def take(key, limit, window_seconds, burst=0):
+    """Record a hit for `key` and return the new in-window hit count.
+    Raises QuotaExceededError, without recording, once the in-window
+    count would exceed `limit + burst`."""
+    hits = _prune(key, window_seconds)
+    allowed = limit + burst
+    if len(hits) >= allowed:
+        raise QuotaExceededError(
+            "quota exceeded for key %r: limit %s (burst %s)" % (key, limit, burst)
+        )
+    hits = list(hits)
+    hits.append(now())
+    _hits[key] = hits
+    return len(hits)
+
+
+def remaining(key, limit, window_seconds, burst=0):
+    """Return how many more `take` calls would succeed right now for
+    `key`, without recording a hit. Floors at 0."""
+    hits = _prune(key, window_seconds)
+    allowed = limit + burst
+    return max(0, allowed - len(hits))
+
+
+def snapshot(window_seconds):
+    """Return a dict mapping each key with at least one in-window hit to
+    the sorted list of its in-window hit timestamps. Keys with none are
+    omitted. The returned lists are fresh copies — mutating one never
+    affects later `snapshot`/`remaining` readings."""
+    result = {}
+    for key in list(_hits.keys()):
+        hits = _prune(key, window_seconds)
+        if hits:
+            result[key] = sorted(hits)
+    return result
+
+
+def time_to_next_slot(key, limit, window_seconds, burst=0):
+    """Return the seconds until one slot frees for `key`: 0.0 when a
+    take would succeed right now; otherwise the time until the oldest
+    in-window hit ages out. Never raises — an exhausted key with a zero
+    allowance (limit + burst == 0, so no hit was ever recorded) or an
+    infinite window reports float("inf") instead of crashing on an
+    empty hit list. Read-only."""
+    if remaining(key, limit, window_seconds, burst) > 0:
+        return 0.0
+    if window_seconds == float("inf"):
+        return float("inf")
+    hits = _hits.get(key, [])
+    if not hits:
+        return float("inf")
+    return min(hits) + window_seconds - now()
+
+
+def usage(key, limit, window_seconds, burst=0):
+    """Read-only snapshot of a key's quota state."""
+    hits = _prune(key, window_seconds)
+    return {
+        "used": len(hits),
+        "allowed": limit + burst,
+        "remaining": remaining(key, limit, window_seconds, burst),
+        "reset_in": time_to_next_slot(key, limit, window_seconds, burst),
+    }
+
+
+def purge(window_seconds):
+    """Drop every key's aged-out hits (removing keys left with none) and
+    return the total number of hits dropped."""
+    dropped = 0
+    for key in list(_hits.keys()):
+        before = len(_hits.get(key, []))
+        after = _prune(key, window_seconds)
+        dropped += before - len(after)
+    return dropped
diff --git a/app/ratelimit.py b/app/ratelimit.py
new file mode 100644
index 0000000..970be6e
--- /dev/null
+++ b/app/ratelimit.py
@@ -0,0 +1,94 @@
+"""Per-key rate limiting on POST writes, layered on app.quota.
+
+Keeps no counter state of its own — every increment lives in
+app.quota's module-global hit store; `reset()` simply delegates to
+`quota.reset()` so callers reset both the counters and the logical
+clock in one call.
+
+Wires into app.registry's DISPATCH_HOOKS as `dispatch_hook`.
+"""
+from app import quota
+
+
+class RateLimitExceededError(quota.QuotaExceededError):
+    pass
+
+
+def reset():
+    """Delegate to quota.reset(): clears every key's counter AND the
+    logical clock."""
+    quota.reset()
+
+
+def check_and_increment(key, limit, window_seconds=float("inf"), burst=0):
+    """Record a hit for `key` and return the new in-window count.
+    Delegates to quota.take; re-raises quota.QuotaExceededError as the
+    RateLimitExceededError subclass."""
+    try:
+        return quota.take(key, limit, window_seconds, burst=burst)
+    except quota.QuotaExceededError as exc:
+        raise RateLimitExceededError(
+            "rate limit exceeded for key %r: limit %s" % (key, limit)
+        ) from exc
+
+
+def dispatch_hook(store, config, method, path, kwargs):
+    """DISPATCH_HOOKS entry: rate-limits POST writes only (GETs and any
+    other method pass through untouched). The key is the caller's
+    `actor` kwarg, defaulting to "anonymous". Only
+    `rate_limit_max_per_window` is a required config key; window and
+    burst always read via `.get(...)` defaults so a minimal, limit-only
+    config still works."""
+    if method != "POST":
+        return
+    actor = kwargs.get("actor", "anonymous")
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    check_and_increment(actor, limit, window_seconds, burst=burst)
+
+
+def retry_after(key, config):
+    """Seconds until `key`'s next slot frees, read-only. Delegates to
+    quota.time_to_next_slot using the same config-key conventions as
+    dispatch_hook."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    return quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
+
+
+def limit_headers(key, config):
+    """Read-only rate-limit response headers, values coerced to str.
+    "Limit" is the bare configured limit; burst is reflected only in
+    "Remaining"'s full allowance."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    remaining = quota.remaining(key, limit, window_seconds, burst=burst)
+    reset_in = quota.time_to_next_slot(key, limit, window_seconds, burst=burst)
+    return {
+        "X-RateLimit-Limit": str(limit),
+        "X-RateLimit-Remaining": str(remaining),
+        "X-RateLimit-Reset": str(reset_in),
+    }
+
+
+def status_line(key, config):
+    """Read-only human-readable status line built from quota.usage."""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    u = quota.usage(key, limit, window_seconds, burst=burst)
+    return "%s: %s/%s, reset in %ss" % (key, u["used"], u["allowed"], u["reset_in"])
+
+
+def check_many(keys, config):
+    """Read-only: for each key, would a POST succeed right now?"""
+    limit = config["rate_limit_max_per_window"]
+    window_seconds = config.get("rate_limit_window_seconds", 60)
+    burst = config.get("rate_limit_burst", 0)
+    return {
+        key: quota.remaining(key, limit, window_seconds, burst=burst) > 0
+        for key in keys
+    }
