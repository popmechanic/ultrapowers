@@ -0,0 +1,192 @@
+"""Tests for the export formatter app/export.py."""
+import json
+
+import pytest
+
+from app import export, tabular
+
+
+def test_to_csv_empty():
+    assert export.to_csv([]) == ""
+
+
+def test_to_csv_sorted_header_and_missing_fields():
+    records = [{"a": 1, "b": 2}, {"a": 33, "c": "x"}]
+    assert export.to_csv(records) == "a,b,c\n1,2,\n33,,x"
+
+
+def test_to_csv_plain_str_for_non_strings():
+    records = [{"amount": 5, "name": "x"}]
+    assert export.to_csv(records) == "amount,name\n5,x"
+
+
+def test_to_json_empty():
+    assert export.to_json([]) == "[]"
+
+
+def test_to_json_round_trips_and_sorts_keys():
+    records = [{"b": 1, "a": 2}, {"a": 3, "b": 4}]
+    text = export.to_json(records)
+    assert text == '[{"a": 2, "b": 1}, {"a": 3, "b": 4}]'
+    assert json.loads(text) == records
+
+
+def test_to_csv_escapes_cells():
+    plain = export.to_csv([{"name": "plain", "amount": 1}])
+    assert plain == "amount,name\n1,plain"
+    comma = export.to_csv([{"name": "a,b", "amount": 1}])
+    assert comma == 'amount,name\n1,"a,b"'
+    quote = export.to_csv([{"name": 'say "hi"', "amount": 1}])
+    assert quote == 'amount,name\n1,"say ""hi"""'
+
+
+def test_to_markdown_empty():
+    assert export.to_markdown([]) == ""
+
+
+def test_to_markdown_pads_and_pins_missing_fields():
+    records = [{"a": 1, "b": 2}, {"a": 33, "c": "x"}]
+    expected = "| a  | b | c |\n| -- | - | - |\n| 1  | 2 |   |\n| 33 |   | x |"
+    assert export.to_markdown(records) == expected
+
+
+def test_to_ndjson_empty():
+    assert export.to_ndjson([]) == ""
+
+
+def test_to_ndjson_one_object_per_line():
+    records = [{"a": 1, "b": 2}, {"a": 33, "c": "x"}]
+    expected = '{"a": 1, "b": 2}\n{"a": 33, "c": "x"}'
+    assert export.to_ndjson(records) == expected
+    for line in export.to_ndjson(records).split("\n"):
+        json.loads(line)
+
+
+def test_to_markdown_align_left_and_right():
+    records = [{"a": 1, "b": 2}, {"a": 33, "c": "x"}]
+    left = "| a  | b | c |\n| -- | - | - |\n| 1  | 2 |   |\n| 33 |   | x |"
+    right = "|  a | b | c |\n| -: | : | : |\n|  1 | 2 |   |\n| 33 |   | x |"
+    assert export.to_markdown(records) == left
+    assert export.to_markdown(records, align="right") == right
+
+
+def test_to_markdown_bad_align_raises_even_when_widths_already_fit():
+    # every cell already meets its column width (single-char values,
+    # single-char headers) so pad's width short-circuit cannot skip the
+    # align validation.
+    records = [{"a": "1"}, {"a": "2"}]
+    with pytest.raises(ValueError):
+        export.to_markdown(records, align="center")
+
+
+def test_to_tsv_empty():
+    assert export.to_tsv([]) == ""
+
+
+def test_to_tsv_sanitizes_cells_and_headers():
+    records = [{"na\tme": "a\nb", "x": 1}]
+    expected = "na me\tx\na b\t1"
+    assert export.to_tsv(records) == expected
+
+
+def test_to_html_empty():
+    assert export.to_html([]) == ""
+
+
+def test_to_html_exact_literal():
+    # Unequal key sets: the second record has no "name", pinning the
+    # missing-field -> empty <td></td> clause. One value carries both "&"
+    # and "<" so ampersand-first escaping is pinned inside a single cell.
+    records = [{"a": 1, "name": "A & <b>"}, {"a": 2}]
+    expected = (
+        "<table>\n"
+        "<tr><th>a</th><th>name</th></tr>\n"
+        "<tr><td>1</td><td>A &amp; &lt;b&gt;</td></tr>\n"
+        "<tr><td>2</td><td></td></tr>\n"
+        "</table>"
+    )
+    assert export.to_html(records) == expected
+
+
+def test_parse_csv_inverse_of_to_csv():
+    assert export.parse_csv("") == []
+    record = {"name": 'a,b"c\nd', "x": 1}
+    text = export.to_csv([record])
+    parsed = export.parse_csv(text)
+    expected = {k: str(v) for k, v in record.items()}
+    assert parsed == [expected]
+
+
+def test_parse_csv_never_re_types_values():
+    text = export.to_csv([{"amount": 3}])
+    assert export.parse_csv(text) == [{"amount": "3"}]
+
+
+def test_parse_csv_unterminated_quote_raises():
+    with pytest.raises(ValueError):
+        export.parse_csv('"unterminated')
+
+
+def test_parse_csv_single_column_corner_cases():
+    assert export.parse_csv("a\n") == [{"a": ""}]
+    assert export.parse_csv("a") == []
+
+
+def test_formats_dict_exact_keys():
+    assert set(export.FORMATS.keys()) == {"csv", "json", "md", "ndjson", "tsv"}
+    assert export.FORMATS["csv"] is export.to_csv
+    assert export.FORMATS["json"] is export.to_json
+    assert export.FORMATS["md"] is export.to_markdown
+    assert export.FORMATS["ndjson"] is export.to_ndjson
+    assert export.FORMATS["tsv"] is export.to_tsv
+
+
+def test_extra_formats_dict_exact_key():
+    assert set(export.EXTRA_FORMATS.keys()) == {"html"}
+    assert export.EXTRA_FORMATS["html"] is export.to_html
+
+
+def test_render_delegates_to_matching_function():
+    records = [{"a": 1, "b": 2}, {"a": 33, "c": "x"}]
+    for fmt, fn in export.FORMATS.items():
+        assert export.render(records, fmt) == fn(records)
+
+
+def test_render_rejects_unknown_and_extra_formats():
+    with pytest.raises(ValueError) as excinfo:
+        export.render([], "xml")
+    assert "xml" in str(excinfo.value)
+    with pytest.raises(ValueError):
+        export.render([], "html")
+
+
+def test_render_any_serves_formats_then_extra_formats():
+    records = [{"a": 1, "b": 2}]
+    assert export.render_any(records, "csv") == export.to_csv(records)
+    assert export.render_any(records, "html") == export.to_html(records)
+    with pytest.raises(ValueError) as excinfo:
+        export.render_any(records, "xml")
+    assert "xml" in str(excinfo.value)
+
+
+def test_summary_line():
+    records = [{"a": 1, "b": 2}, {"a": 33, "c": "x"}]
+    assert export.summary_line(records) == "2 records, 3 columns"
+    assert export.summary_line([]) == "0 records, 0 columns"
+
+
+def test_single_record_coverage_all_formats():
+    records = [{"amount": 5, "name": "x"}]
+    assert export.to_csv(records) == "amount,name\n5,x"
+    assert export.to_json(records) == '[{"amount": 5, "name": "x"}]'
+    assert export.to_markdown(records) == (
+        "| amount | name |\n| ------ | ---- |\n| 5      | x    |"
+    )
+    assert export.to_ndjson(records) == '{"amount": 5, "name": "x"}'
+    assert export.to_tsv(records) == "amount\tname\n5\tx"
+    assert export.to_html(records) == (
+        "<table>\n"
+        "<tr><th>amount</th><th>name</th></tr>\n"
+        "<tr><td>5</td><td>x</td></tr>\n"
+        "</table>"
+    )
diff --git a/tests/test_profiles.py b/tests/test_profiles.py
