@@ -0,0 +1,82 @@
+"""Pure policy layer over app.quota — path/method-keyed rate policies.
+
+Imports app.quota only (never app.ratelimit); no module state of its
+own beyond the POLICIES constant. NOT wired into app.registry — a
+library layer other callers (e.g. app.tiers) build on.
+"""
+from app import quota
+
+
+class PolicyError(Exception):
+    pass
+
+
+POLICIES = {
+    "POST /records": {"limit": 5, "window": 60, "burst": 0},
+    "GET /export": {"limit": 10, "window": 60, "burst": 2},
+}
+
+
+def match_policy(method, path, policies):
+    """Return the policy dict whose key's method matches `method` and
+    whose path-prefix is a prefix of `path`, preferring the longest
+    matching prefix. None if nothing matches."""
+    best = None
+    best_len = -1
+    for policy_key, policy in policies.items():
+        policy_method, _, prefix = policy_key.partition(" ")
+        if policy_method != method:
+            continue
+        if path.startswith(prefix) and len(prefix) > best_len:
+            best = policy
+            best_len = len(prefix)
+    return best
+
+
+def key_for(method, path, actor):
+    return "%s %s:%s" % (method, path, actor)
+
+
+def enforce(method, path, actor, policies):
+    """No matching policy: return None, record nothing. A match:
+    delegate to quota.take under the policy's params and return the
+    in-window count, or raise PolicyError (chained) once exhausted."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    key = key_for(method, path, actor)
+    try:
+        return quota.take(
+            key, policy["limit"], policy["window"], burst=policy.get("burst", 0)
+        )
+    except quota.QuotaExceededError as exc:
+        raise PolicyError(
+            "policy exceeded for key %r: limit %s" % (key, policy["limit"])
+        ) from exc
+
+
+def remaining_for(method, path, actor, policies):
+    """Read-only: None when no policy matches, else quota.remaining
+    under the policy's params."""
+    policy = match_policy(method, path, policies)
+    if policy is None:
+        return None
+    key = key_for(method, path, actor)
+    return quota.remaining(
+        key, policy["limit"], policy["window"], burst=policy.get("burst", 0)
+    )
+
+
+def describe_policies(policies):
+    """Render one line per policy key (sorted), or a fixed placeholder
+    for an empty policy set."""
+    if not policies:
+        return "(no policies)"
+    lines = []
+    for key in sorted(policies):
+        policy = policies[key]
+        lines.append(
+            "%s: limit=%s, window=%s, burst=%s"
+            % (key, policy["limit"], policy["window"], policy["burst"])
+        )
+    return "\n".join(lines)
