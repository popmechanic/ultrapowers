+"""Tests for the pure rule-combinator layer in app/rules.py."""
+import pytest
+
+from app import rules
+from app import schema
+
+
+def test_rule_error_is_exception_subclass_distinct_from_schema_error():
+    assert issubclass(rules.RuleError, Exception)
+    assert not issubclass(rules.RuleError, schema.SchemaError)
+
+
+def test_rule_builds_dict_and_rejects_bad_name():
+    r = rules.rule("positive", lambda v: v > 0)
+    assert r == {"name": "positive", "test": r["test"]}
+    assert r["name"] == "positive"
+    with pytest.raises(ValueError):
+        rules.rule("", lambda v: True)
+    with pytest.raises(ValueError):
+        rules.rule(None, lambda v: True)
+
+
+def test_check_calls_predicate_and_coerces_to_bool():
+    r = rules.rule("truthy", lambda v: v)
+    assert rules.check(1, r) is True
+    assert rules.check(0, r) is False
+
+
+def test_all_of_passes_iff_every_child_passes():
+    positive = rules.rule("positive", lambda v: v > 0)
+    even = rules.rule("even", lambda v: v % 2 == 0)
+    combo = rules.all_of(positive, even)
+    assert combo["name"] == "all(positive,even)"
+    assert rules.check(4, combo) is True
+    assert rules.check(3, combo) is False
+    assert rules.check(-4, combo) is False
+
+
+def test_all_of_no_children_passes_everything():
+    combo = rules.all_of()
+    assert combo["name"] == "all()"
+    assert rules.check("anything", combo) is True
+
+
+def test_any_of_passes_iff_at_least_one_child_passes():
+    positive = rules.rule("positive", lambda v: v > 0)
+    even = rules.rule("even", lambda v: v % 2 == 0)
+    combo = rules.any_of(positive, even)
+    assert combo["name"] == "any(positive,even)"
+    assert rules.check(3, combo) is True
+    assert rules.check(-4, combo) is True
+    assert rules.check(-3, combo) is False
+
+
+def test_any_of_no_children_raises_value_error():
+    with pytest.raises(ValueError):
+        rules.any_of()
+
+
+def test_negate_inverts_and_names():
+    positive = rules.rule("positive", lambda v: v > 0)
+    not_positive = rules.negate(positive)
+    assert not_positive["name"] == "not(positive)"
+    assert rules.check(1, not_positive) is False
+    assert rules.check(-1, not_positive) is True
+
+
+def test_when_material_implication_truth_table():
+    true_rule = rules.rule("true", lambda v: True)
+    false_rule = rules.rule("false", lambda v: False)
+
+    tt = rules.when(true_rule, true_rule)
+    assert tt["name"] == "when(true,true)"
+    assert rules.check(0, tt) is True
+
+    tf = rules.when(true_rule, false_rule)
+    assert rules.check(0, tf) is False
+
+    ft = rules.when(false_rule, true_rule)
+    assert rules.check(0, ft) is True
+
+    ff = rules.when(false_rule, false_rule)
+    assert rules.check(0, ff) is True
+
+
+def test_explain_pass_and_fail():
+    positive = rules.rule("positive", lambda v: v > 0)
+    assert rules.explain(1, positive) == "positive: pass"
+    assert rules.explain(-1, positive) == "positive: fail"
+
+
+def test_apply_rules_returns_failure_strings_in_insertion_order():
+    positive = rules.rule("positive", lambda v: v > 0)
+    non_empty = rules.rule("non_empty", lambda v: bool(v))
+    rules_by_field = {"amount": positive, "name": non_empty}
+    fields = {"amount": -1, "name": ""}
+    assert rules.apply_rules(fields, rules_by_field) == [
+        "field amount failed positive",
+        "field name failed non_empty",
+    ]
+
+
+def test_apply_rules_skips_absent_fields_and_empty_when_all_pass():
+    positive = rules.rule("positive", lambda v: v > 0)
+    rules_by_field = {"amount": positive, "missing_field": positive}
+    assert rules.apply_rules({"amount": 5}, rules_by_field) == []
+
+
+def test_apply_rules_does_not_mutate_fields():
+    positive = rules.rule("positive", lambda v: v > 0)
+    fields = {"amount": -1}
+    original = dict(fields)
+    rules.apply_rules(fields, {"amount": positive})
+    assert fields == original
+
+
+def test_first_failure_returns_first_failing_tuple_or_none():
+    positive = rules.rule("positive", lambda v: v > 0)
+    rules_by_field = {"amount": positive, "other": positive}
+    assert rules.first_failure({"amount": -1, "other": -1}, rules_by_field) == (
+        "amount", "positive",
+    )
+    assert rules.first_failure({"amount": 1, "other": 1}, rules_by_field) is None
+
+
+def test_explain_failures_only_failing_fields_in_insertion_order():
+    positive = rules.rule("positive", lambda v: v > 0)
+    rules_by_field = {"a": positive, "b": positive, "c": positive}
+    fields = {"a": 1, "b": -1, "c": -2}
+    assert rules.explain_failures(fields, rules_by_field) == [
+        "positive: fail",
+        "positive: fail",
+    ]
+
+
+def test_explain_failures_empty_when_all_pass():
+    positive = rules.rule("positive", lambda v: v > 0)
+    assert rules.explain_failures({"a": 1}, {"a": positive}) == []
+
+
+def test_builtins_has_exactly_expected_keys_and_behavior():
+    assert set(rules.BUILTINS.keys()) == {"number", "str", "non_empty"}
+    assert rules.BUILTINS["number"]["name"] == "number"
+    assert rules.check(5, rules.BUILTINS["number"]) is True
+    assert rules.check("5", rules.BUILTINS["number"]) is False
+    assert rules.BUILTINS["str"]["name"] == "str"
+    assert rules.check("x", rules.BUILTINS["str"]) is True
+    assert rules.check(5, rules.BUILTINS["str"]) is False
+    assert rules.BUILTINS["non_empty"]["name"] == "non_empty"
+    assert rules.check("x", rules.BUILTINS["non_empty"]) is True
+    assert rules.check("   ", rules.BUILTINS["non_empty"]) is False
+
+
+def test_parse_rule_single_builtin():
+    r = rules.parse_rule("number")
+    assert r["name"] == "number"
+    assert rules.check(5, r) is True
+
+
+def test_parse_rule_composite_in_text_order():
+    r = rules.parse_rule("number&non_empty")
+    assert r["name"] == "all(number,non_empty)"
+
+
+def test_parse_rule_unknown_token_raises_value_error_naming_token():
+    with pytest.raises(ValueError, match="bogus"):
+        rules.parse_rule("bogus")
+
+
+def test_parse_rule_empty_string_raises_value_error():
+    with pytest.raises(ValueError):
+        rules.parse_rule("")
+
+
+def test_parse_rules_maps_dict_in_insertion_order():
+    parsed = rules.parse_rules({"amount": "number", "name": "str&non_empty"})
+    assert list(parsed.keys()) == ["amount", "name"]
+    assert parsed["amount"]["name"] == "number"
+    assert parsed["name"]["name"] == "all(str,non_empty)"
+
+
+def test_parse_rules_unknown_token_names_field_and_token():
+    with pytest.raises(ValueError, match="amount"):
+        rules.parse_rules({"amount": "bogus"})
+    with pytest.raises(ValueError, match="bogus"):
+        rules.parse_rules({"amount": "bogus"})
+
+
+def test_parse_rules_empty_dict_returns_empty_dict():
+    assert rules.parse_rules({}) == {}
+
+
+def test_parse_rules_end_to_end_with_apply_rules():
+    rules_by_field = rules.parse_rules({"amount": "number", "name": "non_empty"})
+    fields = {"amount": "3", "name": "ok"}
+    assert rules.apply_rules(fields, rules_by_field) == [
+        "field amount failed number",
+    ]
+
+
+def test_describe_rules_two_field_literal():
+    number_rule = rules.BUILTINS["number"]
+    composite = rules.all_of(rules.BUILTINS["str"], rules.BUILTINS["non_empty"])
+    rules_by_field = {"amount": number_rule, "name": composite}
+    assert rules.describe_rules(rules_by_field) == (
+        "amount: number\nname: all(str,non_empty)"
+    )
+
+
+def test_describe_rules_empty():
+    assert rules.describe_rules({}) == "(no rules)"
+
+
+def test_builtins_number_delegates_to_schema_is_valid_amount(monkeypatch):
+    monkeypatch.setattr(schema, "is_valid_amount", lambda v: False)
+    fresh_rule = rules.parse_rule("number")
+    assert rules.check(5, fresh_rule) is False
