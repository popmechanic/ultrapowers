index 0000000..5206a1d
--- /dev/null
+++ b/app/tabular.py
@@ -0,0 +1,129 @@
+"""Column-model toolkit: the shared primitives export.py builds on.
+
+Pure functions only, no imports beyond the standard library. Every
+key-union, cell-formatting, escaping, and padding rule the export
+renderers need lives here exactly once.
+"""
+
+
+def columns(records):
+    """Sorted union of every key across all records."""
+    keys = set()
+    for record in records:
+        keys.update(record.keys())
+    return sorted(keys)
+
+
+def cell(value):
+    """Plain str() rendering of a value, except None -> ""."""
+    if value is None:
+        return ""
+    return str(value)
+
+
+def escape_csv(value):
+    """CSV-escape a single cell (RFC4180-ish): quote iff the cell contains
+    a comma, quote, or newline; double any inner quotes."""
+    text = value if isinstance(value, str) else cell(value)
+    if "," in text or '"' in text or "\n" in text or "\r" in text:
+        return '"' + text.replace('"', '""') + '"'
+    return text
+
+
+def widths(records, cols):
+    """dict mapping each column name to max(len(header), max cell width)."""
+    result = {}
+    for col in cols:
+        widest = len(col)
+        for record in records:
+            widest = max(widest, len(cell(record.get(col))))
+        result[col] = widest
+    return result
+
+
+def pad(value, width, align):
+    """Pad `value` to `width` using `align` ("left" or "right"). A value at
+    or beyond `width` is returned unchanged. `align` is validated before
+    any short-circuit on width."""
+    if align not in ("left", "right"):
+        raise ValueError(align)
+    if len(value) >= width:
+        return value
+    fill = " " * (width - len(value))
+    if align == "left":
+        return value + fill
+    return fill + value
+
+
+def sanitize_flat(value):
+    """cell(value) with every tab/newline replaced by a single space."""
+    text = cell(value)
+    return text.replace("\t", " ").replace("\n", " ").replace("\r", " ")
+
+
+def escape_html(value):
+    """cell(value) HTML-escaped: & first, then < > "."""
+    text = cell(value)
+    text = text.replace("&", "&amp;")
+    text = text.replace("<", "&lt;")
+    text = text.replace(">", "&gt;")
+    text = text.replace('"', "&quot;")
+    return text
+
+
+def truncate(value, width, marker="..."):
+    """`value` unchanged if it already fits `width`; else truncated with
+    `marker` appended so the result is exactly `width` characters. A
+    `width` too small to hold the marker only raises when truncation is
+    actually needed -- an already-fitting value never triggers it."""
+    if len(value) <= width:
+        return value
+    if width < len(marker):
+        raise ValueError(width)
+    return value[: width - len(marker)] + marker
+
+
+def wrap(value, width):
+    """Greedily wrap `value` on spaces into lines each <= width. A single
+    word longer than width is hard-split at width."""
+    if width < 1:
+        raise ValueError(width)
+    if value == "":
+        return [""]
+
+    lines = []
+    current = ""
+    for word in value.split(" "):
+        while len(word) > width:
+            if current:
+                lines.append(current)
+                current = ""
+            lines.append(word[:width])
+            word = word[width:]
+        if not current:
+            candidate = word
+        else:
+            candidate = current + " " + word
+        if len(candidate) <= width:
+            current = candidate
+        else:
+            lines.append(current)
+            current = word
+    lines.append(current)
+    return lines
+
+
+def fit(value, width, align):
+    """Compose truncate then pad: an over-long value is truncated to
+    `width` (marker included), a short one padded per `align`."""
+    return pad(truncate(value, width), width, align)
+
+
+def render_row(cells, widths_list, align):
+    """Render one pipe-table row: "| " + " | ".join(padded cells) + " |"."""
+    if len(cells) != len(widths_list):
+        raise ValueError(
+            "cells/widths length mismatch: %d != %d" % (len(cells), len(widths_list))
+        )
+    padded = [pad(c, w, align) for c, w in zip(cells, widths_list)]
+    return "| " + " | ".join(padded) + " |"
