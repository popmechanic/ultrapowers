+        },
+    }
+
+
+def test_get_profile_returns_deep_copy_and_unknown_name_raises():
+    spec = profiles.get_profile("record")
+    spec["name"]["required"] = False
+    assert profiles.PROFILES["record"]["name"]["required"] is True
+
+    with pytest.raises(profiles.ProfileError, match="nope"):
+        profiles.get_profile("nope")
+
+
+def test_validate_profile_delegates_to_compile_spec(monkeypatch):
+    recorded = {}
+    real_compile_spec = schema.compile_spec
+
+    def recorder(spec):
+        recorded["spec"] = spec
+        return real_compile_spec(spec)
+
+    monkeypatch.setattr(schema, "compile_spec", recorder)
+    profiles.validate_profile({"name": "x", "amount": 1}, "record")
+    assert recorded["spec"] == profiles.get_profile("record")
+
+
+def test_validate_profile_end_to_end():
+    result = profiles.validate_profile({"name": "  ada  ", "amount": 1}, "record")
+    assert result == {"name": "ada", "amount": 1}
+
+    with pytest.raises(schema.SchemaError) as exc:
+        profiles.validate_profile({}, "record")
+    assert str(exc.value) == "missing field: name"
+
+
+def test_merge_profiles_delegates_to_merge_specs(monkeypatch):
+    recorded = {}
+    real_merge_specs = schema.merge_specs
+
+    def recorder(a, b):
+        recorded["args"] = (a, b)
+        return real_merge_specs(a, b)
+
+    monkeypatch.setattr(schema, "merge_specs", recorder)
+    profiles.merge_profiles("draft", "import")
+    assert recorded["args"] == (profiles.get_profile("draft"), profiles.get_profile("import"))
+
+
+def test_merge_profiles_draft_and_import_equals_import_spec():
+    assert profiles.merge_profiles("draft", "import") == profiles.PROFILES["import"]
+    assert profiles.PROFILES == {
+        "record": profiles.PROFILES["record"],
+        "draft": {"name": {"type": "str"}},
+        "import": {
+            "name": {"required": True, "type": "str", "non_empty": True},
+            "amount": {"type": "number"},
+        },
+    }
+
+
+def test_describe_profile_literal_for_draft():
+    assert profiles.describe_profile("draft") == "name: type=str"
+
+
+def test_compare_profiles_exact_diff():
+    assert profiles.compare_profiles("draft", "import") == {
+        "added": ["amount"],
+        "removed": [],
+        "changed": ["name"],
+    }
+
+
+def test_profile_from_config_delegates_to_spec_from_config(monkeypatch):
+    recorded = {}
+    real_spec_from_config = schema.spec_from_config
+
+    def recorder(config, prefix):
+        recorded["prefix"] = prefix
+        return real_spec_from_config(config, prefix)
+
+    monkeypatch.setattr(schema, "spec_from_config", recorder)
+    profiles.profile_from_config({}, "x")
+    assert recorded["prefix"] == "profile_x_"
+
+
+def test_profile_from_config_end_to_end():
+    config = {"profile_x_name": {"required": True}, "other": 1}
+    spec = profiles.profile_from_config(config, "x")
+    validator = schema.compile_spec(spec)
+    with pytest.raises(schema.SchemaError) as exc:
+        validator({})
+    assert str(exc.value) == "missing field: name"
+
+
+def test_profile_summary_literal_for_draft():
+    assert profiles.profile_summary("draft") == "draft: 1 fields, 1 rules"
+
+
+def test_validate_all_profiles_exact_dict_for_empty_fields():
+    assert profiles.validate_all_profiles({}) == {
+        "draft": [],
+        "import": ["missing field: name"],
+        "record": ["missing field: name", "missing field: amount"],
+    }
+
+
+def test_strictest_two_profiles():
+    assert profiles.strictest(["draft", "import"]) == "import"
+
+
+def test_strictest_three_profiles():
+    assert profiles.strictest(["record", "import", "draft"]) == "record"
+
+
+def test_strictest_empty_raises_profile_error():
+    with pytest.raises(profiles.ProfileError):
+        profiles.strictest([])
diff --git a/tests/test_quota.py b/tests/test_quota.py
new file mode 100644
index 0000000..30037dc
--- /dev/null
+++ b/tests/test_quota.py
@@ -0,0 +1,180 @@
+"""Tests for the windowed quota counter in app/quota.py."""
+import pytest
+
+from app import quota
+
+
+def setup_function(_fn):
+    quota.reset()
+
+
+def test_quota_exceeded_error_is_exception_subclass():
+    assert issubclass(quota.QuotaExceededError, Exception)
+
+
+def test_now_and_advance():
+    assert quota.now() == 0.0
+    assert quota.advance(30) == 30.0
+    assert quota.now() == 30.0
+    with pytest.raises(ValueError):
+        quota.advance(-1)
+    assert quota.now() == 30.0
+
+
+def test_take_counts_then_raises():
+    assert quota.take("k", limit=2, window_seconds=60) == 1
+    assert quota.take("k", limit=2, window_seconds=60) == 2
+    with pytest.raises(quota.QuotaExceededError) as exc:
+        quota.take("k", limit=2, window_seconds=60)
+    message = str(exc.value)
+    assert "k" in message
+    assert "2" in message
+
+
+def test_window_pruning():
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(61)
+    assert quota.take("k", 2, 60) == 1
+
+    quota.reset()
+    quota.advance(30)
+    quota.take("k", 2, 60)  # hit recorded at t=30
+    quota.advance(31)  # now = 61
+    assert quota.now() == 61.0
+    assert quota.remaining("k", 1, 60) == 0  # still counts at t=61
+    quota.advance(30)  # now = 91
+    assert quota.now() == 91.0
+    assert quota.remaining("k", 1, 60) == 1  # no longer counts at t=91
+
+
+def test_infinite_window_never_prunes():
+    quota.take("k", 1, float("inf"))
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 1, float("inf"))
+    quota.advance(10 ** 6)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 1, float("inf"))
+
+
+def test_burst_allows_extra_hits():
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 1
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 2
+    assert quota.take("k", limit=2, window_seconds=60, burst=1) == 3
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", limit=2, window_seconds=60, burst=1)
+
+
+def test_per_key_independence():
+    quota.take("a", 1, 60)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("a", 1, 60)
+    # "b" is untouched by "a"'s exhaustion, same clock and window
+    assert quota.take("b", 1, 60) == 1
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("b", 1, 60)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("a", 1, 60)
+
+
+def test_reset_clears_clock_and_all_hits():
+    quota.advance(5)
+    quota.take("k", 1, 60)
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 1, 60)
+    quota.reset()
+    assert quota.now() == 0.0
+    assert quota.take("k", 1, 60) == 1
+
+
+def test_remaining_is_read_only_and_recovers_after_window():
+    assert quota.remaining("k", 2, 60) == 2
+    quota.take("k", 2, 60)
+    assert quota.remaining("k", 2, 60) == 1
+    assert quota.remaining("k", 2, 60) == 1  # calling twice: same value
+    assert quota.take("k", 2, 60) == 2  # still succeeds where it should
+    assert quota.remaining("k", 2, 60) == 0  # floors at 0 when exhausted
+    quota.advance(61)
+    assert quota.remaining("k", 2, 60) == 2  # recovers to full allowance
+
+
+def test_snapshot_exact_and_deep_copy():
+    quota.take("a", 5, 60)  # t=0
+    quota.advance(10)
+    quota.take("a", 5, 60)  # t=10
+    quota.take("b", 5, 60)  # t=10
+    assert quota.snapshot(60) == {"a": [0.0, 10.0], "b": [10.0]}
+
+    snap = quota.snapshot(60)
+    snap["a"].append(999.0)
+    snap["a"].append(-1.0)
+    later = quota.snapshot(60)
+    assert later == {"a": [0.0, 10.0], "b": [10.0]}
+    assert quota.remaining("a", 5, 60) == 3
+
+
+def test_snapshot_omits_keys_with_no_in_window_hits():
+    quota.take("a", 5, 60)  # t=0
+    quota.advance(61)
+    assert quota.snapshot(60) == {}
+
+
+def test_time_to_next_slot():
+    assert quota.time_to_next_slot("k", 0, 60) == float("inf")
+
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    assert quota.time_to_next_slot("k", 2, 60) == 50.0
+
+    assert quota.remaining("k", 2, 60) == 0  # read-only: still exhausted
+
+
+def test_time_to_next_slot_infinite_window():
+    quota.take("k", 1, float("inf"))
+    assert quota.time_to_next_slot("k", 1, float("inf")) == float("inf")
+
+
+def test_time_to_next_slot_boundary_exactly_at_window_edge():
+    quota.take("k", 2, 60)
+    quota.take("k", 2, 60)
+    quota.advance(60)
+    assert quota.time_to_next_slot("k", 2, 60) == 0.0
+    with pytest.raises(quota.QuotaExceededError):
+        quota.take("k", 2, 60)
+
+
+def test_usage_exact_dict_three_states():
+    assert quota.usage("k", 2, 60) == {
+        "used": 0,
+        "allowed": 2,
+        "remaining": 2,
+        "reset_in": 0.0,
+    }
+
+    quota.take("k", 2, 60)
+    assert quota.usage("k", 2, 60) == {
+        "used": 1,
+        "allowed": 2,
+        "remaining": 1,
+        "reset_in": 0.0,
+    }
+
+    quota.take("k", 2, 60)
+    quota.advance(10)
+    assert quota.usage("k", 2, 60) == {
+        "used": 2,
+        "allowed": 2,
+        "remaining": 0,
+        "reset_in": 50.0,
+    }
+
+
+def test_purge_counts_dropped_and_updates_snapshot():
+    quota.take("a", 5, 60)  # t=0
+    quota.advance(61)
+    quota.take("b", 5, 60)  # t=61
+
+    assert quota.purge(60) == 1
+    assert "a" not in quota.snapshot(60)
+    assert quota.purge(60) == 0
