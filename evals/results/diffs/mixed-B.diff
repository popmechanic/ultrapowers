new file mode 100644
index 0000000..e06ac24
--- /dev/null
+++ b/apistub/validate.py
@@ -0,0 +1,24 @@
+"""Payload validation against the User creation-payload field contract."""
+
+from apistub.schema import FIELDS
+
+
+def validate_payload(payload):
+    """Validate a creation payload against `schema.FIELDS`.
+
+    Returns a list of error strings, empty when the payload is valid.
+    Unknown keys in the payload are ignored.
+    """
+    errors = []
+
+    for key, declared_type in FIELDS.items():
+        if key not in payload:
+            errors.append(f"missing: {key}")
+        elif not isinstance(payload[key], declared_type):
+            errors.append(f"wrong type: {key}")
+
+    email = payload.get("email")
+    if isinstance(email, str) and "@" not in email:
+        errors.append("invalid: email")
+
+    return errors
