--- /dev/null
+++ b/apistub/store.py
@@ -0,0 +1,28 @@
+"""In-memory storage for User records."""
+
+from typing import Dict, List, Optional
+
+from apistub.schema import User
+
+
+class MemoryStore:
+    """A simple in-memory store for `User` records."""
+
+    def __init__(self) -> None:
+        self._users: Dict[int, User] = {}
+        self._next_id: int = 1
+
+    def add(self, name: str, email: str) -> User:
+        """Create a new `User` with an auto-incrementing id and store it."""
+        user = User(self._next_id, name, email)
+        self._users[user.id] = user
+        self._next_id += 1
+        return user
+
+    def get(self, user_id: int) -> Optional[User]:
+        """Return the `User` with the given id, or `None` if not found."""
+        return self._users.get(user_id)
+
+    def list(self) -> List[User]:
+        """Return all users in insertion order."""
+        return list(self._users.values())
