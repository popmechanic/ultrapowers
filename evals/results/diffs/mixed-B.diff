@@ -0,0 +1,59 @@
+import json
+
+from apistub.handlers import create_user, get_user
+from apistub.store import MemoryStore
+
+
+def test_create_user_returns_400_with_errors_when_payload_invalid():
+    store = MemoryStore()
+    status, body = create_user(store, {"email": "ada-ex.com"})
+    assert status == 400
+    assert json.loads(body) == {
+        "errors": ["missing: name", "invalid: email"]
+    }
+
+
+def test_create_user_does_not_add_to_store_when_invalid():
+    store = MemoryStore()
+    create_user(store, {})
+    assert store.list() == []
+
+
+def test_create_user_returns_201_with_serialized_user_when_valid():
+    store = MemoryStore()
+    status, body = create_user(store, {"name": "Ada", "email": "ada@ex.com"})
+    assert status == 201
+    assert body == '{"id": 1, "name": "Ada", "email": "ada@ex.com"}'
+
+
+def test_create_user_adds_to_store_when_valid():
+    store = MemoryStore()
+    create_user(store, {"name": "Ada", "email": "ada@ex.com"})
+    users = store.list()
+    assert len(users) == 1
+    assert users[0].name == "Ada"
+    assert users[0].email == "ada@ex.com"
+
+
+def test_create_user_ignores_unknown_keys():
+    store = MemoryStore()
+    status, body = create_user(
+        store, {"name": "Ada", "email": "ada@ex.com", "extra": "ignored"}
+    )
+    assert status == 201
+    assert json.loads(body) == {"id": 1, "name": "Ada", "email": "ada@ex.com"}
+
+
+def test_get_user_returns_200_with_serialized_user_when_found():
+    store = MemoryStore()
+    user = store.add("Ada", "ada@ex.com")
+    status, body = get_user(store, user.id)
+    assert status == 200
+    assert body == '{"id": 1, "name": "Ada", "email": "ada@ex.com"}'
+
+
+def test_get_user_returns_404_when_missing():
+    store = MemoryStore()
+    status, body = get_user(store, 999)
+    assert status == 404
+    assert json.loads(body) == {"errors": ["not found"]}
