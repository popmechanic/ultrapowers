@@ -0,0 +1,58 @@
+import json
+
+from apistub.app import route
+from apistub.store import MemoryStore
+
+
+def test_route_post_users_creates_user():
+    store = MemoryStore()
+    status, body = route(
+        store, "POST", "/users", {"name": "Ada", "email": "ada@ex.com"}
+    )
+    assert status == 201
+    assert json.loads(body) == {"id": 1, "name": "Ada", "email": "ada@ex.com"}
+
+
+def test_route_post_users_returns_400_on_invalid_payload():
+    store = MemoryStore()
+    status, body = route(store, "POST", "/users", {"email": "ada-ex.com"})
+    assert status == 400
+    assert json.loads(body) == {
+        "errors": ["missing: name", "invalid: email"]
+    }
+
+
+def test_route_get_users_id_returns_existing_user():
+    store = MemoryStore()
+    user = store.add("Ada", "ada@ex.com")
+    status, body = route(store, "GET", f"/users/{user.id}")
+    assert status == 200
+    assert json.loads(body) == {"id": 1, "name": "Ada", "email": "ada@ex.com"}
+
+
+def test_route_get_users_id_returns_404_when_missing():
+    store = MemoryStore()
+    status, body = route(store, "GET", "/users/999")
+    assert status == 404
+    assert json.loads(body) == {"errors": ["not found"]}
+
+
+def test_route_returns_404_for_unknown_route():
+    store = MemoryStore()
+    status, body = route(store, "DELETE", "/users/1")
+    assert status == 404
+    assert json.loads(body) == {"errors": ["no route"]}
+
+
+def test_route_returns_404_for_non_digit_user_id():
+    store = MemoryStore()
+    status, body = route(store, "GET", "/users/abc")
+    assert status == 404
+    assert json.loads(body) == {"errors": ["no route"]}
+
+
+def test_route_returns_404_for_unknown_path():
+    store = MemoryStore()
+    status, body = route(store, "GET", "/unknown")
+    assert status == 404
+    assert json.loads(body) == {"errors": ["no route"]}
