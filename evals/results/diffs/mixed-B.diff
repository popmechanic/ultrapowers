index 0000000..be5732f
--- /dev/null
+++ b/apistub/handlers.py
@@ -0,0 +1,35 @@
+"""HTTP-shaped handler functions for the users API, no network."""
+
+import json
+
+from apistub.serialize import to_json
+from apistub.validate import validate_payload
+
+
+def create_user(store, payload):
+    """Validate `payload` and, if valid, add a new user to `store`.
+
+    Returns a `(status, body)` tuple: `(400, ...)` with a JSON list of
+    errors when the payload is invalid, otherwise `(201, ...)` with the
+    newly created user serialized to JSON.
+    """
+    errors = validate_payload(payload)
+    if errors:
+        return 400, json.dumps({"errors": errors})
+
+    user = store.add(payload["name"], payload["email"])
+    return 201, to_json(user)
+
+
+def get_user(store, user_id):
+    """Look up `user_id` in `store`.
+
+    Returns a `(status, body)` tuple: `(200, ...)` with the user
+    serialized to JSON when found, otherwise `(404, ...)` with a JSON
+    error list.
+    """
+    user = store.get(user_id)
+    if user is None:
+        return 404, json.dumps({"errors": ["not found"]})
+
+    return 200, to_json(user)
