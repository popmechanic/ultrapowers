+from apistub.schema import User
+from apistub.store import MemoryStore
+
+
+def test_add_returns_user_with_auto_incrementing_id_starting_at_1():
+    store = MemoryStore()
+    user = store.add("Ada", "ada@ex.com")
+    assert isinstance(user, User)
+    assert user.id == 1
+    assert user.name == "Ada"
+    assert user.email == "ada@ex.com"
+
+
+def test_add_increments_id_for_each_new_user():
+    store = MemoryStore()
+    first = store.add("Ada", "ada@ex.com")
+    second = store.add("Bob", "bob@ex.com")
+    third = store.add("Cy", "cy@ex.com")
+    assert (first.id, second.id, third.id) == (1, 2, 3)
+
+
+def test_get_returns_the_user_by_id():
+    store = MemoryStore()
+    user = store.add("Ada", "ada@ex.com")
+    assert store.get(user.id) == user
+
+
+def test_get_returns_none_for_unknown_id():
+    store = MemoryStore()
+    store.add("Ada", "ada@ex.com")
+    assert store.get(999) is None
+
+
+def test_list_returns_all_users_in_insertion_order():
+    store = MemoryStore()
+    first = store.add("Ada", "ada@ex.com")
+    second = store.add("Bob", "bob@ex.com")
+    third = store.add("Cy", "cy@ex.com")
+    assert store.list() == [first, second, third]
+
+
+def test_list_returns_empty_list_when_no_users_added():
+    store = MemoryStore()
+    assert store.list() == []
