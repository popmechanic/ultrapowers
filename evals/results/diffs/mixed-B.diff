+import dataclasses
+
+from apistub import schema
+from apistub.schema import FIELDS, User
+
+
+def test_user_is_dataclass_with_expected_fields():
+    assert dataclasses.is_dataclass(User)
+    field_types = {f.name: f.type for f in dataclasses.fields(User)}
+    assert field_types == {"id": int, "name": str, "email": str}
+
+
+def test_user_construction_and_field_values():
+    user = User(1, "Ada", "ada@ex.com")
+    assert user.id == 1
+    assert user.name == "Ada"
+    assert user.email == "ada@ex.com"
+
+
+def test_fields_constant_contents():
+    assert FIELDS == {"name": str, "email": str}
+
+
+def test_fields_constant_insertion_order_name_first():
+    assert list(FIELDS.keys()) == ["name", "email"]
