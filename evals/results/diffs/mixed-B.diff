@@ -0,0 +1,14 @@
+"""User schema: the dataclass and the creation-payload field contract."""
+
+from dataclasses import dataclass
+
+
+@dataclass
+class User:
+    id: int
+    name: str
+    email: str
+
+
+# The creation-payload contract. Insertion order matters: name first.
+FIELDS = {"name": str, "email": str}
