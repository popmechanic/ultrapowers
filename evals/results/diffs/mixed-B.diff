+++ b/tests/test_validate.py
@@ -0,0 +1,75 @@
+from apistub.validate import validate_payload
+
+
+def test_valid_payload_returns_empty_list():
+    assert validate_payload({"name": "Ada", "email": "ada@ex.com"}) == []
+
+
+def test_missing_name_reported():
+    assert validate_payload({"email": "ada@ex.com"}) == ["missing: name"]
+
+
+def test_missing_email_reported():
+    assert validate_payload({"name": "Ada"}) == ["missing: email"]
+
+
+def test_missing_both_reported_in_fields_order():
+    assert validate_payload({}) == ["missing: name", "missing: email"]
+
+
+def test_wrong_type_name_reported():
+    assert validate_payload({"name": 123, "email": "ada@ex.com"}) == [
+        "wrong type: name"
+    ]
+
+
+def test_wrong_type_email_reported():
+    assert validate_payload({"name": "Ada", "email": 123}) == [
+        "wrong type: email"
+    ]
+
+
+def test_bool_is_not_valid_str_type():
+    # bool is a subclass of int in Python, but not of str; ensure the
+    # declared-type check still rejects it for a str-typed field.
+    assert validate_payload({"name": True, "email": "ada@ex.com"}) == [
+        "wrong type: name"
+    ]
+
+
+def test_missing_and_wrong_type_combined_in_fields_order():
+    assert validate_payload({"email": 123}) == [
+        "missing: name",
+        "wrong type: email",
+    ]
+
+
+def test_invalid_email_missing_at_sign():
+    assert validate_payload({"name": "Ada", "email": "ada-ex.com"}) == [
+        "invalid: email"
+    ]
+
+
+def test_invalid_email_appended_after_field_errors():
+    assert validate_payload({"email": "ada-ex.com"}) == [
+        "missing: name",
+        "invalid: email",
+    ]
+
+
+def test_email_wrong_type_does_not_also_trigger_invalid_email():
+    # email must be a str to be checked for "@"; if it's the wrong type
+    # only "wrong type: email" should be reported, not "invalid: email".
+    assert validate_payload({"name": "Ada", "email": 123}) == [
+        "wrong type: email"
+    ]
+
+
+def test_unknown_keys_are_ignored():
+    payload = {"name": "Ada", "email": "ada@ex.com", "extra": "ignored"}
+    assert validate_payload(payload) == []
+
+
+def test_unknown_keys_ignored_with_other_errors_present():
+    payload = {"email": "ada@ex.com", "extra": "ignored"}
+    assert validate_payload(payload) == ["missing: name"]
