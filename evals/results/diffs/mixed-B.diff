@@ -0,0 +1,18 @@
+"""Serialization helpers for apistub schema objects."""
+
+import json
+from collections import OrderedDict
+
+from apistub.schema import User
+
+
+def to_json(user: User) -> str:
+    """Serialize a ``User`` to a JSON string with keys in id, name, email order."""
+    payload = OrderedDict(
+        (
+            ("id", user.id),
+            ("name", user.name),
+            ("email", user.email),
+        )
+    )
+    return json.dumps(payload)
