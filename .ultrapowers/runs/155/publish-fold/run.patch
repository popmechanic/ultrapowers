+// ════════════════════════════════════════════════════════════════════════════
+{
+  const MISSING = EXPECTED_DIR + 'never-written.json'
+  const repoE = makeRepo(path.join(tmp, 'repo-e'))
+  const E = await driveRun({
+    label: 'E', repo: repoE, runDir: path.join(tmp, 'run-e'),
+    post: { expected: MISSING, content: CONTENT },
