{"t":51405,"op":"edit","agent":"A","path":"skills/ultrawrite/stories/questions.json","vstart":37,"vend":37,"lines":["  \"gate\": {","    \"fact\": {\"type\": \"noul\",","      \"instructions\": {\"question\": \"Does `clauses[i].text` state a computable fact: an exit code, a recorded argv, a byte-exact string, a count, an ordering of events, or that something is gone, unchanged or exactly so many?\",","        \"context\": \"`claim` is what a task promises; `clauses` are its machine clauses, each with an id and its text. `probes` are the commands that prove it, each naming the clauses it proves; `legs` say which clause each part of the proof covers.\"},","      \"criteria\": {\"true\": \"A program could decide it exactly\", \"false\": \"It needs a judgment to decide\"}},","    \"caught\": {\"type\": \"noul\",","      \"instructions\": {\"question\": \"Would at least one command in `probes` fail if `clauses[i].text` were false?\",","        \"context\": \"`clauses` are a task's machine clauses; `probes` are the commands that prove them, each with the clause ids it claims to prove (`proves`).\"},","      \"criteria\": {\"true\": \"Some probe would fail\", \"false\": \"Every probe could still pass\"}},","    \"contradiction\": {\"type\": \"noul\",","      \"instructions\": {\"question\": \"Does any entry of `legs` say something the clause it cites rules out?\",","        \"context\": \"`legs` are the proof's legs, each with its text and the clause ids it cites (`cites`); `clauses` are the task's machine clauses.\"},","      \"criteria\": {\"true\": \"Some leg contradicts its clause\", \"false\": \"Every leg agrees with the clauses it cites\"}}","  },"]}
