-+                 r"\[(?P<family>[A-Za-z]+)\] "
-+                 r"(?P<text>.*) — disposition:(?P<value>.*)$")
-+DISPOSITION = re.compile(r"^(?:fixed|acked|filed:\S+|waived:\S.*)$")
