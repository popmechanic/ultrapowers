-+    b2 = commit(repo, tree, [root], "b2")
-+    b3 = commit(repo, tree, [root], "b3")
-+    O = commit(repo, tree, [root, b2, b3], "octopus O")
-+    b4 = commit(repo, tree, [O], "b4")
-+    M = commit(repo, tree, [O, b4], "merge M")
-+
-+    report = _report([(1, O, ["t1", "t2", "t3"]), (2, M, ["t4"])])
