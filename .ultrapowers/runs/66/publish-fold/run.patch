+# --------------------------------------------------------------------------- #
+# leg (a) [M1] — collect_sims: what it returns, and in what order              #
+# --------------------------------------------------------------------------- #
+def test_collect_sims_takes_both_directories_in_slow_first_then_alpha_order(
