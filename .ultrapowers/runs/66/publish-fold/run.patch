+    """M2's line, verbatim."""
+    return "ADVISORY guard: task %s names `%s` \u2014 not in its Files" % (
+        task_id, path)
+
+
+def _no_test_line(task_id, path):
+    """M3's line, verbatim."""
+    return ("ADVISORY guard: task %s names `%s` \u2014 the Proof names no "
+            "Test: at that path" % (task_id, path))
+
+
