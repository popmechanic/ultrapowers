+  const rest = prompt.slice(at + 1)
+  const ends = ['\nEXAM EDITED DIFF ', '\n\nRUN EVIDENCE:', '\n\nEXAM EVIDENCE:']
+    .map((s) => rest.indexOf(s, header.length))
+    .filter((i) => i >= 0)
