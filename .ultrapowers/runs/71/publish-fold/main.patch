+    assert.ok(detailOf(killed).includes(`timeout after ${SEAM_MS}ms`),
+      `[M3] … keeping "timeout after ${SEAM_MS}ms" — got ${JSON.stringify(detailOf(killed))}`)
+    assert.ok(!detailOf(killed).includes('within'),
