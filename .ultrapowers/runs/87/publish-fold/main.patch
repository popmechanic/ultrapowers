+def _report_lines(tmp_path, ledger):
+    proc = _run(REPORT, tmp_path, "--ledger", ledger)
+    assert proc.returncode == 0, proc.stderr
+    assert "Traceback" not in proc.stderr, proc.stderr
+    return proc.stdout.splitlines()
