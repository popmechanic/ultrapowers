+def test_b_the_buckets_are_floor_of_x_plus_a_half_clamped(tmp_path):
+    """(b)/[M2]: `b = min(3, max(0, floor(jev.magnitude + 0.5)))`. `0.5` is
+    bucket 1 and `2.5` is bucket 3, where Python's banker's `round` reads 0 and
