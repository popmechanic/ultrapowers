+      "', at: 'review', round: iter, tierChosen: economics.tier}` — one review round ran, so " +
+      '`round` is `1` and `tierChosen` is `' + SONNET + '`: ' + JSON.stringify(row))
+
+    assert.deepEqual(Object.keys(row).sort(), REVIEW_ROW_KEYS,
