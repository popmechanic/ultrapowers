{"ts":"2026-09-21T23:48:40.914Z","kind":"worker:test-run","task":"1","label":"exam:1","cmd":"mkdir -p /tmp/gitblock_check/factory\ncat > /tmp/gitblock_check/factory/gitblock.mjs <<'EOF'\nexport function findGit (command) {\n  const line = String(command)\n  // extremely small stand-in, just enough to satisfy the sanity check\n  const segs = line.split(/&&|\\|\\||;|\\||&/).map(s => s.trim())\n  for (const seg of segs) {\n    const word = seg.split(/\\s+/)[0]\n    if (word === 'git' || /\\/git$/.test(word)) return seg\n    if (/^sh -c /.test(seg)) {\n      const m = seg.match(/'([^']*)'/)\n      if (m && /^git\\b/.test(m[1].trim())) return m[1]\n    }\n  }\n  return null\n}\nEOF\ncat > /tmp/gitblock_check/factory/worker.mjs <<'EOF'\nimport { findGit } from './gitblock.mjs'\nexport function makeConfineHook () { return async () => ({}) }\nexport function makeGitHook ({ task, label, onDenied }) {\n  return async (input) => {\n    if (input.tool_name !== 'Bash') return {}\n    const command = input.tool_input.command\n    const hit = findGit(command)\n    if (hit === null) return {}\n    const row = { kind: 'worker:denied', task, label, tool: 'Bash', why: 'git', command: String(command).slice(0,200) }\n    if (typeof onDenied === 'function') {\n      try { onDenied(row) } catch {}\n    }\n    return { hookSpecificOutput: { hookEventName: 'PreToolUse', permissionDecision: 'deny', permissionDecisionReason: 'Bash denied: this line runs git, and the engine runs git itself — never a worker.' } }\n  }\n}\nexport function workerOptions (opts, denials) {\n  return { hooks: { PreToolUse: [{ hooks: [makeConfineHook(), makeGitHook({ task: opts.task, label: opts.label, onDenied: opts.onDenied })] }] } }\n}\nexport function runWorker (opts, deps) {\n  const run = deps.query\n  return (async () => {\n    const iter = await run({ prompt: opts.prompt, options: workerOptions(opts, []) })\n    let result = null\n    for await (const m of iter) { if (m.type === 'result') result = m }\n    return { result }\n  })()\n}\nEOF\nsed \"s#'../../factory/gitblock.mjs'#'/tmp/gitblock_check/factory/gitblock.mjs'#; s#'../../factory/worker.mjs'#'/tmp/gitblock_check/factory/worker.mjs'#\" fleet/tests/test_factory_worker_gitblock.mjs > /tmp/gitblock_check/run.mjs\nnode /tmp/gitblock_check/run.mjs","exit":null,"red":null,"via":"bash"}
