+    }
+    if (kind === 'fix') {
+      fs.rmSync(path.join(cwd, 'T2.txt'), { force: true })
+      fs.writeFileSync(path.join(cwd, id + '.txt'), 'v2\n')
+      return doneImpl(cwd)
+    }
