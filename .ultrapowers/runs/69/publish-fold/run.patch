+  assert.equal(eco.refereeSkippedPairs, 0, 'and none bought back: ' + JSON.stringify(eco))
+  assert.equal(eco.refereeBlocking, 0, 'nothing blocking was found: ' + JSON.stringify(eco))
+}
+
 fs.rmSync(tmp, { recursive: true, force: true })
