+  assert.equal(eco.refereeSkippedPairs, 1,
+    'and the round the referee bought back is counted once: ' + JSON.stringify(eco))
+  assert.ok(eco.refereeBlocking >= 1, 'the blocking finding is tallied: ' + JSON.stringify(eco))
