+    for (const m of line.matchAll(/^import\s*['"]([^'"]+)['"]/g)) specs.push(m[1])
+    for (const m of line.matchAll(/\bimport\s*\(\s*['"]([^'"]+)['"]\s*\)/g)) specs.push(m[1])
