+
+  const hungBeside = await linkProduces({ bullet: '`foo(a)`', files: ['src/quiet.mjs', 'src/hang.mjs'], cloneDir: hung, timeoutMs: 500 })
+  shape(hungBeside, 'leg (b) unlinked over missing')
