+function assertOneClose(ctx, label) {
+  const argv = closeArgv(ctx)
+  assert.equal(argv.length, 1,
+    `${label} [M6] exactly one close is POSTed to '${CLOSE_URL}' — ${argv.length} were${whyCurl(ctx)}`)
+  const a = argv[0]
