+// ── (c) the boot script looks for no acceptance log  [M3] ────────────────────
+
+const BOOT_SCRIPT = path.join(FLEET, 'sandbox-boot.sh')
+/** `grep`'s own reading of `acceptance.log`: the `.` matches any character, so
