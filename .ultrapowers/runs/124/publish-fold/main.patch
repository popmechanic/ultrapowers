+function publishBullet(contract) {
+  const all = contract.split('\n')
+  const from = all.findIndex((l) => l.startsWith('- **Publish:**'))
+  assert.ok(from >= 0, '`fleet/CONTRACT.md` carries no line beginning `- **Publish:**`')
