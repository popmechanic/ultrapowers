+        return "%s,%d" % (name, count)
+    return "%s %d" % (name, count)
+
+
+def clamp(rows, limit):
+    if limit is None:
+        return list(rows)
+    if limit < 0:
+        raise ValueError("limit must be >= 0")
+    return list(rows)[:limit]
+
+
+def sort_rows(rows):
+    return sorted(rows, key=lambda row: row[0])
