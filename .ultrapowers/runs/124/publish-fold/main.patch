-+
-+
-+def publish(base, repo, base_ref, ref, task_id):
-+    """Derive a TaskState from the git diff base_ref..ref."""
-+    out = _git(repo, "diff", "--name-status", "-z", "--no-renames", base_ref, ref).decode()
-+    parts = [x for x in out.split("\0") if x]
