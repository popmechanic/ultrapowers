-+# state format is [(line, depth, anchored_right, count)]
-+def serialize_state(state):
-+    result = []
-+    for (line, depth, anchored_right, count) in state:
-+        arrow = ('<', '>')[anchored_right]
-+        result.append(f'{depth} {arrow} {count} {line}')
