+    assert verb1 < catch < verb2, (
+        f"expected `{VERB1_HEADING}` ({verb1}) < `{CATCH_HEADING}` ({catch}) "
+        f"< `{VERB2_HEADING}` ({verb2})")
+
+
+def test_catch_section_names_the_scripts_the_row_and_the_ledger():
