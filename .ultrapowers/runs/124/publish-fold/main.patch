-+# ---------------------------------------------------------------- shapes ----
-+# (a) three tasks, all `Modify: src/x.py`, no Depends-on.
-+SHAPE_A = _HEADER + "".join(
-+    _task(i, "writer " + i, ["Modify: `src/x.py`"]) for i in ("A", "B", "C"))
