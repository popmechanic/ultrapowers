-+
-+def _relabel(annotated, task_id):
-+    """Rewrite kernel conflict markers to name the frontier and the task."""
-+    out = []
-+    for line in annotated:
-+        if line.startswith(MARKERS):
-+            line = line.replace("left", "frontier").replace("right", task_id)
-+        out.append(line)
