-+
-+def _task(tid, title, files, deps=None):
-+    head = "### Task %s: %s\n\n**Type:** implementation\n" % (tid, title)
-+    if deps:
-+        head += "**Depends-on:** %s\n" % ", ".join(deps)
-+    return (head + "\n**Files:**\n" + "".join("- %s\n" % f for f in files)
-+            + "\n- [ ] **Step 1:** do the work\n\n")
