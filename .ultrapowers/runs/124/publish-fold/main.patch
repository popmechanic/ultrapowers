-+CONFLICT_ADDED_LEFT = 0
-+CONFLICT_ADDED_RIGHT = 1
-+CONFLICT_ADDED_BOTH = 2
-+CONFLICT_DELETED_LEFT = 3
-+CONFLICT_DELETED_RIGHT = 4
-+PEACE = 5
