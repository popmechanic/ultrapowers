+    print()
+    print("| lag | n | median (s) | p90 (s) |")
+    print("|---|---:|---:|---:|")
+    for name, xs in (("engine ts → hub comment created_at", hub_lags),
+                     ("engine ts → first evidence commit", commit_lags)):
+        if xs:
+            print(f"| {name} | {len(xs)} | {statistics.median(xs):.1f} | {p90(xs):.1f} |")
+        else:
+            print(f"| {name} | 0 | — | — |")
+    print()
