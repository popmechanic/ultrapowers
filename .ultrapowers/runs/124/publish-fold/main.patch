+export const FRONTIER_DIR = path.join(REPO_ROOT, 'evals', 'frontier')
+
+/** The default root M6 scans; `READINESS_FIXTURES_DIR` overrides it. */
+export const FIXTURES_ROOT = path.join(HERE, 'fixtures', 'readiness')
+
+/**
+ * The committed replies. `corpus/` answers corpus wave 3's one `lines`
+ * conflict on `d.txt`; `control/step-<n>/` are the negative control's, one per
