-+import json
-+import re
-+from collections import Counter
-+from pathlib import Path
-+
-+HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
-+DIFF_GIT_RE = re.compile(r"^diff --git a/(.+?) b/(.+)$")
