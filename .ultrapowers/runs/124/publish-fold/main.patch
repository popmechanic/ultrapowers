-def repo(tmp_path):
-    """The git checkout `--base` names: the render family is driven by
-    `render_advisories`, which skips every render outside one."""
-    r = tmp_path / "repo"
-    r.mkdir()
-    subprocess.run(["git", "init", "-q"], cwd=r, check=True)
-    (r / "README.md").write_text("# base\n")
