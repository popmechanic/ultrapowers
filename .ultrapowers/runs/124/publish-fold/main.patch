+  for (const needle of needles) {
+    const i = text.indexOf(needle, at)
+    if (i < 0) {
+      return at === 0
+        ? `\`${needle}\` does not appear at all`
+        : `\`${needle}\` does not appear after the name before it`
+    }
+    at = i + needle.length
+  }
+  return null
+}
