-// ── (e) the excerpt is shell and awk, never node  [M5] ──────────────────────
-
-test("the suite-red boot calls node directly not once  [failing-block M5 / leg (e)]", async () => {
-  const ctx = await suiteRed()
-  const leg = '(e) [failing-block M5]'
