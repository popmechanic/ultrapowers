+}
+
+// ════════════════════════════════════════════════════════════════════════════
+// Scenario B — the reviewer answers FIX_REQUIRED once, so the exam is executed
+// again at round 2. Legs (b) second half and (f) second half.
+// ════════════════════════════════════════════════════════════════════════════
+{
+  const B = await scenario({
