+}
+
+// ════════════════════════════════════════════════════════════════════════════
+// Scenario C — a breached contract, and a sibling task whose exam writes no
+// record at all. Legs (g) and (i) second half.
+// ════════════════════════════════════════════════════════════════════════════
+const BREACH = 'contract breach: https://x'
+{
+  const T2 = entry({
