+    parallel: (thunks) => Promise.all(thunks.map((t) => t())),
+    exec: execSeam,
+    paths: { repoDir: repo, runDir, clonesDir },
+    log: (l) => logs.push(String(l)),
+    phase: () => {},
+    patchBase,
+    kata,
+  })
+  return { run, base, clonesDir, patchesDir, integ, logs }
+}
+
