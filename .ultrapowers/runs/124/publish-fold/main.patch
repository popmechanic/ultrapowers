+/** BASE's sentence, with the verdict both arms below run under. */
+const VERDICT = 'NEEDS_ACK'
+const SENTENCE =
+  `parked: ${INTEGRATION_BRANCH} has no commits ahead of base (verdict ${VERDICT})`
