+})
+
+// ── (c) neither directory  [M2] ──────────────────────────────────────────────
+
+test('a branch with neither directory is left alone, and says so  [M2 / leg (c)]', () => {
+  const s = NEITHER
+  const leg = '(c) [M2]'
