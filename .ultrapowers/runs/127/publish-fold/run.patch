+  wsMem.cleanup()
+}
+
+// ── c. [M3] one stamped compile per launch, before the verb, read by both ───
+{
+  const solo = await drive({ compiled: TEN_WIDE, config: CAPPED })
+  const soloStamps = stampCalls(solo.exec)
