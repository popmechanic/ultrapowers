{"t":245674,"op":"edit","agent":"B","path":"fleet/doctor.mjs","vstart":232,"vend":258,"lines":["/**"," * The pool `billing plan --json` answered, through the lobby's own reader:"," * `{ maxCpus, maxMemoryGb, tier }`, or null when the verb exited non-zero or"," * answered no numeric `max_cpus`. `readPlanCapacity` reads an absent"," * `max_memory_gb` as 0, which is a launch's business; the doctor reads it as no"," * pool, so `maxMemoryGb` is null unless the payload itself carries a number."," */","async function readPool (res) {","  if (res.code !== 0) return null","  let capacity","  try {","    capacity = await readPlanCapacity(async () => res)","  } catch {","    return null","  }","  const payload = parseJson(res.stdout)","  return {","    maxCpus: capacity.maxCpus,","    maxMemoryGb: typeof payload?.max_memory_gb === 'number' ? capacity.maxMemoryGb : null,","    tier: capacity.tier !== '' ? capacity.tier : String(payload?.plan ?? 'untiered')","  }","}","","function poolRow (res, pool, config) {","  const askedCpu = parseCpus(config.cpu)","  const askedGb = parseMemoryGb(config.memory)","  if (askedCpu === null || askedGb === null) {","    return row(","      'capacity',","      'missing',","      `~/.ultrapowers/fleet.json asks for cpu ${config.cpu} / memory ${config.memory}, which is not <int> and <int>GB`","    )","  }","","  if (pool === null || pool.maxMemoryGb === null) {","    return row(","      'capacity',","      'missing',","      `billing plan --json answered code ${res.code} with no readable pool — ~/.ultrapowers/fleet.json sets the size a run asks for`","    )","  }","","  const described = `${pool.tier} pool ${pool.maxCpus} vCPU / ${pool.maxMemoryGb}GB`","  const asked = `${askedCpu} vCPU / ${askedGb}GB`","  return row('capacity', 'ok', `${described}; a run asks ${asked}`)"]}
