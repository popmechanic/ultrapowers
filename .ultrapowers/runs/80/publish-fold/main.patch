+  const argv = argvLines(ctx, 'systemd-run').find((a) => a.includes('--unit=fleet-engine-7'))
+  assert.ok(argv, `${leg} a systemd-run of --unit=fleet-engine-7; the units run were ` +
+    JSON.stringify(unitsRun(ctx)))
