{"t":158611,"op":"edit","agent":"A","path":"tests/test_authoring_census.py","vstart":642,"vend":660,"lines":["# `{task, amends, what, why}` rows.","def amendment(task, amends):","    return {","        \"task\": task,","        \"amends\": amends,","        \"what\": \"the clause moved\",","        \"why\": \"the tree said otherwise\",","    }","","","#: A report carrying the empty list: `0` amendments. Zero is a value the file","#: carries, so the cell is `0` and the totals sum is still 0."]}
{"t":165455,"op":"edit","agent":"A","path":"tests/test_authoring_census.py","vstart":683,"vend":701,"lines":["#: Where the `amendments` cell sits in a row, counted from the end — the","#: `explain_rounds` column a later plan added closes the row after it.","AMENDMENTS_FROM_END = len(COLUMN_NAMES) - COLUMN_NAMES.index(\"amendments\")","","# (a): `run-9`'s record predates the plan — `-` in every authoring column, its","# tally read — and its report carries three amendment rows.","AM_ROW_9 = tsv(\"9\", \"-\", \"-\", \"3\", \"0\", \"-\", \"-\", \"-\", \"-\", \"-\", \"3\", \"-\")","# (a): the full row, its report carrying no `amendments` key. Its question","# carries no `explain_rounds`, so that cell is `0`, not `-` — the record has","# an `authoring` key.","AM_ROW_131 = tsv(\"131\", \"118\", \"12\", \"4\", \"1\", \"risk\", \"ultrapowers\", \"1\",","                 \"1/1\", \"16\", \"-\", \"0\")","# (a): no report at all beside the record.","AM_ROW_133 = tsv(\"133\", \"47\", \"5\", \"2\", \"-\", \"width\", \"ultrapowers\", \"2\",","                 \"1/1\", \"-\", \"-\", \"0\")"]}
