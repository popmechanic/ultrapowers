+ */
+const refusedFirstPush = (repo, state) => ({
+  when: (cmd, argv) => cmd === 'git' && argv.includes('push') &&
+    argv.some((a) => String(a).endsWith(`:refs/heads/${planBranch(FIRST)}`)),
+  answer: () => {
+    state.refusals += 1
+    repo.git(['push', repo.origin, `${repo.base}:refs/heads/${planBranch(FIRST)}`])
