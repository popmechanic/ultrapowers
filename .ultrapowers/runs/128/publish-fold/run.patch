+// ── Reading the calls ───────────────────────────────────────────────────────
+
+const newCallOf = (exec) => exec.calls.find(
+  (c) => c.cmd === 'ssh' && c.argv[0] === EXE_HOST && String(c.argv[1] ?? '').startsWith('new ')
