index 0000000000000000000000000000000000000000..c978d3669c14deb1e6faed42b1fdd0dbc5015cb4
--- /dev/null
+++ b/fleet/tests/exams/run_106/test_sandbox_boot_evidence_copy.mjs
@@ -0,0 +1,321 @@
+/**
+ * Exam for Task 3 — "The record carries no referee directory": the evidence
+ * `fleet/sandbox-boot.sh` commits for a run carries `transcripts/` and
+ * `state-exams/` exactly as before and never a `referee/` directory, even when
+ * the run directory holds one, and `fleet/CONTRACT.md` no longer promises one.
+ *
+ * The clauses this file pins, in the task's own words:
+ *
+ *   M1 / leg (a)  `fleet/CONTRACT.md` contains no line with `referee/task-` or
+ *                 `driver's referee`, and its evidence list still carries, in
+ *                 order, `transcripts/<sessionId>.jsonl` and then
+ *                 `state-exams/` — read inside §Literals, the section that
+ *                 holds the evidence list, the way the Proof's `sed`-scoped
+ *                 `Run:` line reads it.
+ *   M2 / leg (b)  a boot through the sandbox-boot rig whose engine stub leaves
+ *                 `<run_dir>/transcripts/s1.jsonl`,
+ *                 `<run_dir>/state-exams/task-1/buy-milk-0/walls.json` and
+ *                 `<run_dir>/referee/task-1-0.json` behind exits 0 and leaves,
+ *                 under the evidence worktree's `.ultrapowers/runs/7/`,
+ *                 `transcripts/s1.jsonl` and
+ *                 `state-exams/task-1/buy-milk-0/walls.json` byte-equal to the
+ *                 run directory's, and no entry named `referee` at any depth.
+ *                 The planted `<run_dir>/referee/task-1-0.json` is asserted to
+ *                 EXIST, so a green leg is not two absences agreeing: the
+ *                 directory the copy must not collect is really there.
+ *   M3 / leg (c)  `fleet/sandbox-boot.sh` contains no occurrence of `referee`
+ *                 in any letter case, `bash -n` parses it, and
+ *                 `node fleet/tests/test_sandbox_boot_state_exams.mjs` — the
+ *                 sim that grades the state-exams walk, and therefore the one
+ *                 that catches a cut that took too much — prints
+ *                 `ALL TESTS PASSED`.
+ *   M4 / leg (d)  `python3 -m pytest tests/test_docs_agree_with_code.py -q`
+ *                 exits 0: the four-document structural pin still holds over
+ *                 the edited CONTRACT.
+ *
+ * The rig is `_sandbox_boot_helpers.mjs`, shared with `test_sandbox_boot.mjs`
+ * and `test_sandbox_boot_state_exams.mjs`: `makeHome` builds a home whose PATH
+ * carries the stubs, `bootAsync` runs the script to completion, `runDir` is the
+ * run directory the engine stub writes into and `evidenceDir` is the evidence
+ * worktree. The one thing that rig cannot do is leave a `referee/` directory
+ * behind, so this sim splices the three writes into the shared engine stub in
+ * front of its `exit ${STUB_ENGINE_CODE:-0}` line — the same splice point, and
+ * the same shape, the state-exams sim uses.
+ *
+ * A boot is ~40 forks of stub shell, so this exam runs exactly ONE of them and
+ * every M2 assertion reads that one run.
+ *
+ * This file names `referee/task-1-0.json` and the word `referee` in full,
+ * because what it asserts is their ABSENCE from the record and from the script:
+ * a pin spelled any other way would not be the clause.
+ */
+
+import assert from 'node:assert/strict'
+import { spawnSync } from 'node:child_process'
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import {
+  SCRIPT, RUN_PATH,
+  STUBS, PRELUDE, makeHome, bootAsync, runDir, evidenceDir,
+  runTests, ENV,
+} from '../../_sandbox_boot_helpers.mjs'
+
+const HERE = path.dirname(fileURLToPath(import.meta.url))
+// `fleet/tests/exams/run_106/` → the repository root is four levels up.
+const REPO_ROOT = path.resolve(HERE, '..', '..', '..', '..')
+
+const tests = []
+const test = (name, fn) => tests.push([name, fn])
+
+// ── what the contract may and may not say  [M1] ──────────────────────────────
+
+const CONTRACT = path.join(REPO_ROOT, 'fleet', 'CONTRACT.md')
+
+/** The two strings M1 forbids on any line of the contract. */
+const FORBIDDEN_IN_CONTRACT = ['referee/task-', "driver's referee"]
+
+/** The two items M1 keeps, in the order it keeps them. */
+const TRANSCRIPTS_ITEM = 'transcripts/<sessionId>.jsonl'
+const STATE_EXAMS_ITEM = 'state-exams/'
+
+const contractText = () => fs.readFileSync(CONTRACT, 'utf8')
+
+/** `<line number>: <line>` for every line of the contract carrying `needle`. */
+const contractHits = (needle) =>
+  contractText()
+    .split('\n')
+    .map((line, i) => [i + 1, line])
+    .filter(([, line]) => line.includes(needle))
+    .map(([n, line]) => `${n}: ${line.trim()}`)
+
+/**
+ * §Literals as one line, the way the Proof's `Run:` reads it:
+ * `sed -n '/^## Literals/,/^## Rules/p' … | tr '\n' ' '`.
+ */
+function literalsSection() {
+  const all = contractText().split('\n')
+  const from = all.findIndex((l) => /^## Literals/.test(l))
+  assert.ok(from >= 0, '(a) [M1] fleet/CONTRACT.md must still carry a `## Literals` section')
+  const rest = all.slice(from + 1).findIndex((l) => /^## Rules/.test(l))
+  assert.ok(rest >= 0, '(a) [M1] and a `## Rules` heading after it, which closes the sed range')
+  return all.slice(from, from + 1 + rest + 1).join(' ')
+}
+
+// ── the run the engine leaves behind  [M2] ───────────────────────────────────
+
+/** The last line of the shared engine stub — where the extension is spliced. */
+const ENGINE_EXIT = 'exit ${STUB_ENGINE_CODE:-0}'
+
+/** The three paths the engine stub plants, relative to the run directory. */
+const TRANSCRIPT_REL = 'transcripts/s1.jsonl'
+const EXAM_REL = 'state-exams/task-1/buy-milk-0/walls.json'
+/** M2's own name for the file the copy must NOT collect. */
+const REFEREE_REL = 'referee/task-1-0.json'
+
+/** One reduced worker record: distinct, non-trivial bytes, so the byte-equal
+ *  assertion below is a real comparison and not two empty files agreeing. */
+const TRANSCRIPT_BYTES =
+  '{"kind":"worker:turn","session":"s1","role":"implementer","text":"the reduced record"}\n'
+/** One state exam's walls, in the shape the exams write. */
+const WALLS_BYTES =
+  '{\n  "task": "1",\n  "stem": "buy-milk",\n  "pass": 0,\n' +
+  '  "walls": [{"id": "w-1", "kind": "contract", "held": true}]\n}\n'
+/** What the planted `referee/task-1-0.json` holds. */
+const REFEREE_BYTES = '{}'
+
+/**
+ * The engine's writes, under `$run_dir` — the run directory the stub already
+ * resolves — at the layout the contract names for the two that stay and the
+ * layout #729 named for the one that goes.
+ */
+const PLANT_SNIPPET = `
+if [ -n "\${STUB_EVIDENCE_PLANT:-}" ]; then
+  mkdir -p "$run_dir/${path.dirname(TRANSCRIPT_REL)}" \\
+           "$run_dir/${path.dirname(EXAM_REL)}" \\
+           "$run_dir/${path.dirname(REFEREE_REL)}"
+  printf '%s' "$STUB_PLANT_TRANSCRIPT" >"$run_dir/${TRANSCRIPT_REL}"
+  printf '%s' "$STUB_PLANT_WALLS" >"$run_dir/${EXAM_REL}"
+  printf '%s' "$STUB_PLANT_REFEREE" >"$run_dir/${REFEREE_REL}"
+fi
+`
+
+/** The environment that turns the splice on, and the bytes it writes. */
+const PLANT_ENV = {
+  STUB_EVIDENCE_PLANT: '1',
+  STUB_PLANT_TRANSCRIPT: TRANSCRIPT_BYTES,
+  STUB_PLANT_WALLS: WALLS_BYTES,
+  STUB_PLANT_REFEREE: REFEREE_BYTES,
+}
+
+/** The run's record on the evidence worktree — what the branch will carry. */
+const evidenceRunDir = (ctx) => path.join(evidenceDir(ctx), RUN_PATH)
+
+const read = (file) => fs.readFileSync(file)
+
+/** Every entry under `dir`, at any depth, as `<relative path>` strings. */
+function walk(dir, prefix = '') {
+  const out = []
+  for (const name of fs.readdirSync(dir).sort()) {
+    const rel = prefix ? `${prefix}/${name}` : name
+    out.push(rel)
+    if (fs.statSync(path.join(dir, name)).isDirectory()) out.push(...walk(path.join(dir, name), rel))
+  }
+  return out
+}
+
+// ── the rig: an engine that leaves all three directories behind ──────────────
+
+function examHome() {
+  const ctx = makeHome()
+  const body = STUBS['systemd-run']
+  assert.ok(body.includes(ENGINE_EXIT),
+    `the shared engine stub no longer ends in '${ENGINE_EXIT}' — this sim's splice is stale`)
+  const file = path.join(ctx.bin, 'systemd-run')
+  fs.writeFileSync(file, PRELUDE + body.replace(ENGINE_EXIT, () => PLANT_SNIPPET + ENGINE_EXIT))
+  fs.chmodSync(file, 0o755)
+  return ctx
+}
+
+/**
+ * THE PLANTED BOOT: an engine that records a transcript, a state exam and a
+ * graded-patch file. Every M2 leg reads this one run.
+ */
+const plantedBoot = (() => {
+  const ctx = examHome()
+  const done = bootAsync(ctx, ['boot'], PLANT_ENV).then((r) => ({ ctx, result: r }))
+  // Marked handled at creation — the legs below attach their own handlers, and
+  // a boot that failed must reach the leg that reads it rather than killing the
+  // process as an unhandled rejection.
+  done.catch(() => {})
+  return () => done
+})()
+
+// ── (a) the contract promises no referee record  [M1] ────────────────────────
+
+// One case per negated grep, so each is a leg of its own: the two strings sit
+// on the same surviving line today, and a cut that took one and left the other
+// must be red for the one it left.
+for (const needle of FORBIDDEN_IN_CONTRACT) {
+  test(`fleet/CONTRACT.md carries no line with \`${needle}\`  [M1 / leg (a)]`, () => {
+    assert.deepEqual(contractHits(needle), [],
+      `(a) [M1] no line of fleet/CONTRACT.md may carry \`${needle}\` — the evidence list no ` +
+        'longer promises a `referee/` directory')
+  })
+}
+
+test('§Literals still lists transcripts before state-exams  [M1 / leg (a)]', () => {
+  const section = literalsSection()
+
+  const at = section.indexOf(TRANSCRIPTS_ITEM)
+  assert.ok(at >= 0,
+    `(a) [M1] §Literals must still carry \`${TRANSCRIPTS_ITEM}\` — the item above the deleted ` +
+      'one stays')
+  const after = section.indexOf(STATE_EXAMS_ITEM, at + TRANSCRIPTS_ITEM.length)
+  assert.ok(after >= 0,
+    `(a) [M1] and \`${STATE_EXAMS_ITEM}\` after it — the item below the deleted one stays, in ` +
+      'that order; §Literals is the section that holds the evidence list')
+})
+
+// ── (b) the record carries the two, and never the third  [M2] ────────────────
+
+test('the planted boot exits 0 and the engine left all three directories  [M2 / leg (b)]', async () => {
+  const { ctx, result } = await plantedBoot()
+  assert.equal(result.status, 0,
+    `(b) [M2] the planted boot must run to completion:\n${result.stdout}${result.stderr}`)
+
+  // The rig left the three files where the engine leaves them, with the bytes
+  // it meant to — otherwise a green leg below would be two absences agreeing.
+  const dir = runDir(ctx)
+  assert.deepEqual(read(path.join(dir, TRANSCRIPT_REL)), Buffer.from(TRANSCRIPT_BYTES),
+    `(b) [M2] the engine stub must leave <run_dir>/${TRANSCRIPT_REL} with the bytes it meant to`)
+  assert.deepEqual(read(path.join(dir, EXAM_REL)), Buffer.from(WALLS_BYTES),
+    `(b) [M2] and <run_dir>/${EXAM_REL}`)
+  assert.ok(fs.existsSync(path.join(dir, REFEREE_REL)),
+    `(b) [M2] and <run_dir>/${REFEREE_REL} — this leg asks what the boot does with a run ` +
+      'directory that HOLDS one, so the file has to be there for the absence below to mean ' +
+      'anything; got: ' + walk(dir).join(' '))
+  assert.deepEqual(read(path.join(dir, REFEREE_REL)), Buffer.from(REFEREE_BYTES),
+    `(b) [M2] holding \`${REFEREE_BYTES}\``)
+})
+
+test('the transcript and the state exam reach the record byte for byte  [M2 / leg (b)]', async () => {
+  const { ctx } = await plantedBoot()
+  const source = runDir(ctx)
+  const dest = evidenceRunDir(ctx)
+
+  // The evidence directory is the real one — the run's receipts are in it.
+  assert.ok(fs.existsSync(path.join(dest, 'gate-receipt.json')),
+    `(b) [M2] ${RUN_PATH}/gate-receipt.json must be collected — otherwise this leg reads the ` +
+      'wrong directory')
+
+  for (const rel of [TRANSCRIPT_REL, EXAM_REL]) {
+    const collected = path.join(dest, rel)
+    assert.ok(fs.existsSync(collected),
+      `(b) [M2] ${RUN_PATH}/${rel} must be on the record — the transcripts copy and the ` +
+        'state-exams walk are untouched by this cut; got: ' + walk(dest).join(' '))
+    assert.deepEqual(read(collected), read(path.join(source, rel)),
+      `(b) [M2] and byte-equal to the run directory's ${rel}`)
+  }
+  assert.deepEqual(read(path.join(dest, TRANSCRIPT_REL)), Buffer.from(TRANSCRIPT_BYTES),
+    '(b) [M2] the collected transcript is the bytes the engine recorded')
+  assert.deepEqual(read(path.join(dest, EXAM_REL)), Buffer.from(WALLS_BYTES),
+    '(b) [M2] and so is the collected state exam')
+})
+
+test('no referee entry at any depth of the committed record  [M2 / leg (b)]', async () => {
+  const { ctx } = await plantedBoot()
+  const dest = evidenceRunDir(ctx)
+
+  const found = walk(dest).filter((rel) => rel.includes('referee'))
+  assert.deepEqual(found, [],
+    `(b) [M2] ${RUN_PATH}/ must hold no entry named \`referee\` at any depth — a copy block ` +
+      'that survived in `collect_evidence` makes one appear, and the run directory this boot ' +
+      `left really does hold ${REFEREE_REL}; got: ` + found.join(' '))
+  assert.ok(!fs.existsSync(path.join(dest, 'referee')),
+    `(b) [M2] and no ${RUN_PATH}/referee directory, got: ` + fs.readdirSync(dest).join(' '))
+})
+
+// ── (c) the script says it nowhere, parses, and still walks the exams  [M3] ───
+
+test('fleet/sandbox-boot.sh carries no occurrence of referee, in any case  [M3 / leg (c)]', () => {
+  const hits = fs.readFileSync(SCRIPT, 'utf8')
+    .split('\n')
+    .map((line, i) => [i + 1, line])
+    .filter(([, line]) => /referee/i.test(line))
+    .map(([n, line]) => `${n}: ${line.trim()}`)
+  assert.deepEqual(hits, [],
+    '(c) [M3] `grep -ci referee fleet/sandbox-boot.sh` must be 0 — the copy block and the six ' +
+      'comment lines above it go together, comment included')
+})
+
+test('the boot script parses  [M3 / leg (c)]', () => {
+  const r = spawnSync('bash', ['-n', SCRIPT], { encoding: 'utf8', env: ENV })
+  assert.equal(r.status, 0, `(c) [M3] bash -n ${SCRIPT}:\n${r.stdout}${r.stderr}`)
+})
+
+test('test_sandbox_boot_state_exams.mjs still prints ALL TESTS PASSED  [M3 / leg (c)]', () => {
+  const sim = 'fleet/tests/test_sandbox_boot_state_exams.mjs'
+  const r = spawnSync(process.execPath, [sim], {
+    cwd: REPO_ROOT, encoding: 'utf8', env: ENV, timeout: 300000,
+  })
+  assert.ok(r.stdout.includes('ALL TESTS PASSED'),
+    `(c) [M3] \`node ${sim}\` must print ALL TESTS PASSED — it grades the state-exams walk, ` +
+      `which this cut leaves alone:\n${r.stdout}${r.stderr}`)
+  assert.equal(r.status, 0, `(c) [M3] and exit 0:\n${r.stdout}${r.stderr}`)
+})
+
+// ── (d) the four-document structural pin  [M4] ───────────────────────────────
+
+test('tests/test_docs_agree_with_code.py passes  [M4 / leg (d)]', () => {
+  const r = spawnSync('python3', ['-m', 'pytest', 'tests/test_docs_agree_with_code.py', '-q'], {
+    cwd: REPO_ROOT, encoding: 'utf8', env: ENV, timeout: 300000,
+  })
+  assert.equal(r.status, 0,
+    '(d) [M4] `python3 -m pytest tests/test_docs_agree_with_code.py -q` must exit 0 — the ' +
+      'unit, the engine directory, the VM name and the two-tags bullet are none of them in ' +
+      `the deleted item:\n${r.stdout}${r.stderr}`)
+})
+
+runTests(tests)
