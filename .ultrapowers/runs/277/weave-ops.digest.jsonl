{"t":127231,"op":"edit","agent":"A","path":"factory/flock/engine.mjs","vstart":1110,"vend":1140,"lines":["// ── the compact record: each tested snapshot's patch against the previous one, and the weave's","// ops with file texts as fingerprints (compact_record.mjs) ──","function writeCompactRecord () {","  const lines = fs.readFileSync(path.join(OUT, 'weave-ops.jsonl'), 'utf8').split('\\n')","  const rec = compactRecord(snapshots, BASE_FILES, lines)","  fs.writeFileSync(path.join(OUT, 'snapshots.jsonl'), rec.snapshots)","  fs.writeFileSync(path.join(OUT, 'weave-ops.digest.jsonl'), rec.digest)"]}
