diff --git a/fleet/tests/test_run_engine_examiner.mjs b/fleet/tests/test_run_engine_examiner.mjs
index 11dea88734fd8b8bb99f9e77c93fd4519968fa4e..6657d2e0e683066c755c9da33efba57dbc592eee 100644
--- a/fleet/tests/test_run_engine_examiner.mjs
+++ b/fleet/tests/test_run_engine_examiner.mjs
