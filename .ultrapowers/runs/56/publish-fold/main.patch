+  /*  0 */ 'TAP version 13',
+  /*  1 */ '# Subtest: the first sim',
+  /*  2 */ 'ok 1 - the first sim',
+  /*  3 */ '  ---',
+  /*  4 */ '  duration_ms: 1.203',
+  /*  5 */ '  ...',
+  /*  6 */ 'not ok 2 - leg (b) [M2]: the failing sim', // start
+  /*  7 */ '  ---',
+  /*  8 */ "  error: 'the block must start at the not ok line'",
+  /*  9 */ "  code: 'ERR_ASSERTION'",
