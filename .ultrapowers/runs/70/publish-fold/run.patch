+
+# --------------------------------------------------------------- leg (b) M1
+
+def test_leg_b_zero_test_unions_its_exercises_and_counts_one_touch(table_a):
+    """(b)/M1: `tests/test_b.py` — `catches` exactly 0, `exercised` exactly
