+      assert.ok(isAncestor(run.integ, prev, cur),
+        '(c)/M2: epoch ' + adoptions[i].wave + '\'s head ' + cur + ' is a descendant of epoch ' +
+        adoptions[i - 1].wave + '\'s ' + prev + ' — each epoch folds onto the head the last one ' +
+        'left' + where)
+    }
