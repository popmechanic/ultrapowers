-def _main(argv):
-    """`hfr.main`, with an argparse `SystemExit` reported as its exit code."""
-    try:
-        return hfr.main(list(argv))
-    except SystemExit as exc:
-        if exc.code is None:
-            return 0
-        return exc.code if isinstance(exc.code, int) else 1
