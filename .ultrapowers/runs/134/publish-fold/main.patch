+    const under = fs.realpathSync(TMP)
+    assert.ok(fs.realpathSync(home).startsWith(under + path.sep),
+      `(a) [M1] and it is under os.tmpdir() (${under}): ${fs.realpathSync(home)}`)
+    const second = simEnv()
