+            swallow("git unavailable; no landing dates for this tree", exc)
+            return out
+        if proc.returncode != 0:
+            continue
+        first = proc.stdout.strip().splitlines()
+        when = _when(first[0]) if first else None
+        if when is not None:
+            out[rel] = when
+    return out
+
