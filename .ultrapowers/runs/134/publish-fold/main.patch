-+    record = {"status": "GREEN_AT_BASELINE", "specSha256": sha,
-+              "evidence": "all green at base", "createdAt": "t"}
-+    (pending / "outcome.json").write_text(json.dumps(record))
-+    out = run_collect(spec, vault)
