-/** `deps.rename`: `fs.renameSync`, with the bytes it moved recorded. */
-function renameSpy() {
-  const calls = []
-  const fn = (from, to) => {
-    calls.push({ from: String(from), to: String(to), bytes: fs.readFileSync(from) })
-    return fs.renameSync(from, to)
-  }
-  fn.calls = calls
-  return fn
-}
