-    if isinstance(t, str):
-        return t
-    c = block.get("content")
-    if isinstance(c, str):
-        return c
-    if isinstance(c, list):
-        return "\n".join(block_text(b) for b in c)
-    return ""
-
-
-def iter_blocks_indexed(records):
