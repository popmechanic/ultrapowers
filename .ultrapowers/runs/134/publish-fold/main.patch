+  const calls = { listProjects: 0, listIssues: [] }
+  return {
+    host,
+    calls,
+    listProjects: async () => {
+      calls.listProjects += 1
+      return { projects: projects.map((p) => ({ ...p })) }
+    },
+    listIssues: async (projectId) => {
