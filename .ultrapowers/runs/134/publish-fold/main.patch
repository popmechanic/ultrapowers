+      while (j < n && text[j] !== '\n') j++
+      blank(i, j, true)
+      i = j
+      continue
+    }
+    if (c === '/' && d === '*') {
+      const close = text.indexOf('*/', i + 2)
+      const j = close === -1 ? n : close + 2
+      blank(i, j, true)
+      i = j
+      continue
