+  // main, where the reserved directory does not exist; inside a run it is the
+  // run's own exams.
+  const examsDir = path.join(TESTS_DIR, 'exams')
+  const present = !fs.existsSync(examsDir) ? [] : fs.readdirSync(examsDir)
