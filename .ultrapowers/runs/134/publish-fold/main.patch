+    const { report, events } = await edgeRun({
+      ids: ['T1'], plan: { T1: ['edge403', 'success'] }, reflection: 'absent',
+    })
+    assert.equal(report.tasks[0].status, 'failed',
+      '#903 (b): the run fails: ' + JSON.stringify(report.tasks[0]))
