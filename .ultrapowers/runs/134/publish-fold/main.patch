-/** The run a tag-verify read names, off the refs it asks for. */
-const runOfTagRead = (argv) => {
-  for (const arg of argv) {
-    const match = /^refs\/tags\/ultra\/(?:plan|evidence)\/run-([1-9][0-9]*)$/.exec(String(arg))
-    if (match) return Number(match[1])
-  }
-  return null
-}
