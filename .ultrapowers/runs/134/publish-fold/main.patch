-def _task(tid, title, *, files, consumes, produces, context,
-          proof_test=None):
-    """One well-formed claims-v1 task: head markers then the six body slots."""
-    proof_test = proof_test or "tests/test_t%s.py" % tid
-    return "\n\n".join([
-        "### Task %s: %s" % (tid, title),
