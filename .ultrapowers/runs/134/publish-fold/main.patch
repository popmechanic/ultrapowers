+      if (!issue) throw new Error(`no such issue ${uid}`)
+      issue.metadata = { ...issue.metadata, ...patch }
+      issue.revision += 1
+      return answer(issue)
+    },
+    async link (projectId, fromUid, spec) {
+      rec('link', [projectId, fromUid, spec])
