-def _elide(text, budget):
-    """Head-and-tail elision with an explicit marker, or `text` if it fits."""
-    if len(text) <= budget:
-        return text
-    head = budget * 2 // 3
-    tail = budget - head
-    return (text[:head] + f"\n\n…[elided {len(text) - head - tail} chars]…\n\n"
-            + text[-tail:])
