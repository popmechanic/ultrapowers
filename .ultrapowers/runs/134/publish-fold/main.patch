-+    calls = []
-+    def fake_run(cmd, **kw):
-+        calls.append((cmd, kw))
-+        return _Result(0, json.dumps(CRED))
-+    env = seed_worker_auth({"PATH": "/bin"}, run=fake_run,
-+                           home=pathlib.Path("/nonexistent"))
-+    assert env["CLAUDE_CODE_OAUTH_TOKEN"] == "tok-live-123"
