+# the exam of …` looks like at the top of a section.
+_BANNER_RE = re.compile(
+    r"^\s*(?://|#)\s*((?:[A-Z][A-Z0-9'\u2019#,:\-]*\s+){2}[A-Z][A-Z0-9'\u2019#,:\-]*.*?)\s*$")
