-+Text pin on SKILL.md; no subprocess."""
-+import pathlib
-+import re
-+
-+import pytest
-+
-+ROOT = pathlib.Path(__file__).resolve().parents[1]
-+SKILL = ROOT / "skills/ultrapowers/SKILL.md"
