+  const contract = fs.readFileSync(path.join(HERE, '..', 'CONTRACT.md'), 'utf8').split('\n')
+  const start = contract.findIndex((l) => l.startsWith('- **Kata record (engine)'))
+  assert.ok(start !== -1,
