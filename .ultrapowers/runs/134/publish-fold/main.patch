+  ENGINE_RULE,
+  ...(repo ? [localRemote(repo)] : []),
+  compilerRule(compiled),
+  sshRule('help ', HELP_OK),
+  sshRule('integrations list --json', answer([{ name: GH, attachments: [] }, { name: 'claude-max', attachments: [] }])),
+  sshRule('billing plan --json', answer(billing)),
+  sshRule('new ', NEW_OK),
+  NO_REMOTE_OPS,
+  NO_NETWORK_GIT
