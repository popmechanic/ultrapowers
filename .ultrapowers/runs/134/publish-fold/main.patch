+test('(c) the live page carries `<phase> · <sub>` and the verb\'s own `tasks` cell  [M3]', () =>
+  held({ FLEET_STATUS_INTERVAL: '0.25' }, async ({ ctx, run, release, over }) => {
+    // The `engine starting` page is written BEFORE the unit, when the run dir
