-    found = []
-    for node in ast.walk(ast.parse(source)):
-        if not isinstance(node, ast.FunctionDef):
-            continue
-        seg = ast.get_source_segment(source, node) or ""
-        if "--check" in seg and "--renders" in seg:
-            found.append(node)
-    assert len(found) == 1, (
-        "expected exactly one `--check --renders` helper, found %r"
