-const HERE = path.dirname(fileURLToPath(import.meta.url))
-const CONTRACT = path.join(HERE, '..', 'CONTRACT.md')
-const RUNBOOK = path.join(HERE, '..', 'RUNBOOK.md')
-const SKILL = path.join(HERE, '..', '..', 'skills', 'ultrapowers', 'SKILL.md')
