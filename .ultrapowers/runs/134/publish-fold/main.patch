+run_uid = uid_of(record.get("run") if isinstance(record, dict) else None)
+if run_uid:
+    mine.add(run_uid)
+tasks = record.get("tasks") if isinstance(record, dict) else None
+for task in (tasks.values() if isinstance(tasks, dict) else []):
+    task_uid = uid_of(task)
+    if task_uid:
+        mine.add(task_uid)
