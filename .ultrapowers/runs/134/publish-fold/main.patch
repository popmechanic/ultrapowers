-    (d / "bundle.json").write_text(json.dumps({
-        "runId": run_id,
-        "origin": origin,
-        "engineVersion": {"epoch": epoch, "asOf": None, "basis": "explicit"},
-        "events": {"runId": run_id, "openedAt": opened_at},
-    }))
-    return d
