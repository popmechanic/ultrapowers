+def assert_reading(line, ran, timed_out):
+    m = READING_RE.match(line)
+    assert m, "not M6's reading line: %r" % line
+    assert (m.group(2), m.group(3)) == (str(ran), str(timed_out)), line
+    return m.group(1)
+
