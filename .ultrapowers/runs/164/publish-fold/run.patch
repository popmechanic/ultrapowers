+    # uv.lock yet — the same `[tool.uv` sniff the bootstrap ladder uses.
+    (tmp_path / "pyproject.toml").write_text("[project]\nname='x'\n[tool.uv]\n")
+    assert derive_regenerate_cmd(tmp_path) == ("uv lock", "pyproject-uv")
