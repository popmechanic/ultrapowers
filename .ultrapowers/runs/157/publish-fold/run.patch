+  const lines = String(text).split('\n')
+  const s = lines.findIndex((l) => startRe.test(l))
+  if (s === -1) return null
+  for (let i = s + 1; i < lines.length; i += 1) {
+    if (endRe.test(lines[i])) return lines.slice(s, i + 1).join(' ')
+  }
+  return lines.slice(s).join(' ')
