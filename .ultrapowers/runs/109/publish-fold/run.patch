+            "leg (a) [M1]: `--stamp %r` does not match "
+            "`^[A-Za-z0-9][A-Za-z0-9-]*$`, so the compiler exits 2; got "
+            "rc=%d\n%s" % (bad, p.returncode, both))
+        assert [l for l in both.splitlines()
+                if l.startswith("error: --stamp")], (
