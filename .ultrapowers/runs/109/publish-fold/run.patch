+# --------------------------------------------------------------------------- #
+# (h) [M4] the legacy grammar, and --check unchanged                           #
+# --------------------------------------------------------------------------- #
+def _legacy_sheets(tmp_path, *extra, name="wide"):
+    stdout_payload, _ = _compile(WIDE_FIXTURE, tmp_path, *extra, name=name)
+    entries = _wave_entries(stdout_payload)
